g/mozilla/fenix/translations/TranslationsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/ReportBrokenSiteMenuItemProviderTest.kt"], "git_node": "798a0fae8fa1436f310f59d9e564b373aae3169c", "git_parents": ["53504914395553a185f47307e1e087dc5f706064"], "node": "9796d7395eb74edfd8f7a1d14b1b8aff87e2a9a1", "parents": ["0ab80c8a2b142ce1734ca7aaa4fba200d37d8509"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2069022 - Allow showing a banner in the menu r=android-reviewers,giorga\n\nWe already supported the UI from the compose-menu module.\nNow we also add in the MVI configuration for it that will be read from\nMenuState to render the banner when appropriately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331515\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/data/MenuItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuBanner.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuGridContainer.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuListItemGroup.kt", "mobile/android/android-components/components/compose/menu/src/main/res/values/strings.xml", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/MenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/MainMenuSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/ThreeDotMenuMainRobot.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/MenuBanner.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/fake/MenuItemEvents.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/fake/MenuItemEventsTest.kt"], "git_node": "691bfefee9dbec711228b45a7aa797d563eb1b85", "git_parents": ["798a0fae8fa1436f310f59d9e564b373aae3169c"], "node": "32f170c13d4824f7395eabecb9ad9f418b5e9a7e", "parents": ["9796d7395eb74edfd8f7a1d14b1b8aff87e2a9a1"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2069022 - Ensure menus for browser, home and custom tabs are built the same but with different items r=android-reviewers,giorga\n\nBrowserMenuBuilder already had the code needed to build the final structure\nfor how a menu should look like based on list of menu items configured to show.\nSince that same code is needed for home and custom tabs menus also the\nBrowserMenuBuilder was refactored to a generic MenuBuilder which gets passed a\nmenu items list and returns the menu configuration to be displayed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331516\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/BrowserMenuBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuConfigurations.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/BrowserMenuBuilderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuBuilderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuItemsRegistryTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/middleware/MenuMiddlewareTest.kt"], "git_node": "7f74b992e43e0244552e309856970d63adc5a0af", "git_parents": ["691bfefee9dbec711228b45a7aa797d563eb1b85"], "node": "4c93d2e49d2b61c6c9964c2d817cc414ce790b5e", "parents": ["32f170c13d4824f7395eabecb9ad9f418b5e9a7e"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2069022 - Show the default browser promotional banner in the home menu r=android-reviewers,giorga\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331517\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/DefaultBrowserMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuConfigurations.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuItemProvidersFactory.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuDialogMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/MenuAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/MenuStore.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/ExtensionsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/DefaultBrowserMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuItemProvidersFactoryTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuTelemetryMiddlewareTest.kt"], "git_node": "8eadaebdc3bbd8a1ddef2ec26ce5b7cb23aeb573", "git_parents": ["7f74b992e43e0244552e309856970d63adc5a0af"], "node": "bc65103ce107a57d43ebcb6bb298e5946bc77d83", "parents": ["4c93d2e49d2b61c6c9964c2d817cc414ce790b5e"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2078598 - Remove run-sequentially from netwerk/ tests that don't need it r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331154\n", "files": ["netwerk/test/unit/xpcshell.toml", "netwerk/test/unit_ipc/xpcshell.toml"], "git_node": "776c06abae5c4cd26cf59d99445473248a3cc280", "git_parents": ["8eadaebdc3bbd8a1ddef2ec26ce5b7cb23aeb573"], "node": "7686bf78649c3ffad30f7668c784830bafdeba1e", "parents": ["bc65103ce107a57d43ebcb6bb298e5946bc77d83"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078226 - Don't animate tab width changes when reduced motion is preferred. r=tabbrowser-reviewers,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330993\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "aaf9a57c7499058aa086f10d4f5c5b0ad7efd23e", "git_parents": ["776c06abae5c4cd26cf59d99445473248a3cc280"], "node": "927b77051e351bad04fa885eb7dfb16062446b6e", "parents": ["7686bf78649c3ffad30f7668c784830bafdeba1e"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079264 - Update android nightly application-services version bump to afd9e477f3ccb108c618360132cdd4e2c91b35ae r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331594\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "d5cf28a0ac0a47e544ed845491e0a2cf757e37d1", "git_parents": ["aaf9a57c7499058aa086f10d4f5c5b0ad7efd23e"], "node": "a8f548cd9c216fe2fc19ba393fa70c3cdfefbfe2", "parents": ["927b77051e351bad04fa885eb7dfb16062446b6e"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050488 - Run WPT testharness with --processes=3 on bare-metal macOS aarch64 r=jgraham\n\nFission-enabled WPT testharness was pinned to a single process on every\nplatform, a decision made for low-memory Intel workers. The macOS\naarch64 CI workers are 10-core / 16GB Mac minis and sit largely idle\nunder that.\n\nMeasured against a matched single-process control on the same base\ncommit, same selector, rebuild 3: median chunk wall-clock drops from\n22.4 min to 9.5 min, a 2.35x speedup, with the failure rate unchanged\nat 9/42 against the control's 8/42 (two-sided Fisher exact p = 1.000).\n\nSweeping further up finds the knee at 3. 5 processes gives 8.6 min and\n7 gives 8.7 min, so everything above 3 is worth about 10 percent more\nand nothing above 5 is worth anything, while the failure rate drifts to\n12/42 and 11/42. At 9 every job fails during browser startup with\nOSError [Errno 24] Too many open files: this is a file descriptor limit\nin the wptrunner parent process, not memory pressure, as peak system\nmemory never exceeds 10.3 GiB of 16 GiB even at 7 processes.\n\nScoped to the general testharness chunks. The tag-scoped media jobs\n(--tag=webrtc, -eme, -canvas, -webcodecs) have not been measured and\nstay single-process. The macOS aarch64 VM pools have far less memory\nper guest and also stay single-process, gated via mozinfo\ninfo[\"macos_vm\"].\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327010\n", "files": ["testing/mozharness/scripts/web_platform_tests.py"], "git_node": "c48b122b963245cd9c55eabd30bf22a63dacfa55", "git_parents": ["d5cf28a0ac0a47e544ed845491e0a2cf757e37d1"], "node": "b50cac2e78b82360902b9279ae7835c458f601a2", "parents": ["a8f548cd9c216fe2fc19ba393fa70c3cdfefbfe2"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2076608 - Use moz-src for devtools/startup r=profiler-reviewers,devtools-reviewers,nchevobbe,florian\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329871\n", "files": ["devtools/client/performance-new/test/xpcshell/test_webchannel-urls.js", "devtools/startup/components.conf", "devtools/startup/moz.build", "devtools/startup/tests/browser/browser_command_line_urls.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "9f50e4675b73c349ec7bfa72fa909f6fcf558bb5", "git_parents": ["c48b122b963245cd9c55eabd30bf22a63dacfa55"], "node": "8d72dad3f6465ffba7f266e06c6ab302f8b997a2", "parents": ["b50cac2e78b82360902b9279ae7835c458f601a2"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076697 - Call a continuation's initial function through a slow call site. r=rhunt\n\nThe continuation base-frame stub called the initial funcref via wasmCallRef.\nIn the stub, InstanceReg (and the pinned registers and realm) already belongs\nto the funcref's instance, so wasmCallRef's runtime instance-compare always\ntook the fast path and its slow path was dead code. Replace it with a direct\ncall that is marked as a slow call, so a cross-instance return_call from the\ncallee collapses its frame without inserting a hidden return_call trampoline\nframe. Nothing after the call uses the instance (EmitSwitchStack reloads it),\nso no restore is emitted.\n\nPerformance: this stub runs once per continuation, on its first resume, and is\nnot on the suspend/resume hot path. The direct (fast) call is preserved; the\nstub is smaller than before because wasmCallRef's dead slow path and its\ncompare-and-branch are gone, leaving two instance-slot stores, the entry load,\nthe call, and a one-instruction slow-call marker. A debug-only assertion checks\nthat InstanceReg matches the funcref's instance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329990\n", "files": ["js/src/jit-test/tests/wasm/stack-switching/bug2076697-trap.js", "js/src/jit-test/tests/wasm/stack-switching/bug2076697.js", "js/src/wasm/WasmStubs.cpp"], "git_node": "7ce45bf77a1709752a5bc6feb62609ba17b5df8c", "git_parents": ["9f50e4675b73c349ec7bfa72fa909f6fcf558bb5"], "node": "85c00edb5f75536c3726612ed3da416f74fccaf1", "parents": ["8d72dad3f6465ffba7f266e06c6ab302f8b997a2"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975750 - Add more tests for UserInstalledConfigEngines. r=search-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329935\n", "files": ["toolkit/components/search/tests/xpcshell/test_userInstalledConfigEngine.js"], "git_node": "900b158fab4e0ed74e903b1397e29bc980228055", "git_parents": ["7ce45bf77a1709752a5bc6feb62609ba17b5df8c"], "node": "bdcef29a06de1e125f17775753506f57dc5d37a1", "parents": ["85c00edb5f75536c3726612ed3da416f74fccaf1"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977691 - Remove incorrect comment r=spidermonkey-reviewers,iain DONTBUILD\n\nWe definitely will hit this path with no promise from AddPromiseReactions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331281\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "677bbcd30b2e268a57ceb5c56eeb55c307e199b9", "git_parents": ["900b158fab4e0ed74e903b1397e29bc980228055"], "node": "1d5d343acd68bf7d927eba4e5b690dc2e101c83b", "parents": ["bdcef29a06de1e125f17775753506f57dc5d37a1"], "tags": []}, {"author": "Seva Alipov \u003csalipov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057345: No longer ignore block-ellipsis in line-clamp containers. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330276\n", "files": ["layout/generic/TextOverflow.cpp", "layout/generic/TextOverflow.h", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-010.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-text-overflow-string-003.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-text-overflow-string-004.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-text-overflow-string-005.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/webkit-line-clamp-037.html.ini"], "git_node": "9903eebfc8a8fc2264496a19e0aecea726194a9f", "git_parents": ["677bbcd30b2e268a57ceb5c56eeb55c307e199b9"], "node": "721b784fb8931dc8bcd1e429cb88cb23e51e0c60", "parents": ["1d5d343acd68bf7d927eba4e5b690dc2e101c83b"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076834 - Use asynchronous module load for the revamped switcher in the legacy bookmarks panel. r=sidebar-reviewers,nsharpley\" for causing failures complaining about CustomElementCreationCallback.\n\nThis reverts commit 8d08195715553a798b7135f79a856681ac591b8a.\n", "files": ["browser/components/places/content/bookmarksSidebar.xhtml"], "git_node": "2e37e56cf8fe60224c361c89815ab73a7cb53f73", "git_parents": ["9903eebfc8a8fc2264496a19e0aecea726194a9f"], "node": "908045b724361fa9acbb8e016882ae9dbef538be", "parents": ["721b784fb8931dc8bcd1e429cb88cb23e51e0c60"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078226 - Don't animate tab width changes when reduced motion is preferred. r=tabbrowser-reviewers,niklas\" for causing failures at browser_tabCloseProbes.js.\n\nThis reverts commit aaf9a57c7499058aa086f10d4f5c5b0ad7efd23e.\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "9789cf2bdad9e2b31cd82b7173072f68b1004dab", "git_parents": ["2e37e56cf8fe60224c361c89815ab73a7cb53f73"], "node": "ef71232eee5aad2fc38675f8add15c953a3f1961", "parents": ["908045b724361fa9acbb8e016882ae9dbef538be"], "tags": []}, {"author": "Anna \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 1982833 - Missing crv check for OKP JWK keys r=JavierFernandez\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260973\n", "files": ["dom/crypto/CryptoKey.cpp", "dom/crypto/CryptoKey.h", "dom/crypto/WebCryptoTask.cpp", "testing/web-platform/meta/WebCryptoAPI/import_export/okp_importKey_failures_Ed25519.https.any.js.ini"], "git_node": "9e4173956dc9b569eb9d4e53fd5b06fb8ecc8b36", "git_parents": ["9789cf2bdad9e2b31cd82b7173072f68b1004dab"], "node": "956da8b1f751d2497c88a108c5ecb1f5db6d3fe5", "parents": ["ef71232eee5aad2fc38675f8add15c953a3f1961"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075888 - Make the repo-update tasks use git instead of hg.mozilla.org. r=releng-reviewers,jcristau\n\nThe repo-update checkout no longer forces an hg clone, so it clones from GitHub wherever the decision task\nprovides a git revision. Try pushes still get an hg checkout, so periodic_file_updates.sh picks git or hg from\nthe checkout itself instead of taking a --use-git option.\n\nThe in-tree files the tasks compare against (HSTS and HPKP lists, public suffix list, mobile experiments) are\nnow copied from the task's checkout instead of downloaded from hg.mozilla.org, and the unused hg repository\nmapping and clone code are removed, so -t is now required. Outside a dry run the script refuses a checkout\nwith uncommitted changes, because the update commit would include them.\n\nThe image now configures the ffxbld identity for both git and hg instead of the script passing it to hg\ncommit. Git refuses to commit without an identity, and moz-phab also needs one when it rewrites the commit to\nadd its trailer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331279\n", "files": ["taskcluster/docker/periodic-updates/README.md", "taskcluster/docker/periodic-updates/runme.sh", "taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js", "taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh", "taskcluster/docker/periodic-updates/setup.sh", "taskcluster/kinds/repo-update/kind.yml"], "git_node": "3d3cde2a8e0dd683015c284ec9bae29e67db2672", "git_parents": ["9e4173956dc9b569eb9d4e53fd5b06fb8ecc8b36"], "node": "f6aefa2adc713a65b46f1fcb9bde773da437a5c2", "parents": ["956da8b1f751d2497c88a108c5ecb1f5db6d3fe5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075888 - Remove Thunderbird support and the archive.mozilla.org download path from the periodic update scripts. r=releng-reviewers,jcristau\n\nThunderbird does not run the repo-update tasks, so the product option goes too and the scripts use Firefox\ndirectly.\n\nThe --use-ftp-builds option is removed as well: no task passes it, and archive.mozilla.org has no\ntarget.tar.xz for it to download.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331280\n", "files": ["taskcluster/docker/periodic-updates/README.md", "taskcluster/docker/periodic-updates/runme.sh", "taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh", "taskcluster/kinds/repo-update/kind.yml"], "git_node": "144feddfa83dcaf65e9917c2960370460f859295", "git_parents": ["3d3cde2a8e0dd683015c284ec9bae29e67db2672"], "node": "aa10661f2d05534f6ea815173dca1ef6089e28a4", "parents": ["f6aefa2adc713a65b46f1fcb9bde773da437a5c2"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077391 - Add strings for auto-triggered guidance notification r=omc-reviewers,fluent-reviewers,bolsson,jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331444\n", "files": ["browser/locales/en-US/browser/defaultBrowserNotification.ftl"], "git_node": "b037ca141af9e2ab02abfd15b0b7c5ea0bc90170", "git_parents": ["144feddfa83dcaf65e9917c2960370460f859295"], "node": "d4badd3eea40079e01ecc3d1c7f12bdd1bed93fc", "parents": ["aa10661f2d05534f6ea815173dca1ef6089e28a4"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2070034 - Don't trust MP4 stss to decide if an AV1 frame is a keyframe. r=media-playback-reviewers,padenot\n\nAV1-in-MP4 (bug 1417050) never rewrote mKeyframe from the payload, so seek still\ntreats sample_is_sync as a RAP. AV1-in-ISOBMFF requires a sync sample to be a\nKEY RAP, but muxes can still mark INTER.\n\nDo what is already done for H.264, VP9-in-MP4, and AV1-in-WebM: parse the sample\nwith AOMDecoder::IsKeyframe and correct mKeyframe. Encrypted samples stay on stss.\n\nMP4Demuxer.SeekAV1 copies SeekHEVC. Existing av1.mp4 is one GOP (1s). Generate\ntest_av1.mp4, then overwrite the stss sample numbers in place (box size and\nentry_count stay 4). Bitstream KEY_FRAME is 1, 31, 61, 91; stss becomes\n1, 28, 60, 88 so a seek to 2s lands on a non-KEY_FRAME if stss is trusted:\n\n  ffmpeg -f lavfi -i testsrc=duration=4:size=128x128:rate=30 \\\n    -c:v libaom-av1 -cpu-used 8 -crf 40 -g 30 -keyint_min 30 -an \\\n    test_av1.mp4\n\n  python3 - \u003c\u003c'PY'\n  from pathlib import Path\n  p = Path(\"test_av1.mp4\")\n  b = bytearray(p.read_bytes())\n  i = b.find(b\"stss\")\n  for k, s in enumerate((1, 28, 60, 88)):\n      b[i + 12 + 4 * k : i + 16 + 4 * k] = s.to_bytes(4, \"big\")\n  p.write_bytes(b)\n  PY\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329576\n", "files": ["dom/media/gtest/TestMP4Demuxer.cpp", "dom/media/gtest/moz.build", "dom/media/gtest/test_av1.mp4", "dom/media/mp4/MP4Demuxer.cpp"], "git_node": "9b0e8d0ebaed5dc5574564cc24a7068a15a962c2", "git_parents": ["b037ca141af9e2ab02abfd15b0b7c5ea0bc90170"], "node": "731a0d3fdb0eaa1889ecb8aaaec5837b6f2f4d3f", "parents": ["d4badd3eea40079e01ecc3d1c7f12bdd1bed93fc"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 1983514 - Update metadata for html/semantics/interactive-elements/the-summary-element/interactive-content.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331643\n", "files": ["testing/web-platform/meta/html/semantics/interactive-elements/the-summary-element/interactive-content.html.ini"], "git_node": "4c51a923fe7bd66810dea070ddd05c6e4c3f4ffc", "git_parents": ["9b0e8d0ebaed5dc5574564cc24a7068a15a962c2"], "node": "1b78025e9fe534b77e7813fbac9b16089e795371", "parents": ["731a0d3fdb0eaa1889ecb8aaaec5837b6f2f4d3f"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2079188 - Expose the CSS namespace in workers and worklets behind a preference; r=emilio,webidl,firefox-style-system-reviewers\n\nExtend the CSS namespace exposure to Worker and PaintWorklet while keeping the\nexisting Window-only APIs restricted to Window.\n\nGate the additional exposure behind the\nlayout.css.namespace.exposed-in-workers-and-worklets preference, which is\ndisabled by default for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331606\n", "files": ["dom/webidl/CSS.webidl", "dom/worklet/WorkletCommon.h", "dom/worklet/WorkletGlobalScope.cpp", "dom/worklet/moz.build", "layout/style/CSS.cpp", "layout/style/CSS.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "a6bc7652b48848692f405ce8b7a6965fde5105ba", "git_parents": ["4c51a923fe7bd66810dea070ddd05c6e4c3f4ffc"], "node": "0455edfd14c6e5572b415581c52795944ed6377f", "parents": ["1b78025e9fe534b77e7813fbac9b16089e795371"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2078401 - Remove add-shortcuts-improvement nimbus flag r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330916\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/ShortcutsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/TopSiteState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/TopSites.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/middleware/ShortcutsMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/store/ShortcutsAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/store/ShortcutsState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/store/ShortcutsStore.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/ui/ShortcutsScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/TopSiteStateTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/TopSitesExpandToggleTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/middleware/ShortcutsMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/store/ShortcutsStoreTest.kt"], "git_node": "aa344befd4253aae468d69ce1e899ea849344b4c", "git_parents": ["a6bc7652b48848692f405ce8b7a6965fde5105ba"], "node": "1ffc7f64db59bc9f9b01c1723ee58a29ade560bd", "parents": ["0455edfd14c6e5572b415581c52795944ed6377f"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2073500 - Enable doh autoselect-enabled by default on nightly r=necko-reviewers,android-reviewers,kershaw,sfamisa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327367\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml"], "git_node": "02fd20998061388ab8556afdfbdf32187be98591", "git_parents": ["aa344befd4253aae468d69ce1e899ea849344b4c"], "node": "97c781c3492ffc743bc3e910782ebcf64889ce9c", "parents": ["1ffc7f64db59bc9f9b01c1723ee58a29ade560bd"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077075 - Remove marking check that doesn't hold r=spidermonkey-reviewers,iain\n\nThere's a block at the start of ShouldMarkCrossCompartment that crashes if it\ndetects gray to nursery edges, on the grounds that it shouldn't be possible for\nsuch edges to exist.\n\nThe reasoning is wrong and this bug demonstrates how they can be created: by\nwrapper remapping, which touches gray (and possibly dead) things.\n\nIt's not a problem to hit these edges here. We will return false from the first\nif block because the nursery target will be reported as marked black. The\nnursery object will be tenured and traced on the next minor GC, due to the\nstore buffer entry added by the postbarrier when we created the edge.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331524\n", "files": ["js/src/gc/Marking.cpp", "js/src/jit-test/tests/gc/bug-2077075.js"], "git_node": "ac08cf2dd00390cbb0029cadc8de45b33fbe0127", "git_parents": ["02fd20998061388ab8556afdfbdf32187be98591"], "node": "980247558a35b0312d02b9265120ba4320e38d00", "parents": ["97c781c3492ffc743bc3e910782ebcf64889ce9c"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074685 - Turn off Talos/AWSY macOS 14.7 tests r=perftest-reviewers,aglavic\n\nThis patch finalizes the migration of Talos + AWSY to the newer macOS\nhardware. We have enough time series data now to safely turn off the\n14.7 tests for the transition period.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331642\n", "files": ["taskcluster/test_configs/test-platforms.yml", "testing/perfdocs/generated/awsy.md", "testing/perfdocs/generated/talos.md"], "git_node": "15503e50a6ab018b80aa6ddf6081acc9d94cbf85", "git_parents": ["ac08cf2dd00390cbb0029cadc8de45b33fbe0127"], "node": "3890382f0f049b7ceaac58a6de102a7f2dba00c2", "parents": ["980247558a35b0312d02b9265120ba4320e38d00"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074483 - Apply the edge to edge wallpaper before the home screen being visible r=android-reviewers,tthibaud\n\nSetting the wallpaper serially inside onStart will ensure there is not flicker\nfrom initially showing the window background and then soon after the actual\nedge to edge wallpaper.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328133\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomepageEdgeToEdgeFeature.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/HomepageEdgeToEdgeFeatureTest.kt"], "git_node": "0b390d246b20e211a35d5006d825227c08ce7fc4", "git_parents": ["15503e50a6ab018b80aa6ddf6081acc9d94cbf85"], "node": "d3e8b0bf1e2f62983ddbdea16bcc03bb0c90c7ab", "parents": ["3890382f0f049b7ceaac58a6de102a7f2dba00c2"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074898 - Ensure bottom chrome dividers are shown on top of the top most bar r=android-reviewers,calu\n\nUntil recently the single navigation bar or bottom toolbar were known to be the\ntop most bars shown at the bottom of the screens so they were hardcoded to show\na top divider.\nNow it is possible for the tab strip or tab groups strip to be shown on top of\nthem so their divider should not be shown in favor of a new one supported by the\nnew strips.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330793\n", "files": ["mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/BrowserDisplayToolbar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/BrowserEditToolbar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/BrowserToolbar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/NavigationBar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/concept/BrowserToolbarTestTags.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/ui/FullDisplayToolbar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/BrowserDisplayToolbarTest.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/BrowserEditToolbarTest.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/BrowserToolbarTest.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/NavigationBarTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserNavigationBar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/TopDividerColumn.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeNavigationBar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposable.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/TopDividerColumnTest.kt"], "git_node": "ce2c92f6677561a0f3eefb0301d3ec8ef6cb2242", "git_parents": ["0b390d246b20e211a35d5006d825227c08ce7fc4"], "node": "8f751b38b12972231dc4346566ecbc6612de7c59", "parents": ["d3e8b0bf1e2f62983ddbdea16bcc03bb0c90c7ab"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078628: On macOS, save the restored bounds before every zoom and live resize. r=mac-reviewers,bradwerth\n\nBug 875858 saves a window's normal bounds only when Gecko maximizes it. A title bar double-click, the zoom button or the \"Fill\" tiling action maximizes the window without Gecko, so the saved bounds stay stale and session restore reopens the window where it was before. Save them in windowShouldZoom:toFrame:, which runs before every zoom, and in windowWillStartLiveResize:, which is how Fill reaches us.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331493\n", "files": ["widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm"], "git_node": "138578f7913d9ffd10c645b3702657edd14ae89c", "git_parents": ["ce2c92f6677561a0f3eefb0301d3ec8ef6cb2242"], "node": "09ec854e28093c0e5d33e4049805f0db0173a8e5", "parents": ["8f751b38b12972231dc4346566ecbc6612de7c59"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1982833 - Missing crv check for OKP JWK keys r=JavierFernandez\" for causing wpt failures @kp_importKey_failures_X25519.https.any.html.\n\nThis reverts commit 9e4173956dc9b569eb9d4e53fd5b06fb8ecc8b36.\n", "files": ["dom/crypto/CryptoKey.cpp", "dom/crypto/CryptoKey.h", "dom/crypto/WebCryptoTask.cpp", "testing/web-platform/meta/WebCryptoAPI/import_export/okp_importKey_failures_Ed25519.https.any.js.ini"], "git_node": "f6312fe09e96e827b25746ff7e6959a5597e4382", "git_parents": ["138578f7913d9ffd10c645b3702657edd14ae89c"], "node": "f71436a5d2d44dc35433367783c438ec6ea6067f", "parents": ["09ec854e28093c0e5d33e4049805f0db0173a8e5"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078974 - Turn on widget market gating with every widget off by default r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331453\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "e18a357828ebe1ede957cad94300c5a0c069e6c9", "git_parents": ["f6312fe09e96e827b25746ff7e6959a5597e4382"], "node": "bfd91fbbb5b4be9eab15e3bce935c6069a86e289", "parents": ["f71436a5d2d44dc35433367783c438ec6ea6067f"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078859 - Fix assertion about keys without unique IDs in StableCellHasher r=spidermonkey-reviewers,iain\n\nThis is a rare case which is why this hasn't come up before. The idea is to\nassert that if a unique ID is not found for a key it's because the key is dying\nand is about to be swept. (The replacement assertion is essentially\nIsAboutToBeFinalized(key), except that isn't implemented for Cell* which we\nsometimes use as the template parameter).\n\nThe testcase did reproduce the problem but took ages to run so I didn't include it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331638\n", "files": ["js/src/gc/StableCellHasher-inl.h"], "git_node": "e852dda71be9163bd67437edf5baa4c072c20651", "git_parents": ["e18a357828ebe1ede957cad94300c5a0c069e6c9"], "node": "23997e4e901cc5820b8152dc8ee27dbaf587269e", "parents": ["bfd91fbbb5b4be9eab15e3bce935c6069a86e289"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068205 - Fall back to the \"unknown\" vendor in rust target detection r=firefox-build-system-reviewers,glandium,sylvestre\n\nrustc 1.98 added `*-oe-linux-*` targets, so a host with another vendor, such\nas `aarch64-pld-linux-gnu`, matched both the `unknown` and the `oe` target and\nconfigure could not pick one. When no rust target has the host vendor, match\non `unknown` instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330023\n", "files": ["build/moz.configure/rust.configure", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": "2905c758c195388b3d371f1b615b1c5a9c6e1226", "git_parents": ["e852dda71be9163bd67437edf5baa4c072c20651"], "node": "5b83387730b7b4e098546d60917bab6548289af7", "parents": ["23997e4e901cc5820b8152dc8ee27dbaf587269e"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075835 - Part 1. Make EME WPTs use Widevine if PlayReady is disabled in Firefox. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329429\n", "files": ["testing/web-platform/tests/encrypted-media/drm-check-encryption-scheme.https.html", "testing/web-platform/tests/encrypted-media/drm-check-initdata-type.https.html", "testing/web-platform/tests/encrypted-media/drm-check-status-for-hdcp.https.html", "testing/web-platform/tests/encrypted-media/drm-events-session-closed-event.https.html", "testing/web-platform/tests/encrypted-media/drm-events.https.html", "testing/web-platform/tests/encrypted-media/drm-expiration.https.html", "testing/web-platform/tests/encrypted-media/drm-generate-request-disallowed-input.https.html", "testing/web-platform/tests/encrypted-media/drm-invalid-license.https.html", "testing/web-platform/tests/encrypted-media/drm-keystatuses-multiple-sessions.https.html", "testing/web-platform/tests/encrypted-media/drm-keystatuses.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-destroy-persistent-license.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-persistent-license-events.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-persistent-license.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-retrieve-destroy-persistent-license.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-retrieve-persistent-license.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-clear-encrypted.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-encrypted-clear-sources.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-encrypted-clear.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-events.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-expired.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-multikey-sequential-readyState.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-multikey-sequential.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-multikey.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-multisession.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-playduration-keystatus.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-playduration.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-after-src.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-after-update.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-immediately.https.html", "testing/web-platform/tests/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-onencrypted.https.html", "tes