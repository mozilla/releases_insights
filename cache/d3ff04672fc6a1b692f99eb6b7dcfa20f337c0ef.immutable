63fe4e83a16", "c124b746516c4c256518ad0251f822b054e35d20", "530c5c009de23a3208a489780de0889f25f4b465", "7e630b3f484c936557d341055c567342318a1c28", "a0a153c9cc142b6bb076c1430e6bdf7ed4a29634", "b2c191e67a00234b35d31d045409baf104ecdb43", "4c76f7bf28b06271a12fb9e9388218865148ab02", "ae3bc161ff5ed16506b3477a4849544c236af2b7", "3beeaccf18ab585e7525ad976cd66b77646aca68", "43ebb19328d4621eaf3000050090a487852be78a", "c0ed42e7589532849a14bc6631b2f687183eae91", "8d8808a9835d746ee9374ab6b31ab7805ef7291b", "b5b780ec9c255f2bc5827bd0785f337617926e8e", "aa81485ddf30e9db4bb7426b2314f02f7e13ca18", "79f8d2624b6308e6a61bbaa8a349cbcdf9f38192", "eb9fc716b9d697d9ecc669e7078331c684667666", "7dd9a1f4fb431b88dd0c4d2baff63b1306fa4055", "f508b9040020b840ba1b958665156da707991142", "72db7cdd474f28db48d54219d99248e0c43f6239", "3dcb69080aff548168116024da16feae435ea1fb", "33396944fd25fa9fa75338d8fb2b9c52b64882ad", "7050c8e076befe1f204cfb9ac4a35542e4612d86", "335e12ef5e58da1621cde3b45da9f32103df76db", "3ecb0999739637cb33f01d01fb4df0abc815379f", "4158ca948de792c32723a711fe0046e2d28d0f29", "24780cc4865014c0f8d6a4ec99e810e42f1c2804", "de639f400909fdcf7b82be43fdc4728baa01fafa", "c1b673ddee619255f9a1169e34e8bbf98f416229", "0bb20adddaaf6f612a80183a5ec9eda9f8e55c37", "0f51239e5f43d68cae2370ca4e403965d1cda63b", "24e934fa53cbedcee32e3fe76f451208abd4cae8", "88a18403528fa7d65d82417f1ab735d8a7a298a4", "09dff3d7d01722585da721f72fafc06008db9a4b"], "user": "asilaghi@mozilla.com"}, "45458": {"changesets": [{"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074033: Override shared application data directories in xpcshell tests. r=ahal,win-reviewers,migration-reviewers,jhirsch,mconley,handyman\" for causing xpchsell tests failures at relative_profile_path.js\n\nThis reverts commit 09dff3d7d01722585da721f72fafc06008db9a4b.\n", "files": ["browser/components/backup/tests/xpcshell/head.js", "browser/components/backup/tests/xpcshell/test_BackupService_enable_disable_encryption.js", "browser/components/migration/tests/unit/head_migration.js", "browser/components/shell/test/unit/test_customIconManager.js", "testing/xpcshell/runxpcshelltests.py", "toolkit/components/backgroundtasks/BackgroundTasksTestUtils.sys.mjs", "toolkit/profile/test/xpcshell/head.js", "toolkit/profile/test/xpcshell/test_invalid_descriptor.js", "toolkit/xre/nsXREDirProvider.cpp", "widget/windows/tests/unit/test_windows_alert_service.js"], "git_node": "66b70484481af2e01d4da8bb33f4a756aba77d74", "git_parents": ["09dff3d7d01722585da721f72fafc06008db9a4b"], "node": "95ac3488e2e8f022279f90cf01e22920ac32d1ff", "parents": ["612ef2035f5dcaef564b694f6526143aaefc0ea8"], "tags": []}], "date": 1790804713, "git_changesets": ["66b70484481af2e01d4da8bb33f4a756aba77d74"], "user": "asilaghi@mozilla.com"}, "45459": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076531 - Part 1 - Add a helper to emit build markers from Python. r=firefox-build-system-reviewers,ahochheiden\n\nmach build turns BUILDSTATUS lines printed by the commands it runs into\nmarkers in the resource usage profile. Add a build_marker context\nmanager to emit markers spanning steps that happen within a single\ncommand, which can take a long time without emitting any output.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329953\n", "files": ["python/mozbuild/mozbuild/build_markers.py"], "git_node": "9b1535ff1cb4d54bcebe5494f38fd609ecd4ab78", "git_parents": ["09dff3d7d01722585da721f72fafc06008db9a4b"], "node": "5bb87bd5982203ea4cece11d7ae438693de320f7", "parents": ["612ef2035f5dcaef564b694f6526143aaefc0ea8"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076531 - Part 2 - Download and process artifacts concurrently in mach artifact install. r=firefox-build-system-reviewers,ahochheiden\n\nThe artifacts were downloaded, processed and installed one after the\nother. Download and process them concurrently, and only install them\nsequentially, in the original order, since later artifacts can\noverwrite files from earlier ones.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329801\n", "files": ["python/mozbuild/mozbuild/artifact_cache.py", "python/mozbuild/mozbuild/artifacts.py"], "git_node": "7bc18c5ee4675cd6c0f50121b31382a07698449a", "git_parents": ["9b1535ff1cb4d54bcebe5494f38fd609ecd4ab78"], "node": "ce9aabd27c6210561800a462457118c2a56e9bb6", "parents": ["5bb87bd5982203ea4cece11d7ae438693de320f7"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076531 - Part 3 - Add markers for mach artifact install to the build resource usage profile. r=firefox-build-system-reviewers,ahochheiden\n\nmach artifact install can spend a long time finding, downloading,\nprocessing and installing artifacts without any output. Emit BUILDSTATUS\nmarkers around those steps, as well as around mach startup, setting up\nthe Artifacts object, listing recent revisions from the VCS, and\nquerying the pushlog, so they show up in the resource usage profile of\nmach build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329802\n", "files": ["python/mozbuild/mozbuild/artifact_cache.py", "python/mozbuild/mozbuild/artifact_commands.py", "python/mozbuild/mozbuild/artifacts.py"], "git_node": "a7e2233d12ec626635182039d80131645ac3a8a0", "git_parents": ["7bc18c5ee4675cd6c0f50121b31382a07698449a"], "node": "4e63c868178360e1813e0753aa0a406583d9393b", "parents": ["ce9aabd27c6210561800a462457118c2a56e9bb6"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076531 - Part 4 - Don't unpack symbols in artifact builds that upload them directly. r=firefox-build-system-reviewers,ahochheiden\n\nWhen UPLOAD_DIR is set, the downloaded symbols archive is copied there\nfor upload, and nothing uses the symbols unpacked in dist/ since\nbuildsymbols doesn't run in automation artifact builds. Unpacking them\nstill meant writing ~2.7GB of symbol files to disk. Stop processing and\ninstalling the archive in that case.\n\nThis also makes the copy happen when a processed version of the archive\nis already cached, which previously skipped it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329803\n", "files": ["python/mozbuild/mozbuild/artifacts.py"], "git_node": "7cfeadb0f8263b6b357a4deed70ed5c11c1cf684", "git_parents": ["a7e2233d12ec626635182039d80131645ac3a8a0"], "node": "3fc8260b5ec085d7142b8e31f67b33416891d315", "parents": ["4e63c868178360e1813e0753aa0a406583d9393b"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076531 - Part 5 - Try the most recent public revision before querying more of the pushlog. r=firefox-build-system-reviewers,ahochheiden\n\nTo find candidate pushheads, mach artifact install queried each\ncandidate tree for the push containing the most recent public revision,\nand then the 50 pushes before it, before looking up artifacts for any of\nthem. But that revision is often itself a pushhead, in which case its\nartifacts are the ones that end up being used, and the other requests\nare wasted: in automation, the first request found it, and the three\nothers took ~3.5s.\n\nYield that revision as soon as the pushlog says it's a pushhead, and\nonly query more of the pushlog if it doesn't have artifacts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329804\n", "files": ["python/mozbuild/mozbuild/artifacts.py", "python/mozbuild/mozbuild/test/test_artifacts.py"], "git_node": "6ec09cf2ea9e7e9dba84b193681696a3aabfa4d0", "git_parents": ["7cfeadb0f8263b6b357a4deed70ed5c11c1cf684"], "node": "6820b9a98e00018926e10907117cc49966a48fe6", "parents": ["3fc8260b5ec085d7142b8e31f67b33416891d315"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076531 - Part 6 - Store package and test files uncompressed in processed artifacts. r=firefox-build-system-reviewers,ahochheiden\n\nProcessed artifacts are only a local cache of the files mach artifact\ninstall extracts into dist/, but the package and test files in them were\nrecompressed with deflate, which is slow, only for them to be\ndecompressed again right after: processing the linux64 package took\n14.6s, of which ~6s was compressing libxul.so, and processing the tests\narchive took 5.6s. Storing them uncompressed brings that down to 7.4s\nand 0.8s, at the cost of larger cached files (~300MB and ~260MB instead\nof ~115MB and ~75MB).\n\nSymbols archives are left alone: their entries are copied without being\nrecompressed.\n\nAlso double the size limit of the artifact cache, so that it keeps about\nas many builds' artifacts as before (a linux64 build's package and tests\ntake ~740MB in the cache with this change, instead of ~375MB).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329805\n", "files": ["python/mozbuild/mozbuild/artifact_cache.py", "python/mozbuild/mozbuild/artifacts.py"], "git_node": "25c1279913d389a7f0e41fb7efc2214dbb95143f", "git_parents": ["6ec09cf2ea9e7e9dba84b193681696a3aabfa4d0"], "node": "d157a8a300a496fdfa25e57d6b80d489a3186639", "parents": ["6820b9a98e00018926e10907117cc49966a48fe6"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076531 - Part 7 - Read Linux package artifacts sequentially. r=firefox-build-system-reviewers,ahochheiden\n\nProcessing the Linux package went through UnpackFinder(TarFinder(...)),\nwhich reads the whole tar to index it, and then opens and parses every\nomni.ja, manifest and xpi in it, seeking around in the xz stream to do\nso, which restarts decompression. None of the files we keep are inside\njars, so all of that is unnecessary: reading the archive sequentially\nonly requires decompressing it once, which takes processing the linux64\npackage from ~7.5s down to ~4s, with identical results.\n\nThe cost of the TarFinder and UnpackFinder steps was found thanks to\nprofiler markers in a WIP patch by Florian Qu\u00e8ze.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329806\n", "files": ["python/mozbuild/mozbuild/artifacts.py"], "git_node": "64cefbda85bb9d00e8a927b04f8e2ea6368a55bb", "git_parents": ["25c1279913d389a7f0e41fb7efc2214dbb95143f"], "node": "b931afd02d03c9bd849d86652da9b848c464b53e", "parents": ["d157a8a300a496fdfa25e57d6b80d489a3186639"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076531 - Part 8 - Log the duration of mach artifact install steps, and add more markers. r=firefox-build-system-reviewers,ahochheiden\n\nMarkers are only emitted under mach build. Also log how long each step\ntook at debug level, so that the information is available with\n`mach artifact install -v` too. And add markers for copying symbols to\nthe upload directory, and for each file extracted from Linux packages.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329807\n", "files": ["python/mozbuild/mozbuild/artifact_cache.py", "python/mozbuild/mozbuild/artifact_commands.py", "python/mozbuild/mozbuild/artifacts.py"], "git_node": "ecc0ff1e262d46fca946144b131fc7309d98c63e", "git_parents": ["64cefbda85bb9d00e8a927b04f8e2ea6368a55bb"], "node": "f949a9eade9d193a864757c4c1506f6fe87473fc", "parents": ["b931afd02d03c9bd849d86652da9b848c464b53e"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076531 - Part 9 - Add markers for the Windows installer repackaging steps. r=firefox-build-system-reviewers,ahochheiden\n\nBuilding the Windows installer at the end of the package tier takes ~80s\nin win64 builds, most of it compressing the package with 7-Zip, but it\nonly showed up as a gap in the resource usage profile. Add markers for\nthe repackaging, and for unpacking the package, running UPX and running\n7-Zip.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329954\n", "files": ["python/mozbuild/mozbuild/action/exe_7z_archive.py", "python/mozbuild/mozbuild/repackaging/installer.py"], "git_node": "9a0b75bfb3bafacebcc202f84de6d35214f811ff", "git_parents": ["ecc0ff1e262d46fca946144b131fc7309d98c63e"], "node": "51435645aa00c1da833af6e657a731aea5d280c3", "parents": ["f949a9eade9d193a864757c4c1506f6fe87473fc"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076531 - Part 10 - Fix ruff UP031 warnings in mach artifact and installer repackaging code. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329955\n", "files": ["python/mozbuild/mozbuild/artifact_commands.py", "python/mozbuild/mozbuild/artifacts.py", "python/mozbuild/mozbuild/repackaging/installer.py"], "git_node": "227930e227a39099dae01ffeeee33702362ec0f7", "git_parents": ["9a0b75bfb3bafacebcc202f84de6d35214f811ff"], "node": "e36173613cd6710e4fa0055d40a1e91369927f2a", "parents": ["51435645aa00c1da833af6e657a731aea5d280c3"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076533 - Define BUILDSTATUS in functions.mk so faster make emits build markers. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329808\n", "files": ["config/makefiles/functions.mk", "config/rules.mk"], "git_node": "3239cc25067843f6e781bd8c826a6bb59e15bddc", "git_parents": ["227930e227a39099dae01ffeeee33702362ec0f7"], "node": "0f3e9c9a3c0306366fa7e3587c925336c22bac20", "parents": ["e36173613cd6710e4fa0055d40a1e91369927f2a"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070272 - Add tooltip strings for the widget menu buttons. r=fluent-reviewers,bolsson\n\nEach widget's menu button gets an \"Open [widget name] menu\" string that sets both the tooltip and the screen reader label. The old strings stay until the follow-up patch switches the widgets over and removes them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329642\n", "files": ["browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "aa3785e8f042603094db4bb2fbe85e87a89f83c5", "git_parents": ["3239cc25067843f6e781bd8c826a6bb59e15bddc"], "node": "f6bdf7b5759cca577ee0ff62329bc2638233635d", "parents": ["0f3e9c9a3c0306366fa7e3587c925336c22bac20"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076824 - Document the address bar's in-process and cross-process paths to the parent controller. r=mbeier,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329999\n", "files": ["browser/components/urlbar/docs/overview.md"], "git_node": "0640b3110d99b2eb0448d900a9e49d4f5a4ac57d", "git_parents": ["aa3785e8f042603094db4bb2fbe85e87a89f83c5"], "node": "32fe135793cf4236c3e821683f39c67186d3f8ce", "parents": ["f6bdf7b5759cca577ee0ff62329bc2638233635d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075453 - Keep Close Window in the File menu with vertical tabs, and label the close item \"Close\" in single-tab windows. r=tabbrowser-reviewers,fluent-reviewers,nsharpley,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329101\n", "files": ["browser/base/content/browser.js", "browser/base/content/test/browser-menubar/browser_file_close_tabs.js", "browser/components/tabbrowser/content/tab-bar-visibility.js", "browser/locales/en-US/browser/menubar.ftl", "browser/locales/en-US/browser/tabbrowser.ftl"], "git_node": "64e6c58a1f3ceb9a558895582465f67fcb29f650", "git_parents": ["0640b3110d99b2eb0448d900a9e49d4f5a4ac57d"], "node": "db05c952a16cb3bd34b4757d0dcf7e418fe2c864", "parents": ["32fe135793cf4236c3e821683f39c67186d3f8ce"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2074009 - Ignore early default-browser updates in TelemetryEnvironment; r=TravisLong\n\nReturn early from `_updateDefaultBrowser()` before session restore, following\nthe pattern used by `_updateSearchEngine()`. Log ignored calls instead of\nassigning `null` to `isDefaultBrowser`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329972\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs"], "git_node": "2f6dea86ff7bf8a360de1513a5edf01eaf6368d1", "git_parents": ["64e6c58a1f3ceb9a558895582465f67fcb29f650"], "node": "9a9ba6e7119f5a2340217372b78dbda381748c8a", "parents": ["db05c952a16cb3bd34b4757d0dcf7e418fe2c864"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2074009 - Record browser.default_at_launch after the delayed default-browser check; r=TravisLong\n\nThe metric is recorded before session restore, when the default-browser value\nis not yet available, and is not updated when the delayed check completes.\n\nMove the Glean write into `_updateDefaultBrowser()` so it records the check\u2019s\nresult after session restore. Add a test assertion that the metric contains a\nboolean.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329973\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js"], "git_node": "687d92e91cf592fe1faacf47de49f5517d5402bd", "git_parents": ["2f6dea86ff7bf8a360de1513a5edf01eaf6368d1"], "node": "95365cb6f4cc913ee94ab7c2ad6333014d9eae2c", "parents": ["9a9ba6e7119f5a2340217372b78dbda381748c8a"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2072436 - remove redirectTo API from HTTP child r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329776\n", "files": ["netwerk/ipc/NeckoChannelParams.ipdlh", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpBaseChannel.h", "netwerk/protocol/http/HttpChannelChild.cpp", "netwerk/protocol/http/HttpChannelParent.cpp", "netwerk/protocol/http/HttpChannelParent.h", "netwerk/protocol/http/PHttpChannel.ipdl", "netwerk/protocol/http/nsIHttpChannelInternal.idl"], "git_node": "1048a343e4bbe40e1fcd1b301127f9854bf062c8", "git_parents": ["687d92e91cf592fe1faacf47de49f5517d5402bd"], "node": "874cb9f122682bb1e017908ad3defa90d90d4ecc", "parents": ["95365cb6f4cc913ee94ab7c2ad6333014d9eae2c"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2076807 - Use moz-src for dom/base r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329971\n", "files": ["devtools/client/webconsole/test/browser/browser_console_eager_eval_resolve.js", "dom/base/components.conf", "dom/base/moz.build", "dom/push/PushDB.sys.mjs", "dom/system/NetworkGeolocationProvider.sys.mjs", "toolkit/modules/Region.sys.mjs", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "a98c3772d2fb9b646efc20a92b7d658f0c79c061", "git_parents": ["1048a343e4bbe40e1fcd1b301127f9854bf062c8"], "node": "fe045981b4873b391f47455b796bacd30913444c", "parents": ["874cb9f122682bb1e017908ad3defa90d90d4ecc"], "tags": []}, {"author": "virsworld \u003cvirpatel71@gmail.com\u003e", "branch": "default", "desc": "Bug 2073614 - Add a StyleZoom field to TransformReferenceBox. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329883\n", "files": ["gfx/layers/AnimationInfo.cpp", "layout/generic/nsIFrame.cpp", "layout/painting/ActiveLayerTracker.cpp", "layout/painting/nsDisplayList.cpp", "layout/style/StyleAnimationValue.cpp", "layout/style/nsComputedDOMStyle.cpp", "layout/style/nsStyleTransformMatrix.cpp", "layout/style/nsStyleTransformMatrix.h", "layout/svg/SVGUtils.cpp"], "git_node": "68ee9bc48a58955957b38e8b03135e752e3e379c", "git_parents": ["a98c3772d2fb9b646efc20a92b7d658f0c79c061"], "node": "ca8f4de734a6a5db96567f819ebdff04a9067c4f", "parents": ["fe045981b4873b391f47455b796bacd30913444c"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2076450 - Copy non-normalized upload streams in larger segments. r=necko-reviewers,valentin\n\nSize the NormalizeUploadStream copy to the upload length, capped by network.http.upload_copy_max_segment_size (64 KiB on Nightly, 4 KiB elsewhere), to cut DataPipe round-trips between the content and parent processes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329965\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": "b633f81f5d6f4ac99e1ea63ac415454bb2d005e2", "git_parents": ["68ee9bc48a58955957b38e8b03135e752e3e379c"], "node": "f487e0a9e0dfc0a5df2c7357d1744fef02b1dce6", "parents": ["ca8f4de734a6a5db96567f819ebdff04a9067c4f"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055094 - Remove Fxa-Tokens on Error rather then after use r=ip-protection-reviewers,apopov\n\nRN IP-Protections destroys fxa-tokens after use, we should rather do that after guardian\nhas told us they are not valid.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316980\n", "files": ["toolkit/components/ipprotection/GuardianTypes.sys.mjs", "toolkit/components/ipprotection/enterprise/IPPEnterpriseAuthProvider.sys.mjs", "toolkit/components/ipprotection/fxa/GuardianClient.sys.mjs", "toolkit/components/ipprotection/fxa/IPPAndroidAuthProvider.sys.mjs", "toolkit/components/ipprotection/fxa/IPPFxaActivateAuthProvider.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_GuardianClient.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPPFxaActivateAuthProvider.js"], "git_node": "ab8c90736428ecddae31a66d580ce24d32ca892b", "git_parents": ["b633f81f5d6f4ac99e1ea63ac415454bb2d005e2"], "node": "43b686cc9a8985c4bcf36f5a6a9c06a2efd1b34a", "parents": ["f487e0a9e0dfc0a5df2c7357d1744fef02b1dce6"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Hide duplicated tasks from `mach try fuzzy` unless `--include-duplicates` is passed r=nalexander\n\nThe `-appservices-in-tree` copies have `run_on_projects: []`, but\npresets with `full: true` such as `android-frontend` still matched them\nby name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329966\n", "files": ["tools/tryselect/selectors/fuzzy.py", "tools/tryselect/test/test_fuzzy.py"], "git_node": "38310cee55294883edbec75046183d37ad857b7b", "git_parents": ["ab8c90736428ecddae31a66d580ce24d32ca892b"], "node": "ce04ea2fbf3dcd4a0eecc2f7a04adbbc30a1038c", "parents": ["43b686cc9a8985c4bcf36f5a6a9c06a2efd1b34a"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2076848 - Adjust rust policy docs to reflect the expected MSRV and Use versions. r=firefox-build-system-reviewers,ahochheiden DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330013\n", "files": ["docs/writing-rust-code/update-policy.md"], "git_node": "252a7d931074adf93262adf1e06613a231bae03f", "git_parents": ["38310cee55294883edbec75046183d37ad857b7b"], "node": "83ddcbb34f1fcc1f7bdbea7bcb3a252def06ee32", "parents": ["ce04ea2fbf3dcd4a0eecc2f7a04adbbc30a1038c"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071417 - Use new declarative web push parser for telemetry if pref is enabled. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329648\n", "files": ["dom/push/Declarative.cpp", "dom/push/rust/src/declarative_push.rs", "dom/serviceworkers/ServiceWorkerEvents.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/mozilla/meta/push-api/declarative-glean.https.any.js.ini", "testing/web-platform/mozilla/tests/push-api/declarative-glean.https.any.js"], "git_node": "889e3e0ed7f5af4aa6c188bc38b88e51e8d7ae79", "git_parents": ["252a7d931074adf93262adf1e06613a231bae03f"], "node": "bf2b19ff324e7197f218e4216fd63f5e5a961d32", "parents": ["83ddcbb34f1fcc1f7bdbea7bcb3a252def06ee32"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2076703 - Use the promise overload of LoadRequestedModules for dynamic import in the js shell. r=jonco\n\nThis makes the import() in the js shell executes asynchrounsly, which\nenables testing with relazified scrips while the import is still pending.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329961\n", "files": ["js/src/jit-test/modules/dynamic-import-relazifiable-referrer.js", "js/src/jit-test/tests/modules/bug-2014283.js", "js/src/shell/ModuleLoader.cpp", "js/src/shell/ModuleLoader.h"], "git_node": "22d4ab0a0c314e01e2369d2d6b942dba463a4a36", "git_parents": ["889e3e0ed7f5af4aa6c188bc38b88e51e8d7ae79"], "node": "90ca6e94723ceca56ada863360a75fbb1274b01e", "parents": ["bf2b19ff324e7197f218e4216fd63f5e5a961d32"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074033: Override shared application data directories in xpcshell tests. r=ahal,win-reviewers,migration-reviewers,jhirsch,mconley,handyman\" for causing xpchsell tests failures at relative_profile_path.js\n\nThis reverts commit 09dff3d7d01722585da721f72fafc06008db9a4b.\n", "files": ["browser/components/backup/tests/xpcshell/head.js", "browser/components/backup/tests/xpcshell/test_BackupService_enable_disable_encryption.js", "browser/components/migration/tests/unit/head_migration.js", "browser/components/shell/test/unit/test_customIconManager.js", "testing/xpcshell/runxpcshelltests.py", "toolkit/components/backgroundtasks/BackgroundTasksTestUtils.sys.mjs", "toolkit/profile/test/xpcshell/head.js", "toolkit/profile/test/xpcshell/test_invalid_descriptor.js", "toolkit/xre/nsXREDirProvider.cpp", "widget/windows/tests/unit/test_windows_alert_service.js"], "git_node": "4b4f451be142a679a290dfe0f13560ad5924eae1", "git_parents": ["22d4ab0a0c314e01e2369d2d6b942dba463a4a36"], "node": "b75d69875877482fd517af4576e0687afea624d7", "parents": ["90ca6e94723ceca56ada863360a75fbb1274b01e"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075383 - Restore section_position telemetry for newtab_content impression and click events. r=jbrown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329041\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/CardSections/CardSections.jsx", "browser/extensions/newtab/lib/NewTabContentPing.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/CardSections.test.jsx", "browser/extensions/newtab/test/xpcshell/test_NewTabContentPing.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "ad675b818f4cf36157f81de83acdfb47eaf4e640", "git_parents": ["4b4f451be142a679a290dfe0f13560ad5924eae1"], "node": "bcb5e2f62b5fd71fe40c9754ce877307d533536e", "parents": ["b75d69875877482fd517af4576e0687afea624d7"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074671 - Offer a Mini Window chooser on the Screenshots overlay. r=mconley,fluent-reviewers,desktop-theme-reviewers,emilio,flod,jhirsch\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328306\n", "files": ["browser/components/miniwindow/assets/mini-window.svg", "browser/components/miniwindow/jar.mn", "browser/components/miniwindow/moz.build", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_chooser_panel.js", "browser/components/miniwindow/test/browser/browser_region_entry.js", "browser/components/screenshots/ScreenshotsOverlayChild.sys.mjs", "browser/components/screenshots/ScreenshotsUtils.sys.mjs", "browser/components/screenshots/overlay/overlay.css", "browser/components/screenshots/screenshots-buttons.css", "browser/components/screenshots/screenshots-buttons.js", "browser/components/screenshots/tests/browser/browser_mini_window_mode.js", "browser/locales-preview/miniWindow.ftl", "browser/themes/shared/toolbarbutton-icons.css"], "git_node": "1686db87cdc40edfbbeb3bcfca075d4505eae2db", "git_parents": ["ad675b818f4cf36157f81de83acdfb47eaf4e640"], "node": "67b85b46cba1d703f797a237d8e13268485cf70f", "parents": ["bcb5e2f62b5fd71fe40c9754ce877307d533536e"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075266 - Let a mini window's toolbar hide while the window is inactive. r=desktop-theme-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328869\n", "files": ["browser/themes/shared/browser-shared.css"], "git_node": "3b81422705e5bb08d591e08efdff012afd94c9db", "git_parents": ["1686db87cdc40edfbbeb3bcfca075d4505eae2db"], "node": "8b360c04afe113c972cf443f7d066872ca8f6f2d", "parents": ["67b85b46cba1d703f797a237d8e13268485cf70f"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076534 - Part 1 - Only validate the webcompat intervention schema once. r=webcompat-reviewers,twisniewski\n\njsonschema.validate checks the schema itself against the metaschema on\nevery call, which is most of the time spent loading each intervention\nJSON file. Generating run.js loads all ~410 of them, and took 7.7s\nlocally; with the validator built once and reused, it takes 0.27s.\n\nErrors are still reported with best_match(), as jsonschema.validate\ndoes, rather than with the validator's own validate() method: the latter\nraises the first error it finds, which is often a less specific one\n(e.g. \"... is not valid under any of the given schemas\"), and the\nwebcompat build tests check for the more specific messages.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329811\n", "files": ["browser/extensions/webcompat/codegen.py"], "git_node": "085544e5a57ba3eaa51bae02b3f72eef6258a4dc", "git_parents": ["3b81422705e5bb08d591e08efdff012afd94c9db"], "node": "c0c5f1d6f24cb9f9c71ffd5bd546e0c93e7b4396", "parents": ["8b360c04afe113c972cf443f7d066872ca8f6f2d"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076534 - Part 2 - Generate all webcompat intervention files in a single pass. r=webcompat-reviewers,twisniewski\n\nEach generated intervention file used to be a separate GeneratedFile,\nso the build ran codegen.py once per file (332 Python processes on\ndesktop), each re-reading every intervention JSON. Generate them from\nthe same pass that produces run.js instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329812\n", "files": ["browser/extensions/webcompat/codegen.py", "browser/extensions/webcompat/generate_files.mozbuild"], "git_node": "9ffd044c69183014682ec077436029da5b2e9e30", "git_parents": ["085544e5a57ba3eaa51bae02b3f72eef6258a4dc"], "node": "5508de544cdbd1e2e3116a4bca6264b802e1fb8a", "parents": ["c0c5f1d6f24cb9f9c71ffd5bd546e0c93e7b4396"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076590 - Update NSS to 824793aca473a0bb4a9dc3d4a88a6d0f2786bd7b UPGRADE_NSS_RELEASE r=ai4dev-reviewers,padenot,nkulatova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329842\n", "files": ["security/nss/CLAUDE.md", "security/nss/auto