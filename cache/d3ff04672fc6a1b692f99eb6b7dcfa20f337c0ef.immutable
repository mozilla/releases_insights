or/test/new-resend-request/browser_net_edit_resend_xhr.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_new_request_panel_clear_button.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_new_request_panel_content-length.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_new_request_panel_context_menu.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_new_request_panel_send_request.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_new_request_panel_sync_url_params.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_resend.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_resend_csp.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_resend_xhr.js", "devtools/client/netmonitor/test/websockets/browser_net-ws-filter-freetext.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-basic.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-clear.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-connection-closed.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-copy-binary-message.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-early-connection.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-filter-dropdown.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-filter-regex.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-json-action-cable-payload.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-json-payload.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-json-stomp-payload.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-jsonl-payload.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-keep-future-frames.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-limit-frames.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-limit-payload.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-messages-navigation.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-sockjs-stomp-payload.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-sse-persist-columns.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-stomp-payload.js"], "git_node": "6d6714096b46ec2aaf1b7c91d315397041ed689d", "git_parents": ["0e07800efeef1710e5d1cb4d182a2f9a414bea04"], "node": "327c74f64029c954532574fd34e791a6185470db", "parents": ["03da9cb5e0b39638ed7115d91c20bbcc7ebcd84f"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Select the request with a real click in browser_aboutdebugging_addons_debug_netmonitor.js, r=devtools-reviewers,bomsy,nchevobbe.\n\nThe test selected the request with EventUtils.sendMouseEvent({ type: \"mousedown\" }), a trusted mousedown without a mouseup, which left the mouse button pressed after the test. Click the file cell of the row instead, as the netmonitor tests now do.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329171\n", "files": ["devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_debug_netmonitor.js"], "git_node": "f5bcde5ce5581f4dd83186cec7ae15e42ed12464", "git_parents": ["6d6714096b46ec2aaf1b7c91d315397041ed689d"], "node": "1135d4b3707d56816953eaf584c5e3e35add9394", "parents": ["327c74f64029c954532574fd34e791a6185470db"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075354 - Force-close the SharedWorker MessagePort through MessagePortService when WorkerManagerCreatedRunnable fails, r=dom-core-reviewers,asuth,smaug,dom-worker-reviewers.\n\nWhen a SharedWorker's creating actor goes away before WorkerManagerCreatedRunnable runs, its UniqueMessagePortId was never released and got force-closed on the background thread. MessagePort::ForceClose then created a same-process PBackgroundChild on the background thread itself, which ParentImpl::ShutdownBackgroundThread waits for forever, hanging shutdown at XPCOMShutdownThreads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328958\n", "files": ["dom/workers/sharedworkers/SharedWorkerService.cpp"], "git_node": "16740a67278fc725b83cee4211fc9fbd93172206", "git_parents": ["f5bcde5ce5581f4dd83186cec7ae15e42ed12464"], "node": "d63e602f7dbd993874d6a3c0774ec0d18b46a2a1", "parents": ["1135d4b3707d56816953eaf584c5e3e35add9394"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075354 - Assert when creating a PBackground child on the PBackground thread, r=ipc-reviewers,nika.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328959\n", "files": ["ipc/glue/BackgroundImpl.cpp"], "git_node": "acf367180683e06b38fd88038e452cb4695df5f5", "git_parents": ["16740a67278fc725b83cee4211fc9fbd93172206"], "node": "673e47708e5653bfb4cd3fa8426f49f25287d984", "parents": ["d63e602f7dbd993874d6a3c0774ec0d18b46a2a1"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e e11d6dd4844875e25c277f615f89b226b52bad4e\naf -\u003e e11d6dd4844875e25c277f615f89b226b52bad4e\nan -\u003e e11d6dd4844875e25c277f615f89b226b52bad4e\nar -\u003e e11d6dd4844875e25c277f615f89b226b52bad4e\nast -\u003e e11d6dd4844875e25c277f615f89b226b52bad4e\naz -\u003e e11d6dd4844875e25c277f615f89b226b52bad4e\nbe -\u003e e11d6dd4844875e25c277f615f89b226b52bad4e\nbg -\u003e e11d6dd4844875e25c277f615f89b226b52bad4e\nbn -\u003e e11d6dd4844875e25c277f615f89b226b52bad4e\nbo -\u003e e11d6dd4844875e25c277f615f89b226b52bad4e\nbqi -\u003e e11d6dd4844875e25c277f615f89b226b52bad4e\nbr -\u003e e11d6dd4844875e25c277f615f89b226b52bad4e\nbrx -\u003e e11d6dd4844875e25c277f615f89b226b52bad4e\nbs -\u003e e11d6dd484487