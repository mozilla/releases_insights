"pushes": {"431": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging c685d5844a0e4f99ac535b6ffc641fbd07696c68 with FIREFOX_128_8_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "fdf1696d6856504ee26d17f33004cdb779ba7cd5", "parents": ["c685d5844a0e4f99ac535b6ffc641fbd07696c68"], "tags": []}], "date": 1740416505, "git_changesets": [null], "user": "ffxbld"}, "432": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "740c8301c7deebf52ef4b0b0b5b5fe4b6040f37a", "parents": ["fdf1696d6856504ee26d17f33004cdb779ba7cd5"], "tags": []}], "date": 1740997182, "git_changesets": [null], "user": "ffxbld-merge"}, "433": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging c685d5844a0e4f99ac535b6ffc641fbd07696c68 with FIREFOX_128_8_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "23ee264f68143d46d5f5ece52b84aab86de2ac67", "parents": ["740c8301c7deebf52ef4b0b0b5b5fe4b6040f37a"], "tags": []}], "date": 1741095857, "git_changesets": [null], "user": "ffxbld"}, "434": {"changesets": [{"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 1942551 - WebRTC backport: PipeWire camera: Fix cleanup order  a=pascalc\n\nThe hook is associated with the proxy object. We should remove the hook\nfirst before destroying the proxy object to avoid use-after-free.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: caa8ef3ab511d54dfa486eb7599ef0a74f7471ee\n\nOriginal Revision: https://phabricator.services.mozilla.com/D239886\n\nDifferential Revision: https://phabricator.services.mozilla.com/D240592", "files": ["third_party/libwebrtc/modules/video_capture/linux/pipewire_session.cc", "third_party/libwebrtc/moz-patch-stack/caa8ef3ab5.no-op-cherry-pick-msg"], "git_node": null, "git_parents": [null], "node": "37e9479f210b249584e7245a35009546897c595c", "parents": ["23ee264f68143d46d5f5ece52b84aab86de2ac67"], "tags": []}], "date": 1741269718, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "435": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D240608", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "2e9edfc0eb1fee3a601428c112e0316a8050a3ed", "parents": ["37e9479f210b249584e7245a35009546897c595c"], "tags": []}], "date": 1741270730, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "436": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1945654: install unzip on the update verify docker image  a=pascalc\n\nThis is just the strictly necessary part of https://phabricator.services.mozilla.com/D236625\n\nDifferential Revision: https://phabricator.services.mozilla.com/D237611", "files": ["taskcluster/docker/update-verify/Dockerfile"], "git_node": null, "git_parents": [null], "node": "141e03340d0e9a42ed6f4d7e08ab5e5df0aaa61b", "parents": ["2e9edfc0eb1fee3a601428c112e0316a8050a3ed"], "tags": []}], "date": 1741272173, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "437": {"changesets": [{"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950282 - add a UA override for f1tv.formula1.com on ESR128;  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D240268", "files": ["browser/extensions/webcompat/data/injections.js", "browser/extensions/webcompat/data/ua_overrides.js", "browser/extensions/webcompat/injections/js/bug1950282-formula1.com-platform-linux-fix.js", "browser/extensions/webcompat/manifest.json", "browser/extensions/webcompat/moz.build"], "git_node": null, "git_parents": [null], "node": "980604e33c4a50f78ab07ddcb1b65f43222a74c8", "parents": ["141e03340d0e9a42ed6f4d7e08ab5e5df0aaa61b"], "tags": []}], "date": 1741273259, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "438": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "No bug - reduce fuzziness of moz-icon-blank-1-almostref.html after Windows testing machines update. a=test-expection", "files": ["image/test/reftest/generic/reftest.list"], "git_node": null, "git_parents": [null], "node": "e73051c787783f31a528b969eed5183a337f1679", "parents": ["980604e33c4a50f78ab07ddcb1b65f43222a74c8"], "tags": []}], "date": 1741280314, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "439": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D240843", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "63b28cb22ac8362e8e3b496f6f59a5519347