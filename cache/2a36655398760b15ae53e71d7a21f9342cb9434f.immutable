43, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "458": {"changesets": [{"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1954323: Cache DateTimeFormat for Date.prototype.toLocaleString when locales argument is used. r=tcampbell a=pascalc\n\nSupport using a cached `Intl.DateTimeFormat` when `locales` is a string.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242636", "files": ["js/src/builtin/Date.js"], "git_node": null, "git_parents": [null], "node": "76f59a9f2161a539a9b6b000fcb7205e8d007b11", "parents": ["78008b30d7549832e9267f4ad70687be09e8e234"], "tags": ["FIREFOX_128_9_0esr_BUILD1"]}], "date": 1742825610, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "459": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 76f59a9f2161a539a9b6b000fcb7205e8d007b11 with FIREFOX_128_9_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "1b50058462409202a6bc402425ea2c7d0c6cc67a", "parents": ["76f59a9f2161a539a9b6b000fcb7205e8d007b11"], "tags": []}], "date": 1742909249, "git_changesets": [null], "user": "ffxbld"}, "460": {"changesets": [{"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918118 - Cache parsing of glean metrics r=mkmelin a=pascalc\n\nGlean metrics are described in yaml, which is notably slow to parse.\nInstead of repeatedly parsing the same metrics again and again, cache\nthe parsing result.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242930", "files": ["toolkit/components/glean/build_scripts/glean_parser_ext/cache_yaml.py", "toolkit/components/glean/build_scripts/glean_parser_ext/run_glean_parser.py", "toolkit/components/glean/moz.build"], "git_node": null, "git_parents": [null], "node": "1679d5c000eb5b7acde30c230c70ef609521e579", "parents": ["1b50058462409202a6bc402425ea2c7d0c6cc67a"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1931277 - [128esr] glean-parser PR: Support for Configuring a Subset of Interesting Metrics to Collect. r=TravisLong a=pascalc\n\nApply https://github.com/mozilla/glean_parser/pull/774\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242675", "files": ["third_party/python/glean_parser/glean_parser/parser.py"], "git_node": null, "git_parents": [null], "node": "76a6a702652ca9a776769d907a21dff664664b10", "parents": ["1679d5c000eb5b7acde30c230c70ef609521e579"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1931277 - [128esr] Support for Configuring a Subset of Interesting Metrics to Collect. r=TravisLong a=pascalc\n\nNeeds https://github.com/mozilla/glean_parser/pull/774\n\nThis is an 128esr version of D228971\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242676", "files": ["toolkit/components/glean/build_scripts/glean_parser_ext/cache_yaml.py", "toolkit/components/glean/build_scripts/glean_parser_ext/run_glean_parser.py", "toolkit/components/glean/moz.build", "toolkit/components/glean/tests/pytest/metrics2_test.yaml", "toolkit/components/glean/tests/pytest/metrics_test_output", "toolkit/components/glean/tests/pytest/metrics_test_output_cpp", "toolkit/components/glean/tests/pytest/metrics_test_output_js_cpp", "toolkit/components/glean/tests/pytest/metrics_test_output_js_h", "toolkit/components/glean/tests/pytest/test_gifft.py", "toolkit/components/glean/tests/pytest/test_glean_parser_cpp.py", "toolkit/components/glean/tests/pytest/test_glean_parser_js.py", "toolkit/components/glean/tests/pytest/test_glean_parser_rust.py", "toolkit/components/glean/tests/pytest/test_jogfile_output.py"], "git_node": null, "git_parents": [null], "node": "966b5fade8db92893f294ae184d9ab4365d8f609", "parents": ["76a6a702652ca9a776769d907a21dff664664b10"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1942797 - Generate a serverknobs config for all uninteresting metrics. r=mkmelin a=pascalc\n\nIn certain builds we pass a list of \"interesting\" metrics.\nEverything not on that list is marked as disabled.\n\nFor tests however we want to keep all defined metrics enabled.\nWe use serverknobs to control that.\n\nAt build time we build a serverknobs config using all \"uninteresting\"\nmetrics and enable them.\nThis config would then need to be applied at runtime when in tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242914", "files": ["toolkit/components/glean/build_scripts/glean_parser_ext/interesting_serverknobs.py", "toolkit/components/glean/moz.build"], "git_node": null, "git_parents": [null], "node": "4236e7dfbbf2c4cca9264085a4902b9371b8d2a2", "parents": ["966b5fade8db92893f294ae184d9ab4365d8f609"], "tags": []}, {"author": "Travis Long \u003ctlong@mozilla.com\u003e", "branch": "default", "desc": "Bug 1942797 - Apply interesting_serverknobs.json when running in automation. r=mkmelin a=pascalc\n\nFor non-Firefox builds, automatically apply interesting_serverknobs.json when running tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242915", "files": ["toolkit/components/glean/src/lib.rs", "toolkit/components/glean/tests/xpcshell/xpcshell.toml", "toolkit/components/glean/xpcom/FOG.cpp", "toolkit/components/glean/xpcom/FOG.h"], "git_node": null, "git_parents": [null], "node": "68fdca788712c73a96a791b97607f0481c78a82e", "parents": ["4236e7dfbbf2c4cca9264085a4902b9371b8d2a2"], "tags": []}], "date": 1743003084, "git_changesets": [null, null, null, null, null], "user": "pchevrel@mozilla.com"}, "461": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_8_X_RELBRANCH", "desc": "No bug - Bump version to 128.8.1 a=me", "files": ["browser/config/v