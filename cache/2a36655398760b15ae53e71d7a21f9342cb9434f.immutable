"parents": ["e837eef79733635597511bd0916b1a9f0341b00c"], "tags": []}], "date": 1741765461, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "443": {"changesets": [{"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 1952706 - Exporting key material takes not SRTP_MAX_KEY_LENGTH but the actual size  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D240788\n\nDifferential Revision: https://phabricator.services.mozilla.com/D241186", "files": ["dom/media/webrtc/transport/transportlayersrtp.cpp"], "git_node": null, "git_parents": [null], "node": "4eed0df7156378770415565e1fea4cf8a0b01240", "parents": ["2e2507a55cb7b4da39da4c82e2d4e205860ba138"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1952706: Disable DTLS 1.3 in webrtc  a=pascalc\n\nWe had a mistake in our key calculation that when fixed renders our DTLS 1.3\nimplementation non-interoperable with previous versions of Firefox. We need to\ndisable DTLS 1.3 until the fix is present on all supported versions of Firefox.\n\nThe change also broke some glean tests, which are now fixed.\n\nAlso, remove a glean test that was trying to set static prefs.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D240934\n\nDifferential Revision: https://phabricator.services.mozilla.com/D241187", "files": ["dom/media/webrtc/tests/mochitests/test_peerConnection_glean.html", "modules/libpref/init/all.js"], "git_node": null, "git_parents": [null], "node": "750a9a019dcb2d44aaf6b6fd4c39ec0bd6d8a33d", "parents": ["4eed0df7156378770415565e1fea4cf8a0b01240"], "tags": []}], "date": 1741862722, "git_changesets": [null, null], "user": "pchevrel@mozilla.com"}, "444": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1850615 Share the same libva handle across all FFmpegVideoDecoders  a=pascalc\n\nRebased from https://hg.mozilla.org/mozilla-central/rev/b34601c7751d\n\nDifferential Revision: https://phabricator.services.mozilla.com/D241144", "files": ["dom/media/platforms/ffmpeg/FFmpegLibWrapper.cpp", "dom/media/platforms/ffmpeg/FFmpegLibWrapper.h", "dom/media/platforms/ffmpeg/FFmpegRuntimeLinker.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/VALibWrapper.cpp", "dom/media/platforms/ffmpeg/VALibWrapper.h", "dom/media/platforms/ffmpeg/ffvpx/FFVPXRuntimeLinker.cpp", "dom/media/platforms/ffmpeg/moz.build"], "git_node": null, "git_parents": [null], "node": "bd97520902ba753ac37c7c74c906dc6ef82d3008", "parents": ["750a9a019dcb2d44aaf6b6fd4c39ec0bd6d8a33d"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1850615 Share the same VADisplay across all FFmpegVideoDecoders  a=pascalc\n\nRebased from https://hg.mozilla.org/mozilla-central/rev/9d547b90a407\nwith https://hg.mozilla.org/mozilla-central/rev/47d823d94067\n\nDifferential Revision: https://phabricator.services.mozilla.com/D241145", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/VALibWrapper.cpp", "dom/media/platforms/ffmpeg/VALibWrapper.h"], "git_node": null, "git_parents": [null], "node": "db294085c4823bec5a85e611add30b724b495442", "parents": ["bd97520902ba753ac37c7c74c906dc6ef82d3008"], "tags": []}], "date": 1741864333, "git_changesets": [null, null], "user": "pchevrel@mozilla.com"}, "445": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D241367", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/main/top-sites.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "68a606986e8d1f6c5abee96b132d151040eace82", "parents": ["db294085c4823bec5a85e611add30b724b495442"], "tags": []}], "date": 1741865277, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "446": {"changesets": [{"author": "Fatih Kilic \u003cfkilic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948811: Compare windows instead of tabs to show canvas permission prompt.  a=pascalc\n\nEach window gets the observe call once. gBrowser.selectedBrowser refers to the currently selected tab and we check against that to verify if the target browser instance is in the current window.\n\nThis patch changes it to comparing windows instead of browser instances.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D238974\n\nDifferential Revision: https://phabricator.services.mozilla.com/D241376", "files": ["browser/base/content/browser.js"], "git_node": null, "git_parents": [null], "node": "0e88b0982d8765ca86c20fa0de5b0d2e4707d0b4", "parents": ["68a606986e8d1f6c5abee96b132d151040eace82"], "tags": []}, {"author": "Fatih Kilic \u003cfkilic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948811 - Add test for showing permission prompt when canvas is read in a out of focus tab.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D240926\n\nDifferential Revision: https://phabricator.services.mozilla.com/D241377", "files": ["toolkit/components/resistfingerprinting/tests/browser/browser.toml", "toolkit/components/resistfingerprinting/tests/browser/browser_canvas_randomization_permission_background_load.js"], "git_node": null, "git_parents": [null], "node": "eaabe9fa09fac043082644b9d4253f262f72f7e1", "parents": ["0e88b0982d8765ca86c20fa0de5b0d2e4707d0b4"], "tags": []}], "date": 1742202609, "git_changesets": [null, null], "user": "pchevrel@mozilla.com"}, "447": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D241817", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/translations-models.json"], "git_node": null, "git_parents": [null], "node": "d0a6a8f50280721ff60c03aff20fd3545f29660a", "parents": ["eaabe9fa09fac043082644b9d4253f262f72f7e1"], "tags": []}], "date": 1742288760, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "448": {"changesets": [{"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1952711 - Temporarily disable browser_exslt_timezone_load.js on Windows because of perma failures due to winter hour change. a=test-only DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D240789", "files": ["browser/components/resistfingerprinting/test/browser/browser.toml"], "git_node": null, "git_parents": [null], "node": "c20a08f02f364bf03e127474159cbdbb75b1ecc0", "parents": ["d0a6a8f50280721ff60c03aff20fd3545f29660a"], "tags": []}], "date": 1742415607, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "449": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1954818 - Add intermediate cert used until 2018 - ESR128 port r=jschanck,willdurand a=pascalc\n\nThis patch was modified from the original because this ESR branch\ndoes not include the changes from bug 1914064.\n\nThe certificate was generated from the original in D242073 with:\n\n```\n$ openssl x509 \\\n  -in security/manager/ssl/addons-public-2018-intermediate.pem \\\n  -outform DER \\\n  -out security/manager/ssl/addons-public-2018-intermediate.crt\n```\n\nOriginal Revision: https://phabricator.services.mozilla.com/D242073\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242078", "files": ["security/manager/ssl/AppTrustDomain.cpp", "security/manager/ssl/AppTrustDomain.h", "security/manager/ssl/addons-public-2018-intermediate.crt", "security/manager/ssl/gen_cert_header.py", "security/manager/ssl/moz.build", "toolkit/mozapps/extensions/test/xpcshell/data/signing_checks/disable_ctrl_q_and_cmd_q-1.xpi", "toolkit/mozapps/extensions/test/xpcshell/data/signing_checks/disable_ctrl_q_and_cmd_q-2resigned1.xpi", "toolkit/mozapps/extensions/test/xpcshell/test_signed_verify.js"], "git_node": null, "git_parents": [null], "node": "d709e49a85aac04d14a13cb2f7d496d7d8356548", "parents": ["c20a08f02f364bf03e127474159cbdbb75b1ecc0"], "tags": []}], "date": 1742464641, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "450": {"changesets": [{"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 1953381 - Fix x86 PBLEND optimizations for v128.bitselect. r=jseward a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D241259", "files": ["js/src/jit-test/tests/wasm/regress/bug1953381.js", "js/src/jit-test/tests/wasm/simd/bitselect-x64-ion-codegen.js", "js/src/jit/x86-shared/Lowering-x86-shared.cpp"], "git_node": null, "git_parents": [null], "node": "f4b6f95e39503cb356c42e71fffa0a21e949fbd8", "parents": ["d709e49a85aac04d14a13cb2f7d496d7d8356548"], "tags": []}], "date": 1742468849, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "451": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1932468 - Making EventSourceImpl::mWorkerRef accessing be thread-safe. r=dom-worker-reviewers,asuth a=pascalc\n\nEventSourceImpl::mWorkerRef is not accessed on the Worker thread only.\nWhen EventSourceImpl::Dispatch is called, it could be on any thread, so the race could happen if Worker is shuttdown at the same time.\nThis patch uses DataMutex to protect EventSourceImpl::mWorkerRef.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D239515", "files": ["dom/base/EventSource.cpp"], "git_node": null, "git_parents": [null], "node": "685f34da0f66be4733bdb87e3e17ec38d3a5dac6", "parents": ["f4b6f95e39503cb356c42e71fffa0a21e949fbd8"], "tags": []}], "date": 1742468994, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "452": {"changesets": [{"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1941002 - Clone source. r=smaug a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235577", "files": ["dom/xml/nsXMLPrettyPrinter.cpp", "dom/xslt/xslt/txMozillaStylesheetCompiler.cpp", "dom/xslt/xslt/txMozillaXSLTProcessor.cpp", "dom/xslt/xslt/txMozillaXSLTProcessor.h"], "git_node": null, "git_parents": [null], "node": "d6306c38ade39b3ea02266c9cdbe1f0ad8aa31ef", "parents": ["685f34da0f66be4733bdb87e3e17ec38d3a5dac6"], "tags": []}, {"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1941002 - Make XPath tree walker hold a strong reference. r=smaug a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D237259", "files": ["dom/xslt/xml/txXMLParser.cpp", "dom/xslt/xml/txXMLParser.h", "dom/xslt/xpath/XPathExpression.cpp", "dom/xslt/xpath/XPathResult.cpp", "dom/xslt/xpath/txForwardContext.h", "dom/xslt/xpath/txMozillaXPathTreeWalker.cpp", "dom/xslt/xpath/txNodeSet.cpp", "dom/xslt/xpath/txNodeSet.h", "dom/xslt/xpath/txSingleNodeContext.h", "dom/xslt/xpath/txXPathNode.h", "dom/xslt/xpath/txXPathTreeWalker.h", "dom/xslt/xslt/txEXSLTFunctions.cpp", "dom/xslt/xslt/txExecutionState.cpp", "dom/xslt/xslt/txExecutionState.h", "dom/xslt/xslt/txMozillaXSLTProcessor.cpp", "dom/xslt/xslt/txXSLTPatterns.cpp"], "git_node": null, "git_parents": [null], "node": "11dc6844734881f664c26ce3a062535354d52f7f", "parents": ["d6306c38ade39b3ea02266c9cdbe1f0ad8aa31ef"], "tags": []}, {"aut