 "date": 1742475217, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "607": {"changesets": [{"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1941002 - Clone source. r=smaug a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235577", "files": ["dom/xml/nsXMLPrettyPrinter.cpp", "dom/xslt/xslt/txMozillaStylesheetCompiler.cpp", "dom/xslt/xslt/txMozillaXSLTProcessor.cpp", "dom/xslt/xslt/txMozillaXSLTProcessor.h"], "git_node": null, "git_parents": [null], "node": "6cc8c19f40b03cdd4be9fa7cef5cb960abde6bd7", "parents": ["ffab6a2fed03b4befdbfab0ad19737f93eaacd8e"], "tags": []}, {"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1941002 - Make XPath tree walker hold a strong reference. r=smaug a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D237259", "files": ["dom/xslt/xml/txXMLParser.cpp", "dom/xslt/xml/txXMLParser.h", "dom/xslt/xpath/XPathExpression.cpp", "dom/xslt/xpath/XPathResult.cpp", "dom/xslt/xpath/txForwardContext.h", "dom/xslt/xpath/txMozillaXPathTreeWalker.cpp", "dom/xslt/xpath/txNodeSet.cpp", "dom/xslt/xpath/txNodeSet.h", "dom/xslt/xpath/txSingleNodeContext.h", "dom/xslt/xpath/txXPathNode.h", "dom/xslt/xpath/txXPathTreeWalker.h", "dom/xslt/xslt/txEXSLTFunctions.cpp", "dom/xslt/xslt/txExecutionState.cpp", "dom/xslt/xslt/txExecutionState.h", "dom/xslt/xslt/txMozillaXSLTProcessor.cpp", "dom/xslt/xslt/txXSLTPatterns.cpp"], "git_node": null, "git_parents": [null], "node": "f69dc97182dcae0b333230994377dd524c6b8542", "parents": ["6cc8c19f40b03cdd4be9fa7cef5cb960abde6bd7"], "tags": []}, {"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1941002 - Check state before compiling/transforming. r=smaug a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D237260", "files": ["dom/webidl/XSLTProcessor.webidl", "dom/xslt/xslt/txMozi