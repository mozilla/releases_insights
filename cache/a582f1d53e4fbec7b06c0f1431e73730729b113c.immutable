li/enc/backward_references.h", "modules/brotli/enc/backward_references_hq.c", "modules/brotli/enc/backward_references_hq.h", "modules/brotli/enc/backward_references_inc.h", "modules/brotli/enc/block_splitter.c", "modules/brotli/enc/block_splitter_inc.h", "modules/brotli/enc/brotli_bit_stream.c", "modules/brotli/enc/cluster_inc.h", "modules/brotli/enc/command.c", "modules/brotli/enc/command.h", "modules/brotli/enc/compress_fragment_two_pass.c", "modules/brotli/enc/dictionary_hash.c", "modules/brotli/enc/dictionary_hash.h", "modules/brotli/enc/encode.c", "modules/brotli/enc/encoder_dict.c", "modules/brotli/enc/encoder_dict.h", "modules/brotli/enc/entropy_encode.c", "modules/brotli/enc/entropy_encode.h", "modules/brotli/enc/fast_log.c", "modules/brotli/enc/fast_log.h", "modules/brotli/enc/find_match_length.h", "modules/brotli/enc/hash.h", "modules/brotli/enc/hash_composite_inc.h", "modules/brotli/enc/hash_forgetful_chain_inc.h", "modules/brotli/enc/hash_longest_match64_inc.h", "modules/brotli/enc/hash_longest_match_inc.h", "modules/brotli/enc/hash_longest_match_quickly_inc.h", "modules/brotli/enc/hash_rolling_inc.h", "modules/brotli/enc/hash_to_binary_tree_inc.h", "modules/brotli/enc/memory.h", "modules/brotli/enc/metablock.c", "modules/brotli/enc/metablock_inc.h", "modules/brotli/enc/params.h", "modules/brotli/enc/ringbuffer.h", "modules/brotli/enc/utf8_util.c", "modules/brotli/enc/write_bits.h", "modules/brotli/include/brotli/encode.h", "modules/brotli/include/brotli/port.h", "modules/brotli/moz.build", "modules/brotli/tools/brotli.c", "modules/brotli/update.sh"], "git_node": null, "git_parents": [null], "node": "bb63a7426fd33346ac7db020dae9b22259d616ef", "parents": ["d046a027e91899e050673e964e747b97219e4915"], "tags": []}, {"author": "Mihai Tabara \u003cmtabara@mozilla.com\u003e", "branch": "default", "desc": "Bug 1661673 - make esr78 not next-esr. r=aki, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D88591", "files": ["taskcluster/ci/release-bouncer-aliases/kind.yml", "taskcluster/ci/release-snap-push/kind.yml", "taskcluster/ci/release-update-verify-config/kind.yml", "taskcluster/taskgraph/target_tasks.py"], "git_node": null, "git_parents": [null], "node": "9e8441749e04106bcdbbb20a9a38be3f895e44c7", "parents": ["bb63a7426fd33346ac7db020dae9b22259d616ef"], "tags": []}, {"author": "Mihai Tabara \u003cmtabara@mozilla.com\u003e", "branch": "default", "desc": "Bug 1661673 - remove esr68 references. r=aki, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D88618", "files": [".cron.yml", "taskcluster/ci/build/windows-mingw.yml", "taskcluster/ci/config.yml", "taskcluster/ci/l10n-bump/kind.yml", "taskcluster/ci/release-balrog-scheduling/kind.yml", "taskcluster/ci/release-balrog-submit-toplevel/kind.yml", "taskcluster/ci/release-bouncer-sub/kind.yml", "taskcluster/ci/release-update-verify-config-next/kind.yml", "taskcluster/ci/release-update-verify-config/kind.yml", "taskcluster/ci/release-update-verify-next/kind.yml", "taskcluster/docs/attributes.rst", "taskcluster/docs/parameters.rst", "taskcluster/taskgraph/decision.py", "taskcluster/taskgraph/target_tasks.py", "taskcluster/taskgraph/util/attributes.py", "taskcluster/taskgraph/util/scriptworker.py"], "git_node": null, "git_parents": [null], "node": "95637d01c8150cb9af47dd18609fc9bfdc7163ea", "parents": ["9e8441749e04106bcdbbb20a9a38be3f895e44c7"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1659719 - Add support for arbitrary preferences in policy. r=Gijs,dveditz a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D87447", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/head.js", "browser/components/enterprisepolicies/tests/xpcshell/test_preferences.js"], "git_node": null, "git_parents": [null], "node": "c7680631850f7cf0a1ca650574dcaf2fce34ab91", "parents": ["95637d01c8150cb9af47dd18609fc9bfdc7163ea"], "tags": []}, {"author": "Marco Trevisan \u003cmail@3v1n0.net\u003e", "branch": "default", "desc": "Bug 1661094: Always define PKGCONF_REQUIRES_PRIVATE. r=froydnj, a=RyanVM\n\nWhen configuring without system NSPR the configuration variable\nPKGCONF_REQUIRES_PRIVATE isn't ever set, leading to a .pc file that still\ncontains the @PKGCONF_REQUIRES_PRIVATE@ stub.\n\nEnsure that we always define PKGCONF_REQUIRES_PRIVATE, by setting it to an\nempty string in case no system-nsrp is enabled.\nIn this way, the pkg-config file stub will be always replaced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D88179", "files": ["build/moz.configure/nspr.configure"], "git_node": null, "git_parents": [null], "node": "95bddd34109c1ee5797ab588f469fda87d39c398", "parents": ["c7680631850f7cf0a1ca650574dcaf2fce34ab91"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1662381 - Don't let pipenv initialize the virtualenv with packages from pypi. r=rstewart,ahal a=RyanVM\n\nBy setting PIP_NO_INDEX when running pipenv, we make it populate the\nvirtualenv with the in-tree wheels for e.g. pip and setuptools, instead of\nwhatever happens to be the latest version the day pipenv runs. This\nmakes it match what we already do for other virtualenvs (with\n--no-download in VirtualenvManager.create).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D89107", "files": ["python/mozbuild/mozbuild/virtualenv.py"], "git_node": null, "git_parents": [null], "node": "9278a0344695a4154aa0b3b6fa246df0e4431ffd", "parents": ["95bddd34109c1ee5797ab588f469fda87d39c398"], "tags": []}], "date": 1599591950, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "70": {"changesets": [{"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1661022 - add trailing slash to pypi.pub.b.m.o/pub r=releng-reviewers,bhearsum a=release DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D88181", "files": ["testing/condprofile/condprof/check_install.py", "testing/mozharness/mozharness/base/python.py"], "git_node": null, "git_parents": [null], "node": "a37580e43f7ab597900c4584c1ac9273c7194487", "parents": ["9278a0344695a4154aa0b3b6fa246df0e4431ffd"], "tags": []}], "date": 1599602955, "git_changesets": [null], "user": "asasaki@mozilla.com"}, "71": {"changesets": [{"author": "Kagami Sascha Rosylight \u003ckrosylight@mozilla.com\u003e", "branch": "default", "desc": "Bug 1646140 - Fire SVG onload only when scripting is enabled. r=hsivonen, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D89218", "files": ["parser/html/nsHtml5TreeBuilderCppSupplement.h"], "git_node": null, "git_parents": [null], "node": "1671e4d826e51b86737e65a2ece5b885a402dd43", "parents": ["a37580e43f7ab597900c4584c1ac9273c7194487"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1641487, r=jaws a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D86761", "files": ["browser/components/downloads/DownloadsViewUI.jsm"], "git_node": null, "git_parents": [null], "node": "2ceaf24211377cbbdc58741beddc6ef60cc2988d", "parents": ["1671e4d826e51b86737e65a2ece5b885a402dd43"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1650462: Don't include group descendants when calculating the acc name of treeitems. r=MarcoZ, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83042", "files": ["accessible/base/nsTextEquivUtils.cpp", "accessible/base/nsTextEquivUtils.h", "accessible/tests/mochitest/name/test_general.html", "accessible/tests/mochitest/value/test_general.html"], "git_node": null, "git_parents": [null], "node": "351ecbf2ae5acd9620de55e84841a0fdca769b1b", "parents": ["2ceaf24211377cbbdc58741beddc6ef60cc2988d"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1645492 - only show certificates with corresponding error overrides in the \"Servers\" tab of the certificate manager. r=kjacobs, a=jcristau\n\nBefore this patch, the \"Servers\" tab of the certificate manager would show\nbuilt-in distrust records that had corresponding certificates (lately, this has\nonly consisted of two DigiNotar look-alike roots that were added many years ago\nto block the real DigiNotar roots and potential cross-signs).\nThis patch changes the implementation to only show certificates that actually\nhave a corresponding error override in the \"Servers\" tab.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83190", "files": ["security/manager/ssl/nsCertTree.cpp", "security/manager/ssl/tests/mochitest/browser/browser.ini", "security/manager/ssl/tests/mochitest/browser/browser_certificateManager.js", "security/manager/ssl/tests/mochitest/browser/browser_certificateManagerLeak.js", "security/manager/ssl/tests/mochitest/browser/browser_clientAuthRememberService.js", "security/manager/ssl/tests/mochitest/browser/head.js"], "git_node": null, "git_parents": [null], "node": "16ddd5f4b13e4991da0563e25428f88b37d54527", "parents": ["351ecbf2ae5acd9620de55e84841a0fdca769b1b"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1368270: When shutting down Windows AccessibleWraps, don't clear the id. r=MarcoZ, a=jcristau\n\nWhen an Accessible is shut down, there might still be external references to it, so we keep the instance alive.\nWe don't want to reuse the id until all references are released, so we only release the id in the destructor (which runs when all references are released).\nPreviously, we were clearing the id variable in Shutdown, which meant we couldn't release the id in the destructor!\nThis meant we always leaked ids, never reusing them.\nNow, we don't clear the id in Shutdown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D84653", "files": ["accessible/windows/msaa/AccessibleWrap.cpp"], "git_node": null, "git_parents": [null], "node": "92582efe4621cf2b7a2feb5bd101a9c1ce70206c", "parents": ["16ddd5f4b13e4991da0563e25428f88b37d54527"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1659825 - Null check gWindowContexts in WindowContext::Discard(). r=nika, a=jcristau\n\nIf we're after shutdown, then this variable will have been cleared.\nThis is the remaining use that was failing to do a null check, and\nit was manifesting as a very low-volume crash.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D87503", "files": ["docshell/base/WindowContext.cpp"], "git_node": null, "git_parents": [null], "node": "df7a0bd80d5219b82dd0a01442446407f25bca76", "parents": ["92582efe4621cf2b7a2feb5bd101a9c1ce70206c"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1627667 - Don't use nullptr with std::string. r=lsalzman, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D88357", "files": ["dom/canvas/WebGLContext.cpp"], "git_node": null, "git_parents": [null], "node": "09a1fbacd795004309876f89ba0d08ad4502b01e", "parents": ["df7a0bd80d5219b82dd0a01442446407f25bca76"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1656556 - Switch to device context as default for Firefox MSI. r=mhowell, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D89186", "files": ["browser/installer/windows/msi/installer.wxs"], "git_node": null, "git_parents": [null], "node": "8e5ceb66f84733a0f7342091824db7aae367e51d", "parents": ["09a1fbacd795004309876f89ba0d08ad4502b01e"], "tags": []}, {"author": "Steven Michaud \u003csmichaud@pobox.com\u003e", "branch": "default", "desc": "Bug 1662862 - Fall back to getting debug ids from modules in memory. r=gsvelto, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D89245", "files": ["toolkit/crashreporter/breakpad-client/mac/handler/minidump_generator.cc"], "git_node": null, "git_parents": [null], "node": "94a4962e1878fe228c66c4a420f3093d1ec23479", "parents": ["8e5ceb66f84733a0f7342091824db7aae367e51d"], "tags": []}], "date": 1599678878, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "72": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1648493. r=kershaw, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D89374", "files": ["netwerk/base/nsStandardURL.cpp"], "git_node": null, "git_parents": [null], "node": "f8ed7e04a821b5953b00decc2930d79732224d2c", "parents": ["94a4962e1878fe228c66c4a420f3093d1ec23479"], "tags": []}], "date": 1599761392, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "73": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D89736", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons.json", "services/settings/dumps/main/search-config.json"], "git_node": null, "git_parents": [null], "node": "7fc438bde1953d75e0d9c471456240fe3dcb8ed4", "parents": ["f8ed7e04a821b5953b00decc2930d79732224d2c"], "tags": []}], "date": 1599761687, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "74": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D90139", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "0f6b2481af52f969e859442fde554442bed88e42", "parents": ["7fc438bde1953d75e0d9c471456240fe3dcb8ed4"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1629002 - unblock asepkcs.dll r=tkikuchi a=RyanVM\n\nWhen the osclientcerts module attempts to use client certificates and keys from\ncertain tokens, the Windows APIs will attempt to load asepkcs.dll. If Firefox\nblocks this library, the keys won't be available. Thus, it needs to be\nunblocked.\n\nDue to the architecture of osclientcerts (namely, its dedicated single thread),\nusing asepkcs.dll via the Windows APIs shouldn't cause the crashes that led to\nthis module being blocked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82788", "files": ["mozglue/dllservices/WindowsDllBlocklistDefs.in"], "git_node": null, "git_parents": [null], "node": "f58cf6a2a1a4ca7f92ac93b27d796b83882a760e", "parents": ["0f6b2481af52f969e859442fde554442bed88e42"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1629002 - osclientcerts: add support for CryptoAPI-only keys r=mhowell,kjacobs a=RyanVM\n\nEvidently, keys stored on some tokens can only be accessed via the deprecated\nCryptoAPI interface. This patch adds support for such keys.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82789", "files": ["security/manager/ssl/osclientcerts/src/backend_windows.rs", "security/manager/ssl/osclientcerts/src/util.rs"], "git_node": null, "git_parents": [null], "node": "fc94a8dbf2e71656c6e2bcfa72b7c9edef98ef7b", "parents": ["f58cf6a2a1a4ca7f92ac93b27d796b83882a760e"], "tags": ["FIREFOX_78_3_0esr_BUILD1", "FIREFOX_78_3_0esr_RELEASE"]}], "date": 1600105400, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}}
}";