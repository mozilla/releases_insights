"f12afe093cac49e91409ad275d48932885174ccf"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1661543 - Backed out 1 changesets (bug 1651449) for performance regression. a=backout\n\nBacked out changeset a28c58add438 (bug 1651449)", "files": ["security/certverifier/NSSCertDBTrustDomain.cpp", "security/manager/ssl/nsINSSComponent.idl", "security/manager/ssl/nsNSSCertificateDB.cpp", "security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/nsNSSComponent.h", "security/nss.symbols"], "git_node": null, "git_parents": [null], "node": "2fd428c0b23b7e08d2c254b288447f14f020d928", "parents": ["ba6d3f7f199d3e1cc87b8aaeeaecd9f21b1cfe1f"], "tags": []}, {"author": "Mihai Tabara \u003cmtabara@mozilla.com\u003e", "branch": "default", "desc": "Bug 1660771 - default mergeduty bump-esr to esr78. r=bhearsum,jlorenzo a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D88140", "files": ["taskcluster/ci/config.yml"], "git_node": null, "git_parents": [null], "node": "651bd1b0c8b7720c1578a948d342d117eb2b87e9", "parents": ["2fd428c0b23b7e08d2c254b288447f14f020d928"], "tags": []}], "date": 1598637060, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "67": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D88857", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "8b7f4eec61c4008eb6abcebbffe93707393d1c9a", "parents": ["651bd1b0c8b7720c1578a948d342d117eb2b87e9"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1648534 - Read HKLM's EnableDesktopModeAutoInvoke entry if no entry in HKCU. r=masayuki\n\nThis is regression by bug 1618759 and bug 1197722.\n\nBy bug 1197722, we use registry value whether opening software keyboard even if\ndesktop mode. But this fix isn't enough.\n\nAlso, before landing bug 1618759, since TSF manages software keyboard state on\nnewer Windows 10 version such as Windows 10 RS1, bug 1197722's fix isn't used.\nThen, after landing bug 1618759, since we use `EnableDesktopModeAutoInvoke`\nagain, this issue occurs.\n\nSince `EnableDesktopModeAutoInvoke` is available if in HKLM, we should read\nHKLM's key too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D83489", "files": ["widget/windows/WinIMEHandler.cpp"], "git_node": null, "git_parents": [null], "node": "086a2f020fc99ef5d93f6c6b5d023bbe5aa79adc", "parents": ["8b7f4eec61c4008eb6abcebbffe93707393d1c9a"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1650486 - guard search-textbox from multiple connectedCallbacks, so that we don't get multiple search icons. r=bgrins, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D86175", "files": ["toolkit/content/tests/chrome/test_textbox_search.xhtml", "toolkit/content/widgets/search-textbox.js"], "git_node": null, "git_parents": [null], "node": "c05e5f72a67550cd422242537b852a14d04b6a56", "parents": ["086a2f020fc99ef5d93f6c6b5d023bbe5aa79adc"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1660211 - Respect iterator invalidation rules in ComputeClippedCompositionBounds(). r=kats, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D87893", "files": ["gfx/layers/apz/src/APZCTreeManager.cpp"], "git_node": null, "git_parents": [null], "node": "e22ad6020423414ef531b213cbac7921f9b3a926", "parents": ["c05e5f72a67550cd422242537b852a14d04b6a56"], "tags": []}, {"author": "Kashav Madan \u003ckmadan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1660537 - Null check mOwnerContent in GetWindowDimensions, r=smaug a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D87903", "files": ["dom/base/nsFrameLoader.cpp"], "git_node": null, "git_parents": [null], "node": "aabdc823a2ed2fac55cb622fb4f276486e37c543", "parents": ["e22ad6020423414ef531b213cbac7921f9b3a926"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1660608 - fix plugin crash notification bar message for GMP crashes to include plugin name, r=mconley a=RyanVM\n\nThe test abstraction meant we missed that this broke in the refactor. This\nfixes the bug and makes sure the test actually tests it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D88012", "files": ["browser/actors/PluginParent.jsm", "browser/base/content/test/plugins/browser_globalplugin_crashinfobar.js"], "git_node": null, "git_parents": [null], "node": "bb0fbc3f097e4f1cebdbaacd402b0be7023cb290", "parents": ["aabdc823a2ed2fac55cb622fb4f276486e37c543"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1659801 - Implement a CTypes readTypedArray() for CData and CDataFinalizer. r=jorendorff, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D87477", "files": ["js/src/ctypes/CTypes.cpp", "js/src/ctypes/ctypes.msg", "js/src/jit-test/tests/ctypes/typedarrays.js"], "git_node": null, "git_parents": [null], "node": "d928031b7f170eeeb06d3d5733856d8bcf575f59", "parents": ["bb0fbc3f097e4f1cebdbaacd402b0be7023cb290"], "tags": []}], "date": 1598924053, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "68": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D89246", "files": ["security/manage