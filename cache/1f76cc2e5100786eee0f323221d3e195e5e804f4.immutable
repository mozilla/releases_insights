33\n", "files": ["gfx/2d/DrawTargetCairo.cpp"], "git_node": "2c4cdb7809f4d686d2d28c90339b77e3912a2851", "git_parents": ["244a2c7754f03ca8ce0eb972d1f6a9ab20f8fee4"], "node": "6cd084afa259e28daff69ef4cfef3b0ffe2b6cbc", "parents": ["8b6ab19f30421509549f203ed14b7d23bb6a33eb"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005658. r=aosmond a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276109\n", "files": ["gfx/2d/DrawTargetCairo.cpp"], "git_node": "29aa5a848fb37039d9719ae2bf026d2a8c07d402", "git_parents": ["2c4cdb7809f4d686d2d28c90339b77e3912a2851"], "node": "634aa488291f43c4878dc976e4f899049c2013b0", "parents": ["6cd084afa259e28daff69ef4cfef3b0ffe2b6cbc"], "tags": []}], "date": 1765813933, "git_changesets": ["2c4cdb7809f4d686d2d28c90339b77e3912a2851", "29aa5a848fb37039d9719ae2bf026d2a8c07d402"], "user": "rvandermeulen@mozilla.com"}, "396": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276433\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "66771690f30cbf25607aef1ab9f77e6239886bc8", "git_parents": ["29aa5a848fb37039d9719ae2bf026d2a8c07d402"], "node": "aa0c011fb67ec54f8646ba856fefce0a306794f4", "parents": ["634aa488291f43c4878dc976e4f899049c2013b0"], "tags": []}], "date": 1765814114, "git_changesets": ["66771690f30cbf25607aef1ab9f77e6239886bc8"], "user": "rvandermeulen@mozilla.com"}, "397": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2003607 - Set majorFinishedWhileMinorSweeping when aborting major sweeping (ESR140)  a=RyanVM\n\nThe problem here is that although we set majorFinishedWhileMinorSweeping when\nmajor collection finishes normally we didn't set when major collection was\naborted.\n\nI was able to easily reproduce the crash with the testcase in the bug without\nthis patch and confirmed that it didn't happen when the patch was applied. I\nwas not able to come up with a standalone test case for this however (the\ntestcase in the report requires adding delays to the helper thread task).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276671\n", "files": ["js/src/gc/BufferAllocator.cpp"], "git_node": "fd88be60b04c676b84da05fc26cccec32eebc21a", "git_parents": ["66771690f30cbf25607aef1ab9f77e6239886bc8"], "node": "2927ea382a99a63e6282272e44801b9f9518e455", "parents": ["aa0c011fb67ec54f8646ba856fefce0a306794f4"], "tags": []}], "date": 1765943621, "git_changesets": ["fd88be60b04c676b84da05fc26cccec32eebc21a"], "user": "rvandermeulen@mozilla.com"}, "398": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2002446 - Make document name getter handle the torn-down iframe contentWindow;  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D275870\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276466\n", "files": ["dom/html/nsHTMLDocument.cpp"], "git_node": "f7a5980ab8a991e9e762655d7fe5de3e7de714d1", "git_parents": ["fd88be60b04c676b84da05fc26cccec32eebc21a"], "node": "182a256d235f9415c388d1edbb6aab16a212fa6f", "parents": ["2927ea382a99a63e6282272e44801b9f9518e455"], "tags": []}], "date": 1765943667, "git_changesets": ["f7a5980ab8a991e9e762655d7fe5de3e7de714d1"], "user": "rvandermeulen@mozilla.com"}, "399": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005058 - avoid reusing a cached task graph in test_query_paths_variants r=taskgraph-reviewers,Eijebong a=test-only DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D275786\n", "files": ["tools/tryselect/test/test_fuzzy.py"], "git_node": "89606b92a7e8367838dbb8ccef10331943662d50", "git_parents": ["f7a5980ab8a991e9e762655d7fe5de3e7de714d1"], "node": "be50db518e3bdd92c0262e4ffc71de73bbd9fff5", "parents": ["182a256d235f9415c388d1edbb6aab16a212fa6f"], "tags": []}], "date": 1765995301, "git_changesets": ["89606b92a7e8367838dbb8ccef10331943662d50"], "user": "rvandermeulen@mozilla.com"}, "400": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1982016 - Improve ownership of the ancillary data types used by the crash helper code  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D267247\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276626\n", "files": ["toolkit/crashreporter/crash_helper_client/src/lib.rs", "toolkit/crashreporter/crash_helper_client/src/platform/android.rs", "toolkit/crashreporter/crash_helper_client/src/platform/unix.rs", "toolkit/crashreporter/crash_helper_client/src/platform/windows.rs", "toolkit/crashreporter/crash_helper_common/src/errors.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/unix.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/windows.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_listener/windows.rs", "toolkit/crashreporter/crash_helper_common/src/lib.rs", "toolkit/crashreporter/crash_helper_common/src/messages.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server.rs", "toolkit/crashreporter/crash_helper_server/src/lib.rs", "toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "2ee636e94cf00b4fce5a22b83e58000c7f3cef37", "git_parents": ["89606b92a7e8367838dbb8ccef10331943662d50"], "node": "10fd160da1a99aadfb829fa03f9579eea806a256", "parents": ["be50db518e3bdd92c0262e4ffc71de73bbd9fff5"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1989686 - Stop duplicating handles when scheduling overlapped operations  a=RyanVM\n\nThis removes the owned handle we used in overlapped operations to avoid\nthe crash in bug 1974259. The handle is now replaced with a counted\nreference to the source handle.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D270528\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276627\n", "files": ["toolkit/crashreporter/crash_helper_common/src/ipc_connector/windows.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_listener/windows.rs", "toolkit/crashreporter/crash_helper_common/src/platform/windows.rs"], "git_node": "aa51bf07c738f49844e0e0e2df346b9da9821f8f", "git_parents": ["2ee636e94cf00b4fce5a22b83e58000c7f3cef37"], "node": "2cd16af8b5a0bc1195895de293a2417daa08d545", "parents": ["10fd160da1a99aadfb829fa03f9579eea806a256"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1989686 - Refactor errors in per-type groups  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D270529\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276628\n", "files": ["toolkit/crashreporter/crash_helper_common/src/breakpad/unix_strings.rs", "toolkit/crashreporter/crash_helper_common/src/breakpad/windows_strings.rs", "toolkit/crashreporter/crash_helper_common/src/errors.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_channel.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_channel/unix.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_channel/windows.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/unix.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/windows.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_listener.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_listener/windows.rs", "toolkit/crashreporter/crash_helper_common/src/lib.rs", "toolkit/crashreporter/crash_helper_common/src/messages.rs", "toolkit/crashreporter/crash_helper_common/src/platform.rs", "toolkit/crashreporter/crash_helper_common/src/platform/linux.rs", "toolkit/crashreporter/crash_helper_common/src/platform/macos.rs", "toolkit/crashreporter/crash_helper_common/src/platform/windows.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server/unix.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server/windows.rs"], "git_node": "f8224f990bc409520fd14de8d7b6d5dfc8e81eb5", "git_parents": ["aa51bf07c738f49844e0e0e2df346b9da9821f8f"], "node": "711ef0014b51fae81e061a1a4972026ab777f451", "parents": ["2cd16af8b5a0bc1195895de293a2417daa08d545"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1989686 - Switched the crash helper IPC code to use I/O completion ports on Windows  a=RyanVM\n\nThis patch moves the waiting logic out of the IPCServer object and into a\nseparate IPCQueue one, it also makes the queue spit out entire messages rather\nthan just the header, effectively removing all sorts of asynchronous I/O from\nthe IPCServer and hiding its details in the crash_herlper_common crate.\n\nThese changes not only switch Windows to using I/O completion ports, but\nimproves error handling significantly. This in turn makes the crash helper\nmore reliable while handling child process disconnections.\n\nLast but not least all raw references to HANDLEs held in structs within\nthe Windows implementation have been replaced with reference-counted ot\nborrowed references.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D270530\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276629\n", "files": ["Cargo.lock", "toolkit/crashreporter/crash_helper_client/src/lib.rs", "toolkit/crashreporter/crash_helper_common/Cargo.toml", "toolkit/crashreporter/crash_helper_common/src/errors.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_channel.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_channel/windows.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/unix.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/windows.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_listener/windows.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_queue.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_queue/unix.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_queue/windows.rs", "toolkit/crashreporter/crash_helper_common/src/lib.rs", "toolkit/crashreporter/crash_helper_common/src/messages.rs", "toolkit/crashreporter/crash_helper_common/src/platform/windows.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server/unix.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server/windows.rs", "toolkit/crashreporter/crash_helper_server/src/lib.rs"], "git_node": "0f46c074b9d1d6da923c1aed98316fd43a8421e3", "git_parents": ["f8224f990bc409520fd14de8d7b6d5dfc8e81eb5"], "node": "836fabcf9cd621586260ed7637046527640b5839", "parents": ["711ef0014b51fae81e061a1a4972026ab777f451"], "tags": []}], "date": 1765999079, "git_changesets": ["2ee636e94cf00b4fce5a22b83e58000c7f3cef37", "aa51bf07c738f49844e0e0e2df346b9da9821f8f", "f8224f990bc409520fd14de8d7b6d5dfc8e81eb5", "0f46c074b9d1d6da923c1aed98316fd43a8421e3"], "user": "rvandermeulen@mozilla.com"}, "401": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005081 - Ensure clipboard paste button is dismissed after navigation;  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D275694\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276920\n", "files": ["browser/base/content/browser.js", "dom/events/test/clipboard/browser.toml", "dom/events/test/clipboard/browser_navigator_clipboard_contextmenu_dismiss.js", "toolkit/modules/ClipboardContextMenu.sys.mjs"], "git_node": "95fa900ee01ad63e9f7af4d6346858b6ad2ecaea", "git_parents": ["0f46c074b9d1d6da923c1aed98316fd43a8421e3"], "node": "3cedf91a625751537e2e00786af69bf20c59ce7f", "parents": ["836fabcf9cd621586260ed7637046527640b5839"], "tags": []}], "date": 1766016744, "git_changesets": ["95fa900ee01ad63e9f7af4d6346858b6ad2ecaea"], "user": "rvandermeulen@mozilla.com"}, "402": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1995481 - Improve bitrate logging. r=ng a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D274918\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276187\n", "files": ["dom/media/webrtc/libwebrtcglue/VideoConduit.cpp", "dom/media/webrtc/libwebrtcglue/VideoStreamFactory.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.cpp"], "git_node": "1a3105701183163365e108720939777c0d862993", "git_parents": ["95fa900ee01ad63e9f7af4d6346858b6ad2ecaea"], "node": "1f19efa8f373a170166b687bbb43b2ac06d52679", "parents": ["3cedf91a625751537e2e00786af69bf20c59ce7f"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1995481 - Set simulcast layer max bitrate as constrained by JS.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D274919\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276188\n", "files": ["dom/media/webrtc/libwebrtcglue/VideoConduit.cpp", "media/webrtc/signaling/gtest/videoconduit_unittests.cpp"], "git_node": "b77f47fbb9ee685904e60f0eef6898b996a51d97", "git_parents": ["1a3105701183163365e108720939777c0d862993"], "node": "984a9d2d0e2c8f9ac83700b81165d47f05553b86", "parents": ["1f19efa8f373a170166b687bbb43b2ac06d52679"], "tags": []}], "date": 1766028505, "git_changesets": ["1a3105701183163365e108720939777c0d862993", "b77f47fbb9ee685904e60f0eef6898b996a51d97"], "user": "rvandermeulen@mozilla.com"}, "403": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276991\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-config-icons.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "2b12d13b502b7d49aa42b6124af69ff1c59c9dc4", "git_parents": ["b77f47fbb9ee685904e60f0eef6898b996a51d97"], "node": "ed2a8481c175f3813300d3230ecca8b479e426f9", "parents": ["984a9d2d0e2c8f9ac83700b81165d47f05553b86"], "tags": []}], "date": 1766091461, "git_changesets": ["2b12d13b502b7d49aa42b6124af69ff1c59c9dc4"], "user": "rvandermeulen@mozilla.com"}, "404": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1970743 - consolidate DownloadUtils.getURIHost into BrowserUtils.formatURIForDisplay,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253150\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277005\n", "files": ["browser/base/content/browser-fullScreenAndPointerLock.js", "browser/components/downloads/DownloadsViewUI.sys.mjs", "browser/components/firefoxview/fxview-tab-list.mjs", "browser/components/firefoxview/helpers.mjs", "toolkit/modules/BrowserUtils.sys.mjs", "toolkit/modules/tests/xpcshell/test_BrowserUtils_urlFormatting.js", "toolkit/mozapps/downloads/DownloadUtils.sys.mjs", "toolkit/mozapps/downloads/tests/browser/browser_unknownContentType_blob.js", "toolkit/mozapps/downloads/tests/unit/test_DownloadUtils.js"], "git_node": "e12fe1d63ecadf7cf127fc160b644c0c4f50d154", "git_parents": ["2b12d13b502b7d49aa42b6124af69ff1c59c9dc4"], "node": "9cd7c21a0fee41cd7121f5b53f7d63ec9d9b3c8d", "parents": ["ed2a8481c175f3813300d3230ecca8b479e426f9"], "tags": []}], "date": 1766091578, "git_changesets": ["e12fe1d63ecadf7cf127fc160b644c0c4f50d154"], "user": "rvandermeulen@mozilla.com"}, "405": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2000531 - Fix getBBox when content has padding and scale  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D273465\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277121\n", "files": ["dom/svg/SVGContentUtils.cpp", "testing/web-platform/tests/svg/types/scripted/SVGGraphicsElement-padding.svg"], "git_node": "c017f1a03875e6b2d941923489254635a7adff8c", "git_parents": ["e12fe1d63ecadf7cf127fc160b644c0c4f50d154"], "node": "44404e44d7f91bfb017d013f60ad3296d8c1116e", "parents": ["9cd7c21a0fee41cd7121f5b53f7d63ec9d9b3c8d"], "tags": []}], "date": 1766113150, "git_changesets": ["c017f1a03875e6b2d941923489254635a7adff8c"], "user": "rvandermeulen@mozilla.com"}, "406": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1995637 - Make sure debugger object gets traced when tracing breakpoints  a=RyanVM\n\nBreakpoints currently trace |wrappedDebugger| but this doesn't keep |debugger|\nalive if we have nuked the CCWs. The debugger has a linked list of breakpoints that\neach breakpoint is part of so we need to make sure it lives at least as long as\nthat.\n\nThe patch traces the debugger's object even if our CCW to it has been nuked.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D271062\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277210\n", "files": ["js/src/debugger/Debugger.cpp", "js/src/jit-test/tests/debug/bug-1995637.js"], "git_node": "364db80d5eacfad5b3f5a0c1cfe80b4ea4a62e65", "git_parents": ["c017f1a03875e6b2d941923489254635a7adff8c"], "node": "159c02c3c5346d5ecfbe76b90671771c9cf93887", "parents": ["44404e44d7f91bfb017d013f60ad3296d8c1116e"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1999464 - Don't nuke CCWs to the debugger object  a=RyanVM\n\nThis is an alternative to the fix in bug 1995637 and removes that change.\n\nThe debugger mostly uses its own wrappers for cross compartment pointers\nbetween debugger and debuggee globals. These are not in the CCW map and so are\nnot nuked by NukeCrossCompartmentWrappers. This pointer from a Breakpoint to\nits owning debugger however is a normal CCW that is in the map and so can be\naffected by that operation.\n\nThe change makes it so we skip nuking CCWs to the main debugger object. This\ncould affect other uses of this CCW but these are not accessible from content\nJS so I don't think this is a problem.\n\nIt's important not to break the link between breakpoints and their debuggers\nbecause they are present in two linked lists which are in different realms. To\nclean up properly the link needs to be intact.\n\nThis change is also covered by the original test in bug 1995637.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D273012\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277211\n", "files": ["js/src/debugger/Debugger.cpp", "js/src/jit-test/tests/debug/bug-1999464.js", "js/src/proxy/CrossCompartmentWrapper.cpp"], "git_node": "ffae18d27741ccf39a10c81f89875dd36a3ec110", "git_parents": ["364db80d5eacfad5b3f5a0c1cfe80b4ea4a62e65"], "node": "a39a60fc172d0ac7781cbe7f87616be076b5d334", "parents": ["159c02c3c5346d5ecfbe76b90671771c9cf93887"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2002646 - Fix assertion that didn't take account of moving GC  a=RyanVM\n\nWhen the trace hook is called during moving GC both the object and its shape\ncan be forwarded so it's not safe to call IsDeadProxyObject. The simplest thing\nis to skip this check in moving GC.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D275204\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277212\n", "files": ["js/src/debugger/Debugger.cpp", "js/src/jit-test/tests/debug/bug-2002646.js"], "git_node": "ae4345fe2e7b9a94d8f97b7f5c0594727c6bd594", "git_parents": ["ffae18d27741ccf39a10c81f89875dd36a3ec110"], "node": "9d52ad92507f8cb749ed6832da06ff9a3e0ee6b1", "parents": ["a39a60fc172d0ac7781cbe7f87616be076b5d334"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2003100 - Suppress GC during wrapper remapping  a=RyanVM\n\nWe rely on tracing a CCW to the debugger from a script with a breakpoint that's\nin another compartment.  The problem here is that wrapper remapping can trigger\na GC after nuking the original CCW but before remapping is complete, meaning\nthat we wouldn't trace the debugger target in this case.\n\nThe patch suppresses GC during remapping.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D274575\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277213\n", "files": ["js/src/jit-test/tests/gc/bug-2003100.js", "js/src/proxy/CrossCompartmentWrapper.cpp"], "git_node": "0552e94c929f55fa8330aa98512aca40cecb390e", "git_parents": ["ae4345fe2e7b9a94d8f97b7f5c0594727c6bd594"], "node": "55f021d913c9c5ae702417276baa73278226128d", "parents": ["9d52ad92507f8cb749ed6832da06ff9a3e0ee6b1"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2003588 - Continue to allow creation of CCWs to debugger instances after CCWs have been nuked  a=RyanVM\n\nIt turns out that disallowing this breaks the checks in Compartment::wrap. I\ndon't fully understand what the implications of this are but it seems fine to\ncontinue to allow creating these if we don't nuke them in the first place.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D275046\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277214\n", "files": ["js/src/jit-test/tests/debug/bug-2003588.js", "js/src/jit-test/tests/debug/bug-2003809.js", "js/src/proxy/CrossCompartmentWrapper.cpp"], "git_node": "42feb69fa32d01c2b231ef546fff58129d02419f", "git_parents": ["0552e94c929f55fa8330aa98512aca40cecb390e"], "node": "ebeb5955d8213688fe7045b9e46df77962b04f36", "parents": ["55f021d913c9c5ae702417276baa73278226128d"], "tags": []}], "date": 1766168878, "git_changesets": ["364db80d5eacfad5b3f5a0c1cfe80b4ea4a62e65", "ffae18d27741ccf39a10c81f89875dd36a3ec110", "ae4345fe2e7b9a94d8f97b7f5c0594727c6bd594", "0552e94c929f55fa8330aa98512aca40cecb390e", "42feb69fa32d01c2b231ef546fff58129d02419f"], "user": "rvandermeulen@mozilla.com"}, "407": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1989340 - Only set GSS_C_DELEG_FLAG flag when server supports delegation  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D265582\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277161\n", "files": ["extensions/auth/nsAuthGSSAPI.cpp", "extensions/auth/nsAuthGSSAPI.h"], "git_node": "8ddabe94aa30e48a2d101068f26975e8a5e5a170", "git_parents": ["42feb69fa32d01c2b231ef546fff58129d02419f"], "node": "30aa61f6e70a6232809acb78ce165ddb33a1cc5c", "parents": ["ebeb5955d8213688fe7045b9e46df77962b04f36"], "tags": []}], "date": 1766169279, "git_changesets": ["8ddabe94aa30e48a2d101068f26975e8a5e5a170"], "user": "rvandermeulen@mozilla.com"}, "408": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2003989. r=ahale a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D275372\n", "files": ["gfx/layers/SourceSurfaceSharedData.cpp"], "git_node": "1ed7a8a23b2b3910685ae23b785229eb3a7d1cc0", "git_parents": ["8ddabe94aa30e48a2d101068f26975e8a5e5a170"], "node": "6b8bff3c42d8d454146b7defc72ddf243088335a", "parents": ["30aa61f6e70a6232809acb78ce165ddb33a1cc5c"], "tags": []}], "date": 1766169563, "git_changesets": ["1ed7a8a23b2b3910685ae23b785229eb3a7d1cc0"], "user": "rvandermeulen@mozilla.com"}, "409": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277316\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "dfd8eab49b54c35a5886fec60dd78759b363db1b", "git_parents": ["1ed7a8a23b2b3910685ae23b785229eb3a7d1cc0"], "node": "5f6acb6973ba875ff7f20c97a777947852f30da6", "parents": ["6b8bff3c42d8d454146b7defc72ddf243088335a"], "tags": []}], "date": 1766408023, "git_changesets": ["dfd8eab49b54c35a5886fec60dd78759b363db1b"], "user": "rvandermeulen@mozilla.com"}, "410": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007612 - Update pdf.js toolchain fetch revision. r=calixte a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277482\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "aadfd2101085721ea2f9971eab4e1fd296156f98", "git_parents": ["dfd8eab49b54c35a5886fec60dd78759b363db1b"], "node": "38daa15e1d07ae901e75b4e0a6391a350fda43e4", "parents": ["5f6acb6973ba875ff7f20c97a777947852f30da6"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007552 - [esr140] migrate linux tasks from docker-worker to d2g pools. r?#releng\n\nThis includes the following cherry-picks:\n- Bug 1971288 - run mozlint-android source-tests on t-linux-docker workers. r=releng-reviewers,bhearsum\n- Bug 1971292 - remove unused linux test pools from taskcluster config. r=releng-reviewers,bhearsum\n- Bug 1962414 - switch linux ccov xpcshell tests to t-linux-docker-noscratch worker pool. r=jmaher,taskgraph-reviewers,bhearsum DONTBUILD\n\nIn addition, this:\n- switches the `update` kind to t-linux-docker\n- updates the b-linux* worker aliases to use the new pools\n- fixes test_task_configs tryselect tests to not rely on a b-linux worker alias\n- updates .taskcluster.yml to use the `decision` pool instead of `decision-gcp`\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277441\n", "files": [".taskcluster.yml", "taskcluster/config.yml", "taskcluster/gecko_taskgraph/transforms/test/__init__.py", "taskcluster/gecko_taskgraph/transforms/test/other.py", "taskcluster/gecko_taskgraph/transforms/test/worker.py", "taskcluster/kinds/source-test/mozlint-android.yml", "taskcluster/kinds/update/kind.yml", "tools/tryselect/test/test_task_configs.py"], "git_node": "2ba1b66feb8aea2c8286cbba57ca1fbf5e2d9b63", "git_parents": ["aadfd2101085721ea2f9971eab4e1fd296156f98"], "node": "a327357b0be19b890a70d611d4858d5c17c0dec4", "parents": ["38daa15e1d07ae901e75b4e0a6391a350fda43e4"], "tags": []}], "date": 1766591888, "git_changesets": ["aadfd2101085721ea2f9971eab4e1fd296156f98", "2ba1b66feb8aea2c8286cbba57ca1fbf5e2d9b63"], "user": "rvandermeulen@mozilla.com"}, "411": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2005895 - Make `AutoEmptyBlockAncestorDeleter::GetNewCaretPosition()` never return point after a line break before a block boundary  a=RyanVM\n\nThe caret should be put before the last line break in a block if there\nis no visible content between the line break and the end block boundary.\n\nAdditionally,\n`WhiteSpaceVisibilityKeeper::DeleteContentNodeAndJoinTextNodesAroundIt()`\nshould delete the preceding block's invisible `\u003cbr\u003e` too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277400\n", "files": ["editor/libeditor/HTMLEditUtils.cpp", "editor/libeditor/HTMLEditUtils.h", "editor/libeditor/HTMLEditorDeleteHandler.cpp", "editor/libeditor/WSRunScanner.h", "editor/libeditor/WhiteSpaceVisibilityKeeper.cpp", "testing/web-platform/meta/editing/run/delete.html.ini", "testing/web-platform/tests/editing/data/delete.js", "testing/web-platform/tests/editing/data/forwarddelete.js"], "git_node": "fd24ebaf5203279f4fbb3763ef2ed79cdee3a555", "git_parents": ["2ba1b66feb8aea2c8286cbba57ca1fbf5e2d9b63"], "node": "3cc81d362482782d6a82cec48d61cd7c627db2ee", "parents": ["a327357b0be19b890a70d611d4858d5c17c0dec4"], "tags": []}], "date": 1766592714, "git_changesets": ["fd24ebaf5203279f4fbb3763ef2ed79cdee3a555"], "user": "rvandermeulen@mozilla.com"}, "412": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277532\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "42e888637a2a143e83334b4a8198c91f9cd47b10", "git_parents": ["fd24ebaf5203279f4fbb3763ef2ed79cdee3a555"], "node": "9c002a26b37554b72a1d9c0ab1fb7a625f861e54", "parents": ["3cc81d362482782d6a82cec48d61cd7c627db2ee"], "tags": []}], "date": 1766712545, "git_changesets": ["42e888637a2a143e83334b4a8198c91f9cd47b10"], "user": "dsmith@mozilla.com"}, "413": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2007618 - Make `AutoEmptyBlockAncestorDeleter::GetNewCaretPosition` ignore invisible `Text` nodes  a=RyanVM\n\nThe remaining case of bug 2005895 is, there is a invisible `Text`\nbetween paragraphs like:\n```html\n\u003cp\u003eabc\u003c/p\u003e \u003cp\u003e{}\u003cbr\u003e\u003c/p\u003e\n```\nThe reason is, `HTMLEditUtils::GetPreviousContent` is not called with\n`WalkTreeOption::IgnoreWhiteSpaceOnlyText`.  Therefore, I tried to\nadd the option in `AutoEmptyBlockAncestorDeleter::GetNewCaretPosition`.\nHowever, the handling is odd [1]:\n```cpp\n  static bool IsContentIgnored(const nsIContent& aContent,\n                               const WalkTreeOptions& aOptions) {\n```\n\u003csnip\u003e\n```cpp\n    if (aOptions.contains(WalkTreeOption::IgnoreWhiteSpaceOnlyText) &&\n        aContent.IsText() &&\n        const_cast\u003cText*\u003e(aContent.AsText())-\u003eTextIsOnlyWhitespace()) {\n      return true;\n    }\n```\nSo, whether the `Text` is actually visible or not is not tested.\nTherefore, this does not work with preformatted content.  However, I'd\nlike to uplift this to ESR140 so that it's too risky to change the\nextant `HTMLEditUtils` implementation.  Therefore, this patch makes\n`GetNewCaretPosition` ignore invisible `Text` nodes directly.\n\n1. https://searchfox.org/firefox-main/rev/20a1fb35a4d5c2f2ea6c865ecebc8e4bee6f86c9/editor/libeditor/HTMLEditUtils.h#3268-3269,3279-3282\n\nOriginal Revision: https://phabricator.services.mozilla.com/D277498\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277554\n", "files": ["editor/libeditor/HTMLEditorDeleteHandler.cpp", "testing/web-platform/meta/editing/run/forwarddelete.html.ini", "testing/web-platform/meta/editing/run/multitest.html.ini", "testing/web-platform/tests/editing/data/delete.js", "testing/web-platform/tests/editing/data/forwarddelete.js", "testing/web-platform/tests/editing/data/multitest.js"], "git_node": "95047e4964b69b07d91c112a6f572ab303bd3e99", "git_parents": ["42e888637a2a143e83334b4a8198c91f9cd47b10"], "node": "83c5f148c99a5ce0b43a032b60031c485cec6a1f", "parents": ["9c002a26b37554b72a1d9c0ab1fb7a625f861e54"], "tags": []}], "date": 1766851611, "git_changesets": ["95047e4964b69b07d91c112a6f572ab303bd3e99"], "user": "rvandermeulen@mozilla.com"}, "414": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277586\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "753c7aba8f9e25285322b43c2c9aacc1010aac5d", "git_parents": ["95047e4964b69b07d91c112a6f572ab303bd3e99"], "node": "d208962d988c9000097f859e12d0a4db6273aea1", "parents": ["83c5f148c99a5ce0b43a032b60031c485cec6a1f"], "tags": []}], "date": 1767013343, "git_changesets": ["753c7aba8f9e25285322b43c2c9aacc1010aac5d"], "user": "dmeehan@mozilla.com"}, "415": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2000981 - Deal with clamping to end of block. r=jfkthame,layout-reviewers a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277323\n", "files": ["layout/generic/nsBlockFrame.cpp"], "git_node": "ecffefcb1c6d36d44711f1c2f1b0804d9f99283d", "git_parents": ["753c7aba8f9e25285322b43c2c9aacc1010aac5d"], "node": "b238ac5ecc138bea94b9fe6ed9ada59c4110dab3", "parents": ["d208962d988c9000097f859e12d0a4db6273aea1"], "tags": []}], "date": 1767188421, "git_changesets": ["ecffefcb1c6d36d44711f1c2f1b0804d9f99283d"], "user": "dmeehan@mozilla.com"}, "416": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277733\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "b62c2bb4d25e5a8e43ab87df1c9c1213bcad6d16", "git_parents": ["ecffefcb1c6d36d44711f1c2f1b0804d9f99283d"], "node": "3409e699ceb961a98ceaeaf0ed98690fe16203c9", "parents": ["b238ac5ecc138bea94b9fe6ed9ada59c4110dab3"], "tags": []}], "date": 1767280015, "git_changesets": ["b62c2bb4d25e5a8e43ab87df1c9c1213bcad6d16"], "user": "dmeehan@mozilla.com"}, "417": {"changesets": [{"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2006500 - Don't load external css resources when loading a pdf  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D276839\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277807\n", "files": ["toolkit/components/pdfjs/content/PdfStreamConverter.sys.mjs", "toolkit/components/pdfjs/test/browser.toml", "toolkit/components/pdfjs/test/browser_pdfjs_response_link.js", "toolkit/components/pdfjs/test/pdf_response_link.sjs"], "git_node": "31a35f3269c8f97ae07d7b261d1ace0038a7f843", "git_parents": ["b62c2bb4d25e5a8e43ab87df1c9c1213bcad6d16"], "node": "098a307dab04cb05bd8524cd9b4995793207284c", "parents": ["3409e699ceb961a98ceaeaf0ed98690fe16203c9"], "tags": []}], "date": 1767565376, "git_changesets": ["31a35f3269c8f97ae07d7b261d1ace0038a7f843"], "user": "rvandermeulen@mozilla.com"}, "418": {"changesets": [{"author": "ffxbld \u