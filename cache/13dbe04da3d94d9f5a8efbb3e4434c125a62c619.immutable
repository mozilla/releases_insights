236\n", "files": ["devtools/client/inspector/markup/markup.js", "devtools/client/inspector/test/browser_inspector_initialization.js"], "git_node": "7c55e1efc2a3344030d0191752c5e8fc0e15a3c5", "git_parents": ["ec188ec108d0df94c764f1dc0736bc3a72b3b0f3"], "node": "9e7803acc6ad5eef9be76177bbc40cd2702e353f", "parents": ["599f65f075737811db64c0841f4631cd80095586"], "tags": []}], "date": 1754681605, "git_changesets": ["7c55e1efc2a3344030d0191752c5e8fc0e15a3c5"], "user": "rvandermeulen@mozilla.com"}, "148": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1828622, try to stabilize test_focus.xhtml a bit, r=farre a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259856\n", "files": ["dom/tests/mochitest/chrome/window_focus.xhtml"], "git_node": "99a150a0083e156e26f08f6dd21424c031827167", "git_parents": ["7c55e1efc2a3344030d0191752c5e8fc0e15a3c5"], "node": "1d68748a251c38712fabf0bd668443ac497b3431", "parents": ["9e7803acc6ad5eef9be76177bbc40cd2702e353f"], "tags": []}, {"author": "Landry Breuil \u003clandry@openbsd.org\u003e", "branch": "default", "desc": "Bug 1973336: fix building http3server when --with-system-nss/nspr is used r=glandium,necko-reviewers,jesup a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258821\n", "files": ["netwerk/test/http3server/moz.build"], "git_node": "2debf439a301567d4690dd335ff82feb56bd02ec", "git_parents": ["99a150a0083e156e26f08f6dd21424c031827167"], "node": "c560549184ac802191d7fc82ebc7805be497ce22", "parents": ["1d68748a251c38712fabf0bd668443ac497b3431"], "tags": []}], "date": 1754682921, "git_changesets": ["99a150a0083e156e26f08f6dd21424c031827167", "2debf439a301567d4690dd335ff82feb56bd02ec"], "user": "rvandermeulen@mozilla.com"}, "149": {"changesets": [{"author": "unknown \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1933572 - Be more stringent about which SurfaceDescriptors we serialize for moz