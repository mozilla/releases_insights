s:119981:"{
"lastpushid": 1679,
"pushes": {"100": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Bug 1978871 - Update l10n-changesets.json.  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258454\n", "files": ["browser/locales/l10n-changesets.json"], "git_node": "196173e09332f34cef89bab46e9d0bd5a0b314fc", "git_parents": ["9c8467ffee4a586fff22d9fb2d39ecf0ab4fd584"], "node": "ab6fd013a16b188106568c21305705972ed0cd1d", "parents": ["33a2d7d33f487429f753a36035dbc3fe2a358679"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965504 part 1 - add Download operation type and rename fileNameForDisplay  a=diannaS\n\nWe only ever used operationDisplayString to represent a filename,\nso go ahead and formalize that.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D251877\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258201\n", "files": ["browser/components/contentanalysis/content/ContentAnalysis.sys.mjs", "toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/ContentAnalysis.h", "toolkit/components/contentanalysis/nsIContentAnalysis.idl", "toolkit/components/contentanalysis/tests/browser/browser_clipboard_paste_file_content_analysis.js", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysis.cpp", "toolkit/locales/en-US/toolkit/contentanalysis/contentanalysis.ftl", "widget/windows/nsFilePicker.cpp"], "git_node": "7ec9c6d8f4f11e7e2fcdebbee798d56d42a95329", "git_parents": ["196173e09332f34cef89bab46e9d0bd5a0b314fc"], "node": "8aa3f0f24816b489d2a3e2f6483f54c31bbd5477", "parents": ["ab6fd013a16b188106568c21305705972ed0cd1d"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965504 part 2 - make Content Analysis log SHA-256 digest in hex  a=diannaS\n\nSadly, the demo agent doesn't do this and just logs the raw digest.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D251878\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258202\n", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp"], "git_node": "4bdb9246435316db25274a9326fd3acf72ce7a99", "git_parents": ["7ec9c6d8f4f11e7e2fcdebbee798d56d42a95329"], "node": "f4bf06c3061b834bb6cb9624bc74735ed62be25a", "parents": ["8aa3f0f24816b489d2a3e2f6483f54c31bbd5477"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965504 part 3 - avoid assert on shutdown if user actions are in progress  a=diannaS\n\nThis doesn't fix all the problems, but accessing mUserActionMap while\nwe're in the middle of shutdown is one way to hit an assert, so check\nIsShutDown() first.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D251879\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258203\n", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp"], "git_node": "40596147d06c86322a790e5127a17bd5124de94a", "git_parents": ["4bdb9246435316db25274a9326fd3acf72ce7a99"], "node": "57f05ca1d2a43b866050d581232b60833c404d33", "parents": ["f4bf06c3061b834bb6cb9624bc74735ed62be25a"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965504 part 4 - don't show the normal Content Analysis dialogs for downloads  a=diannaS\n\nOne annoying part to this is that for \"Save As\" downloads on a PDF (for\nexample), we don't get a valid browsing context. For downloads, the only\nthing we need a browsing context for us to get a window so we can show\nthe \"DLP busy\" notification, so just use the window that we were\ninitialized with. In practice I can't tell any difference.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D251880\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258204\n", "files": ["browser/components/contentanalysis/content/ContentAnalysis.sys.mjs"], "git_node": "1b51797326ffa5bb9a83f9258f98e2ff87bd9ba1", "git_parents": ["40596147d06c86322a790e5127a17bd5124de94a"], "node": "462d075199d34655ab908c4a45d3b0ff91425a10", "parents": ["57f05ca1d2a43b866050d581232b60833c404d33"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965504 part 4.5 - make ContentAnalysisResponse implement nsIClassInfo  a=diannaS\n\nThis means we don't have to QueryInterface() for it in JS.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253571\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258205\n", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/ContentAnalysis.h"], "git_node": "8036e10b2724a88ff29b8c1ec3407cc56a88c592", "git_parents": ["1b51797326ffa5bb9a83f9258f98e2ff87bd9ba1"], "node": "2ddd899b1d1cc8870168134a30ed441f61cf8270", "parents": ["462d075199d34655ab908c4a45d3b0ff91425a10"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965504 part 4.9 - make shouldBlockForReputationCheck() return a numerical verdict  a=diannaS\n\nThis is helpful for part 5 so we can compare the numbers instead of comparing\nstrings.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253572\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258206\n", "files": ["toolkit/components/downloads/DownloadCore.sys.mjs", "toolkit/components/downloads/DownloadIntegration.sys.mjs", "toolkit/components/downloads/test/unit/common_test_Download.js", "toolkit/components/downloads/test/unit/head.js", "toolkit/components/downloads/test/unit/test_DownloadBlockedTelemetry.js"], "git_node": "143dc7420ffde35e7e906532a3943b1dbddedcb0", "git_parents": ["8036e10b2724a88ff29b8c1ec3407cc56a88c592"], "node": "396dff3fd555abca42648e735bb5097199826b2e", "parents": ["2ddd899b1d1cc8870168134a30ed441f61cf8270"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965504 part 5 - integrate Content Analysis into Downloads  a=diannaS\n\nThe actual call to content analysis is in DownloadCore.sys.mjs's\n_checkReputationAndMove() method.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D251881\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258207\n", "files": ["browser/components/downloads/DownloadsCommon.sys.mjs", "browser/components/downloads/DownloadsViewUI.sys.mjs", "browser/components/downloads/content/downloads.css", "browser/components/downloads/content/downloads.js", "browser/locales/en-US/chrome/browser/downloads/downloads.properties", "toolkit/components/downloads/DownloadCore.sys.mjs", "toolkit/components/downloads/DownloadHistory.sys.mjs", "toolkit/components/downloads/DownloadIntegration.sys.mjs", "toolkit/components/reputationservice/nsIApplicationReputation.idl"], "git_node": "099ed944b9937c33b71895f336661316ed89996b", "git_parents": ["143dc7420ffde35e7e906532a3943b1dbddedcb0"], "node": "490eac586d75351f2bc5956b528b260ff40a16cc", "parents": ["396dff3fd555abca42648e735bb5097199826b2e"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965504 part 6 - add pref and enterprise policy for Content Analysis Downloads  a=diannaS\n\nNote that for backwards compatibility the pref to do Downloads\nanalysis is off by default.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D251882\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258208\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "modules/libpref/init/StaticPrefList.yaml", "toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/tests/browser/browser_content_analysis_policies.js"], "git_node": "ff9022d23027ba4ab3b377c67db838a5ac409153", "git_parents": ["099ed944b9937c33b71895f336661316ed89996b"], "node": "da632f8c9d78b84c87b560ec6d300bd6a01afe3d", "parents": ["490eac586d75351f2bc5956b528b260ff40a16cc"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965504 part 7 - add tests for Content Analysis Downloads  a=diannaS\n\nThere are more things we could test in the future (like clicking\nbuttons on the Downloads panel to block/unblock for WARN responses) but\nthis is a good first step.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D251883\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258209\n", "files": ["browser/components/downloads/test/browser/browser_downloads_panel_block.js", "toolkit/components/contentanalysis/tests/browser/browser.toml", "toolkit/components/contentanalysis/tests/browser/browser_download_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/browser_download_pdf_save_as_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/file_to_download.unknownextension"], "git_node": "0c41490ff107c2ea64e6ccba74c8b0d816557391", "git_parents": ["ff9022d23027ba4ab3b377c67db838a5ac409153"], "node": "71a95d7dc8ca55c7cbc1272809bcb37cd22465f7", "parents": ["da632f8c9d78b84c87b560ec6d300bd6a01afe3d"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965504 part 8 - update TypeScript files  a=diannaS\n\nThis is helpful since we changed some values in nsIContentAnalysis.idl.\nSadly, this also picks up a bunch of unrelated changes; such is the\nstate of TypeScript tooling right now.\n\nThis was all autogenerated with ./mach ts build && ./mach ts update\n\nOriginal Revision: https://phabricator.services.mozilla.com/D251884\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258210\n", "files": ["tools/@types/generated/lib.gecko.dom.d.ts", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "c74b8cf6d682f9dab2c9394eb01c6acedd071f13", "git_parents": ["0c41490ff107c2ea64e6ccba74c8b0d816557391"], "node": "314e799dc6f91739e125558a907496f65d26d276", "parents": ["71a95d7dc8ca55c7cbc1272809bcb37cd22465f7"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1972764 - make Content Analysis work if the download's redirects are non-null  a=diannaS\n\nI was wrong about the interface to download.saver.getRedirects(), and\nthis is the correct way to iterate over them.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254279\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258211\n", "files": ["toolkit/components/contentanalysis/tests/browser/browser.toml", "toolkit/components/contentanalysis/tests/browser/browser_download_save_link_as_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/download.html", "toolkit/components/downloads/DownloadIntegration.sys.mjs"], "git_node": "aec66f8d709ca01f10c00960f96261b7aca094b4", "git_parents": ["c74b8cf6d682f9dab2c9394eb01c6acedd071f13"], "node": "ef652da9b9b027443ae39070df0fa640e23ddab5", "parents": ["314e799dc6f91739e125558a907496f65d26d276"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1972764 - Lint Fix  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254296\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258212\n", "files": ["toolkit/components/contentanalysis/tests/browser/download.html"], "git_node": "0c73a36334d5af42812d7d44cc390c386250a6d4", "git_parents": ["aec66f8d709ca01f10c00960f96261b7aca094b4"], "node": "b3e69d344fccd8e07e8d048ad9050e3d330c8012", "parents": ["ef652da9b9b027443ae39070df0fa640e23ddab5"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1972773 - avoid showing \"confirm quit\" dialog in Content Analysis if we have already cancelled quit  a=diannaS\n\nI think there may be some other corner cases (if the user decides to confirm\nthe quit with a download running we still still show a dialog here), but\nthat is harder to fix and this is a start.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254291\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258213\n", "files": ["browser/components/contentanalysis/content/ContentAnalysis.sys.mjs", "toolkit/components/contentanalysis/tests/browser/browser_content_analysis_quit_confirmation_dialog.js"], "git_node": "972e0fdf7c8e1674724b1714cd3a24148f45aed9", "git_parents": ["0c73a36334d5af42812d7d44cc390c386250a6d4"], "node": "3ded037a9d4bb56d263c27ec1f75153e3ea28b04", "parents": ["b3e69d344fccd8e07e8d048ad9050e3d330c8012"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1963385 part 1 - add settings telemetry for Content Analysis  a=diannaS\n\nRecords telemetry for the settings used with Content Analysis. Note\nthat there is no way in C++ to get the default value of a pref that was\nset via an Enterprise Policy (with setAndLockPref()) because that method\nactually sets the default value, so I had to modify some of my plans for\ntelemetry to gather. For example, I was going to record interception points\nwhose Enabled value differed from the default, but instead we record\nany interception points whose Enabled value is false. (right now these\nare equivalent, but Downloads will be default-off so this will change)\n\nFor the allow/deny URL lists I didn't want to record the actual URLs\non those lists, so we really do want to just record whether the values\nare different from the default. I hard-coded the default into\nContentAnalysis.cpp, and we can rely on the JS test\ntest_ca_enterprise_config_with_default_prefs_telemetry() to start failing\nif that changes.\n\nAlso adds a forceRecreateClientForTest() method to ContentAnalysis that\ntests can use to force trying to connect to a client. (since this is when\nwe record the settings telemetry)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D252570\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258214\n", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/ContentAnalysis.h", "toolkit/components/contentanalysis/metrics.yaml", "toolkit/components/contentanalysis/nsIContentAnalysis.idl", "toolkit/components/contentanalysis/tests/browser/browser_content_analysis_policies.js", "toolkit/components/glean/metrics_index.py"], "git_node": "0acca0e06b6e096367c12b6f68ea14f0f73b25c7", "git_parents": ["972e0fdf7c8e1674724b1714cd3a24148f45aed9"], "node": "baeeb40d96c822fa46a9744ecd53e6eeaa657904", "parents": ["3ded037a9d4bb56d263c27ec1f75153e3ea28b04"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1963385 part 2 - add connection attempts/failures telemetry for Content Analysis  a=diannaS\n\nRecords connection attempts, retries, and failures (with nsresult).\n\nThis also adds a GetCreatingClientForTest() method so that tests can\ncall to create a client, then SpinEventLoopUntil() until\nGetCreatingClientForTest() returns false, and after this point the\ntelemetry should be recorded.\n\nAlso moves some test code from TestContentAnalysis.cpp to\nTestContentAnalysisUtils.h so it can be used in the new telemetry gtests.\n\nNote that these new gtests start the agent every time it's needed - this\nwill be cleaned up in part 4.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D252571\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258215\n", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/ContentAnalysis.h", "toolkit/components/contentanalysis/metrics.yaml", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysis.cpp", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysisTelemetry.cpp", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysisUtils.h", "toolkit/components/contentanalysis/tests/gtest/moz.build"], "git_node": "fdd82d20b22c8bbd12b716a47d2afb1a523931d9", "git_parents": ["0acca0e06b6e096367c12b6f68ea14f0f73b25c7"], "node": "51f6257e82818db33ec8bb0eddd6183744fcf7de", "parents": ["baeeb40d96c822fa46a9744ecd53e6eeaa657904"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1963385 part 3 - add requests telemetry for Content Analysis  a=diannaS\n\nRecords requests made (specifically the analysisType and reason), and\nalso requests allowed/blocked by the allow/deny URL lists.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D252572\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258216\n", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/metrics.yaml", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysis.cpp", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysisTelemetry.cpp", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysisUtils.h"], "git_node": "3a7d45fabaaf70eff7003169efc0b18baaf2cae3", "git_parents": ["fdd82d20b22c8bbd12b716a47d2afb1a523931d9"], "node": "2a4533f438e99a91fb1708c7953435e23a351542", "parents": ["51f6257e82818db33ec8bb0eddd6183744fcf7de"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1963385 part 4 - refactor telemetry tests to avoid starting agent so much  a=diannaS\n\nInstead of having each telemetry test start the agent at the top, add\nhelper methods EnsureAgentStarted() and EnsureAgentTerminated() that\nwill sure the agent is running or not, and will no-op if it's already in\nthat state.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D252573\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258217\n", "files": ["toolkit/components/contentanalysis/tests/gtest/TestContentAnalysisTelemetry.cpp", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysisUtils.h"], "git_node": "553655971b7bb4aea2fca9b79c5b800e3b785632", "git_parents": ["3a7d45fabaaf70eff7003169efc0b18baaf2cae3"], "node": "7bb90e3a1792e6f74e10ee4b1df134d126978781", "parents": ["2a4533f438e99a91fb1708c7953435e23a351542"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1963385 part 5 - add response telemetry for Content Analysis  a=diannaS\n\nRecords the action returned in a response from the DLP agent, as well\nas how long the agent took to return a response (roughly). Note that if\nthe agent pops up some kind of its own WARN dialog, the timing recorded\nwill include how long it took for the user to pick an option, so this\nmay not end up being too valuable.\n\nAlso includes a bit more shuffling around of test code so the telemetry\ntests can use it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D252574\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258218\n", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/ContentAnalysis.h", "toolkit/components/contentanalysis/metrics.yaml", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysis.cpp", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysisTelemetry.cpp", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysisUtils.cpp", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysisUtils.h"], "git_node": "d17532e2b1bd1b8a8e729ff121238f7f9c38aaf8", "git_parents": ["553655971b7bb4aea2fca9b79c5b800e3b785632"], "node": "66205a89c082203855381b1bd8582dccf97df7e7", "parents": ["7bb90e3a1792e6f74e10ee4b1df134d126978781"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1963385 part 6 - move acknowledgement message after Acknowledge() call  a=diannaS\n\nThis fixes some intermittency in the gtests, because now we know the\nAcknowledge() call has happened when the test receives the\n\"dlp-acknowledgement-sent-raw\" message and no more calls will be made\nto the client.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D252575\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258219\n", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp"], "git_node": "84a1919b8a3f2271108c579fc64c1d8687ccf984", "git_parents": ["d17532e2b1bd1b8a8e729ff121238f7f9c38aaf8"], "node": "048ae69fcda8e6d00dcbf208ffb4f7925b0ab36b", "parents": ["66205a89c082203855381b1bd8582dccf97df7e7"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1963385 part 7 - make tests that terminate the DLP agent wait until the process has terminated  a=diannaS\n\nThis gets rid of some intermittency now that more gtests are terminating\nand restarting the agent.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D252576\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258220\n", "files": ["toolkit/components/contentanalysis/tests/gtest/TestContentAnalysis.cpp", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysisTelemetry.cpp", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysisUtils.cpp", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysisUtils.h"], "git_node": "19dda29624a3e41cf6b4a4d221c98718c31d8587", "git_parents": ["84a1919b8a3f2271108c579fc64c1d8687ccf984"], "node": "3639a20c42e235340ca7b94a362005c7ff3ed5dc", "parents": ["048ae69fcda8e6d00dcbf208ffb4f7925b0ab36b"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1973005 - don't open about:blank when double-clicking on blocked download  a=diannaS\n\nI looked into using gInitialPages instead of hard-coding \"about:blank\",\nbut:\n- there's no convenient window or browser here to access gInitialPages\n- We hard-code \"about:blank\" many other places in source, so its\n  \"specialness\" is already pretty well established.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254871\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258221\n", "files": ["browser/components/downloads/DownloadsViewUI.sys.mjs"], "git_node": "5a1af9a0bb30f9db33d59f0c0d97bbbd148294ed", "git_parents": ["19dda29624a3e41cf6b4a4d221c98718c31d8587"], "node": "d15ee8e1eec171acc9d6a918d13ca2d24bdecd02", "parents": ["3639a20c42e235340ca7b94a362005c7ff3ed5dc"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1973043 - if download was blocked on exit, remove it from the downloads list  a=diannaS\n\nIf the DLP agent responds with WARN for a file, and the user quits Firefox\n(after a confirmation dialog), we treat that as a block. Previously we\nwere just reporting that to the agent and deleting the file on disk. But\nfor safebrowsing, downloads that were blocked don't persist after a browser\nrestart, so we should do that too for DLP ones.\n\nSo we just delete the download, which includes a call to respond to the\nDLP agent and finalize the download, but also removes it from the relevant\nlists.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255212\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258222\n", "files": ["toolkit/components/downloads/DownloadIntegration.sys.mjs"], "git_node": "416e84a948644325a895ca77047dd9d6f330eba1", "git_parents": ["5a1af9a0bb30f9db33d59f0c0d97bbbd148294ed"], "node": "14c87677ffbd9d3b280d61731a836fa54e4fc43e", "parents": ["d15ee8e1eec171acc9d6a918d13ca2d24bdecd02"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1973168 - wait for both safebrowsing and content analysis results for downloads  a=diannaS\n\nPreviously if one result was the most restrictive possible (verdict=VERDICT_DANGEROUS\nand shouldBlock=true), we would not wait for the other result and just use that one.\nHowever, safebrowsing results are generally overridable by the user, but a BLOCK result\nfrom content analysis should not be overridable.\n\nInstead of making the early result check more complicated, I think it's more\nstraightforward to just always wait for both. The existing hasMostRestrictiveResult()\nmethod already knows that content analysis results should take precedence, and I\nrenamed the parameters to make that more clear.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255389\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258223\n", "files": ["toolkit/components/downloads/DownloadCore.sys.mjs"], "git_node": "863f6fe12fc86a01d2bdd6ab7d9da41c3fa9493d", "git_parents": ["416e84a948644325a895ca77047dd9d6f330eba1"], "node": "e469a19b265cfe3f903c58397895c39392677b83", "parents": ["14c87677ffbd9d3b280d61731a836fa54e4fc43e"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975175 - cancel Content Analysis when Download is canceled  a=diannaS\n\nIf a Download is canceled, cancel the Content Analysis request in progress\nand return something so the Download can finish.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D257535\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258224\n", "files": ["toolkit/components/contentanalysis/tests/browser/browser_download_content_analysis.js", "toolkit/components/downloads/DownloadIntegration.sys.mjs"], "git_node": "84ee5cc917131c3f71d688a6bf79a28e94716b09", "git_parents": ["863f6fe12fc86a01d2bdd6ab7d9da41c3fa9493d"], "node": "bc98a888b7f48ef572dd3247aaaba0b87d202306", "parents": ["e469a19b265cfe3f903c58397895c39392677b83"], "tags": []}], "date": 1753292117, "git_changesets": ["196173e09332f34cef89bab46e9d0bd5a0b314fc", "7ec9c6d8f4f11e7e2fcdebbee798d56d42a95329", "4bdb9246435316db25274a9326fd3acf72ce7a99", "40596147d06c86322a790e5127a17bd5124de94a", "1b51797326ffa5bb9a83f9258f98e2ff87bd9ba1", "8036e10b2724a88ff29b8c1ec3407cc56a88c592", "143dc7420ffde35e7e906532a3943b1dbddedcb0", "099ed944b9937c33b71895f336661316ed89996b", "ff9022d23027ba4ab3b377c67db838a5ac409153", "0c41490ff107c2ea64e6ccba74c8b0d816557391", "c74b8cf6d682f9dab2c9394eb01c6acedd071f13", "aec66f8d709ca01f10c00960f96261b7aca094b4", "0c73a36334d5af42812d7d44cc390c386250a6d4", "972e0fdf7c8e1674724b1714cd3a24148f45aed9", "0acca0e06b6e096367c12b6f68ea14f0f73b25c7", "fdd82d20b22c8bbd12b716a47d2afb1a523931d9", "3a7d45fabaaf70eff7003169efc0b18baaf2cae3", "553655971b7bb4aea2fca9b79c5b800e3b785632", "d17532e2b1bd1b8a8e729ff121238f7f9c38aaf8", "84a1919b8a3f2271108c579fc64c1d8687ccf984", "19dda29624a3e41cf6b4a4d221c98718c31d8587", "5a1af9a0bb30f9db33d59f0c0d97bbbd148294ed", "416e84a948644325a895ca77047dd9d6f330eba1", "863f6fe12fc86a01d2bdd6ab7d9da41c3fa9493d", "84ee5cc917131c3f71d688a6bf79a28e94716b09"], "user": "dsmith@mozilla.com"}, "101": {"changesets": [{"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1551856: Move AudioSession to LayoutStatics r=mccr8,win-reviewers,gstoll a=RyanVM\n\nThis allows us to shut down the IAudioSessionManager after Cubeb has stopped,\nso there shouldn't be STA apartment deadlock issues with it.\nIAudioSessionManager's shutdown always requires the STA.  This patch eliminates\nMTA threads involvement at shutdown, which was previously needed for thread\nsafety.  We keep other operations on MTA (background) threads, for performance.\n\nThis also removes a lot of unused functionality.  AudioSession hasn't been\nneeded outside of the parent process since audio remoting landed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D251773\n", "files": ["dom/ipc/ContentParent.cpp", "js/xpconnect/src/XPCShellImpl.cpp", "layout/build/nsLayoutStatics.cpp", "widget/windows/AudioSession.cpp", "widget/windows/AudioSession.h", "widget/windows/nsAppShell.cpp"], "git_node": "18de707b8ecd695d058cd03f573bfaf771d4fc29", "git_parents": ["84ee5cc917131c3f71d688a6bf79a28e94716b09"], "node": "fb01bc21faf047e023981aea95a490d7cab38ce0", "parents": ["bc98a888b7f48ef572dd3247aaaba0b87d202306"], "tags": []}], "date": 1753320855, "git_changesets": ["18de707b8ecd695d058cd03f573bfaf771d4fc29"], "user": "rvandermeulen@mozilla.com"}, "102": {"changesets": [{"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1973993 - Add in missing files for running mach  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D256359\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258477\n", "files": ["js/src/make-source-package.py"], "git_node": "24a02285cdf33b433747cee0485eb363c2a4e7c2", "git_parents": ["18de707b8ecd695d058cd03f573bfaf771d4fc29"], "node": "796480f28a7d26f3380087f9bdc2d3f50ca26368", "parents": ["fb01bc21faf047e023981aea95a490d7cab38ce0"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1973993 - Install ProfilingCategoryList.h into both the js/ directory and the toplevel include directory  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D256360\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258478\n", "files": ["js/src/build/Makefile.in"], "git_node": "e3190778ad14b2fea44204c868ca31e111b8db07", "git_parents": ["24a02285cdf33b433747cee0485eb363c2a4e7c2"], "node": "a201f741c8f1a63a5e12af9fd4c58cb32686865c", "parents": ["796480f28a7d26f3380087f9bdc2d3f50ca26368"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1973993 - Switch autospider.py to using mach to run jit-test and jstests  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D256361\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258479\n", "files": ["js/src/devtools/automation/autospider.py", "js/src/devtools/automation/variants/arm64-sim", "js/src/devtools/automation/variants/compacting", "js/src/devtools/automation/variants/fuzzilli", "js/src/devtools/automation/variants/fuzzing", "js/src/devtools/automation/variants/msan", "js/src/devtools/automation/variants/plain", "js/src/devtools/automation/variants/rootanalysis", "js/src/devtools/automation/variants/tsan", "js/src/devtools/automation/variants/wasi", "js/src/devtools/automation/variants/wasi-intl", "js/src/devtools/automation/variants/wasi-pbl"], "git_node": "3594c03511634a31217018da6ae03da5856582e0", "git_parents": ["e3190778ad14b2fea44204c868ca31e111b8db07"], "node": "fae670acae9a6bea2615438c5e3e89c6d3bb4cae", "parents": ["a201f741c8f1a63a5e12af9fd4c58cb32686865c"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1973993 - Switch gdb test to using extra-args  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D256362\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258480\n", "files": ["js/src/devtools/automation/autospider.py", "js/src/devtools/automation/variants/gdb"], "git_node": "b29a5e4b56819fd2888700da1be39bb8fd31b82a", "git_parents": ["3594c03511634a31217018da6ae03da5856582e0"], "node": "ce2c8d6d9dafb5fbacc5f2076a6618ca6eab83fe", "parents": ["fae670acae9a6bea2615438c5e3e89c6d3bb4cae"], "tags": []}], "date": 1753321131, "git_changesets": ["24a02285cdf33b433747cee0485eb363c2a4e7c2", "e3190778ad14b2fea44204c868ca31e111b8db07", "3594c03511634a31217018da6ae03da5856582e0", "b29a5e4b56819fd2888700da1be39bb8fd31b82a"], "user": "rvandermeulen@mozilla.com"}, "103": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258558\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-config-v2.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/main/translations-models.json"], "git_node": "03fc0ce6b0b144e30f9af1ea22f0b4126ef7b40b", "git_parents": ["b29a5e4b56819fd2888700da1be39bb8fd31b82a"], "node": "1a88508c4098c594ea598c903c2eac92eb8ca93c", "parents": ["ce2c8d6d9dafb5fbacc5f2076a6618ca6eab83fe"], "tags": []}], "date": 1753358138, "git_changesets": ["03fc0ce6b0b144e30f9af1ea22f0b4126ef7b40b"], "user": "rvandermeulen@mozilla.com"}, "104": {"changesets": [{"author": "Dharma Ong \u003cdharmaong00@gmail.com\u003e", "branch": "default", "desc": "Bug 1973763 - Add Aura and DT partner codes to search-config-v2 for android. r=mcheang, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257580\n", "files": ["toolkit/components/search/tests/xpcshell/searchconfigs/test_distributions.js"], "git_node": "86d56b63825f7ec6b18e1c601ef7b6702d1d7d50", "git_parents": ["03fc0ce6b0b144e30f9af1ea22f0b4126ef7b40b"], "node": "c56287e150e670968d7c4d34be3d48dc24552bb6", "parents": ["1a88508c4098c594ea598c903c2eac92eb8ca93c"], "tags": []}], "date": 1753379155, "git_changesets": ["86d56b63825f7ec6b18e1c601ef7b6702d1d7d50"], "user": "dsmith@mozilla.com"}, "105": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1973149 - fix form validation message not updating if the form validation popup is already open,  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254824\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258550\n", "files": ["browser/actors/FormValidationParent.sys.mjs", "browser/modules/test/browser/formValidation/browser.toml", "browser/modules/test/browser/formValidation/browser_validation_message_update.js", "browser/modules/test/browser/formValidation/browser_validation_other_popups.js"], "git_node": "5adc9375da8ad36ad4bcd386be18c4a67e0704b8", "git_parents": ["86d56b63825f7ec6b18e1c601ef7b6702d1d7d50"], "node": "caf2eac7389c576ff4a9746a69b3ced67eca21ed", "parents": ["c56287e150e670968d7c4d34be3d48dc24552bb6"], "tags": []}], "date": 1753379673, "git_changesets": ["5adc9375da8ad36ad4bcd386be18c4a67e0704b8"], "user": "dsmith@mozilla.com"}, "106": {"changesets": [{"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1972786 - show various DLP agent errors for download operations  a=diannaS\n\nShow these errors in the download panel, etc.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254295\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258587\n", "files": ["browser/components/contentanalysis/content/ContentAnalysis.sys.mjs", "browser/components/downloads/DownloadsCommon.sys.mjs", "browser/components/downloads/DownloadsViewUI.sys.mjs", "browser/locales/en-US/chrome/browser/downloads/downloads.properties", "toolkit/components/downloads/DownloadCore.sys.mjs", "toolkit/components/downloads/DownloadHistory.sys.mjs", "toolkit/components/downloads/DownloadIntegration.sys.mjs"], "git_node": "b48f6f40357af4577edfed9751ef1e15277448ea", "git_parents": ["5adc9375da8ad36ad4bcd386be18c4a67e0704b8"], "node": "c415b1e153ae74fd4aba72fbf8e6923419208b92", "parents": ["caf2eac7389c576ff4a9746a69b3ced67eca21ed"], "tags": []}], "date": 1753388556, "git_changesets": ["b48f6f40357af4577edfed9751ef1e15277448ea"], "user": "dsmith@mozilla.com"}, "107": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1968427 - Adding a null checking on WorkerPrivate::GlobalScope() in ServiceWorkerOpRunnable.  a=diannaS\n\nWorkerPrivate's GlobalScope is created during CompileScriptRunnable::WorkerRun.\nHowever, the creation could fail when there is an OOM issue during the WebIDL bindings.\nAlthough the Worker will start the shutdown as soon as possible, there is still a chance that some WorkerRunnable had already been dispatched to the Worker. And there is no guarantee that there is a GlobalScope for the WorkerRunnable.\nUnfortunately, WorkerRunnable should check the GlobalScope existence by itself, because not every WorkerRunnable needs the GlobalScope to perform its functionality.\n\nThis patch only does the null checking for the ServiceWorkerOpRunnable, since ServiceWorkerOpRunnable are supposed to dispatching an event to the corresponding ServiceWorkerGlobalScope.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254659\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258725\n", "files": ["dom/serviceworkers/ServiceWorkerOp.cpp"], "git_node": "6dbb97510837bfcdec2fe061e860f67d0a42ae67", "git_parents": ["b48f6f40357af4577edfed9751ef1e15277448ea"], "node": "28fe16d805e55981116d93f51cf38d56d44e2835", "parents": ["c415b1e153ae74fd4aba72fbf8e6923419208b92"], "tags": []}], "date": 1753470345, "git_changesets": ["6dbb97510837bfcdec2fe061e860f67d0a42ae67"], "user": "dsmith@mozilla.com"}, "108": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1978217 - Record use counter data inline in StylesheetContents. r=firefox-style-system-reviewers,layout-reviewers,dshin, a=dsmith\n\nNo behavior change, but this is simpler. I want to reuse the use\ncounters mechanism to fix this bug because it's a very trivial way of\nasking questions about the parsed data and we need to plumb it through\nthe same places.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258290\n", "files": ["dom/base/nsTreeSanitizer.cpp", "layout/style/GeckoBindings.cpp", "layout/style/GeckoBindings.h", "layout/style/Loader.cpp", "layout/style/StyleSheet.cpp", "layout/style/StyleSheet.h", "layout/style/StyleSheetInfo.h", "layout/style/test/gtest/StyloParsingBench.cpp", "servo/components/style/stylesheets/stylesheet.rs", "servo/components/style/use_counters/mod.rs", "servo/ports/geckolib/glue.rs", "servo/ports/geckolib/stylesheet_loader.rs"], "git_node": "a3013fe0ae0b1153c387a3b1b09fba59f7d9854e", "git_parents": ["6dbb97510837bfcdec2fe061e860f67d0a42ae67"], "node": "9f7c116b6313cebb6d1cca7db72593336b25ffc0", "parents": ["28fe16d805e55981116d93f51cf38d56d44e2835"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1978217 - Add support for custom style use counters. r=firefox-style-system-reviewers,layout-reviewers,dshin, a=dsmith\n\nIn the future if we need to we can hook these up to telemetry (in fact it's not\nhard, we just need to do that in Document::ReportUseCounters).\n\nFor now I want to start using them to record whether we might have a data URI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258291\n", "files": ["servo/components/style/use_counters/mod.rs", "servo/ports/geckolib/glue.rs"], "git_node": "7a19b92511329aba7b6e57b8ef8c1690b051f8f5", "git_parents": ["a3013fe0ae0b1153c387a3b1b09fba59f7d9854e"], "node": "b5c68cf8f03de76fd5db57cf969914fd0ef31947", "parents": ["9f7c116b6313cebb6d1cca7db72593336b25ffc0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1978217 - Don't share sheets using relative URIs when it's not safe to do so. r=firefox-style-system-reviewers,layout-reviewers,dshin a=dsmith\n\nTrack whether an inline sheet might have uris that depend on the base, and\navoid caching them if appropriate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258292\n", "files": ["layout/style/Loader.cpp", "layout/style/Loader.h", "layout/style/StyleSheet.cpp", "layout/style/StyleSheet.h", "servo/components/style/gecko/url.rs", "servo/components/style/use_counters/mod.rs", "servo/ports/geckolib/cbindgen.toml"], "git_node": "41c3fd6f74cbc61ce8aea86ead54ecd369cbd34c", "git_parents": ["7a19b92511329aba7b6e57b8ef8c1690b051f8f5"], "node": "a5a274b629d82ca5b2eabe51bf8b688ed2fbf948", "parents": ["b5c68cf8f03de76fd5db57cf969914fd0ef31947"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1978217 - Add a test for relative URIs inside cacheable inline stylesheets. r=firefox-style-system-reviewers,layout-reviewers,dshin, a=dsmith\n\nThis tests both @import and regular declarations. Without this fix, the test\npage renders blue, rather than a blue background with a purple square inside\nand a smaller lime square inside.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258293\n", "files": ["testing/web-platform/tests/css/css-values/inline-cache-base-uri-ref.html", "testing/web-platform/tests/css/css-values/inline-cache-base-uri.css", "testing/web-platform/tests/css/css-values/inline-cache-base-uri.html", "testing/web-platform/tests/css/css-values/inline-cache-base-uri/inline-cache-base-uri.css", "testing/web-platform/tests/css/css-values/inline-cache-base-uri/inner.html"], "git_node": "177b577d2ad4c8307ca5ff238501b89b276de3da", "git_parents": ["41c3fd6f74cbc61ce8aea86ead54ecd369cbd34c"], "node": "55c7c76cff4193769cf6f6ac5fdf1dda7d661fe9", "parents": ["a5a274b629d82ca5b2eabe51bf8b688ed2fbf948"], "tags": []}, {"author": "Lando \u003clando@lando.test\u003e", "branch": "default", "desc": "Bug 1978217: apply code formatting via Lando, a=dsmith\n", "files": ["dom/base/nsTreeSanitizer.cpp", "layout/style/Loader.cpp", "layout/style/StyleSheet.cpp"], "git_node": "9e9cfb0a37f2a4e34586cd6dec60fbe181cedaa5", "git_parents": ["177b577d2ad4c8307ca5ff238501b89b276de3da"], "node": "30255082489e4ddf8a55f24dc266bc36dead6e97", "parents": ["55c7c76cff4193769cf6f6ac5fdf1dda7d661fe9"], "tags": []}], "date": 1753486401, "git_changesets": ["a3013fe0ae0b1153c387a3b1b09fba59f7d9854e", "7a19b92511329aba7b6e57b8ef8c1690b051f8f5", "41c3fd6f74cbc61ce8aea86ead54ecd369cbd34c", "177b577d2ad4c8307ca5ff238501b89b276de3da", "9e9cfb0a37f2a4e34586cd6dec60fbe181cedaa5"], "user": "dsmith@mozilla.com"}, "109": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976376 - More Http2StreamBase cleanup (esr140), r=necko-reviewers,sunil a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258683\n", "files": ["netwerk/protocol/http/ConnectionDiagnostics.cpp", "netwerk/protocol/http/Http2Session.cpp", "netwerk/protocol/http/Http2Session.h", "netwerk/protocol/http/Http2Stream.h", "netwerk/protocol/http/Http2StreamBase.cpp", "netwerk/protocol/http/Http2StreamBase.h", "netwerk/protocol/http/Http2StreamTunnel.cpp", "netwerk/protocol/http/Http2StreamTunnel.h"], "git_node": "3797a61e442811898b0ca12559b94033f43bb575", "git_parents": ["9e9cfb0a37f2a4e34586cd6dec60fbe181cedaa5"], "node": "a8058026810cab22ad4b366cb22858ed1d956518", "parents": ["30255082489e4ddf8a55f24dc266bc36dead6e97"], "tags": []}], "date": 1753564352, "git_changesets": ["3797a61e442811898b0ca12559b94033f43bb575"], "user": "dsmith@mozilla.com"}, "110": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258885\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "26ad3887ac87c002c1334477a139f8f5eb75e04e", "git_parents": ["3797a61e442811898b0ca12559b94033f43bb575"], "node": "46a8ed19b821106071c27a6df68f747dfc448745", "parents": ["a8058026810cab22ad4b366cb22858ed1d956518"], "tags": []}], "date": 1753703004, "git_changesets": ["26ad3887ac87c002c1334477a139f8f5eb75e04e"], "user": "dsmith@mozilla.com"}, "111": {"changesets": [{"author": "Pier Angelo Vendrame \u003cpierov@torproject.org\u003e", "branch": "default", "desc": "Bug 1972282 - Check for spoof English in xsl:sort.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254784\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258855\n", "files": ["dom/xslt/xpath/txXPathNode.h", "dom/xslt/xslt/txNodeSorter.cpp"], "git_node": "448e04165524365d47d5a046e0a5a4ffee43f84f", "git_parents": ["26ad3887ac87c002c1334477a139f8f5eb75e04e"], "node": "dc55052c8ba37c5b78ea61c8c24e49331af6a9b3", "parents": ["46a8ed19b821106071c27a6df68f747dfc448745"], "tags": []}], "date": 1753729632, "git_changesets": ["448e04165524365d47d5a046e0a5a4ffee43f84f"], "user": "dsmith@mozilla.com"}, "112": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977166: When moving a RemoteAccessible, ensure it doesn't still have a parent.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D257206\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258841\n", "files": ["accessible/ipc/DocAccessibleParent.cpp"], "git_node": "d06a39a730c4787d63adfb58959e3b84719fd4ef", "git_parents": ["448e04165524365d47d5a046e0a5a4ffee43f84f"], "node": "5c56075bff0d1736d29d1c3d4d52c7c206d53e9c", "parents": ["dc55052c8ba37c5b78ea61c8c24e49331af6a9b3"], "tags": []}], "date": 1753731282, "git_changesets": ["d06a39a730c4787d63adfb58959e3b84719fd4ef"], "user": "dsmith@mozilla.com"}, "113": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1979163 - Add missing AutoPrepareTraversal. r=firefox-style-system-reviewers,dshin, a=dsmith\n\nBug 1967507 made the AutoPrepareTraversal scope smaller, but missed this\nloop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258724\n", "files": ["layout/style/ServoStyleSet.cpp"], "git_node": "6d1ac1135eda532124f4160dff29347b965fd221", "git_parents": ["d06a39a730c4787d63adfb58959e3b84719fd4ef"], "node": "3f533cd540069afad129368572445a2d1ba04c85", "parents": ["5c56075bff0d1736d29d1c3d4d52c7c206d53e9c"], "tags": []}], "date": 1753733460, "git_changesets": ["6d1ac1135eda532124f4160dff29347b965fd221"], "user": "dsmith@mozilla.com"}, "114": {"changesets": [{"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1979113: Reject AsyncEncodeAndWriteIcon promise if task dispatch fails on Windows r=daisuke,win-reviewers,gstoll, a=dsmith\n\nReject the promise at destruction unless it has already been resolved/rejected.\nAlso return an error (that is ignored).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258614\n", "files": ["widget/windows/WinUtils.cpp"], "git_node": "c68862e175ffab8917566f5b1f0d721650b22077", "git_parents": ["6d1ac1135eda532124f4160dff29347b965fd221"], "node": "8584d654b34e6938367d0a9ea0025bdc8078d56e", "parents": ["3f533cd540069afad129368572445a2d1ba04c85"], "tags": []}], "date": 1753814877, "git_changesets": ["c68862e175ffab8917566f5b1f0d721650b22077"], "user": "dsmith@mozilla.com"}, "115": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1930690 - certificate transparency: support static-ct-api (\"tiled\") logs  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258972\n", "files": ["security/certverifier/CertVerifier.cpp", "security/ct/CTKnownLogs.h", "security/ct/CTLogVerifier.cpp", "security/ct/CTLogVerifier.h", "security/ct/CTPolicyEnforcer.cpp", "security/ct/CTSerialization.cpp", "security/ct/CTVerifyResult.cpp", "security/ct/CTVerifyResult.h", "security/ct/MultiLogCTVerifier.cpp", "security/ct/SignedCertificateTimestamp.cpp", "security/ct/SignedCertificateTimestamp.h", "security/ct/tests/gtest/CTLogVerifierTest.cpp", "security/ct/tests/gtest/CTObjectsExtractorTest.cpp", "security/ct/tests/gtest/CTPolicyEnforcerTest.cpp", "security/ct/tests/gtest/CTSerializationTest.cpp", "security/ct/tests/gtest/CTTestUtils.cpp", "security/ct/tests/gtest/CTTestUtils.h", "security/ct/tests/gtest/MultiLogCTVerifierTest.cpp", "security/manager/ssl/tests/unit/test_ct.js", "security/manager/ssl/tests/unit/test_ct/ct-tiled-valid.example.com.pem", "security/manager/ssl/tests/unit/test_ct/ct-tiled-valid.example.com.pem.certspec", "security/manager/ssl/tests/unit/test_ct/ct-unknown-log.example.com.pem", "security/manager/ssl/tests/unit/test_ct/ct-unknown-log.example.com.pem.certspec", "security/manager/tools/log_list.json", "security/manager/tools/pycert.py", "security/manager/tools/pyct.py", "taskcluster/docker/periodic-updates/scripts/getCTKnownLogs.py"], "git_node": "e85c3d250f4fd7741ba3bb3e212e600915eedaa1", "git_parents": ["c68862e175ffab8917566f5b1f0d721650b22077"], "node": "cf43e4e808488a7747921b153d05e9821c177e1c", "parents": ["8584d654b34e6938367d0a9ea0025bdc8078d56e"], "tags": []}], "date": 1753820407, "git_changesets": ["e85c3d250f4fd7741ba3bb3e212e600915eedaa1"], "user": "dsmith@mozilla.com"}, "116": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1971702 - Update Opera migrator to account for the Default user profile.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254992\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259249\n", "files": ["browser/components/migration/ChromeProfileMigrator.sys.mjs", "browser/components/migration/MigratorBase.sys.mjs"], "git_node": "96145a393e062b85472f77250221f8170d331923", "git_parents": ["e85c3d250f4fd7741ba3bb3e212e600915eedaa1"], "node": "39af27d2c6a5f53f7277766447ddc5a13d21743c", "parents": ["cf43e4e808488a7747921b153d05e9821c177e1c"], "tags": []}], "date": 1753894737, "git_changesets": ["96145a393e062b85472f77250221f8170d331923"], "user": "dsmith@mozilla.com"}, "117": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976782 - Guard against possible race via gfxFontEntry::GetFontTable.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D258728\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259118\n", "files": ["gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h"], "git_node": "ec4d6aa373b37bbb1fac96f0f031487c2115e42f", "git_parents": ["96145a393e062b85472f77250221f8170d331923"], "node": "c3fd840fa3bd843c0000b285785d5243bfc1fcca", "parents": ["39af27d2c6a5f53f7277766447ddc5a13d21743c"], "tags": []}], "date": 1753974827, "git_changesets": ["ec4d6aa373b37bbb1fac96f0f031487c2115e42f"], "user": "dsmith@mozilla.com"}, "118": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977347 - osclientcerts: check for already being on the right thread in ThreadSpecificHandles::drop  a=diannaS\n\nIf a `find_objects` implementation encounters an error, it may release a\n`ThreadSpecificHandles` on the background thread. Before this patch, this would\ncause `ThreadSpecificHandles::drop` to block on the currently-running thread,\ncausing a deadlock. This patch changes the drop implementation to first check\nif it's already on the background thread, in which case it can simply release\nthe resources without blocking on anything.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D258085\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258729\n", "files": ["security/manager/ssl/osclientcerts/src/backend_macos.rs", "security/manager/ssl/osclientcerts/src/backend_windows.rs"], "git_node": "05b70c7f113137b445a5edb2d72053f57bea333a", "git_parents": ["ec4d6aa373b37bbb1fac96f0f031487c2115e42f"], "node": "85e04e4c8bd580eccbfd9ae8af011573db4be0f3", "parents": ["c3fd840fa3bd843c0000b285785d5243bfc1fcca"], "tags": []}], "date": 1753976341, "git_changesets": ["05b70c7f113137b445a5edb2d72053f57bea333a"], "user": "dsmith@mozilla.com"}, "119": {"changesets": [{"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1963764 - make sure Report Broken Site is still hidden appropriately when enterprise DisableFeedbackCommands policy is active (regressed by bug 1952334); r=Gijs, a=dsmith DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258785\n", "files": ["browser/components/reportbrokensite/ReportBrokenSite.sys.mjs", "browser/components/reportbrokensite/test/browser/browser_parent_menuitems.js", "browser/components/reportbrokensite/test/browser/head.js"], "git_node": "10c77a8f7af66faa309b56b8e95fb64998160ea5", "git_parents": ["05b70c7f113137b445a5edb2d72053f57bea333a"], "node": "cf0f1e09c21d7becfc9e09a0d082b0785f6efb16", "parents": ["85e04e4c8bd580eccbfd9ae8af011573db4be0f3"], "tags": []}], "date": 1753982559, "git_changesets": ["10c77a8f7af66faa309b56b8e95fb64998160ea5"], "user": "dsmith@mozilla.com"}, "120": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259454\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-config-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "ba9c3b0b56be3791a850f1091b67204152dde2fb", "git_parents": ["10c77a8f7af66faa309b56b8e95fb64998160ea5"], "node": "368d4262d8c0beab504dac37291eeddee989d5d3", "parents": ["cf0f1e09c21d7becfc9e09a0d082b0785f6efb16"], "tags": []}], "date": 1753985551, "git_changesets": ["ba9c3b0b56be3791a850f1091b67204152dde2fb"], "user": "dsmith@mozilla.com"}, "121": {"changesets": [{"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1974445 - Linux sandbox: genericize the socketcall unpack trap.  a=diannaS\n\nThe sandbox has code to handle `socketcall`, a multiplexer for\nsocket-related syscalls used in Linux's oldest target architectures, by\nunpacking the arguments and resubmitting the call using the individual\nsyscalls added in kernel 4.3 if available.  This allows seccomp-bpf to\nfilter the syscall arguments, and not just which call it is (see also\nbug 1066750).\n\nCurrently this is a special case for `socketpair` and `getsockopt`; this\npatch generalizes it and adds a number of other socket calls, which will\nbe used by the next patch.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255741\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259014\n", "files": ["security/sandbox/linux/SandboxFilter.cpp"], "git_node": "ffbb1e538bd1b00505f901db0770cde9884cbe20", "git_parents": ["ba9c3b0b56be3791a850f1091b67204152dde2fb"], "node": "ecf9f767db3a5a2652c734d40d47c48c732dbffd", "parents": ["368d4262d8c0beab504dac37291eeddee989d5d3"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1974445 - Linux sandbox: filter the flags arguments to send/recv syscalls.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255742\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259015\n", "files": ["security/sandbox/common/test/SandboxTestingChildTests.h", "security/sandbox/linux/SandboxFilter.cpp"], "git_node": "d6f73cfef5a87e3bca80b71f209a145bca92f30c", "git_parents": ["ffbb1e538bd1b00505f901db0770cde9884cbe20"], "node": "3591ee00dc26eb3231e5e25e3d3171b3df0273f8", "parents": ["ecf9f767db3a5a2652c734d40d47c48c732dbffd"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1974445 - Linux sandbox: filter send/recv flags for socket process.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255743\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259016\n", "files": ["security/sandbox/common/test/SandboxTestingChildTests.h", "security/sandbox/linux/SandboxFilter.cpp"], "git_node": "47e3221ff1f0ee0e5c529e5104bedbaac70d7c4e", "git_parents": ["d6f73cfef5a87e3bca80b71f209a145bca92f30c"], "node": "6ba55c021f7a65a289ffe92009fcb81885d3868b", "parents": ["3591ee00dc26eb3231e5e25e3d3171b3df0273f8"], "tags": []}], "date": 1753990382, "git_changesets": ["ffbb1e538bd1b00505f901db0770cde9884cbe20", "d6f73cfef5a87e3bca80b71f209a145bca92f30c", "47e3221ff1f0ee0e5c529e5104bedbaac70d7c4e"], "user": "dsmith@mozilla.com"}, "122": {"changesets": [{"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1970154 - Streams Realm Handling Improvements r=saschanaz,jonco, a=dsmith DONTBUILD\n\nMake TransferArrayBuffer cautious, and remove overzealous assert in JS_GetArrayBufferViewBuffer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253288\n", "files": ["dom/streams/ByteStreamHelpers.cpp", "js/src/vm/ArrayBufferViewObject.cpp"], "git_node": "b8bf3faaeef89673242161d31ef0acbbc8c72023", "git_parents": ["47e3221ff1f0ee0e5c529e5104bedbaac70d7c4e"], "node": "f2e308bb35739dae635bad890d8e1da81e81d911", "parents": ["6ba55c021f7a65a289ffe92009fcb81885d3868b"], "tags": []}], "date": 1754312564, "git_changesets": ["b8bf3faaeef89673242161d31ef0acbbc8c72023"], "user": "dsmith@mozilla.com"}, "123": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259805\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "9a2c95e1e50faa185ba760b79d922f3f3b3cbc75", "git_parents": ["b8bf3faaeef89673242161d31ef0acbbc8c72023"], "node": "0865dd01c70fb77778f6334d5e9e9829c6667d46", "parents": ["f2e308bb35739dae635bad890d8e1da81e81d911"], "tags": []}], "date": 1754323618, "git_changesets": ["9a2c95e1e50faa185ba760b79d922f3f3b3cbc75"], "user": "dsmith@mozilla.com"}, "124": {"changesets": [{"author": "Michael Kaply \u003c345868+mkaply@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1973827 - Add policy support for screen permission.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255334\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259879\n", "files": ["browser/base/content/pageinfo/permissions.js", "browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser_policy_pageinfo_permissions.js", "browser/components/enterprisepolicies/tests/xpcshell/test_permissions.js"], "git_node": "a7b853d0e802a0f5417515040726e47b0f413a2e", "git_parents": ["9a2c95e1e50faa185ba760b79d922f3f3b3cbc75"], "node": "d284508181754e2ac48fb839ec2c6d6b88480114", "parents": ["0865dd01c70fb77778f6334d5e9e9829c6667d46"], "tags": []}], "date": 1754348655, "git_changesets": ["a7b853d0e802a0f5417515040726e47b0f413a2e"], "user": "dsmith@mozilla.com"}, "125": {"changesets": [{"author": "Michael Kaply \u003c345868+mkaply@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1978092 - Policy should set tracking protection prefs on the default branch when locked.  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259446\n", "files": ["browser/components/enterprisepolicies/tests/browser/trackingprotection/browser_policy_trackingprotection.js", "browser/components/protections/ContentBlockingPrefs.sys.mjs"], "git_node": "c95346b7903c203e3dccf11181681129bc9d2eae", "git_parents": ["a7b853d0e802a0f5417515040726e47b0f413a2e"], "node": "c80e1672d788f9ce807f8ab6f12a258e47a71edc", "parents": ["d284508181754e2ac48fb839ec2c6d6b88480114"], "tags": []}], "date": 1754349008, "git_changesets": ["c95346b7903c203e3dccf11181681129bc9d2eae"], "user": "dsmith@mozilla.com"}, "126": {"changesets": [{"author": "Andrew Osmond \u003caosmond@gmail.com\u003e", "branch": "default", "desc": "Bug 1974174 - Ensure we don't release the fences holder too early. r=sotaro,gfx-reviewers, a=dsmith\n\nThis patch adds an additional reference count to each FencesHolder\nstored in the map, so that TextureHosts can acquire a reference at\ninitialization and release it at destruction. Previously the lifetime of\nthe entry was controlled by the TextureClient + TextureData.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D255536\n", "files": ["gfx/layers/d3d11/CompositeProcessD3D11FencesHolderMap.cpp", "gfx/layers/d3d11/CompositeProcessD3D11FencesHolderMap.h", "gfx/layers/d3d11/TextureD3D11.cpp", "gfx/layers/d3d11/TextureD3D11.h"], "git_node": "442a28af4b236bf883b03ba05eae0507098ee13b", "git_parents": ["c95346b7903c203e3dccf11181681129bc9d2eae"], "node": "1cad8bb787ab7c4c08a88cf5d677889124b19c9c", "parents": ["c80e1672d788f9ce807f8ab6f12a258e47a71edc"], "tags": []}], "date": 1754359965, "git_changesets": ["442a28af4b236bf883b03ba05eae0507098ee13b"], "user": "dsmith@mozilla.com"}, "127": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1923017 - Fix null ptr deref in CacheFileIOManager::Read  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253658\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259939\n", "files": ["netwerk/cache2/CacheFileIOManager.cpp"], "git_node": "6c1be2988e56cde6db376e578eb5a909e26bbf5f", "git_parents": ["442a28af4b236bf883b03ba05eae0507098ee13b"], "node": "71709b6f55d0981c769f3d9fa99c8eb23744791d", "parents": ["1cad8bb787ab7c4c08a88cf5d677889124b19c9c"], "tags": []}], "date": 1754394068, "git_changesets": ["6c1be2988e56cde6db376e578eb5a909e26bbf5f"], "user": "dsmith@mozilla.com"}, "128": {"changesets": [{"author": "William Wen \u003cwwwenwilliam@gmail.com\u003e", "branch": "default", "desc": "Bug 1977066 - Change missed \"cm\" strings to \"cryptoTP\".  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D257271\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259824\n", "files": ["browser/components/preferences/privacy.js", "remote/test/puppeteer/packages/browsers/src/browser-data/firefox.ts"], "git_node": "0a4544fe76437128fd9c5108e05421a48cbc9776", "git_parents": ["6c1be2988e56cde6db376e578eb5a909e26bbf5f"], "node": "c0c28bdc71e55c2e93b41d3a86de01ca9aa4ab61", "parents": ["71709b6f55d0981c769f3d9fa99c8eb23744791d"], "tags": []}], "date": 1754394725, "git_changesets": ["0a4544fe76437128fd9c5108e05421a48cbc9776"], "user": "dsmith@mozilla.com"}, "129": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1971549 - Use stand-in button border colors for yaru / adwaita, or in case we didn't find a suitable one. r=stransky, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253407\n", "files": ["widget/gtk/nsLookAndFeel.cpp"], "git_node": "97039c76940e2d2d4899238e10910b4c4dc7bb81", "git_parents": ["0a4544fe76437128fd9c5108e05421a48cbc9776"], "node": "785f051795db81fbfac8d2afb5820519f36c2cb5", "parents": ["c0c28bdc71e55c2e93b41d3a86de01ca9aa4ab61"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1946586 - Set opaque region even without an EGL window. r=stransky, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D254738\n", "files": ["widget/gtk/MozContainerWayland.cpp", "widget/gtk/MozContainerWayland.h"], "git_node": "1680854f3b7146d45c3b0ee32e8464acdb7897a8", "git_parents": ["97039c76940e2d2d4899238e10910b4c4dc7bb81"], "node": "ff5157b874e7ef2eb24a6ebb25011d95adea5dbe", "parents": ["785f051795db81fbfac8d2afb5820519f36c2cb5"], "tags": []}], "date": 1754415399, "git_changesets": ["97039c76940e2d2d4899238e10910b4c4dc7bb81", "1680854f3b7146d45c3b0ee32e8464acdb7897a8"], "user": "dsmith@mozilla.com"}, "130": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1971549 - Use stand-in button border colors for yaru / adwaita, or in case we didn't find a suitable one. r=stransky, for causing linux failures a=backout\n\nThis reverts commit 97039c76940e2d2d4899238e10910b4c4dc7bb81.\n", "files": ["widget/gtk/nsLookAndFeel.cpp"], "git_node": "2ce3f80962a5060ad195bbfa7cbfda8ca23cc436", "git_parents": ["1680854f3b7146d45c3b0ee32e8464acdb7897a8"], "node": "8c3784e3d4118fac732ebdaef72f9169ec1cea6b", "parents": ["ff5157b874e7ef2eb24a6ebb25011d95adea5dbe"], "tags": []}], "date": 1754416795, "git_changesets": ["2ce3f80962a5060ad195bbfa7cbfda8ca23cc436"], "user": "dsmith@mozilla.com"}, "131": {"changesets": [{"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1905944: Fix intermittents in browser_tab_preview.js r=sthompson,tabbrowser-reviewers, a=test-only\n\nThis patch fixes a number of issues that clear up a few different\nintermittents in browser_tab_preview.js.\n\n1. In browser_tab_groups_tab_interactions_telemetry.js, a call to \"close\n   duplicate tabs\" would automatically open the confirmation hint panel.\n   If not manually closed, it seems to persist in a half-way open state\n   where the `animating` attribute is always `true`. This is now fixed.\n\n2. There is a test somewhere that seems to apply the\n   `sidebar.verticalTabs` pref and doesn't turn it off. I would like to\n   figure out which test is causing this, but as a last defence I have\n   made sure this is always properly set within this test suite.\n\n3. Some tests check that THP is disabled if another panel is open. These\n   used to work by opening the `appMenu-popup` menu (the hamburger menu\n   in the top right of the browser). The problem with this approach is\n   that this panel (and basically every other panel) are very complex\n   and are prone to change. This was causing an intermittent failure\n   where attempting to close this panel threw an error in console that\n   seemed to be specifically related to this panel. I fixed this by\n   creating a fake minimal panel that is guaranteed to not change as\n   application code changes. (I borrowed this technique from\n   https://searchfox.org/mozilla-central/source/browser/base/content/test/popupNotifications/browser_popupNotification_queue.js).\n\n4. There is a suite of tests that checks that THP is disabled in the\n   event that a drag operation is performed. The problem is that\n   dragging a tab by 100px sometimes detaches the tab and creates a new\n   window, breaking the test run. Reducing the drag amount seems to fix\n   this.\n\n5. As a last line of defence, I have added a state reset function at the\n   start of each test to ensure that all panels are closed and that the\n   mouse is not hovering over the tab strip. (The latter was being done at\n   the end of some tests already, but this makes sure it is consistently\n   applied everywhere.)\n\nCloses bug1898099, bug1905944, bug1933597.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258976\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_tab_interactions_telemetry.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_preview.js"], "git_node": "520c64e4d9e31f488a9f4f62a74482eb587e3732", "git_parents": ["2ce3f80962a5060ad195bbfa7cbfda8ca23cc436"], "node": "ddd83bbb362e48a7f1c0765d45151bacb66df105", "parents": ["8c3784e3d4118fac732ebdaef72f9169ec1cea6b"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 1975578 - shift wrappedTimeStampDelta in order to handle negative value. a=RyanVM\n\nThe delta of two time stamps can be negative. However, in order to\nsupport 32-bits unsigned time from X server, the delta has been casted\nto an unsigned value, causing the failure with negative values.\n\nWe translate the origin (value 0) to the half way of the valid range\nof Time type. Use this value to compute timestamp and translate back\nlater so that we can handle delta in the range [MAX/2 + 1, -MAX/2].\n\nFor example, if Time is a uint32_t. Delta of value 0 will be\ntranslated to 0x7fffffff.  Delta of value -15 will be transalted to\n0x7ffffff0.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D257794\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258760\n", "files": ["widget/SystemTimeConverter.h"], "git_node": "e777d120721032290ffdb97466a125e37afe9e5a", "git_parents": ["520c64e4d9e31f488a9f4f62a74482eb587e3732"], "node": "ad8e0c0fe4c1894399f584a23ec4b7d4c6f5c3dd", "parents": ["ddd83bbb362e48a7f1c0765d45151bacb66df105"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1966676 - Check for pattern surface before accessing offset. r=aosmond, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258034\n", "files": ["gfx/2d/DrawTargetSkia.cpp"], "git_node": "09c5fac79d4fd8e9ee336726247ef1fe8a27cf9c", "git_parents": ["e777d120721032290ffdb97466a125e37afe9e5a"], "node": "ecac9774c674b27f3ecd86dfd48ede76009fd85b", "parents": ["ad8e0c0fe4c1894399f584a23ec4b7d4c6f5c3dd"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1977974 - nsCaret::ResetBlinking should invalidate the caret if it switched mIsBlinkOn. r=dholbert, a=RyanVM\n\nNot sure how to reliably test this unfortunately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258191\n", "files": ["layout/base/nsCaret.cpp"], "git_node": "011069c07846c254eb6f8cabb68853f85c0e8581", "git_parents": ["09c5fac79d4fd8e9ee336726247ef1fe8a27cf9c"], "node": "72de9ba8959e9a04d2f71633cbc781e9a7a8e95d", "parents": ["ecac9774c674b27f3ecd86dfd48ede76009fd85b"], "tags": []}], "date": 1754427211, "git_changesets": ["520c64e4d9e31f488a9f4f62a74482eb587e3732", "e777d120721032290ffdb97466a125e37afe9e5a", "09c5fac79d4fd8e9ee336726247ef1fe8a27cf9c", "011069c07846c254eb6f8cabb68853f85c0e8581"], "user": "rvandermeulen@mozilla.com"}, "132": {"changesets": [{"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976751 - Newtab fixing add shortcut button contrast issue  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D256868\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260048\n", "files": ["browser/extensions/newtab/content-src/components/TopSites/_TopSites.scss", "browser/extensions/newtab/css/activity-stream.css"], "git_node": "9a748902abbaae6b0aedddde2e12b070c554ba49", "git_parents": ["011069c07846c254eb6f8cabb68853f85c0e8581"], "node": "1973c1768c0613b3591061363e18c61eb32c1b87", "parents": ["72de9ba8959e9a04d2f71633cbc781e9a7a8e95d"], "tags": []}], "date": 1754429224, "git_changesets": ["9a748902abbaae6b0aedddde2e12b070c554ba49"], "user": "rvandermeulen@mozilla.com"}, "133": {"changesets": [{"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1970030 - Let input element keep a wheel event cancelable. r=dom-core,edgar a=RyanVM DONTBUILD\n\nWhen a user sets the pref dom.input.number_and_range_modified_by_mousewheel,\nthe input element needs to default prevent the wheel event to cancel scrolling.\n\nTherefore it has to prevent the event from becoming uncancelable if there is no\npassive listener.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253132\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259784\n", "files": ["dom/events/EventDispatcher.cpp", "dom/events/EventDispatcher.h", "dom/html/HTMLInputElement.cpp", "dom/html/test/mochitest.toml", "dom/html/test/test_bug1261673.html", "dom/html/test/test_input_modify_by_wheel.html"], "git_node": "bf13cfb46ed6623b2fc29f81837015655ae5d4bd", "git_parents": ["9a748902abbaae6b0aedddde2e12b070c554ba49"], "node": "3f063f6c696746a6e93f7e3bca2dc66dadc20e7d", "parents": ["1973c1768c0613b3591061363e18c61eb32c1b87"], "tags": []}], "date": 1754429387, "git_changesets": ["bf13cfb46ed6623b2fc29f81837015655ae5d4bd"], "user": "rvandermeulen@mozilla.com"}, "134": {"changesets": [{"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1971380 - Optimize login counting by skipping nsILoginInfo instantiation  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254169\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259911\n", "files": ["toolkit/components/passwordmgr/storage-json.sys.mjs"], "git_node": "466d793da038e80e61353a78bba8811a2b41bcdd", "git_parents": ["bf13cfb46ed6623b2fc29f81837015655ae5d4bd"], "node": "b10f0df57c1f175c2bb130def13a8507b0d90f84", "parents": ["3f063f6c696746a6e93f7e3bca2dc66dadc20e7d"], "tags": []}], "date": 1754429453, "git_changesets": ["466d793da038e80e61353a78bba8811a2b41bcdd"], "user": "rvandermeulen@mozilla.com"}, "135": {"changesets": [{"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948976 - Retrieve the Windows Documents folder via `SHGetKnownFolderPath` to avoid generating desktop.ini files, and retrieve it directly instead of routing through the Documents virtual folder.  a=RyanVM\n\nAlso removes fallback to `GetWindowsFolder`. The implementation thereof is based on `SHGetSpecialFolderPath`, which was depreciated in favor of `SHGetFolderPath`, which is a wrapper for `SHGetKnownFolderPath` for versions of Windows supported. `CSIDL_MYDOCUMENTS` is documented as equivalent to `FOLDERID_Documents`.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255238\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260054\n", "files": ["xpcom/io/SpecialSystemDirectory.cpp"], "git_node": "4d0d2c909eedf6366e30ec39c876cbae61072112", "git_parents": ["466d793da038e80e61353a78bba8811a2b41bcdd"], "node": "3df3879e70f576848331c8b19c790775a9c4de82", "parents": ["b10f0df57c1f175c2bb130def13a8507b0d90f84"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1974356 - Pre: Remove unnecessary special casing for Windows XP Downloads folder, and modify `GetKnownFolder` to use the same types passed through to WINAPI's `SHGetKnownFolderPath`.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255239\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260055\n", "files": ["xpcom/io/SpecialSystemDirectory.cpp"], "git_node": "9a42138c289ce9ef308bc26f2753cd69389719f5", "git_parents": ["4d0d2c909eedf6366e30ec39c876cbae61072112"], "node": "76bbf791d4b30ed97f0552975df17d93c85838ed", "parents": ["3df3879e70f576848331c8b19c790775a9c4de82"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1974356 - Replace SpecialSystemDirectory usage of `SHGetSpecialFolderPathW` with `SHGetKnownFolderPath`.  a=RyanVM\n\nAlso remove fallbacks which should only have been necessary for versions of Windows no longer supported.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255240\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260056\n", "files": ["xpcom/io/SpecialSystemDirectory.cpp"], "git_node": "488ab8310d8deb5abd2885a26f83aa0ea23a5adf", "git_parents": ["9a42138c289ce9ef308bc26f2753cd69389719f5"], "node": "4576f0281d824f37b8d35c891ce3447a0fde736d", "parents": ["76bbf791d4b30ed97f0552975df17d93c85838ed"], "tags": []}], "date": 1754441991, "git_changesets": ["4d0d2c909eedf6366e30ec39c876cbae61072112", "9a42138c289ce9ef308bc26f2753cd69389719f5", "488ab8310d8deb5abd2885a26f83aa0ea23a5adf"], "user": "rvandermeulen@mozilla.com"}, "136": {"changesets": [{"author": "Geoff Lankow \u003cgeoff@darktrojan.net\u003e", "branch": "default", "desc": "Bug 1975349 - Use \"sync\" variable to disable tests on builds without Sync.  a=RyanVM DONTBUILD\n\nSync is going to be disabled on Thunderbird again for a time, so these tests would need disabling.\nInstead, I'm changing the condition to use the sync variable, so they are automatically enabled on\nbuilds with Sync and disabled on builds without.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D255900\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260073\n", "files": ["services/fxaccounts/tests/xpcshell/xpcshell.toml", "toolkit/components/extensions/test/xpcshell/xpcshell.toml"], "git_node": "e18a59563e8d212eac0ce46981fd677be277f5b3", "git_parents": ["488ab8310d8deb5abd2885a26f83aa0ea23a5adf"], "node": "8337630376db14016a1483bb4dc765d8f71d4c8d", "parents": ["4576f0281d824f37b8d35c891ce3447a0fde736d"], "tags": []}], "date": 1754442060, "git_changesets": ["e18a59563e8d212eac0ce46981fd677be277f5b3"], "user": "rvandermeulen@mozilla.com"}, "137": {"changesets": [{"author": "Geoff Lankow \u003cgeoff@darktrojan.net\u003e", "branch": "default", "desc": "Bug 1977722 - Add comm-esr140 to artifacts.py.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D257625\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260072\n", "files": ["python/mozbuild/mozbuild/artifacts.py"], "git_node": "b1f3323a94cd9ca3b35548bff06a4c444031940c", "git_parents": ["e18a59563e8d212eac0ce46981fd677be277f5b3"], "node": "19cf0c61f2be90a678145499f67c518d448fb07f", "parents": ["8337630376db14016a1483bb4dc765d8f71d4c8d"], "tags": []}], "date": 1754442128, "git_changesets": ["b1f3323a94cd9ca3b35548bff06a4c444031940c"], "user": "rvandermeulen@mozilla.com"}, "138": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1969281 - Clear mResolvedDefaultFB on resize. r=ahale a=RyanVM\n\nThe size of mDefaultFB and mResolvedDefaultFB diverge on a resize if there is\nan existing mResolvedDefaultFB from before the size change. Both need to be\ncleared on a resize.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259489\n", "files": ["dom/canvas/WebGLContext.cpp"], "git_node": "aa0c95ed7241edfd24e73eeb686b1c4241ca9764", "git_parents": ["b1f3323a94cd9ca3b35548bff06a4c444031940c"], "node": "9948a2c6d60422b39b1b6e6feab27978a3115f92", "parents": ["19cf0c61f2be90a678145499f67c518d448fb07f"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977130 - Error-check pthread_getattr_np. r=glandium,spidermonkey-reviewers,jandem, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258648\n", "files": ["js/src/util/NativeStack.cpp", "mozglue/misc/StackWalk.cpp"], "git_node": "c446c5e360ac89081485029ab7bc3b765312f156", "git_parents": ["aa0c95ed7241edfd24e73eeb686b1c4241ca9764"], "node": "e37689609126323d57ab12d929e012e756e417ee", "parents": ["9948a2c6d60422b39b1b6e6feab27978a3115f92"], "tags": []}], "date": 1754445854, "git_changesets": ["aa0c95ed7241edfd24e73eeb686b1c4241ca9764", "c446c5e360ac89081485029ab7bc3b765312f156"], "user": "rvandermeulen@mozilla.com"}, "139": {"changesets": [{"author": "Pier Angelo Vendrame \u003cpierov@torproject.org\u003e", "branch": "default", "desc": "Bug 1979608.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D258859\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259975\n", "files": ["dom/xslt/xslt/txNodeSorter.cpp"], "git_node": "982a6c591c504a7c6b8132f914d2875207ccf003", "git_parents": ["c446c5e360ac89081485029ab7bc3b765312f156"], "node": "581afd9a89197c3fd91ad75bb373f8315155c300", "parents": ["e37689609126323d57ab12d929e012e756e417ee"], "tags": []}], "date": 1754486920, "git_changesets": ["982a6c591c504a7c6b8132f914d2875207ccf003"], "user": "rvandermeulen@mozilla.com"}, "140": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1974970 - Make `GetNextPrevLineBlockFrame()` guarantee that it won't enter into anonymous subtree r=emilio a=RyanVM\n\nIt seems that `nsIFrame::GetLastLeaf()` and `nsIFrame::GetFirstLeaf()`\nwere designed for helper methods of `nsIFrame::IsVisuallyAtLineEdge()`\nand `nsIFrame::IsLogicallyAtLineEdge()`.  Therefore, they require the\n`nsTextFrame` which is generated by `::before` or `::after` to check\nwhether the frame is first or last of the line.  However, only\n`nsIFrame::GetLastLeaf()` is used by `GetNextPrevLineBlockFrame()` too\nand I changed the behavior only for `GetNextPrevLineBlockFrame()` in\nD216371.  Then, that broke the `nsIFrame::IsVisuallyAtLineEdge()` and\n`nsIFrame::IsLogicallyAtLineEdge()`.  Therefore, this patch moves the\nnew check to the caller side, i.e., into `GetNextPrevLineBlockFrame()`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256211\n", "files": ["layout/generic/nsIFrame.cpp", "testing/web-platform/tests/selection/selection-modify-extend-word-generated-content.html"], "git_node": "e7d692b3a12f92aad1c792b8e1a61934f64ccd36", "git_parents": ["982a6c591c504a7c6b8132f914d2875207ccf003"], "node": "63ba8c42aece215bc0fbf4543b889abb20f275c0", "parents": ["581afd9a89197c3fd91ad75bb373f8315155c300"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1974917 - Fix TypeToString to automatically handle named/numbered int types. r=nbp,glandium a=RyanVM\n\n`TypeToString` defines instances for all the numbered int types (like\n`int32_t`); unfortunately this can leave some of the named types (like\n`int`) out of the sequence depending on how the C headers define the\nnumbered ones.  There are additional instances for signed and unsigned\nlong, which are needed on some platforms and would break the build on\nothers; there is an `#ifdef` which attempts to handle that, but the\nresult of all this is that CI can build for 32-bit x86 Linux but it\nfails when I try locally.\n\nThis patch simplifies things and removes the `#ifdef` using a similar\nidea to bug 836438: the unspecialized `TypeToString` calls another\nfunction with its own set of specializations, with numbered types in the\nfirst layer and named types in the second.\n", "files": ["mfbt/Casting.h"], "git_node": "b5d80c4948ef2494a9544cb638ec993a36fe91e1", "git_parents": ["e7d692b3a12f92aad1c792b8e1a61934f64ccd36"], "node": "4c4b22e5175cd12647e88a397cfa55c2d3ae5247", "parents": ["63ba8c42aece215bc0fbf4543b889abb20f275c0"], "tags": []}], "date": 1754504917, "git_changesets": ["e7d692b3a12f92aad1c792b8e1a61934f64ccd36", "b5d80c4948ef2494a9544cb638ec993a36fe91e1"], "user": "rvandermeulen@mozilla.com"}, "141": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260307\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json"], "git_node": "690ffd0b0913efe9daa33d84fbc24ae1c15b86af", "git_parents": ["b5d80c4948ef2494a9544cb638ec993a36fe91e1"], "node": "7769489f47a3740eae82e64fe51b45d21ed05146", "parents": ["4c4b22e5175cd12647e88a397cfa55c2d3ae5247"], "tags": []}], "date": 1754575991, "git_changesets": ["690ffd0b0913efe9daa33d84fbc24ae1c15b86af"], "user": "dsmith@mozilla.com"}, "142": {"changesets": [{"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 1976551 - [devtools] Fix selecting original source from the Source Tree.  a=RyanVM\n\nWe should ignore the \"show original source location by default\" selecting\nfrom selecting a source from the source tree.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D256694\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260237\n", "files": ["devtools/client/debugger/src/actions/sources/select.js", "devtools/client/debugger/test/mochitest/browser_dbg-features-source-tree.js"], "git_node": "1f0cb9a0b94105bf7b1f4b1b7e1048583a53e67c", "git_parents": ["690ffd0b0913efe9daa33d84fbc24ae1c15b86af"], "node": "82ac99e4a10802de453647973a9559809feb73ef", "parents": ["7769489f47a3740eae82e64fe51b45d21ed05146"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 1980892 - [devtools] Remove use of InspectorUtils.isCustomElementName on WalkerSearch#_searchSelectors.  a=RyanVM.\n\nWe used to check if the passed query looked like a tag name so we could\nbail out early, as we'd get those results from _searchIndex.\nBut InspectorUtils.isCustomElementName does match some legitimate\nselectors, like div.a-b.\nLet's remove the check on custom element and trigger the search in such case.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D259783\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260238\n", "files": ["devtools/server/actors/utils/walker-search.js", "devtools/server/tests/browser/browser_inspector-search.js", "devtools/server/tests/browser/inspector-search-data.html"], "git_node": "8a33ca95a6c39662e765e425cd72a7b2668681e6", "git_parents": ["1f0cb9a0b94105bf7b1f4b1b7e1048583a53e67c"], "node": "591adea108781d1db950bba533299bcc5803f2d7", "parents": ["82ac99e4a10802de453647973a9559809feb73ef"], "tags": []}], "date": 1754580085, "git_changesets": ["1f0cb9a0b94105bf7b1f4b1b7e1048583a53e67c", "8a33ca95a6c39662e765e425cd72a7b2668681e6"], "user": "rvandermeulen@mozilla.com"}, "143": {"changesets": [{"author": "Ashley Hale \u003cahale@mozilla.com\u003e", "branch": "default", "desc": "Bug 1966754 - reduce SVGFE render task resolution for excessively large inputs r=gfx-reviewers,ErichDonGubler a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D256388\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260363\n", "files": ["gfx/wr/webrender/src/render_task.rs", "testing/web-platform/tests/svg/crashtests/firefox-bug-1966754.html"], "git_node": "45f01ba16c3f6b7733285192270679aea927a1c4", "git_parents": ["8a33ca95a6c39662e765e425cd72a7b2668681e6"], "node": "eeac337d55b2043275031a70087578bb7943b3e2", "parents": ["591adea108781d1db950bba533299bcc5803f2d7"], "tags": []}], "date": 1754603550, "git_changesets": ["45f01ba16c3f6b7733285192270679aea927a1c4"], "user": "dsmith@mozilla.com"}, "144": {"changesets": [{"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 1981252 - extend web-platform-tests test certificates until 2026-06-11. r=jgraham a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D260042\n", "files": ["testing/web-platform/tests/tools/certs/cacert.key", "testing/web-platform/tests/tools/certs/cacert.pem", "testing/web-platform/tests/tools/certs/web-platform.test.key", "testing/web-platform/tests/tools/certs/web-platform.test.pem"], "git_node": "486346cc9dddcdd5617c9c9c3f69d1c96f74042a", "git_parents": ["45f01ba16c3f6b7733285192270679aea927a1c4"], "node": "3ba0418ab6c3ee9e01df521b0b1fb1a276a9aac1", "parents": ["eeac337d55b2043275031a70087578bb7943b3e2"], "tags": []}], "date": 1754662981, "git_changesets": ["486346cc9dddcdd5617c9c9c3f69d1c96f74042a"], "user": "rvandermeulen@mozilla.com"}, "145": {"changesets": [{"author": "Andrew Osmond \u003caosmond@gmail.com\u003e", "branch": "default", "desc": "Bug 1979527.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D260190\n\n