 {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1920429 - Use Opus packet duration when discarding padding in WebM.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D250906\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257957\n", "files": ["config/external/gkcodecs/gkcodecs.symbols", "dom/media/webm/WebMDemuxer.cpp"], "git_node": "83bab56a4be25cfdde55f85aa2074081e500f4f0", "git_parents": ["8ec28b97d15eb147ca90a3d8f161a6ef56b1a5c1"], "node": "0fbcfb117301b5776881d6c6180efbf84e84b274", "parents": ["326849bfd0164df22ade206278112f144e3ae773"], "tags": []}], "date": 1753149851, "git_changesets": ["83bab56a4be25cfdde55f85aa2074081e500f4f0"], "user": "rvandermeulen@mozilla.com"}, "87": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-esr140", "desc": "No bug - Tagging 0c53463d0e61c036c08be46403e896e174f2182e with FIREFOX_140_1_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "27fac095ad9e323bd94c7ad4c5ba18faa1e82e1a", "git_parents": ["1ac9ff261f9851eee2b6175ebfe9a3acf882f6c9"], "node": "229508b3c3665bf08609f4aed2c35e2999cc659d", "parents": ["155a6a44648b500f0b0e0563ab38d402e00a42c0"], "tags": []}], "date": 1753189166, "git_changesets": ["27fac095ad9e323bd94c7ad4c5ba18faa1e82e1a"], "user": "ffxbld@lando.moz.tools"}, "88": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1978412 - bouncer-check: don't look for linux64-aarch64 partials from before it existed r=releng-reviewers,Eijebong a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258175\n", "files": ["testing/mozharness/scripts/release/bouncer_check.py"], "git_node": "d9deee1cb716099abf8841d1e62ff20c800088e5", "git_parents": ["83bab56a4be25cfdde55f85aa2074081e500f4f0"], "node": "4e4aa2d5d52aa3a34e39708047dfde0978f5bce8", "parents": ["0fbcfb117301b5776881d6c6180efbf84e84b274"], "tags": []}], "date": 1753192570, "git_changesets": ["d9deee1cb716099abf8841d1e62ff20c800088e5"], "user": "rvandermeulen@mozilla.com"}, "89": {"changesets": [{"author": "Bastien Orivel \u003cborivel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1902030 - Add msix win64-aarch64 to bouncer-check for ESRs  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D258180\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258189\n", "files": ["testing/mozharness/configs/releases/bouncer_firefox_esr.py"], "git_node": "3fba4812701eaaf9f0f525cb91f45a35ce2b550b", "git_parents": ["d9deee1cb716099abf8841d1e62ff20c800088e5"], "node": "b883bb53224eadacc6cfb0357d61c98ff4619e51", "parents": ["4e4aa2d5d52aa3a34e39708047dfde0978f5bce8"], "tags": []}], "date": 1753192619, "git_changesets": ["3fba4812701eaaf9f0f525cb91f45a35ce2b550b"], "user": "rvandermeulen@mozilla.com"}, "90": {"changesets": [{"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1955112 [Wayland] Terminate buggy unfinished D&D operation as DragDrop r=emilio a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D251691\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "7b2919002db2bc801e6c4336739d8f6b6eb3bfa3", "git_parents": ["3fba4812701eaaf9f0f525cb91f45a35ce2b550b"], "node": "f4ccb9bf5cdd4c7fda6eba7b9e6839bab1d410a8", "parents": ["b883bb53224eadacc6cfb0357d61c98ff4619e51"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977049 - Mock `buildconfig.substs` for `TestThunderbirdMixin` r=bhearsum a=RyanVM\n\nSame fix as in D256843, just for `TestThunderbirdMixin` as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257567\n", "files": ["python/mozbuild/mozbuild/test/test_artifacts.py"], "git_node": "da2ea1762891ccf389d4bf754df6926185a2f969", "git_parents": ["7b2919002db2bc801e6c4336739d8f6b6eb3bfa3"], "node": "e5bcb104d64c5be29a293d971f8829ccd1417ef5", "parents": ["f4ccb9bf5cdd4c7fda6eba7b9e6839bab1d410a8"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 1976313 - Increase MAX_CACHE_SLICES as a temporary workaround r=tnikkel a=RyanVM\n\nThis allows surface promotion to work on Canal+ where the picture\ncache slicing logic is being tripped up by a large number of\nscrollable video carousels, that are present even when the video\nis playing back.\n\nIt's unlikely to cause significant performance regressions, since\nany page with this number of slices is already going to be expensive\nto render, and very few pages get near this slice count.\n\nNonetheless, there are better long-term solutions. In future we\nshould change the slicing logic to be aware of pages that have\npromoted surfaces, and ensure we don't create too many scroll\nroot slices in these cases, so that we still have the ability\nto promote video/canvas surfaces without too much GPU memory use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256938\n", "files": ["gfx/wr/webrender/src/tile_cache.rs"], "git_node": "70177dfd20e575fe869ee4310faa41fa7e232927", "git_parents": ["da2ea1762891ccf389d4bf754df6926185a2f969"], "node": "0041c8f4bdde05ffb39b46bb806aa4632b1b5fa3", "parents": ["e5bcb104d64c5be29a293d971f8829ccd1417ef5"], "tags": []}], "date": 1753192875, "git_changesets": ["7b2919002db2bc801e6c4336739d8f6b6eb3bfa3", "da2ea1762891ccf389d4bf754df6926185a2f969", "70177dfd20e575fe869ee4310faa41fa7e232927"], "user": "rvandermeulen@mozilla.com"}, "91": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1977978 - [firefox-ui] Workaround for `functional/security/test_https_first.py` to not timeout when waiting for DOMContentLoaded event.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D257813\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258029\n", "files": ["testing/firefox-ui/tests/functional/security/test_https_first.py"], "git_node": "ca2064476551d46ec5c7f8cf9b1ec536351f2d1b", "git_parents": ["70177dfd20e575fe869ee4310faa41fa7e232927"], "node": "358b80cb903028b698dbd40be135d5dfa18aa75c", "parents": ["0041c8f4bdde05ffb39b46bb806aa4632b1b5fa3"], "tags": []}], "date": 1753193023, "git_changesets": ["ca2064476551d46ec5c7f8cf9b1ec536351f2d1b"], "user": "rvandermeulen@mozilla.com"}, "92": {"changesets": [{"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 1929482 - Make sure that strings live until serialization inside uprofiler_simple_event_marker_internal  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D257403\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258229\n", "files": ["tools/profiler/core/MicroGeckoProfiler.cpp"], "git_node": "b65dd1ed6c54aa10fd11ff67b9969b74713e3517", "git_parents": ["ca2064476551d46ec5c7f8cf9b1ec536351f2d1b"], "node": "1a374444a167c0a55a3d4149e48007e037c8c451", "parents": ["358b80cb903028b698dbd40be135d5dfa18aa75c"], "tags": []}], "date": 1753198668, "git_changesets": ["b65dd1ed6c54aa10fd11ff67b9969b74713e3517"], "user": "rvandermeulen@mozilla.com"}, "93": {"changesets": [{"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 1973246 - [devtools] Expose browserLoaderRequire in Debugger panel global.  a=RyanVM.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D254813\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257646\n", "files": ["devtools/client/debugger/index.js", "devtools/client/debugger/test/mochitest/browser_dbg-custom-formatters.js", "devtools/client/debugger/test/mochitest/examples/doc_dbg-custom-formatters.html", "devtools/client/shared/components/reps/reps/custom-formatter.mjs"], "git_node": "72aedb1d83c9a6145ba72578f3f1af571b648927", "git_parents": ["b65dd1ed6c54aa10fd11ff67b9969b74713e3517"], "node": "0ed0962da3c32eefc19cf2de9dbb31a9b22aa0b7", "parents": ["1a374444a167c0a55a3d4149e48007e037c8c451"], "tags": []}], "date": 1753198733, "git_changesets": ["72aedb1d83c9a6145ba72578f3f1af571b648927"], "user": "rvandermeulen@mozilla.com"}, "94": {"changesets": [{"author": "Geoff Lankow \u003cgeoff@darktrojan.net\u003e", "branch": "default", "desc": "Bug 1976650 - Fix and test \"View\u2026\" button in certificate exception dialog.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D256777\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257626\n", "files": ["security/manager/pki/resources/content/exceptionDialog.js", "security/manager/ssl/tests/mochitest/browser/browser_add_exception_dialog.js"], "git_node": "d681cd389ec2fc855557fc49e0c23e80466c5b76", "git_parents": ["72aedb1d83c9a6145ba72578f3f1af571b648927"], "node": "73b3643bc2dcd88ce52b650dc159fe40ab6248f7", "parents": ["0ed0962da3c32eefc19cf2de9dbb31a9b22aa0b7"], "tags": []}], "date": 1753198783, "git_changesets": ["d681cd389ec2fc855557fc49e0c23e80466c5b76"], "user": "rvandermeulen@mozilla.com"}, "95": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976031 - Apply inline layout only to dynamicType=\"actions\" rows in action mode.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D257157\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257477\n", "files": ["browser/themes/shared/urlbarView.css"], "git_node": "440b210e47631b2c6167d90cf7a48650d23b3007", "git_parents": ["d681cd389ec2fc855557fc49e0c23e80466c5b76"], "node": "5de0c36cb4e074dfd26c918a9f1e4cfce6dd0ad0", "parents": ["73b3643bc2dcd88ce52b650dc159fe40ab6248f7"], "tags": []}], "date": 1753208075, "git_changesets": ["440b210e47631b2c6167d90cf7a48650d23b3007"], "user": "dsmith@mozilla.com"}, "96": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1974876 - Minor cleanups to scale change. r=stransky a=RyanVM\n\nThis made the logs a bit less confusing to read and should be marginally\nfaster. No behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257718\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "86c0ceb3a368848f976d46c2cb6b11cf1ba0a013", "git_parents": ["440b210e47631b2c6167d90cf7a48650d23b3007"], "node": "678a782421582db0f0e07764fa3bc7260489b6e0", "parents": ["5de0c36cb4e074dfd26c918a9f1e4cfce6dd0ad0"], "tags": []}, {"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 1971296: Make WebRender clip dirty rects and display rects to surface sizes. r=gw a=RyanVM\n\nThis patch clamps dirty rects and display rects to surface sizes. This\nprevents native compositors -- specifically macOS -- from panicking that\none or both of the rects is larger than the surface itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D254761\n", "files": ["gfx/wr/webrender/src/frame_builder.rs"], "git_node": "404892ce67fd3e89649d2f0f6a160d7d9a2a5a55", "git_parents": ["86c0ceb3a368848f976d46c2cb6b11cf1ba0a013"], "node": "fefacd01861df7757ec2b8548e45ff5dcf670aff", "parents": ["678a782421582db0f0e07764fa3bc7260489b6e0"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975837. r=aosmond a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257122\n", "files": ["gfx/wr/swgl/src/gl.cc", "gfx/wr/swgl/src/texture.h"], "git_node": "a3995ac4f5e9ecbda16bc0280e07714af818b062", "git_parents": ["404892ce67fd3e89649d2f0f6a160d7d9a2a5a55"], "node": "ff46b5cfd33af39f30db002b5cc4626c5b375f9f", "parents": ["fefacd01861df7757ec2b8548e45ff5dcf670aff"], "tags": []}], "date": 1753241592, "git_changesets": ["86c0ceb3a368848f976d46c2cb6b11cf1ba0a013", "404892ce67fd3e89649d2f0f6a160d7d9a2a5a55", "a3995ac4f5e9ecbda16bc0280e07714af818b062"], "user": "rvandermeulen@mozilla.com"}, "97": {"changesets": [{"author": "Xi Ruoyao \u003cxry111@xry111.site\u003e", "branch": "default", "desc": "Bug 1977549: Refine -mlasx usage for LoongArch  a=RyanVM\n\nTo allow running Firefox on processors without LASX (for example\nLoongson 2K3000; note that LSX is guaranteed for LoongArch desktop\nprocessors but LASX is not), only use -mlasx on the source files those a\nruntime check for LASX guards.\n\nThe runtime check is in SkOpts.cpp and it's enabled after removing\n-mlasx for this translation unit, if LASX is available at runtime the\ncode in SkOpts_lasx.cpp will be needed to configure Skia to use LASX.\nThus we need to add SkOpts_lasx.cpp into the list of sources to build.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D257490\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257825\n", "files": ["gfx/skia/generate_mozbuild.py", "gfx/skia/moz.build"], "git_node": "99b2c5786ca3892406e06df500b61cdd35f1a86e", "git_parents": ["a3995ac4f5e9ecbda16bc0280e07714af818b062"], "node": "87d07640bdbf68b5fd1e018f5e5e31ca34751ff2", "parents": ["ff46b5cfd33af39f30db002b5cc4626c5b375f9f"], "tags": []}], "date": 1753241808, "git_changesets": ["99b2c5786ca3892406e06df500b61cdd35f1a86e"], "user": "rvandermeulen@mozilla.com"}, "98": {"changesets": [{"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1958096 - Prefer files over images for CF_HDROP drag and drop on Windows  a=RyanVM\n\nWhen dropping an image over Total Commander, we first offer a .png file\nregardless of the source image type, which requires converting to .png\nand losing the original file name. Instead, if an application requests\nCF_HDROP (which represents an existing file), prefer a file or file promise\nif the nsDataObj has one, and only fall back to a native image if it does\nnot.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D253035\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258413\n", "files": ["widget/windows/nsDataObj.cpp"], "git_node": "8fca93d6bad45c2ccaf2b50a06b5a70f31b69f7f", "git_parents": ["99b2c5786ca3892406e06df500b61cdd35f1a86e"], "node": "686ba61600be893a135f310816cfbaa5e8a0eb44", "parents": ["87d07640bdbf68b5fd1e018f5e5e31ca34751ff2"], "tags": []}], "date": 1753281787, "git_changesets": ["8fca93d6bad45c2ccaf2b50a06b5a70f31b69f7f"], "user": "rvandermeulen@mozilla.com"}, "99": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1974876 - Don't enforce client-side constraints in RecomputeBounds. r=stransky a=RyanVM\n\nMake sure only that our sizes are sane, which is the point of the check.\n\nConstraints are in device pixels, so when changing scale they may not be\nright until layout has updated them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257716\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "18ca523ed0ee60cea8232fe426ba62a400718a06", "git_parents": ["8fca93d6bad45c2ccaf2b50a06b5a70f31b69f7f"], "node": "9be4894490ef9b7c1f80bf3c21cf6e740e003f0e", "parents": ["686ba61600be893a135f310816cfbaa5e8a0eb44"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976102 - r=mak,urlbar-reviewers a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257093\n", "files": ["browser/components/urlbar/UrlbarInput.sys.mjs", "browser/components/urlbar/UrlbarSearchTermsPersistence.sys.mjs"], "git_node": "5b1655eb9b8aef64851e389cef2f9dfcf29653ac", "git_parents": ["18ca523ed0ee60cea8232fe426ba62a400718a06"], "node": "4824f3754c495299b5deed106400dda94f5fe69b", "parents": ["9be4894490ef9b7c1f80bf3c21cf6e740e003f0e"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1977252 - Create sandbox.xulRuntime object inside the sandbox compartment. r=tnikkel a=test-only\n\nThe xulRuntime object needs to be created inside the sandbox, or code running\ninside the sandbox will hit some kind of wrapper when attempting to access it,\ncausing thousands of warnings when evaluating the test conditions:\n\nSilently denied access to property \"shell\": Access to privileged JS object not permitted\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257186\n", "files": ["layout/tools/reftest/manifest.sys.mjs"], "git_node": "475768e076c5e5e78c1b18814a5e7139c1bbe8aa", "git_parents": ["5b1655eb9b8aef64851e389cef2f9dfcf29653ac"], "node": "57a15785dd0604b7db5fc06efa30e04aa3a091bd", "parents": ["4824f3754c495299b5deed106400dda94f5fe69b"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1940385: Skip 256180-2.html on win32. r=layout-reviewers,emilio a=test-only\n\nThis test was annotated as skipped on win32 when it was added.  That skip\nannotation was speculatively removed in bug 1895637, but as evidenced by the\nintermittent failures, we do actually need it, so let's add it back.\n\nConveniently, there's already a code-comment explaining why we're skipping this\ntest for win32.  (That comment was left in by accident when the annotation was\nremoved, so it didn't map to anything for a little while, but now it usefully\nexplains the newly-restored annotation.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257071\n", "files": ["layout/reftests/bugs/reftest.list"], "git_node": "9c8467ffee4a586fff22d9fb2d39ecf0ab4fd584", "git_parents": ["475768e076c5e5e78c1b18814a5e7139c1bbe8aa"], "node": "33a2d7d33f487429f753a36035dbc3fe2a358679", "parents": ["57a15785dd0604b7db5fc06efa30e04aa3a091bd"], "tags": []}], "date": 1753287091, "git_changesets": ["18ca523ed0ee60cea8232fe426ba62a400718a06", "5b1655eb9b8aef64851e389cef2f9dfcf29653ac", "475768e076c5e5e78c1b18814a5e7139c1bbe8aa", "9c8467ffee4a586fff22d9fb2d39ecf0ab4fd584"], "user": "rvandermeulen@mozilla.com"}}
}";