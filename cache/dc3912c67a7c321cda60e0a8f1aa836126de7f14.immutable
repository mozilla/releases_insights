aph/transforms/source_checksums_signing.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/geckodriver-mac-notarization/kind.yml", "taskcluster/kinds/release-beetmover-push-to-release/kind.yml", "taskcluster/kinds/release-eme-free-repack-mac-notarization/kind.yml", "taskcluster/kinds/release-partner-repack-mac-notarization/kind.yml", "taskcluster/kinds/shippable-l10n-mac-notarization/kind.yml"], "git_node": "3d1afc20a51694e0df6718393e49c8b3122ba474", "git_parents": ["8e86cc330f88ad2e796b5fae00f907aa7b728a81"], "node": "37aa2f3faf49f2db3145abb04bc43f121314e641", "parents": ["37adaf4d1854243c5f97aba10b76a3f93a3505a1"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1995600 - stop setting default max-run-time for beetmover and signingscript tasks.  a=RyanVM DONTBUILD\n\nThe max-run-time is ignored by beetmover payload builders.\nFor signingscript, 10 minutes seems to be fine except for localized\nnotarization jobs, which started failing after scriptworker started\ntaking the payload's maxRunTime into account in v61.2.0.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D269539\n\nDifferential Revision: https://phabricator.services.mozilla.com/D269601\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "162b40c8818352efea949bc6a16449e2696a33a4", "git_parents": ["3d1afc20a51694e0df6718393e49c8b3122ba474"], "node": "a05efd261a52653dc9ed1db35c01730c3d27a334", "parents": ["37aa2f3faf49f2db3145abb04bc43f121314e641"], "tags": []}], "date": 1761585811, "git_changesets": ["3d1afc20a51694e0df6718393e49c8b3122ba474", "162b40c8818352efea949bc6a16449e2696a33a4"], "user": "rvandermeulen@mozilla.com"}, "309": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270138\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "c2b83fc60b568328c166ccf252d4638f375224d8", "git_parents": ["162b40c8818352efea949bc6a16449e2696a33a4"], "node": "5d5e0e16e3359eddfe7f5c8e51fc2e7b15acc082", "parents": ["a05efd261a52653dc9ed1db35c01730c3d27a334"], "tags": []}], "date": 1761586402, "git_changesets": ["c2b83fc60b568328c166ccf252d4638f375224d8"], "user": "rvandermeulen@mozilla.com"}, "310": {"changesets": [{"author": "Simon Friedberger \u003csimon@mozilla.com\u003e", "branch": "default", "desc": "Bug 1984940: Make sec-fetch user-triggered check default to secure  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D265744\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270137\n", "files": ["dom/security/SecFetch.cpp"], "git_node": "c4b28fcae36c69d5718ccd117137dbf09f4acf8f", "git_parents": ["c2b83fc60b568328c166ccf252d4638f375224d8"], "node": "4dcda609c7024bf3a19dcc64a69139b91ea85be5", "parents": ["5d5e0e16e3359eddfe7f5c8e51fc2e7b15acc082"], "tags": []}], "date": 1761586439, "git_changesets": ["c4b28fcae36c69d5718ccd117137dbf09f4acf8f"], "user": "rvandermeulen@mozilla.com"}, "311": {"changesets": [{"author": "Andrew Osmond \u003caosmond@gmail.com\u003e", "branch": "default", "desc": "Bug 1649857 - Fix crash in parent process when RDD and GPU processes crashed simultaneously.  a=pascalc\n\nWhen the RDD and GPU processes crashed simultaneously, we could get into\na position where we would try to recreate PVideoBridge between the RDD\nand GPU processes, before bringing back up the RDD process. We should\nnow skip reinitializing the protocol if the RDD process is unavailable.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D175044\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270327\n", "files": ["dom/media/ipc/RDDProcessHost.cpp", "dom/media/ipc/RDDProcessManager.cpp", "dom/media/ipc/RDDProcessManager.h"], "git_node": "0f106aafc1a2efc38bc09f3557ce34186c79e090", "git_parents": ["c4b28fcae36c69d5718ccd117137dbf09f4acf8f"], "node": "87c08c22ff80abc906da943f7a14e6c69685d0c1", "parents": ["4dcda609c7024bf3a19dcc64a69139b91ea85be5"], "tags": []}], "date": 1761671416, "git_changesets": ["0f106aafc1a2efc38bc09f3557ce34186c79e090"], "user": "pchevrel@mozilla.com"}, "312": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1445260 - Add release-mode checks to Vector's operator[], back() and popBack().  a=pascalc\n\nAlso, while I am touching this file, change some typedefs to using.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D266670\n\nDifferential Revision: https://phabricator.services.mozilla.com/D269446\n", "files": ["mfbt/Vector.h"], "git_node": "3342eff1d0a44f1bf573a1ddc1a271cde0aa93a8", "git_parents": ["0f106aafc1a2efc38bc09f3557ce34186c79e090"], "node": "0cf0da2a603c455cb942597ae184c6505e974f65", "parents": ["87c08c22ff80abc906da943f7a14e6c69685d0c1"], "tags": []}], "date": 1761671456, "git_changesets": ["3342eff1d0a44f1bf573a1ddc1a271cde0aa93a8"], "user": "pchevrel@mozilla.com"}, "313": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1991945. r=farre a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D267575\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270313\n", "files": ["netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": "16d805c5e86b7f0580772468fdd26a4120826249", "git_parents": ["3342eff1d0a44f1bf573a1ddc1a271cde0aa93a8"], "node": "2c51e891365039179b07c32cd94be9454087c7c1", "parents": ["0cf0da2a603c455cb942597ae184c6505e974f65"], "tags": []}], "date": 1761689957, "git_changesets": ["16d805c5e86b7f0580772468fdd26a4120826249"], "user": "pchevrel@mozilla.com"}, "314": {"changesets": [{"author": "spohlMozilla \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 1980815: Ensure that the emoji picker menu item doesn't disappear from the menu bar and that its associated shortcuts continue to work on macOS. r=mac-reviewers,bradwerth a=pascalc\n\nThis is somewhat unfortunate, but I couldn't find a better way to address this. There are two aspects to this fix:\n\n1. In order for SVG chicklets to appear in the context menu the first time it is opened, we have to set an nsMenuX to be rebuilt in its constructor (bug 1923666). However, this interferes with some menus, such as the Window and the Edit menu, since macOS adds its own menu items to these menus. This patch expands the fix for bug 1939346 for the Window menu to also include the Edit menu, where the Emoji picker is added as a menu item.\n\n2. Bug 1808223 addressed a regression due to a macOS bug where the emoji picker and the dictation menu item are added every time that a main menu bar is set for an app, but macOS 'forgets' to remove these items when switched away from one Firefox window to another and back again. One quirk about this is that if the user switches to another APP and back to the same Firefox window, macOS will not re-add these menu items to the edit menu again. So we need to avoid removing these problematic menu items in this situation. I was hoping to implement a fix that would simply remove duplicates *after* setting the `NSApp.mainMenu`, but if we do so then macOS will remove ALL added menu items and the emoji picker will disappear entirely from the Edit menu. So this appears to be the only way to properly fix this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268239\n", "files": ["widget/cocoa/nsMenuBarX.mm", "widget/cocoa/nsMenuX.h", "widget/cocoa/nsMenuX.mm"], "git_node": "2a3c838e2494bc73e64c848a36b3a07092855973", "git_parents": ["16d805c5e86b7f0580772468fdd26a4120826249"], "node": "e68519ddc5b315c848e2eb4810c1c9ae2a763cda", "parents": ["2c51e891365039179b07c32cd94be9454087c7c1"], "tags": []}], "date": 1761690560, "git_changesets": ["2a3c838e2494bc73e64c848a36b3a07092855973"], "user": "pchevrel@mozilla.com"}, "315": {"changesets": [{"author": "Adam Vandolder \u003cadam.vandolder@gmail.com\u003e", "branch": "default", "desc": "Bug 1978237 - Check for null before attempting to get document URI when ScriptLoader is reporting to the console. r=dom-core,smaug a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258259\n", "files": ["dom/script/ScriptLoader.cpp"], "git_node": "76a867fb4d7d91d48018a9c20cda910e990ba107", "git_parents": ["2a3c838e2494bc73e64c848a36b3a07092855973"], "node": "8ab10d9d799e0c5385121d618dbcd97957840995", "parents": ["e68519ddc5b315c848e2eb4810c1c9ae2a763cda"], "tags": []}], "date": 1761691044, "git_changesets": ["76a867fb4d7d91d48018a9c20cda910e990ba107"], "user": "pchevrel@mozilla.com"}, "316": {"changesets": [{"author": "William Durand \u003cwill+git@drnd.me\u003e", "branch": "default", "desc": "Bug 1995530 - Allow unrecognized props in `bss.gecko.data_collection_permissions`. r=robwu,rpl a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D269385\n", "files": ["toolkit/components/extensions/schemas/manifest.json", "toolkit/components/extensions/test/xpcshell/test_ext_data_collection_permissions.js"], "git_node": "2c2503b6e61648bf0d8ad6cfa3187a720946d26e", "git_parents": ["76a867fb4d7d91d48018a9c20cda910e990ba107"], "node": "7271da50679b929e034bf12984ade51ae35aeff1", "parents": ["8ab10d9d799e0c5385121d618dbcd97957840995"], "tags": []}], "date": 1761691417, "git_changesets": ["2c2503b6e61648bf0d8ad6cfa3187a720946d26e"], "user": "pchevrel@mozilla.com"}, "317": {"changesets": [{"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 1993351 - Set selection as dirty when unbinding from frame  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D268527\n\nDifferential Revision: https://phabricator.services.mozilla.com/D269124\n", "files": ["dom/html/TextControlState.cpp", "testing/web-platform/tests/html/semantics/forms/the-textarea-element/selection-after-whitespace-change.html"], "git_node": "6055a6e562ebb174ff528966d3454194c0f53609", "git_parents": ["2c2503b6e61648bf0d8ad6cfa3187a720946d26e"], "node": "5ab3c4d20c3643226be758dd1a726f163589f4af", "parents": ["7271da50679b929e034bf12984ade51ae35aeff1"], "tags": []}], "date": 1761766464, "git_changesets": ["6055a6e562ebb174ff528966d3454194c0f53609"], "user": "rvandermeulen@mozilla.com"}, "318": {"changesets": [{"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1994657 - block old versions of KeyScrambler to prevent crashes on keystrokes  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D268885\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270605\n", "files": ["toolkit/xre/dllservices/mozglue/WindowsDllBlocklistDefs.in"], "git_node": "35b0decc41bc42d3bfa3e7f8cb5f2cf5ed5e11c3", "git_parents": ["6055a6e562ebb174ff528966d3454194c0f53609"], "node": "a0ad6c01a24c163bf25333b4e16394b8d4734d3e", "parents": ["5ab3c4d20c3643226be758dd1a726f163589f4af"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996038 - block MFCopyHook.dll in the parent process  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D269999\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270600\n", "files": ["toolkit/xre/dllservices/mozglue/WindowsDllBlocklistDefs.in"], "git_node": "b59c04e51a225cdf34ba4bf4937ba72b84e7e328", "git_parents": ["35b0decc41bc42d3bfa3e7f8cb5f2cf5ed5e11c3"], "node": "40f6edca63e100190a0ed1a74c96311a9f150210", "parents": ["a0ad6c01a24c163bf25333b4e16394b8d4734d3e"], "tags": []}], "date": 1761771187, "git_changesets": ["35b0decc41bc42d3bfa3e7f8cb5f2cf5ed5e11c3", "b59c04e51a225cdf34ba4bf4937ba72b84e7e328"], "user": "rvandermeulen@mozilla.com"}, "319": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1994921 - Cherry-pick commit b98ec96 from upstream harfbuzz to fix AAT shaping error.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D269165\n\nDifferential Revision: https://phabricator.services.mozilla.com/D269196\n", "files": ["gfx/harfbuzz/src/hb-cache.hh", "layout/reftests/text/kannada-1-notref.html", "layout/reftests/text/kannada-1.html", "layout/reftests/text/reftest.list"], "git_node": "8cc419a2513f6169dba3e86a8c30103520f723af", "git_parents": ["b59c04e51a225cdf34ba4bf4937ba72b84e7e328"], "node": "a4cf35a38337a0071e7eb52f68169015239f2366", "parents": ["40f6edca63e100190a0ed1a74c96311a9f150210"], "tags": []}], "date": 1761780466, "git_changesets": ["8cc419a2513f6169dba3e86a8c30103520f723af"], "user": "rvandermeulen@mozilla.com"}, "320": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1988412 - Update the RemoteWorkerData on main thread.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D266815\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270489\n", "files": ["dom/workers/sharedworkers/SharedWorkerService.cpp"], "git_node": "6fd1decc16ca00fd5d0687c636170d0a59501832", "git_parents": ["8cc419a2513f6169dba3e86a8c30103520f723af"], "node": "089be6d18ab4499d03bca072be69c71dbf7c6a2a", "parents": ["a4cf35a38337a0071e7eb52f68169015239f2366"], "tags": []}], "date": 1761780610, "git_changesets": ["6fd1decc16ca00fd5d0687c636170d0a59501832"], "user": "rvandermeulen@mozilla.com"}, "321": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1996906 - Change where we get libxml2 from. r=taskgraph-reviewers,jcristau a=release DONTBUILD\n\nInstead of downloading an archive from gitlab, which likes to send us a\nbot challenge instead, just do a git clone, which should bring us the\nsame content.\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "81fb5bda51ae6c0cecf868615449c6d689828c1d", "git_parents": ["6fd1decc16ca00fd5d0687c636170d0a59501832"], "node": "67cd4fe87864f057ed2f5e1a653e7ce5720e2278", "parents": ["089be6d18ab4499d03bca072be69c71dbf7c6a2a"], "tags": []}], "date": 1761787436, "git_changesets": ["81fb5bda51ae6c0cecf868615449c6d689828c1d"], "user": "rvandermeulen@mozilla.com"}, "322": {"changesets": [{"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 1984560 - Ensure /run/user/1000 exists and is owned for snapcraft execution r=glandium a=release DONTBUILD\n", "files": ["taskcluster/docker/snap-coreXX-build/Dockerfile", "taskcluster/docker/snap-coreXX-build/install-snap.sh", "taskcluster/docker/snap-coreXX-build/run.sh"], "git_node": "3e6c3047fba0f1dbfc0e3dec4cb493a9f8ff507c", "git_parents": ["81fb5bda51ae6c0cecf868615449c6d689828c1d"], "node": "c4425e6078bf452e2f6f625231b595045b42998a", "parents": ["67cd4fe87864f057ed2f5e1a653e7ce5720e2278"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1991673 - download nexus from tooltool. r=RyanVM a=NPOTB DONTBUILD\n\nWe've started getting 403s from download.sonatype.com.\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "9307ca798a9c6246fa5316ee6b4451ade06d9fa6", "git_parents": ["3e6c3047fba0f1dbfc0e3dec4cb493a9f8ff507c"], "node": "398ef872814e3f14897f7ffccf0c3ae067f9bd83", "parents": ["c4425e6078bf452e2f6f625231b595045b42998a"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1991703 - update sonatype nexus to 2.15.2-03. r=RyanVM a=NPOTB DONTBUILD\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "cadccb2f8c432600440fc8af7d34402743ab7b96", "git_parents": ["9307ca798a9c6246fa5316ee6b4451ade06d9fa6"], "node": "2de2e8e7a5625f29b572923b93a4228841cc3506", "parents": ["398ef872814e3f14897f7ffccf0c3ae067f9bd83"], "tags": []}, {"author": "afinder \u003cafinder@mozilla.com\u003e", "branch": "default", "desc": "Bug 1959123 - Updated browsertime dependencies to 24.8.2 a=NPOTB DONTBUILD\n\nUpdated the browsertime dependencies to version 24.8.2 and disabled perfstats for twitch-animation tests on the macOS 14.70 Shippable platform as a temporary fix for the perfstat failures that will be resolved in Bug 1972620. The usb-power-profiling package was also updated to 1.6.0 to avoid issues during symbolication when running the profiler. Previous browsertime dependency update to version 24.8.1 was failing on the firefox-constant-regression test.\n", "files": ["testing/perfdocs/generated/raptor.rst", "testing/raptor/raptor/tests/benchmarks/twitch-animation.toml", "tools/browsertime/package-lock.json", "tools/browsertime/package.json"], "git_node": "499162955720589dfca7f0de323422d4df541888", "git_parents": ["cadccb2f8c432600440fc8af7d34402743ab7b96"], "node": "893425ab9089484104a7ac95572d6f4af583b86c", "parents": ["2de2e8e7a5625f29b572923b93a4228841cc3506"], "tags": []}, {"author": "Abhishek Nimalan \u003cabhisheknimalan@gmail.com\u003e", "branch": "default", "desc": "Bug 1977613 - Update browsertime to fix edgedriver URL change issue. r=perftest-reviewers,kshampur a=NPOTB DONTBUILD\n\nThis patch updates browsertime's package files to fix the build failure due to the URL change for edgedriver.\nThis is needed to ensure browsertime dependencies can be installed (and not blocked by an outdated edgedriver)\nwhen running raptor tests locally for the first time. The edgedriver issue does not seem to appear in CI\nbecause browsertime tests in CI are currently using an older, cached browsertime-toolchain.\n", "files": ["tools/browsertime/package-lock.json", "tools/browsertime/package.json"], "git_node": "43cd084ad996fefdebdf49229138d5c45006ad69", "git_parents": ["499162955720589dfca7f0de323422d4df541888"], "node": "90ba9ac5d2a960dfa922ace345e7e65787ef373e", "parents": ["893425ab9089484104a7ac95572d6f4af583b86c"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1987457 - freeze date in unit test to avoid spurious failures when test variants expire r=jmaher a=test-only DONTBUILD\n", "files": ["tools/tryselect/test/test_fuzzy.py"], "git_node": "41e19d3053a6f4c99c0a8ad970b6d2510a656875", "git_parents": ["43cd084ad996fefdebdf49229138d5c45006ad69"], "node": "85b72100b455b4699ff10f57d282d3d54dfefefe", "parents": ["90ba9ac5d2a960dfa922ace345e7e65787ef373e"], "tags": []}], "date": 1761797158, "git_changesets": ["3e6c3047fba0f1dbfc0e3dec4cb493a9f8ff507c", "9307ca798a9c6246fa5316ee6b4451ade06d9fa6", "cadccb2f8c432600440fc8af7d34402743ab7b96", "499162955720589dfca7f0de323422d4df541888", "43cd084ad996fefdebdf49229138d5c45006ad69", "41e19d3053a6f4c99c0a8ad970b6d2510a656875"], "user": "rvandermeulen@mozilla.com"}, "323": {"changesets": [{"author": "Stephen King \u003csking@thunderbird.net\u003e", "branch": "default", "desc": "Bug 1991990: Update MSIX Packaging Branding  a=pascalc DONTBUILD\n\nThunderbird already uses a \" Beta\" suffix in its branding. Only add a \" Beta\" suffix if one does not already exist.\n\nAlso adds an esr channel with a corresponding \" ESR\" suffix if one does not aleady exist in the products branding.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D268806\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270627\n", "files": ["python/mozbuild/mozbuild/mach_commands.py", "python/mozbuild/mozbuild/repackaging/msix.py"], "git_node": "3c22b4c56f688d485a71f3735d86afddf4a1f74b", "git_parents": ["41e19d3053a6f4c99c0a8ad970b6d2510a656875"], "node": "bd4293069f4f6c6a766ea8413bba77afd20ac6b1", "parents": ["85b72100b455b4699ff10f57d282d3d54dfefefe"], "tags": []}], "date": 1761814298, "git_changesets": ["3c22b4c56f688d485a71f3735d86afddf4a1f74b"], "user": "pchevrel@mozilla.com"}, "324": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1990586 - Make `WhiteSpaceVisibilityKeeper::DeleteContentNodeAndJoinTextNodesAroundIt` track given caret point  a=pascalc\n\nIt's used as the result in some cases.  However, it's not tracked in\nsome cases when touching the DOM.\n\nThis modifies the API of `AutoTrackDOMPoint` to flush the tracking point\nbut can keep tracking.  We should use the new API in every place later.\n\n(This manually merges `WhiteSpaceVisibilityKeeper.cpp` because ESR140\nstill has the pref to take the legacy mode back and that blocks applying\nthe patch cleanly.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270643\n", "files": ["editor/libeditor/EditorForwards.h", "editor/libeditor/SelectionState.h", "editor/libeditor/WhiteSpaceVisibilityKeeper.cpp", "testing/web-platform/tests/editing/crashtests/delete-in-empty-editable-document-element.html"], "git_node": "0c6404cf721164dfbd460b60252b67f87d9d749d", "git_parents": ["3c22b4c56f688d485a71f3735d86afddf4a1f74b"], "node": "26eff341874075f35c3daa42b8e29fa54ff62972", "parents": ["bd4293069f4f6c6a766ea8413bba77afd20ac6b1"], "tags": []}], "date": 1761814440, "git_changesets": ["0c6404cf721164dfbd460b60252b67f87d9d749d"], "user": "pchevrel@mozilla.com"}, "325": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270652\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-config-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "3a7afc86741cd0c80306f874682847ff61848672", "git_parents": ["0c6404cf721164dfbd460b60252b67f87d9d749d"], "node": "85050669f2e25e3df8ac32eb32f7520707e59396", "parents": ["26eff341874075f35c3daa42b8e29fa54ff62972"], "tags": []}], "date": 1761822938, "git_changesets": ["3a7afc86741cd0c80306f874682847ff61848672"], "user": "pchevrel@mozilla.com"}, "326": {"changesets": [{"author": "Michael Kaply \u003c345868+mkaply@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1994791 - Chatbot policy should turn off context menu.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D269272\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270676\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js"], "git_node": "0a0e35c404b9c02162ae84e9680c85e70b3d5f3e", "git_parents": ["3a7afc86741cd0c80306f874682847ff61848672"], "node": "f583a286a50d7585b02591f455fe2f109eae3692", "parents": ["85050669f2e25e3df8ac32eb32f7520707e59396"], "tags": []}], "date": 1761837267, "git_changesets": ["0a0e35c404b9c02162ae84e9680c85e70b3d5f3e"], "user": "pchevrel@mozilla.com"}, "327": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1995686 - Pass copies to SendCaptureEnded. r=jib,grulja a=RyanVM\n", "files": ["dom/media/systemservices/CamerasParent.cpp"], "git_node": "3f6ceff21f7bdb46fa47757cd76f0b78e253b542", "git_parents": ["0a0e35c404b9c02162ae84e9680c85e70b3d5f3e"], "node": "a926f18ecc2ddce2de49ea2027b27751bd72b2f2", "parents": ["f583a286a50d7585b02591f455fe2f109eae3692"], "tags": []}], "date": 1761858765, "git_changesets": ["3f6ceff21f7bdb46fa47757cd76f0b78e253b542"], "user": "rvandermeulen@mozilla.com"}, "328": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1968820 - Make `HTMLEditor::InsertPaddingBRElementIfNeeded()` put `\u003cbr\u003e` before the mail-quote  a=dmeehan\n\nWhen we find a block boundary, it may be current block's boundary or\nother block's boundary.  The lambda assume only the former, but the\nSTR of this bug hits the latter case.\n\nSo, when user modifies the text before a mail-quote which is a block of\n`\u003cspan\u003e` element should put `\u003cbr\u003e` before it rather than end of it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270782\n", "files": ["editor/libeditor/HTMLEditSubActionHandler.cpp", "editor/libeditor/tests/mochitest.toml", "editor/libeditor/tests/test_mailcite_backspace_at_end_of_inline_reply.html"], "git_node": "8e53bd4fcd9559f3ab3777f94716257513b42536", "git_parents": ["3f6ceff21f7bdb46fa47757cd76f0b78e253b542"], "node": "2b300e5a80c0cf3bd3f7e918816fc65482d1ee6d", "parents": ["a926f18ecc2ddce2de49ea2027b27751bd72b2f2"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1989861 - Make `HTMLEditor::EnsureNoFollowingUnnecessaryLineBreak` consider a preceding `\u003cbr\u003e` of a mailcite is necessary  a=dmeehan\n\nThe serializer needs to make each mailcite starts from head of a line.\nHowever, mailcite may be a blocked `\u003cspan\u003e`.  So, its preceding `\u003cbr\u003e`\nis not required from the HTML point of view, but we need to preserve\nit for the serializer.\n\nIf we need this hack in some other places, we should make\n`HTMLEditUtils::GetFollowingUnnecessaryLineBreak()` aware of this\nspecial handling in a follow up bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D270784\n", "files": ["editor/libeditor/HTMLEditor.cpp", "editor/libeditor/tests/mochitest.toml", "editor/libeditor/tests/test_mailcite_keep_preceding_br_after_insert.html"], "git_node": "3d600c8b5d9b1667d85279a8cb2b8f1d4492c9bf", "git_parents": ["8e53bd4fcd9559f3ab3777f94716257513b42536"], "node": "0fcbf6268b5abc55012f27ba0e4294cff103c870", "parents": ["2b300e5a80c0cf3bd3f7e918816fc65482d1ee6d"], "tags": []}], "date": 1761915167, "git_changesets": ["8e53bd4fcd9559f3ab3777f94716257513b42536", "3d600c8b5d9b1667d85279a8cb2b8f1d4492c9bf"], "user": "dmeehan@mozilla.com"}, "329": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1995696 - Don't populate Places menus if they create a recursive structure  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D269599\n\nDifferential Revision: https://phabricator.services.mozilla.com/D271039\n", "files": ["browser/components/places/content/browserPlacesViews.js", "browser/components/places/tests/browser/browser.toml", "browser/components/places/tests/browser/browser_recursive_hierarchies.js"], "git_node": "fa313641c0a8092c861d1911b5db7b30640c365f", "git_parents": ["3d600c8b5d9b1667d85279a8cb2b8f1d4492c9bf"], "node": "b867a9aa764c08408ba17b2a8f20c66d7cd84666", "parents": ["0fcbf6268b5abc55012f27ba0e4294cff103c870"], "tags": []}], "date": 1762167473, "git_changesets": ["fa313641c0a8092c861d1911b5db7b30640c365f"], "user": "pchevrel@mozilla.com"}, "330": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings ct-logs -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D271075\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/top-sites.jso