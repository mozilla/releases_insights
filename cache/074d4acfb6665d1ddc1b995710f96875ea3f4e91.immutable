Review-Commit-ID: 2bFLcGEARTJ", "files": ["testing/mozharness/external_tools/robustcheckout.py"], "git_node": null, "git_parents": [null], "node": "612f7b6026905bfe875374534396ccbf858e81d3", "parents": ["62e1cf4e659565618426bda70443076817d02c60"], "tags": []}], "date": 1491940271, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "7023": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 612f7b602690 (bug 1317594) for breaking compat with Mercurial 3.7.", "files": ["testing/mozharness/external_tools/robustcheckout.py"], "git_node": null, "git_parents": [null], "node": "10791c73b816717f2c28e4a83d18a207e2b0d9f0", "parents": ["612f7b6026905bfe875374534396ccbf858e81d3"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1317594 - Vendor latest version of robustcheckout extension. a=NPOTB\n\nFile copied verbatim from changeset 249a47720ddcf896a9f07600c429a1b4492b805e\nfrom the version-control-tools repository.\n\nThe updated extension now detects and retries after network failures\nwhere it didn't before. This should cut down on the number of\nintermittent failures.\n\nMozReview-Commit-ID: 2bFLcGEARTJ", "files": ["testing/mozharness/external_tools/robustcheckout.py"], "git_node": null, "git_parents": [null], "node": "15f63401caefa5c829cd4cb35ee27c25e9001b83", "parents": ["10791c73b816717f2c28e4a83d18a207e2b0d9f0"], "tags": []}], "date": 1491943529, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "7024": {"changesets": [{"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1355404 - Make single locale use the unified repo r=nthomas a=release\n\nMozReview-Commit-ID: KvYjJhbxCzs", "files": ["testing/mozharness/configs/single_locale/dev-mozilla-beta.py", "testing/mozharness/configs/single_locale/dev-mozilla-release.py", "testing/mozharness/configs/single_locale/mozilla-aurora.py", "testing/mozharness/configs/single_locale/mozilla-beta.py", "testing/mozharness/configs/single_locale/mozilla-central.py", "testing/mozharness/configs/single_locale/mozilla-esr52.py", "testing/mozharness/configs/single_locale/mozilla-release.py"], "git_node": null, "git_parents": [null], "node": "db0c9c2760ddcfcd53d915d91881cdf70cb9381f", "parents": ["15f63401caefa5c829cd4cb35ee27c25e9001b83"], "tags": []}], "date": 1491990018, "git_changesets": [null], "user": "jlorenzo@mozilla.com"}, "7025": {"changesets": [{"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1355018 - Make post-release steps use the unified repo r=rail a=release CLOSED TREE\n\nMozReview-Commit-ID: GtfoY8RVE2n", "files": ["testing/mozharness/configs/releases/dev_postrelease_firefox_beta.py", "testing/mozharness/configs/releases/dev_postrelease_firefox_release.py", "testing/mozharness/configs/releases/postrelease_firefox_beta.py", "testing/mozharness/configs/releases/postrelease_firefox_esr52.py", "testing/mozharness/configs/releases/postrelease_firefox_release.py"], "git_node": null, "git_parents": [null], "node": "d01c882f6b1c1b116edc0db2afdfd0d6a0e46fb9", "parents": ["db0c9c2760ddcfcd53d915d91881cdf70cb9381f"], "tags": []}], "date": 1492001303, "git_changesets": [null], "user": "jlorenzo@mozilla.com"}, "7026": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-053 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "53dd927557b8e2730a6c3ceb60961253f789ae58", "parents": ["d01c882f6b1c1b116edc0db2afdfd0d6a0e46fb9"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-053 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "e35c073dbc8bbd9a11852fd83d685934de9eb59c", "parents": ["53dd927557b8e2730a6c3ceb60961253f789ae58"], "tags": []}], "date": 1492009360, "git_changesets": [null, null], "user": "ffxbld"}, "7027": {"changesets": [{"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1355624 - Make Mercurial require TLS 1.2+ connections. r=dustin, a=NPOTB\n\nMercurial uses the latest version of TLS that is both supported by\nPython and the server.\n\nIn automation, the servers we care about should all support TLS 1.2.\n\nThe Python side is trickier. Modern versions of Python (typically 2.7.9+)\nsupport TLS 1.1 and 1.2. Mercurial will default to allowing TLS 1.1+ -\nexplicitly disallowing TLS 1.0. However, legacy versions of Python\ndon't support TLS 1.1+, so Mercurial will allow TLS 1.0+ rather than\nprevent connections at all.\n\nTLS 1.0 is borderline secure these days. I think it is a bug for TLS\n1.0 to be used anywhere in the Firefox release process. This simple\npatch changes our default Mercurial config in TaskCluster to require\nTLS 1.2+ for all https:// communications. For modern Python versions,\nthis effectively prevents potential downgrade attacks to TLS 1.1\n(connections before should have negotiated the use of TLS 1.2).\n\nI expect this change to break things. Finding and fixing automation\nthat isn't capable of speaking TLS 1.1+ should be encouraged.\n\nMozReview-Commit-ID: 876YpL5vB3T", "files": ["testing/docker/recipes/install-mercurial.sh"], "git_node": null, "git_parents": [null], "node": "154327e98878f5d8d1869505312ece14c2207153", "parents": ["e35c073dbc8bbd9a11852fd83d685934de9eb59c"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1139795 - Disable /html/dom/dynamic-markup-insertion/opening-the-input-stream/010.html due to bad timing. r=jgraham, a=test-only\n\nMozReview-Commit-ID: 49YuAQjjYoH", "files": ["testing/web-platform/meta/html/dom/dynamic-markup-insertion/opening-the-input-stream/010.html.ini"], "git_node": null, "git_parents": [null], "node": "af7d378522eee1714b5398d510005af4efb3457c", "parents": ["154327e98878f5d8d1869505312ece14c2207153"], "tags": []}, {"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1090198 - Disable intermittent websockets/constructor/014.html on e10s debug. a=test-only", "files": ["testing/web-platform/meta/websockets/constructor/014.html.ini"], "git_node": null, "git_parents": [null], "node": "21f106a0665c8abea9ed645cc1dc279ccd765360", "parents": ["af7d378522eee1714b5398d510005af4efb3457c"], "tags": []}, {"author": "Nicholas Hurley \u003churley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1346392 - Force non-spdy on sticky auth connections. r=dragana, a=lizzard\n\nMozReview-Commit-ID: IkYTVgetKsn", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h", "netwerk/protocol/http/nsHttpChannelAuthProvider.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h", "netwerk/protocol/http/nsIHttpAuthenticableChannel.idl"], "git_node": null, "git_parents": [null], "node": "955ee0340ab79a1712618cf7dc8bcb9345ee187b", "parents": ["21f106a0665c8abea9ed645cc1dc279ccd765360"], "tags": []}, {"author": "David Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1353216 - Disable certificate transparency processing for performance concerns. r=jcj, a=lizzard\n\nMozReview-Commit-ID: 2k7FwC5RCWC", "files": ["netwerk/base/security-prefs.js"], "git_node": null, "git_parents": [null], "node": "aaa0bba23803d2fcf283040f123915cf98a7eef0", "parents": ["955ee0340ab79a1712618cf7dc8bcb9345ee187b"], "tags": []}], "date": 1492032113, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7028": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-301