"lastpushid": 7836,
"pushes": {"6921": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-026 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "4e31b2e7f40ada2e86e85b0ecaeedeee2b16d2cc", "parents": ["15d9d940341f02ef6dcad96899d284619d3d48db"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-026 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "1ef81d2b9db31f048bfd79bc44c1b6f03a41f2aa", "parents": ["4e31b2e7f40ada2e86e85b0ecaeedeee2b16d2cc"], "tags": []}], "date": 1488555982, "git_changesets": [null, null], "user": "ffxbld"}, "6922": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-305 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "1766b416095313c26867337195a1bcfeefbeb4d5", "parents": ["1ef81d2b9db31f048bfd79bc44c1b6f03a41f2aa"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-305 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "41ae6dd2a13c798581f71ed5959e505698c0ded6", "parents": ["1766b416095313c26867337195a1bcfeefbeb4d5"], "tags": []}], "date": 1488641887, "git_changesets": [null, null], "user": "ffxbld"}, "6923": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-306 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "b2ae694a405279e5c53d52ba91c577dd9a531811", "parents": ["41ae6dd2a13c798581f71ed5959e505698c0ded6"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-306 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "3fdce177df48c594afe6e3440355e41cbf55940c", "parents": ["b2ae694a405279e5c53d52ba91c577dd9a531811"], "tags": []}], "date": 1488727376, "git_changesets": [null, null], "user": "ffxbld"}, "6924": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-095 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "b0ea2ffc3dbb9390d5c611e701b95ab4ca40e5e5", "parents": ["3fdce177df48c594afe6e3440355e41cbf55940c"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-095 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "ce1a4a27b63bf41158f526d713c2d8029f291a81", "parents": ["b0ea2ffc3dbb9390d5c611e701b95ab4ca40e5e5"], "tags": []}], "date": 1488814778, "git_changesets": [null, null], "user": "ffxbld"}, "6925": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump. CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "5bc0b65754eb16dce6365f6f66c38c8269c6ec0e", "parents": ["ce1a4a27b63bf41158f526d713c2d8029f291a81"], "tags": []}, {"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "No bug - Tagging 15d9d940341f02ef6dcad96899d284619d3d48db with FIREFOX_52_0esr_BUILD4, FIREFOX_52_0esr_RELEASE a=release CLOSED TREE", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "dac467924a46c4bbff97c948bf4a7143dada2b19", "parents": ["5bc0b65754eb16dce6365f6f66c38c8269c6ec0e"], "tags": []}], "date": 1488896515, "git_changesets": [null, null], "user": "ffxbld"}, "6926": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-308 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "794f4dab11e085361ab321ff09779c1b9358820e", "parents": ["dac467924a46c4bbff97c948bf4a7143dada2b19"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-308 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "31f4e02c044d22c361c85050870cea38c274985d", "parents": ["794f4dab11e085361ab321ff09779c1b9358820e"], "tags": []}], "date": 1488900589, "git_changesets": [null, null], "user": "ffxbld"}, "6927": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-306 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "07c4a55e3d062a4f3621edd1039ec1cb9ddcc9a7", "parents": ["31f4e02c044d22c361c85050870cea38c274985d"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-306 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "3f0d904d7f7da39b56cb008c6763094431d6a249", "parents": ["07c4a55e3d062a4f3621edd1039ec1cb9ddcc9a7"], "tags": []}], "date": 1488987354, "git_changesets": [null, null], "user": "ffxbld"}, "6928": {"changesets": [{"author": "Matt Woodrow \u003cmwoodrow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1300355 - Part 1: Increase frequency of GC/CC during reftests. r=dbaron, a=test-only", "files": ["layout/tools/reftest/reftest-content.js"], "git_node": null, "git_parents": [null], "node": "2bb591035b83309ef534715b1c1eadbaf5783d0a", "parents": ["3f0d904d7f7da39b56cb008c6763094431d6a249"], "tags": []}, {"author": "Matt Woodrow \u003cmwoodrow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1300355 - Part 2: Don't track use counts in the reftest harness when the cache is disabled. r=dbaron, a=test-only", "files": ["layout/tools/reftest/reftest.jsm"], "git_node": null, "git_parents": [null], "node": "fb382c5c0cf05aa5b46557c7b062ab6f6bd6f612", "parents": ["2bb591035b83309ef534715b1c1eadbaf5783d0a"], "tags": []}, {"author": "Matt Woodrow \u003cmwoodrow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1300355 - Part 3: Disable reftest canvas cache for win 7. r=jmaher, a=test-only", "files": ["layout/tools/reftest/runreftest.py"], "git_node": null, "git_parents": [null], "node": "9a153f39053dac4177f0a739f3d40c7808b0b5bd", "parents": ["fb382c5c0cf05aa5b46557c7b062ab6f6bd6f612"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1317047 followup, make the table cells smaller to avoid horizontal compression of columns. a=test-only", "files": ["layout/reftests/w3c-css/submitted/writing-modes-3/logical-physical-mapping-001-ref.html", "layout/reftests/w3c-css/submitted/writing-modes-3/logical-physical-mapping-001.html"], "git_node": null, "git_parents": [null], "node": "2a6ced4d447da283b3c7f84d2da0956abb1dc683", "parents": ["9a153f39053dac4177f0a739f3d40c7808b0b5bd"], "tags": []}, {"author": "Matt Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1343938 - Fix new installs erroneously not prompting to change the default browser setting. r=agashlin, a=jcristau\n\nMozReview-Commit-ID: EYPeEOE8Ldr", "files": ["browser/installer/windows/nsis/installer.nsi"], "git_node": null, "git_parents": [null], "node": "55b2513ee25301d82b026182953d1f273b7d8de5", "parents": ["2a6ced4d447da283b3c7f84d2da0956abb1dc683"], "tags": []}], "date": 1489007116, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "6929": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1322027 - Update jemalloc 4 to version 4.4.0. r=glandium a=jorgk", "files": ["build/autoconf/jemalloc.m4", "memory/jemalloc/src/ChangeLog", "memory/jemalloc/src/INSTALL", "memory/jemalloc/src/Makefile.in", "memory/jemalloc/src/VERSION", "memory/jemalloc/src/build-aux/config.guess", "memory/jemalloc/src/build-aux/config.sub", "memory/jemalloc/src/configure", "memory/jemalloc/src/configure.ac", "memory/jemalloc/src/doc/jemalloc.xml.in", "memory/jemalloc/src/include/jemalloc/internal/arena.h", "memory/jemalloc/src/include/jemalloc/internal/chunk.h", "memory/jemalloc/src/include/jemalloc/internal/extent.h", "memory/jemalloc/src/include/jemalloc/internal/jemalloc_internal.h.in", "memory/jemalloc/src/include/jemalloc/internal/jemalloc_internal_defs.h.in", "memory/jemalloc/src/include/jemalloc/internal/pages.h", "memory/jemalloc/src/include/jemalloc/internal/private_symbols.txt", "memory/jemalloc/src/include/jemalloc/internal/stats.h", "memory/jemalloc/src/include/jemalloc/internal/util.h", "memory/jemalloc/src/include/jemalloc/internal/valgrind.h", "memory/jemalloc/src/msvc/projects/vc2015/test_threads/test_threads.cpp", "memory/jemalloc/src/src/arena.c", "memory/jemalloc/src/src/base.c", "memory/jemalloc/src/src/chunk.c", "memory/jemalloc/src/src/chunk_dss.c", "memory/jemalloc/src/src/extent.c", "memory/jemalloc/src/src/huge.c", "memory/jemalloc/src/src/jemalloc.c", "memory/jemalloc/src/src/pages.c", "memory/jemalloc/src/src/stats.c", "memory/jemalloc/src/src/tcache.c", "memory/jemalloc/src/src/util.c", "memory/jemalloc/src/test/integration/MALLOCX_ARENA.c", "memory/jemalloc/src/test/integration/allocated.c", "memory/jemalloc/src/test/integration/chunk.c", "memory/jemalloc/src/test/integration/mallocx.c", "memory/jemalloc/src/test/integration/overflow.c", "memory/jemalloc/src/test/integration/rallocx.c", "memory/jemalloc/src/test/integration/sdallocx.c", "memory/jemalloc/src/test/integration/thread_arena.c", "memory/jemalloc/src/test/integration/thread_tcache_enabled.c", "memory/jemalloc/src/test/integration/xallocx.c", "memory/jemalloc/src/test/unit/arena_reset.c", "memory/jemalloc/src/test/unit/decay.c", "memory/jemalloc/src/test/unit/mallctl.c", "memory/jemalloc/src/test/unit/pack.c", "memory/jemalloc/src/test/unit/pages.c", "memory/jemalloc/src/test/unit/prof_accum.c", "memory/jemalloc/src/test/unit/prof_active.c", "memory/jemalloc/src/test/unit/prof_gdump.c", "memory/jemalloc/src/test/unit/prof_idump.c", "memory/jemalloc/src/test/unit/prof_reset.c", "memory/jemalloc/src/test/unit/prof_thread_name.c", "memory/jemalloc/src/test/unit/run_quantize.c", "memory/jemalloc/src/test/unit/size_classes.c", "memory/jemalloc/src/test/unit/stats.c", "memory/jemalloc/src/test/unit/tsd.c", "memory/jemalloc/src/test/unit/util.c", "memory/jemalloc/upstream.info"], "git_node": null, "git_parents": [null], "node": "301a46b075293261115b39da1ff5f4d06cc08406", "parents": ["15d9d940341f02ef6dcad96899d284619d3d48db"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1322027 - Don't disable hugepage support since it no longer causes PGO issues. a=jorgk", "files": ["build/autoconf/jemalloc.m4"], "git_node": null, "git_parents": [null], "node": "7770a9083198bca021de3c6fe3b48a4f7daff7cc", "parents": ["301a46b075293261115b39da1ff5f4d06cc08406"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1311039 - Properly detect the default malloc zone on OSX 10.12. r=njn a=jorgk", "files": ["memory/mozjemalloc/jemalloc.c"], "git_node": null, "git_parents": [null], "node": "693fe5c8555069d6a88cc9c08a62f2b073d39d43", "parents": ["7770a9083198bca021de3c6fe3b48a4f7daff7cc"], "tags": []}, {"author": "John Paul Adrian Glaubitz \u003cglaubitz@physik.fu-berlin.de\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1275204 - mozjemalloc: Use better pre-processor defines for sparc64. r=glandium a=jorgk", "files": ["memory/mozjemalloc/jemalloc.c"], "git_node": null, "git_parents": [null], "node": "0d2f32e3bd87543d1b686a5c1f790be68a7bfdb2", "parents": ["693fe5c8555069d6a88cc9c08a62f2b073d39d43"], "tags": []}, {"author": "John Paul Adrian Glaubitz \u003cglaubitz@physik.fu-berlin.de\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1275204 - mozjemalloc: Use the JS arm64 allocator on Linux/sparc64. r=glandium a=jorgk", "files": ["memory/mozjemalloc/jemalloc.c"], "git_node": null, "git_parents": [null], "node": "e2be59496c8626bc9f194d2a993ac77dbde41835", "parents": ["0d2f32e3bd87543d1b686a5c1f790be68a7bfdb2"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1286613 - Properly call mozjemalloc pre/post fork hooks on OSX when replace-malloc is enabled. r=njn a=jorgk\n\nSomehow, we never called those hooks when replace-malloc is enabled. I'd\nexpect this to cause random deadlocks when forking, and I'm surprised\nthis hasn't surfaced. Maybe it actually causes some intermittent oranges\non automation, who knows.\n\nThis also brings consistency with what is done for jemalloc 4, and with\nthe mozjemalloc implementation, too, that we're going to replace with\nthis one in a subsequent changeset.", "files": ["memory/build/replace_malloc.c", "memory/mozjemalloc/jemalloc.c"], "git_node": null, "git_parents": [null], "node": "80b0b75f8b0d069a87d3c24fcf78901fe51258dc", "parents": ["e2be59496c8626bc9f194d2a993ac77dbde41835"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1286613 - Move replace-malloc zone allocator to a separate file. r=njn a=jorgk\n\nThe intent here is to reuse the zone allocator for mozjemalloc, to avoid\nall the shortcomings of mozjemalloc using a different one. This change\nonly moves the replace-malloc zone allocator out of replace-malloc.c, to\nmake changes for mozjemalloc integration clearer.", "files": ["memory/build/moz.build", "memory/build/replace_malloc.c", "memory/build/zone.c"], "git_node": null, "git_parents": [null], "node": "7d0dd01d7dd4712ea8be076e9e03d67a5948b1f8", "parents": ["80b0b75f8b0d069a87d3c24fcf78901fe51258dc"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1286613 - Use the same zone allocator implementation as replace-malloc for mozjemalloc. r=njn a=jorgk\n\nWe have been using a different zone allocator between mozjemalloc and\nreplace-malloc for a long time. Jemalloc 4 uses the same as\nreplace-malloc, albeit as part of the jemalloc upstream code base.\n\nWe've been bitten many times in the past with Apple changes breaking the\nzone allocator, and each time we've had to make changes to the three\ninstances, although two of them are similar and the changes there are\nstraightforward.\n\nIt also turns out that the way the mozjemalloc zone allocator is set up,\nwhen a new version of OSX appears with a new version of the system zone\nallocator, Firefox ends up using the system allocator, because the zone\nallocator version is not supported.\n\nSo, we use the same zone allocator for both replace-malloc and\nmozjemalloc, making everything on par with jemalloc 4.", "files": ["memory/build/moz.build", "memory/build/zone.c", "memory/mozjemalloc/jemalloc.c", "memory/mozjemalloc/osx_zone_types.h"], "git_node": null, "git_parents": [null], "node": "e2289a5148001a8b680875adbe11ce7835f15292", "parents": ["7d0dd01d7dd4712ea8be076e9e03d67a5948b1f8"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1286613 - Don't rely on OSX SDK malloc/malloc.h for malloc_zone struct definitions. r=njn a=jorgk\n\nThe SDK jemalloc is built against might be not be the latest for various\nreasons, but the resulting binary ought to work on newer versions of\nOSX.\n\nIn order to ensure this, we need the fullest definitions possible, so\ncopy what we need from the latest version of malloc/malloc.h available\non opensource.apple.com.\n\n[Adapted from\nhttps://github.com/jemalloc/jemalloc/commit/c68bb4179312665e22d375aecf9f4306607c7c1a]", "files": ["memory/build/zone.c"], "git_node": null, "git_parents": [null], "node": "7b2c4625fa0fe62cd659f3f7b226bd1b295185d5", "parents": ["e2289a5148001a8b680875adbe11ce7835f15292"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1286613 - Add dummy implementations for most remaining OSX zone allocator functions. r=njn a=jorgk\n\nSome system libraries are using malloc_default_zone() and then using\nsome of the malloc_zone_* API. Under normal conditions, those functions\ncheck the malloc_zone_t/malloc_introspection_t struct for the values\nthat are allowed to be NULL, so that a NULL deref doesn't happen.\n\nAs of OSX 10.12, malloc_default_zone() doesn't return the actual default\nzone anymore, but returns a fake, wrapper zone. The wrapper zone defines\nall the possible functions in the malloc_zone_t/malloc_introspection_t\nstruct (almost), and calls the function from the registered default zone\n(jemalloc in our case) on its own. Without checking whether the pointers\nare NULL.\n\nThis means that a system library that calls e.g.\nmalloc_zone_batch_malloc(malloc_default_zone(), ...) ends up trying to\ncall jemalloc_zone.batch_malloc, which is NULL, and crash follows.\n\nSo as of OSX 10.12, the default zone is required to have all the\nfunctions available (really, the same as the wrapper zone), even if they\ndo nothing.\n\nThis is arguably a bug in libsystem_malloc in OSX 10.12, but jemalloc\nstill needs to work in that case.\n\n[Adapted from\nhttps://github.com/jemalloc/jemalloc/commit/c6943acb3c56d1b3d1e82dd43b3fcfeae7771990]", "files": ["memory/build/zone.c"], "git_node": null, "git_parents": [null], "node": "2070ab8bedb27c8c85324a4083655f499e48e78b", "parents": ["7b2c4625fa0fe62cd659f3f7b226bd1b295185d5"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1286613 - Update jemalloc 4 to c6943ac. r=njn a=jorgk\n\nThis picks the same changes as the ones we just did to\nmemory/build/zone.c, plus a oneliner for sparc64.", "files": ["memory/jemalloc/src/VERSION", "memory/jemalloc/src/configure", "memory/jemalloc/src/configure.ac", "memory/jemalloc/src/include/jemalloc/internal/jemalloc_internal.h.in", "memory/jemalloc/src/include/jemalloc/internal/jemalloc_internal_defs.h.in", "memory/jemalloc/src/include/jemalloc/internal/mb.h", "memory/jemalloc/src/src/zone.c", "memory/jemalloc/upstream.info"], "git_node": null, "git_parents": [null], "node": "22d22554507f6db7c1ecd8e467516bd194e48e7e", "parents": ["2070ab8bedb27c8c85324a4083655f499e48e78b"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1332508 - Reinitialize allocator mutexes in fork() child processes. r=njn a=jorgk DONTBUILD\n\nAdapted from\nhttps://github.com/jemalloc/jemalloc/commit/4e2e3dd9cf19ed5991938a708a8b50611aa5bbf8\nand\nhttps://github.com/jemalloc/jemalloc/commit/d9f7b2a4307f7ff9f7a139b33d366d44e8a8b83d\n\nAs per the latter commit, it would seem unlocking, in fork() child\nprocesses, mutexes that were locked in the parent process is not really\nwell supported on OSX 10.12. The addition of the zone_reinit_lock\nfunction in 10.12 supports this idea.", "files": ["memory/build/zone.c", "memory/mozjemalloc/jemalloc.c"], "git_node": null, "git_parents": [null], "node": "ae7f7269073a31622cae4221fb7aad868767f24a", "parents": ["22d22554507f6db7c1ecd8e467516bd194e48e7e"], "tags": []}], "date": 1489054876, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null], "user": "mozilla@jorgk.com"}, "6930": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-384 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "e91f28a35e2027dc9321f42a70f9d7148c6ed7d2", "parents": ["55b2513ee25301d82b026182953d1f273b7d8de5"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-384 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "1bb8c90bae68b99eed71768731629191e7e60be2", "parents": ["e91f28a35e2027dc9321f42a70f9d7148c6ed7d2"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-384 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "ba1cff49bacefcc98557bafcc9f39eac34265322", "parents": ["1bb8c90bae68b99eed71768731629191e7e60be2"], "tags": []}], "date": 1489072803, "git_changesets": [null, null, null], "user": "ffxbld"}, "6931": {"changesets": [{"author": "tbirdbld", "branch": "THUNDERBIRD520_2017030915_RELBRANCH", "desc": "Automated checkin: version bump for thunderbird 52.0 release. DONTBUILD CLOSED TREE a=release", "files": [], "git_node": null, "git_parents": [null], "node": "a15a29e4a07c2d5182985adf47b54d177a33cf34", "parents": ["ae7f7269073a3