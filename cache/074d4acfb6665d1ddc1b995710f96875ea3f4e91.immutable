, "parents": ["9333f6772c1898e45a4be46556d19b35f2dafde8"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-368 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "40f159de4e7340c6f5fa0d083c28d7f4c18c22a6", "parents": ["1babe8573585a833bb71715eea3ef5e94578ac10"], "tags": []}], "date": 1491751716, "git_changesets": [null, null], "user": "ffxbld"}, "7014": {"changesets": [{"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1353088: Ensure we don't attempt to process garbage data. r=gerald,a=lizzard\n\nMozReview-Commit-ID: AryC34eLjOg\n", "files": ["dom/media/mediasource/TrackBuffersManager.cpp", "dom/media/mediasource/TrackBuffersManager.h"], "git_node": null, "git_parents": [null], "node": "7a30cddfcd546da645c56f86ac78ee949ca46fe3", "parents": ["40f159de4e7340c6f5fa0d083c28d7f4c18c22a6"], "tags": []}], "date": 1491811659, "git_changesets": [null], "user": "jyavenard@mozilla.com"}, "7015": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-306 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "e3ac524e3d0d248c7ef1baee1646d8771d638af0", "parents": ["7a30cddfcd546da645c56f86ac78ee949ca46fe3"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-306 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "1fcf426dd867c00fa7b58b1221762bca76189184", "parents": ["e3ac524e3d0d248c7ef1baee1646d8771d638af0"], "tags": []}], "date": 1491835104, "git_changesets": [null, null], "user": "ffxbld"}, "7016": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1345873 - Part 0: Minor cleanup in existing test_flexbox_order mochitests. a=test-only\n\nThis patch:\n - does s/var/let/ to upgrade to modern JS best-practices.\n - Wraps some lines that are too long.\n - Changes loops to \"for (let foo of [...])\" rather than foreach+function-pointer.\n - Changes some copypasted cleanup code to use a loop instead (which will be especially useful in a forthcoming version of this test that'll add another thing to clean up).\n\nMozReview-Commit-ID: DWK8jFbfqeB", "files": ["layout/style/test/test_flexbox_order.html", "layout/style/test/test_flexbox_order_table.html"], "git_node": null, "git_parents": [null], "node": "75cea353ad787814158fbbb0805c15711f327f74", "parents": ["1fcf426dd867c00fa7b58b1221762bca76189184"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1345873 - Part 1: Make flex-item sorting code treat placeholders as having the default value of 'order' / 'box-ordinal-group'. r=mats, a=jcristau\n\nThis should allow their flex-item siblings to reorder themselves as-needed for\nhonoring their own 'order' values, without unnecessarily reordering the\nplaceholders.\n\nMozReview-Commit-ID: aCBQER5r2G", "files": ["layout/generic/nsFlexContainerFrame.cpp", "layout/style/test/mochitest.ini", "layout/style/test/test_flexbox_order_abspos.html"], "git_node": null, "git_parents": [null], "node": "b08ef5a82f89190b9daaacd05b07bf63adbbdb31", "parents": ["75cea353ad787814158fbbb0805c15711f327f74"], "tags": []}], "date": 1491840919, "git_changesets": [null, null], "user": "dholbert@mozilla.com"}, "7017": {"changesets": [{"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1183300 - Intermittent dom/security/test/csp/test_upgrade_insecure.html. disable on win7. r=ckerschb, r=gbrown, a=test-only\n\nMozReview-Commit-ID: AslnFrYGOVw", "files": ["dom/security/test/csp/mochitest.ini"], "git_node": null, "git_parents": [null], "node": "0618256da57a335d1daf998f26fededd95fa13c8", "parents": ["b08ef5a82f89190b9daaacd05b07bf63adbbdb31"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1340163 - Introducing originNoSuffix as attribute in ContentPrincipalInfo. r=smaug, a=jcristau", "files": ["caps/nsJSPrincipals.cpp", "dom/cache/DBSchema.cpp", "dom/workers/ServiceWorkerRegistrar.cpp", "dom/workers/test/gtest/TestReadWrite.cpp", "ipc/glue/BackgroundUtils.cpp", "ipc/glue/PBackgroundSharedTypes.ipdlh"], "git_node": null, "git_parents": [null], "node": "f3f2a995a239280091abfe6f6dab8ce413cf64cf", "parents": ["0618256da57a335d1daf998f26fededd95fa13c8"], "tags": []}, {"author": "Jan-Ivar Bruaroey \u003cjib@mozilla.com\u003e", "branch": "default", "desc": "Bug 1348174 - Convert test_enumerateDevices.html to async/await. r=ng, a=test-only\n\nMozReview-Commit-ID: 7kWiwD0E5tO", "files": ["dom/media/tests/mochitest/test_enumerateDevices.html"], "git_node": null, "git_parents": [null], "node": "330904d6f0dc54686a5ef771ebebed10ffedfcd9", "parents": ["f3f2a995a239280091abfe6f6dab8ce413cf64cf"], "tags": []}, {"author": "Jan-Ivar Bruaroey \u003cjib@mozilla.com\u003e", "branch": "default", "desc": "Bug 1348174 - Test that deviceIds are stable for same origin and differ across origins. r=jesup, a=test-only\n\nMozReview-Commit-ID: LEkHzgUZwqd", "files": ["dom/media/tests/mochitest/mochitest.ini", "dom/media/tests/mochitest/test_enumerateDevices.html", "dom/media/tests/mochitest/test_enumerateDevices_iframe.html"], "git_node": null, "git_parents": [null], "node": "c61b99483c4bb3fd225db53a65a382e9103cc72c", "parents": ["330904d6f0dc54686a5ef771ebebed10ffedfcd9"], "tags": []}, {"author": "Kilik Kuo \u003ckikuo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1348601 - Carry IsHandlingUserInput information to media listeners in content.js. r=mrbkap, a=jcristau\n\nHTMLMediaElement relies on user's interaction to allow playback when media.autoplay.enabled set to false.\n\nMozReview-Commit-ID: IPZdAAKlrjM", "files": ["browser/base/content/content.js", "browser/base/content/nsContextMenu.js"], "git_node": null, "git_parents": [null], "node": "1848bd2380649e0c0f0f8f33995c62697f35f8d2", "parents": ["c61b99483c4bb3fd225db53a65a382e9103cc72c"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1345991 - SVG Image Elements aren't displayed in the Page Info view media list. r=florian, a=jcristau\n\nMozReview-Commit-ID: LlHwl2Kn1Vk", "files": ["browser/base/content/content.js", "browser/base/content/test/general/browser.ini", "browser/base/content/test/general/browser_pageinfo_svg_image.js", "browser/base/content/test/general/svg_image.html"], "git_node": null, "git_parents": [null], "node": "2008a4b89d9acd6a8d25374ffd69121b494b2e89", "parents": ["1848bd2380649e0c0f0f8f33995c62697f35f8d2"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1344498 - Add fallible StripWhitespace. r=njn, a=jcristau\n\nMozReview-Commit-ID: 8UOTEBlFxfO", "files": ["xpcom/string/nsTString.h", "xpcom/string/nsTStringObsolete.cpp"], "git_node": null, "git_parents": [null], "node": "9acd0103d67f7ee5fb7d25676479aff19e5b0261", "parents": ["2008a4b89d9acd6a8d25374ffd69121b494b2e89"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1344498 - Use fallible string.StripWhitespace to avoid OOM. r=mcmanus, a=jcristau\n\nMozReview-Commit-ID: 9wosC46DNcX", "files": ["netwerk/protocol/data/nsDataHandler.cpp"], "git_node": null, "git_parents": [null], "node": "49aadb25b1ecef0830c73698b2bc9efe49ce63ce", "parents": ["9acd0103d67f7ee5fb7d25676479aff19e5b0261"], "tags": []}], "date": 1491842406, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7018": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1344205 - Remove unsatisfied assertion on database page removals and protect removals from orphaning. r=standard8, a=jcristau\n\nDue to the asynchronous behavior of history, it's possible a race condition\ncauses a page to be used when it was about to be removed.\nFor example a bookmark to a page could be added between the point where we\ndecide the page is an orphan, and the point where we actually remove the page.\nNotifications in such a case may be improperly ordered, and there is no cheap\nway to guarantee we won't notify a removal in such a case.\nSince applicable solutions would be too expensive (code and perf wise), for now\njust remove the assertion we can't satisfy, and protect removals from possibly\ncreating unexpected orphans.\nTesting this would require a special setup where we can guarantee thread\nscheduling order, so for now this comes without a test. Regardless it's\nbasically only adding safety guards.\n\nMozReview-Commit-ID: KYkaqAv8fCB", "files": ["toolkit/components/places/History.jsm", "toolkit/components/places/nsNavBookmarks.cpp", "toolkit/components/places/nsPlacesExpiration.js", "toolkit/components/places/tests/unit/test_null_interfaces.js"], "git_node": null, "git_parents": [null], "node": "34b453085dc054f029ecebfb0751edf071f7a4ea", "parents": ["49aadb25b1ecef0830c73698b2bc9efe49ce63ce"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1349862 - MutableBlobStorage must use a TaskQueue in order to preserve the order of runnables for I/O ops. r=asuth, a=jcristau", "files": ["dom/base/MutableBlobStorage.cpp", "dom/base/MutableBlobStorage.h"], "git_node": null, "git_parents": [null], "node": "864ff0c36b6be772aa774ecd67ae5a1c330c7aef", "parents": ["34b453085dc054f029ecebfb0751edf071f7a4ea"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1333858 - Intersect should be fallible on overflow. r=daoshengmu, a=jcristau\n\nMozReview-Commit-ID: 6lmIKKyXXah", "files": ["dom/canvas/WebGLContext.cpp", "dom/canvas/WebGLContext.h", "dom/canvas/WebGLContextGL.cpp", "dom/canvas/WebGLTextureUpload.cpp"], "git_node": null, "git_parents": [null], "node": "5ec6fbedb420f3464e4dd3a792fbffb1b2a97258", "parents": ["864ff0c36b6be772aa774ecd67ae5a1c330c7aef"], "tags": []}, {"author": "vincentliu \u003cvliu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1347617 - In SVG ConvolveMatrix code, bail out if kernelUnitLength is negative or zero. r=dholbert, a=jcristau", "files": ["dom/svg/SVGFEConvolveMatrixElement.cpp"], "git_node": null, "git_parents": [null], "node": "2b95de78a92c3fae7b705e288f3a92f61b51bd7a", "parents": ["5ec6fbedb420f3464e4dd3a792fbffb1b2a97258"], "tags": []}, {"author": "Christoph Kerschbaumer \u003cckerschb@christophkerschbaumer.com\u003e", "branch": "default", "desc": "Bug 1353975 - Fix nullPrincipal edge case. r=bz, r=mcmanus, a=jcristau", "files": ["netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": null, "git_parents": [null], "node": "a5ec5e70abf1e35329d2d81b8c4591c37018b01d", "parents": ["2b95de78a92c3fae7b705e288f3a92f61b51bd7a"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1347646 - Use CreateRenderingContext in nsSimplePageSequenceFrame::PrePrintNextPage to ensure recorder is used for canvases. r=jwatt, a=jcristau\n\nCalling CreateReferenceRenderingContext currently returns a non-recording DrawTarget even\nwhen the nsIDeviceContextSpec within the nsDeviceContext has a DrawEventRecorder, due to\nbug 1354624. Since we've already called BeginPage we can call CreateRenderingContext instead\nthough and that will give us a recording DrawTarget as we require to record the canvas drawing.", "files": ["layout/generic/nsSimplePageSequenceFrame.cpp"], "git_node": null, "git_parents": [null], "node": "1b50711a46ceb24bb31391867a7936113632421b", "parents": ["a5ec5e70abf1e35329d2d81b8c4591c37018b01d"], "tags": []}], "date": 1491844858, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7019": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "7beb59bc3482523ad6811fd3984949204d763810", "parents": ["1b50711a46ceb24bb31391867a7936113632421b"], "tags": []}], "date": 1491860981, "git_changesets": [null], "user": "jlund@mozilla.com"}, "7020": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-301 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "c86e503505709e3cf542a26f8ad5748f009bbf13", "parents": ["7beb59bc3482523ad6811fd3984949204d763810"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-301 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "d63d18ded76d8c07f3616d552dd75a41f7610fb2", "parents": ["c86e503505709e3cf542a26f8ad5748f009bbf13"], "tags": []}], "date": 1491922725, "git_changesets": [null, null], "user": "ffxbld"}, "7021": {"changesets": [{"author": "tbirdbld", "branch": "THUNDERBIRD5201_2017041113_RELBRANCH", "desc": "Automated checkin: version bump for thunderbird 52.0.1 release. DONTBUILD CLOSED TREE a=release", "files": ["config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "23d11e49363535e209da46998af679aae086acf7", "parents": ["1970761a6677e76a55dfed1a45bc0f1d77dc4851"], "tags": ["THUNDERB