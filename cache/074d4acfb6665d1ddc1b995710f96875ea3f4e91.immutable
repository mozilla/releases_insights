urce/zoneinfo64.txt", "js/src/builtin/IntlTimeZoneData.h", "js/src/tests/Intl/DateTimeFormat/timeZone_backward_links.js", "js/src/tests/Intl/DateTimeFormat/timeZone_backzone.js", "js/src/tests/Intl/DateTimeFormat/timeZone_backzone_links.js", "js/src/tests/Intl/DateTimeFormat/timeZone_notbackward_links.js"], "git_node": null, "git_parents": [null], "node": "35496444b38079b1249a3b4a8f225fbdd24161a3", "parents": ["6913f0537208fe4f20236048b243cb5987df8542"], "tags": []}, {"author": "Alexander Surkov \u003csurkov.alexander@gmail.com\u003e", "branch": "default", "desc": "Bug 1342433 - onclick changes shouldn't recreate the tree. r=yzen, a=jcristau", "files": ["accessible/base/nsAccessibilityService.cpp", "accessible/tests/browser/e10s/browser_treeupdate_listener.js", "accessible/tests/mochitest/treeupdate/test_bug1175913.html", "accessible/tests/mochitest/treeupdate/test_textleaf.html"], "git_node": null, "git_parents": [null], "node": "f1653d8df3a4d14a7cc7fc970cd43ae6040b1d36", "parents": ["35496444b38079b1249a3b4a8f225fbdd24161a3"], "tags": []}, {"author": "Eric Rahm \u003cerahm@mozilla.com\u003e", "branch": "default", "desc": "Bug 1349719 - Share max capacity logic in nsTString. r=froydnj, a=jcristau\n\nThis refactors the max capacity logic so that both |MutatePrep| and |Adopt| can\nshare it.\n\nMozReview-Commit-ID: CMn4kiAoWub", "files": ["xpcom/string/nsTSubstring.cpp", "xpcom/string/nsTSubstring.h"], "git_node": null, "git_parents": [null], "node": "64495dfa29db66c7768e94438a7f0ddea6a4747b", "parents": ["f1653d8df3a4d14a7cc7fc970cd43ae6040b1d36"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1350783 - Support bitmaps fonts in gfxFcPlatformFontList. r=jfkthame, a=jcristau\n\nMozReview-Commit-ID: 4VQkyhx4IJE", "files": ["gfx/skia/skia/src/ports/SkFontHost_cairo.cpp", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxFontEntry.h"], "git_node": null, "git_parents": [null], "node": "26cd34db3c140b83e4bc15fa6f332fd26f29947e", "parents": ["64495dfa29db66c7768e94438a7f0ddea6a4747b"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1352926 - Make sure to check the right character for being semicolon or comma. r=farre, a=dveditz\n\nMozReview-Commit-ID: DOb1qYb8Tz4", "files": ["dom/base/nsContentSink.cpp"], "git_node": null, "git_parents": [null], "node": "6cd77a0d7ac0b5d3ec993cb955157c1095136163", "parents": ["26cd34db3c140b83e4bc15fa6f332fd26f29947e"], "tags": []}], "date": 1491525916, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7009": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-369 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "115aeacf1e82a052d7e8417fd3b9be84dba8c4e2", "parents": ["6cd77a0d7ac0b5d3ec993cb955157c1095136163"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-369 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "d2e75c8d6904c81594e16b892e5da9ddb2ee9461", "parents": ["115aeacf1e82a052d7e8417fd3b9be84dba8c4e2"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-369 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "e0962c0504c3f268fea08d452014c05cb0a1a2bd", "parents": ["d2e75c8d6904c81594e16b892e5da9ddb2ee9461"], "tags": []}], "date": 1491579352, "git_changesets": [null, null, null], "user": "ffxbld"}, "7010": {"changesets": [{"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1354224 - Upgrade to Mercurial 4.1.2. r=dustin, a=lizzard\n\nThis is a pretty straightforward change. Just bumping package versions\nand hashes.\n\nMozReview-Commit-ID: CaVjM0JHYKi", "files": ["testing/docker/recipes/install-mercurial.sh"], "git_node": null, "git_parents": [null], "node": "08ed743024941f4e0306638008872152a032dfb7", "parents": ["e0962c0504c3f268fea08d452014c05cb0a1a2bd"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1354625 - Use mozilla-unified for single_locale try builds upstream. r=aki, a=NPOTB\n\nI think I initially defined these and I think I know why I used\nmozilla-central (it had to do with try not advertising bundles and\nmozilla-unified being generaldelta when other repos were not). Those\nreasons are no longer valid and we should be using mozilla-unified\neverywhere.\n\nMozReview-Commit-ID: CFaZspU6A5M", "files": ["testing/mozharness/configs/single_locale/try.py", "testing/mozharness/configs/single_locale/try_android-api-15.py"], "git_node": null, "git_parents": [null], "node": "0dfab14fffa1c22d84d951a628c614e156d3d22e", "parents": ["08ed743024941f4e0306638008872152a032dfb7"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1354625 - Use mozilla-unified for upstream for all Firefox builds. r=aki, a=NPOTB\n\nWithout the use of an upstream the first repo cloned on a machine will\nbe cached. If a subsequent job references a different repo, it may have\nto pull thousands of changesets because those changesets aren't part of\nthe initially-cloned repo. This is why the --upstream feature to\nrobustclone exists and is why it uses the mozilla-unified repo.\n\nThe mozilla-unified repo is a superset of central, aurora, beta, release,\netc. So by cloning it, you get changesets for all of the repos at the\ntime of the clone. When a subsequent job comes along and requests\na changeset from a different repo, you likely only need to fetch data\nfor a handful of changesets, not thousands.\n\nThis change adds the upstream url config for all fx_desktop_build jobs,\nensuring it is used. A redundant config entry for the try repo has been\nremoved as well.\n\nMozReview-Commit-ID: 3EL7aSXS4AG", "files": ["testing/mozharness/configs/builds/branch_specifics.py", "testing/mozharness/scripts/fx_desktop_build.py"], "git_node": null, "git_parents": [null], "node": "f4802fea742c8b2c7083135f71b4ab252cfa52dd", "parents": ["0dfab14fffa1c22d84d951a628c614e156d3d22e"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1343642 - Ensure to grab nsFrameSelection before calling its methods unless calling only const methods. r=smaug, a=abillings", "files": ["dom/html/HTMLInputElement.cpp", "layout/base/nsPresShell.cpp", "layout/generic/nsSelection.cpp"], "git_node": null, "git_parents": [null], "node": "a803be74843c16ca1b7841dc0318aa333e5ba915", "parents": ["f4802fea742c8b2c7083135f71b4ab252cfa52dd"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 1337392 - Only place cursor at textarea/input end if content was changed. r=smaug, a=jcristau\n\nMozReview-Commit-ID: CmlN9Pn97Nl", "files": ["layout/forms/nsTextControlFrame.cpp"], "git_node": null, "git_parents": [null], "node": "4ab6d5c43036602ca978833665453418104ce3a2", "parents": ["a803be74843c16ca1b7841dc0318aa333e5ba915"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 1337392 - Update test cases to match new cursor behavior. r=smaug, a=jcristau\n\nMozReview-Commit-ID: 4BdZyeqTBAx", "files": ["accessible/tests/mochitest/jsat/test_content_text.html", "accessible/tests/mochitest/states/test_inputs.html", "devtools/client/debugger/new/test/mochitest/browser_dbg-breakpoints-cond.js", "devtools/client/netmonitor/test/browser_net_resend.js", "dom/browser-element/mochitest/browserElement_SetInputMethodActive.js", "dom/html/test/test_bug613019.html", "editor/libeditor/tests/test_bug850043.html", "layout/base/tests/bug1082486-1.html", "layout/base/tests/bug646382-1-ref.html", "layout/base/tests/bug646382-2-ref.html", "layout/base/tests/bug664087-1-ref.html", "layout/base/tests/bug664087-2-ref.html", "layout/base/tests/bug956530-1.html", "layout/base/tests/input-maxlength-invalid-change.html", "layout/base/tests/input-maxlength-ui-invalid-change.html", "layout/base/tests/input-maxlength-ui-valid-change.html", "layout/base/tests/input-maxlength-valid-change.html", "layout/base/tests/input-minlength-invalid-change.html", "layout/base/tests/input-minlength-ui-invalid-change.html", "layout/base/tests/input-minlength-ui-valid-change.html", "layout/base/tests/input-minlength-valid-change.html", "layout/base/tests/textarea-maxlength-invalid-change.html", "layout/base/tests/textarea-maxlength-ui-invalid-change.html", "layout/base/tests/textarea-maxlength-ui-valid-change.html", "layout/base/tests/textarea-maxlength-valid-change.html", "layout/base/tests/textarea-minlength-invalid-change.html", "layout/base/tests/textarea-minlength-ui-invalid-change.html", "layout/base/tests/textarea-minlength-ui-valid-change.html", "layout/base/tests/textarea-minlength-valid-change.html", "layout/forms/test/bug287446_subframe.html", "layout/forms/test/test_bug353539.html", "layout/forms/test/test_bug534785.html", "layout/reftests/bugs/240933-1.html", "widget/tests/test_native_key_bindings_mac.html"], "git_node": null, "git_parents": [null], "node": "13f2d85da9a7d80ca4674f7d1b3c9e195d72e2c1", "parents": ["4ab6d5c43036602ca978833665453418104ce3a2"], "tags": []}, {"author": "Liang-Heng Chen \u003cxeonchen@gmail.com\u003e", "branch": "default", "desc": "Bug 1348841 - Switch on blocking mode for named-pipe only on windows. r=bagder, r=mayhemer, a=lizzard\n\nMozReview-Commit-ID: Gvm88q26VHK", "files": ["netwerk/socket/nsSOCKSIOLayer.cpp"], "git_node": null, "git_parents": [null], "node": "143d5fa98ef7bfd6e89f70211d210e1