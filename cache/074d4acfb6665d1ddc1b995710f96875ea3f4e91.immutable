patches, previously shared by a FilePicker or a DataTransfer event.", "files": ["dom/base/nsContentUtils.cpp", "dom/filesystem/FileSystemRequestParent.cpp", "dom/filesystem/FileSystemSecurity.cpp", "dom/filesystem/FileSystemSecurity.h", "dom/filesystem/FileSystemTaskBase.h", "dom/filesystem/FileSystemUtils.cpp", "dom/filesystem/FileSystemUtils.h", "dom/filesystem/GetDirectoryListingTask.cpp", "dom/filesystem/GetDirectoryListingTask.h", "dom/filesystem/GetFileOrDirectoryTask.cpp", "dom/filesystem/GetFileOrDirectoryTask.h", "dom/filesystem/GetFilesTask.cpp", "dom/filesystem/GetFilesTask.h", "dom/filesystem/compat/tests/test_basic.html", "dom/filesystem/compat/tests/test_formSubmission.html", "dom/filesystem/compat/tests/test_no_dnd.html", "dom/filesystem/moz.build", "dom/filesystem/tests/filesystem_commons.js", "dom/ipc/ContentParent.cpp", "dom/ipc/FilePickerParent.cpp", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/BackgroundParentImpl.h"], "git_node": null, "git_parents": [null], "node": "84b774afcf41e158a7e557e5848e976333c69ae5", "parents": ["263f278056898f6cff0b50d72c8fabc68093cfad"], "tags": []}], "date": 1490802506, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "6988": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 84b774afcf41 (bug 1344415) for bustage.", "files": ["dom/base/nsContentUtils.cpp", "dom/filesystem/FileSystemRequestParent.cpp", "dom/filesystem/FileSystemSecurity.cpp", "dom/filesystem/FileSystemSecurity.h", "dom/filesystem/FileSystemTaskBase.h", "dom/filesystem/FileSystemUtils.cpp", "dom/filesystem/FileSystemUtils.h", "dom/filesystem/GetDirectoryListingTask.cpp", "dom/filesystem/GetDirectoryListingTask.h", "dom/filesystem/GetFileOrDirectoryTask.cpp", "dom/filesystem/GetFileOrDirectoryTask.h", "dom/filesystem/GetFilesTask.cpp", "dom/filesystem/GetFilesTask.h", "dom/filesystem/compat/tests/test_basic.html", "dom/filesystem/compat/tests/test_formSubmission.html", "dom/filesystem/compat/tests/test_no_dnd.html", "dom/filesystem/moz.build", "dom/filesystem/tests/filesystem_commons.js", "dom/ipc/ContentParent.cpp", "dom/ipc/FilePickerParent.cpp", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/BackgroundParentImpl.h"], "git_node": null, "git_parents": [null], "node": "eb0dc59b106ee2365ca1e54e6c957165bb0e5c04", "parents": ["84b774afcf41e158a7e557e5848e976333c69ae5"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1344415. r=haik, a=jcristau\n\nEntries API gives access to the filesystem. With this patch we allow that only\nto patches, previously shared by a FilePicker or a DataTransfer event.", "files": ["dom/base/nsContentUtils.cpp", "dom/filesystem/FileSystemRequestParent.cpp", "dom/filesystem/FileSystemSecurity.cpp", "dom/filesystem/FileSystemSecurity.h", "dom/filesystem/FileSystemTaskBase.h", "dom/filesystem/FileSystemUtils.cpp", "dom/filesystem/FileSystemUtils.h", "dom/filesystem/GetDirectoryListingTask.cpp", "dom/filesystem/GetDirectoryListingTask.h", "dom/filesystem/GetFileOrDirectoryTask.cpp", "dom/filesystem/GetFileOrDirectoryTask.h", "dom/filesystem/GetFilesTask.cpp", "dom/filesystem/GetFilesTask.h", "dom/filesystem/compat/tests/test_basic.html", "dom/filesystem/compat/tests/test_formSubmission.html", "dom/filesystem/compat/tests/test_no_dnd.html", "dom/filesystem/moz.build", "dom/filesystem/tests/filesystem_commons.js", "dom/ipc/ContentParent.cpp", "dom/ipc/FilePickerParent.cpp", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/BackgroundParentImpl.h"], "git_node": null, "git_parents": [null], "node": "538e0b382cc2d764693da22ed6480b0bddf6a806", "parents": ["eb0dc59b106ee2365ca1e54e6c957165bb0e5c04"], "tags": []}], "date": 1490803954, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "6989": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump. CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "57ceb9ae21a6544133d15e2fed6daafa514e3f11", "parents": ["538e0b382cc2d764693da22ed6480b0bddf6a806"], "tags": []}, {"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "No bug - Tagging afa66bcf9203e691f164e5e8a9cc8fad783ccddc with FIREFOX_52_0_2esr_BUILD1, FIREFOX_52_0_2esr_RELEASE a=release CLOSED TREE", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "b9fc5211050d722b93be4c0fa22c044921f10dee", "parents": ["57ceb9ae21a6544133d15e2fed6daafa514e3f11"], "tags": []}], "date": 1490821131, "git_changesets": [null, null], "user": "ffxbld"}, "6990": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1280079 - Make sure browser_privatebrowsing_newtab_from_popup.js accounts for initial browser remoteness flip when opening popup. r=mossop, a=test-only\n\nDuring the test, we open a new window which loads a URL, and have code to wait for that\ninitial browser to complete the load. For the initial browser, there is (when we open\na remote-able URL), the remoteness of that initial browser flips from non-remote to\nremote. Sometimes, due to messaging / timing, the initial browser will send a message\nsaying that a load completed for the initial about:blank before the URL we actually\nwant is loaded. This causes the test to continue, and attempt to click on an element\nthat isn't actually on the page yet.\n\nThis modification allows us to wait for the initial browser to actually load the page\nthat we care about before proceeding.\n\nI also changed some of the assertion messages to actually reflect what's being asserted,\nas opposed to reflecting what is being revealed if the assertion fails.\n\nMozReview-Commit-ID: 608SaA1nCVs", "files": ["browser/components/privatebrowsing/test/browser/browser_privatebrowsing_newtab_from_popup.js"], "git_node": null, "git_parents": [null], "node": "6fbcb6a4b91e6b50524626118631078e9978898b", "parents": ["b9fc5211050d722b93be4c0fa22c044921f10dee"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1350683 - Ensure the transaction processing. r=masayuki, a=jcristau", "files": ["editor/libeditor/EditorBase.cpp"], "git_node": null, "git_parents": [null], "node": "a362e1205ba45ca4c96dca55d5e79914e168c7ea", "parents": ["6fbcb6a4b91e6b50524626118631078e9978898b"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1341960 - TextInputHandler shouldn't ignore InsertText() calls even if TextInputHandler has already dispatched keypress events and/or composition events for the key down but InsertText() is called again for inserting printable text. r=m_kato, a=jcristau\n\nKorean IME and some other simple IME may not use marked text at composing text.  Such IME modifies composing character with InsertText() with aReplacementRange.  Then, when\n user types new character, such IME may replace the previous character with a call of InsertText() with aReplacementRange and insert the next character with additional call of InsertText() without aReplacementRange.\n\nIn this case, InsertText() ignores the call when the native keydown event is already caused composition events.  However, we need to allow to dispatch keypress event for supporting to insert text even in such case.\n\nThis patch checks if inserting text is printable.  If it's not a printable character such as U+000A at pressing Enter, keeping current behavior.  Otherwise, dispatching keypress event instead.\n\nMozReview-Commit-ID: 5NcCgXfvniO", "files": ["widget/cocoa/TextInputHandler.mm"], "git_node": null, "git_parents": [null], "node": "b24ce30e8cfa1d7fe516bc7aeead23bad5ac544e", "parents": ["a362e1205ba45ca4c96dca55d5e79914e168c7ea"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1349276 - Paths received by FileSystemRequestParent need to be sanitized before passed to IsDescendantPath. r=haik, a=jcristau", "files": ["dom/filesystem/FileSystemSecurity.cpp"], "git_node": null, "git_parents": [null], "node": "ac40d4a4e4143961c33267aadb043c420141e52a", "parents": ["b24ce30e8cfa1d7fe516bc7aeead23bad5ac544e"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1342823 - Simplify the management of whether our document's frame request callbacks are scheduled. r=farre, a=jcristau", "files": ["dom/base/nsDocument.cpp", "dom/base/nsDocument.h", "dom/base/nsIDocument.h"], "git_node": null, "git_parents": [null], "node": "e469af8e9ccca161e8bca0a96a22e27fb2268ea8", "parents": ["ac40d4a4e4143961c33267aadb043c420141e52a"], "tags": []}, {"author": "Gerald Squelart \u003cgsquelart@mozilla.com\u003e", "branch": "default", "desc": "Bug 1351094 - Catch div/0 when hz==0 in MPEG4Extractor's unitsToUs. r=alfredo, a=jcristau\n\nMozReview-Commit-ID: KLgUg3UYiNQ", "files": ["media/libstagefright/frameworks/av/media/libstagefright/MPEG4Extractor.cpp"], "git_node": null, "git_parents": [null], "node": "4c1383e76adcd7e87d983c398547b787b0ded2f3", "parents": ["e469af8e9ccca161e8bca0a96a22e27fb2268ea8"], "tags": []}, {"author": "Gerald Squelart \u003cgsquelart@mozilla.com\u003e", "branch": "default", "desc": "Bug 1351094 - Add gtest. r=alfredo, a=jcristau\n\nMozReview-Commit-ID: 7n9ZYSO2ECF", "files": ["media/libstagefright/gtest/TestParser.cpp", "media/libstagefright/gtest/moz.build", "media/libstagefright/gtest/test_case_1351094.mp4"], "git_node": null, "git_parents": [null], "node": "371202fc44ae7ab8ff05b9f888c3eff167ae44ac", "parents": ["4c1383e76adcd7e87d983c398547b787b0ded2f3"], "tags": []}], "date": 1490839098, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "6991": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-303 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "dd5e698a9795017cc6a4c008d5ee50941b86071d", "parents": ["371202fc44ae7ab8ff05b9f888c3eff167ae44ac"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-303 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "870b4bc54a109378644ebc218db2eb0d50a7c612", "parents": ["dd5e698a9795017cc6a4c008d5ee50941b86071d"], "tags": []}], "date": 1490885849, "git_changesets": [null, null], "user": "ffxbld"}, "6992": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1336527 - Define RegisterIdlePeriod. r=baku, a=jcristau\n\nMozReview-Commit-ID: A41UJ6OHvP7", "files": ["dom/workers/WorkerThread.h"], "git_node": null, "git_parents": [null], "node": "b9f53baeabb3f89b4c17242cab8e27cbdc848231", "parents": ["870b4bc54a109378644ebc218db2eb0d50a7c612"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1345716 - Make default notification anchor icon be part of notification-icons.svg. r=johannh, a=jcristau\n\nMozReview-Commit-ID: FzYBHvYQlDN", "files": ["browser/themes/shared/notification-icons.inc.css", "browser/themes/shared/notification-icons.svg"], "git_node": null, "git_parents": [null], "node": "2569af645a98a51c0c5855b0dc283b5a8fd76311", "parents": ["b9f53baeabb3f89b4c17242cab8e27cbdc848231"], "tags": []}, {"author": "Blake Kaplan \u003cmrbkap@gmail.com\u003e", "branch": "default", "desc": "Bug 1208957 - Join the watchdog thread to avoid shutdown races. r=billm, a=jcristau\n\nMozReview-Commit-ID: FlnPO2fJWVu", "files": ["js/xpconnect/src/XPCJSContext.cpp"], "git_node": null, "git_parents": [null], "node": "2b68880d8f6b1a5636f0f672d27856ae16203598", "parents": ["2569af645a98a51c0c5855b0dc283b5a8fd76311"], "tags": []}, {"author": "Blake Kaplan \u003cmrbkap@gmail.com\u003e", "branch": "default", "desc": "Bug 1208957 - No need for a condvar for thread shutdown. r=billm, a=jcristau\n\nNow that we join on the thread exiting, we no longer need to have the thread\nexplicitly tell us it's shutting down.\n\nMozReview-Commit-ID: LycPjUvyeX", "files": ["js/xpconnect/src/XPCJSContext.cpp"], "git_node": null, "git_parents": [null], "node": "bc646835442bf9af795fa8fe88fe7414b6f30649", "parents": ["2b68880d8f6b1a5636f0f672d27856ae16203598"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1347944 - Uplift three cubeb crash fixes to ESR52. r=kinetik, a=jcristau\n\nThis is simply cherry picked from recent patches.\n\nMozReview-Commit-ID: LdcXcbTFxqL", "files": ["media/libcubeb/fix-crashes.patch", "media/libcubeb/src/cubeb_wasapi.cpp", "media/libcubeb/update.sh"], "git_node": null, "git_parents": [null], "node": "47cb652ddc257a6017145c1e84e8f5bb511b0905", "parents": ["bc646835442bf9af795fa8fe88fe7414b6f30649"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1347632 - Make RecordedSourceSurfaceCreation fallible. r=tobytailor, a=jcristau\n\nMozReview-Commit-ID: G4x3zTluGb4", "files": ["gfx/2d/RecordedEvent.cpp"], "git_node": null, "git_parents": [null], "node": "7d8f7a52a1086e2864c982a3fd5ba50b2030e40f", "parents": ["47cb652ddc257a6017145c1e84e8f5bb511b0905"], "tags": []}, {"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1336828 - Ignore the obsolete handler if the transform fails. r=erahm, a=jcristau", "files": ["dom/xslt/xslt/txExecutionState.cpp"], "git_node": null, "git_parents": [null], "node": "154c93b9435b7a41ea