re leftover from review of Bug 1320389. I must have forgotten to\nre-push to MozReview.\n\nMozReview-Commit-ID: ENTFdmCsv6I", "files": ["testing/marionette/action.js", "testing/marionette/assert.js"], "git_node": null, "git_parents": [null], "node": "52c9feec937e545e7e901957716096c895fb81ab", "parents": ["1be5aa3e9626fd34e1ce5a94e14f5edf01dbf8fa"], "tags": []}, {"author": "Maja Frydrychowicz \u003cmjzffr@gmail.com\u003e", "branch": "default", "desc": "Bug 1328726 - Make performActions and releaseActions blocking. r=ato, a=test-only\n\nNow the server response isn't sent until the command's Promise is\nresolved.\n\nMozReview-Commit-ID: LUdL6mZQ5jE", "files": ["testing/marionette/listener.js"], "git_node": null, "git_parents": [null], "node": "3046db97519e131777f073d5e3680e70f5d9cc42", "parents": ["52c9feec937e545e7e901957716096c895fb81ab"], "tags": []}, {"author": "Maja Frydrychowicz \u003cmjzffr@gmail.com\u003e", "branch": "default", "desc": "Bug 1328726 - (wdclient) Add actions endpoints, key actions API. r=ato, a=test-only\n\nMozReview-Commit-ID: CScEEaAgw0X", "files": ["testing/web-platform/tests/tools/webdriver/webdriver/client.py"], "git_node": null, "git_parents": [null], "node": "953312848de9cbc76cd4b12d846f4a9ff41c1b91", "parents": ["3046db97519e131777f073d5e3680e70f5d9cc42"], "tags": []}, {"author": "Maja Frydrychowicz \u003cmjzffr@gmail.com\u003e", "branch": "default", "desc": "Bug 1328726 - (wdclient) Add element property command, use value key. r=ato, a=test-only\n\nMozReview-Commit-ID: FZjSxRLV829", "files": ["testing/web-platform/tests/tools/webdriver/webdriver/client.py"], "git_node": null, "git_parents": [null], "node": "847ef3599faa75cec4a3387f571ccf21da865791", "parents": ["953312848de9cbc76cd4b12d846f4a9ff41c1b91"], "tags": []}, {"author": "Maja Frydrychowicz \u003cmjzffr@gmail.com\u003e", "branch": "default", "desc": "Bug 1328726 - Add server fixture to pytestrunner. r=ato, r=jgraham, a=test-only\n\nMozReview-Commit-ID: B64A6ZR2Sz8", "files": ["testing/web-platform/harness/wptrunner/executors/executormarionette.py", "testing/web-platform/harness/wptrunner/executors/pytestrunner/fixtures.py", "testing/web-platform/harness/wptrunner/executors/pytestrunner/runner.py", "testing/web-platform/meta/webdriver/navigation.py.ini"], "git_node": null, "git_parents": [null], "node": "15a1e8bc0dce808b80aeb1b7fb07db7e9c5d77ba", "parents": ["847ef3599faa75cec4a3387f571ccf21da865791"], "tags": []}, {"author": "Maja Frydrychowicz \u003cmjzffr@gmail.com\u003e", "branch": "default", "desc": "Bug 1328726 - Add web-platform wdspec tests for key actions. r=ato, r=jgraham, a=test-only\n\nMozReview-Commit-ID: LkfDqHujfOl", "files": ["testing/web-platform/tests/test_keys_wdspec.html", "testing/web-platform/tests/webdriver/actions.py", "testing/web-platform/tests/webdriver/support/__init__.py", "testing/web-platform/tests/webdriver/support/keys.py"], "git_node": null, "git_parents": [null], "node": "f98c4db03e53a7269053177644ec208510e71cde", "parents": ["15a1e8bc0dce808b80aeb1b7fb07db7e9c5d77ba"], "tags": []}, {"author": "Maja Frydrychowicz \u003cmjzffr@gmail.com\u003e", "branch": "default", "desc": "Bug 1328726 - Add wdspec test for emoji in key actions. r=ato, r=jgraham, a=test-only\n\nMozReview-Commit-ID: F4xyHqjCc87", "files": ["testing/web-platform/meta/MANIFEST.json", "testing/web-platform/tests/test_keys_wdspec.html", "testing/web-platform/tests/webdriver/actions.py"], "git_node": null, "git_parents": [null], "node": "17913deae97f5f5f63748fbdb3625630902449bc", "parents": ["f98c4db03e53a7269053177644ec208510e71cde"], "tags": []}, {"author": "Maja Frydrychowicz \u003cmjzffr@gmail.com\u003e", "branch": "default", "desc": "Bug 1328726 - Disable wdspec tests on linux64 debug. r=jgraham, a=test-only\n\nThe wdspec tests in contexts.py already fail silently on linux64\ndebug. The new actions tests also fail to start a webdriver session,\nalthough only intermittenly. When running the job on a one-click\nloaner, I can't tell if it's a browser crash with no crash dump\nor a run-time error in wptrunner. Perhaps there's a race wherein\nit takes longer to start a Marionette session and wptrunner\nstarts tests before Marionette is ready, all the tests fail and the\nbrowser gets killed.\n\nMozReview-Commit-ID: FoRbSZOhBUA", "files": ["testing/web-platform/meta/webdriver/actions.py.ini", "testing/web-platform/meta/webdriver/contexts.py.ini"], "git_node": null, "git_parents": [null], "node": "a1b92421760f87cc141ea33aa51e7206cf1d17df", "parents": ["17913deae97f5f5f63748fbdb3625630902449bc"], "tags": []}], "date": 1489174785, "git_changesets": [null, null, null, null, null, null, null, null], "user": "kwierso@gmail.com"}, "6936": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1345105 - Disable gnome-software-service on desktop1604-test. r=dustin, a=test-only\n\nMozReview-Commit-ID: I14cViRPsl8", "files": ["testing/docker/desktop1604-test/Dockerfile", "testing/docker/desktop1604-test/autostart/deja-dup-monitor.desktop", "testing/docker/desktop1604-test/autostart/gnome-software-service.desktop", "testing/docker/desktop1604-test/autostart/jockey-gtk.desktop", "testing/docker/desktop1604-test/deja-dup-monitor.desktop", "testing/docker/desktop1604-test/jockey-gtk.desktop"], "git_node": null, "git_parents": [null], "node": "61b73f70db9d894d2d71321e0cd143680ea459ca", "parents": ["a1b92421760f87cc141ea33aa51e7206cf1d17df"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1340718 - When the cubeb stream errors out while driving a MediaStreamGraph, fall back to a SystemClockDriver. r=jesup, a=sledru\n\nMozReview-Commit-ID: Co1UIuU7bCu", "files": ["dom/media/GraphDriver.cpp"], "git_node": null, "git_parents": [null], "node": "3aae8d9061626a300646fd5ea88c49f244bce0f8", "parents": ["61b73f70db9d894d2d71321e0cd143680ea459ca"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1343453 - Backport some upstream libevent fixes to our in-tree copy. r=billm, a=ritu\n\nFixes for upstream issues #317, #318, #332, and #335.", "files": ["ipc/chromium/src/third_party/libevent/README.mozilla", "ipc/chromium/src/third_party/libevent/buffer.c", "ipc/chromium/src/third_party/libevent/evdns.c", "ipc/chromium/src/third_party/libevent/evutil.c", "ipc/chromium/src/third_party/libevent/patches/backport-upstream-fixes.patch"], "git_node": null, "git_parents": [null], "node": "c5c236ff438c31fd9652ab4659d4113eef77f490", "parents": ["3aae8d9061626a300646fd5ea88c49f244bce0f8"], "tags": []}, {"author": "Mats Palmgren \u003cmats@mozilla.com\u003e", "branch": "default", "desc": "Bug 1343552 - Part 1: Invalidate the cached flow length when the next-in-flow/continuation changes. r=jfkthame, a=ritu\n\nMozReview-Commit-ID: Bz5YA60NY8I", "files": ["layout/generic/nsTextFrame.h"], "git_node": null, "git_parents": [null], "node": "3bc981f85a174364dd75d477d073128c6f397471", "parents": ["c5c236ff438c31fd9652ab4659d4113eef77f490"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1343552 - Part 2: Record attempted misuse of gfxSkipCharsIterator via a gfxCriticalError. r=mats, a=ritu\n\nMozReview-Commit-ID: CayLp1dGSnq", "files": ["gfx/thebes/gfxSkipChars.cpp"], "git_node": null, "git_parents": [null], "node": "4f752b0e592085b49b9c46aabec8820f2cd36932", "parents": ["3bc981f85a174364dd75d477d073128c6f397471"], "tags": []}], "date": 1489187186, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "6937": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-303 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "333717d07d2c6471bde515c9a352df3bab9e5de9", "parents": ["4f752b0e5920