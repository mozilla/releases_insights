135749fb1015661a2d0e057367a4b6a7", "parents": ["0617b074ec3d601800b3fd2d33f49ea0774dec6f"], "tags": []}, {"author": "Till Schneidereit \u003ctill@tillschneidereit.net\u003e", "branch": "default", "desc": "Bug 1339999 - Properly handle OOM during exception throwing in all Promise code. r=arai, a=jcristau\n\nMozReview-Commit-ID: 2uZgTZAKYnK", "files": ["js/src/builtin/Promise.cpp"], "git_node": null, "git_parents": [null], "node": "b7cb8f8b08777fabc50a3dc3ae4a387c41194e30", "parents": ["88466b91135749fb1015661a2d0e057367a4b6a7"], "tags": []}, {"author": "Cykesiopka \u003ccykesiopka.bmo@gmail.com\u003e", "branch": "default", "desc": "Bug 1350868 - Make HSTS preload script preload test domains for use in tests. r=keeler, a=jcristau\n\nThis lets us migrate off depending on real preloaded domains and onto\ndomains that are guaranteed to have the correct characteristics.\n\nMozReview-Commit-ID: 4TyOfdIA9I7", "files": ["security/manager/tools/getHSTSPreloadList.js"], "git_node": null, "git_parents": [null], "node": "ddd6c44790c0fb06b25b45f2133e1d7a4a3f68bf", "parents": ["b7cb8f8b08777fabc50a3dc3ae4a387c41194e30"], "tags": []}, {"author": "Michal Novotny \u003cmichal.novotny@gmail.com\u003e", "branch": "default", "desc": "Bug 1342360 - \"Crash in mozilla::net::WyciwygChannelParent::ActorDestroy\". r=valentin, a=jcristau", "files": ["netwerk/protocol/wyciwyg/WyciwygChannelParent.cpp"], "git_node": null, "git_parents": [null], "node": "416681a239ef83006a225d8931cda44bc698e52a", "parents": ["ddd6c44790c0fb06b25b45f2133e1d7a4a3f68bf"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1350844 - Don't add dead proxy zone edges for zones which are not being collected. r=sfink, a=jcristau\n\nMozReview-Commit-ID: 1ltJJCv2tg7", "files": ["js/src/jsgc.cpp"], "git_node": null, "git_parents": [null], "node": "a76e626ae6db6e241e49b3e7fa8bb483510df573", "parents": ["416681a239ef83006a225d8931cda44bc698e52a"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1348941. r=njn, a=jcristau", "files": ["image/encoders/bmp/nsBMPEncoder.cpp", "image/encoders/bmp/nsBMPEncoder.h", "image/encoders/ico/nsICOEncoder.cpp", "image/encoders/ico/nsICOEncoder.h"], "git_node": null, "git_parents": [null], "node": "39da731d80ed7beef4d4b5b7559de2673c3f2646", "parents": ["a76e626ae6db6e241e49b3e7fa8bb483510df573"], "tags": []}, {"author": "Daniel Stenberg \u003cdaniel@haxx.se\u003e", "branch": "default", "desc": "Bug 1346419 - Bail out on zero length data. r=valentin, a=jcristau\n\nSince we cannot call .First() on it and since it clearly contains\nnothing to show anyway!", "files": ["netwerk/streamconv/converters/nsIndexedToHTML.cpp"], "git_node": null, "git_parents": [null], "node": "1b148cf9c54518cdd2738bf39503ed44d2357a07", "parents": ["39da731d80ed7beef4d4b5b7559de2673c3f2646"], "tags": []}], "date": 1491270011, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "6999": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-319 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "0135e65f6b2c41a8e6ded74e72316e1e663bd273", "parents": ["1b148cf9c54518cdd2738bf39503ed44d2357a07"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-319 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "d6bc73ddeb580779cb8a2e25e37a2abb4addad5b", "parents": ["0135e65f6b2c41a8e6ded74e72316e1e663bd273"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-319 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "03fc1fdde1fcf8df30e28a9adeb2557685f78e26", "parents": ["d6bc73ddeb580779cb8a2e25e37a2abb4addad5b"], "tags": []}], "date": 1491317252, "git_changesets": [null, null, null], "user": "ffxbld"}, "7000": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1321228 - Part 1: Remove legacy generator from testing/marionette/. r=ato, a=test-only", "files": ["testing/marionette/driver.js"], "git_node": null, "git_parents": [null], "node": "e9ba51e2ea72102c92d9a27681cba56f25e26a4f", "parents": ["03fc1fdde1fcf8df30e28a9adeb2557685f78e26"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1321228 - Part 2: Remove legacy generator from testing/mochitest/. r=ato, a=test-only", "files": ["testing/mochitest/server.js", "testing/mochitest/tests/browser/browser_add_task.js"], "git_node": null, "git_parents": [null], "node": "4f43e401a7c1aa45e4bc08855c4016ddf6c729fd", "parents": ["e9ba51e2ea72102c92d9a27681cba56f25e26a4f"], "tags": []}], "date": 1491323354, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "7001": {"changesets": [{"author": "Andreas Tolfsen \u003cato@mozilla.com\u003e", "branch": "default", "desc": "Bug 1150527 - Remove error numbers from Marionette Python client; r=automatedtester, a=test-only\n\nMozReview-Commit-ID: IGAdxItviaz", "files": ["testing/marionette/client/marionette_driver/errors.py", "testing/marionette/harness/marionette_harness/tests/unit/test_errors.py", "testing/marionette/harness/marionette_harness/tests/unit/test_marionette.py"], "git_node": null, "git_parents": [null], "node": "4d6649bc5abe710ef4940c018575e7f96cd1da1f", "parents": ["4f43e401a7c1aa45e4bc08855c4016ddf6c729fd"], "tags": []}, {"author": "Andreas Tolfsen \u003cato@mozilla.com\u003e", "branch": "default", "desc": "Bug 1150527 - Remove unusued InstallGeckoError type; r=automatedtester, a=test-only\n\nIt does not appear to be used in m-c.\n\nMozReview-Commit-ID: EAr0g3VJNi4", "files": ["testing/marionette/client/marionette_driver/errors.py"], "git_node": null, "git_parents": [null], "node": "8a53091786468b8691f5989229e5ff85c17a7932", "parents": ["4d6649bc5abe710ef4940c018575e7f96cd1da1f"], "tags": []}, {"author": "Andreas Tolfsen \u003cato@mozilla.com\u003e", "branch": "default", "desc": "Bug 1333014 - Align element interaction errors with spec; r=whimboo a=test-only\n\nThis renames the ElementNotVisibleError to ElementNotInteractableError,\nand adds a new ElementClickInterceptedError.\n\nMozReview-Commit-ID: 6cjVghUCvyv", "files": ["testing/marionette/driver.js", "testing/marionette/error.js", "testing/marionette/event.js", "testing/marionette/interaction.js", "testing/marionette/listener.js", "testing/marionette/test_error.js"], "git_node": null, "git_parents": [null], "node": "a3148dd9d1a3cee537008f2e9b0164ea8598b4d4", "parents": ["8a53091786468b8691f5989229e5ff85c17a7932"], "tags": []}, {"author": "Andreas Tolfsen \u003cato@mozilla.com\u003e", "branch": "default", "desc": "Bug 1333014 - Introduce new exceptions to Python client; r=whimboo a=test-only\n\nThis adds the new errors ElementNotInteractableException and\nElementClickInterceptedException to the Marionette Python client.\n\nIt marks the ElementNotVisibleException as a deprecated, but does not\nremove it for to backwards compatibility concerns with the Firefox\nupgrade tests.\n\nMozReview-Commit-ID: GPSwMo0fHnk", "files": ["testing/marionette/client/marionette_driver/errors.py", "testing/marionette/harness/marionette_harness/tests/unit/test_accessibility.py", "testing/marionette/harness/marionette_harness/tests/unit/test_click.py", "testing/marionette/harness/marionette_harness/tests/unit/test_modal_dialogs.py", "testing/marionette/harness/marionette_harness/tests/unit/test_typing.py"], "git_node": null, "git_parents": [null], "node": "2ee9978ab49df1d8233dbfbba18503d70711182e", "parents": ["a3148dd9d1a3cee537008f2e9b0164ea8598b4d4"], "tags": []}, {"author": "Andreas Tolfsen \u003cato@mozilla.com\u003e", "branch": "default", "desc": "Bug 1333014 - Support intercepted clicks and align with spec; r=automatedtester,whimboo a=test-only\n\nThe WebDriver specification changed recently to introduce a new\n'element click intercepted' error that is returned if the high-level\nElement Click command attempts an element that is obscured by another\n(the other element's z-index, or order in the paint tree, is higher).\n\nThis patch introduces the notion of 'container elements', which is an\nelement's context.  For example, an \u003coption\u003e element's container element\nor context is the nearest ancestral \u003cselect\u003e or \u003cdatalist\u003e element.\n\nIt also makes a distinction between an element being pointer-interactable\nand merely being in-view.  This is important since an element may be in\nview but not pointer-interactable (i.e. clicking its centre coordinates\nmight be intercepted), and we do not want to wait for an element to\nbecome pointer-interactable after scrolling it into view if it is indeed\nobscured.\n\nMozReview-Commit-ID: 8dqGZP6UyOo", "files": ["testing/marionette/element.js", "testing/marionette/harness/marionette_harness/tests/unit/test_click.py", "testing/marionette/interaction.js"], "git_node": null, "git_parents": [null], "node": "3cd87c44307c6a74778bb384afcc6bc3a8be56e4", "parents": ["2ee9978ab49df1d8233dbfbba18503d70711182e"], "tags": []}, {"author": "Andreas Tolfsen \u003cato@mozilla.com\u003e", "branch": "default", "desc": "Bug 1333014 - Pretty-print HTML elements; r=maja_zf a=test-only\n\nWhen passing a DOM element that is an HTML element to error.pprint,\nit will get pretty-printed with its ID and class properties.\n\nThis helps to identify elements when one is obscuring the other when\nclicking. For example, the error message\n\n\tElement \u003cinput id=\"foo\"\u003e is obscured by \u003cinput id=\"bar\"\u003e\n\nis nicer than the old error message\n\n\tElement [object HTMLElement] {} is obscured by [object HTMLElement] {}\n\nMozReview-Commit-ID: 8U2Lo8V4lmv", "files": ["testing/marionette/element.js", "testing/marionette/error.js", "testing/marionette/test_error.js"], "git_node": null, "git_parents": [null], "node": "2e7778a2d409f18b467fe0e228d9005fc748e060", "parents": ["3cd87c44307c6a74778bb384afcc6bc3a8be56e4"], "tags": []}, {"author": "Andreas Tolfsen \u003cato@mozilla.com\u003e", "branch": "default", "desc": "Bug 1333014 - Remove unused element.isInteractable API; r=maja_zf a=test-only\n\nMozReview-Commit-ID: 5iBcHUeNmSN", "files": ["testing/marionette/element.js"], "git_node": null, "git_parents": [null], "node": "8f269d6bd9bdeb252d43b1ad712321646e8ffd11", "parents": ["2e7778a2d409f18b467fe0e228d9005fc748e060"], "tags": []}, {"author": "Andreas Tolfsen \u003cato@mozilla.com\u003e", "branch": "default", "desc": "Bug 1333014 - Change element.isDisconnected to take container; r=maja_zf a=test-only\n\nIt makes sense for element.isDisconnected to accept a container object\nwith frame and shadowRoot, instead of taking the shadowRoot as an optional\nthird argument, since this is what most consumers start out with.\n\nMozReview-Commit-ID: 6kfEIEf8u96", "files": ["testing/marionette/element.js"], "git_node": null, "git_parents": [null], "node": "cfd1ee014c32c94aece716310c15c88a1aebe6a3", "parents": ["8f269d6bd9bdeb252d43b1ad712321646e8ffd11"], "tags": []}, {"author": "Andreas Tolfsen \u003cato@mozilla.com\u003e", "branch": "default", "desc": "Bug 1333014 - Lint testing/marionette/element.js; r=maja_zf a=test-only\n\nNo functional changes.\n\nMozReview-Commit-ID: CK33FjpQMmO", "files": ["testing/marionette/element.js"], "git_node": null, "git_parents": [null], "node": "92b140933599fa723380cd2c0c8c507d2b3228b8", "parents": ["cfd1ee014c32c94aece716310c15c88a1aebe6a3"], "tags": []}, {"author": "Randell Jesup \u003crjesup@jesup.org\u003e", "branch": "default", "desc": "Bug 1353476 - Make InputObserver refcounted. r=drno, a=dveditz\n\nMozReview-Commit-ID: 9YULodfLBkq", "files": ["dom/media/systemservices/CamerasParent.cpp", "dom/media/systemservices/CamerasParent.h"], "git_node": null, "git_parents": [null], "node": "27493ca827822bb6341444b0c5cdfb65511537c2", "parents": ["92b140933599fa723380cd2c0c8c507d2b3228b8"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1350844 - Fix typoed variable name. r=sfink, a=NPOTB", "files": ["js/src/jsgc.cpp"], "git_node": null, "git_parents": [null], "node": "0ce4196ab86eda4354b8aafcb9cb8f3f4dd76950", "parents": ["27493ca827822bb6341444b0c5cdfb65511537c2"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1325841 - Fix hiding popup icon when navigating the browser. r=Felipe, a=jcristau\n\nMozReview-Commit-ID: AXBgxwb3Jt", "files": ["browser/base/content/browser.js", "browser/base/content/test/general/browser.ini", "browser/base/content/test/general/browser_popupUI.js", "browser/base/content/test/general/browser_popup_blocker.js", "browser/base/content/test/general/head.js", "browser/base/content/test/general/popup_blocker.html", "browser/base/content/test/popups/browser.ini", "browser/base/content/test/popups/browser_popupUI.js", "browser/base/content/test/popups/browser_popup_blocker.js", "browser/base/content/test/popups/popup_blocker.html", "browser/base/moz.build"], "git_node": null, "git_parents": [null], "node": "74e9f13c554fe3d75e388d0598c5d05892dfccc3", "parents": ["0ce4196ab86eda4354b8aafcb9cb8f3f4dd76950"], "tags": []}, {"author": "Daniel Stenberg \u003cdaniel@haxx.se\u003e", "branch": "default", "desc": "Bug 1344467 - Clear the format type for unknown types. r=valentin, a=lizzard\n\nTo make sure the last (unknown) entry is always -1.\n\nAlso, nsDirIndexParser::ParseFormat() must return OK even when bailing\nout early to not cause subsequent problems.", "files": ["netwerk/streamconv/converters/nsDirIndexParser.cpp"], "git_node": null, "git_parents": [null], "node": "d7d87adfe186580ae49e079a394d7f96eff751f2", "parents": ["74e9f13c554fe3d75e388d0598c5d05892dfccc3"], "tags": []}], "date": 1491345619, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7002": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 27493ca82782 (bug 1353476) for bustage.", "files": ["dom/media/systemservices/CamerasParent.cpp", "dom/media/systemservices/CamerasParent.h"], "git_node": null, "git_parents": [null], "node": "e8651b7e41c89a4a8354c2bfba6d10923a167ac3", "parents": ["d7d87adfe186580ae49e079a394d7f96eff751f2"], "tags": []}], "date": 1491346667, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7003": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-303 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "c66e2269ec31ba9d7ce4368b5e28b89e59fe3d90", "parents": ["e8651b7e41c89a4a8354c2bfba6d10923a167ac3"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-303 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "58467de2e53e94a8cdb29730e8ea47f7cb27a164", "parents": ["c66e2269ec31ba9d7ce4368b5e28b89e59fe3d90"], "tags": []}], "date": 1491405344, "git_changesets": [null, null], "user": "ffxbld"}, "7004": {"changesets": [{"author": "Cykesiopka \u003ccykesiopka.bmo@gmail.com\u003e", "branch": "default", "desc": "Bug 1350599 - Use guaranteed preloaded test domains instead of real domains in HSTS tests. r=keeler, a=test-only\n\nSome of our tests currently assume that certain real domains are HSTS preloaded.\nWhile most of the time these domains are in fact preloaded, this may change\nduring periods of maintenance or other events.\n\nTo avoid this, the changes here perform the following renames:\nbugzilla.mozilla.org -\u003e includesubdomains.preloaded.test\nlogin.persona.org -\u003e includesubdomains2.preloaded.test\nwww.torproject.org -\u003e noincludesubdomains.preloaded.test\n\nIn addition, some tests that refer to mozilla.com (but don't depend on it being\npreloaded) are made to refer to example.com instead to avoid referring to real\ndomains in tests.\n\nMozReview-Commit-ID: 3987moJnKGk", "files": ["security/manager/ssl/tests/unit/sss_readstate_child_worker.js", "security/manager/ssl/tests/unit/test_sss_readstate.js", "security/manager/ssl/tests/unit/test_sss_readstate_child.js", "security/manager/ssl/tests/unit/test_sss_readstate_empty.js", "security/manager/ssl/tests/unit/test_sss_savestate.js", "security/manager/ssl/tests/unit/test_sts_preloadlist_perwindowpb.js", "security/manager/ssl/tests/unit/test_sts_preloadlist_selfdestruct.js", "security/manager/ssl/tests/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "0af73defbea26649fecd30d42976bad2d970117b", "parents": ["58467de2e53e94a8cdb29730e8ea47f7cb27a164"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1351335 - Don't close software update dialog before restart. r=ato, a=test-only\n\nThere is no need to close this dialog given that a restart happens anyway.\nBut doing that as right now, and trying to invoke execute_script() on it,\nwill end up with a unlocatable window.\n\nMozReview-Commit-ID: 53yBLYsWX4o", "files": ["testing/firefox-ui/harness/firefox_ui_harness/testcases.py"], "git_node": null, "git_parents": [null], "node": "014a36bb27d82273b9cbd624969cd587a3db3e94", "parents": ["0af73defbea26649fecd30d42976bad2d970117b"], "tags": []}, {"author": "Patrick Brosset \u003cpbrosset@mozilla.com\u003e", "branch": "default", "desc": "Bug 1346424 - Wait for the button to become paused instead of the timeline-data-changed event. r=pbro, a=test-only\n\nMozReview-Commit-ID: 9xsx5gguspP", "files": ["devtools/client/animationinspector/test/browser_animation_timeline_pause_button_03.js"], "git_node": null, "git_parents": [null], "node": "5ede402f494fd5329a82cfc9fce72d402bec9fab", "parents": ["014a36bb27d82273b9cbd624969cd587a3db3e94"], "tags": []}, {"author": "Samael Wang \u003cfreesamael@gmail.com\u003e", "branch": "default", "desc": "Bug 1339722 - Check for mDoc after DispatchChromeEvent. r=smaug, a=jcristau", "files": ["dom/base/nsGlobalWindow.cpp", "dom/base/test/chrome/chrome.ini", "dom/base/test/chrome/test_bug1339722.html"], "git_node": null, "git_parents": [null], "node": "da44c5cfab2eba8418b496bfef1a25beed58fcfb", "parents": ["5ede402f494fd5329a82cfc9fce72d402bec9fab"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1344368 - Upgrade ESR52 to NSS 3.28.4. a=jcristau", "files": ["old-configure.in", "security/nss/TAG-INFO", "security/nss/coreconf/coreconf.dep", "security/nss/gtests/util_gtest/manifest.mn", "security/nss/gtests/util_gtest/util_b64_unittest.cc", "security/nss/gtests/util_gtest/util_gtest.gyp", "security/nss/lib/freebl/blapi.h", "security/nss/lib/freebl/drbg.c", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/softkver.h", "security/nss/lib/ssl/ssl3con.c", "security/nss/lib/ssl/sslsock.c", "security/nss/lib/ssl/tls13con.c", "security/nss/lib/util/nssb64d.c", "security/nss/lib/util/nssb64e.c", "security/nss/lib/util/nssutil.h"], "git_node": null, "git_parents": [null], "node": "845da34e5bd820476bba0ba77f41fa65fdc7b958", "parents": ["da44c5cfab2eba8418b496bfef1a25beed58fcfb"], "tags": []}], "date": 1491429289, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7005": {"changesets": [{"author": "Randell Jesup \u003crjesup@jesup.org\u003e", "branch": "default", "desc":