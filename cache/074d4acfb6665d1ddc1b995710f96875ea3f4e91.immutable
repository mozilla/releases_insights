31630bd9db476e278c4a3006f7adab27df35965d", "parents": ["e755294c7b55e847281b8d915171a95c66aacb40"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1343446 - NativeKey::GetFollowingCharMessage() should ignore found message if PeekMessage(PM_REMOVE) retrieves different char message but the found odd char message was odd. r=m_kato, a=jcristau\n\nAccording to crash reports, we may find WM_CHAR whose wParam is 0 and scancode is 0xFF with a call of PeekMessage(PM_NOREMOVE) but we'll remove usual char message with a call of PeekMessage(PM_REMOVE).\n\nIn such case, we should ignore the found odd message and take the usual char message which was removed from the queue actually.\n\nMozReview-Commit-ID: Gw8LvCXxul", "files": ["widget/windows/KeyboardLayout.cpp"], "git_node": null, "git_parents": [null], "node": "29121ef1333136c566c9bbfcfe66f24792a0c49c", "parents": ["31630bd9db476e278c4a3006f7adab27df35965d"], "tags": []}], "date": 1489529330, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "6943": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-034 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "e1dcaa13cd1261c4deb93492723466c5a04b8e32", "parents": ["29121ef1333136c566c9bbfcfe66f24792a0c49c"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-034 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "0a1eb075263a7c2669e0383ae5f1ec090bfd0c5d", "parents": ["e1dcaa13cd1261c4deb93492723466c5a04b8e32"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-034 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "8d77a0620e68e3fc692b56c2050978dbbc3c3e5d", "parents": ["0a1eb075263a7c2669e0383ae5f1ec090bfd0c5d"], "tags": []}], "date": 1489590679, "git_changesets": [null, null, null], "user": "ffxbld"}, "6944": {"changesets": [{"author": "Blake Kaplan \u003cmrbkap@gmail.com\u003e", "branch": "default", "desc": "Bug 1345214 - Wait for the right pages to load. r=krizsa, a=test-only\n\nBecause we weren't waiting for the first, \"about:blank\" page to load, the first\n`waitForLoad` could trigger for about:blank. Rather than add an additional\n`waitForLoad` it's easier (and probably more future-proof) to just wait for\nthe right page to load.\n\nMozReview-Commit-ID: DZsMnlgRTa", "files": ["toolkit/components/remotebrowserutils/tests/browser/browser_RemoteWebNavigation.js"], "git_node": null, "git_parents": [null], "node": "971e7066eaa088569aa4bfec6d945503290811e7", "parents": ["8d77a0620e68e3fc692b56c2050978dbbc3c3e5d"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1247519 - Trigger mouse click twice in case the first click is overlooked. r=smaug, a=test-only", "files": ["dom/tests/mochitest/chrome/test_bug1224790-1.xul", "dom/tests/mochitest/chrome/test_bug1224790-2.xul"], "git_node": null, "git_parents": [null], "node": "5c90952bf75c87c8686ab474f4b3a07bf829f6d6", "parents": ["971e7066eaa088569aa4bfec6d945503290811e7"], "tags": []}, {"author": "Michael Layzell \u003cmichael@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1332166 - Wait for the clipboard to be updated before checking it. r=enndeakin, a=test-only\n\nMozReview-Commit-ID: Ea6jZCYjuaY", "files": ["dom/plugins/test/mochitest/test_copyText.html"], "git_node": null, "git_parents": [null], "node": "231d57130138bda23b12ca8963408fc7c1c054be", "parents": ["5c90952bf75c87c8686ab474f4b3a07bf829f6d6"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1344265 - Fix OOM bug in newExternalString testing function. r=bbouvier, a=test-only", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/jit-test/tests/basic/bug1344265.js"], "git_node": null, "git_parents": [null], "node": "405bba2d38b17db5cd28cc908dc388f4e03d726c", "parents": ["231d57130138bda23b12ca8963408fc7c1c054be"], "tags": []}], "date": 1489630838, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "6945": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-304 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "edb135524d35b8b2b9ec5700a704154f1dc2d3e6", "parents": ["405bba2d38b17db5cd28cc908dc388f4e03d726c"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-304 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "f2415416bddf9829d2cb789862de93c96893f061", "parents": ["edb135524d35b8b2b9ec5700a704154f1dc2d3e6"], "tags": []}], "date": 1489675144, "git_changesets": [null, null], "user": "ffxbld"}, "6946": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1330348 - Make pollForReadyState a shared method for navigation commands. r=ato, a=test-only\n\nAll navigation commands including get, goBack, goForward, and maybe others\nin the future should rely on the same method for fetching the readyState of\na document. As such prepare `pollForReadyState` and `get` for the upcoming\nusage.\n\nMozReview-Commit-ID: 5Y4U9dgM7uj", "files": ["testing/marionette/driver.js", "testing/marionette/listener.js"], "git_node": null, "git_parents": [null], "node": "b3a10f8056464027893eaf65b4a4c6f28747ea1c", "parents": ["f2415416bddf9829d2cb789862de93c96893f061"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1330348 - Make forward- and backward commands synchronous. r=ato, a=test-only\n\nBoth `goBack` and `goForward` commands should not return immediately,\nbut when the requested page has been fully loaded. To handle that a general\n`waitForPageUnloaded` method has been added, which will call\n`pollForReadyState` when necessary.\n\nSimilar to `get` the dispatcher cannot be used due to possible remoteness\nchanges. As such the driver has to poll the framescript until the page load\nhas been finished.\n\nMozReview-Commit-ID: 4F7Piymxwhs", "files": ["testing/marionette/driver.js", "testing/marionette/harness/marionette_harness/tests/unit/test_about_pages.py", "testing/marionette/harness/marionette_harness/tests/unit/test_navigation.py", "testing/marionette/harness/marionette_harness/www/frameset.html", "testing/marionette/harness/marionette_harness/www/xhtmlTest.html", "testing/marionette/listener.js"], "git_node": null, "git_parents": [null], "node": "867ab104af2ffde878a1390008dad61565a82215", "parents": ["b3a10f8056464027893eaf65b4a4c6f28747ea1c"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1345413 - Fallback to getpwuid() info when LOGNAME is not set when creating the XRemote mutex. r=froydnj a=jcristau", "files": ["toolkit/xre/nsAppRunner.cpp"], "git_node": null, "git_parents": [null], "node": "055d03b56e147429139d37b4d7e93de0fe3d61be", "parents": ["867ab104af2ffde878a1390008dad61565a82215"], "tags": []}], "date": 1489693563, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "6947": {"changesets": [{"author": "David Burns \u003cdburns@mozilla.com\u003e", "branch": "default", "desc": "Bug 1347658: Allow negative integers for Marionette pointerMove. r=maja_zf a=testonly\n\nW3C WebDriver spec had incorrectly described that we could only have\npositive integers when it should have been just Integers.\n\nMozReview-Commit-ID: CttUFKiav7q", "files": ["testing/marionette/action.js", "testing/marionette/test_action.js"], "git_node": null, "git_parents": [null], "node": "ba81987804c733a24d0fe4ea206647399e8c65de", "parents": ["055d03b56e147429139d37b4d7e93de0fe3d61be"], "tags": []}], "date": 1489707812, "git_changesets": [null], "user": "kwierso@gmail.com"}, "6948": {"changesets": [{"author": "Ehsan Akhgari \u003cehsan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1348168 - Disable Mozilla custom ImageBitmap extensions that didn't go through proper API review; r=bzbarsky a=dveditz", "files": ["dom/base/nsGlobalWindow.cpp", "dom/workers/WorkerScope.cpp", "modules/libpref/init/all.js"], "git_node": null, "git_parents": [null], "node": "0af82b157012ae9527d6f8e5b5db65ca05314c42", "parents": ["ba81987804c733a24d0fe4ea206647399e8c65de"], "tags": []}], "date": 1489724953, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "6949": {"changesets": [{"author": "Ehsan Akhgari \u003cehsan@mozilla.com\u003e", "branch": "FIREFOX_ESR_52_0_X_RELBRANCH", "desc": "Bug 1348168 - Disable Mozilla custom ImageBitmap extensions that didn't go through proper API review; r=bzbarsky a=dveditz", "files": ["dom/base/nsGlobalWindow.cpp", "dom/workers/WorkerScope.cpp", "modules/libpref/init/all.js"], "git_node": null, "git_parents": [null], "node": "4af7cd795eeef3bce2dd40d5a6e92d21304eaea1", "parents": ["dac467924a46c4bbff97c948bf4a7143dada2b19"], "tags": []}], "date": 1489725294, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "6950": {"changesets": [{"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1343524 - Split en-US beetmover config (m-r, m-esr* version) r=jlorenzo a=release DONTBUILD\n\nMozReview-Commit-ID: 8jYM7FqtwC2", "files": ["testing/mozharness/configs/beetmover/en_us.yml.tmpl", "testing/mozharness/configs/beetmover/en_us_build.yml.tmpl", "testing/mozharnes