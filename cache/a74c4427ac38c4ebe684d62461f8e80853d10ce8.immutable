ts commit b104d50d22f057c9abfc83c8dbbe9af9d219487b.\n\nRevert \"Bug 1993981 - Allow canceling cancelable and discardable tail-dispatched runnables. r=xpcom-reviewers,nika\"\n\nThis reverts commit b6c1a23845f4aea5d0b7f355b96eff91f5ed55db.\n\nRevert \"Bug 1993981 - Implement nsIDirectTaskDispatcher for MediaTrackGraphImpl. r=karlt\"\n\nThis reverts commit 73bbfc2af3db17a3c2026ae0c0bb96896fbf5764.\n\nRevert \"Bug 1993981 - Store ControlMessages as runnables. r=karlt\"\n\nThis reverts commit 00188974771053ee0b069f76d28e68a454ca72e9.\n", "files": ["dom/media/MediaDecoderStateMachineBase.cpp", "dom/media/MediaFormatReader.cpp", "dom/media/MediaManager.cpp", "dom/media/MediaTrackGraph.cpp", "dom/media/MediaTrackGraph.h", "dom/media/MediaTrackGraphImpl.h", "dom/media/gtest/TestAudioCallbackDriver.cpp", "dom/media/gtest/TestAudioDecoderInputTrack.cpp", "dom/media/gtest/TestAudioTrackGraph.cpp", "dom/media/gtest/TestDecodedStream.cpp", "dom/media/gtest/TestDeviceInputTrack.cpp", "dom/media/gtest/TestWebrtcTaskQueueWrapper.cpp", "dom/media/hls/HLSDemuxer.cpp", "dom/media/webcodecs/WebCodecsUtils.cpp", "dom/media/webrtc/jsapi/PeerConnectionCtx.cpp", "dom/media/webrtc/libwebrtcglue/VideoConduit.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcTaskQueueWrapper.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcTaskQueueWrapper.h", "media/webrtc/signaling/gtest/mediapipeline_unittest.cpp", "xpcom/tests/gtest/TestAutoOwningEventTarget.cpp", "xpcom/tests/gtest/TestDelayedRunnable.cpp", "xpcom/tests/gtest/TestStateMirroring.cpp", "xpcom/tests/gtest/TestTargetShutdownTask.cpp", "xpcom/tests/gtest/TestTaskQueue.cpp", "xpcom/threads/AbstractThread.cpp", "xpcom/threads/AbstractThread.h", "xpcom/threads/TaskDispatcher.h", "xpcom/threads/TaskQueue.cpp", "xpcom/threads/TaskQueue.h"], "git_node": "c4528230e80ec9a318df43b6e48d5795b76ce726", "git_parents": ["43b9a69350b3fa903482a7a48efdd1010a6810f8"], "node": "2d3ab410934704e1ca064c9adfc61a7883592568", "parents": ["b4bd9f39959911ec2956f246d6cd16893dfa13e1