nodpi  a=dmeehan\n\nMove the main Firefox wordmark text drawables to drawable-nodpi so\nthey use the same resource qualifier as the build-type overrides.\n\nThis ensures the channel-specific wordmarks properly override the\nmain resources and prevents the \"Preview\" wordmark from appearing\nin shipped builds.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321863\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322355\n", "files": ["mobile/android/fenix/app/src/main/res/drawable-nodpi/ic_wordmark_text_normal.xml", "mobile/android/fenix/app/src/main/res/drawable-nodpi/ic_wordmark_text_private.xml", "mobile/android/fenix/app/src/main/res/drawable/ic_wordmark_text_normal.xml", "mobile/android/fenix/app/src/main/res/drawable/ic_wordmark_text_private.xml"], "git_node": "6fddd65487d8f81a1ea93006e105c76091bcfd71", "git_parents": ["6edcf7976be8c066da86ced4b5e923a8bbf95eb0"], "node": "2dd38c4592068fe1618f06faa194a4e68830485e", "parents": ["e1b0484a38c32aabc438540aea7f31249d8011ba"], "tags": []}], "date": 1788265832, "git_changesets": ["6fddd65487d8f81a1ea93006e105c76091bcfd71"], "user": "dmeehan@mozilla.com"}, "28302": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 1ace7e56a446a26f61ef013ac6967e8186f47704 with FIREFOX_140_15_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "7588988ec48a7bd8c46eaf51b686b0998887acd1", "git_parents": ["b985b06942cd27773edf7afe748f81e0d0a14806"], "node": "ebf52938992a7488ecb3f65ab0214f310b1c70cb", "parents": ["78c3bd00f823d38ccc38c7ddb9ff6127b6ee10c8"], "tags": []}], "date": 1788265855, "git_changesets": ["7588988ec48a7bd8c46eaf51b686b0998887acd1"], "user": "ffxbld@lando.moz.tools"}, "28303": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067360 - Reserve room for the icon in the switcher's Proton panel items.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322382\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322442\n", "files": ["browser/themes/shared/urlbar.css"], "git_node": "1601f777178ee8e02fe4e474bcc70b296d5d7281", "git_parents": ["6fddd65487d8f81a1ea93006e105c76091bcfd71"], "node": "550f27ca26360b6f54fbd4d4d87a90f32375bf5a", "parents": ["2dd38c4592068fe1618f06faa194a4e68830485e"], "tags": []}], "date": 1788265935, "git_changesets": ["1601f777178ee8e02fe4e474bcc70b296d5d7281"], "user": "dmeehan@mozilla.com"}, "28304": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 713124d101dc6894cf32c6c7c4293cf46f79633f with FIREFOX_115_40_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "27f8f274985ca07f5d1ffae78eaacd70bab34990", "git_parents": ["7588988ec48a7bd8c46eaf51b686b0998887acd1"], "node": "cbf52bc6ccb7298d598b59cdaf8f12aa773133a2", "parents": ["ebf52938992a7488ecb3f65ab0214f310b1c70cb"], "tags": []}], "date": 1788265956, "git_changesets": ["27f8f274985ca07f5d1ffae78eaacd70bab34990"], "user": "ffxbld@lando.moz.tools"}, "28305": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 21a0961191033207dc167b842f6c251f337b0e54 with FIREFOX-ANDROID_155_0_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "67b955fb45ad610c987b95217e10d215e36afd1c", "git_parents": ["27f8f274985ca07f5d1ffae78eaacd70bab34990"], "node": "8c2cac5724ca69bd776b49dd263e5b0d66156722", "parents": ["cbf52bc6ccb7298d598b59cdaf8f12aa773133a2"], "tags": []}], "date": 1788266058, "git_changesets": ["67b955fb45ad610c987b95217e10d215e36afd1c"], "user": "ffxbld@lando.moz.tools"}, "28306": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2065438: Simplify annotations for 446100-1* reftests to just depend on useDrawSnapshot.  a=dmeehan\n\nThese reftests fail under WebRender (and have failed since WebRender\nwas enabled by default), due to WebRender having different rounding behavior\nwhen sampling image-pixels with a fractional devicePixelRatio.\n\nIn other words: ever since WebRender was enabled, these tests have\nonly passed with the drawSnapshot backend.  This patch codifies that\nexpectation more clearly.  This addresses an unexpected-pass\nperma-fail that we were getting on one drawSnapshot test\nconfiguration, due to formerly having an unnecessarily-complex combination\nof annotations.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322185\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322483\n", "files": ["layout/reftests/bugs/reftest.list"], "git_node": "ef6f3c106b86979db1f47d2efb6ed217cae0042d", "git_parents": ["1601f777178ee8e02fe4e474bcc70b296d5d7281"], "node": "4177b47af9dd31dfad01383b0f25b14114f0ceb1", "parents": ["550f27ca26360b6f54fbd4d4d87a90f32375bf5a"], "tags": []}], "date": 1788272349, "git_changesets": ["ef6f3c106b86979db1f47d2efb6ed217cae0042d"], "user": "dmeehan@mozilla.com"}, "28307": {"changesets": [{"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067903 - back out changesets related to newtab bundle during build  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322449\n", "files": [".gitignore", ".hgignore", "CLOBBER", "browser/extensions/moz.configure", "browser/extensions/newtab/.npmrc", "browser/extensions/newtab/addon-jar.mn", "browser/extensions/newtab/bin/try-runner.js", "browser/extensions/newtab/build-newtab-bundles.py", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/data/content/vendor.bundle.js", "browser/extensions/newtab/lib/cache.worker.js", "browser/extensions/newtab/moz.build", "browser