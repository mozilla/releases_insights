2b1567b4f89ef3d49a176fcc92222aae0"], "node": "2a0ef60ce9d4071c35e409ea8b176cbf5e5c776e", "parents": ["a8c3cd8b747359b5d53686bcf02ca38b04be454b"], "tags": []}], "date": 1787907819, "git_changesets": ["565c5182b1567b4f89ef3d49a176fcc92222aae0", "2e2901cbc35063ee9d3a0242cdc20fefabc65d34"], "user": "ffxbld@lando.moz.tools"}, "28262": {"changesets": [{"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064975 - Extend glean metrics networking.cookie_c* to 168  a=dmeehan\n\nThe cookie count and purge metrics expire at the end of Firefox 156. They are\nstill needed for the cookie jar size investigation.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321700\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321892\n", "files": ["netwerk/metrics.yaml"], "git_node": "ae083522042c109e423785809dad0a4ab8f8d324", "git_parents": ["2e2901cbc35063ee9d3a0242cdc20fefabc65d34"], "node": "2ca9ba039cdbfbc8c95e9f1defae187ad6494fed", "parents": ["2a0ef60ce9d4071c35e409ea8b176cbf5e5c776e"], "tags": []}], "date": 1787919906, "git_changesets": ["ae083522042c109e423785809dad0a4ab8f8d324"], "user": "dmeehan@mozilla.com"}, "28263": {"changesets": [{"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044550 - Fix verifyExternalLinksTest UI test  a=dmeehan\n\nThe `verifyExternalLinksTest` was flaking/failing intermittently due to live network delays.\nThe test tried to find the \"DuckDuckGo\" text in the rendered page content, so it genuinely waited for page to load. If the network was slow, it timed out and crashed waiting for the text to appear.\n\nTo avoid the network flakiness I swapped the external link to example.com instead of testing against the live production website.\n\nThe UI test successfully passed 100x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=84541  | Try ]]\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320929\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322033\n", "files": ["mobile/android/focus-android/app/src/androidTest/assets/htmlControls.html", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/WebControlsTest.kt"], "git_node": "30ad31155c01b27451da225930a8ffef7a72c834", "git_parents": ["ae083522042c109e423785809dad0a4ab8f8d324"], "node": "d9cb717ab398badad719ad1c8de61991dc57e540", "parents": ["2ca9ba039cdbfbc8c95e9f1defae187ad6494fed"], "tags": []}], "date": 1787919932, "git_changesets": ["30ad31155c01b27451da225930a8ffef7a72c834"], "user": "dmeehan@mozilla.com"}, "28264": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064703 - Copy fontconfig charset to gfxCharacterMap to allow sharing the map for non-OpenType fonts.  a=dmeehan\n\nInstead of directly using the fontconfig FcCharSet for legacy font formats,\ncopy the charset into a gfxCharacterMap so that it can be migrated to the\nshared font list and benefit from the lock-free lookups that supports.\n\n(This removes the only override of gfxFontEntry::TestCharacterMap, so that\nno longer needs to be a virtual method.)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321841\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322053\n", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxFontEntry.h"], "git_node": "6ec5df7d16ec325404c05322dca6ff11e7df0787", "git_parents": ["30ad31155c01b27451da225930a8ffef7a72c834"], "node": "36c0e13cdf713210ad54fad54621bf1d9ed7651c", "parents": ["d9cb717ab398badad719ad1c8de61991dc57e540"], "tags": []}], "date": 1787921543, "git_changesets": ["6ec5df7d16ec325404c05322dca6ff11e7df0787"], "user": "dmeehan@mozilla.com"}, "28265": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066655 - Export mozilla::RLBoxSoundTouch::clear() from lgpllibs for MinGW builds.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321748\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322067\n", "files": ["config/external/lgpllibs/lgpllibs.symbols"], "git_node": "59c7c57c3a1d364cb93957aa05d504a4e2ddb882", "git_parents": ["6ec5df7d16ec325404c05322dca6ff11e7df0787"], "node": "122d71578b5c6e257b0fda7fad28a360b9e76fc8", "parents": ["36c0e13cdf713210ad54fad54621bf1d9ed7651c"], "tags": []}], "date": 1787941183, "git_changesets": ["59c7c57c3a1d364cb93957aa05d504a4e2ddb882"], "user": "dmeehan@mozilla.com"}, "28266": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2067205. Don't verify the app-services version bump moz.yaml, it perma fails on beta.  a=dmeehan\n\nSince Fx156 went to beta and app-services switched to the release channel, the\nversion bump script stops with NotImplementedError, because it only handles\nnightly. The vendoring verification job runs it, so beta is perma orange.\n\nTo fix this orange we should just stop checking this moz.yaml. It isn't a useful\ncheck anyway, because there is no library being vendored into our tree here.\nmobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml says\nin its own header that application-services is not really vendored there. It skips\nevery vendoring step, and its one update-action bumps the app-services version in\nApplicationServices.kt to the newest build. Even on central the check isn't telling\nus anything, it just looks like it is: the script exits without doing anything as\nlong as no newer app-services build exists, and the first time one does it rewrites\nApplicationServices.kt and the job reports that as drift.\n\nWe create a new skip list just for this one, because neither of the existing states\nfits. Leaving it out of the expected-fail file means it has to pass, and on beta it\ncan't. Putting it in means it has to fail, and on central it mostly doesn't.\n\nWe want this list to stay at one ideally, so we strongly warn in the comments not\nto add to it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322021\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322042\n", "files": ["taskcluster/kinds/source-test/vendor-verify.yml", "taskcluster/scripts/misc/check-vendor-coverage.py"], "git_node": "2c7fff825fc2b51104bc3c8bda3ea4f42deb0637", "git_parents": ["59c7c57c3a1d364cb93957aa05d504a4e2ddb882"], "node": "ff3339906565ffbd3dc75786b48a3f284d0f8cce", "parents": ["122d71578b5c6e257b0fda7fad28a360b9e76fc8"], "tags": []}], "date": 1787941208, "git_changesets": ["2c7fff825fc2b51104bc3c8bda3ea4f42deb0637"], "user": "dmeehan@mozilla.com"}, "28267": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/feature/summarize/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-cs/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-el/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-es-rAR/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-es-rCL/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-eu/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-fr/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-hy-rAM/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ia/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ko/strings.xml", "mobile/andr