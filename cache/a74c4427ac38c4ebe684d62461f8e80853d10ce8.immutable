TBUILD", "files": [".hgtags"], "git_node": "f098aef4c97c1668ff4a0b905d476080ae4155c5", "git_parents": ["ee1f48209df890f93a2b8dffe2366f8e39aa9995"], "node": "6af5d3cadd3539586005cab84edd374df7c673af", "parents": ["fc219d06babd5ba90562b6322cdbed8bc038e06b"], "tags": []}], "date": 1788898221, "git_changesets": ["f098aef4c97c1668ff4a0b905d476080ae4155c5"], "user": "ffxbld@lando.moz.tools"}, "28419": {"changesets": [{"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050381 - Make credit card doorhanger keyboard focusable on initial submission\" for breaking WebAuthn  a=dmeehan\n\nThis reverts commit dab9d9770bdb2751045449f91dae92340da37928.\n\nWhile the commit intended to auto-focus credit card auto-fill prompts, it\nalso made password auto-fill prompts take focus away from the document.\n\nWebAuthn requests require focus to work correctly: Bug 2068858\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324164\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324321\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_keyboard.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/components/passwordmgr/LoginManagerPrompter.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser.toml", "toolkit/components/passwordmgr/test/browser/browser_doorhanger_keyboard.js", "toolkit/modules/PopupNotifications.sys.mjs"], "git_node": "642b11b51c75842b1181394f8472a38f0cf84eba", "git_parents": ["6fbdc4737ad04d8c3670e09e6facb5964ce752dd"], "node": "a39435b4a7d89668cc0327ac30c3d7ea73fc0a7a", "parents": ["50b230d196ffb154af4b2d5bda40d1e451b8721e"], "tags": []}], "date": 1788898344, "git_changesets": ["642b11b51c75842b1181394f8472a38f0cf84eba"], "user": "dmeehan@mozilla.com"}, "28420": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings tld-suffixes mobile-merino-manifest ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324428\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": "b97112c17e63910fe9b0a4f212c98d8f5add20d9", "git_parents": ["642b11b51c75842b1181394f8472a38f0cf84eba"], "node": "42c6c3ac8487c1173f4341d31c7e24f7da628742", "parents": ["a39435b4a7d89668cc0327ac30c3d7ea73fc0a7a"], "tags": []}], "date": 1788898486, "git_changesets": ["b97112c17e63910fe9b0a4f212c98d8f5add20d9"], "user": "dmeehan@mozilla.com"}, "28421": {"changesets": [{"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069211 - Discard onboarding cards that have an unexpected type  a=dmeehan\n\n`card-type` used to default to `default-browser` in `onboarding.fml.yaml`. When a configuration has a card type that can't be resolved, Nimbus builds a new card with the default value (`default-browser`). So a configuration still referring one of the card types removed in Bug 2060802 would add an extra card with the default browser type.\n\nThe `HorizontalPager` in `OnboardingScreen` keys each page by card type. So those extra cards with the same `default-browser` type makes Jetpack Compose compose the same key multiple times, which lead to a crash (Key \"DEFAULT_BROWSER\" was already used).\n\nThis patch makes `card-type` optional with a null default value. Cards without a type are discarded when mapping them to pages. So a misconfigured card is hidden instead of being treated as another type of card.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323634\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324283\n", "files": ["mobile/android/fenix/app/onboarding.fml.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/onboarding/view/OnboardingMapperTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingMapper.kt"], "git_node": "5a2d9c239535a7e7e034d466dc31079ae5a1d3fb", "git_parents": ["b97112c17e63910fe9b0a4f212c98d8f5add20d9"], "node": "0847fcb5bbc71c8cf1fc1a9d931947a2af12df3b", "parents": ["42c6c3ac8487c1173f4341d31c7e24f7da628742"], "tags": []}], "date": 1788917989, "git_changesets": ["5a2d9c239535a7e7e034d466dc31079ae5a1d3fb"], "user": "dmeehan@mozilla.com"}, "28422": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/browser/menu/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/browser/toolbar/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-es/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-fi/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-hu/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-pt-rBR/strings.xml", "mobile/android/android-components/components/compose/awesomebar/s