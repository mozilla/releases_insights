"parents": ["a06ca61fa60134d3c250d150a3cdc6c07e3be427"], "tags": []}], "date": 1788788179, "git_changesets": ["0f36174e7a44a7f8a6af5f3177204e287aac89e0"], "user": "ffxbld@lando.moz.tools"}, "28396": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a06ca61fa60134d3c250d150a3cdc6c07e3be427 with FIREFOX-ANDROID_156_0b4_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9bd885c206bbb718d93528a2f39db3e7d201080b", "git_parents": ["bc8f79da9ba113c4789ca083acdcf553a440c172"], "node": "73464dd92b00cd4760e466850c80e87aa60c0886", "parents": ["5c5ac6e6e87780c43cb313e5b16db5e1c87aeab2"], "tags": []}], "date": 1788788198, "git_changesets": ["9bd885c206bbb718d93528a2f39db3e7d201080b"], "user": "ffxbld@lando.moz.tools"}, "28397": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a06ca61fa60134d3c250d150a3cdc6c07e3be427 with DEVEDITION_156_0b4_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "d625c283e2fd2b0d84a0314780afab06320275aa", "git_parents": ["9bd885c206bbb718d93528a2f39db3e7d201080b"], "node": "37fae6f5240823cb43d1a893ab666aa32a30981b", "parents": ["73464dd92b00cd4760e466850c80e87aa60c0886"], "tags": []}], "date": 1788797254, "git_changesets": ["d625c283e2fd2b0d84a0314780afab06320275aa"], "user": "ffxbld@lando.moz.tools"}, "28398": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a06ca61fa60134d3c250d150a3cdc6c07e3be427 with FIREFOX_156_0b4_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "3bf8c40c86a15419b3e56feec6823903da8ecd58", "git_parents": ["d625c283e2fd2b0d84a0314780afab06320275aa"], "node": "103f8c26fe098e3a3295951d034e62057653d7fe", "parents": ["37fae6f5240823cb43d1a893ab666aa32a30981b"], "tags": []}], "date": 1788797351, "git_changesets": ["3bf8c40c86a15419b3e56feec6823903da8ecd58"], "user": "ffxbld@lando.moz.tools"}, "28399": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068378 - Dispatch pass-through OnDataAvailable to the main thread in nsHTTPCompressConv  a=dmeehan\n\nRead the data and hand it to do_OnDataAvailable() when a bounce is\nneeded; keep the direct pass-through otherwise.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322964\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323576\n", "files": ["netwerk/streamconv/converters/nsHTTPCompressConv.cpp"], "git_node": "d307da92eececd1659ced74253d27d853c96ccd7", "git_parents": ["0f36174e7a44a7f8a6af5f3177204e287aac89e0"], "node": "c0062346e5041df0bcfab88da0d562cb2054ed6b", "parents": ["6cffd1f66c6d331dc040ab88e16a0b7856a3a321"], "tags": []}], "date": 1788797956, "git_changesets": ["d307da92eececd1659ced74253d27d853c96ccd7"], "user": "dmeehan@mozilla.com"}, "28400": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067436: Don't allow the viewport cache for non-doc accessibles.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323141\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323949\n", "files": ["accessible/ipc/RemoteAccessible.cpp"], "git_node": "fdde86518f79c4f4f61eaf243ad1414b32d4ec7e", "git_parents": ["d307da92eececd1659ced74253d27d853c96ccd7"], "node": "c54b0d3b473c01c1bffaa17a09b94e942af87f65", "parents": ["c0062346e5041df0bcfab88da0d562cb2054ed6b"], "tags": []}], "date": 1788797985, "git_changesets": ["fdde86518f79c4f4f61eaf243ad1414b32d4ec7e"], "user": "dmeehan@mozilla.com"}, "28401": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2068442 - Make `EditorBase::InsertTextIntoTextNodeWithTransaction` not use `CompositionTransaction` if it's not caused by a composition change  a=dmeehan\n\n`insertText` command etc may be used during a composition and we need\nto handle them for the backward compatibility and compatibility with\nthe other browsers.\n\nHowever, we should not treat such coming commands as a part of\ncomposition. Therefore, we should make the related methods take\n`InputTextFor` and consider to make an `InsertTextTransaction` for\na text insertion not caused by a composition change.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323152\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323953\n", "files": ["editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorBase.h", "editor/libeditor/HTMLEditSubActionHandler.cpp", "editor/libeditor/HTMLEditor.cpp", "editor/libeditor/HTMLEditor.h", "editor/libeditor/TextEditSubActionHandler.cpp", "editor/libeditor/WhiteSpaceVisibilityKeeper.cpp", "editor/libeditor/WhiteSpaceVisibilityKeeper.h"], "git_node": "17ec54e9c318e7414ddf4aaa27a18d276c1fc853", "git_parents": ["fdde86518f79c4f4f61eaf243ad1414b32d4ec7e"], "node": "1b9aa09f5942343c3001596d013cecf26209d21d", "parents": ["c54b0d3b473c01c1bffaa17a09b94e942af87f65"], "tags": []}], "date": 1788798024, "git_changesets": ["17ec54e9c318e7414ddf4aaa27a18d276c1fc853"], "user": "dmeehan@mozilla.com"}, "28402": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062642 - Disable media.navigator.mediadatadecoder_av1_enabled pref on 156.  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324030\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "b00f221125fb4cde75e149d743675a427cf1784a", "git_parents": ["17ec54e9c318e7414ddf4aaa27a18d276c1fc853"], "node": "5fa6f8dcaa132286d36263274e2dfc1614e43c7f", "parents": ["1b9aa09f5942343c3001596d013cecf26209d21d"], "tags": []}], "date": 1788798112, "git_changesets": ["b00f221125fb4cde75e149d743675a427cf1784a"], "user": "dmeehan@mozilla.com"}, "28403": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2001265 - Enforce Local Network Access checks on notification icon loads  a=dmeehan\n\nNotification icon loads have no requesting node, so their LoadInfo has no\nbrowsing context and the parent IP address space resolved to Unknown, which\nmakes IsLocalOrPrivateNetworkAccess() false for any target. Read the address\nspace from the policy container instead, which Document::InitPolicyContainer\nalready propagates for exactly this reason, and share that resolution with\nthe two copies of it in nsHttpChannel.\n\nThese loads have no tab to anchor a permission prompt on, and can outlive the\npage that created the notification, so treat them like shared and service\nworker requests: never prompt, and only allow when the origin already has a\npersistent LNA permission.\n\nAlso add a regression test for the document CSP being applied to these loads.\nThat already works, since bug 1997282 moved icon decoding into the content\nprocess and the load carries the creating global's ClientInfo, but it is the\nother half of this bug and was untested.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319466\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323997\n", "files": ["dom/notification/test/mochitest/file_notification_icon_csp.html", "dom/notification/test/mochitest/file_notification_icon_csp_self.html", "dom/notification/test/mochitest/mochitest.toml", "dom/notification/test/mochitest/test_notification_icon_csp.html", "netwerk/base/LNAPermissionRequest.cpp", "netwerk/base/nsNetUtil.cpp", "netwerk/base/nsNetUtil.h", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/browser/browser.toml", "netwerk/test/browser/browser_test_local_network_access_notification.js", "netwerk/test/browser/page_notification_icon.html"], "git_node": "bf967fdeb8abe53672b887a1ed1e44d05025add7", "git_parents": ["b00f221125fb4cde75e149d743675a427cf1784a"], "node": "a9c196019dca60a8cb9ecf931f8fab4fc40b5efb", "parents": ["5fa6f8dcaa132286d36263274e2dfc1614e43c7f"], "tags": []}], "date": 1788798279, "git_changesets": ["bf967fdeb8abe53672b887a1ed1e44d05025add7"], "user": "dmeehan@mozilla.com"}, "28404": {"changesets": [{"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065636 - Simplify error handling branches in _importChanges  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322645\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323515\n", "files": ["services/settings/RemoteSettingsClient.sys.mjs"], "git_node": "a721cb68fd60c98f89bd3cbc81d98cf37c3d30b1", "git_parents": ["bf967fdeb8abe53672b887a1ed1e44d05025add7"], "node": "91335e0d6d21b8c340c45e4901832dd65659463a", "parents": ["a9c196019dca60a8cb9ecf931f8fab4fc40b5efb"], "tags": []}], "date": 1788798552, "git_changesets": ["a721cb68fd60c98f89bd3cbc81d98cf37c3d30b1"], "user": "dmeehan@mozilla.com"}, "28405": {"changesets": [{"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068952 - Handle verification failures consistently in _importChanges  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323231\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323518\n", "files": ["services/settings/RemoteSettingsClient.sys.mjs"], "git_node": "7c2c11d322c23dd34048b95b550b14deaaeeaa42", "git_parents": ["a721cb68fd60c98f89bd3cbc81d98cf37c3d30b1"], "node": "2b26b7743dbdc6d6863be1f4a4457fca8b048292", "parents": ["91335e0d6d21b8c340c45e4901832dd65659463a"], "tags": []}], "date": 1788798690, "git_changesets": ["7c2c11d322c23dd34048b95b550b14deaaeeaa42"], "user": "dmeehan@mozilla.com"}, "28406": {"changesets": [{"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2061327 - Uncache subtree of hidden accessible when it is coalesced.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319920\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324097\n", "files": ["accessible/base/NotificationController.cpp", "accessible/generic/DocAccessible.cpp"], "git_node": "ca372558af7ebdd26254dcdacb60c37f6ceeb0e5", "git_parents": ["7c2c11d322c23dd34048b95b550b14deaaeeaa42"], "node": "6d92a4a120ffb9a1d8bebe8b5ad18710ce2b6906", "parents": ["2b26b7743dbdc6d6863be1f4a4457fca8b048292"], "tags": []}], "date": 1788810538, "git_changesets": ["ca372558af7ebdd26254dcdacb60c37f6ceeb0e5"], "user": "dmeehan@mozilla.com"}, "28407": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2069250 - Restore effective persistence behavior on popup windows.  a=dmeehan\n\nDo it in a bit more straight-forward way than pre-regression, by just\nchecking the chrome flag before saving the persistent attribute.\n\nThis really undoes the purpose of the regressor, which was fixing issues\nwith bug 2054183 (since we go back to restoring the sizemode attribute\nfrom the xul store...).\n\nBut turns out that since then we've removed the window gap stuff that\ncaused that issue (plus even with the gaps we decided to remove the gaps\nfrom popups altogether), so we might not really care about that anymore.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323778\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324099\n", "files": ["toolkit/components/windowwatcher/test/browser_new_sized_window.js", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/AppWindow.h"], "git_node": "c6f6fcb2279140586776914c6495d823bf22ea49", "git_parents": ["ca372558af7ebdd26254dcdacb60c37f6ceeb0e5"], "node": "9cebcc0191e2d0c653fee6f04f85733483549225", "parents": ["6d92a4a120ffb9a1d8bebe8b5ad18710ce2b6906"], "tags": []}], "date": 1788811785, "git_changesets": ["c6f6fcb2279140586776914c6495d823bf22ea49"], "user": "dmeehan@mozilla.com"}, "28408": {"changesets": [{"author": "Release Engineering Landoscript \u003