 memory as initialized.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321124\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322389\n", "files": ["dom/canvas/WebGLTextureUpload.cpp", "dom/canvas/gtest/TestWebGLTextureUploadInit.cpp", "dom/canvas/gtest/moz.build"], "git_node": "4737eb8cc878298f8c7efcae332cae39746564bd", "git_parents": ["30ac4ea26283658048d11b4c938ddcba66f98562"], "node": "3ce737e17d9928bbb555c328e0b51fac5b072179", "parents": ["a41d5f6554ced3c2d4d06b09a1594b2ea6310b6a"], "tags": []}], "date": 1788213393, "git_changesets": ["4737eb8cc878298f8c7efcae332cae39746564bd"], "user": "dmeehan@mozilla.com"}, "28290": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2065646 - Unwrap about:reader URLs with ReaderMode.getOriginalUrl in WebsiteFilter.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321920\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322358\n", "files": ["browser/components/enterprisepolicies/helpers/WebsiteFilter.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser_policy_websitefilter.js", "browser/components/enterprisepolicies/tests/xpcshell/test_websitefilter.js"], "git_node": "5f9ee0149018f9337897d8134d9a2f510e78438f", "git_parents": ["4737eb8cc878298f8c7efcae332cae39746564bd"], "node": "bb5232b222c27ddc261ebf9d92910b37a7a321e2", "parents": ["3ce737e17d9928bbb555c328e0b51fac5b072179"], "tags": []}], "date": 1788213424, "git_changesets": ["5f9ee0149018f9337897d8134d9a2f510e78438f"], "user": "dmeehan@mozilla.com"}, "28291": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056051: Don't cancel the ImageDecoder read request from cycle-collection unlink  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318221\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322313\n", "files": ["dom/base/NodeIterator.cpp", "dom/media/webcodecs/ImageDecoder.cpp", "dom/media/webcodecs/ImageDecoder.h"], "git_node": "7cc73e96f0ab645d8f660e158e255de0ce3bf730", "git_parents": ["5f9ee0149018f9337897d8134d9a2f510e78438f"], "node": "53c59197a7282cfafcff4b865411d4f8ff80868b", "parents": ["bb5232b222c27ddc261ebf9d92910b37a7a321e2"], "tags": []}], "date": 1788213461, "git_changesets": ["7cc73e96f0ab645d8f660e158e255de0ce3bf730"], "user": "dmeehan@mozilla.com"}, "28292": {"changesets": [{"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065431 - Ensure sidebar visibility is restored after browser restart when 'Hide tabs and sidebar' option is enabled  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321688\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322309\n", "files": ["browser/components/sidebar/SidebarState.sys.mjs", "browser/components/sidebar/tests/browser/browser_launcher_hidden_restore.js", "browser/components/sidebar/tests/marionette/test_default_launcher_visible.py"], "git_node": "70798d12e2073a8741af5900dc6fdb3ce282541c", "git_parents": ["7cc73e96f0ab645d8f660e158e255de0ce3bf730"], "node": "2a153fc1a70f44b8bd248672a4141239fba77da9", "parents": ["53c59197a7282cfafcff4b865411d4f8ff80868b"], "tags": []}], "date": 1788213501, "git_changesets": ["70798d12e2073a8741af5900dc6fdb3ce282541c"], "user": "dmeehan@mozilla.com"}, "28293": {"changesets": [{"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2066505 - Clamp the opacity amount when compositing a picture.  a=dmeehan\n\nCSS opacity keyframes are computed unclamped so that additive animation can\ninterpolate out-of-range values, and nothing clamps the sampled value on its way\nto WebRender. The compositing quad's base color is multiplied by the source, so\nan amount above one scales the picture past the range of the target: hardware GL\nsaturates the fragment output, while SWGL wraps around and produces noise.\n\nbrush_opacity clamped the amount in its vertex shader. The port to the quad path\ndid not carry that over.\n\nAlso give wrench's opacity() filter an optional second argument that binds the\namount to a property, since a plain value above one is discarded as a no-op\nfilter and never reaches compositing.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321547\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322287\n", "files": ["gfx/wr/webrender/src/picture.rs", "gfx/wr/wrench/reftests/filters/opacity-out-of-range-ref.yaml", "gfx/wr/wrench/reftests/filters/opacity-out-of-range.yaml", "gfx/wr/wrench/reftests/filters/reftest.list", "gfx/wr/wrench/src/yaml_helper.rs"], "git_node": "37fa576336d015747e41e5876cab1ab9e7950b43", "git_parents": ["70798d12e2073a8741af5900dc6fdb3ce282541c"], "node": "d8df16b1bae85543497726850b2032b1baf8d682", "parents": ["2a153fc1a70f44b8bd248672a4141239fba77da9"], "tags": []}], "date": 1788213544, "git_changesets": ["37fa576336d015747e41e5876cab1ab9e7950b43"], "user": "dmeehan@mozilla.com"}, "28294": {"changesets": [{"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2054622 - WebRTC backport: PipeWire mmap improvements  a=dmeehan\n\nPipeWire: encapsulate mmap in ScopedBuf and fix mapoffset handling\nMove mmap into ScopedBuf::initialize so callers no longer manage mmap\nflags and cleanup directly. Use MAP_PRIVATE for read-only MemFd\nconsumers and MAP_SHARED for DmaBuf and read-write consumers. Fix\nscreen capture's double mapoffset application by passing the offset\nto mmap directly. Add AccessMode and BufferType enums for clarity\nand delete copy/move to prevent double-munmap.\n\nPipeWire: validate fd backing size before mmap\nValidate that the fd actually backs the requested mapping range\nby calling fstat and checking mapoffset + maxsize \u003c= st_size\nbefore mmap, matching what PipeWire does in its own memory pool\n(src/pipewire/mem.c). Skip the check for DmaBuf fds where fstat\ndoes not reliably report the buffer size.\n\nThis is a simple backport of WebRTC upstream changes.\n\nUpstream commits:\nc84dbe590a5519bc1404a268dd8816088ffe8980\n5c10f93376c1e9f0ff339bd1facf5b6d7d978f25\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321791\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322290\n", "files": ["third_party/libwebrtc/modules/desktop_capture/linux/wayland/shared_screencast_stream.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/test/test_egl_dmabuf.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/test/test_screencast_stream_provider.cc", "third_party/libwebrtc/modules/portal/pipewire_utils.cc", "third_party/libwebrtc/modules/portal/pipewire_utils.h", "third_party/libwebrtc/modules/video_capture/linux/video_capture_pipewire.cc", "third_party/libwebrtc/moz-patch-stack/5c10f93376.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/c84dbe590a.no-op-cherry-pick-msg"], "git_node": "9fe214f389246aa1dff6966472bbb72611a8ebf6", "git_parents": ["37fa576336d015747e41e5876cab1ab9e7950b43"], "node": "6fc50dd966de2fed0e7e2b9f9b46e3eeee9d5a74", "parents": ["d8df16b1bae85543497726850b2032b1baf8d682"], "tags": []}], "date": 1788213707, "git_changesets": ["9fe214f389246aa1dff6966472bbb72611a8ebf6"], "user": "dmeehan@mozilla.com"}, "28295": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a2e949393afd57efbc77b783d374552d5fa52d06 with DEVEDITION_156_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "aa8f489b7e4d68c3ba8d75a885fb2a364f11f429", "git_parents": ["bc49288c185b52e0c61c09fe69ec6b65b38e8249"], "node": "50d25725e66570c8b59b3d3f00b093af22b296c6", "parents": ["6d712e3df739128df927381350c9edebba8e79b0"], "tags": []}], "date": 1788213988, "git_changesets": ["aa8f489b7e4d68c3ba8d75a885fb2a364f11f429"], "user": "ffxbld@lando.moz.tools"}, "28296": {"changesets": [{"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2066412 - Switch SmartBar result menu to panel-list.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321809\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322441\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs"], "git_node": "31bd771d35f60f29225a83e70cd3479c8a948d75", "git_parents": ["9fe214f389246aa1dff6966472bbb72611a8ebf6"], "node": "668705e5099ab7c816cb021af74793a95806fe97", "parents": ["6fc50dd966de2fed0e7e2b9f9b46e3eeee9d5a74"], "tags": []}], "date": 1788214073, "git_changesets": ["31bd771d35f60f29225a83e70cd3479c8a948d75"], "user": "dmeehan@mozilla.com"}, "28297": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-es-rES/strings.xml", "mobile/android/android-components/components/feature/contextmenu/src/main/res/values-es-rES/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-es-rES/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-es-rES/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-tr/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-vi/strings.xml", "mobile/android/fenix/app/src/main/res/values-ab/strings.xml", "mobile/android/fenix/app/src/main/res/values-am/strings.xml", "mobile/android/fenix/app/src/main/res/values-an/strings.xml", "mobile/android/fenix/app/src/main/res/values-ar/strings.xml", "mobile/android/fenix/app/src/main/res/values-ast/strings.xml", "mobile/android/fenix/app/src/main/res/values-azb/strings.xml", "mobile/android/fenix/ap