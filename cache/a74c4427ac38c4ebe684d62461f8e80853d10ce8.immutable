9b55e7f3a474c58dc931292b337\nsv-SE -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\nta -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\nte -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\nth -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\ntl -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\ntr -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\ntrs -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\nuk -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\nur -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\nuz -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\nvi -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\nwo -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\nxh -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\nzam -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\nzh-CN -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\nzh-TW -\u003e 4d5641c15b3879b55e7f3a474c58dc931292b337\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "4db9b981bdd6eeb4e82ba49abc7b6057459f009c", "git_parents": ["26f4b0135d92c58ade0a713ebfa8d6a501b634ff"], "node": "1843c334bbc882c56aff7f91b56af53a6ea16f88", "parents": ["c76f60d70e950d322c45d97e8bc8a088d92c27b7"], "tags": []}], "date": 1788858284, "git_changesets": ["26f4b0135d92c58ade0a713ebfa8d6a501b634ff", "4db9b981bdd6eeb4e82ba49abc7b6057459f009c"], "user": "ffxbld@lando.moz.tools"}, "28410": {"changesets": [{"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065505 - Keyboard scroll the root scroll container from fixed-pos frames.  a=dmeehan\n\nA frame fixed with respect to the viewport is a child of the viewport frame, so\nwalking up the ancestor chain from it skips over the root scroll container\nframe and finds nothing to scroll.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320779\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324153\n", "files": ["layout/base/nsLayoutUtils.cpp", "layout/base/tests/mochitest.toml", "layout/base/tests/test_keyboard_scroll_from_fixed_pos.html"], "git_node": "de65790ef49360b95cf1eb91d4a20aaf618066c9", "git_parents": ["4db9b981bdd6eeb4e82ba49abc7b6057459f009c"], "node": "ebe50b8bf3ce749a0ca8784771e2dcc97861a7b4", "parents": ["1843c334bbc882c56aff7f91b56af53a6ea16f88"], "tags": []}], "date": 1788872978, "git_changesets": ["de65790ef49360b95cf1eb91d4a20aaf618066c9"], "user": "dmeehan@mozilla.com"}, "28411": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2061489 - Make `KeymapWrapper::InitKeyEvent` set `.mKeyNameIndex` to `KEY_NAME_INDEX_USE_STRING` if `aCommitCharReceivedByIMContext` is not void  a=dmeehan\n\nWhen `aCommitCharReceivedByIMContext` is not void, it means that the key\nintroduced the string with a commit signal. Therefore, its `.key`\nshould be set to the string.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323547\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324205\n", "files": ["widget/gtk/nsGtkKeyUtils.cpp"], "git_node": "f8d0cf5bb9d0a80e951208e8c8648d39bdb55d7d", "git_parents": ["de65790ef49360b95cf1eb91d4a20aaf618066c9"], "node": "1e26e7319f56d635ee04d73066cffa33878d72a9", "parents": ["ebe50b8bf3ce749a0ca8784771e2dcc97861a7b4"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2061489 - Make `IMContextWrapper::CommitCompositionNative` not dispatch `eKeyDown` event if we've already dispatched  a=dmeehan\n\n`IMContextWrapper::CommitCompositionNative` started to dispatch\n`eKeyDown` and `eKeyPress` as far as possible for Microsoft Word's bug.\nHowever, we should not do that for a special case. That is, IME may\nsend canceling composition first, then, send `commit` signal without\nanother composing state during a call of\n`gtk_im_context_filter_keypress`. The reason is, some web apps may\ncount `keydown` events and that may be important for them (e.g.,\ntyping test apps). Therefore, this patch makes `CommitCompositionNative`\ntreats the commit composition without composing state as an input\nwithout a key press after we've already dispatched `eKeyDown`.\n\nNote that this is the traditional behavior before bug 2051354 even\nthough the old code didn't check `mKeyboardEventWasDispatched`.\nhttps://searchfox.org/firefox-main/source/widget/gtk/IMContextWrapper.cpp#1991,2003,2013,2019,2036,2040\n(not matching the `keyval` and `commitString`, `mMaybeInDeadKeySequence`\nwas set to `false` at dispatching the composition commit event for the\npreceding composition cancel and there is `mProcessingKeyEvent`, so,\n`DispatchCompositionCommitEvent()` was used.)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323805\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324206\n", "files": ["widget/gtk/IMContextWrapper.cpp"], "git_node": "3bd471dc2b2c4b609269350ea53d65deb3ae3ace", "git_parents": ["f8d0cf5bb9d0a80e951208e8c8648d39bdb55d7d"], "node": "93c37c894dba7687dcb18a08e26bb2b73e85dd67", "parents": ["1e26e7319f56d635ee04d73066cffa33878d72a9"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2069698 - Make `IMContextWrapper::OnCommitCompositionNative` use `eKeyDown` event if DOM `Ctrl`, `Alt` or `Meta` is pressed and the commit string is the same as the key  a=dmeehan\n\nIME may send `commit` signal without the composing state when\nuser presses `Super` or something. Then, if the commit string is the\nsame as the character introduced by the key press, the user may want\nto use a shortcut key or an access key. Therefore, we need to dispatch\n`eKeyDown` instead of composition events or a content event with\n`Process` `eKeyDown` since the global key handler needs to handle the\nkey event as a shortcut key.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323946\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324207\n", "files": ["widget/gtk/IMContextWrapper.cpp"], "git_node": "d6029c373278f314cc39f009b4b7cf1cb9a498de", "git_parents": ["3bd471dc2b2c4b609269350ea53d65deb3ae3ace"], "node": "e3ebac2f870d08825a1ba492f576c2a123ab3a5e", "parents": ["93c37c894dba7687dcb18a08e26bb2b73e85dd67"], "tags": []}], "date": 1788873042, "git_changesets": ["f8d0cf5bb9d0a80e951208e8c8648d39bdb55d7d", "3bd471dc2b2c4b609269350ea53d65deb3ae3ace", "d6029c373278f314cc39f009b4b7cf1cb9a498de"], "user": "dmeehan@mozilla.com"}, "28412": {"changesets": [{"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069284 - Use a per-list minimum_wait_duration for google5 updates.  a=dmeehan\n\nThe V5 protocol sends a minimum_wait_duration per table, but we only\nuse the duration of the last table to schedule the next update, which\ncould be wrong if the duration is longer or shorter than others.\n\nThis patch fixes this issue. The nextUpdateTime pref will contain the\nearliest update time among updated tables. And we use per-list pref to\nstore the update time for tables that have later time than the earliest\ntable. We schedule the timer according to the earliest update time and\nskip those tables that are not expired.\n\nWe also updates relevant tests for this change.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323990\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324236\n", "files": ["toolkit/components/reputationservice/test/unit/test_app_rep.js", "toolkit/components/reputationservice/test/unit/test_app_rep_maclinux.js", "toolkit/components/reputationservice/test/unit/test_app_rep_windows.js", "toolkit/components/url-classifier/Entries.h", "toolkit/components/url-classifier/ProtocolParser.cpp", "toolkit/components/url-classifier/ProtocolParser.h", "toolkit/components/url-classifier/UrlClassifierListManager.sys.mjs", "toolkit/components/url-classifier/nsIUrlClassifierDBService.idl", "toolkit/components/url-classifier/nsIUrlClassifierTestUtils.idl", "toolkit/components/url-classifier/nsUrlClassifierDBService.cpp", "toolkit/components/url-classifier/nsUrlClassifierDBService.h", "toolkit/components/url-classifier/nsUrlClassifierProxies.cpp", "toolkit/components/url-classifier/nsUrlClassifierProxies.h", "toolkit/components/url-classifier/nsUrlClassifierStreamUpdater.cpp", "toolkit/components/url-classifier/nsUrlClassifierTestUtils.cpp", "toolkit/components/url-classifier/tests/gtest/TestProtocolParser.cpp", "toolkit/components/url-classifier/tests/unit/head_urlclassifier.js", "toolkit/components/url-classifier/tests/unit/test_dbservice.js", "toolkit/components/url-classifier/tests/unit/test_digest256.js", "toolkit/components/url-classifier/tests/unit/test_listmanager_v5_update_timing.js", "toolkit/components/url-classifier/tests/unit/test_rsListService.js", "toolkit/components/url-classifier/tests/unit/xpcshell.toml"], "git_node": "571a18e911a0052ffbe7a570a8abd0cc89d31c3e", "git_parents": ["d6029c373278f314cc39f009b4b7cf1cb9a498de"], "node": "50c994f801874f07ccf145a745d885e2dc291f6d", "parents": ["e3ebac2f870d08825a1ba492f576c2a123ab3a5e"], "tags": []}], "date": 1788873468, "git_changesets": ["571a18e911a0052ffbe7a570a8abd0cc89d31c3e"], "user": "dmeehan@mozilla.com"}, "28413": {"changesets": [{"author": "Gian-Carlo Pascutto \u003cgcp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068960 - Accept the \"dek\" JSON key when reading Lockstore DEK metadata  a=dmeehan\n\nBuilds between the Bug 2055631 clippy rename and its revert serialized\nWrappedDek with a \"dek\" key instead of \"wrapped_dek\". Profiles created\nwith those builds fail to load with a missing field `wrapped_dek` error.\n\nKeep writing \"wrapped_dek\" and add a serde alias so either key\ndeserializes.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324056\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324252\n", "files": ["security/lockstore/lockstore_rs/src/keystore.rs"], "git_node": "0de7bf2a9249e7357dac63cf3ca67249a2afbd50", "git_parents": ["571a18e911a0052ffbe7a570a8abd0cc89d31c3e"], "node": "933d8b47cee73d0f1e35029f25cb51bc9d18f08b", "parents": ["50c994f801874f07ccf145a745d885e2dc291f6d"], "tags": []}], "date": 1788878833, "git_changesets": ["0de7bf2a9249e7357dac63cf3ca67249a2afbd50"], "user": "dmeehan@mozilla.com"}, "28414": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064287 - Harden drag handling;  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321984\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323927\n", "files": ["dom/base/PointerLockManager.cpp", "dom/base/PointerLockManager.h", "dom/events/EventStateManager.cpp", "dom/events/EventStateManager.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "widget/nsBaseDragService.cpp", "widget/nsIDragService.idl"], "git_node": "871c85c52863cff910a0cd89524617347440668b", "git_parents": ["0de7bf2a9249e7357dac63cf3ca67249a2afbd50"], "node": "a61331c8205c443c46627e13488e345e75c78048", "parents": ["933d8b47cee73d0f1e35029f25cb51bc9d18f08b"], "tags": []}], "date": 1788879725, "git_changesets": ["871c85c52863cff910a0cd89524617347440668b"], "user": "dmeehan@mozilla.com"}, "28415": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069367 - Preserve an input's undo history across value setters via a preserveundohistory attribute.  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324244\n", "files": ["browser/components/search/content/searchbar.js", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-editing/browser_undo_history.js", "dom/base/test/chrome/test_input_value_set_preserve_undo.xhtml", "dom/html/HTMLInputElement.cpp", "dom/html/test/mochitest.toml", "dom/html/test/test_input_value_set_preserve_undo.html", "editor/libe