txt", "mobile/android/version.txt"], "git_node": "334791f0925d437d1dbf8e06cadf83ce8bd1be7c", "git_parents": ["026c4a1c838be8dd6095f30c239999f73fa6375b"], "node": "ebccb7718975a4da95baa794cff6d6a05b269e8f", "parents": ["95e1a246e1790d1dee727637ba698027f17f8a11"], "tags": []}], "date": 1788528742, "git_changesets": ["334791f0925d437d1dbf8e06cadf83ce8bd1be7c"], "user": "ffxbld@lando.moz.tools"}, "28359": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 95e1a246e1790d1dee727637ba698027f17f8a11 with FIREFOX-ANDROID_156_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "7ce6d0914e638320897b601e017e619163bf53aa", "git_parents": ["e0197b3ccb682d666a85c5ac3332f967e844d875"], "node": "b30fb25351aeaac6994c727dff267a24e37d3ec7", "parents": ["b2a637c9ac45a8b38f22fa02b85d591e449e1eca"], "tags": []}], "date": 1788528760, "git_changesets": ["7ce6d0914e638320897b601e017e619163bf53aa"], "user": "ffxbld@lando.moz.tools"}, "28360": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 5fdfd0092780e85643e2cddc0e1b590c8b9ef860 with FIREFOX-ANDROID_155_0_1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "84d7cd724d74cf0946823054ff3a0917d1e36afe", "git_parents": ["7ce6d0914e638320897b601e017e619163bf53aa"], "node": "93d4479b7c9e9426bc015f791ca1412a4922d76a", "parents": ["b30fb25351aeaac6994c727dff267a24e37d3ec7"], "tags": []}], "date": 1788530077, "git_changesets": ["84d7cd724d74cf0946823054ff3a0917d1e36afe"], "user": "ffxbld@lando.moz.tools"}, "28361": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 5fdfd0092780e85643e2cddc0e1b590c8b9ef860 with FIREFOX_155_0_1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "a14fa64c5fdaf73abd0e72cc00d3d8d6da2dd8e2", "git_parents": ["84d7cd724d74cf0946823054ff3a0917d1e36afe"], "node": "7e9b9f56d92764cca07faa28bc3f3b28751ad66a", "parents": ["93d4479b7c9e9426bc015f791ca1412a4922d76a"], "tags": []}], "date": 1788531621, "git_changesets": ["a14fa64c5fdaf73abd0e72cc00d3d8d6da2dd8e2"], "user": "ffxbld@lando.moz.tools"}, "28362": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 95e1a246e1790d1dee727637ba698027f17f8a11 with FIREFOX_156_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "7b79c854a600de8c57244f50a2b4744c474db378", "git_parents": ["a14fa64c5fdaf73abd0e72cc00d3d8d6da2dd8e2"], "node": "87d07d804a11329380e1589694e7049b0f79672a", "parents": ["7e9b9f56d92764cca07faa28bc3f3b28751ad66a"], "tags": []}], "date": 1788536903, "git_changesets": ["7b79c854a600de8c57244f50a2b4744c474db378"], "user": "ffxbld@lando.moz.tools"}, "28363": {"changesets": [{"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066920 - Record the OS version crash annotations without the system info service, .  a=dmeehan\n\nBug 2049749 reached OSVersion and LinuxLSBDescription through\n@mozilla.org/system-info;1, which loads that service during every startup, and\n@mozilla.org/windows-registry-key;1 behind it on Windows. Background tasks are\nmeant to load neither, and browser_xpcom_graph_wait.js has failed permanently\nsince. The values come from free functions nsSystemInfo itself uses, and since\nneither needs XPCOM they move to RecordPlatformAnnotations, which runs earlier.\n\nOn Android, where nsSystemInfo substitutes the SDK version for the release, Gecko\nnow leaves OSVersion to lib-crash, which sets Build.VERSION.SDK_INT when absent.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321714\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323600\n", "files": ["toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "97c3f88f615b90f58f2230a6d9aa8e32ee209501", "git_parents": ["334791f0925d437d1dbf8e06cadf83ce8bd1be7c"], "node": "df24bad72aebd6ce6b511ae8e71a90c3ccbc87f3", "parents": ["ebccb7718975a4da95baa794cff6d6a05b269e8f"], "tags": []}], "date": 1788538170, "git_changesets": ["97c3f88f615b90f58f2230a6d9aa8e32ee209501"], "user": "dmeehan@mozilla.com"}, "28364": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061777 - Reject parent-only Client ops received from content processes.  a=dmeehan\n\nClientHandleOpParent::Init now rejects ClientControlledArgs and\nClientEvictBFCacheArgs when the sender is a content process. These op types\nare only ever produced by the parent-process ServiceWorkerManager (via\nClientHandle::Control and ClientHandle::EvictFromBFCache); a content process\nnever legitimately sends them.\n\nAccepting a forged ClientControlledArgs from content let a compromised\ncontent process install attacker-chosen ServiceWorker controller state on a\nclient living in another process. ClientManagerService::Navigate then trusted\nthat controller state as its sole authorization, allowing extension\nbackground pages to be navigated to attacker-controlled URLs and attacker\ncode to run in the extension process.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321169\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322860\n", "files": ["dom/clients/manager/ClientHandleOpParent.cpp"], "git_node": "e6533bd5b33408b92635edcdf90c9213969d95e4", "git_parents": ["97c3f88f615b90f58f2230a6d9aa8e32ee209501"], "node": "0f9d01f040887b0ca8c97eafc67339ee656585d5", "parents": ["df24bad72aebd6ce6b511ae8e71a90c3ccbc87f3"], "tags": []}], "date": 1788538191, "git_changesets": ["e6533bd5b33408b92635edcdf90c9213969d95e4"], "user": "dmeehan@mozilla.com"}, "28365": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2067971.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322591\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323203\n", "files": ["image/decoders/nsJPEGDecoder.cpp"], "git_node": "b9eb9ccea52df0d414128259e365954d5ff556fb", "git_parents": ["e6533bd5b33408b92635edcdf90c9213969d95e4"], "node": "2e594bed7f613c7984f2867ae4ff9c1e45a7b85e", "parents": ["0f9d01f040887b0ca8c97eafc67339ee656585d5"], "tags": []}], "date": 1788538367, "git_changesets": ["b9eb9ccea52df0d414128259e365954d5ff556fb"], "user": "dmeehan@mozilla.com"}, "28366": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2068354 - Check whether we're reflowing when observing changes  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323194\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323328\n", "files": ["layout/svg/SVGObserverUtils.cpp", "layout/svg/SVGTextFrame.cpp"], "git_node": "1fab0351ce074286bd3c9c32e94ac6c5e62bdf6b", "git_parents": ["b9eb9ccea52df0d414128259e365954d5ff556fb"], "node": "80189063379982b6767fabaf87681888d945e06d", "parents": ["2e594bed7f613c7984f2867ae4ff9c1e45a7b85e"], "tags": []}], "date": 1788538508, "git_changesets": ["1fab0351ce074286bd3c9c32e94ac6c5e62bdf6b"], "user": "dmeehan@mozilla.com"}, "28367": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2068438  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323156\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323434\n", "files": ["gfx/layers/ImageContainer.cpp", "gfx/layers/client/TextureClient.cpp", "gfx/layers/client/TextureClient.h"], "git_node": "40430840a8e7867837e4def423777fa10402c300", "git_parents": ["1fab0351ce074286bd3c9c32e94ac6c5e62bdf6b"], "node": "6b71d3562c70224385ee95c5f141926c0c99c088", "parents": ["80189063379982b6767fabaf87681888d945e06d"], "tags": []}], "date": 1788538767, "git_changesets": ["40430840a8e7867837e4def423777fa10402c300"], "user": "dmeehan@mozilla.com"}, "28368": {"changesets": [{"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063863 - Improve TranslationsEngine port lifetime management  a=dmeehan\n\nThis commit fixes TranslationsEngine port lifetime management by\ntracking each port independently and notifying its client when the\nassociated language-pair engine is destroyed.\n\nIt also adds test-only control over the engine timeout and regression\ncoverage for multiple clients and independently cached engines.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317556\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323245\n", "files": ["toolkit/components/translations/actors/TranslationsEngineChild.sys.mjs", "toolkit/components/translations/actors/TranslationsEngineParent.sys.mjs", "toolkit/components/translations/content/Translator.mjs", "toolkit/components/translations/content/translations-engine.sys.mjs", "toolkit/components/translations/tests/browser/browser.toml", "toolkit/components/translations/tests/browser/browser_translations_engine_lifetime.js", "toolkit/components/translations/tests/browser/shared-head.js", "toolkit/components/translations/translations.d.ts"], "git_node": "93e5b7adddb5b8694a81937a70f5d9eb194aac1c", "git_parents": ["40430840a8e7867837e4def423777fa10402c300"], "node": "752ea9e7447c993f495bb540983d684dbf0163c6", "parents": ["6b71d3562c70224385ee95c5f141926c0c99c088"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067578 - Add Full-Page TranslationsEngine lifetime regression coverage  a=dmeehan\n\nThis commit adds Full-Page Translations regression coverage to ensure\nthat newly intersecting and modified content continues to translate\nafter an engine timeouts.\n\nThe tests cover recreating the inference process as well as recreating\nonly the engine while the process is kept alive by another actor.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322759\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323246\n", "files": ["browser/components/translations/tests/browser/browser_full.toml", "browser/components/translations/tests/browser/browser_translations_full_page_intersection_engine_timeout.js", "browser/components/translations/tests/browser/head.js"], "git_node": "bc72468f0a17d695775871a06fcb19533ba1d4ca", "git_parents": ["93e5b7adddb5b8694a81937a70f5d9eb194aac1c"], "node": "059bf8f2d1c4e946e8df902582923bb85934ad4e", "parents": ["752ea9e7447c993f495bb540983d684dbf0163c6"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063863 - Add about:translations engine lifetime regression coverage  a=dmeehan\n\nThis commit expands the about:translations engine-destruction test to\ncover idle timeouts. It ensures that about:translations can acquire a\nnew port and continue translating after its engine is destroyed.\n\nThe tests cover recreating the inference process as well as recreating\nonly the engine while the process is kept alive by another actor.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322760\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323247\n", "files": ["toolkit/components/translations/tests/browser/browser_about_translations_engine_destroy.js", "toolkit/components/translations/tests/browser/shared-head.js"], "git_node": "baa52b20a632a5af7e787c60459fd376574de62d", "git_parents": ["bc72468f0a17d695775871a06fcb19533ba1d4ca"], "node": "7799461bf87f851ad8d1ed1d46c82e15df01f402", "parents": ["059bf8f2d1c4e946e8df902582923bb85934ad4e"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063863 - Release SelectTranslations ports after each request  a=dmeehan\n\nThis commit ensures that Select Translations releases each short-lived\nTranslator and its port after a translation request completes.\n\nThe tests cover recreating the inference process as well as recreating\nonly the engine while the process is kept alive by another actor.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322761\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323248\n", "files": ["browser/components/translations/content/selectTranslationsPanel.js", "browser/components/translations/tests/browser/browser_translations_select_panel_engine_cache.js", "browser/components/translations/tests/browser/head.js"], "git_node": "98efb28a00431cdfd928e122628a7f96bbf48a06", "git_parents": ["baa52b20a632a5af7e787c60459fd376574de62d"], "node": "867641bc55a8411c16d2159261c4478a20e7c729", "parents": ["7799461bf87f851ad8d1ed1d46c82e15df01f402"], "tags": []}], "date": 1788538793, "git_changesets": ["93e5b7adddb5b8694a81937a70f5d9eb194aac1c", "bc72468f0a17d695775871a06fcb19533ba1d4ca", "baa52b20a632a5af7e787c60459fd376574de62d", "98efb28a00431cdfd928e122628a7f96bbf48a06"], "user": "dmeehan@mozilla.com"}, "28369": {"changesets": [{"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055858 - Honor the wallpaper visible and visibility_group fields in the New Tab picker  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323031\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323344\n", "files": ["browser/extensions/newtab/content-src/components/WallpaperCategories/WallpaperCategories.jsx", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/WallpaperCategories/WallpaperCategories.test.jsx"], "git_node": "e8280c97ad07a09fbb801cf73507e74f110cf824", "git_parents": ["98efb28a00431cdfd928e122628a7f96bbf48a06"], "node": "f9255a4dc1ad9cd47443ed5d559512acee760132", "parents": ["867641bc55a8411c16d2159261c4478a20e7c729"], "tags": []}], "date": 1788538820, "git_changesets": ["e8280c97ad07a09fbb801cf73507e74f110cf824"], "user": "dmeehan@mozilla.com"}, "28370": {"changesets": [{"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068852 - Add operation and failure-state extras to vpn.error_encountered.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323162\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323470\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Actions.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionSnackbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddlewareTest.kt"], "git_node": "bea23a01a7ec9adf4480c15d337fd22c300d5eca", "git_parents": ["e8280c97ad07a09fbb801cf73507e74f110cf824"], "node": "7a0f1cd523b24f39f3038dbca1a734507f04bbc6", "parents": ["f9255a4dc1ad9cd47443ed5d559512acee760132"], "tags": []}], "date": 1788539077, "git_changesets": ["bea23a01a7ec9adf4480c15d337fd22c300d5eca"], "user": "dmeehan@mozilla.com"}, "28371": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 95e1a246e1790d1dee727637ba698027f17f8a11 with DEVEDITION_156_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "be34ab82a339b4c933c0e3cce8420a6b4a4667fb", "git_parents": ["7b79c854a600de8c57244f5