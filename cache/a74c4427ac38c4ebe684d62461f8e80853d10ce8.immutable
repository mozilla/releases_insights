["cde386eab3b6f3463c4206f4c28f1df3e53bcd16"], "node": "a17f4d6f0d9284fa357f0d58fecfb14c0e100cf3", "parents": ["3330980dabe0189817592579d3e8cf4dc515dff1"], "tags": []}], "date": 1788599156, "git_changesets": ["cde386eab3b6f3463c4206f4c28f1df3e53bcd16", "87d553c956cca4882f9edd71177920decc8ed7dc"], "user": "ffxbld@lando.moz.tools"}, "28378": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2068440 - Validate fieldset listed elements.  a=dmeehan\n\nMake sure we have a fieldset. We can't check _which_ fieldset because\nfieldset.elements work across multiple fieldsets.\n\nTrack elements inside legends and check the disabled-ness more\nexplicitly instead.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322883\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323530\n", "files": ["dom/html/HTMLElement.cpp", "dom/html/HTMLFieldSetElement.cpp", "dom/html/nsGenericHTMLElement.cpp", "dom/html/nsGenericHTMLElement.h", "testing/web-platform/tests/custom-elements/form-associated/fieldset-elements-after-upgrade.html", "testing/web-platform/tests/custom-elements/form-associated/fieldset-elements-during-construction.html", "testing/web-platform/tests/custom-elements/form-associated/form-disabled-legend.html", "testing/web-platform/tests/html/semantics/forms/the-fieldset-element/disabled-nested-legend.html"], "git_node": "b8b9ad08016c328308cbda6059df86017cd11559", "git_parents": ["87d553c956cca4882f9edd71177920decc8ed7dc"], "node": "43e52df881121885602ea5345d5dfa4ecfd3fe5f", "parents": ["a17f4d6f0d9284fa357f0d58fecfb14c0e100cf3"], "tags": []}], "date": 1788615108, "git_changesets": ["b8b9ad08016c328308cbda6059df86017cd11559"], "user": "dmeehan@mozilla.com"}, "28379": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2068961 - Add colour metadata test videos with explicit transfer functions.  a=dmeehan\n\ngen_combos.py cross combines a single colour space name into primaries,\ntransfer and matrix, so the generated corpus cannot express BT.2100 PQ or HLG,\nor wide gamut SDR. Those are the cases where a decoder has to report a transfer\nfunction that is not implied by the primaries, which is what the macOS\nVideoToolbox path gets wrong.\n\nAdd a second, explicit set of combinations for those, signalled through\nx265-params and svtav1-params so the values land in the bitstream rather than\nonly in the container, plus HEVC, which is the codec VideoToolbox most reliably\ndecodes in hardware on macOS and which the corpus had no coverage of at all.\n\nThe samples are transfer converted with zscale rather than merely tagged, so\nregenerating them needs an ffmpeg built with libzimg. Within a combination the\nsamples are identical across codecs, so codec to codec comparisons isolate the\ncontainer and decoder rather than the encode.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323303\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323608\n", "files": ["dom/media/test/reftest/color_quads/720p.png.bt2020.bt2020.tv.yuv420p10.av1.mp4", "dom/media/test/reftest/color_quads/720p.png.bt2020.bt2020.tv.yuv420p10.av1.webm", "dom/media/test/reftest/color_quads/720p.png.bt2020.bt2020.tv.yuv420p10.hevc.mp4", "dom/media/test/reftest/color_quads/720p.png.bt2020.hlg.tv.yuv420p10.av1.mp4", "dom/media/test/reftest/color_quads/720p.png.bt2020.hlg.tv.yuv420p10.av1.webm", "dom/media/test/reftest/color_quads/720p.png.bt2020.hlg.tv.yuv420p10.hevc.mp4", "dom/media/test/reftest/color_quads/720p.png.bt2020.hlg.tv.yuv420p10.vp9.webm", "dom/media/test/reftest/color_quads/720p.png.bt2020.pq.tv.yuv420p10.av1.mp4", "dom/media/test/reftest/color_quads/720p.png.bt2020.pq.tv.yuv420p10.av1.webm", "dom/media/test/reftest/color_quads/720p.png.bt2020.pq.tv.yuv420p10.hevc.mp4", "dom/media/test/reftest/color_quads/720p.png.bt2020.pq.tv.yuv420p10.vp9.webm", "dom/media/test/reftest/color_quads/720p.png.bt709.bt709.tv.yuv420p.hevc.mp4", "dom/media/test/reftest/gen_combos.py"], "git_node": "ec31063b1183fdc12df3a73e82a2a1ccb856ed87", "git_parents": ["b8b9ad08016c328308cbda6059df86017cd11559"], "node": "4829695b73fc068ce2e69f911cbd1950a8aa709e", "parents": ["43e52df881121885602ea5345d5dfa4ecfd3fe5f"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2068961 - Test the colorspace attached to VideoToolbox decoded frames.  a=dmeehan\n\nExhaustive over the cross product of transfer function and colour primaries,\nbecause the rule is a pure function of those two and the combinations codecs\nhappen to emit are only a subset of what has to be right.\n\nPlus one end to end check per side, decoding through VideoToolbox in process\nand inspecting the IOSurface the compositor would receive: an SDR frame keeps\nthe colorspace VideoToolbox gave it, and a PQ frame still gets an explicit one.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323304\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323609\n", "files": ["dom/media/gtest/TestAppleVTColorSpace.cpp", "dom/media/gtest/moz.build"], "git_node": "8c65133f84bcc018f1e29e4390343413711d843c", "git_parents": ["ec31063b1183fdc12df3a73e82a2a1ccb856ed87"], "node": "df35c7e3506fae18d5b4e830b4be2296023f34be", "parents": ["4829695b73fc068ce2e69f911cbd1950a8aa709e"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2068961 - Only override the VideoToolbox buffer colorspace for wide gamut and HDR content.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323305\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323610\n", "files": ["dom/media/platforms/apple/AppleVTColorSpace.h", "dom/media/platforms/apple/AppleVTDecoder.cpp"], "git_node": "2017d3e1c703aff6bed85cd7ac611ea029828153", "git_parents": ["8c65133f84bcc018f1e29e4390343413711d843c"], "node": "a0ec873327d7a1a4c76c54