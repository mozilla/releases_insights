es": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_build_conversation.js"], "git_node": "e2a1605713988704f272ded88ce0357cede545a3", "git_parents": ["bba0b7da2eab65f4d51ea184de367a69e0b5799a"], "node": "1671768c071e09dfc96b286552ed369ffb69d699", "parents": ["a840e0cb3ea81a155fd284b7b9075752bf1530ed"], "tags": []}], "date": 1788442228, "git_changesets": ["e2a1605713988704f272ded88ce0357cede545a3"], "user": "dmeehan@mozilla.com"}, "28332": {"changesets": [{"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068547 - VPN location list fails to update dynamically after default browser change -  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322941\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322961\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/tests/xpcshell/test_IPProtectionPanel.js"], "git_node": "7d7044ca55ba551b0cffedfc14928d528461defd", "git_parents": ["e2a1605713988704f272ded88ce0357cede545a3"], "node": "814900331c0f4cf14adc3d4a3b98631672a5dee2", "parents": ["1671768c071e09dfc96b286552ed369ffb69d699"], "tags": []}], "date": 1788442258, "git_changesets": ["7d7044ca55ba551b0cffedfc14928d528461defd"], "user": "dmeehan@mozilla.com"}, "28333": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068342 -  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322923\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323028\n", "files": ["dom/xml/nsXMLContentSink.cpp"], "git_node": "be5afb4e236fba5b95ebd509c8e60f985147430a", "git_parents": ["7d7044ca55ba551b0cffedfc14928d528461defd"], "node": "9a5cb3c42df1de5510cb08986c755b9655c64572", "parents": ["814900331c0f4cf14adc3d4a3b98631672a5dee2"], "tags": []}], "date": 1788442290, "git_changesets": ["be5afb4e236fba5b95ebd509c8e60f985147430a"], "user": "dmeehan@mozilla.com"}, "28334": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067366 - Restore the scrollbar in menulist popups.  a=dmeehan\n\nA vertical arrowscrollbox hides its scrollbar, and the menulist rule set the scrollbox's overflow but not its scrollbar-width, so the popup kept scrolling with nothing to drag. Narrowing the overflow declaration to overflow-y crops a menuitem wider than the popup rather than scrolling it sideways. The declarations stay unconditional, so the popup is scrollable in its first frame; the arrowscrollbox only sets [overflowing] a frame later, from a ResizeObserver.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322351\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322818\n", "files": ["browser/base/content/test/forms/browser_selectpopup_colors.js", "toolkit/content/tests/chrome/chrome.toml", "toolkit/content/tests/chrome/test_menulist_scrollbar.xhtml", "toolkit/content/widgets/menupopup.css"], "git_node": "97c904cb9fd9360f888ae375af9512477b78c5bf", "git_parents": ["be5afb4e236fba5b95ebd509c8e60f985147430a"], "node": "e8d6ad1aa57585369daa3b93615ea09a3c93e6b3", "parents": ["9a5cb3c42df1de5510cb08986c755b9655c64572"], "tags": []}], "date": 1788442384, "git_changesets": ["97c904cb9fd9360f888ae375af9512477b78c5bf"], "user": "dmeehan@mozilla.com"}, "28335": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2068184 - Check for visibility CSS property in PopupNotifications.  a=dmeehan\n\nBefore bug 2064683, the tab bar was hidden via display: none, and now it\nonly has collapsed attribute which uses visibility: collapse.\n\nPopupNotifications should account for visibility: collapse / hidden,\njust like checkForAnchorChange does.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322746\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323237\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/base/content/browser.js", "browser/components/extensions/test/browser/browser_ext_request_permissions.js", "browser/components/sidebar/sidebar-permissions.mjs", "toolkit/modules/PopupNotifications.sys.mjs"], "git_node": "04b506419b807826b619882a258e456a9d05d16f", "git_parents": ["97c904cb9fd9360f888ae375af9512477b78c5bf"], "node": "91efe42443871245530147781c2878456032a66b", "parents": ["e8d6ad1aa57585369daa3b93615ea09a3c93e6b3"], "tags": []}], "date": 1788442598, "git_changesets": ["04b506419b807826b619882a258e456a9d05d16f"], "user": "dmeehan@mozilla.com"}, "28336": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2016440 - Don't block application shutdown on the newtab train-hop update task.  a=dmeehan\n\n`scheduleUpdateTrainhopAddonState` registered an `AsyncShutdown.appShutdownConfirmed`\nblocker that awaited `_updateAddonStateDeferredTask.finalize()`. That tied application\nshutdown to the completion of a train-hop XPI download/install, producing the\n`AsyncShutdownTimeout | quit-application | newtabTrainhopAddon\nscheduleUpdateTrainhopAddonState shutting down` top crash.\n\nTo fix this, we now:\n\n- Drop the AsyncShutdown blocker entirely. Interrupting the update is safe: an already\n  staged install is applied on the next startup, and everything else is recomputed from\n  the Nimbus enrollments next session. Finalizing XPIProvider operations that are still\n  in progress is left to the XPIProvider's own AsyncShutdown blockers.\n- Add an `_isAppShuttingDown()` helper based on `nsIAppStartup.attemptingQuit` (the\n  earliest signal, set before `quit-application-granted` is notified) plus the existing\n  `isInOrBeyondShutdownPhase(APPSHUTDOWNCONFIRMED)` check, for shutdowns that don't go\n  through `nsIAppStartup.quit`.\n- Use it to bail out of the deferred task, to avoid starting a download that could never\n  be cancelled, and to avoid calling `continuePostponedInstall()` on the FirstStartup\n  restartless path once shutdown has begun.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320515\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323243\n", "files": ["browser/components/newtab/AboutNewTabResourceMapping.sys.mjs", "browser/components/newtab/test/xpcshell/test_nimbus_newtabTrainhopAddon_onBrowserReady.js", "browser/components/newtab/test/xpcshell/test_nimbus_newtabTrainhopAddon_shutdown.js", "browser/components/newtab/test/xpcshell/xpcshell.toml"], "git_node": "16a6a45080a1fdaf3a666fdd6c0979f074258e10", "git_parents": ["04b506419b807826b619882a258e456a9d05d16f"], "node": "633bc5e3a9a81c09dfcbefef2a39016ce296c9c9", "parents": ["91efe42443871245530147781c2878456032a66b"], "tags": []}], "date": 1788443954, "git_changesets": ["16a6a45080a1fdaf3a666fdd6c0979f074258e10"], "user": "dmeehan@mozilla.com"}, "28337": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2066852 - Only synthesize an HTTPS AliasMode record when a real AliasMode record was followed  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322245\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323249\n", "files": ["netwerk/dns/DNSPacket.cpp", "netwerk/dns/DNSPacket.h", "netwerk/dns/GetAddrInfo.cpp", "netwerk/dns/GetAddrInfo.h", "netwerk/dns/PlatformDNSAndroid.cpp", "netwerk/dns/PlatformDNSMac.cpp", "netwerk/dns/PlatformDNSUnix.cpp", "netwerk/dns/PlatformDNSWin.cpp", "netwerk/dns/TRR.cpp", "netwerk/test/unit/test_dns_override.js", "netwerk/test/unit/test_httpssvc_https_upgrade.js", "netwerk/test/unit/test_trr_httpssvc.js"], "git_node": "cdbf8a109a3ffd15e01fd1e17f8029b94ed42891", "git_parents": ["16a6a45080a1fdaf3a666fdd6c0979f074258e10"], "node": "3766572db78fbfba1210784c1b3edf509f60b41c", "parents": ["633bc5e3a9a81c09dfcbefef2a39016ce296c9c9"], "tags": []}], "date": 1788444551, "git_changesets": ["cdbf8a109a3ffd15e01fd1e17f8029b94ed42891"], "user": "dmeehan@mozilla.com"}, "28338": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067031 - Null-check mTransaction after OnMsgReclaimConnection in DnsAndConnectSocket::SetupConn,  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321898\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323173\n", "files": ["netwerk/protocol/http/DnsAndConnectSocket.cpp"], "git_node": "2fcbf89c861fde0448312c5ab50ad37b466c6395", "git_parents": ["cdbf8a109a3ffd15e01fd1e17f8029b94ed42891"], "node": "d9d29b3ca7515e9034bf5b54b829d0ab1868de8d", "parents": ["3766572db78fbfba1210784c1b3edf509f60b41c"], "tags": []}], "date": 1788444642, "git_changesets": ["2fcbf89c861fde0448312c5ab50ad37b466c6395"], "user": "dmeehan@mozilla.com"}, "28339": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068240 - Make mForm a RefPtr.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322736\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323251\n", "files": ["dom/html/HTMLFormElement.cpp", "dom/html/HTMLImageElement.cpp", "dom/html/HTMLImageElement.h", "dom/html/nsGenericHTMLElement.cpp", "dom/html/nsGenericHTMLElement.h"], "git_node": "55decd023b2f0b79990c04fb1eacb5c40cbc94dc", "git_parents": ["2fcbf89c861fde0448312c5ab50ad37b466c6395"], "node": "451127ebd665f0555f5175fe83da96eef8bf0021", "parents": ["d9d29b3ca7515e9034bf5b54b829d0ab1868de8d"], "tags": []}], "date": 1788445184, "git_changesets": ["55decd023b2f0b79990c04fb1eacb5c40cbc94dc"], "user": "dmeehan@mozilla.com"}, "28340": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2011747 - Order backdrop-filter sub-graph content before the tasks that sample it r=gfx-reviewers,nical\" for causing browser freezes.\n\nThis reverts commit 865c925ec74249b8802fa3c6d4bc37eba0bf38b5.\n", "files": ["gfx/wr/webrender/src/surface.rs", "gfx/wr/wrench/reftests/filters/backdrop-filter-in-blurred-parent-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-filter-in-blurred-parent.yaml", "gfx/wr/wrench/reftests/filters/reftest.list", "testing/web-platform/meta/css/filter-effects/backdrop-filter-plus-filter-2.html.ini"], "git_node": "e52e37b73ba17c90d29b8849c3d26ad45b41894f", "git_parents": ["55decd023b2f0b79990c04fb1eacb5c40cbc94dc"], "node": "acfdc839c920219073a5dc44b971aa365e98f5e7", "parents": ["451127ebd665f0555f5175fe83da96eef8bf0021"], "tags": []}], "date": 1788454288, "git_changesets": ["e52e37b73ba17c90d29b8849c3d26ad45b41894f"], "user": "rvandermeulen@mozilla.com"}, "28341": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Reapply \"Bug 1625902 - part 4: Make dispatcher of the chrome event of initializing/finalizing UA shadow require a script blocker r=smaug,emilio,layout-reviewers\" to beta a=dmeehan\n\nReapply \"Bug 1625902 - part 3: Make some overloads of `nsContentUtils::Dispatch*Event` r=smaug,layout-reviewers,emilio\" to beta a=dmeehan\n\nReapply \"Bug 1625902 - part 2: Mark `nsContentUtils::Dispatch*Event` for chrome as `MOZ_CAN_RUN_SCRIPT` r=smaug,dom-core-reviewers,win-reviewers,layout-reviewers,emilio,handyman\" to beta a=dmeehan\n\nReapply \"Bug 1625902 - part 1: Mark `nsContentUtils::Dispatch*Event` as `MOZ_CAN_RUN_SCRIPT` except for chrome r=smaug,dom-core-reviewers,geckoview-reviewers,media-playback-reviewers,win-reviewers,padenot,handyman,m_kato\" to beta a=dmeehan\n\nThis reverts commit d9d96f44c6167f2268500ef3c67567e387b7524e.\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "docshell/base/nsDSURIContentListener.cpp", "docshell/base/nsDocShell.cpp", "do