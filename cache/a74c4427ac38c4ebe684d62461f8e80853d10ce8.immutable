bfbbbc3d4e95796721075\nvi -\u003e 1d3a403e67a82201325bfbbbc3d4e95796721075\nwo -\u003e 1d3a403e67a82201325bfbbbc3d4e95796721075\nxh -\u003e 1d3a403e67a82201325bfbbbc3d4e95796721075\nzam -\u003e 1d3a403e67a82201325bfbbbc3d4e95796721075\nzh-CN -\u003e 1d3a403e67a82201325bfbbbc3d4e95796721075\nzh-TW -\u003e 1d3a403e67a82201325bfbbbc3d4e95796721075\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "891f4e41422b55fa920978feb93a164efd0bc765", "git_parents": ["50398521cc95dc1160f64c7781db1c56bd5d4926"], "node": "4a417e4a64d1d3699dbdc28d58bfa9f6522756b4", "parents": ["dec94396479490686411ccbed1ddfaf5d5cbd551"], "tags": ["DEVEDITION_156_0b2_BUILD1", "DEVEDITION_156_0b2_RELEASE", "FIREFOX-ANDROID_156_0b2_BUILD1", "FIREFOX-ANDROID_156_0b2_RELEASE", "FIREFOX_156_0b2_BUILD1", "FIREFOX_156_0b2_RELEASE"]}], "date": 1788339811, "git_changesets": ["50398521cc95dc1160f64c7781db1c56bd5d4926", "891f4e41422b55fa920978feb93a164efd0bc765"], "user": "ffxbld@lando.moz.tools"}, "28312": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 4a417e4a64d1d3699dbdc28d58bfa9f6522756b4 with FIREFOX_156_0b2_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "d762e9d21b4696ab8453f1845a0a171c6166917d", "git_parents": ["67b955fb45ad610c987b95217e10d215e36afd1c"], "node": "c63bbe64be417de1aef2a9c80e47ee4db701a6c8", "parents": ["8c2cac5724ca69bd776b49dd263e5b0d66156722"], "tags": []}], "date": 1788354414, "git_changesets": ["d762e9d21b4696ab8453f1845a0a171c6166917d"], "user": "ffxbld@lando.moz.tools"}, "28313": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 4a417e4a64d1d3699dbdc28d58bfa9f6522756b4 with FIREFOX-ANDROID_156_0b2_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "2772b983ae80dd9454d01aa8bb99fecc4b9f0d35", "git_parents": ["d762e9d21b4696ab8453f1845a0a171c6166917d"], "node": "b1cb385e02f97c573c88edfe2e7240857796da2e", "parents": ["c63bbe64be417de1aef2a9c80e47ee4db701a6c8"], "tags": []}], "date": 1788354500, "git_changesets": ["2772b983ae80dd9454d01aa8bb99fecc4b9f0d35"], "user": "ffxbld@lando.moz.tools"}, "28314": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 4a417e4a64d1d3699dbdc28d58bfa9f6522756b4 with DEVEDITION_156_0b2_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "91ea955c215db9b52a27b933515f234afe3a4058", "git_parents": ["2772b983ae80dd9454d01aa8bb99fecc4b9f0d35"], "node": "f2408449918c7425f4ac5e478680a3bee5fe2893", "parents": ["b1cb385e02f97c573c88edfe2e7240857796da2e"], "tags": []}], "date": 1788354635, "git_changesets": ["91ea955c215db9b52a27b933515f234afe3a4058"], "user": "ffxbld@lando.moz.tools"}, "28315": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE DONTBUILD\n", "files": ["browser/config/version_display.txt", "mobile/android/version.txt"], "git_node": "3a05a94852977bd7baf61a76f305ebbd7ba5c089", "git_parents": ["891f4e41422b55fa920978feb93a164efd0bc765"], "node": "956c6247264b8ce343250bb2c9e73f5fd5e4bd38", "parents": ["4a417e4a64d1d3699dbdc28d58bfa9f6522756b4"], "tags": []}], "date": 1788355982, "git_changesets": ["3a05a94852977bd7baf61a76f305ebbd7ba5c089"], "user": "ffxbld@lando.moz.tools"}, "28316": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 4a417e4a64d1d3699dbdc28d58bfa9f6522756b4 with FIREFOX-ANDROID_156_0b2_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "88ed57bdae27e8780c35cf78714fe1c891c17303", "git_parents": ["91ea955c215db9b52a27b933515f234afe3a4058"], "node": "44bcaf64a78fda6a93d925c8ff54f751f53c21cf", "parents": ["f2408449918c7425f4ac5e478680a3bee5fe2893"], "tags": []}], "date": 1788355999, "git_changesets": ["88ed57bdae27e8780c35cf78714fe1c891c17303"], "user": "ffxbld@lando.moz.tools"}, "28317": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 4a417e4a64d1d3699dbdc28d58bfa9f6522756b4 with FIREFOX_156_0b2_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "b8fc069e207514bfeacb9b6a4965a1102edef9df", "git_parents": ["88ed57bdae27e8780c35cf78714fe1c891c17303"], "node": "b6457005c096f0625413063ab925fe583c38bf70", "parents": ["44bcaf64a78fda6a93d925c8ff54f751f53c21cf"], "tags": []}], "date": 1788364360, "git_changesets": ["b8fc069e207514bfeacb9b6a4965a1102edef9df"], "user": "ffxbld@lando.moz.tools"}, "28318": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067158 - Enable skipTabStop in the newtab search mode switcher tab order test.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321890\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322816\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser_searchModeSwitcher.js"], "git_node": "cdd9b17d12cbe1a9e68d4b2cf2b24c7bfc2f905e", "git_parents": ["3a05a94852977bd7baf61a76f305ebbd7ba5c089"], "node": "a0061a2eeb9d96694656d64821ac4e63abd1ae82", "parents": ["956c6247264b8ce343250bb2c9e73f5fd5e4bd38"], "tags": []}], "date": 1788365652, "git_changesets": ["cdd9b17d12cbe1a9e68d4b2cf2b24c7bfc2f905e"], "user": "dmeehan@mozilla.com"}, "28319": {"changesets": [{"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 2060235 - Look up proxy contexts by childId and actor.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319821\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322148\n", "files": ["toolkit/components/extensions/ExtensionParent.sys.mjs"], "git_node": "5dc38c4e4ccd020adbfb2ec1e4e35abbaa24e7fe", "git_parents": ["cdd9b17d12cbe1a9e68d4b2cf2b24c7bfc2f905e"], "node": "1b5e65eb99270d03e5c55e20d205fb1a308bbbea", "parents": ["a0061a2eeb9d96694656d64821ac4e63abd1ae82"], "tags": []}], "date": 1788365680, "git_changesets": ["5dc38c4e4ccd020adbfb2ec1e4e35abbaa24e7fe"], "user": "dmeehan@mozilla.com"}, "28320": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061235: Clean up some uses of STGMEDIUM  a=dmeehan\n\nThis patch includes a bunch of tiny code improvements:\n\n1. The main part of this patch is in nsDataObj::GetText, where it sizes the buffer that we add to the STGMEDIUM by the max char size for the code page, specifically for folks who have configured Windows with the experimental UTF-8 code page, where characters can be 3 bytes.  (NB: An AI checked on stateful code pages.  With state, the max character size can be exceeded.  However, the AI reports that Windows does not allow those pages as CP_ACP.  It says: \"CP_ACP can only resolve to a single-byte code page, a DBCS code page, or 65001. ISO-2022-* and UTF-7 are usable as explicit code-page arguments but Windows won't install them as the system ANSI code page. Every ACP-eligible family is stateless, and all of them held the bound in the measurements above.\".)\n\n2. ScopedOLEMemory checks that the size_t allocation is within bounds.\n\n3. Initializes STGMEDIUM (to TYMED_NULL) in places where it wasn't before.\n\n4. Releases allocated STGMEDIUMs on error (and return an error code when appropriate).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321723\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322685\n", "files": ["widget/windows/WinOLELock.h", "widget/windows/nsClipboard.cpp", "widget/windows/nsDataObj.cpp", "widget/windows/nsDataObjCollection.cpp", "widget/windows/nsDragService.cpp"], "git_node": "a7f66ea63d1e900bce90dc3b52e85448360cb557", "git_parents": ["5dc38c4e4ccd020adbfb2ec1e4e35abbaa24e7fe"], "node": "6f8213ae312bb4814ed9a80171956d13e83ebff8", "parents": ["1b5e65eb99270d03e5c55e20d205fb1a308bbbea"], "tags": []}], "date": 1788365711, "git_changesets": ["a7f66ea63d1e900bce90dc3b52e85448360cb557"], "user": "dmeehan@mozilla.com"}, "28321": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2058181 - More carefully clamp grid tracks.  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322749\n", "files": ["layout/generic/nsGridContainerFrame.cpp", "testing/web-platform/tests/css/css-grid/firefox-bug-2058181-crash.html"], "git_node": "42002f7b66c9d9abd9b5e4948964486e3b635294", "git_parents": ["a7f66ea63d1e900bce90dc3b52e85448360cb557"], "node": "574e908c8e5971b81f367a45eed727ca308a5a5a", "parents": ["6f8213ae312bb4814ed9a80171956d13e83ebff8"], "tags": []}], "date": 1788365745, "git_changesets": ["42002f7b66c9d9abd9b5e4948964486e3b635294"], "user": "dmeehan@mozilla.com"}, "28322": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065393 - Part 1: Drop queued pre-seek audio when stopping a reused stream.  a=dmeehan\n\nAn audio stream reused across a seek is never stopped, so its callback keeps\nconsuming the sink's ring buffer while the sink is stopped. That audio belongs to\nthe position being left behind, and it played until the resume dropped the\nremainder, leaking a fragment of the old position on every seek.\n\nSet the discard boundary when the seek begins instead, so the callback skips that\naudio. Emptying the buffer early also has to be told apart from the source\nending, so mark the sink as deliberately starved for that window; otherwise a\nseek issued once the audio queue had finished would drain the stream and lose the\nreuse.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321760\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322666\n", "files": ["dom/media/mediasink/AudioSink.cpp", "dom/media/mediasink/AudioSink.h"], "git_node": "f45d9e51fb5d320b641793fdac73d592e7ae5977", "git_parents": ["42002f7b66c9d9abd9b5e4948964486e3b635294"], "node": "0371feabd637e73daa1e0318edc8ba8180f1e185", "parents": ["574e908c8e5971b81f367a45eed727ca308a5a5a"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065393 - Part 2: Test that a sink stopped for a seek outputs silence.  a=dmeehan\n\nThe existing stream-reuse tests only assert on what plays after the resume, so\nnothing covered the window in which the sink is stopped and its stashed stream is\nstill running. Drive the callbacks in that window and require every sample to be\nsilence, then resume and require the stream to be reused and the whole post-seek\nbuffer to play, so the invariant cannot be satisfied by tearing the stream down\ninstead.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321761\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322667\n", "files": ["dom/media/gtest/TestAudioSinkWrapper.cpp"], "git_node": "8a0610edaa32b9934b0e21db4ee39da7e2359265", "git_parents": ["f45d9e51fb5d320b641793fdac73d592e7ae5977"], "node": "6385ba94c6f7eeae856b1c7d3b1ba5d44c831209", "parents": ["0371feabd637e73daa1e0318edc8ba8180f1e185"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065393 - Part 3: Stop reporting the silence a seek asks for as an underrun.  a=dmeehan\n\nEmptying the sink's ring buffer for a seek leaves nothing to hand back, so the\nshortfall was reported as a glitch on every callback of the seek. Let the source\nsay when a shortfall is deliberate and skip the reporting then. The zero fill and\nthe frame accounting are unchanged, so the position still holds at the target.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321762\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322668\n", "files": ["dom/media/AudioStream.cpp", "dom/media/AudioStream.h", "dom/media/mediasink/AudioSink.cpp", "dom/media/mediasink/AudioSink.h"], "git_node": "2bbaa7547c27b0f63f291d8f3ee7b56771c5fcfe", "git_parents": ["8a0610edaa32b9934b0e21db4ee39da7e2359265"], "node": "5226be94f77d420cf90174ed82133ecc290ba571", "parents": ["6385ba94c6f7eeae856b1c7d3b1ba5d44c831209"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065393 - Part 4: Document how a reused audio stream behaves across a seek.  a=dmeehan\n\nThe page covers the seek-resume clock but not what the stream does while the sink\nis stopped, which is now the surprising half: the callback runs against a buffer\nemptied on purpose. Record the resulting silence and the properties that depend\non it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321763\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322669\n", "files": ["dom/media/docs/AudioSinkWrapper.md"], "git_node": "ca07ea00f6c29a29695d99d06cab6bd197d64f61", "git_parents": ["2bbaa7547c27b0f63f291d8f3ee7b56771c5fcfe"], "node": "789f6d52f4eb2279baae7eafde1fd1b6f44212a8", "parents": ["5226be94f77d420cf90174ed82133ecc290ba571"], "tags": []}], "date": 1788365790, "git_changesets": ["f45d9e51fb5d320b641793fdac73d592e7ae5977", "8a0610edaa32b9934b0e21db4ee39da7e2359265", "2bbaa7547c27b0f63f291d8f3ee7b56771c5fcfe", "ca07ea00f6c29a29695d99d06cab6bd197d64f61"], "user": "dmeehan@mozilla.com"}, "28323": {"changesets": [{"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061503 - Validate draw fetch limits for matrix attribute columns.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322729\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322750\n", "files": ["dom/canvas/WebGLProgram.cpp", "dom/canvas/test/webgl-mochitest/mochitest.toml", "dom/canvas/test/webgl-mochitest/test_draw_matrix_attrib_fetch_limits.html"], "git_node": "c7f7e319d17bd79084b7dc9516eddde4899c823d", "git_parents": ["ca07ea00f6c29a29695d99d06cab6bd197d64f61"], "node": "94160d130c022c53db71d014c054c412702e5bd3", "parents": ["789f6d52f4eb2279baae7eafde1fd1b6f44212a8"], "tags": []}], "date": 1788367321, "git_changesets": ["c7f7e319d17bd79084b7dc9516eddde4899c823d"], "user": "dmeehan@mozilla.com"}, "28324": {"changesets": [{"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067734 - Fix profile asset size in app menu profile subpanel  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322718\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322920\n", "files": ["browser/base/content/browser-profiles.js"], "git_node": "1557a352dc7124adecaca273f427e27ba57abf1c", "git_parents": ["c7f7e319d17bd79084b7dc9516eddde4899c823d"], "node": "6bd47e02701848169202318c6f022562811643c9", "parents": ["94160d130c022c53db71d014c054c412702e5bd3"], "tags": []}], "date": 1788367848, "git_changesets": ["1557a352dc7124adecaca273f427e27ba57abf1c"], "user": "dmeehan@mozilla.com"}, "28325": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 4a417e4a64d1d3699dbdc28d58bfa9f6522756b4 with DEVEDITION_156_0b2_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "2a8946839e4f9047c11b8e844bbf37d1d19f280c", "git_parents": ["b8fc069e207514bfeacb9b6a4965a1102edef9df"], "node": "a751d511f8fd14585387de4ee15264d6e7b1265c", "parents": ["b6457005c096f0625413063ab925fe583c38bf70"], "tags": []}], "date": 1788369145, "git_changesets": ["2a8946839e4f9047c11b8e844bbf37d1d19f280c"], "user": "ffxbld@lando.moz.tools"}, "28326": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Revert \"Bug 1625902 - part 4: Make dispatcher of the chrome event of initializing/finalizing UA shadow require a script blocker r=smaug,emilio,