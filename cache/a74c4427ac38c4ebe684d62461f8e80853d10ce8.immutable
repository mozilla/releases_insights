"git_node": "77f771c88354dec2f3fa457e1b049f17fe80cec2", "git_parents": ["a871da9e212cd507b1961e733d2554926f6b501d"], "node": "4b835b3377faa97550ec6f45da2a56d6b9ae3f15", "parents": ["87477ce99010d635ec31dfe56d976b00e282dc76"], "tags": []}], "date": 1787853890, "git_changesets": ["77f771c88354dec2f3fa457e1b049f17fe80cec2"], "user": "ffxbld@lando.moz.tools"}, "28259": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066924: use 136.0 as the last-watershed for linux-aarch64 on the release channel  a=dmeehan DONTBUILD\n\n136.0b6 is _technically_ the most correct version, I guess, because it's the first one we shipped, and updates could theoretically be done from that version to an RC. In practice this probably doesn't happen, and the `compare-directories.py` doesn't support the scenario. Additionally, it's probably better to test an old version on the release channel than on the beta channel, as there is a much greater chance of updates actually happening from 136.0 -\u003e latest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321820\n", "files": ["taskcluster/kinds/test-update-integrity/kind.yml"], "git_node": "2ac363fbf1001356deb720c3b2e277015c1f85d9", "git_parents": ["e9b541688e8212c9bdf6724b1d8ed6260c5f2fc4"], "node": "5a732c12f48edf561513bce64501bd9ac8394ec9", "parents": ["ad0c2ee9a5fe36f519f395b69fda38027066c8bb"], "tags": []}], "date": 1787869856, "git_changesets": ["2ac363fbf1001356deb720c3b2e277015c1f85d9"], "user": "dmeehan@mozilla.com"}, "28260": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321978\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.js