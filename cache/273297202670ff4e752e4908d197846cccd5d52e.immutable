c3822eb46b696", "parents": ["7846694a7af80702003318c56e1e589b3509a99e"], "tags": []}, {"author": "Martin Sirringhaus \u003cmartin.sirringhaus@suse.com\u003e", "branch": "default", "desc": "Bug 1868975 - Part 2: Add logging section to about-page (r=fluent-reviewers,flod,mfarrell)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D195862\n", "files": ["dom/webauthn/authrs_bridge/src/lib.rs", "dom/webauthn/authrs_bridge/src/test_token.rs", "toolkit/components/aboutwebauthn/content/aboutWebauthn.css", "toolkit/components/aboutwebauthn/content/aboutWebauthn.html", "toolkit/components/aboutwebauthn/content/aboutWebauthn.js", "toolkit/components/aboutwebauthn/tests/browser/browser.toml", "toolkit/components/aboutwebauthn/tests/browser/browser_aboutwebauthn_aria_keycontrols.js", "toolkit/components/aboutwebauthn/tests/browser/browser_aboutwebauthn_info.js", "toolkit/components/aboutwebauthn/tests/browser/browser_aboutwebauthn_logging.js", "toolkit/components/aboutwebauthn/tests/browser/browser_aboutwebauthn_logging_e2e.js", "toolkit/components/aboutwebauthn/tests/browser/browser_aboutwebauthn_no_token.js", "toolkit/components/aboutwebauthn/tests/browser/dummy_page.html", "toolkit/locales/en-US/toolkit/about/aboutWebauthn.ftl"], "git_node": "f1d9ab362903155ab8ec2282fec1391c8e932096", "git_parents": ["a8d8b88ab901bf92a283c0c576ce95c03c075033"], "node": "4153d6785946d9f191227772ad23afff95003826", "parents": ["70a55e263825fed97a1a05f8734c3822eb46b696"], "tags": []}, {"author": "Martin Sirringhaus \u003cmartin.sirringhaus@suse.com\u003e", "branch": "default", "desc": "Bug 1868975 - Part 3: Only send logging to JS if activated. (r=mfarrell)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D196283\n", "files": ["dom/webauthn/AndroidWebAuthnService.cpp", "dom/webauthn/MacOSWebAuthnService.mm", "dom/webauthn/WebAuthnService.cpp", "dom/webauthn/WinWebAuthnService.cpp", "dom/webauthn/authrs_bridge/src/lib.rs", "dom/webauthn/nsIWebAuthnService.idl", "toolkit/components/aboutwebauthn/content/aboutWebauthn.js", "toolkit/components/aboutwebauthn/tests/browser/browser_aboutwebauthn_logging_e2e.js"], "git_node": "2024e90df3e55391b89122d6a9d317a1026c90f8", "git_parents": ["f1d9ab362903155ab8ec2282fec1391c8e932096"], "node": "e98520026a95a1b2109d7da5c76330e393c7e933", "parents": ["4153d6785946d9f191227772ad23afff95003826"], "tags": []}], "date": 1794477130, "git_changesets": ["80d3ad15b20332391856b5c39ccd7968b550cf14", "e938f6a8c5b1455e1f7846f4525a1bf959c0ac70", "775ff5bf302e389b353182b0a7509bc2e120981d", "3c6878439a18e216678b69e91fe32503a28e9c67", "dd896d999edaa984ec91545b7a73b34395e71ad1", "dda256c08bcd507d612b439d430e083d3ff8b6f7", "6ca3f8339885213ac51f6eb983e992353b64a546", "75409b397d6d9ed3062703e84682d027fc1a5d0f", "01011b5e7c36229f4c04e91583493409870984ae", "a3fe01524f7091432fb25472d6d186d028555874", "dc5aa1fd2c636adea93ad0351a21ea57eb206923", "b3940214ff93a3f00edeaaf7df36b0217310eec7", "695cd95c63fac302fd1b3c32d897c90c0237a5f8", "e5ef8e6bd92800fa7216abbf022e991be9315d94", "08f7028726014693ad8356956d27830e65875e26", "5513b747c66f8c00a07fcb3e3511c5f2072c7982", "a034e5f88fcb6f6c82e2d9aa3744f789ad296a9d", "4127e4aeb0928391142e2677b0b3b25f3d171a30", "d20978279cac05ceac7318cdb6723e92169c24c6", "a5db01b1e47b321a9911eea39cc0711573239bf3", "e276d0c68da64836c6916e1629e7b3adffcd040d", "aba83d89405e08eb6b777bebae79f69a8baccd36", "7b6f31af730e1feceb8679ae70984999d32afe13", "b6bb960dad487444aa9230aa406bcb392777ea92", "a8d8b88ab901bf92a283c0c576ce95c03c075033", "f1d9ab362903155ab8ec2282fec1391c8e932096", "2024e90df3e55391b89122d6a9d317a1026c90f8"], "user": "asilaghi@mozilla.com"}, "45769": {"changesets": [{"author": "calixteman \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2091852 - Wait for about:pdf transitions in the file picker test. r=marco\n\nKeep the picker open through the wait to avoid the vsync failures reported\nin bug 2091848.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341942\n", "files": ["toolkit/components/aboutpdf/tests/browser/browser_aboutPDF_actor.js"], "git_node": "bd15dc1b907c62a8a286ca64823d0d0592806309", "git_parents": ["2024e90df3e55391b89122d6a9d317a1026c90f8"], "node": "624af760951d61649638d118948895c719c81b05", "parents": ["e98520026a95a1b2109d7da5c76330e393c7e933"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2089946. Use highp precision in the accelerated Canvas2D blur fragment shader. r=lsalzman\n\nThe blur fragment shader builds its Gaussian weights by repeatedly multiplying\nby exp(-0.5/sigma^2). On GPUs that implement mediump as fp16 (Mali, for\nexample) that ratio rounds to exactly 1.0 for sigma above about 45, so every\ntap gets the same weight and the blur degenerates into an over-bright box\nfilter that saturates and ends in a hard edge at the support radius. Smaller\nsigmas get a too narrow Gaussian that is normalized as if it were the right\nwidth, so the shadow is too faint.\n\nThe test adds a shadowBlur 120 case on a 400x400 canvas to\nshadowBlur_gaussian_tolerance.1.html. The existing cases didn't reach this\ncode: their canvases are below the size we accelerate and their sigmas are\ntoo small to break. The new case fails without the fix and passes with it on\na Pixel 8 (Mali-G715, 10 bit mediump), but it can't catch a regression in our\nCI. That needs a GPU that implements mediump as fp16 running accelerated\nCanvas2D, and none of our CI machines have one: desktop GPUs and the Android\nemulator use fp32, and the test passes without the fix on the Samsung A55\nhardware workers too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341792\n", "files": ["dom/canvas/DrawTargetWebgl.cpp", "testing/web-platform/tests/html/canvas/element/manual/shadows/shadowBlur_gaussian_tolerance.1.html"], "git_node": "af64cd46b5c6daf643cbc43850099369b4eb2c59", "git_parents": ["bd15dc1b907c62a8a286ca64823d0d0592806309"], "node": "289d6b2733e2296554d500a47213df43e61965cc", "parents": ["624af760951d61649638d118948895c719c81b05"], "tags": []}, {"author": "Mirko Kerezovic \u003cmirko@kerezovic.de\u003e", "branch": "default", "desc": "Bug 2089965 - Remove dead separator checks in display list effect dumps. r=tnikkel,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342008\n", "files": ["layout/painting/nsDisplayList.cpp"], "git_node": "3c0fdd37206514ab8b35116ca99032552fd6aa89", "git_parents": ["af64cd46b5c6daf643cbc43850099369b4eb2c59"], "node": "b0cff9f9e691526cd92e1863d8e4150a82160f8e", "parents": ["289d6b2733e2296554d500a47213df43e61965cc"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2084900 [Linux] Add BufferSurface::SupportsDirectComposition() flag to configure direct offload to Wayland compositor r=emilio,gtk-reviewers\"\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337035\n", "files": ["widget/gtk/BufferSurface.cpp", "widget/gtk/BufferSurface.h"], "git_node": "1c86c34d981dbf2c855c4330d5e834158db6af88", "git_parents": ["3c0fdd37206514ab8b35116ca99032552fd6aa89"], "node": "09c0004ebc37b78fd3ac7b5d7dd2dea5a3fc35a6", "parents": ["b0cff9f9e691526cd92e1863d8e4150a82160f8e"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2084900 [Linux] Export BufferSurface from WaylandBuffer r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337036\n", "files": ["widget/gtk/WaylandBuffer.h"], "git_node": "b77613c9e798211390cad781da1022fc2e4cca42", "git_parents": ["1c86c34d981dbf2c855c4330d5e834158db6af88"], "node": "2ae6157b0f1f3927e55bb4764f5bc83d4b9d7ca8", "parents": ["09c0004ebc37b78fd3ac7b5d7dd2dea5a3fc35a6"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2084900 [Linux] Implement SHMBufSurface::MapPlane() and remove YCbCrDescriptor from SHMSurface r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337037\n", "files": ["widget/gtk/SHMBufSurface.cpp", "widget/gtk/SHMBufSurface.h"], "git_node": "696bc7be27408980dac431fa4ed6ab9b129ce87d", "git_parents": ["b77613c9e798211390cad781da1022fc2e4cca42"], "node": "f1716bfa43877e27ec8ab60bf7cb1433eae61a13", "parents": ["2ae6157b0f1f3927e55bb4764f5bc83d4b9d7ca8"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2084900 [Linux] Merge WaylandTextureHost and RenderDMABUFTextureHost to RenderLinuxTextureHost r=lsalzman,gfx-reviewers\n\nImplement RenderLinuxTextureHost as unified texture host for both DMABuf and SHM backends.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337038\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/NativeLayerWayland.h", "gfx/webrender_bindings/RenderDMABUFTextureHost.cpp", "gfx/webrender_bindings/RenderDMABUFTextureHost.h", "gfx/webrender_bindings/RenderLinuxTextureHost.cpp", "gfx/webrender_bindings/RenderLinuxTextureHost.h", "gfx/webrender_bindings/RenderWaylandTextureHost.cpp", "gfx/webrender_bindings/RenderWaylandTextureHost.h", "gfx/webrender_bindings/moz.build"], "git_node": "baac3a7a64b944f6b7f7a6abc31a4844451bc778", "git_parents": ["696bc7be27408980dac431fa4ed6ab9b129ce87d"], "node": "adcebb2a4e7bf306897291aabf654ee332cd9a26", "parents": ["f1716bfa43877e27ec8ab60bf7cb1433eae61a13"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2084900 [Linux] Use RenderLinuxTextureHost for Wayland compositor and make direct composition optional r=gfx-reviewers,bradwerth\n\n- Replace RenderWaylandTextureHost/RenderDMABUFTextureHost with RenderLinuxTextureHost\n- Configure direct composition per host state, as it depends on compositor support & buffer format.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337039\n", "files": ["gfx/layers/composite/TextureHost.cpp", "gfx/layers/opengl/DMABUFTextureHostOGL.cpp", "gfx/webrender_bindings/RenderCompositorLayerNative.cpp", "gfx/webrender_bindings/RenderCompositorNative.cpp", "gfx/webrender_bindings/RenderTextureHost.h", "gfx/webrender_bindings/RenderTextureHostWrapper.cpp", "gfx/webrender_bindings/RenderTextureHostWrapper.h", "gfx/webrender_bindings/RendererOGL.cpp"], "git_node": "7668013e60d4a1695dea0891919e0706f2c71bbf", "git_parents": ["baac3a7a64b944f6b7f7a6abc31a4844451bc778"], "node": "c06f3728ee0e97c337df54a9d248a1fda81ffeb0", "parents": ["adcebb2a4e7bf306897291aabf654ee332cd9a26"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091476 - Recover from bad pretenuring decisions for wasm alloc sites r=spidermonkey-reviewers,rhunt\n\nThis extends the existing recovery system to apply to wasm code too.\n\nThis patch reduces total GC time by 40% in the j2cl-box2d-wasm benchmark when\nrun in the shell.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341853\n", "files": ["js/src/gc/GC.cpp", "js/src/gc/Pretenuring.cpp", "js/src/gc/Pretenuring.h", "js/src/gc/Zone.cpp", "js/src/gc/Zone.h", "js/src/wasm/WasmInstance.cpp", "js/src/wasm/WasmInstance.h", "js/src/wasm/WasmRealm.cpp", "js/src/wasm/WasmRealm.h"], "git_node": "8477bbe5509c68a7802475eb61b5b19f6068ea76", "git_parents": ["7668013e60d4a1695dea0891919e0706f2c71bbf"], "node": "5c1ac1ba5dd0cbe8975512676656fa710b3a081d", "parents": ["c06f3728ee0e97c337df54a9d248a1fda81ffeb0"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086676 - Rename the \"URLBar - \u003cname\u003e\" log modules to \"URLBar\". r=urlbar-reviewers,mak\n\nMOZ_LOG could not configure the \"URLBar - \u003cname\u003e\" modules: it reads the\nspaces as separators. The loggers now log to the \"URLBar\" module, with\ntheir name as prefix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338258\n", "files": ["browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/docs/debugging.md"], "git_node": "02bc159ab8f4c2066d747ab031fb18bf5a5845ed", "git_parents": ["8477bbe5509c68a7802475eb61b5b19f6068ea76"], "node": "0501bd0aeea9f460383904390a0eb3dfdf8be2b9", "parents": ["5c1ac1ba5dd0cbe8975512676656fa710b3a081d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2091539 - Rename the windows11-64-24h2-artifact test platform to windows11-64-25h2-artifact, r=taskgraph-reviewers,jcristau.\n\nIts tasks already run on the 25h2 workers; only the name was left behind by\nthe 25h2 migration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341579\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/worker.py", "taskcluster/test_configs/test-platforms.yml"], "git_node": "e6ad739cadfaa056b9544822ec9a52d0ded8416b", "git_parents": ["02bc159ab8f4c2066d747ab031fb18bf5a5845ed"], "node": "f9adabf56925d126bea6b09cc214021227be4f59", "parents": ["0501bd0aeea9f460383904390a0eb3dfdf8be2b9"], "tags": []}, {"author": "RuslanSemchenko \u003cuncleruc2075@gmail.com\u003e", "branch": "default", "desc": "Bug 1874084 - Guard null mStartTime in SpeechDispatcher OnSpeechEvent r=media-webspeech-reviewers,pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341906\n", "files": ["dom/media/webspeech/synth/speechd/SpeechDispatcherService.cpp"], "git_node": "b08a9cbe6b29bc304470dd24d7c560ce3fd4ac89", "git_parents": ["e6ad739cadfaa056b9544822ec9a52d0ded8416b"], "node": "5b01f84dd9fe62c0293c58e1cdcde9befa81f5e2", "parents": ["f9adabf56925d126bea6b09cc214021227be4f59"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2091957 - Flush native fence commands before exporting the fence FD in RenderCompositorEGL::EndFrame() r=gfx-reviewers,lsalzman\n\nAdd glFlush() after creating the EGL native fence and before calling eglDupNativeFenceFDANDROID(). This ensures the native fence is created before its file descriptor is exported for release synchronization.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342007\n", "files": ["gfx/webrender_bindings/RenderCompositorEGL.cpp"], "git_node": "c5359a34e43e945a9a09e31922c18bbdb351f5df", "git_parents": ["b08a9cbe6b29bc304470dd24d7c560ce3fd4ac89"], "node": "50aaefe74e1e54fea961ed63e86ebd1dc6fd7ae6", "parents": ["5b01f84dd9fe62c0293c58e1cdcde9befa81f5e2"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2091460 - Remove the session-count check from test_http2_fin_buffered.js. r=necko-reviewers,kershaw\n\nHappy Eyeballs can complete a second, unused HTTP/2 session; the response checks already cover bug 2089558.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341873\n", "files": ["netwerk/test/unit/test_http2_fin_buffered.js"], "git_node": "3b6cf03683b95b33deaaf26d3bc457a5e65721a3", "git_parents": ["c5359a34e43e945a9a09e31922c18bbdb351f5df"], "node": "e588880e32e31e478c8b5d1d7e61ccc125c5132c", "parents": ["50aaefe74e1e54fea961ed63e86ebd1dc6fd7ae6"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087938 - Don't assert that expired shared surfaces still have consumers. r=gfx-reviewers,gw\n\nSharedSurfacesParent::ExpireMap runs without sMutex, so a surface taken out\nof the expiration tracker can lose its last consumer through Release or\nRemoveAll before it is unmapped. Unmapping such a surface is harmless: it\nkeeps its handle and Map maps it again on demand.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341381\n", "files": ["gfx/layers/ipc/SharedSurfacesParent.cpp"], "git_node": "777ebc3578bad201299c327df6a144ed56f89743", "git_parents": ["3b6cf03683b95b33deaaf26d3bc457a5e65721a3"], "node": "6e4909a229d036a2428fe1e21012fd4ede9cfe58", "parents": ["e588880e32e31e478c8b5d1d7e61ccc125c5132c"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091307 - remove $ and # restrict tokens r=urlbar-reviewers,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341723\n", "files": ["browser/components/urlbar/UrlbarProviderAutofill.sys.mjs", "browser/components/urlbar/UrlbarProviderPlaces.sys.mjs", "browser/components/urlbar/UrlbarProvidersManager.sys.mjs", "browser/components/urlbar/UrlbarTokenizer.sys.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/unit/test_special_search.js", "browser/components/urlbar/tests/unit/test_tokenizer.js"], "git_node": "23cc4bf21a875100492c3436432412ba64dc1ab1", "git_parents": ["777ebc3578bad201299c327df6a144ed56f89743"], "node": "3c291c30b88d16689acb46bded2b02c5c2129395", "parents": ["6e4909a229d036a2428fe1e21012fd4ede9cfe58"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090300 - Fix message ordering issue between SW and Worker. r=dom-worker-reviewers,edenchuang\n\nIt seems like in Firefox the message from the SW could arrive after the\nWorker message, which would cause intermittent failures.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341410\n", "files": ["testing/web-platform/tests/connection-allowlist/tentative/resources/sw-intercept-and-fetch.js", "testing/web-platform/tests/connection-allowlist/tentative/service-worker-dedicated-worker.https.sub.window.js", "testing/web-platform/tests/connection-allowlist/tentative/service-worker-shared-worker.https.sub.window.js"], "git_node": "4253cabfe69b44773c4e124fbeaaa92b0d896780", "git_parents": ["23cc4bf21a875100492c3436432412ba64dc1ab1"], "node": "56eba9f609ef141a724bbec42d1a81762c0426ab", "parents": ["3c291c30b88d16689acb46bded2b02c5c2129395"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091325 - Enable gfx.webrender.svg-images.opacity. r=gfx-reviewers,tnikkel,firefox-svg-reviewers,jwatt\n\nSVG \u003cimage\u003e elements with opacity are drawn as WebRender images, with the opacity folded into the image color.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342023\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "00db5152fe152ea7103ae5532a8930b49ab9fab6", "git_parents": ["4253cabfe69b44773c4e124fbeaaa92b0d896780"], "node": "ecd9d379c47f7bcc69780bffec3a6d4db8a74142", "parents": ["56eba9f609ef141a724bbec42d1a81762c0426ab"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091325 - Enable gfx.webrender.svg-shapes.blend. r=gfx-reviewers,tnikkel,jwatt\n\nSVG shapes and images with mix-blend-mode are drawn with WebRender primitives.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342024\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "6ef9361b4a9c11ec230532087a5f9b9e0560c4ab", "git_parents": ["00db5152fe152ea7103ae5532a8930b49ab9fab6"], "node": "bcf273348401dc63e62c8e7bca69dff1e7460c2d", "parents": ["ecd9d379c47f7bcc69780bffec3a6d4db8a74142"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 1982766 - Implement parsing and computation of border-shape. r=emilio,firefox-style-system-reviewers\n\nImplement the border-shape property from css-borders-4 as a parse and\ncompute only longhand, behind the layout.css.border-shape.enabled pref\n(on in Nightly). The value is none or one or two [\u003cbasic-shape\u003e\n\u003cgeometry-box\u003e?] components, stored as a ThinVec of components, reusing\nthe existing BasicShape machinery.\n\nThe specified value keeps an omitted \u003cgeometry-box\u003e as Optional::None so\nit serializes as written. The computed value resolves omitted boxes to\ntheir positional defaults (half-border-box for a lone shape, border-box\nand padding-box for a pair), collapses a pair that resolves to the same\ncomponent, and elides boxes matching those defaults when serializing,\nfollowing the Chromium/WPT behavior in border-shape-computed.html.\n\nThe property animates discretely for now. Rendering is not implemented\nyet; the remaining border-shape WPTs keep their FAIL expectations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341191\n", "files": ["devtools/server/actors/animation-type-longhand.js", "dom/base/use_counter_metrics.yaml", "layout/style/ServoBindings.toml", "layout/style/nsStyleStruct.cpp", "layout/style/nsStyleStruct.h", "layout/style/test/property_database.js", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/properties/longhands.toml", "servo/components/style/values/computed/basic_shape.rs", "servo/components/style/values/generics/basic_shape.rs", "servo/components/style/values/specified/basic_shape.rs", "servo/ports/geckolib/cbindgen.toml", "testing/web-platform/meta/css/css-borders/border-shape/__dir__.ini", "testing/web-platform/meta/css/css-borders/border-shape/border-shape-animation.html.ini", "testing/web-platform/meta/css/css-borders/tentative/parsing/border-shape-computed.html.ini", "testing/web-platform/meta/css/css-borders/tentative/parsing/border-shape-invalid.html.ini", "testing/web-platform/meta/css/css-borders/tentative/parsing/border-shape-valid.html.ini", "testing/web-platform/tests/css/css-borders/tentative/parsing/border-shape-valid.html"], "git_node": "d3eff8022305badb3e49c4e31fc5a611385384c2", "git_parents": ["6ef9361b4a9c11ec230532087a5f9b9e0560c4ab"], "node": "525b64772652b355fafd0272b68e8adcc153ff1b", "parents": ["bcf273348401dc63e62c8e7bca69dff1e7460c2d"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 1982766 - Part 2: Implement painting of border-shape. r=emilio,firefox-style-system-reviewers,layout-reviewers\n\nPaint the border of a frame with border-shape set as the shape(s)\ninstead of the regular border geometry:\n\n- A single shape is stroked, centered on its path, with the used\n  border-top-width. Its reference box defaults to half-border-box.\n- A pair of shapes fills the area between the outer and inner shape\n  (even-odd fill) with the border color. The reference boxes default\n  to border-box / padding-box.\n\nThe background painting area is clipped to the outer shape, and\nborder-radius is ignored while border-shape is in effect, per\ncss-borders-4. Backgrounds and borders of such frames are no longer\nconsidered opaque or uniform and fall back from the simple WebRender\nitems to the fallback painting path.\n\nShape-to-path conversion reuses the clip-path machinery through the\nnew static CSSClipPathInstance::CreateBasicShapePath.\n\nThe border display item bounds and the frame's ink overflow account\nfor margin-box geometry and the centered stroke.\n\nWPT expectations: the reftests covering border/background painting\nnow pass (some only differ from their references by anti-aliasing,\nwhich the fuzzy annotations cover). Outline, box-shadow, overflow\nclipping of child content, hit-testing and animation of border-shape\nremain for follow-ups and keep FAIL expectations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341208\n", "files": ["layout/generic/nsIFrame.cpp", "layout/painting/nsCSSRendering.cpp", "layout/painting/nsCSSRendering.h", "layout/painting/nsDisplayList.cpp", "layout/painting/nsDisplayList.h", "layout/style/nsStyleStruct.h", "layout/svg/CSSClipPathInstance.cpp", "layout/svg/CSSClipPathInstance.h", "testing/web-platform/meta/css/css-borders/border-shape/border-shape-clips-background.html.ini", "testing/web-platform/meta/css/css-borders/border-shape/border-shape-geometry-box.html.ini", "testing/web-platform/meta/css/css-borders/border-shape/border-shape-ignore-radius.html.ini", "testing/web-platform/meta/css/css-borders/border-shape/border-shape-inner-outer.html.ini", "testing/web-platform/meta/css/css-borders/border-shape/border-shape-overflow-child-clip.html.ini", "testing/web-platform/meta/css/css-borders/border-shape/border-shape-overflow-replaced-canvas.html.ini", "testing/web-platform/meta/css/css-borders/border-shape/border-shape-overflow-replaced-iframe.html.ini", "testing/web-platform/meta/css/css-borders/border-shape/border-shape-overflow-replaced-img.html.ini", "testing/web-platform/meta/css/css-borders/border-shape/border-shape-polygon-miter-limit.html.ini", "testing/web-platform/meta/css/css-borders/border-shape/border-shape-shape-arc-miter-limit.html.ini"], "git_node": "34cd3621539b7ce336f4d4636a459bfd1cae4248", "git_parents": ["d3eff8022305badb3e49c4e31fc5a611385384c2"], "node": "582c722a79b5d5a22e307e6f7036a935d2b2e0f2", "parents": ["525b64772652b355fafd0272b68e8adcc153ff1b"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2044348 - Enable headingoffset by default r=dom-core-reviewers,jjaschke,devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340303\n", "files": ["devtools/client/webconsole/test/browser/browser_webconsole_object_inspector_entries.snapshot.mjs", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/dom/idlharness.https.html.ini"], "git_node": "9a0c3fd60561fe25a4a607ae8b5db6018c1254dd", "git_parents": ["34cd3621539b7ce336f4d4636a459bfd1cae4248"], "node": "32c776075ab2d958f9a426c3bf6717bce65c1fdf", "parents": ["582c722a79b5d5a22e307e6f7036a935d2b2e0f2"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090041 - Quota manager: replace old telemetry introduced by bug 2066750 by a new one which also includes the error type. r=dom-storage-reviewers,jari\n\nThe \"corruption errors\" had two root causes: one being transient, and the other one being permanent, which is far more serious: we need to be able to tell them apart.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340537\n", "files": ["dom/quota/OriginOperations.cpp", "dom/quota/metrics.yaml"], "git_node": "f753bf082e9bcf805e7a03326cce29b086df9eae", "git_parents": ["9a0c3fd60561fe25a4a607ae8b5db6018c1254dd"], "node": "ce6ce3927b499d1b941610b3c16ef9ef9276c133", "parents": ["32c776075ab2d958f9a426c3bf6717bce65c1fdf"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2066057 - Use ECMAMap for IntersectionObserver targets. r=layout-reviewers,emilio\n\nUse the insertion-ordered map from bug 2030981 for target membership,\nthreshold state, and iteration. This makes removal amortized O(1) and\navoids a hash lookup for each target during intersection updates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320865\n", "files": ["dom/base/DOMIntersectionObserver.cpp", "dom/base/DOMIntersectionObserver.h"], "git_node": "978cd007380834e5b410306ef0ea7926845747a0", "git_parents": ["f753bf082e9bcf805e7a03326cce29b086df9eae"], "node": "70ab9d1ef923182f5e631056f104d7eb7298fa58", "parents": ["ce6ce3927b499d1b941610b3c16ef9ef9276c133"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084027 - Don't select print-reftests for per-test WPT runs on Android r=jgraham\n\nThe firefox_android wptrunner product has no print-reftest executor. When a push modifies a print-reftest, per-test mode (TV/TCw) on Android still schedules it, and wptrunner then only logs \"Unsupported test type print-reftest\". No test is counted as run or skipped, so the job fails with \"No tests ran\".\n\nThe fix leaves print-reftest out of the WPT test types per-test mode selects when buildapp is mobile/android. Desktop behaviour does not change.\n\nFollow-up, not in this patch: wptrunner's `_cleanup_run_loop` also throws an AttributeError (`current_group` is None) when there are no tests to run. That traceback is noise and does not cause this failure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341645\n", "files": ["testing/mozharness/mozharness/mozilla/testing/per_test_base.py"], "git_node": "1d160aeff40992910e7145f890bbe2b666c25ec7", "git_parents": ["978cd007380834e5b410306ef0ea7926845747a0"], "node": "96f4959515ea9a974ed84785e5bf4e44263f3c7f", "parents": ["70ab9d1ef923182f5e631056f104d7eb7298fa58"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089498 - Add Tainted::ValidateRef. r=nika,ipc-reviewers\n\nThis validates a tainted value with a function returning bool, instead of\ncombining MOZ_IS_VALID with MOZ_NO_VALIDATE, and returns a Maybe reference to\nthe untainted value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340284\n", "files": ["dom/ipc/ContentParent.h", "ipc/glue/BackgroundParent.h", "ipc/glue/BackgroundParentImpl.cpp", "mfbt/Tainting.h", "mfbt/tests/gtest/TestTainting.cpp"], "git_node": "41d3d93c8b8df40cf0ad202486c6cbcdee007608", "git_parents": ["1d160aeff40992910e7145f890bbe2b666c25ec7"], "node": "614c3ca617d02dc1e607de65de25f9635393b01d", "parents": ["96f4959515ea9a974ed84785e5bf4e44263f3c7f"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089498 - Support [Tainted] on IPDL structs and unions. r=nika,ipc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339974\n", "files": ["ipc/docs/ipdl.md", "ipc/ipdl/ipdl/lower.py", "ipc/ipdl/ipdl/type.py", "ipc/ipdl/test/ipdl/error/PNoTaintUntaintedStruct.ipdl", "ipc/ipdl/test/ipdl/ok/PTaintedCompound.ipdl", "ipc/ipdl/test/ipdl/ok/TaintedCompoundHeader.ipdlh"], "git_node": "ae7d034601b1a37af22149c80200222834abe54d", "git_parents": ["41d3d93c8b8df40cf0ad202486c6cbcdee007608"], "node": "a41ccd822aa75b22c2d3351ab00401077abfe86f", "parents": ["614c3ca617d02dc1e607de65de25f9635393b01d"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089498 - Apply [Tainted] to IPCClientInfo. r=dom-worker-reviewers,ipc-reviewers,nika,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339975\n", "files": ["dom/clients/manager/ClientHandleParent.cpp", "dom/clients/manager/ClientIPCTypes.ipdlh", "dom/clients/manager/ClientManagerParent.cpp", "dom/clients/manager/ClientManagerParent.h", "dom/clients/manager/ClientValidation.cpp", "dom/clients/manager/ClientValidation.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/serviceworkers/ServiceWorkerContainerParent.cpp", "dom/serviceworkers/ServiceWorkerContainerParent.h", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/BackgroundParentImpl.h"], "git_node": "834d2a5bfe68c0958b7c34f27b17fc2b4efbc587", "git_parents": ["ae7d034601b1a37af22149c80200222834abe54d"], "node": "8487d1400c923f42541e3d06db97c11d78d925f1", "parents": ["a41ccd822aa75b22c2d3351ab00401077abfe86f"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087441 - Record markers for bugbug requests in decision task resource usage profiles. r=marco,taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338269\n", "files": ["taskcluster/gecko_taskgraph/util/bugbug.py"], "git_node": "e47a7b0d21ff3fc7a8bb3315130ed43d7a82a13c", "git_parents": ["834d2a5bfe68c0958b7c34f27b17fc2b4efbc587"], "node": "89ec900a7f462e5a916f132aec3b75963fd0d9cf", "parents": ["8487d1400c923f42541e3d06db97c11d78d925f1"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087441 - Poll bugbug for push schedules every 2 seconds rather than 10. r=marco,taskgraph-reviewers,bhearsum\n\nGenerating the test kinds' tasks waits on bugbug, so polling less often left\nthem waiting up to 10 seconds after its results were ready.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338271\n", "files": ["taskcluster/gecko_taskgraph/util/bugbug.py"], "git_node": "f2f49ae3e86319662fc0800f85767e4bca6cd6ce", "git_parents": ["e47a7b0d21ff3fc7a8bb3315130ed43d7a82a13c"], "node": "5f7258f16fd52880c3e653a9c09cfdb173caec06", "parents": ["89ec900a7f462e5a916f132aec3b75963fd0d9cf"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087441 - make a single bugbug query, and share its results. r=taskgraph-reviewers,bhearsum\n\nWe were making the same bugbug query from various test kinds and the\noptimizer (the cache is ineffective since taskgraph went multiprocess).\nThe decision task now makes that query as soon as it starts, on autoland\nand on try pushes using the bugbug test manifest loader, and writes its\nresult to a file named in the environment, which reaches those processes\nhowever taskgraph starts them, and push_schedules waits for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338272\n", "files": ["taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/test/test_decision.py", "taskcluster/gecko_taskgraph/test/test_optimize_strategies.py", "taskcluster/gecko_taskgraph/test/test_util_bugbug.py", "taskcluster/gecko_taskgraph/util/bugbug.py", "taskcluster/mach_commands.py"], "git_node": "f58ba914548a9183b3aba2930ace189be9b3682d", "git_parents": ["f2f49ae3e86319662fc0800f85767e4bca6cd6ce"], "node": "ac248e480d51effd597b2f4ec7d288595fb4ea80", "parents": ["5f7258f16fd52880c3e653a9c09cfdb173caec06"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066057 - Use ECMAMap for IntersectionObserver targets. r=layout-reviewers,emilio\" for causing bulild bustages at /DOMIntersectionObserver.cpp\n\nThis reverts commit 978cd007380834e5b410306ef0ea7926845747a0.\n", "files": ["dom/base/DOMIntersectionObserver.cpp", "dom/base/DOMIntersectionObserver.h"], "git_node": "a59c9febc80e4ea9d1af6c7beffd228db3ac7829", "git_parents": ["f58ba914548a9183b3aba2930ace189be9b3682d"], "node": "2717811be0c1a39aeba7a27c434488cfc4bd772f", "parents": ["ac248e480d51effd597b2f4ec7d288595fb4ea80"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084900 [Linux] Use RenderLinuxTextureHost for Wayland compositor and make direct composition optional r=gfx-reviewers,bradwerth\" for causing reftests failures at color_quads\n\nThis reverts commit 7668013e60d4a1695dea0891919e0706f2c71bbf.\n\nRevert \"Bug 2084900 [Linux] Merge WaylandTextureHost and RenderDMABUFTextureHost to RenderLinuxTextureHost r=lsalzman,gfx-reviewers\"\n\nThis reverts commit baac3a7a64b944f6b7f7a6abc31a4844451bc778.\n\nRevert \"Bug 2084900 [Linux] Implement SHMBufSurface::MapPlane() and remove YCbCrDescriptor from SHMSurface r=emilio,gtk-reviewers\"\n\nThis reverts commit 696bc7be27408980dac431fa4ed6ab9b129ce87d.\n\nRevert \"Bug 2084900 [Linux] Export BufferSurface from WaylandBuffer r=emilio,gtk-reviewers\"\n\nThis reverts commit b77613c9e798211390cad781da1022fc2e4cca42.\n\nRevert \"Bug 2084900 [Linux] Add BufferSurface::SupportsDirectComposition() flag to configure direct offload to Wayland compositor r=emilio,gtk-reviewers\"\"\n\nThis reverts commit 1c86c34d981dbf2c855c4330d5e834158db6af88.\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/NativeLayerWayland.h", "gfx/layers/composite/TextureHost.cpp", "gfx/layers/opengl/DMABUFTextureHostOGL.cpp", "gfx/webrender_bindings/RenderCompositorLayerNative.cpp", "gfx/webrender_bindings/RenderCompositorNative.cpp", "gfx/webrender_bindings/RenderDMABUFTextureHost.cpp", "gfx/webrender_bindings/RenderDMABUFTextureHost.h", "gfx/webrender_bindings/RenderLinuxTextureHost.cpp", "gfx/webrender_bindings/RenderLinuxTextureHost.h", "gfx/webrender_bindings/RenderTextureHost.h", "gfx/webrender_bindings/RenderTextureHostWrapper.cpp", "gfx/webrender_bindings/RenderTextureHostWrapper.h", "gfx/webrender_bindings/RenderWaylandTextureHost.cpp", "gfx/webrender_bindings/RenderWaylandTextureHost.h", "gfx/webrender_bindings/RendererOGL.cpp", "gfx/webrender_bindings/moz.build", "widget/gtk/BufferSurface.cpp", "widget/gtk/BufferSurface.h", "widget/gtk/SHMBufSurface.cpp", "widget/gtk/SHMBufSurface.h", "widget/gtk/WaylandBuffer.h"], "git_node": "234699f276e64daa620b6e7291574ac5f68cd68e", "git_parents": ["a59c9febc80e4ea9d1af6c7beffd228db3ac7829"], "node": "51988cb1a3db73a9d69db5ddb81614f512a2490e", "parents": ["2717811be0c1a39aeba7a27c434488cfc4bd772f"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1827766 - Part 1: Move TelemetryEvent and bounce tracking into UrlbarSession.sys.mjs - r=urlbar-reviewers,daisuke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341727\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarSession.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/moz.build", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_disable.js", "browser/modules/URILoadingHelper.sys.mjs", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "ae670369837e7e47f00a98bda826f706ab4a8cde", "git_parents": ["234699f276e64daa620b6e7291574ac5f68cd68e"], "node": "08320733310a83513928be011ff9c6fe71d7eb21", "parents": ["51988cb1a3db73a9d69db5ddb81614f512a2490e"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1827766 - Part 2: Rename TelemetryEvent to UrlbarSession and UrlbarChildTelemetry to UrlbarChildSession - r=urlbar-reviewers,daisuke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341728\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarSession.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarChildSession.mjs", "browser/components/urlbar/content/UrlbarChildTelemetry.mjs", "browser/components/urlbar/docs/telemetry.md", "browser/components/urlbar/jar.mn", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_disable.js", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_record_preferences.js", "tools/@types/generated/tspaths.json"], "git_node": "43f102b71c0d6a0bc1dd1aaac9679c643b797478", "git_parents": ["ae670369837e7e47f00a98bda826f706ab4a8cde"], "node": "aa72d55a22fb659757d0d244b0fe12dd931dcf88", "parents": ["08320733310a83513928be011ff9c6fe71d7eb21"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1827766 - Part 3: Make bounce tracking static public methods of UrlbarSession and rename engagementEvent to session - r=urlbar-reviewers,daisuke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341729\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarSearchOneOffs.sys.mjs", "browser/components/urlbar/UrlbarSession.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_reenter.js", "browser/components/urlbar/tests/browser-engagementTelemetry/head-sap.js", "browser/components/urlbar/tests/browser-engagementTelemetry/head.js", "browser/components/urlbar/tests/browser-quickactions/browser_general.js", "browser/components/urlbar/tests/browser/browser_splitbutton.js", "browser/modules/URILoadingHelper.sys.mjs"], "git_node": "36b2a0e7e34040a729c4ed6b031ddc46bacf0ac0", "git_parents": ["43f102b71c0d6a0bc1dd1aaac9679c643b797478"], "node": "255ac80d1c6c4cf75a7d16e2fc9794eb58f5f0c2", "parents": ["aa72d55a22fb659757d0d244b0fe12dd931dcf88"], "tags": []}, {"author": "Oskar Mansfeld \u003comansfeld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091734 - remove duplicate http3 packet loss metric. r=mxinden,necko-reviewers,jesup\n\n- removing: http3.loss_ratio\n- keeping: networking.http_3_loss_ratio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341823\n", "files": ["netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/metrics.yaml"], "git_node": "204ad580992dcd26ad39521ce639afa0bb76710e", "git_parents": ["36b2a0e7e34040a729c4ed6b031ddc46bacf0ac0"], "node": "639263757bed78b6bcd517918dab750cfdca6867", "parents": ["255ac80d1c6c4cf75a7d16e2fc9794eb58f5f0c2"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2085640 - Don't let head CSS/JS loads block fetch(), like XHR. r=necko-reviewers,valentin,jesup\n\nLike for XHR, this also gives fetch() requests the urgency of Unblocked loads.\nService worker fetches for intercepted non-fetch() requests keep their class of service.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336556\n", "files": ["dom/fetch/FetchDriver.cpp", "testing/web-platform/meta/css/css-view-transitions/navigation/mismatched-snapshot-containing-block-size-skips.html.ini", "testing/web-platform/mozilla/tests/fetch/fetchpriority/fetchpriority-urgency.h2.html", "toolkit/components/extensions/test/xpcshell/test_ext_csp_upgrade_requests.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_modifyHeaders.js", "tools/profiler/tests/browser/browser_test_marker_network_serviceworker_synthetized_response.js"], "git_node": "076ba68bdf1529be4c5b1a0cc072662fc3a4777f", "git_parents": ["204ad580992dcd26ad39521ce639afa0bb76710e"], "node": "a919c67e144db6beb47859ae213779c3e532454b", "parents": ["639263757bed78b6bcd517918dab750cfdca6867"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090113 - Only add nsViewSourceChannel to the load group once the inner channel has opened. r=smaug,necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341909\n", "files": ["netwerk/protocol/viewsource/nsViewSourceChannel.cpp"], "git_node": "7d3785af9a83ab35e1382e06efcff9eb3f8a1ee2", "git_parents": ["076ba68bdf1529be4c5b1a0cc072662fc3a4777f"], "node": "5757032c3eaa4994762199c3bd2fbcfff6494179", "parents": ["a919c67e144db6beb47859ae213779c3e532454b"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2066057 - Use ECMAMap for IntersectionObserver targets. r=layout-reviewers,emilio\n\nUse the insertion-ordered map from bug 2030981 for target membership,\nthreshold state, and iteration. This makes removal amortized O(1) and\navoids a hash lookup for each target during intersection updates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320865\n", "files": ["dom/base/DOMIntersectionObserver.cpp", "dom/base/DOMIntersectionObserver.h"], "git_node": "e7709938c17b9fa38d79828426515a10dd765e90", "git_parents": ["7d3785af9a83ab35e1382e06efcff9eb3f8a1ee2"], "node": "5cc90af4b46557e2439244656f7a4c30e9129d75", "parents": ["5757032c3eaa4994762199c3bd2fbcfff6494179"], "tags": []}, {"author": "Adolfo \u003cadolfo@ochagavia.nl\u003e", "branch": "default", "desc": "Bug 2091824 - Disable pacing for the inner connect-udp connection r=mxinden,kershaw,necko-reviewers\n\nThe outer connection is already pacing outgoing traffic, so there is no\nneed to pace the inner one.\n\nNote: this change could be considered questionable in its current form,\nbecause there's an unbounded buffer storing the inner connection's\noutbound datagrams before they are fed to the outer connection's buffer\n(in other words, inner pacing does serve a purpose: keep the buffer size\nin check). However, that buffer is going to be removed in a future\ncommit, and the outer connection's bounded buffers will apply\nbackpressure on the inner connection.\n\nCo-authored-by: Max Inden \u003cmail@max-inden.de\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341807\n", "files": ["netwerk/protocol/http/Http3Session.cpp", "netwerk/socket/neqo_glue/NeqoHttp3Conn.h", "netwerk/socket/neqo_glue/src/lib.rs"], "git_node": "06c63be823201d623244272365ea9b350b7d8e73", "git_parents": ["e7709938c17b9fa38d79828426515a10dd765e90"], "node": "e4856de64113ad1703527a512316bfcb56015ae0", "parents": ["5cc90af4b46557e2439244656f7a4c30e9129d75"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041762 - Optimize frecency SQL queries for pages with large history. r=jteow,places-reviewers\n\nPages with many interactions, but few interesting ones, made the frecency\nqueries scan all their moz_places_metadata rows, as the view time filters\nare not covered by an index. Interactions older than the oldest sampled\nvisit, by more than the visit gap, can't affect the score, so they're now\nskipped.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302146\n", "files": ["toolkit/components/places/SQLFunctions.cpp", "toolkit/components/places/tests/unit/test_frecency_interactions.js"], "git_node": "adc9182986a85c97fdfac184eb7229a72422950d", "git_parents": ["06c63be823201d623244272365ea9b350b7d8e73"], "node": "cd0c978bc6ed8607c55b18e4ae9f9b35be6c65cb", "parents": ["e4856de64113ad1703527a512316bfcb56015ae0"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091757 - Add debug logging for SAP counts. r=search-reviewers,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341839\n", "files": ["browser/components/search/BrowserSearchTelemetry.sys.mjs"], "git_node": "a60e39c8ad658fac0522a56f4137808d1729d0e0", "git_parents": ["adc9182986a85c97fdfac184eb7229a72422950d"], "node": "73c9c22aa3d66e70dd6628cd2e5c58abb35ca1aa", "parents": ["cd0c978bc6ed8607c55b18e4ae9f9b35be6c65cb"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1921356 - Keep a bookmarks menu from shrinking while an item is dragged out of it. r=places-reviewers,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341825\n", "files": ["browser/components/places/content/places-menupopup.js"], "git_node": "2a6030f50731868a738ff182a2d1e530600203a4", "git_parents": ["a60e39c8ad658fac0522a56f4137808d1729d0e0"], "node": "610fc42371036703f827fdcd62c9abaf0264b2d5", "parents": ["73c9c22aa3d66e70dd6628cd2e5c58abb35ca1aa"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2090903 - Keep tsan_error records in summary.jsonl r=jgraham\n\nTSan runs with halt_on_error, so every report is fatal to the process it\nnames and belongs in the summary like crashes and ubsan_error records.\nThe pid is kept: it names the racing process, not the logging one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340927\n", "files": ["testing/mozbase/mozlog/mozlog/formatters/testsummary.py", "testing/mozbase/mozlog/tests/test_testsummary.py"], "git_node": "0eb6ce4759c86d1f5caf5c09db15b4c8d217d6df", "git_parents": ["2a6030f50731868a738ff182a2d1e530600203a4"], "node": "82c3d12f991c3c6af753d87adb24d31d9afd86a6", "parents": ["610fc42371036703f827fdcd62c9abaf0264b2d5"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2091962 - Fix RGB swap chain fallback after YUV swap chain creation failure in DCSurfaceVideo::CalculateSwapChainSize() r=gfx-reviewers,lsalzman\n\nRecalculate the swap chain format after YUV creation fails so the retry uses an RGB format. Also close and clear the composition surface handle on swap chain creation failure to prevent handle leaks during retries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342039\n", "files": ["gfx/webrender_bindings/DCLayerTree.cpp"], "git_node": "1e7536895963ef75e0238b29fa2d5e1c9eedf9cb", "git_parents": ["0eb6ce4759c86d1f5caf5c09db15b4c8d217d6df"], "node": "388e3ddb330cd8acb3b500d98d23c62819d38fe3", "parents": ["82c3d12f991c3c6af753d87adb24d31d9afd86a6"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084567 - Part 1: Allow onboarding card buttons to show a leading icon r=android-reviewers,gmalekpour,twhite\n\nOnboarding card buttons can only show text, but the new pairing sync card needs a QR icon on its \"Scan pairing code\" button, before the text.\n\nAdd an optional `leadingIconRes` to the onboarding button `Action`. Existing buttons are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336130\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingPageState.kt"], "git_node": "44876e1b7b73a5556e78d636648f2bdd5cca84b3", "git_parents": ["1e7536895963ef75e0238b29fa2d5e1c9eedf9cb"], "node": "215405589c336e400a0e41e849aeea7133464736", "parents": ["388e3ddb330cd8acb3b500d98d23c62819d38fe3"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084586 - Part 2: Add an optional skip button to the onboarding screen r=android-reviewers,android-l10n-reviewers,twhite,parker\n\nThe new pairing sync card needs a Skip button in the top right corner, above the card.\n\nThis patch adds an optional `onSkipClick` to `OnboardingPageState`. When it is set for the current page, `OnboardingContent` shows a Skip button above the pager. When it is null, the button is not shown at all. When any page has a Skip action, the button keeps its space on every page and fades in for pages with a Skip action, so the card doesn't jump between pages.\n\nOn small devices, the card fills the screen and has no elevation, so the solid background behind it now uses `surfaceBright` instead of `surface`. That's the card color so the Skip button and the card appear to be on the same surface.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336219\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingPageState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "39a25af4cf2f389b557e290810e1a0911bdfe138", "git_parents": ["44876e1b7b73a5556e78d636648f2bdd5cca84b3"], "node": "c59546d782044e69e8eb96dd53267d775ef7851c", "parents": ["215405589c336e400a0e41e849aeea7133464736"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086137 - Part 3: Allow bold text in onboarding page descriptions r=android-reviewers,twhite\n\nOnboarding page descriptions can only show plain text. The new pairing sync card needs part of its description to be bold.\n\nAdd support for HTML tags so that a description can contain \u003cb\u003e tags that are shown in bold.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337177\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingPage.kt"], "git_node": "68851432f9b577985af55ca777505e3feb51a935", "git_parents": ["39a25af4cf2f389b557e290810e1a0911bdfe138"], "node": "051a07f50b487d9707e28c4d3e0427981e777695", "parents": ["c59546d782044e69e8eb96dd53267d775ef7851c"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068230 - Part 4: Add a pairing sync card to the onboarding r=android-reviewers,android-l10n-reviewers,parker,twhite\n\nAdd a `sync-pairing` onboarding card that is shown to users who installed Firefox via the pairing campaign.\n\nMove the onboarding pager layout and sizing code into a new `OnboardingLayout.kt` file. The new card's preview triggered Detekt `TooManyFunctions` rule.\n\nNo config shows the card for now, and its buttons only advance to the next page. Follow-up patches will implement these parts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338070\n", "files": ["mobile/android/fenix/app/onboarding.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingTelemetryRecorder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingLayout.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingMapper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingPageUiData.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/view/OnboardingMapperTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/view/OnboardingPageUiDataTest.kt"], "git_node": "42e0c52c8ca84a8acc4e484990dfbe447085f851", "git_parents": ["68851432f9b577985af55ca777505e3feb51a935"], "node": "41fdfce622d9d72b9b1db218b63cc88b1caf9284", "parents": ["051a07f50b487d9707e28c4d3e0427981e777695"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068230 - Part 5: Open the QR scanner and email sign in from the pairing sync card r=android-reviewers,twhite\n\n\"Scan pairing code\" now opens the QR scanner directly and \"Sign in with email\" opens the sign in page.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338329\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/view/OnboardingScreenTest.kt"], "git_node": "b0a3255c5f5c7658b3a8e04eea2b4d8b98f7527b", "git_parents": ["42e0c52c8ca84a8acc4e484990dfbe447085f851"], "node": "bb46effbe7aa5d08d258e0fcbc10e577f6df81c3", "parents": ["41fdfce622d9d72b9b1db218b63cc88b1caf9284"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068230 - Part 6: Show the pairing card instead of the sign-in card to pairing installs r=android-reviewers,twhite\n\nInstalls coming from the pairing campaign now see the new pairing sync card in the onboarding, instead of the generic sign in card. The card is still gated by:\n - `pairing-signin-prompt` Nimbus feature, which is off by default\n - The install is attributed to a pairing campaign link\n\n The default sign in card is now disabled and is no longer gated on pairing attribution. It can still be enabled through Nimbus.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339190\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/onboarding.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/OnboardingPageAdditionSupportTest.kt"], "git_node": "9437614393da29a5123056bfc0be4e34b9e3d085", "git_parents": ["b0a3255c5f5c7658b3a8e04eea2b4d8b98f7527b"], "node": "f767132c0c3cc04ff15a667286be4653847066a4", "parents": ["bb46effbe7aa5d08d258e0fcbc10e577f6df81c3"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090221 - Part 7: Start onboarding instead of the pairing flow when a pairing link is opened before onboarding is complete r=android-reviewers,twhite\n\nWhen Firefox is installed but onboarding is not completed, opening a pairing link used to launch the pair flow and skip the onboarding, so the user could sign in before accepting the terms of use.\n\nPairing links now open the pair flow if onboarding is complete. Otherwise, the link is dropped and Firefox opens and resumes the onboarding.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340455\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/IntentReceiverActivity.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/IntentReceiverActivityTest.kt"], "git_node": "dc646e4fb99d6e938ee15b103bc581fa594d5fd5", "git_parents": ["9437614393da29a5123056bfc0be4e34b9e3d085"], "node": "fd249449ed36a802cdeaca019aa766fc25d4dfdb", "parents": ["f767132c0c3cc04ff15a667286be4653847066a4"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084589 - Part 8: Add telemetry for the onboarding pairing sync card r=android-reviewers,twhite\n\nThis adds 3 telemetry events:\n- `onboarding.sync_pairing_card`: Records the card's impression and interactions (Scan, Email and Skip buttons) using `action` and `element_type` extras.\n- `onboarding.sync_pairing_card_signed_in`: Records that the user signed in from the onboarding pairing sync card. `auth_type` parameter tells how the user authenticated.\n- `sync_auth.pairing_scanner_closed`: Records why the QR code scanner user to pair was closed.\n\nThe onboarding pairing sync card now starts authentication flows with a new `FenixFxAEntryPoint.OnboardingPairing` entrypoint so its sign-ins are correctly attributed to the pairing card.\n\nIn order to attribute an authentication to the pairing card, the entrypoint of the latest authentication flow is now stored in `EntrypointTrackingAuthFeature`. Each new flow replaces the stored entrypoint. This avoids attributing a sign in to the card if the user started the authentication from the card, canceled it and later started a new flow from the settings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341494\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/BackgroundServices.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Services.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/accounts/EntrypointTrackingAuthFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/accounts/FenixFxAEntryPoint.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingTelemetryRecorder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/PairFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/BackgroundServicesTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/accounts/EntrypointTrackingAuthFeatureTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/OnboardingTelemetryRecorderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt"], "git_node": "763afd84388bb0d2edaa45129bea4c34ced7a6ad", "git_parents": ["dc646e4fb99d6e938ee15b103bc581fa594d5fd5"], "node": "61771834cba40f086659942c3eec9a9ea70b9057", "parents": ["fd249449ed36a802cdeaca019aa766fc25d4dfdb"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090906 - Open HomeActivity after authenticating from a scanned pairing link. r=android-reviewers,cbect\n\nWhen a pairing link opens Firefox from another app, the auth custom tab is the only activity left in its task, so finishing it on success returns the user to that app instead of Firefox.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341830\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/IntentReceiverActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/AuthCustomTabActivity.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/IntentReceiverActivityTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/account/AuthCustomTabActivityTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/account/AuthIntentReceiverActivityTest.kt"], "git_node": "8be9f6660b1676583f339c6435e1197fe41937de", "git_parents": ["763afd84388bb0d2edaa45129bea4c34ced7a6ad"], "node": "c84f78cdad492f21c0b3c776e19227c9dc290bdf", "parents": ["61771834cba40f086659942c3eec9a9ea70b9057"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Rename aHashOrNonce to aContentOrNonce in CSP allows() methods; r=tschuster\n\nFor CSP_HASH, the string passed down to nsCSPHashSrc::allows() is the source\ntext being checked (of an inline script or style, an event handler or a\njavascript: URL), which is hashed there and compared to the policy's hash. It\nis never a hash itself. Rename the parameter (and the local holding its UTF-8\nform) to reflect that. nsCSPParser's mHasHashOrNonce keeps its name, as it\ndoes refer to hash and nonce sources in the policy.\n\nNo functional change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337044\n", "files": ["dom/security/nsCSPUtils.cpp", "dom/security/nsCSPUtils.h"], "git_node": "fd1f30285c02be30c601177122f04c6b7a228c59", "git_parents": ["8be9f6660b1676583f339c6435e1197fe41937de"], "node": "4684ea9ba5f7000be9d89912e4e84f795e2d3d02", "parents": ["c84f78cdad492f21c0b3c776e19227c9dc290bdf"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2091649 - Remove dead length subtractions from CopyStringChars. r=jandem\n\nThe unrolled copy reads the length only in the checks that pick where to\nenter it, and callers treat the length register as clobbered afterwards, so\nthe subtraction after each copied word was dead. So was the subtraction after\nan alignment copy that reaches the maximum length, which leaves nothing for\nthe unrolled copy to check.\n\nOn a JetStream 3 run on arm64 this removes 8,179 subtractions, 8,156 from\n2,754 unrolled copies and 23 from alignment copies.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341716\n", "files": ["js/src/jit/CodeGenerator.cpp"], "git_node": "da9baeb7464c42e96c87227c4ea666407258a742", "git_parents": ["fd1f30285c02be30c601177122f04c6b7a228c59"], "node": "f3d13368a1699a8e495cbeb8654f12f47574d35c", "parents": ["4684ea9ba5f7000be9d89912e4e84f795e2d3d02"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2086165 - Part 1: Avoid propagating absolute-positioned block-size dependencies to ancestors. r=layout-reviewers,emilio\n\nAbsoluteContainingBlock handles container-size dependencies after the containing\nblock size is final, so these frames do not need to force additional flex item\nreflows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337173\n", "files": ["layout/generic/ReflowInput.cpp"], "git_node": "77117a9fb8e51dff99ef09b7b2bd05b4c9ec6e2e", "git_parents": ["da9baeb7464c42e96c87227c4ea666407258a742"], "node": "a7c59483abf3bfdef1ee103ce348c185a364e3f6", "parents": ["f3d13368a1699a8e495cbeb8654f12f47574d35c"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2086165 - Part 2: Ignore fixed block-size descendants when checking flex item dependencies. r=layout-reviewers,emilio,firefox-style-system-reviewers\n\nShare IsNonReplacedInline between nsIFrame and computed-style queries, and use\nit when deciding whether a child's fixed block-size isolates its descendants'\npercentage sizes from the parent. Retain checks for table parts, flexed\nblock sizes and quirks-mode percentage-height resolution.\n\nPercentage min/max-block-sizes, insets and flex-basis already mark the parent\nas dependent. Fixed-length min/max constraints preserve a parent-independent\nblock-size basis.\n\nTreat ruby boxes as non-replaced inlines and cover their resolved width and\nheight in a new WPT.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337174\n", "files": ["layout/generic/nsFlexContainerFrame.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "layout/style/nsComputedDOMStyle.cpp", "testing/web-platform/tests/css/cssom/getComputedStyle-ruby-width-height.html"], "git_node": "2199eb1a2f4644553235af44050ec2a8c320067d", "git_parents": ["77117a9fb8e51dff99ef09b7b2bd05b4c9ec6e2e"], "node": "aa1fcb020504db7e7d03d980df298676a35c6de0", "parents": ["a7c59483abf3bfdef1ee103ce348c185a364e3f6"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2086165 - Part 3: Avoid intrinsic-size invalidation for non-float placeholder changes. r=layout-reviewers,emilio,firefox-style-system-reviewers\n\nUse IntrinsicDirty::None for non-float placeholder changes in nsContainerFrame,\nexcept in inline content where abspos placeholders affect line breaking and\nmin-content sizes. Cache the placeholder kind before destroying the frame.\n\nReuse the existing flexbox reflow-count mochitest and its fixture, counter\nhelper and cleanup for the nested-flex abspos scenario. Compare incremental\nlayout with a reconstructed frame tree while retaining the fixed-height child\nand percentage-height descendant. No new test file or manifest entry is needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337175\n", "files": ["layout/generic/nsContainerFrame.cpp", "layout/style/test/test_flexbox_reflow_counts.html"], "git_node": "920eb37441babc704697374749a6b51944c8b1f5", "git_parents": ["2199eb1a2f4644553235af44050ec2a8c320067d"], "node": "3b9dcbc863d715b37d89dd20c4c976434809c387", "parents": ["aa1fcb020504db7e7d03d980df298676a35c6de0"], "tags": []}, {"author": "Aleix Pol i Gonzalez \u003caleix.pol@codethink.co.uk\u003e", "branch": "default", "desc": "Bug 2088971 - Support complex border-area clipping in software painting r=emilio,layout-reviewers\n\nRender border coverage into an alpha mask for background colors and\nimages with dashed, dotted, or double borders. Ignore border colors\nand transparency when generating the mask.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333346\n", "files": ["layout/painting/nsCSSRendering.cpp", "layout/painting/nsCSSRendering.h", "layout/painting/nsDisplayList.cpp", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-complex-color.html.ini", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-complex.html.ini", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-double.html.ini", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-multiple-backgrounds.html.ini"], "git_node": "4488388933b2a1a5760e8891a27cf230b9bdb2ca", "git_parents": ["920eb37441babc704697374749a6b51944c8b1f5"], "node": "5e5bf1dd9ae2c4274f81ddbf860ff9e9453e2c27", "parents": ["3b9dcbc863d715b37d89dd20c4c976434809c387"], "tags": []}, {"author": "Aleix Pol i Gonzalez \u003caleix.pol@codethink.co.uk\u003e", "branch": "default", "desc": "Bug 2088992 - Reduce the amount of work when border-area clipping r=gw\n\nWhen possible, draw the border-area per segment, avoiding the interior\nrender and supporting batching across elements. It allows reusing the border\nsegment textures and rendering logic.\nReuses the border cache.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338062\n", "files": ["gfx/wr/webrender/src/border.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/quad.rs"], "git_node": "f65c3e3ee61fb65825ba78d0ae86bab936ba6a78", "git_parents": ["4488388933b2a1a5760e8891a27cf230b9bdb2ca"], "node": "7e3dde273a3a273a42a6a312c83acec30d991e4e", "parents": ["5e5bf1dd9ae2c4274f81ddbf860ff9e9453e2c27"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2061323 - Part 1: Rename ModuleScript::mFetchInfoForAccessingPreloadFlag to mFetchInfo. r=jonco\n\nThe field is about to be used for more than the preload flag. No functional change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333742\n", "files": ["js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h"], "git_node": "35f08d1f8bcd3cc61c63ee1a84047ae53f6a0f7c", "git_parents": ["f65c3e3ee61fb65825ba78d0ae86bab936ba6a78"], "node": "dbf6394bbe16b7a1de92aab2d7e33223e10a9716", "parents": ["7e3dde273a3a273a42a6a312c83acec30d991e4e"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2061323 - Part 2: Store the preloaded ResolvedModuleSet in ScriptFetchInfo. r=jonco\n\nMove mPreloadedResolvedSet from ModuleScript to ScriptFetchInfo, and\ngive ModuleScript a FetchInfo() accessor so callers can reach it. Since\nScriptFetchInfo is stored as the module private, this allows later patches to\nget each module's ScriptFetchInfo in the module graph.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333743\n", "files": ["js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ModuleLoaderBase.cpp"], "git_node": "9af2e96f40d827d2a056ac3ff229363715586d65", "git_parents": ["35f08d1f8bcd3cc61c63ee1a84047ae53f6a0f7c"], "node": "1e654300a03e104fbeaaabc2c9a9c83c06fa975c", "parents": ["dbf6394bbe16b7a1de92aab2d7e33223e10a9716"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2061323 - Part 3: Add JS::GetLoadedModules to enumerate a module's [[LoadedModules]]. r=jonco\n\nThis patch will be used later to traverse the module graph.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333744\n", "files": ["js/public/Modules.h", "js/src/vm/Modules.cpp"], "git_node": "026d6a0b7a5a3ed03be6f9eff564aeef253ed0fe", "git_parents": ["9af2e96f40d827d2a056ac3ff229363715586d65"], "node": "b5965ba2e8ee840570e07b6af007db6a06653d35", "parents": ["1e654300a03e104fbeaaabc2c9a9c83c06fa975c"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2061323 - Part 4: Traverse [[LoadedModules]] to migrate or reset a preloaded module graph. r=jonco\n\nMovePreloadedSetToResolvedSet and ClearPreloadedModuleGraph used to find the\nmodules of a preloaded graph from the URLs recorded in the root's preloaded\nresolved set. Instead, walk the graph through [[LoadedModules]] with\nJS::GetLoadedModules, and stop at modules which are no longer preloads, as they\nare in use by a normal load.\n\nThe recorded URLs are no longer needed, so release them before storing a\nrecord in any resolved module set.\n\nRename ClearPreloadedModuleGraph to ResetPreloadedModuleGraph, as it resets the\nstate computed while preloading rather than removing the preloaded modules,\nwhich stay in the module map.\n\nMovePreloadedSetToResolvedSet now takes a ModuleScript, so a later patch can\ncall it from ModuleLoadRequest::ModuleLoaded.\n\nSince JS::ResetPreloadedModule clears the [[LoadedModules]] of the preloaded\nmodules found by the traversal, use a release assert for the [[LoadedModules]]\nlookup in GetImportedModule.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333745\n", "files": ["dom/script/ScriptLoader.cpp", "js/loader/ModuleLoaderBase.cpp", "js/loader/ModuleLoaderBase.h", "js/loader/ResolvedModuleSet.h", "js/src/vm/Modules.cpp"], "git_node": "e7af952a815a2646a8b0c6e68698fc17272dfb35", "git_parents": ["026d6a0b7a5a3ed03be6f9eff564aeef253ed0fe"], "node": "edc92d84284ab6f358a6e9fc05bb2673657cc947", "parents": ["b5965ba2e8ee840570e07b6af007db6a06653d35"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2061323 - Part 5: Store each preloaded resolution in the referrer's ScriptFetchInfo. r=jonco\n\nUse ScriptFetchInfo's preload flag to determine whether the resolution should\nbe put in the preloaded set or the global resolved set.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341812\n", "files": ["js/loader/ModuleLoaderBase.cpp", "js/loader/ModuleLoaderBase.h"], "git_node": "d691525401765a70964233320fa77de471667cd1", "git_parents": ["e7af952a815a2646a8b0c6e68698fc17272dfb35"], "node": "093c464ec195dd7d2f262f58333402cc35314f3a", "parents": ["edc92d84284ab6f358a6e9fc05bb2673657cc947"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2061323 - Part 6: Remove the unused preload reset helpers and rename ModuleScript::ResetPreload to ResetPreloadErrors. r=jonco\n\nRemove ModuleLoaderBase::ResetPreloadFlag and\nModuleLoaderBase::ResetPreloadedModule, as they are unused now.\n\nResetPreloadedModuleGraph resets the root's module record itself, so\nModuleScript::ResetPreload is renamed to ModuleScript::ResetPreloadErrors to\nclear only the recorded errors. Errors to rethrow are only recorded on the\ntop-level module script, so only the root needs its errors cleared.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341813\n", "files": ["js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ModuleLoaderBase.cpp", "js/loader/ModuleLoaderBase.h"], "git_node": "d3a1f01371790f54efd5a216f5ffcb41862fdfc7", "git_parents": ["d691525401765a70964233320fa77de471667cd1"], "node": "bd14f5885adffbc86010f8403dab828c6085c089", "parents": ["093c464ec195dd7d2f262f58333402cc35314f3a"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2061323 - Part 7: Migrate the preloaded resolved set in ModuleLoaded(). r=jonco\n\nThis patch fixes the problem that ModuleLoadRequest::ModuleLoaded only cleared\nthe preload flag, but did not migrate the preloaded resolved set.\n\nModuleScript::SetForPreload has no more callers that clear the flag, so remove\nit and set the preload flag on the ScriptFetchInfo directly when the module\nscript is created.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341814\n", "files": ["js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ModuleLoadRequest.cpp", "js/loader/ModuleLoaderBase.cpp"], "git_node": "18a0a7c27be44fdab59cc716141820b0d11b12c5", "git_parents": ["d3a1f01371790f54efd5a216f5ffcb41862fdfc7"], "node": "f0f6e72ef0fd505ac7246ab537fd30d80754e9ee", "parents": ["bd14f5885adffbc86010f8403dab828c6085c089"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2061323 - Part 8: Test that registering an import map does not reset preloaded modules still in use. r=jonco\n\npreload_root.mjs and normal_root.mjs have the same dependency: chain_root.mjs.\nBesides, normal_root.mjs has a sub-module which takes a long time to fetch: slow.mjs\n\nWhile normal_root.mjs is fetching, an import map is inserted.\nThis test checks the module graph of preload_root doesn't get reset.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341815\n", "files": ["dom/base/test/jsmodules/importmaps/multiple/mochitest.toml", "dom/base/test/jsmodules/importmaps/multiple/preload_linked_bare.mjs", "dom/base/test/jsmodules/importmaps/multiple/preload_linked_chain_child.mjs", "dom/base/test/jsmodules/importmaps/multiple/preload_linked_chain_grandchild.mjs", "dom/base/test/jsmodules/importmaps/multiple/preload_linked_chain_root.mjs", "dom/base/test/jsmodules/importmaps/multiple/preload_linked_helpers.js", "dom/base/test/jsmodules/importmaps/multiple/preload_linked_stillloading_normal_root.mjs", "dom/base/test/jsmodules/importmaps/multiple/preload_linked_stillloading_preload_root.mjs", "dom/base/test/jsmodules/importmaps/multiple/preload_linked_stillloading_slow.mjs", "dom/base/test/jsmodules/importmaps/multiple/test_preload_linked_normal_deps_not_reset.html"], "git_node": "a7b17215c8ff6e22c75dc8be89d6b405bc58ab34", "git_parents": ["18a0a7c27be44fdab59cc716141820b0d11b12c5"], "node": "6cb36a6326e228e05ecba293a4e57a25b4e44a8e", "parents": ["f0f6e72ef0fd505ac7246ab537fd30d80754e9ee"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2061323 - Part 9: Test a normal load that reuses a preloaded root directly. r=jonco\n\nThe test preloads chain_root.mjs, and then imports it.\nThis verifies the preload flags of the entire module graph are cleared correctly.\n\nIt then preloads unsupported.mjs, which imports chain_child.mjs with an\nunsupported type: the import fails, but the specifier is still resolved and\nrecorded on unsupported.mjs.\n\nRegistering an import map must not reset chain_child.mjs, which is part of the\nlinked graph.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341816\n", "files": ["dom/base/test/jsmodules/importmaps/multiple/mochitest.toml", "dom/base/test/jsmodules/importmaps/multiple/preload_linked_rootdirect_unsupported.mjs", "dom/base/test/jsmodules/importmaps/multiple/test_preload_linked_root_imported_directly.html"], "git_node": "99c445adea95503359740522f17a10c016a30341", "git_parents": ["a7b17215c8ff6e22c75dc8be89d6b405bc58ab34"], "node": "c9257748732cd66b9939b1503233b0e48862a34f", "parents": ["6cb36a6326e228e05ecba293a4e57a25b4e44a8e"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2061323 - Part 10: Test that errors of preloaded modules are cleared. r=jonco\n\nDuring preloading, a bare specifier fails to resolve and a TypeError is\nrecorded as the error to rethrow. After an import map mapping the specifier is\nregistered, the error should be cleared, so a later load evaluates the module.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341817\n", "files": ["dom/base/test/jsmodules/importmaps/multiple/mochitest.toml", "dom/base/test/jsmodules/importmaps/multiple/preload_linked_errorreset_root.mjs", "dom/base/test/jsmodules/importmaps/multiple/preload_linked_helpers.js", "dom/base/test/jsmodules/importmaps/multiple/test_preload_linked_reset_clears_error.html"], "git_node": "2af035832ea6c9c5fe96876f15923763fc021990", "git_parents": ["99c445adea95503359740522f17a10c016a30341"], "node": "d128f6e35d13622041ee660585a4573448f5739a", "parents": ["c9257748732cd66b9939b1503233b0e48862a34f"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2061323 - Part 11: Test that synthetic modules are skipped while resetting a preloaded module graph. r=jonco\n\nSynthetic modules like JSON modules have no [[LoadedModules]] and no\nScriptFetchInfo as their module private, so the [[LoadedModules]] walk added in\nPart 4 must skip them. This test verifies that a JSON dependency is skipped\nwhile resetting a preloaded module graph.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341818\n", "files": ["dom/base/test/jsmodules/importmaps/multiple/mochitest.toml", "dom/base/test/jsmodules/importmaps/multiple/preload_linked_synthetic.json", "dom/base/test/jsmodules/importmaps/multiple/preload_linked_synthetic_root.mjs", "dom/base/test/jsmodules/importmaps/multiple/test_preload_linked_synthetic_dependency.html"], "git_node": "9ede5792f199081622f0869bef075bb618e50446", "git_parents": ["2af035832ea6c9c5fe96876f15923763fc021990"], "node": "0f646f4d80f571d6545777cf2075235705b7663d", "parents": ["d128f6e35d13622041ee660585a4573448f5739a"], "tags": []}], "date": 1794499107, "git_changesets": ["bd15dc1b907c62a8a286ca64823d0d0592806309", "af64cd46b5c6daf643cbc43850099369b4eb2c59", "3c0fdd37206514ab8b35116ca99032552fd6aa89", "1c86c34d981dbf2c855c4330d5e834158db6af88", "b77613c9e798211390cad781da1022fc2e4cca42", "696bc7be27408980dac431fa4ed6ab9b129ce87d", "baac3a7a64b944f6b7f7a6abc31a4844451bc778", "7668013e60d4a1695dea0891919e0706f2c71bbf", "8477bbe5509c68a7802475eb61b5b19f6068ea76", "02bc159ab8f4c2066d747ab031fb18bf5a5845ed", "e6ad739cadfaa056b9544822ec9a52d0ded8416b", "b08a9cbe6b29bc304470dd24d7c560ce3fd4ac89", "c5359a34e43e945a9a09e31922c18bbdb351f5df", "3b6cf03683b95b33deaaf26d3bc457a5e65721a3", "777ebc3578bad201299c327df6a144ed56f89743", "23cc4bf21a875100492c3436432412ba64dc1ab1", "4253cabfe69b44773c4e124fbeaaa92b0d896780", "00db5152fe152ea7103ae5532a8930b49ab9fab6", "6ef9361b4a9c11ec230532087a5f9b9e0560c4ab", "d3eff8022305badb3e49c4e31fc5a611385384c2", "34cd3621539b7ce336f4d4636a459bfd1cae4248", "9a0c3fd60561fe25a4a607ae8b5db6018c1254dd", "f753bf082e9bcf805e7a03326cce29b086df9eae", "978cd007380834e5b410306ef0ea7926845747a0", "1d160aeff40992910e7145f890bbe2b666c25ec7", "41d3d93c8b8df40cf0ad202486c6cbcdee007608", "ae7d034601b1a37af22149c80200222834abe54d", "834d2a5bfe68c0958b7c34f27b17fc2b4efbc587", "e47a7b0d21ff3fc7a8bb3315130ed43d7a82a13c", "f2f49ae3e86319662fc0800f85767e4bca6cd6ce", "f58ba914548a9183b3aba2930ace189be9b3682d", "a59c9febc80e4ea9d1af6c7beffd228db3ac7829", "234699f276e64daa620b6e7291574ac5f68cd68e", "ae670369837e7e47f00a98bda826f706ab4a8cde", "43f102b71c0d6a0bc1dd1aaac9679c643b797478", "36b2a0e7e34040a729c4ed6b031ddc46bacf0ac0", "204ad580992dcd26ad39521ce639afa0bb76710e", "076ba68bdf1529be4c5b1a0cc072662fc3a4777f", "7d3785af9a83ab35e1382e06efcff9eb3f8a1ee2", "e7709938c17b9fa38d79828426515a10dd765e90", "06c63be823201d623244272365ea9b350b7d8e73", "adc9182986a85c97fdfac184eb7229a72422950d", "a60e39c8ad658fac0522a56f4137808d1729d0e0", "2a6030f50731868a738ff182a2d1e530600203a4", "0eb6ce4759c86d1f5caf5c09db15b4c8d217d6df", "1e7536895963ef75e0238b29fa2d5e1c9eedf9cb", "44876e1b7b73a5556e78d636648f2bdd5cca84b3", "39a25af4cf2f389b557e290810e1a0911bdfe138", "68851432f9b577985af55ca777505e3feb51a935", "42e0c52c8ca84a8acc4e484990dfbe447085f851", "b0a3255c5f5c7658b3a8e04eea2b4d8b98f7527b", "9437614393da29a5123056bfc0be4e34b9e3d085", "dc646e4fb99d6e938ee15b103bc581fa594d5fd5", "763afd84388bb0d2edaa45129bea4c34ced7a6ad", "8be9f6660b1676583f339c6435e1197fe41937de", "fd1f30285c02be30c601177122f04c6b7a228c59", "da9baeb7464c42e96c87227c4ea666407258a742", "77117a9fb8e51dff99ef09b7b2bd05b4c9ec6e2e", "2199eb1a2f4644553235af44050ec2a8c320067d", "920eb37441babc704697374749a6b51944c8b1f5", "4488388933b2a1a5760e8891a27cf230b9bdb2ca", "f65c3e3ee61fb65825ba78d0ae86bab936ba6a78", "35f08d1f8bcd3cc61c63ee1a84047ae53f6a0f7c", "9af2e96f40d827d2a056ac3ff229363715586d65", "026d6a0b7a5a3ed03be6f9eff564aeef253ed0fe", "e7af952a815a2646a8b0c6e68698fc17272dfb35", "d691525401765a70964233320fa77de471667cd1", "d3a1f01371790f54efd5a216f5ffcb41862fdfc7", "18a0a7c27be44fdab59cc716141820b0d11b12c5", "a7b17215c8ff6e22c75dc8be89d6b405bc58ab34", "99c445adea95503359740522f17a10c016a30341", "2af035832ea6c9c5fe96876f15923763fc021990", "9ede5792f199081622f0869bef075bb618e50446"], "user": "pstanciu@mozilla.com"}, "45770": {"changesets": [{"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085640 - Don't let head CSS/JS loads block fetch(), like XHR. r=necko-reviewers,valentin,jesup\" for causing mochitest plain failures at webrequest_background_events.html\n\nThis reverts commit 076ba68bdf1529be4c5b1a0cc072662fc3a4777f.\n", "files": ["dom/fetch/FetchDriver.cpp", "testing/web-platform/meta/css/css-view-transitions/navigation/mismatched-snapshot-containing-block-size-skips.html.ini", "testing/web-platform/mozilla/tests/fetch/fetchpriority/fetchpriority-urgency.h2.html", "toolkit/components/extensions/test/xpcshell/test_ext_csp_upgrade_requests.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_modifyHeaders.js", "tools/profiler/tests/browser/browser_test_marker_network_serviceworker_synthetized_response.js"], "git_node": "2615d30fca3e4fb9cd5e30d1a1de4173fa3bfe1f", "git_parents": ["9ede5792f199081622f0869bef075bb618e50446"], "node": "eda3a2a275bdb850bd26813c6f532f633a056a92", "parents": ["0f646f4d80f571d6545777cf2075235705b7663d"], "tags": []}], "date": 1794499518, "git_changesets": ["2615d30fca3e4fb9cd5e30d1a1de4173fa3bfe1f"], "user": "pstanciu@mozilla.com"}, "45771": {"changesets": [{"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2091591: Clone the updatebot kind with Mercurial again. r=taskgraph-reviewers,ahal\n\nBug 2090949 moved the updatebot kind to the default Git checkout, a\nshallow clone from GitHub. Updatebot runs Mercurial on the checkout: it\ncommits the vendored update, shelves and purges the working directory,\npushes to try over hg, and submits the commits to Phabricator. It also\npicks its production configuration from the hg.mozilla.org repository\nURL, so every run since has failed fetching dev secrets it has no\nscopes for. Restore clone-with: hg for this kind until Updatebot\nsupports Git.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342152\n", "files": ["taskcluster/kinds/updatebot/kind.yml"], "git_node": "5fb56bef1f2d93bf32a9452c4442a6360bc6e3be", "git_parents": ["2615d30fca3e4fb9cd5e30d1a1de4173fa3bfe1f"], "node": "4cf3db2b3de9c0f6f12c04514367c17af948d5dc", "parents": ["eda3a2a275bdb850bd26813c6f532f633a056a92"], "tags": []}], "date": 1794500126, "git_changesets": ["5fb56bef1f2d93bf32a9452c4442a6360bc6e3be"], "user": "pstanciu@mozilla.com"}, "45772": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2091975 - Recreate video swap chains when the required output format changes in DCSurfaceVideo::CalculateSwapChainSize() r=gfx-reviewers,lsalzman\n\nCalculate the required output format before checking whether to recreate the video swap chain. Recreate it when the format differs from the current one so SDR/HDR transitions use the appropriate format.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342040\n", "files": ["gfx/webrender_bindings/DCLayerTree.cpp"], "git_node": "c800aefce73bec4059296780015ba943962a1ec6", "git_parents": ["9ede5792f199081622f0869bef075bb618e50446"], "node": "650e1ddaf9b758a11d3a3ed821837365279e77b2", "parents": ["0f646f4d80f571d6545777cf2075235705b7663d"], "tags": []}, {"author": "Jan-Erik Rediger \u003cjrediger@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088142 - Re-enable the string list rusttests in FOG. r=TravisLong\n\nBug 1677454 landed long ago, so remove the stale `#[ignore]` from `sets_string_list_value` and `string_list_ipc`.\n\n`string_list_ipc` also drained the IPC buffer with an extra `take_buf()` before replaying it. That made the replay a no-op, so the test was asserting that the child's value was missing. Drop the extra drain and assert that the child's `add` is replayed into the parent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338867\n", "files": ["toolkit/components/glean/api/src/private/string_list.rs"], "git_node": "baa844cc9835ba1d7e0d6a582db7730327a026de", "git_parents": ["c800aefce73bec4059296780015ba943962a1ec6"], "node": "f1b19089e612e353f90375174273f826e4f468f8", "parents": ["650e1ddaf9b758a11d3a3ed821837365279e77b2"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2089007 - [riscv64] Load a patchable word that fits in 48 bits with li_ptr. r=csmantle\n\nA patchable ImmWord, from movWithPatch and pushWithPatch, was always loaded\nwith the eight instructions of li_constant, though most hold a value that fits\nin the six of li_ptr: the -1 placeholders that IonIC entries, IonScript and\nnursery labels, and IC stubs are later patched with pointers, and the -1 of a\nwasm::SymbolicAddress, which StaticallyLink() patches with the address of a\nbuiltin.\n\nMake li_ptr load a sign-extended 48-bit value, so that -1 fits, and use it for\nevery patchable word that fits. ExtractLoad64Value() and UpdateLoad64Value()\nalready tell the two sequences apart. A value patched in later has to fit as\nwell: GC Values never do, as their tag sets the top bits, so they keep\nli_constant, and LiPtr::update() now crashes rather than truncate one that\ndoesn't.\n\nIn a JetStream 3 run on a SpacemiT K3 this turns 244,660 of the 415,489\nli_constant sequences into li_ptr, 489K fewer instructions, among them the\n171K calls of Wasm code to builtins.\n\nFound with riscvlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339593\n", "files": ["js/src/jit/riscv64/Assembler-riscv64.cpp", "js/src/jit/riscv64/Assembler-riscv64.h", "js/src/jit/riscv64/MacroAssembler-riscv64.h", "js/src/jsapi-tests/testAssemblerBuffer.cpp"], "git_node": "0137c84567644a3fa3eb02e83fb5299201058c6d", "git_parents": ["baa844cc9835ba1d7e0d6a582db7730327a026de"], "node": "fd8b8e1816f72f13843bd8d72722d2166a882bef", "parents": ["f1b19089e612e353f90375174273f826e4f468f8"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2089007 - [riscv64] Load the target of a call or jump to a fixed address in as few instructions as possible. r=csmantle\n\nma_call(ImmPtr) and ma_jump(ImmPtr) loaded their target with the six\ninstructions of the patchable li_ptr, though nothing patches it: their targets\nare RelocationKind::HARDCODED, which never move. Load it with ma_li, which needs\nfour instructions for the 38-bit addresses of a Sv39 process.\n\nIn a JetStream 3 run on a SpacemiT K3 this shortens about 550K calls and jumps\nby 1.2M instructions in all. Most of them go to trampolines, which bug 2088588\nreaches with pc-relative calls instead; about 71K are calls to C++.\n\nFound with riscvlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339594\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.cpp"], "git_node": "4e32fee8b779216c6808ee1057883aa68b70769b", "git_parents": ["0137c84567644a3fa3eb02e83fb5299201058c6d"], "node": "94d1d8b65e94c6600e00642be17a2338ae15b484", "parents": ["fd8b8e1816f72f13843bd8d72722d2166a882bef"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2088588 - [riscv64] Read rs1 before writing rd when simulating jalr. r=csmantle,jandem\n\nThe simulator wrote the link register before it read the base register,\nso `jalr ra, imm(ra)`, the second half of the `auipc ra; jalr ra` call\nsequence, jumped relative to the return address rather than to the\nauipc result. c.jalr had the same problem, so `c.jalr ra` jumped to the\nreturn address. The JIT does not emit either form.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339220\n", "files": ["js/src/jit/riscv64/Simulator-riscv64.cpp"], "git_node": "3e3b16df04f74634f2c3b59d19558d91d5999f03", "git_parents": ["4e32fee8b779216c6808ee1057883aa68b70769b"], "node": "7fed8ae17def01125546daec45d991578d66b2d5", "parents": ["94d1d8b65e94c6600e00642be17a2338ae15b484"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2088588 - [riscv64] Call and jump to JIT code with auipc and jalr. r=csmantle,jandem\n\nCalls and jumps to trampolines loaded the target with ma_li, three or\nfour instructions for the 38-bit addresses of a Sv39 process, and calls\nand jumps to JitCode with the six-instruction patchable li_ptr sequence,\nbefore the jalr or jr. All JIT code lives in the executable memory\nregion, which is smaller than 2 GiB, so an auipc and jalr pair reaches\nany target from any JIT code. The offset is only known once the code is\ncopied to its final address, so record each pair and patch it in\nexecutableCopy, as x64 and arm64 do for their pc-relative branches.\ncall(ImmPtr) and jump(ImmPtr) take the pc-relative form when the target\nis in the executable memory region, which covers call(TrampolinePtr) and\njump(TrampolinePtr); calls to C++ keep the absolute sequence.\n\nJump relocations now decode the pair. A toggled call becomes auipc, addi\nand jalr or nop, so that disabling the call keeps the low bits of the\noffset.\n\nIn a JetStream 3 run on a SpacemiT K3 this replaces about 485,000 of\nthese loads, 362,000 before a call and 123,000 before a jump, 1.36M\ninstructions in all, and shrinks Baseline code by 3.3% and Ion code by\n2.8%.\n\nFound with riscvlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339219\n", "files": ["js/src/jit/riscv64/Assembler-riscv64.cpp", "js/src/jit/riscv64/Assembler-riscv64.h", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.h"], "git_node": "ca09d5af568e3378a57ffc75c0bbf3ecb58c621a", "git_parents": ["3e3b16df04f74634f2c3b59d19558d91d5999f03"], "node": "08bfd14d126f8509b9f282063108af62c691b315", "parents": ["7fed8ae17def01125546daec45d991578d66b2d5"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090955 - Fix layout/style/StyleSheet.h so that it's self-compilable r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341373\n", "files": ["layout/style/StyleSheet.cpp", "layout/style/StyleSheet.h"], "git_node": "b092ff1bf282eb77366b47571b32610029822c49", "git_parents": ["ca09d5af568e3378a57ffc75c0bbf3ecb58c621a"], "node": "9ff896c592684b50ffe82125d213b5e21a360b7b", "parents": ["08bfd14d126f8509b9f282063108af62c691b315"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090955 - Fix clang-tidy static analysis of xpcom r=xpcom-reviewers,mccr8\n\nMark some constructors as = delete instead of private\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341374\n", "files": ["xpcom/threads/CondVar.h", "xpcom/threads/ReentrantMonitor.h", "xpcom/threads/TimerThreadMonitor.h"], "git_node": "9e101d2b4f9d7db354987cd4821b4f689e0b38c4", "git_parents": ["b092ff1bf282eb77366b47571b32610029822c49"], "node": "b4e8b839452c41d099d94c581edf845d9f3e3242", "parents": ["9ff896c592684b50ffe82125d213b5e21a360b7b"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090955 - Fix clang-tidy scan for dom/workers/WorkerPrivate.cpp r=dom-worker-reviewers,edenchuang\n\nAvoid a copy by reference\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341375\n", "files": ["dom/workers/WorkerPrivate.cpp"], "git_node": "62b713f66bf9b628a89472b44eee756b6c172b28", "git_parents": ["9e101d2b4f9d7db354987cd4821b4f689e0b38c4"], "node": "c84bae8e35f2b9b9e4f01fc1d5639d1ebb289cee", "parents": ["b4e8b839452c41d099d94c581edf845d9f3e3242"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090955 - Fix clang-tidy scan for js/src/vm/SavedStacks.cpp r=spidermonkey-reviewers,mgaudet\n\nAvoid a copy from a const reference\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341376\n", "files": ["js/src/vm/SavedStacks.cpp"], "git_node": "62dc22f7665a4637fb69a7adf465222acb6708fd", "git_parents": ["62b713f66bf9b628a89472b44eee756b6c172b28"], "node": "9b406b6a84f1dea6dbe2fb265065ced0e25118d6", "parents": ["c84bae8e35f2b9b9e4f01fc1d5639d1ebb289cee"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090955 - Fix clang-tidy scan for mfbt/DebugOnly.h r=emilio\n\nUse compiler-generated constructor instead of user-defined version\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341377\n", "files": ["mfbt/DebugOnly.h"], "git_node": "1d5c63beaa48a24188e6c344a7f56e7cf62f162e", "git_parents": ["62dc22f7665a4637fb69a7adf465222acb6708fd"], "node": "940ea4bd25ce8c804200f3067966c3f25d8b2167", "parents": ["9b406b6a84f1dea6dbe2fb265065ced0e25118d6"], "tags": []}, {"author": "Jonathan Kew \u003cjfkthame@gmail.com\u003e", "branch": "default", "desc": "Bug 1558431 - Add some WPT tests for plain-text bidi and alignment. r=layout-reviewers,emilio,jwatt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341849\n", "files": ["testing/web-platform/tests/css/css-text/bidi/bidi-plaintext-001.html", "testing/web-platform/tests/css/css-text/bidi/bidi-plaintext-002.html", "testing/web-platform/tests/css/css-text/bidi/bidi-plaintext-003.html", "testing/web-platform/tests/css/css-text/bidi/bidi-plaintext-004.html", "testing/web-platform/tests/css/css-text/bidi/reference/bidi-plaintext-001-ref.html", "testing/web-platform/tests/css/css-text/bidi/reference/bidi-plaintext-002-ref.html", "testing/web-platform/tests/css/css-text/bidi/reference/bidi-plaintext-003-ref.html", "testing/web-platform/tests/css/css-text/bidi/reference/bidi-plaintext-004-ref.html"], "git_node": "5fabeec89c9911846b549c1f27c9a74a104d0b75", "git_parents": ["1d5c63beaa48a24188e6c344a7f56e7cf62f162e"], "node": "5d9ef51a805ef0a8a671f03df1a27e7e637e5aee", "parents": ["940ea4bd25ce8c804200f3067966c3f25d8b2167"], "tags": []}, {"author": "Jonathan Kew \u003cjfkthame@gmail.com\u003e", "branch": "default", "desc": "Bug 1558431 - Fix nsBidiPresUtils::GetFrameBaseLevel for cases with inline continuations and overflow lists. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341850\n", "files": ["layout/base/nsBidiPresUtils.cpp"], "git_node": "963550ba9107ba475c7ff5fa60bbd3b16776bcae", "git_parents": ["5fabeec89c9911846b549c1f27c9a74a104d0b75"], "node": "4a35d57c29b74d99ad5ec1e03c2b9b64f49a0ccb", "parents": ["5d9ef51a805ef0a8a671f03df1a27e7e637e5aee"], "tags": []}, {"author": "Jonathan Kew \u003cjfkthame@gmail.com\u003e", "branch": "default", "desc": "Bug 1558431 - Introduce nsBidiPresUtils::GetLineBaseLevel helper to address specific lines within a block with preformatted newlines. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341851\n", "files": ["layout/base/nsBidiPresUtils.cpp", "layout/base/nsBidiPresUtils.h", "layout/generic/nsIFrame.cpp"], "git_node": "01a89f8f5c7f9557d45ac9ebc1d8b85aa5e41acb", "git_parents": ["963550ba9107ba475c7ff5fa60bbd3b16776bcae"], "node": "7c064b2074835817b1d46030505e71eda5f6f2ab", "parents": ["4a35d57c29b74d99ad5ec1e03c2b9b64f49a0ccb"], "tags": []}, {"author": "Jonathan Kew \u003cjfkthame@gmail.com\u003e", "branch": "default", "desc": "Bug 1558431 - Ensure nsTextFrame::SetLength propagates bidi levels when it pulls following text into an empty frame. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341852\n", "files": ["layout/generic/nsTextFrame.cpp"], "git_node": "9964f61deed082ae55cbb84a25e13e03d99df3e4", "git_parents": ["01a89f8f5c7f9557d45ac9ebc1d8b85aa5e41acb"], "node": "9b5f78a2c416ba653eba33e00612d1514a248250", "parents": ["7c064b2074835817b1d46030505e71eda5f6f2ab"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 1558431: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["layout/base/nsBidiPresUtils.cpp", "layout/generic/nsTextFrame.cpp"], "git_node": "e3f8eb11d852648912a425c28eb3c05db6e77ca3", "git_parents": ["9964f61deed082ae55cbb84a25e13e03d99df3e4"], "node": "80e2e74745270e3452a1b0d350216c2899a0b671", "parents": ["9b5f78a2c416ba653eba33e00612d1514a248250"], "tags": []}, {"author": "Jonathan Kew \u003cjfkthame@gmail.com\u003e", "branch": "default", "desc": "Bug 2091802 - Remove gfxCoreTextShaper, which has been preffed off by default for several years now. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341900\n", "files": ["gfx/thebes/gfxCoreTextShaper.cpp", "gfx/thebes/gfxCoreTextShaper.h", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxMacFont.cpp", "gfx/thebes/gfxMacFont.h", "gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatformMac.cpp", "gfx/thebes/gfxPlatformMac.h", "gfx/thebes/moz.build", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "641e7a22bdc3ef5514d9ee14747a195133742061", "git_parents": ["e3f8eb11d852648912a425c28eb3c05db6e77ca3"], "node": "8e2c80760b6d1bbcfce50ac738a8247daea33b38", "parents": ["80e2e74745270e3452a1b0d350216c2899a0b671"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2075222 - Allow choosing the tile size of individual blob images. r=gfx-reviewers,gw\n\nOpAddBlobImage already carried a tiling field, but the content side always\nsent zero and the parent ignored it in favor of the global blob tile size.\nLet callers of IpcResourceUpdateQueue::AddBlobImage request a tile size and\nhonor it in the parent.\n\nwr_resource_updates_add_blob_image only forwarded the tile size for BGRA8\nblobs, so A8 blobs such as masks always used WebRender's default of 512.\nForward requested tile sizes larger than the default for every format.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341443\n", "files": ["gfx/layers/wr/IpcResourceUpdateQueue.cpp", "gfx/layers/wr/IpcResourceUpdateQueue.h", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/webrender_bindings/src/bindings.rs"], "git_node": "c66ff4c1a88dffb0e1336bb8e29a4330b404fa54", "git_parents": ["641e7a22bdc3ef5514d9ee14747a195133742061"], "node": "a915838b254ad404a3bfee25ebfc5115cea3d71d", "parents": ["8e2c80760b6d1bbcfce50ac738a8247daea33b38"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2075222 - Use larger blob tiles for masks with large blurs. r=gfx-reviewers,gw\n\nBlob tiles are rasterized independently, and a blur needs the source pixels\naround each tile. With large blurs such as the glow on gemini.google.com\n(standard deviations of more than 100 device pixels) the margin is larger\nthan the 512px default tile, so each tile processes many times its own area\nand neighboring tiles redo most of the same work.\n\nThe recorder now notes blur standard deviations as filter attributes are\nrecorded, and scales the largest one by the transform of the filters it\ndraws to get an upper bound in device space. Recorded standard deviations\nare clamped like software blur filters clamp them, so the margin never\nexceeds what rasterization actually reads. Mask blobs use it to request\ntiles large enough for the margin to stay small relative to the tile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341444\n", "files": ["gfx/2d/Blur.h", "gfx/2d/DrawEventRecorder.h", "gfx/2d/DrawTargetRecording.cpp", "gfx/2d/FilterNodeSoftware.cpp", "gfx/layers/wr/WebRenderCommandBuilder.cpp"], "git_node": "c702dea3059b07e0bf915c4032e5b81bf694c854", "git_parents": ["c66ff4c1a88dffb0e1336bb8e29a4330b404fa54"], "node": "aa19d3fc4ec51089f59db340239cc6254b4476a0", "parents": ["a915838b254ad404a3bfee25ebfc5115cea3d71d"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2075222 - Allow recording object references as deterministic ids. r=gfx-reviewers,gw\n\nRecordings identify objects (draw targets, paths, gradient stops, surfaces,\nfilter nodes...) by their address, so recording the same content twice\nproduces different bytes and recordings can't be compared to detect that\nnothing changed.\n\nThis commit makes it so two recordings that have identical objects (paths,\nfilter nodes, etc.) stored at different addresses are byte-identical. The\nnext commit will compare recordings and avoid re-rasterizing blob masks that\ndid not actually change.\n\nDrawEventRecorderMemory::UseDeterministicReferenceIds makes the recorder\nwrite sequential ids instead. ReferencePtrs are mapped when they are written\nto a MemStream or MemWriter that carries the recorder's ReferenceIdMap,\nincluding the ones embedded in the raw pattern storages. The serialized\nformat and the replay side are unchanged.\n\nDrawOptions and pattern storages are written as raw bytes and contain\npadding, which is now written as zeroes so that it doesn't make otherwise\nidentical recordings differ.\n\nThe new gtest also covers the blur standard deviation tracking added in the\nprevious patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341445\n", "files": ["gfx/2d/DrawEventRecorder.cpp", "gfx/2d/DrawEventRecorder.h", "gfx/2d/RecordedEvent.h", "gfx/2d/RecordedEventImpl.h", "gfx/tests/gtest/TestDrawEventRecording.cpp", "gfx/tests/gtest/moz.build"], "git_node": "5561e25d88d8b7111d75e061f4b0953104f487ac", "git_parents": ["c702dea3059b07e0bf915c4032e5b81bf694c854"], "node": "6bcd2666fc07a84f80db757b755b6a8a5d8fde7b", "parents": ["aa19d3fc4ec51089f59db340239cc6254b4476a0"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2075222 - Don't rasterize mask blobs again when their recording didn't change. r=gfx-reviewers,gw\n\nMask items are recorded again whenever they are invalidated, for example\nwhen the masked frame is restyled, even if the mask itself is unchanged.\nEach new recording got a new blob key, so WebRender rasterized every\nvisible tile from scratch. On gemini.google.com this re-rasterizes a mask\ncontaining very large blurs several times per second.\n\nRecord masks with deterministic reference ids and keep a copy of the last\nrecording. When a new recording is byte-identical, keep using the existing\nblob instead of uploading a new one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341446\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "gfx/layers/wr/WebRenderUserData.h"], "git_node": "65b5546b119ae939817a657c21dab0c57bc6dc1c", "git_parents": ["5561e25d88d8b7111d75e061f4b0953104f487ac"], "node": "9b5e4c92d20d132e127745985862a077f4b6b970", "parents": ["6bcd2666fc07a84f80db757b755b6a8a5d8fde7b"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2091980 - Request commit when replacing video swap chains in DCSurfaceVideo::CreateVideoSwapChain() r=gfx-reviewers,lsalzman\n\nRequest a DirectComposition commit after successfully setting the new video swap chain as the visual\u2019s content, ensuring the change takes effect even when geometry remains unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342044\n", "files": ["gfx/webrender_bindings/DCLayerTree.cpp"], "git_node": "646bcdaae23531886665965d7d72de7067875f21", "git_parents": ["65b5546b119ae939817a657c21dab0c57bc6dc1c"], "node": "a9f9b31fbeb3e3cbd40c88d3dddc7d2c8324ec12", "parents": ["9b5e4c92d20d132e127745985862a077f4b6b970"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087997 - Only use preloads for fetch. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341860\n", "files": ["dom/fetch/FetchDriver.cpp"], "git_node": "278372a3d27fa21acfde085c0a15e04d704355ed", "git_parents": ["646bcdaae23531886665965d7d72de7067875f21"], "node": "e2e980b9a4145ec7ffb69915352cd0a983f70576", "parents": ["a9f9b31fbeb3e3cbd40c88d3dddc7d2c8324ec12"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2084085 - Fix verifyTheSearchTabsFunctionalityTest efficiency UI test r=aaronmt\n\nAfter typing a URL in the tab tray\u2019s search box and pressing Enter, the app jumps to the browser view, but the test still thought it was on the tab tray, so its next \u201cgo to browser\u201d step tried to confirm a tab tray that no longer existed\n\nTo fix this, let's wait for the page content to load first, then run navigateToPage(), so it correctly recognizes it\u2019s on the browser and updates its page tracker before the following steps\n\nThe UI test successfully passed 50x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342120\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TabbedBrowsingTest.kt"], "git_node": "29ef3ea09a85b0d3158c65d4fbf03a3fb8301c07", "git_parents": ["278372a3d27fa21acfde085c0a15e04d704355ed"], "node": "7ebd565a381e5bd3d8506b1c60cd92ddc83560db", "parents": ["e2e980b9a4145ec7ffb69915352cd0a983f70576"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083276 - Update metadata for /encrypted-media/* tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342074\n", "files": ["testing/web-platform/meta/encrypted-media/drm-events.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-playduration-keystatus.https.html.ini"], "git_node": "0bfb86548a6b262b2fa77758e0c54400555a476c", "git_parents": ["29ef3ea09a85b0d3158c65d4fbf03a3fb8301c07"], "node": "07c6d7d9e60e1b6e98a0ed5a972c0bd0be56d271", "parents": ["7ebd565a381e5bd3d8506b1c60cd92ddc83560db"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075160 - Go to top of overflow:scroll for downwards caret navigation. r=emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341589\n", "files": ["layout/generic/nsIFrame.cpp", "testing/web-platform/tests/selection/caret/move-through-overflow-scroll.html"], "git_node": "febf06dbbcbc52bf1a871c4713c0832a3126a5bc", "git_parents": ["0bfb86548a6b262b2fa77758e0c54400555a476c"], "node": "398ccce3a2d8715235dba6d4d40596d4e99c5b0a", "parents": ["07c6d7d9e60e1b6e98a0ed5a972c0bd0be56d271"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2091377 - Remove the cookie set by browser_scriptCache_responseHeaders.js when it finishes, r=bthrall.\n\nThe script it loads sets a cookie on example.com, so when the test runs again in the same browser the cookie sent with the reloaded ?vary request is the same as the one sent with the first load, and the Vary: Cookie response is served from the cache.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341430\n", "files": ["dom/tests/browser/browser_scriptCache_responseHeaders.js"], "git_node": "7568f9d6b17782127dfed38cdb4554734c6022e5", "git_parents": ["febf06dbbcbc52bf1a871c4713c0832a3126a5bc"], "node": "943d365e06687e1d719238bd4e982df0ac7dc8f2", "parents": ["398ccce3a2d8715235dba6d4d40596d4e99c5b0a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2091370 - Reset FOG before checking the missing avatar error event in browser_custom_avatar_test.js, r=niklas.\n\nThe profiles.error.avatar Glean event recorded by the first run was still there when the test ran again in the same browser (with --repeat, or in the upcoming mochitest-browser-chrome-repeat jobs).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341427\n", "files": ["browser/components/profiles/tests/browser/browser_custom_avatar_test.js"], "git_node": "a3dbd5ac57ac8b55a073119a78108f46180975ce", "git_parents": ["7568f9d6b17782127dfed38cdb4554734c6022e5"], "node": "96326b7052e749377d2d6b66a34176dd19b65503", "parents": ["943d365e06687e1d719238bd4e982df0ac7dc8f2"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1883194 - Clear the Alt-Svc cache at the end of browser_staticPartition_network.js, r=manuel.\n\nNo nsIClearDataService flag clears Alt-Svc alone (CLEAR_HISTORY would also clear Places), hence the browser:purge-session-history notification.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341431\n", "files": ["toolkit/components/antitracking/test/browser/browser_staticPartition_network.js"], "git_node": "8a9d7b0ed01555fc48327a2712587e43cd960cb6", "git_parents": ["a3dbd5ac57ac8b55a073119a78108f46180975ce"], "node": "4a03d3c6ff21b690786a2385a6f03eb9d0fc31fd", "parents": ["96326b7052e749377d2d6b66a34176dd19b65503"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2091368 - Wait for the bookmarks toolbar to show in browser_toolbar_collapsed_states.js, r=places-reviewers,mak.\n\nThe test assumed about:newtab opens in the preloaded browser, which is already on about:newtab when selected. The test consumes that browser, so when it runs again no preloaded one exists yet, and the new tab is still on about:blank when the assertion runs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341425\n", "files": ["browser/components/customizableui/test/browser_toolbar_collapsed_states.js"], "git_node": "f197ae179fb826b6f5ce6812d012717169bab16e", "git_parents": ["8a9d7b0ed01555fc48327a2712587e43cd960cb6"], "node": "a28a158df96fb621759ee23d4fec389844d4eb86", "parents": ["4a03d3c6ff21b690786a2385a6f03eb9d0fc31fd"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2091414 - Remove the test widget from gSeenWidgets after `browser_941083_invalidate_wrapper_cache_createWidget.js`, so it passes when run twice, r=firefox-desktop-core-reviewers ,Gijs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341424\n", "files": ["browser/components/customizableui/test/browser_941083_invalidate_wrapper_cache_createWidget.js"], "git_node": "f84a638e9ec9da4f25e553cf0a5674da9dd953b0", "git_parents": ["f197ae179fb826b6f5ce6812d012717169bab16e"], "node": "0ca6c75c6b1252f8562635c76de268948a1835a2", "parents": ["a28a158df96fb621759ee23d4fec389844d4eb86"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2091378 - Clear history around browser_onvisit_title_null_for_navigation.js, r=places-reviewers,mak.\n\nWhen the test runs a second time in the same browser, the page is already in history with its title, so page-visited carries a lastKnownTitle and page-title-changed never fires.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341432\n", "files": ["toolkit/components/places/tests/browser/browser.toml", "toolkit/components/places/tests/browser/browser_onvisit_title_null_for_navigation.js"], "git_node": "1cad031c3034084365969be9eba5500a73bc4d7b", "git_parents": ["f84a638e9ec9da4f25e553cf0a5674da9dd953b0"], "node": "01a915708c085cfabf6a8486525a013da544c6ac", "parents": ["0ca6c75c6b1252f8562635c76de268948a1835a2"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089188 - Remove Legacy Telemetry instrumentation from Toolkit::Crash Reporting r=chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340966\n", "files": ["toolkit/components/crashes/metrics.yaml", "toolkit/components/crashes/tests/xpcshell/test_crash_manager.js", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/histogram-allowlists.json"], "git_node": "a28bd32f9558fb8887614e678680c84a5cccb92c", "git_parents": ["1cad031c3034084365969be9eba5500a73bc4d7b"], "node": "f225cb33c0671aefaf6ebd144dfe2786b5eec166", "parents": ["01a915708c085cfabf6a8486525a013da544c6ac"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2089159 - Remove Legacy Telemetry histogram SANDBOX_FAILED_LAUNCH_KEYED. r=sandbox-reviewers,chutten,yjuglaret\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341465\n", "files": ["security/sandbox/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "48d74dc8dad8f929a5cacefe970bee3e36ff7935", "git_parents": ["a28bd32f9558fb8887614e678680c84a5cccb92c"], "node": "fc60e5fa16b24f2b925061c483068de7e50db430", "parents": ["f225cb33c0671aefaf6ebd144dfe2786b5eec166"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052227 - Part 1: Implement speculation rule CSS selector predicate parsing. r=jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334123\n", "files": ["Cargo.lock", "dom/base/speculationrules/Cargo.toml", "dom/base/speculationrules/lib.rs", "dom/base/speculationrules/parser.rs"], "git_node": "7b41632e1f35ec4305ad199e394b5ab7c019e68a", "git_parents": ["48d74dc8dad8f929a5cacefe970bee3e36ff7935"], "node": "2e186877c3a41c7e8b72bd296d243c08ae9f97f1", "parents": ["fc60e5fa16b24f2b925061c483068de7e50db430"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052227 - Part 2: Use stylo Element directly instead of opqaue type for Speculation Rules. r=dom-core-reviewers,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341205\n", "files": ["dom/base/speculationrules/consider_loads.rs", "dom/base/speculationrules/lib.rs"], "git_node": "3e250ad580fcd1776829f00464ba5927f26888cd", "git_parents": ["7b41632e1f35ec4305ad199e394b5ab7c019e68a"], "node": "7408ef372af0feb759ee3ff7c9476d2cf5de205f", "parents": ["2e186877c3a41c7e8b72bd296d243c08ae9f97f1"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052227 - Part 3: Implement speculation rule CSS selector predicate matching. r=dom-core-reviewers,firefox-style-system-reviewers,jjaschke,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334124\n", "files": ["dom/base/speculationrules/consider_loads.rs"], "git_node": "3d89818955f21bc2ba883e0828dca12c38f754cf", "git_parents": ["3e250ad580fcd1776829f00464ba5927f26888cd"], "node": "17c09b49f5707d526e16bc9dd496dcb3a1eefdab", "parents": ["7408ef372af0feb759ee3ff7c9476d2cf5de205f"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052227 - Part 4: Update tests for speculation rule CSS selector predicates. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339035\n", "files": ["testing/web-platform/meta/speculation-rules/prefetch/document-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/implicit-source.https.html.ini", "testing/web-platform/tests/speculation-rules/prefetch/document-rules-scope.tentative.https.html"], "git_node": "0ba8d654c59675baf39fd3ffb808afb51149b0f5", "git_parents": ["3d89818955f21bc2ba883e0828dca12c38f754cf"], "node": "ecd24d54a8c0244c237a393bb001427dcabc3b84", "parents": ["17c09b49f5707d526e16bc9dd496dcb3a1eefdab"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085640 - Don't let head CSS/JS loads block fetch(), like XHR. r=necko-reviewers,valentin,jesup\" for causing mochitest plain failures at webrequest_background_events.html\n\nThis reverts commit 076ba68bdf1529be4c5b1a0cc072662fc3a4777f.\n", "files": ["dom/fetch/FetchDriver.cpp", "testing/web-platform/meta/css/css-view-transitions/navigation/mismatched-snapshot-containing-block-size-skips.html.ini", "testing/web-platform/mozilla/tests/fetch/fetchpriority/fetchpriority-urgency.h2.html", "toolkit/components/extensions/test/xpcshell/test_ext_csp_upgrade_requests.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_modifyHeaders.js", "tools/profiler/tests/browser/browser_test_marker_network_serviceworker_synthetized_response.js"], "git_node": "27c89fdc2b1d6853637418e7d5686530dbfef21f", "git_parents": ["0ba8d654c59675baf39fd3ffb808afb51149b0f5"], "node": "3070a6e8e3998b3395f930528e69972cb605420f", "parents": ["ecd24d54a8c0244c237a393bb001427dcabc3b84"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2092014 - Simplify VarFunction::resolve_custom_property. r=sajidanwar\n\nAnd avoid cloning an unparsed value without references, which are\ncommon.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342070\n", "files": ["servo/components/style/substitution/mod.rs", "servo/components/style/substitution/var.rs"], "git_node": "bf9c2969790b8125e10e7f018acfe2c585d4cca5", "git_parents": ["27c89fdc2b1d6853637418e7d5686530dbfef21f"], "node": "ac51d6cacea9db6434e84d8ef59d89c432582c07", "parents": ["3070a6e8e3998b3395f930528e69972cb605420f"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2091771 - Re-enable test_http3_prio_enabled.js r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341854\n", "files": ["netwerk/test/unit/test_http3_prio_enabled.js", "netwerk/test/unit/test_http3_prio_helpers.js", "netwerk/test/unit/xpcshell.toml", "netwerk/test/unit_ipc/xpcshell.toml"], "git_node": "a3315cc6274ee9bbd33b46305b68d4a95b91b2fe", "git_parents": ["bf9c2969790b8125e10e7f018acfe2c585d4cca5"], "node": "e271f715884629b9c79287f41751f7191a07c84e", "parents": ["ac51d6cacea9db6434e84d8ef59d89c432582c07"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2091771 - Re-enable test_plaintext_sniff.js r=necko-reviewers,kershaw\n\nThe UCS-4LE BOM in the test was wrong, and testing every header with every\nbody made the test time out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341944\n", "files": ["netwerk/test/unit/test_plaintext_sniff.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "b395f1c29cd194584806984fc7f43784eebccb7b", "git_parents": ["a3315cc6274ee9bbd33b46305b68d4a95b91b2fe"], "node": "9df1290fff48b5ba208ccb4e3ff98f275c20457b", "parents": ["e271f715884629b9c79287f41751f7191a07c84e"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2091771 - Re-enable test_redirect_from_script_wrap.js r=necko-reviewers,kershaw\n\nhttp-on-modify-request observers only run in the parent process, so the\nparent now registers the redirect observer for the child. Sync XHR cannot\nreach an HttpServer running in the same content process, so the XHR checks\nare now async.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341945\n", "files": ["netwerk/test/unit/test_redirect_from_script.js", "netwerk/test/unit_ipc/test_redirect_from_script_wrap.js", "netwerk/test/unit_ipc/xpcshell.toml"], "git_node": "067dcdd344596523c37edf113205fd1c94d84943", "git_parents": ["b395f1c29cd194584806984fc7f43784eebccb7b"], "node": "4c00dbb82bc77c3f081e213f904052857169ca49", "parents": ["9df1290fff48b5ba208ccb4e3ff98f275c20457b"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2091771 - Re-enable browser_nsIFormPOSTActionChannel.js r=necko-reviewers,kershaw\n\nThe custom protocol handler only exists in the parent process, so load the\ntest pages there: use a non-remote tab, give the channel a system principal\nowner and flag the protocol as URI_IS_UI_RESOURCE. The system principal CSP\nblocks inline scripts, so the test now submits the form itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341946\n", "files": ["netwerk/test/browser/browser.toml", "netwerk/test/browser/browser_nsIFormPOSTActionChannel.js"], "git_node": "8a10a3e3b94f4048b9ddb185cffd582183c078f1", "git_parents": ["067dcdd344596523c37edf113205fd1c94d84943"], "node": "8d18205586f282fbc957d1f24b5b358605d7692c", "parents": ["4c00dbb82bc77c3f081e213f904052857169ca49"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2080618 - Allow the HTTP/2 proxy session to not exist yet when the channel is cancelled in test_proxy_cancel.js r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341947\n", "files": ["netwerk/test/unit/test_proxy_cancel.js"], "git_node": "ce22457c9115a8e31d266226dac59c519a6decc5", "git_parents": ["8a10a3e3b94f4048b9ddb185cffd582183c078f1"], "node": "3181458d9e6b68b86a65d07ed6a9e62a6e8ba3e9", "parents": ["8d18205586f282fbc957d1f24b5b358605d7692c"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2091771 - Use the memory cache on Windows in test_mismatch_last-modified.js r=necko-reviewers,kershaw\n\nOn Windows, dooming the disk cache entry intermittently fails because its\nfile is locked by another process, so the stale entry is served again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341948\n", "files": ["netwerk/test/unit/test_mismatch_last-modified.js"], "git_node": "eefd1a77516d969950bf7f9df35b0c207a5b377e", "git_parents": ["ce22457c9115a8e31d266226dac59c519a6decc5"], "node": "512b84ce260a6f963bbedf613a403a6ba3be1a3b", "parents": ["3181458d9e6b68b86a65d07ed6a9e62a6e8ba3e9"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2091771 - Fix races in test_trr_additional_section.js r=necko-reviewers,kershaw\n\nDelay the a.foo response so the b.foo request is always in flight when its\nadditional record is parsed, and disable network.dns.get-ttl so the native TTL\nlookup for else.foo cannot overwrite the record saved from the additional\nsection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341949\n", "files": ["netwerk/test/unit/test_trr_additional_section.js"], "git_node": "acb554ae0e058dfa55002d283bb3a56f7839974e", "git_parents": ["eefd1a77516d969950bf7f9df35b0c207a5b377e"], "node": "192e3853516d70597767168d8e20594a6ad9e59d", "parents": ["512b84ce260a6f963bbedf613a403a6ba3be1a3b"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2091771 - Flush twice before checking the disk in test_cache2-35-encryption.js r=necko-reviewers,kershaw\n\nA flush only waits for writes that are already queued, and the entry data is\nonly queued for writing once its file has been opened, which can happen after\nthe first flush is dispatched.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341950\n", "files": ["netwerk/test/unit/test_cache2-35-encryption.js"], "git_node": "320c9a40f9f2a683398ee08401c8ded5a9d0ed38", "git_parents": ["acb554ae0e058dfa55002d283bb3a56f7839974e"], "node": "b4464f7af83f9bc703f7ac98ffc6bbbf19741c1e", "parents": ["192e3853516d70597767168d8e20594a6ad9e59d"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2091591: Clone the updatebot kind with Mercurial again. r=taskgraph-reviewers,ahal\n\nBug 2090949 moved the updatebot kind to the default Git checkout, a\nshallow clone from GitHub. Updatebot runs Mercurial on the checkout: it\ncommits the vendored update, shelves and purges the working directory,\npushes to try over hg, and submits the commits to Phabricator. It also\npicks its production configuration from the hg.mozilla.org repository\nURL, so every run since has failed fetching dev secrets it has no\nscopes for. Restore clone-with: hg for this kind until Updatebot\nsupports Git.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342152\n", "files": ["taskcluster/kinds/updatebot/kind.yml"], "git_node": "0535ab32ec5cbce165e64735c40c6f96c8ccc015", "git_parents": ["320c9a40f9f2a683398ee08401c8ded5a9d0ed38"], "node": "b2faf223a78ca084cf267ceb04a85414c9239196", "parents": ["b4464f7af83f9bc703f7ac98ffc6bbbf19741c1e"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065297 - Make DeadlockDetector graph traversal iterative and skip visited entries. r=xpcom-reviewers,jstutte\n\nInTransitiveClosure() and GetDeductionChain_Helper() recursed once per edge along the lock ordering graph. A\nlong chain of live, ordered mutexes (seen repeatedly ending in the CacheStorageService lock) overflows threads\nwith small stacks such as the 256KB cache I/O thread. The traversal also had no visited set, so it could\nrevisit shared sub-DAGs exponentially.\n\nBoth now share an iterative DFS with an explicit stack that marks each entry with a per-search generation, so\nevery entry is visited at most once and no search allocates for the visited set. Children are still visited in\norder, so the reported deduction chain is unchanged. Sanity3DeathTest, disabled for bug 1370644 and never\nre-enabled after its fix, is re-enabled to check a multi-hop chain.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332760\n", "files": ["xpcom/tests/gtest/TestDeadlockDetector.cpp", "xpcom/tests/gtest/TestDeadlockDetectorScalability.cpp", "xpcom/threads/DeadlockDetector.h"], "git_node": "49288e3795d8901c8e2e8fe893622821e1ddc604", "git_parents": ["0535ab32ec5cbce165e64735c40c6f96c8ccc015"], "node": "7309444a8a65f9e023fd692d9a120d69abfc5fbb", "parents": ["b2faf223a78ca084cf267ceb04a85414c9239196"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1956000 - Show error page for 4xx/5xx responses whose content-encoded body decodes to nothing r=necko-reviewers,valentin\n\nWhen a document is loaded into a content process, content decoding is deferred to the child. The parent's nsDocumentOpenInfo therefore sees the raw encoded bytes (e.g. the 1-byte empty brotli stream `0x3b` that lvlin.baidu.com sends with its 403), sets mReceivedData, and skips the empty-body check.\n\nThe child's nsDocumentOpenInfo sees the decoded data and correctly detects the empty body, but it only passed the error status on to its listener. The docshell decides on error pages from the status the channel reports to its load group, so no error page was shown.\n\nFix: when CheckContentLengthDiscrepancy fails and the request has not already failed, also cancel the request with that error so the docshell sees it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341548\n", "files": ["browser/base/content/test/browser-about/blank_page.sjs", "browser/base/content/test/browser-about/browser_aboutNetError_blank_page.js", "uriloader/base/nsURILoader.cpp"], "git_node": "6c1f2554d41305842490098fa166d58873cb633e", "git_parents": ["49288e3795d8901c8e2e8fe893622821e1ddc604"], "node": "6bce6827dff0c739972be096f4af79838751b56d", "parents": ["7309444a8a65f9e023fd692d9a120d69abfc5fbb"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089571 - Don't report cached alt-data for a response body that comes from the network. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341061\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": "a1d07208e1efbe30cd8e916487c49388278b49e8", "git_parents": ["6c1f2554d41305842490098fa166d58873cb633e"], "node": "3bbc1c91580aad0373c67823d7206c6e62f13ac5", "parents": ["6bce6827dff0c739972be096f4af79838751b56d"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088539 - Serialize main-thread data and stop notifications in nsHTTPCompressConv. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341046\n", "files": ["netwerk/streamconv/converters/nsHTTPCompressConv.cpp", "netwerk/streamconv/converters/nsHTTPCompressConv.h"], "git_node": "9781084a860eed6f3cae3e5924227759c1838158", "git_parents": ["a1d07208e1efbe30cd8e916487c49388278b49e8"], "node": "217d0a6d3616043f39c4472ce004f1752fbfceee", "parents": ["3bbc1c91580aad0373c67823d7206c6e62f13ac5"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079354 - Cleanup all code related to the old \"Applications\" section of about:preferences r=settings-reviewers,fluent-reviewers,desktop-theme-reviewers,hjones,flod\n\n- Remove AppFileHandler, HandlerListItem and the rest of the legacy Applications code from main.js, along with the gMainPane.preInit() and gMainPane.observe() code that only served it, and the gMainPane.initialized promise preInit() waited on.\n- Remove the legacy Applications and \"Files and Applications\" markup from main.inc.xhtml, and the duplicate Downloads setting-group, which the Downloads pane already renders.\n- Fold HandlerServiceHelpers into ApplicationsHandler, make the downloads.mjs exports module-private since main.js no longer imports them, and drop helpers only the legacy list used.\n- Pass isValidHandlerApp and getIconURLForHandlerApp to the application manager dialog as a dialog argument, instead of having it reach into gMainPane. Importing downloads.mjs in the dialog would register its settings again in the dialog window.\n- Drop inProgress from the applications setting group, and the unused applicationsGroup setting.\n- Remove the TYPE_PDF and PREF_PDFJS_DISABLED constants, unused since PDFHandlerInfoWrapper was moved into downloads.mjs.\n- Remove CSS and Fluent strings used only by the old section, including handlers.css.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341067\n", "files": ["browser/components/preferences/config/downloads.mjs", "browser/components/preferences/dialogs/applicationManager.js", "browser/components/preferences/dialogs/handlers.css", "browser/components/preferences/dialogs/jar.mn", "browser/components/preferences/main.inc.xhtml", "browser/components/preferences/main.js", "browser/components/preferences/preferences.js", "browser/components/preferences/preferences.xhtml", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/themes/shared/preferences/applications.css", "browser/themes/shared/preferences/preferences.css"], "git_node": "791898b870593581a91ad6af1a7250018211472e", "git_parents": ["9781084a860eed6f3cae3e5924227759c1838158"], "node": "19cffe2545e9aaa8c3a6cbc2a009f821baec0194", "parents": ["217d0a6d3616043f39c4472ce004f1752fbfceee"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2028436 - Use BROWSER_NEW_TAB_URL instead of hardcoded about:newtab r=tabbrowser-reviewers,kcochrane\n\nThe current split view implementation navigates to \"about:newtab\" when\nthere are no other tabs. While often true for default browser windows,\nit is not correct for all browser windows, e.g. in private browsing.\n\nThis patch fixes the issue by reusing`BROWSER_NEW_TAB_URL` from\n`utilityOverlay.js` instead.\n\nAdditionally, I also replaced `openTrustedLinkIn` with navigating the\nopentabs.html document directly, to fix bug 2028439.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340748\n", "files": ["browser/components/tabbrowser/content/opentabs-splitview.mjs", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_about_opentabs.js"], "git_node": "3b97b7070410d374c8b38a7db6278f3de125f4a0", "git_parents": ["791898b870593581a91ad6af1a7250018211472e"], "node": "7d1935f22802c74f24f036dd6487cea90b13d3ff", "parents": ["19cffe2545e9aaa8c3a6cbc2a009f821baec0194"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1777412 - Stretch SVG images non-uniformly in canvas drawImage. r=gfx-reviewers,wsmind\n\nDrawDirectlyToCanvas used the rasterization size, which follows the\ndestination scale, as the SVG viewport. When that scale is not uniform,\nthe root \u003csvg\u003e's preserveAspectRatio was resolved against the\ndestination's aspect ratio and letterboxed the content instead of\nstretching it as other browsers do.\n\nLay the SVG out at its natural size instead, so that preserveAspectRatio\napplies there as the spec and Blink do, and let VectorImage scale the\nresult to the rasterization size, possibly non-uniformly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341277\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "testing/web-platform/tests/html/canvas/element/manual/drawing-images-to-the-canvas/drawimage_svg_image_nonuniform_scale.html"], "git_node": "bc6282d8f85b0315fd47b8b9e3468615200e4663", "git_parents": ["3b97b7070410d374c8b38a7db6278f3de125f4a0"], "node": "471dff0e9e48d2c85a94f79a963fa99361b97f35", "parents": ["7d1935f22802c74f24f036dd6487cea90b13d3ff"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087273 - Handle no alignment edges when placing block ellipsis on empty lines. r=layout-reviewers,AlaskanEmily\n\nDistinguish an absent outer alignment edge vs a measured coordinate of zero.\nWe only clip against recorded off-screen content, and use the inline start\nif no outer edge exists.\n\nAdded crashtests and reftests for empty clamped lines, and removed the\nassertion allowance for line-clamp-form-fieldset-003.tentative.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341033\n", "files": ["layout/generic/TextOverflow.cpp", "layout/generic/TextOverflow.h", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-form-fieldset-003.tentative.html.ini", "testing/web-platform/tests/css/css-overflow/line-clamp/crashtests/line-clamp-empty-line.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-empty-line-001.tentative.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-empty-line-001-ref.html"], "git_node": "ab08df254e0465a900cda383d552b08f5f6b1331", "git_parents": ["bc6282d8f85b0315fd47b8b9e3468615200e4663"], "node": "f3767c9c98793e8ee36aba50b9df59ac87194e74", "parents": ["471dff0e9e48d2c85a94f79a963fa99361b97f35"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2077159 - Explicitly dump code coverage counters at the end of test suites. r=marco,perftest-reviewers,webdriver-reviewers,layout-reviewers,emilio,aglavic,jdescottes\n\nOn Android, the atexit handler isn't called because the remote app is\nkilled. Before exiting the test suites and killing the tests runner, we\nmust explicitely dump the counters.\n\nUnfortunately I didn't find a single location to cover every case.\n\nFor gtests, OnTestProgramEnd now calls __gcov_dump in GTestRunner.cpp.\n\nOtherwise __gcov_dump is called by PerTestCoverageUtils.afterSuite,\nwhich is called:\n- on session close in remote/marionette/driver.sys.mjs for marionette-\n  based tests\n- in DoneTests in layout/tools/reftest/reftest.sys.mjs for reftests\n- Tester_finish in testing/mochitest/browser-test.js for browser\n  mochitests\n- _runNextTest in testing/mochitest/tests/SimpleTest/TestRunner.js with\n  support from SpecialPowers for plain mochitests\n\nThis doesn't cover JUnit, xpcshell tests nor wdspec tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333273\n", "files": ["layout/tools/reftest/reftest.sys.mjs", "remote/marionette/driver.sys.mjs", "testing/gtest/mozilla/GTestRunner.cpp", "testing/mochitest/browser-test.js", "testing/mochitest/tests/SimpleTest/TestRunner.js", "testing/specialpowers/content/SpecialPowersChild.sys.mjs", "testing/specialpowers/content/SpecialPowersParent.sys.mjs", "tools/code-coverage/PerTestCoverageUtils.sys.mjs"], "git_node": "8db6895dfe087506bde2325137f6f3da41c09dc9", "git_parents": ["ab08df254e0465a900cda383d552b08f5f6b1331"], "node": "89969ebcb6f4735c991e7ecae8c4a6b60f15ac33", "parents": ["f3767c9c98793e8ee36aba50b9df59ac87194e74"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2077159 - Pull Android code coverage results after test runs using adb.py. r=marco\n\nAfter the last few commits, we now have test coverage data written by\ntests on Android devices, but we still need to pull those results from\nthe Android device to the host.\n\nThe core function lives in adb.py and called at the end of the various\ntest frameworks.\n\nThis doesn't cover wdspec tests because they do not use adb.py but a\ncustom ADB client written in Rust.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333274\n", "files": ["layout/tools/reftest/remotereftest.py", "testing/gtest/remotegtests.py", "testing/mochitest/runjunit.py", "testing/mochitest/runtestsremote.py", "testing/mozbase/mozdevice/mozdevice/adb.py", "testing/remotecppunittests.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox_android.py", "testing/xpcshell/remotexpcshelltests.py"], "git_node": "eebafa9678d95ee966fed0f31eb060cca78519bf", "git_parents": ["8db6895dfe087506bde2325137f6f3da41c09dc9"], "node": "aa04252e62e97c21961606d582831ca7025951c8", "parents": ["89969ebcb6f4735c991e7ecae8c4a6b60f15ac33"], "tags": []}, {"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092089 - Update android nightly application-services version bump to a07a236e02a45c40879fbac81540f10afa93d1a4 r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342121\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "e10580e83ef87a29fa58f3182b587a09a1fba64d", "git_parents": ["eebafa9678d95ee966fed0f31eb060cca78519bf"], "node": "3b817dbd14982e8232cacb3beac92b2cd532415c", "parents": ["aa04252e62e97c21961606d582831ca7025951c8"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074361 - Disable Check now button on Smart Window Monitor if service refuses r=again,fluent-reviewers,ngrato,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339709\n", "files": ["browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser.toml", "browser/components/aiwindow/models/tests/browser/browser_monitor_check_limit.js", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.stories.mjs", "browser/components/aiwindow/ui/modules/AgentUI.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agentui_command.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "db244122cc41dcd45d7e35ae44894bbd2b87d2e2", "git_parents": ["e10580e83ef87a29fa58f3182b587a09a1fba64d"], "node": "0478f984b61aff3e76cc08e01af7b76a49e7cbb8", "parents": ["3b817dbd14982e8232cacb3beac92b2cd532415c"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2091963 -  Paint the correct background in QR code screen with the Darkest theme r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342020\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/share/QRCodeDialogFragment.kt"], "git_node": "6386774c5ca3990fcf9ac048be16f3d05db1c39c", "git_parents": ["db244122cc41dcd45d7e35ae44894bbd2b87d2e2"], "node": "9adef238e14dd91bf982b3bd9b207ec455bcedd4", "parents": ["0478f984b61aff3e76cc08e01af7b76a49e7cbb8"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070852 - Fix verifyTheAddToHomeScreenSubMenuOptionTest efficiency UI test r=aaronmt\n\nAfter tapping the home-screen shortcut, the app relaunches into the browser view, but the test\u2019s page tracker still thought it was on the \u201cAdd to Home screen\u201d dialog meaning that the follow-up navigateToPage() tried to confirm readiness of a dialog that was already gone, causing the failure\n\nTo fix this, I've dropped the redundant navigateToPage() and call verifyPageContent() directly, since it already waits for the browser view and page text on its own\n\nThe UI test successfully passed 50x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342105\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt"], "git_node": "77e9c0a122a92e793b0b0388a051c7a90e37758c", "git_parents": ["6386774c5ca3990fcf9ac048be16f3d05db1c39c"], "node": "9ee492d225d92b2993ab9b5c5eed6785e2353975", "parents": ["9adef238e14dd91bf982b3bd9b207ec455bcedd4"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088303: Move the SFF autocomplete row item before regular autocomplete r=mtigley,credential-management-reviewers\n\nMove the SFF row before the autocomplete row.\nNon-secure website warning still stays on top of the list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340571\n", "files": ["browser/extensions/formautofill/test/unit/test_profileAutocompleteResult.js", "toolkit/components/formautofill/ProfileAutoCompleteResult.sys.mjs"], "git_node": "ac43f0124bae3dc6c2576f4299375224b626ffa2", "git_parents": ["77e9c0a122a92e793b0b0388a051c7a90e37758c"], "node": "3cfc5fa386fbfe12f8c7ec545f79254f5d0b68c8", "parents": ["9ee492d225d92b2993ab9b5c5eed6785e2353975"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "b