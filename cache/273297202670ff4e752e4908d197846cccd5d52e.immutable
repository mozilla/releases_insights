_node": "b3d5d92511de9a8efc1a4ae7c9c9ba97f3e8c2c1", "git_parents": ["374b08bae655287c3f0525354e034611d6ca2abf"], "node": "7283182138597db4bab6ece77cbe11680de4308a", "parents": ["de62cabc8b437eeea971bc3d3ad1a6cd0976eed7"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2084900 [Linux] Implement SHMBufSurface::MapPlane() and remove YCbCrDescriptor from SHMSurface r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337037\n", "files": ["widget/gtk/SHMBufSurface.cpp", "widget/gtk/SHMBufSurface.h"], "git_node": "8318552e677edeaba1b7d94db85a7f8bf5ddeab7", "git_parents": ["b3d5d92511de9a8efc1a4ae7c9c9ba97f3e8c2c1"], "node": "f40ed37bbe7c825f767c1b8f616ba98e9a9b070b", "parents": ["7283182138597db4bab6ece77cbe11680de4308a"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2084900 [Linux] Merge WaylandTextureHost and RenderDMABUFTextureHost to RenderLinuxTextureHost r=lsalzman,gfx-reviewers\n\nImplement RenderLinuxTextureHost as unified texture host for both DMABuf and SHM backends.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337038\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/NativeLayerWayland.h", "gfx/webrender_bindings/RenderDMABUFTextureHost.cpp", "gfx/webrender_bindings/RenderDMABUFTextureHost.h", "gfx/webrender_bindings/RenderLinuxTextureHost.cpp", "gfx/webrender_bindings/RenderLinuxTextureHost.h", "gfx/webrender_bindings/RenderWaylandTextureHost.cpp", "gfx/webrender_bindings/RenderWaylandTextureHost.h", "gfx/webrender_bindings/moz.build"], "git_node": "94ccf09d24a95cd5adf5d38569e0fc39dc05c1ae", "git_parents": ["8318552e677edeaba1b7d94db85a7f8bf5ddeab7"], "node": "c07da1706ef1533158db3ddcbf38df100075fc44", "parents": ["f40ed37bbe7c825f767c1b8f616ba98e9a9b070b"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2084900 [Linux] Use RenderLinuxTextureHost for Wayland compositor and make direct composition optional r=gfx-reviewers,bradwerth\n\n- Replace RenderWaylandTextureHost/RenderDMABUFTextureHost with RenderLinuxTextureHost\n- Configure direct composition per host state, as it depends on compositor support & buffer format.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337039\n", "files": ["gfx/layers/composite/TextureHost.cpp", "gfx/layers/opengl/DMABUFTextureHostOGL.cpp", "gfx/webrender_bindings/RenderCompositorLayerNative.cpp", "gfx/webrender_bindings/RenderCompositorNative.cpp", "gfx/webrender_bindings/RenderTextureHost.h", "gfx/webrender_bindings/RenderTextureHostWrapper.cpp", "gfx/webrender_bindings/RenderTextureHostWrapper.h", "gfx/webrender_bindings/RendererOGL.cpp"], "git_node": "9ccb307dba3ef16ea20a609dd82b7c04286c58e7", "git_parents": ["94ccf09d24a95cd5adf5d38569e0fc39dc05c1ae"], "node": "fc8e457c37e0c51b38b4ed1887fac189289ae461", "parents": ["c07da1706ef1533158db3ddcbf38df100075fc44"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2091173. Don't let a non-finite angle produce a huge number of segments in SVGArcConverter. r=firefox-svg-reviewers,jwatt\n\nThe endpoint differences were computed in float, so arcs between endpoints\nnear +/-FLT_MAX overflowed to inf, making dtheta NaN. The NaN skipped the\nline fallback and was cast to int for mNumSegs, which is undefined and gives\nINT_MIN on x86, so GetNextSegment emitted segments until the counter wrapped\nand the path builder exhausted memory.\n\nCompute the differences in double, and fall back to a line when dtheta isn't\nfinite, before the int conversion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341751\n", "files": ["dom/svg/SVGArcConverter.cpp", "dom/svg/crashtests/2091173.html", "dom/svg/crashtests/crashtests.list"], "git_node": "36c8cc8e66c4db1193af7c917ee32d640c286c87", "git_parents": ["9ccb307dba3ef16ea20a609dd82b7c04286c58e7"], "node": "48b1fb4930bb28e667e0bbe16a52169d4a82b38a", "parents": ["fc8e457c37e0c51b38b4ed1887fac189289ae461"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2091300 - Fix verifyTheExtensionInstallationTest efficiency UI test r=aaronmt\n\nThe UI test was flaky because the test installs a \u201crecommended\u201d add-on and then checks its name appears in the menu, but when none of the server-provided recommendations matched our list, the helper just grabbed the first one shown.\nThis happened to be Google Search Fixer, an add-on that never displays its name in the main menu.\n\nTo fix his I've removed that \u201cgrab the first one\u201d fallback so it only installs add-ons from our known-good list, if none are shown, it closes and reopens the menu for a fresh batch (up to 3 tries) and fails clearly rather than installing a bad add-on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341380\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/MainMenuPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt"], "git_node": "4281bcda0b37f18661b83dad696c811c56f45241", "git_parents": ["36c8cc8e66c4db1193af7c917ee32d640c286c87"], "node": "b271e484f04eff50b2f1537bcf0493c973aca345", "parents": ["48b1fb4930bb28e667e0bbe16a52169d4a82b38a"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2075043 [wpt PR 62911] - Add a test for scroll-axis-lock: none on an iframe.contentDocument.scrollingElement., a=testonly\n\nAutomatic update from web-platform-tests\nAdd a test for scroll-axis-lock: none on an iframe.contentDocument.scrollingElement. (#62911)\n\nBug: 479472367, 561877895\nChange-Id: I65381a8e26dd3019557bf37cdea3c2880be21492\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8366453\nCommit-Queue: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1703474}\n\nCo-authored-by: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\n--\n\nwpt-commits: 6517c819b1500866397fd0c6c75a286ddddf5e7c\nwpt-pr: 62911\n", "files": ["testing/web-platform/tests/css/css-overflow/scroll-axis-lock-none-touch-subframe.html", "testing/web-platform/tests/css/css-overflow/scroll-axis-lock-none-wheel-subframe.html", "testing/web-platform/tests/css/css-overflow/support/scroll-axis-lock-subframe.html", "testing/web-platform/tests/css/css-overflow/support/scroll-axis-lock.js", "testing/web-platform/tests/dom/events/scrolling/scroll_support.js"], "git_node": "c66574b6955b80180fdfb5a465359f25fa8c6918", "git_parents": ["4281bcda0b37f18661b83dad696c811c56f45241"], "node": "0e1283de282fec8a94c72788c85aef3d719c18da", "parents": ["b271e484f04eff50b2f1537bcf0493c973aca345"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075043 [wpt PR 62911] - Update wpt metadata, a=testonly\n\nwpt-pr: 62911\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/scroll-axis-lock-none-touch-subframe.html.ini", "testing/web-platform/meta/css/css-overflow/scroll-axis-lock-none-wheel-subframe.html.ini"], "git_node": "c756fd178c603e449ebe6caeeb1c9dc70f8d2b70", "git_parents": ["c66574b6955b80180fdfb5a465359f25fa8c6918"], "node": "0b6e77292d40c39579fc34397c397763c1e26ff8", "parents": ["0e1283de282fec8a94c72788c85aef3d719c18da"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086774 [wpt PR 63650] - [wdspec] Fix BiDi WPT assertions that contradict the specs, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Fix BiDi WPT assertions that contradict the specs (#63650)\n\n- Update BiDi WebDriver WPT assertions and setup to match the specs so\n  the tests pass in Chrome.\n- Previously, these tests failed because they included scrollbars in\n  the visual viewport size, expected a pointer move to the current\n  position to fire an event, computed the in-view center point from the\n  bounding rect instead of the first client rect, installed an\n  extension from base64 instead of a path, waited for orientation\n  change events in a hidden tab, and expected a shifted keyup key\n  after releasing Shift.\n\nBug: 565712857\nCq-Include-Trybots: luci.chromium.try\u200b:linux-blink-rel,android-15-chrome-blink-rel\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nChange-Id: I86fd856e062a533266863df8c3d551cf4e0a8275\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8577321\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nReviewed-by: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCommit-Queue: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1718724}\n\nCo-authored-by: Maksim Sadym \u003csadym@chromium.org\u003e\n--\n\nwpt-commits: 9a42e7fa495ee7e1240c00e50b71489966392af4\nwpt-pr: 63650\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/browsing_context/capture_screenshot/capture_screenshot.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_screen_orientation_override/screen_orientation.py", "testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/__init__.py", "testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/pointer_mouse.py", "testing/web-platform/tests/webdriver/tests/bidi/input/release_actions/sequence.py", "testing/web-platform/tests/webdriver/tests/bidi/web_extension/uninstall/uninstall.py"], "git_node": "760801fee63da17bd4129437fd8cf2a1d63bdc3a", "git_parents": ["c756fd178c603e449ebe6caeeb1c9dc70f8d2b70"], "node": "f0eba1979597504a65325fe65a8835d940eabd6a", "parents": ["0b6e77292d40c39579fc34397c397763c1e26ff8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086774 [wpt PR 63650] - Update wpt metadata, a=testonly\n\nwpt-pr: 63650\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/browsing_context/capture_screenshot/capture_screenshot.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/pointer_mouse.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/input/release_actions/sequence.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/web_extension/uninstall/uninstall.py.ini"], "git_node": "873f1385732266abb42ae740c50ee1ed966f2915", "git_parents": ["760801fee63da17bd4129437fd8cf2a1d63bdc3a"], "node": "9ce2a58aeaab3610e84996d47ad803abac6edfb0", "parents": ["f0eba1979597504a65325fe65a8835d940eabd6a"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2083906 [wpt PR 63870] - Skip HTML interchange and style markup inside foreign content on copy, a=testonly\n\nAutomatic update from web-platform-tests\nSkip HTML interchange and style markup inside foreign content on copy (#63870)\n\nPrevent StyledMarkupSerializer and StyledMarkupAccumulator from emitting\nHTML interchange markup (\u003cspan\u003e&nbsp;\u003c/span\u003e and\n\u003cbr class=\"Apple-interchange-newline\"\u003e) or inline style wrappers\n(\u003cspan style=\"...\"\u003e) inside foreign content such as \u003cmath\u003e and \u003csvg\u003e.\n\nWhen the HTML parser parses a serialized \u003cmath\u003e or \u003csvg\u003e fragment,\nencountering \u003cspan\u003e or \u003cbr\u003e inside a non-integration-point foreign\nelement triggers a foreign-content breakout that pops \u003cmath\u003e or \u003csvg\u003e\noff the open element stack and parses subsequent siblings in the HTML\nnamespace.\n\nSpecifically:\n- Add IsInForeignContentForSerialization() to detect when a node or any\n  of its DOM or flat-tree ancestors is a non-HTML element or has a\n  \"math\" or \"svg\" tag name.\n- Skip inline style \u003cspan\u003e wrapping and\n  ConvertHtmlTextToInterchangeFormat() in\n  StyledMarkupAccumulator::AppendTextWithInlineStyle() and\n  StyledMarkupTraverser::ShouldApplyWrappingStyle() when inside foreign\n  content.\n- Avoid emitting leading or trailing interchange newlines inside foreign\n  content in StyledMarkupSerializer::CreateMarkup(), and advance\n  first_node to the highest \u003cmath\u003e ancestor when a leading interchange\n  newline precedes a \u003cmath\u003e subtree.\n- Do not abort the ancestor wrapping loop in CreateMarkup() when\n  traversing block or table ancestors (such as \u003cmtd\u003e or \u003cmtr\u003e) inside a\n  \u003cmath\u003e ancestor that must be serialized.\n\nGuard the behavior behind the SkipHtmlInterchangeInForeignContent\nruntime enabled feature.\n\nBug: 573244957\nChange-Id: Icd9a20e2b79839c29f5930a107838c57322e8214\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8609866\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nAuto-Submit: Kent Tamura \u003ctkent@chromium.org\u003e\nCommit-Queue: Koji Ishii \u003ckojii@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1721647}\n\nCo-authored-by: Kent Tamura \u003ctkent@chromium.org\u003e\n--\n\nwpt-commits: 380af16adf49e55f74fed69430017248b5dbef1c\nwpt-pr: 63870\n", "files": ["testing/web-platform/tests/editing/other/mathml-html-serializtion-on-copy.html"], "git_node": "c419c96eee8bc93e68e26823db396691f9d1b5bf", "git_parents": ["873f1385732266abb42ae740c50ee1ed966f2915"], "node": "1d6fa3ec4d83daf450b1815a4cbb6226257a1cf7", "parents": ["9ce2a58aeaab3610e84996d47ad803abac6edfb0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083906 [wpt PR 63870] - Update wpt metadata, a=testonly\n\nwpt-pr: 63870\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/editing/other/mathml-html-serializtion-on-copy.html.ini"], "git_node": "5e11867075240b17bfb43005e987e179c06e20a9", "git_parents": ["c419c96eee8bc93e68e26823db396691f9d1b5bf"], "node": "c0a500250dfc6a9ab6955b14364ab73e6c0c55dc", "parents": ["1d6fa3ec4d83daf450b1815a4cbb6226257a1cf7"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2084324 [wpt PR 63905] - [blink] Enable fall back to main for unsupported inherited properties, a=testonly\n\nAutomatic update from web-platform-tests\n[blink] Enable fall back to main for unsupported inherited properties (#63905)\n\nEnable fall back to the main thread by default (via\nTrackAnimatedSources) for unsupported inherited properties: transform,\ntranslate, rotate, scale, opacity, filter, backdrop-filter,\nbackground-color, and clip-path. When another element inherits an\nanimated value for one of these properties, composited animations fall\nback to the main thread because the compositor cannot yet propagate\nanimated values between elements.\n\nMove tracking of properties that inherit by default, currently only\ncolor, behind a new TrackAnimatedSourcesForInheritedProperties flag\n(disabled by default). Every descendant carries their sources, and color\nanimations are not composited, so the fallback does not need them yet.\n\nAdd WPT reftests checking that a child inheriting an animated transform\nor opacity stays in sync with its parent's animated value. These are the\ntwo properties every engine composites; the per-property tracking is\ncovered by AnimatedSourcePropertyTest.\n\nFixed: 493257009\nFixed: 568017798\nChange-Id: Ic2960dd832dc7375e11c2b618e1b8e6db8ec23ce\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8480791\nCommit-Queue: Free Debreuil \u003cfreedebreuil@google.com\u003e\nAuto-Submit: Free Debreuil \u003cfreedebreuil@google.com\u003e\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1722353}\n\nCo-authored-by: Free Debreuil \u003cfreedebreuil@google.com\u003e\n--\n\nwpt-commits: f283c2aa0712b450a4e5ba9f0b66c5b4c915a955\nwpt-pr: 63905\n", "files": ["testing/web-platform/tests/css/css-animations/inherited-animation-opacity.html", "testing/web-platform/tests/css/css-animations/inherited-animation-transform.html", "testing/web-platform/tests/css/css-animations/support/inherited-animation-reftest.js"], "git_node": "e05383a0b25fd60c0376af84f521507a2c5f0ee6", "git_parents": ["5e11867075240b17bfb43005e987e179c06e20a9"], "node": "b70be69ab86f2d96f7ad1cb4cd17a52f0df846af", "parents": ["c0a500250dfc6a9ab6955b14364ab73e6c0c55dc"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084324 [wpt PR 63905] - Update wpt metadata, a=testonly\n\nwpt-pr: 63905\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-animations/inherited-animation-opacity.html.ini", "testing/web-platform/meta/css/css-animations/inherited-animation-transform.html.ini"], "git_node": "d3c422da6ab1e257b2de6811694182bbe8828fb7", "git_parents": ["e05383a0b25fd60c0376af84f521507a2c5f0ee6"], "node": "32df23e2d5852e988c31c696b82de24722e2ba83", "parents": ["b70be69ab86f2d96f7ad1cb4cd17a52f0df846af"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2086779 [wpt PR 64064] - Ensure consistent overlay scrollbar visibility in ref test., a=testonly\n\nAutomatic update from web-platform-tests\nEnsure consistent overlay scrollbar visibility in ref test. (#64064)\n\nThe test /css/css-position/position-fixed-scroll-overlap.html compares\na view that has scrolled with one that hasn't. This is inherently\nflaky as with overlay scrollbars enabled the view that has scrolled\nsometimes has a scrollbar (depending on the timing of when\nit was scrolled).\n\nInstead, by ensuring that both the test and ref have scrolled we\nshould be able to eliminate the flakiness of the overlay scrollbar\nsometimes not matching.\n\nBug: 558800706\nChange-Id: Ief509bc12cdbd29491df2ff29c8ef1bf24a41bd4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8503365\nReviewed-by: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCommit-Queue: Robert Flack \u003cflackr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724164}\n\nCo-authored-by: Robert Flack \u003cflackr@chromium.org\u003e\n--\n\nwpt-commits: 5af3c135c9c97381733866150a7ada27d1029c50\nwpt-pr: 64064\n", "files": ["testing/web-platform/tests/css/css-position/position-fixed-scroll-overlap-ref.html", "testing/web-platform/tests/css/css-position/position-fixed-scroll-overlap.html", "testing/web-platform/tests/dom/events/scrolling/scroll_support.js"], "git_node": "6587e5d04ae8d6000f8bbe77824c0274216ee7eb", "git_parents": ["d3c422da6ab1e257b2de6811694182bbe8828fb7"], "node": "304ae3a21aceb352d238198c803f7fd94cba8cee", "parents": ["32df23e2d5852e988c31c696b82de24722e2ba83"], "tags": []}, {"author": "Shannon Booth \u003cshannon.ml.booth@gmail.com\u003e", "branch": "default", "desc": "Bug 2086782 [wpt PR 63994] - [wptrunner] Don't restart Ladybird when the test type changes, a=testonly\n\nAutomatic update from web-platform-tests\n[wptrunner] Don't restart Ladybird when the test type changes\n\nLadybird runs testharness, reftest, crashtest and test262 tests through\nWebDriver executors that can switch over in the same browser. Use the\nsame check as Chrome, Safari and WebKit, so that only wdspec and aamtest\ntests get a fresh browser.\n\n--\n\nwpt-commits: 8a5805234c70967e448b07eb8ae86155f0bf4299\nwpt-pr: 63994\n", "files": ["testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/ladybird.py"], "git_node": "d6d46a7010315c011c98372414ae68519ff0e515", "git_parents": ["6587e5d04ae8d6000f8bbe77824c0274216ee7eb"], "node": "f6728441f23d04763ba8eddeac71723da9cf9734", "parents": ["304ae3a21aceb352d238198c803f7fd94cba8cee"], "tags": []}, {"author": "Andreu Botella \u003cabotella@igalia.com\u003e", "branch": "default", "desc": "Bug 2086795 [wpt PR 64022] - [line-clamp] Fix issues with `line-clamp-baseline-001.html`, a=testonly\n\nAutomatic update from web-platform-tests\n[line-clamp] Fix issues with `line-clamp-baseline-001.html` (#64022)\n--\n\nwpt-commits: ffe56d4420d270941329689aff42d925f615d0b4\nwpt-pr: 64022\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-baseline-001.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-baseline-001-ref.html"], "git_node": "e4f701f3c1839568e4fab40babe6f425a5ea1f5c", "git_parents": ["d6d46a7010315c011c98372414ae68519ff0e515"], "node": "dee3de1a1a0bac8526e208f4289211d48a74760a", "parents": ["f6728441f23d04763ba8eddeac71723da9cf9734"], "tags": []}, {"author": "Martin Robinson \u003cmartin@abandonedwig.info\u003e", "branch": "default", "desc": "Bug 2086799 [wpt PR 64153] - script: Do not try to scroll discarded browsing contexts, a=testonly\n\nAutomatic update from web-platform-tests\nscript: Do not try to scroll discarded browsing contexts\n\nWhen recursively scrolling for `scrollIntoView` do not try to scroll\ndiscarded browsing contexts, as they are no longer part of the active\npage content. This prevents a class of infinite loops where we scroll a\ndiscarded browsing context whose `\u003ciframe\u003e` has been adopted by its own\ndocument.\n\nSigned-off-by: Martin Robinson \u003cmartin@abandonedwig.info\u003e\n\n--\n\nwpt-commits: c7902c0b13fb010a78126eb9d951e1f22c421013\nwpt-pr: 64153\n", "files": ["testing/web-platform/tests/css/cssom-view/scrollIntoView-iframe-self-insertion-crash.html"], "git_node": "41f8f5c5b884f4c334b143a857d9431f6c83d531", "git_parents": ["e4f701f3c1839568e4fab40babe6f425a5ea1f5c"], "node": "2f49da2a9bd68d3fc9d196720041e4aa8012c225", "parents": ["dee3de1a1a0bac8526e208f4289211d48a74760a"], "tags": []}, {"author": "Sabb \u003csarafaabbas@gmail.com\u003e", "branch": "default", "desc": "Bug 2084042 [wpt PR 63891] - net: Clear relevant CORS cache entries on network error, a=testonly\n\nAutomatic update from web-platform-tests\nnet: Clear relevant CORS cache entries on network error\n\nSigned-off-by: Sabb \u003csarafaabbas@gmail.com\u003e\n\n--\n\nwpt-commits: 9dde5d72eb824c80eaf1ee9c5a460e8a8f885426\nwpt-pr: 63891\n", "files": ["testing/web-platform/tests/fetch/api/cors/cors-preflight-cache.any.js", "testing/web-platform/tests/fetch/api/resources/preflight.py"], "git_node": "ba491255be6dbdcb1a476be44df59cf62e9287e7", "git_parents": ["41f8f5c5b884f4c334b143a857d9431f6c83d531"], "node": "5d0472eeb6f8fdb93851200c22f0e0db528c99d3", "parents": ["2f49da2a9bd68d3fc9d196720041e4aa8012c225"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2085209 [wpt PR 63962] - script: Acknowledge that `bgcolor` attribute of `\u003ctable\u003e` affects preshints, a=testonly\n\nAutomatic update from web-platform-tests\nscript: Acknowledge that `bgcolor` attribute of `\u003ctable\u003e` affects preshints\n\nNow we will correctly update presentational hints when the value of that\nattribute changes dynamically.\n\nSigned-off-by: Oriol Brufau \u003cobrufau@igalia.com\u003e\n\n--\n\nwpt-commits: f4febe305ac97a2aa53435bf6bf98c0a78d8128f\nwpt-pr: 63962\n", "files": ["testing/web-platform/tests/html/rendering/non-replaced-elements/tables/table-attribute-bgcolor-dynamic.html"], "git_node": "f58045edac38fa98b482f676204d1f60232d18f2", "git_parents": ["ba491255be6dbdcb1a476be44df59cf62e9287e7"], "node": "2b62e1214bea91e0b1794f9c2b04f891d2857bf7", "parents": ["5d0472eeb6f8fdb93851200c22f0e0db528c99d3"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086812 [wpt PR 64091] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327529, a=testonly\n\nAutomatic update from web-platform-tests\n[Flex] Intrinsic min-block-size on a column flex item is clamped by a smaller max-block-size\n\n  \u003cdiv style=\"display: flex; flex-direction: column\"\u003e\n    \u003cdiv style=\"min-block-size: fit-content; max-block-size: 10px\"\u003eItem\u003c/div\u003e\n  \u003c/div\u003e\n\nThe item should be as tall as its content (min-block-size wins over max-block-size). Instead it was 10px tall.\n\nIn the block axis, min-content, max-content and fit-content mean the automatic size, i.e. what height: auto gives.\nuseContentBasedMinimumSize read that as the automatic minimum size of min-height: auto and sent these keywords to computeContentBasedMinMainSize,\nwhich clamps the content height by the max. RenderBox::constrainLogicalHeightByMinMax made the same mistake by turning min-content and max-content into auto.\n\nThe fix keeps the content-based minimum for min-height: auto only, so the intrinsic keywords resolve to the content height like any other non-auto min-block-size.\nRenderBox no longer turns them into auto; a box whose height comes from its aspect ratio resolves them through that ratio instead.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327529\nWebKit-Canonical-Link: https://commits.webkit.org/323872@main\n\n--\n\nwpt-commits: d3e4e7ede5e2c5855ebe4f54a1ac03b38df621ce\nwpt-pr: 64091\n", "files": ["testing/web-platform/tests/css/css-flexbox/flex-item-min-block-size-intrinsic-max-block-size-ref.html", "testing/web-platform/tests/css/css-flexbox/flex-item-min-block-size-intrinsic-max-block-size.html"], "git_node": "2034d38fbd6ab97ac2a74231bad6302077eb753d", "git_parents": ["f58045edac38fa98b482f676204d1f60232d18f2"], "node": "5e3abbeec6706730c189a531b1203d4d06bf0c50", "parents": ["2b62e1214bea91e0b1794f9c2b04f891d2857bf7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086812 [wpt PR 64091] - Update wpt metadata, a=testonly\n\nwpt-pr: 64091\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-flexbox/flex-item-min-block-size-intrinsic-max-block-size.html.ini"], "git_node": "1c10b34a9ab3994611d954370495a0925ebf417c", "git_parents": ["2034d38fbd6ab97ac2a74231bad6302077eb753d"], "node": "b9606bad010045168eff687c968c9465ad43f00e", "parents": ["5e3abbeec6706730c189a531b1203d4d06bf0c50"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2086820 [wpt PR 64093] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327011, a=testonly\n\nAutomatic update from web-platform-tests\nCSSStyleSheet.replaceSync() on a detached constructed stylesheet appends rules instead of replacing them, and can corrupt other sheets sharing the cached contents\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nreplaceSync() [1] must replace all of the stylesheet's rules with the\nresult of parsing the given text.\n\nWhen a constructed stylesheet is detached and has no CSSOM rule\nwrappers, replaceSync() looks the text up in StyleSheetContentsCache.\nOn a cache miss it parsed the text into the sheet's existing\nStyleSheetContents without clearing it first, so the new rules were\nappended to the old ones:\n\n    sheet.replaceSync(\".a {} .b {}\");\n    sheet.replaceSync(\".c {} .d {} .e {}\");\n    sheet.cssRules.length; // 5, should be 3\n\nThe existing contents may also be shared through the cache: a cache\nhit points the sheet at the cached StyleSheetContents. A later cache\nmiss on that sheet then parsed into the shared object, changing every\nother sheet created from the same text, as well as the cache entry\nfor that text:\n\n    first.replaceSync(\".a {}\");\n    second.replaceSync(\".a {}\");   // Cache hit, shares first's contents.\n    second.replaceSync(\".b {}\");   // Appended into the shared contents.\n    first.cssRules;                // [.a, .b], should be [.a]\n\nOn a cache miss, parse into a new StyleSheetContents created with the\nsame parser context, and swap it in the same way the cache-hit path\ndoes, so a cache miss never writes into a shared StyleSheetContents.\n\n[1] https://drafts.csswg.org/cssom/#dom-cssstylesheet-replacesync\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327011\nWebKit-Canonical-Link: https://commits.webkit.org/323736@main\n\n--\n\nwpt-commits: 4378fc87adfa90eba8538e62e15d47c7a2977e2c\nwpt-pr: 64093\n", "files": ["testing/web-platform/tests/css/cssom/CSSStyleSheet-constructable-replaceSync-detached.html"], "git_node": "1069805ca0a4722fc027ac12f69a684cce8fd49c", "git_parents": ["1c10b34a9ab3994611d954370495a0925ebf417c"], "node": "293bf891f77daed35288ad21044c2899128476bd", "parents": ["b9606bad010045168eff687c968c9465ad43f00e"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2086826 [wpt PR 64089] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327660, a=testonly\n\nAutomatic update from web-platform-tests\nlinear() easing function rejects a percentage written before the number\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nThe grammar for a linear() stop is \u003cnumber\u003e && \u003cpercentage\u003e{0,2} [1]. The\n\"&&\" combinator means both components are required but may appear in either\norder, so \"linear(0% 0, 100% 1)\" is valid. We only accepted the number first,\nso any stop that began with a percentage caused the whole function to be\nrejected.\n\nFall back to consuming the percentages first and then require the number.\nA stop with percentages on both sides of the number, such as\n\"linear(0% 0 50%, 1)\", is still rejected, since \u003cpercentage\u003e{0,2} must be\ncontiguous. Serialization is unchanged.\n\n[1] https://drafts.csswg.org/css-easing-2/#funcdef-linear\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327660\nWebKit-Canonical-Link: https://commits.webkit.org/323951@main\n\n--\n\nwpt-commits: d4c9bd031457343bce2d5c26901ab1543b1f4b67\nwpt-pr: 64089\n", "files": ["testing/web-platform/tests/css/css-easing/linear-timing-functions-syntax-percentage-first.html"], "git_node": "57f3ded46ffeb6ff66a0c130ab9b33c0d7adb199", "git_parents": ["1069805ca0a4722fc027ac12f69a684cce8fd49c"], "node": "fb62e047d1783ea1e32d233b783c19bfff787630", "parents": ["293bf891f77daed35288ad21044c2899128476bd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086826 [wpt PR 64089] - Update wpt metadata, a=testonly\n\nwpt-pr: 64089\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-easing/linear-timing-functions-chrome-406926307-crash.html.ini"], "git_node": "1440e7ed388334d0fc085f42827b3e2d5ad96495", "git_parents": ["57f3ded46ffeb6ff66a0c130ab9b33c0d7adb199"], "node": "9dbc51062e59c93719c2a0804d6710bbddbf46c6", "parents": ["fb62e047d1783ea1e32d233b783c19bfff787630"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086827 [wpt PR 64096] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327158, a=testonly\n\nAutomatic update from web-platform-tests\n[Flex] A widget with aspect-ratio and a calc() height gets a zero flex base size\n\n    \u003cdiv style=\"display: flex\"\u003e\n      \u003cinput type=\"checkbox\" style=\"flex-basis: content; aspect-ratio: 2; height: calc(50% + 1px)\"\u003e\n    \u003c/div\u003e\n\nThe checkbox should be as wide as with height: 50%, twice its height. Instead it got a zero flex base size and stayed as narrow as the theme makes it.\n\nThe percentage can't resolve against the auto-height container, so a widget falls back to its intrinsic height, but\nonly the Style::PreferredSize overload of RenderBox::computePercentageLogicalHeight does that.\nflexItemCrossSizeIsDefinite passes the whole size and finds the cross size definite, while\ncomputeMainSizeFromAspectRatioUsing passed the bare calc() alternative, which resolved to nothing and gave a main size\nof 0.\n\nWrap the calc() alternative in SizeType like the percentage, and drop the Style::PreferredSize::Calc instantiation that\nonly this call needed.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327158\nWebKit-Canonical-Link: https://commits.webkit.org/323464@main\n\n--\n\nwpt-commits: ebbd1e6abe90e0304f180e22fa3d1749e246ce1c\nwpt-pr: 64096\n", "files": ["testing/web-platform/tests/css/css-flexbox/checkbox-aspect-ratio-calc-height-in-flex-ref.html", "testing/web-platform/tests/css/css-flexbox/checkbox-aspect-ratio-calc-height-in-flex.html"], "git_node": "3990bdeb5db81a1c8337e93da3506ed4ec382474", "git_parents": ["1440e7ed388334d0fc085f42827b3e2d5ad96495"], "node": "f2798d85c1df350d5c5418166430dc0703f3299f", "parents": ["9dbc51062e59c93719c2a0804d6710bbddbf46c6"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086829 [wpt PR 64097] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327176, a=testonly\n\nAutomatic update from web-platform-tests\n[Flex] A table flex item with borders is wider than its content and borders\n\n    \u003cdiv style=\"display: flex; justify-content: flex-end; width: 300px\"\u003e\n      \u003ctable style=\"border: 10px solid; border-spacing: 0\"\u003e\u003ctr\u003e\u003ctd style=\"padding: 0\"\u003e\u003cdiv style=\"width: 50px\"\u003e\u003c/div\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/table\u003e\n    \u003c/div\u003e\n\nThe table should be 70px wide, its 50px content plus 20px of borders. Instead it was 90px and stuck out of the\ncontainer.\n\nRenderTable cached its inline borders and only recomputed them when it laid out or computed its intrinsic widths.\nThe flex layout read them before either, getting 0 on the first layout or the previous widths after a border change.\nFlexLayoutItem cached that as the main-axis border and padding, and maxContentMainAxisExtentForFlexItem subtracted the\nsame stale value from a max-content contribution that had the real borders, so the content size came out too big by\nthe border widths and the border box added the real borders on top.\n\nCompute borderStart() and borderEnd() on demand, the way borderBefore() and borderAfter() already are, as the FIXMEs\nin layout and computeIntrinsicLogicalWidths asked, and remove the cache.\n\nNo measurable cost in PerformanceTests/Layout (median ms over 20 iterations; with the change, with the old cache,\nthen with the change again):\n\n    large-table-with-collapsed-borders-and-no-colspans                  179    180     184\n    large-table-with-collapsed-borders-and-colspans                     181    183     183\n    large-table-with-collapsed-borders-and-colspans-wider-than-table    498    504.5   512\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327176\nWebKit-Canonical-Link: https://commits.webkit.org/323471@main\n\n--\n\nwpt-commits: af8c795f07a71adb217121ae261b6a609bc9ff91\nwpt-pr: 64097\n", "files": ["testing/web-platform/tests/css/css-flexbox/table-flex-item-borders-001-ref.html", "testing/web-platform/tests/css/css-flexbox/table-flex-item-borders-001.html"], "git_node": "b5dc47cf2041ab578d262297d5af641ebb004b8e", "git_parents": ["3990bdeb5db81a1c8337e93da3506ed4ec382474"], "node": "764a1c6b950d9a7feea7ecbffe9f2ab54ff7d455", "parents": ["f2798d85c1df350d5c5418166430dc0703f3299f"], "tags": []}, {"author": "Yury Semikhatsky \u003cyurys@chromium.org\u003e", "branch": "default", "desc": "Bug 2086835 [wpt PR 64092] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326380, a=testonly\n\nAutomatic update from web-platform-tests\nREGRESSION(312933@main): document.fonts.ready never resolves when an unused @font-face has a failing local() source followed by url()\n\nCSSSegmentedFontFace::fontRanges() probes the first face of a family with\nExternalResourceDownloadPolicy::Forbid, regardless of its unicode-range.\nSince 312933@main, CSSFontFace::pump(Forbid) moves such a face from Pending\nto Loading as soon as its local() source is attempted. When the local()\nsource fails and the next source is a url(), pump() returns with the face\nin Loading, but the url() is only fetched under the Allow policy. If no text\nuses the face, that never happens: the face times out and, with an infinite\nswap period, stays in TimedOut. CSSFontFaceSet's active count never drops to\nzero, so document.fonts stays \"loading\" and document.fonts.ready never\nresolves.\n\nThis partially reverts 312933@main: Pending -\u003e Loading under the Forbid\npolicy is again deferred until the outcome is known. To keep the 312121\nfix for faces whose sources all fail synchronously (e.g. only local()\nsources), the Pending -\u003e Loading -\u003e Failure transition at the end of pump()\nnow applies whenever the face is still Pending, not only when it has no\nsources.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326380\nWebKit-Canonical-Link: https://commits.webkit.org/323883@main\n\n--\n\nwpt-commits: 896e55ddc832079f5d17ef9e0964ef3128fcd544\nwpt-pr: 64092\n", "files": ["testing/web-platform/tests/css/css-font-loading/fontfaceset-ready-unused-face-failed-local-source.html"], "git_node": "6b1355810e31777d97221dcb71bd46da9eca1d57", "git_parents": ["b5dc47cf2041ab578d262297d5af641ebb004b8e"], "node": "254b6a2bc97aecc68ccdef4ca37d57f2a4ac5c40", "parents": ["764a1c6b950d9a7feea7ecbffe9f2ab54ff7d455"], "tags": []}, {"author": "Sam Weinig \u003csam@webkit.org\u003e", "branch": "default", "desc": "Bug 2086836 [wpt PR 64099] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327187, a=testonly\n\nAutomatic update from web-platform-tests\n[Image Redux] 'object-fit: none' and 'scale-down' should size an image without natural dimensions against its content box\n\nFixes an edge case for 'object-fit: none' and 'object-fit: scale-down' for images without\nnatural width and height but with a natural aspect-ratio, like an SVG with only a viewBox.\n\nRemoves the following tests from TestExpectations:\n  css/css-images/object-fit-none-svg-003i.html\n  css/css-images/object-fit-none-svg-003p.html\n  css/css-images/object-fit-none-svg-004i.html\n  css/css-images/object-fit-none-svg-004p.html\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327187\nWebKit-Canonical-Link: https://commits.webkit.org/323503@main\n\n--\n\nwpt-commits: 640b8546308037c2dfedde39b9ecaeae3450bfd1\nwpt-pr: 64099\n", "files": ["testing/web-platform/tests/css/css-images/object-fit-svg-no-natural-dimensions-ref.html", "testing/web-platform/tests/css/css-images/object-fit-svg-no-natural-dimensions.html"], "git_node": "3f578b8907c9670c178d2130fee9631d65bbeba4", "git_parents": ["6b1355810e31777d97221dcb71bd46da9eca1d57"], "node": "180a043258665f2a560430513b4ba46a7f8de0f4", "parents": ["254b6a2bc97aecc68ccdef4ca37d57f2a4ac5c40"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086836 [wpt PR 64099] - Update wpt metadata, a=testonly\n\nwpt-pr: 64099\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-images/cross-fade-legacy-2-crash.html.ini"], "git_node": "0bf078972382eb9d296c45e193caf6a971c4509c", "git_parents": ["3f578b8907c9670c178d2130fee9631d65bbeba4"], "node": "65af85a8d49bfa2c289522ca13bab0e5fc2a167b", "parents": ["180a043258665f2a560430513b4ba46a7f8de0f4"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086839 [wpt PR 64098] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327182, a=testonly\n\nAutomatic update from web-platform-tests\n[Flex] A table flex item with borders or padding and a non-auto min-width is too wide\n\n    \u003cdiv style=\"display: flex; width: 50px\"\u003e\n      \u003ctable style=\"min-width: 0; border: 10px solid; border-spacing: 0\"\u003e\u003ctr\u003e\u003ctd style=\"padding: 0\"\u003e\u003cdiv style=\"width: 100px\"\u003e\u003c/div\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/table\u003e\n    \u003c/div\u003e\n\nThe table should be 120px wide, its min-content width. Instead it was 140px, wider than with min-width: auto.\n\ncomputeUsedNonAutoMinMainSize keeps a table from shrinking below its min-content width by flooring the min main size,\na content-box size, with minContentMainAxisContributionForFlexItem. That returned the min-content contribution with the\ntable's border and padding included, and the border box then added them a second time.\n\nReturn the content-box size instead, like maxContentMainAxisExtentForFlexItem does, and rename the function to\nminContentMainAxisExtentForFlexItem to match.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327182\nWebKit-Canonical-Link: https://commits.webkit.org/323466@main\n\n--\n\nwpt-commits: 9b4c750f61f63d9f1251f7c594600ee696c57f48\nwpt-pr: 64098\n", "files": ["testing/web-platform/tests/css/css-flexbox/table-flex-item-min-width-001-ref.html", "testing/web-platform/tests/css/css-flexbox/table-flex-item-min-width-001.html"], "git_node": "f1221b801ecdb0bbadd3b7d766fab2515d9fa362", "git_parents": ["0bf078972382eb9d296c45e193caf6a971c4509c"], "node": "3844c83e14f4b6154bdaf520d79174498217688e", "parents": ["65af85a8d49bfa2c289522ca13bab0e5fc2a167b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086839 [wpt PR 64098] - Update wpt metadata, a=testonly\n\nwpt-pr: 64098\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-flexbox/inline-flex-editing-with-updating-text-crash.html.ini"], "git_node": "d5ddbae4e3ceda0f14480a97635f5b79b8093df4", "git_parents": ["f1221b801ecdb0bbadd3b7d766fab2515d9fa362"], "node": "50b8d9377ad8eec97b1e30a5783b46df86e890b4", "parents": ["3844c83e14f4b6154bdaf520d79174498217688e"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086845 [wpt PR 64101] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327060, a=testonly\n\nAutomatic update from web-platform-tests\n[line-clamp] Positioned inline-block after the clamp point is visible\n\n\u003cdiv style=\"line-clamp: 2\"\u003eLine 1\u003cbr\u003e\u003cspan style=\"display: inline-block; position: relative; width: 20px; height: 20px; background: blue\"\u003e\u003c/span\u003e\u003c/div\u003e\n(and then line-clamp: 1)\n\nThe inline-block keeps painting where it was before it got clamped.\n\"Within a line-clamp container, the following boxes and line boxes become invisible boxes:\n- Any in-flow or floating boxes that follow the clamp point in the box tree.\"\nhttps://drafts.csswg.org/css-overflow-4/#line-clamp-containers\n\nAtomic inline-level boxes after the clamp point have no display boxes, which is how they normally stay hidden, but one with\nits own layer paints through the layer, with whatever geometry it had before it got clamped.\n\nNow inline layout marks discarded atomic inline-level boxes as invisible boxes too.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327060\nWebKit-Canonical-Link: https://commits.webkit.org/323402@main\n\n--\n\nwpt-commits: c3be32974d9504118ffa656c20d643e3c1ad7f49\nwpt-pr: 64101\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-043.html"], "git_node": "4adb6b91effae53d7b9d8b8b28860823c58077a0", "git_parents": ["d5ddbae4e3ceda0f14480a97635f5b79b8093df4"], "node": "3f2ad8a6377c7a05429fa00b347fea7134e247e9", "parents": ["50b8d9377ad8eec97b1e30a5783b46df86e890b4"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086848 [wpt PR 64104] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323453, a=testonly\n\nAutomatic update from web-platform-tests\n[list-marker] A float in the list item's content pushes the list marker out with the line\n\nThe marker hangs off the line's inline start edge, which a float of that formatting context has already pushed\ninwards. Give that room back. A float intruding from earlier content keeps the marker with the line (webkit.org/b/166528).\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323453\nWebKit-Canonical-Link: https://commits.webkit.org/320549@main\n\n--\n\nwpt-commits: 58cb25cdd56cdb3112801ebcf8af8dfecfe37c02\nwpt-pr: 64104\n", "files": ["testing/web-platform/tests/css/css-lists/outside-marker-with-float-in-content-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-with-float-in-content.html"], "git_node": "3f2fbc35ad566dd7c3116e284ce9b9f3ecf901d2", "git_parents": ["4adb6b91effae53d7b9d8b8b28860823c58077a0"], "node": "0655d327d70ba2c0c1c96c5fd7be1532e5b702d4", "parents": ["3f2ad8a6377c7a05429fa00b347fea7134e247e9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086848 [wpt PR 64104] - Update wpt metadata, a=testonly\n\nwpt-pr: 64104\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-lists/before-after-selectors-on-code-element-crash.html.ini"], "git_node": "4634cf0845b83702d4d436046a840521f58ed676", "git_parents": ["3f2fbc35ad566dd7c3116e284ce9b9f3ecf901d2"], "node": "a650f45d59a81808fb6d032c74e0f0127476c318", "parents": ["0655d327d70ba2c0c1c96c5fd7be1532e5b702d4"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2086851 [wpt PR 64100] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326761, a=testonly\n\nAutomatic update from web-platform-tests\n:dir() of a \u003cbdi\u003e without a dir attribute takes its ancestor's direction when the ancestor's dir changes\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nWhen an element's dir attribute changes, updateEffectiveTextDirectionOfDescendants()\npropagates the new direction to its descendants, stopping only at elements whose dir\nattribute is in a valid state. A \u003cbdi\u003e element with no dir attribute behaves as\ndir=auto, so its directionality comes from its own contents, not from its parent.\nBecause the walk didn't stop at it, the \u003cbdi\u003e and its subtree took the ancestor's\ndirection and matched the wrong :dir() pseudo-class. updateHasDirAutoFlagForSubtree()\nalready skips \u003cbdi\u003e elements for this reason.\n\nSkip \u003cbdi\u003e elements and their subtrees in updateEffectiveTextDirectionOfDescendants().\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326761\nWebKit-Canonical-Link: https://commits.webkit.org/323439@main\n\n--\n\nwpt-commits: 69c416cbe5edd2291d6a0d51232c4a7f1926501a\nwpt-pr: 64100\n", "files": ["testing/web-platform/tests/html/semantics/selectors/pseudo-classes/dir-bdi-dynamic-ancestor.html"], "git_node": "1f83782ff347e7b4b6c317b072130a47cc34268a", "git_parents": ["4634cf0845b83702d4d436046a840521f58ed676"], "node": "066e25d87a251870565e43b3f6d3745828fc6238", "parents": ["a650f45d59a81808fb6d032c74e0f0127476c318"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086854 [wpt PR 64103] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323445, a=testonly\n\nAutomatic update from web-platform-tests\n[list-marker] align-content leaves the list marker behind\n\nAn outside marker is positioned against a line (RenderListItem::placeExcludedMarker) and takes no part in the inline\ncontent of that line. align-content moves the lines after they are built, and LineLayout::shiftLinesByInBlockDirection\nmoves the lines and the renderers of the boxes on them, so the marker stayed where the unshifted line was.\n\nMove the position the marker was given by the same amount.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323445\nWebKit-Canonical-Link: https://commits.webkit.org/320532@main\n\n--\n\nwpt-commits: 21afb273bd00633061cd694fa5a5d9719ec4c905\nwpt-pr: 64103\n", "files": ["testing/web-platform/tests/css/css-lists/outside-marker-with-align-content-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-with-align-content.html"], "git_node": "b24f9cd2e85a8d9dccaa22ffac8fd21ca7c9c7f9", "git_parents": ["1f83782ff347e7b4b6c317b072130a47cc34268a"], "node": "20e6bf5ad0900f27e6d89d3487a8e080b589d605", "parents": ["066e25d87a251870565e43b3f6d3745828fc6238"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086857 [wpt PR 64105] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323448, a=testonly\n\nAutomatic update from web-platform-tests\n[list-marker] text-indent moves the list marker with the text\n\ntext-indent is a margin on the line box, so the line's inline start edge already includes it and the marker hung off\nthat edge moved in with the text. Take the indent off first.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323448\nWebKit-Canonical-Link: https://commits.webkit.org/320533@main\n\n--\n\nwpt-commits: fdc4630ba739c376c3c6b64136d9bc5e4ac23bf9\nwpt-pr: 64105\n", "files": ["testing/web-platform/tests/css/css-lists/outside-marker-with-text-indent-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-with-text-indent.html"], "git_node": "e57371812e79b8f2a6f34ab5f17c8864d56fa8b9", "git_parents": ["b24f9cd2e85a8d9dccaa22ffac8fd21ca7c9c7f9"], "node": "427ffe8777e8cb8021268e6966ddde959906694d", "parents": ["20e6bf5ad0900f27e6d89d3487a8e080b589d605"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086862 [wpt PR 64102] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327005, a=testonly\n\nAutomatic update from web-platform-tests\n[line-clamp] Floats make the line-clamp container taller\n\n\u003cdiv style=\"line-clamp: 2\"\u003e\u003cdiv style=\"float: left; width: 10px; height: 200px\"\u003e\u003c/div\u003eLine 1\u003cbr\u003eLine 2\u003cbr\u003eLine 3\u003c/div\u003e\n\nThe line-clamp container should be two lines tall, but it grows to the bottom of the float.\n\"Within a line-clamp container, floats which have not been made into invisible boxes must be visually clipped to the\nunshaped block-end content edge of the line-clamp container. They do not introduce any clearance that would make the\nline-clamp container increase its height, and do not contribute to the scrollable overflow area.\"\nhttps://drafts.csswg.org/css-overflow-4/#line-clamp-containers\n\nNow a block container that establishes a line-clamp container does not expand its height to encompass its floats.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327005\nWebKit-Canonical-Link: https://commits.webkit.org/323349@main\n\n--\n\nwpt-commits: 81bd6d0cdcd3ddeb27c23d5e94451331fb88c84f\nwpt-pr: 64102\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-with-floats-015.html"], "git_node": "3c3f0f21341127ce4d46540dd3e7740d01b591f3", "git_parents": ["e57371812e79b8f2a6f34ab5f17c8864d56fa8b9"], "node": "e842da85d8c3e67408cea507400d4378631322a6", "parents": ["427ffe8777e8cb8021268e6966ddde959906694d"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086865 [wpt PR 64108] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322864, a=testonly\n\nAutomatic update from web-platform-tests\nREGRESSION(319910@main): unifi.ui.com crashes with unbounded recursion in Element::resolveComputedStyle\n\n  \u003cdiv style=\"display: none\"\u003e\n    \u003ciframe srcdoc=\"\u003cstyle id='sheet'\u003e#container { container-type: size }\u003c/style\u003e\n                    \u003cdiv id='container'\u003e\u003cspan id='target'\u003etext\u003c/span\u003e\u003c/div\u003e\"\u003e\u003c/iframe\u003e\n  \u003c/div\u003e\n\nAfter touching the frame's stylesheet, getComputedStyle(target).color should return a color.\nInstead we end up triggering style recalc in an infinite loop until the web process crashes.\n\nA frame whose owner element does not generate a box (e.g. display: none) has no render tree, so resolveStyle()\nreturns without doing anything and the recalc the stylesheet change scheduled stays pending forever.\nElement::resolveComputedStyle() asks for a style update on reaching a size query container, and since that\nupdate reports that it resolved style, re-enters computedStyle(), which comes back to the same container and\nasks again.\n\nFix by reporting no pending recalc while the render tree is withheld (matches Firefox), the way a document in\nthe back/forward cache already does. Showing the frame again resolves the style in createRenderTree().\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322864\nWebKit-Canonical-Link: https://commits.webkit.org/320119@main\n\n--\n\nwpt-commits: 75922697b621cb93526dc07efffc1e25ac33b69e\nwpt-pr: 64108\n", "files": ["testing/web-platform/tests/css/cssom/getComputedStyle-in-unrendered-subframe-with-query-container-crash.html"], "git_node": "25a4e0530eba16a11747c7fca17ef9f70d379056", "git_parents": ["3c3f0f21341127ce4d46540dd3e7740d01b591f3"], "node": "22661493630bc52e70ac6095ef6c77b745fc72d6", "parents": ["e842da85d8c3e67408cea507400d4378631322a6"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2086868 [wpt PR 64090] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327506, a=testonly\n\nAutomatic update from web-platform-tests\nSMIL: repeat(n) conditions never fire after seeking past repeat iterations\n\nWhen the timeline is seeked, SVGSMILElement::progress() queues a single\ncoalesced repeatEvent for the skipped iterations, but never records the\niteration number in m_pendingRepeatIterations. dispatchPendingEvent()\nonly updates m_lastDispatchedRepeatIteration from that queue, and\nreset() (called by SMILTimeContainer::setElapsed()) has just cleared it,\nso the value stays 0. Conditions such as begin=\"source.repeat(3)\" compare\nagainst lastDispatchedRepeatIteration() and therefore never match.\n\nAppend the iteration to m_pendingRepeatIterations before queuing the\nrepeatEvent on the seek path, as the non-seek path already does.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327506\nWebKit-Canonical-Link: https://commits.webkit.org/323927@main\n\n--\n\nwpt-commits: 80e000601a9331e5573f5221b06f406ce2a1f21b\nwpt-pr: 64090\n", "files": ["testing/web-platform/tests/svg/animations/seek-repeat-event-condition.html"], "git_node": "50efcff23ac1b5cb2a4a80c520260743d4f846ae", "git_parents": ["25a4e0530eba16a11747c7fca17ef9f70d379056"], "node": "f5e2ab4b666c2574f2bc2d2d4374535bf337bb23", "parents": ["22661493630bc52e70ac6095ef6c77b745fc72d6"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086868 [wpt PR 64090] - Update wpt metadata, a=testonly\n\nwpt-pr: 64090\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/animations/seek-repeat-event-condition.html.ini"], "git_node": "1834827b9e4c32746c6b5d0a59137de605e5ca37", "git_parents": ["50efcff23ac1b5cb2a4a80c520260743d4f846ae"], "node": "4cd920256d2d7da126cc29bcb506dff4a44860e3", "parents": ["f5e2ab4b666c2574f2bc2d2d4374535bf337bb23"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2086871 [wpt PR 64094] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327268, a=testonly\n\nAutomatic update from web-platform-tests\n[GFC][Integration] Allow grids with auto-fill tracks\n\nNow that we have built up the infrastructure in GFC to allow some form\nof auto repeat tracks we should be able to allow some content to run\nthrough it. Specifically, we will be allowing grids that have\nrepeat(auto-fill, ...) tracks to run through GFC since auto-fit will\ntake a bit more work.\n\nThe only caveat is that for rows we will still not allow tracks that\nhave percentages since we are still ironing out a few wrinkles with that\ntype of content.\n\nIt looks like we have a decent amount of WPT coverage with this feature\nrunning through GFC! One gap I closed is related to an OOF content where\nthe containing block is a grid so I added some tests for that as well.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327268\nWebKit-Canonical-Link: https://commits.webkit.org/323641@main\n\n--\n\nwpt-commits: 56891e5ce69264f57490aa684359a0b1d5720959\nwpt-pr: 64094\n", "files": ["testing/web-platform/tests/css/css-grid/abspos/grid-positioned-descendant-auto-fill-tracks-001.html", "testing/web-platform/tests/css/css-grid/abspos/grid-positioned-descendant-auto-fill-tracks-002.html"], "git_node": "ea9a047b343f2880c6951a9534653980b09bf8b7", "git_parents": ["1834827b9e4c32746c6b5d0a59137de605e5ca37"], "node": "dea81ea7a3091aa87116ec4c97ad03f50aec6b31", "parents": ["4cd920256d2d7da126cc29bcb506dff4a44860e3"], "tags": []}, {"author": "Antti Koivisto \u003cantti@apple.com\u003e", "branch": "default", "desc": "Bug 2086875 [wpt PR 64107] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321426, a=testonly\n\nAutomatic update from web-platform-tests\nHighlight color should inherit as StyleColor\n\nNormally currentcolor in `color` property resolves against the inherited parent style and can be fully resolved\nduring style building. However highlight pseudo-elements have special behavior where the inheritance\nchain goes via the parent element's highlight style but currentcolor is resolved against the\noriginating element. To do this correctly we need to keep around unresolved (StyleColor) version of\nthe color property value we normally don't need. This field can also later be used to resolve currentcolor\nagainst the lower highlight layer at paint time.\n\nhttps://drafts.csswg.org/css-pseudo-4/#highlight-cascade\n\nTo avoid complicating the regular paths this patch adds colorForHighlight as a separate rare data field.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321426\nWebKit-Canonical-Link: https://commits.webkit.org/320228@main\n\n--\n\nwpt-commits: 21f66aa05bbc19469d51dcf86827f0d4d2168d89\nwpt-pr: 64107\n", "files": ["testing/web-platform/tests/css/css-pseudo/highlight-cascade/highlight-cascade-currentcolor-color-mix.html"], "git_node": "0a4d59176fd6fa85ba286fa37d98db8449eb39e4", "git_parents": ["ea9a047b343f2880c6951a9534653980b09bf8b7"], "node": "d1c3b9c00c5d3cc532f341654bfd91342ee39d48", "parents": ["dea81ea7a3091aa87116ec4c97ad03f50aec6b31"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086875 [wpt PR 64107] - Update wpt metadata, a=testonly\n\nwpt-pr: 64107\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-pseudo/highlight-cascade/highlight-cascade-currentcolor-color-mix.html.ini"], "git_node": "381f588807e760235c123cf72807f61eec13653d", "git_parents": ["0a4d59176fd6fa85ba286fa37d98db8449eb39e4"], "node": "a0320b79c3b90909a00eac1a33abd40f1e0d7a13", "parents": ["d1c3b9c00c5d3cc532f341654bfd91342ee39d48"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086877 [wpt PR 64106] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323168, a=testonly\n\nAutomatic update from web-platform-tests\n[list-marker] Opening a \u003cdetails\u003e makes its summary one pixel shorter\n\n280433@main renders disclosure triangles with system-ui rather than with the font the marker inherited.\nIt gave RenderListMarker a font cascade of its own, built at paint time, and used it for painting,\nbut not for the marker box's height or its layout bounds, which stayed with the inherited font.\n\nMake the font part of the ::marker style instead, so that the glyph is measured with the font it is drawn with.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323168\nWebKit-Canonical-Link: https://commits.webkit.org/320461@main\n\n--\n\nwpt-commits: 6f2a787ba1366f52c401c3c99d517226a0d4035d\nwpt-pr: 64106\n", "files": ["testing/web-platform/tests/css/css-counter-styles/counter-style-at-rule/disclosure-line-height-ref.html", "testing/web-platform/tests/css/css-counter-styles/counter-style-at-rule/disclosure-line-height.html"], "git_node": "c6c30543d84ca65c41ed917d7293e95b7e7c6313", "git_parents": ["381f588807e760235c123cf72807f61eec13653d"], "node": "e9b52417cebce57bb45d3da04edcf3bc7ae2145e", "parents": ["a0320b79c3b90909a00eac1a33abd40f1e0d7a13"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086878 [wpt PR 64112] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322487, a=testonly\n\nAutomatic update from web-platform-tests\nA block level box on a line is left behind when a column break moves the line\n\nLine positions are adjusted for column and page breaks after inline layout has finished, while a block level\nbox on a line is laid out by block layout during inline layout, at the position the line had before that\nadjustment. Moving the lines afterwards moved the display boxes but left the block box's renderer where it\nwas, so it overlapped the line it is supposed to follow. A widow that made line layout restart hid this,\nwhich is why it took a case with no restart to see it.\n\nGive the renderer the offset its line took, and let it lay out again in case its own content breaks\ndifferently at the new position.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322487\nWebKit-Canonical-Link: https://commits.webkit.org/319821@main\n\n--\n\nwpt-commits: cb29ff8f38d03c8ed976337b5530ffd51d33b3a2\nwpt-pr: 64112\n", "files": ["testing/web-platform/tests/css/css-multicol/block-in-inline-after-column-break-001.html"], "git_node": "5f6d0834201efb72f929308b232315b3145ad7fd", "git_parents": ["c6c30543d84ca65c41ed917d7293e95b7e7c6313"], "node": "b9b3934f2d0dfb2e0be3ca8098c957f594ef7411", "parents": ["e9b52417cebce57bb45d3da04edcf3bc7ae2145e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086878 [wpt PR 64112] - Update wpt metadata, a=testonly\n\nwpt-pr: 64112\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-multicol/block-in-inline-after-column-break-001.html.ini"], "git_node": "fec0661879770b8bbc62522943035e2d98ba9f8a", "git_parents": ["5f6d0834201efb72f929308b232315b3145ad7fd"], "node": "641292290669efb887c5577aa95e9e19040fc78a", "parents": ["b9b3934f2d0dfb2e0be3ca8098c957f594ef7411"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086889 [wpt PR 64110] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322595, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] An orthogonal block level box in an inline box makes its container as wide as the box instead of as its content\n\nThe line asks the render tree what a block level box on it costs along the line's inline axis, and got the\nbox's own inline size back. When the box's writing mode is orthogonal to the line's, that is the wrong axis.\nRead the box's intrinsic block size for that case, which is what block layout reads for an orthogonal block\nchild in the block level branch of RenderBlockFlow::computeInlinePreferredLogicalWidths.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322595\nWebKit-Canonical-Link: https://commits.webkit.org/319897@main\n\n--\n\nwpt-commits: d772dd8d9df67c8d768fccd90e133893a2562edc\nwpt-pr: 64110\n", "files": ["testing/web-platform/tests/css/css-writing-modes/orthogonal-block-in-inline-inline-size-001.html"], "git_node": "b5da8988bc7d8cdc30656f3b96da8b59497f7270", "git_parents": ["fec0661879770b8bbc62522943035e2d98ba9f8a"], "node": "c9feb7d274aba1c1c1b47e74d1008f3d995984c6", "parents": ["641292290669efb887c5577aa95e9e19040fc78a"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086890 [wpt PR 64109] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322597, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] An orthogonal block level box in an inline box is misplaced\n\nRenderBlockFlow::layoutSimpleBlockContentInInline lays a block level box on a line out again where it already\nis. It read the position back with RenderBox::logicalTop(), which is on the box's own block axis, and handed it\nto layoutBlockChildFromInlineLayout, which writes it on the container's. Orthogonal writing modes make those\ntwo different axes, so the box landed at its inline offset along the container's block axis: 55px into a\ncontainer whose only line before it takes 20px, sitting on that line rather than after it.\n\nRead and write the position through the container's own accessors, which is what put the box there in the first\nplace.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322597\nWebKit-Canonical-Link: https://commits.webkit.org/319895@main\n\n--\n\nwpt-commits: a13ef32348c9743b608034eaeee10f640bf7c4e5\nwpt-pr: 64109\n", "files": ["testing/web-platform/tests/css/css-writing-modes/orthogonal-block-in-inline-block-axis-position-001.html"], "git_node": "b895dd424a421a84add85c4219fe95ab6bc1dcbc", "git_parents": ["b5da8988bc7d8cdc30656f3b96da8b59497f7270"], "node": "64652542bdf3bd22be625c375b9dde9c3667466f", "parents": ["c9feb7d274aba1c1c1b47e74d1008f3d995984c6"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086892 [wpt PR 64113] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322332, a=testonly\n\nAutomatic update from web-platform-tests\n[anon-block-removal] Adjoining margins do not collapse when the container's first child is a float or an out-of-flow box\n\nRenderTreeBuilder::Block::attach decides childrenInline from the first child but skips that when the child is\nfloating or out-of-flow, so a leading float or out-of-flow box leaves the parent non-empty and the first in-flow\nchild never reaches the branch that would turn the flag off. A container whose in-flow children are all block\nlevel then runs an inline formatting context, which leaves adjoining margins between those boxes uncollapsed,\nmoves out-of-flow static positions and changes what align-content aligns. Ask whether an in-flow child has\narrived rather than whether the box is empty, skipping floats, out-of-flow boxes and an excluded marker.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322332\nWebKit-Canonical-Link: https://commits.webkit.org/319696@main\n\n--\n\nwpt-commits: 87a5420e1f7f61c856891ee64c424c177babc6a9\nwpt-pr: 64113\n", "files": ["testing/web-platform/tests/css/CSS2/normal-flow/margin-collapse-after-float-001-ref.html", "testing/web-platform/tests/css/CSS2/normal-flow/margin-collapse-after-float-001.html"], "git_node": "34bebed82fb488524edfbbe867efd6317d7bac3f", "git_parents": ["b895dd424a421a84add85c4219fe95ab6bc1dcbc"], "node": "3f11dbbf4836bb44d460fa3be03cd5e88ec4a864", "parents": ["64652542bdf3bd22be625c375b9dde9c3667466f"], "tags": []}, {"author": "Sam Weinig \u003csam@webkit.org\u003e", "branch": "default", "desc": "Bug 2086895 [wpt PR 64095] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327310, a=testonly\n\nAutomatic update from web-platform-tests\n[Image Redux] Use replacedContentRect() consistently in RenderImage\n\nWe can stop using contentRect() in RenderImage when hasNaturalAspectRatio() is false now that replacedContentRect()\nworks on the natural dimensions and can handle that case just fine. To remove all uses, computePaintRectForObjectViewBox()\nalso had to be updated to use natural dimensions.\n\nMaking everything going through replacedContentRect() also fixes another edge case of an SVG with only a width\nusing 'object-fit: none' or 'object-fit: scale-down'.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327310\nWebKit-Canonical-Link: https://commits.webkit.org/323567@main\n\n--\n\nwpt-commits: fdf7834bcd1a74ccecfdd93d94868a23a282af1d\nwpt-pr: 64095\n", "files": ["testing/web-platform/tests/css/css-images/object-fit-none-svg-width-only-ref.html", "testing/web-platform/tests/css/css-images/object-fit-none-svg-width-only.html"], "git_node": "29472a51bebc1e699a6410dab677aa6c47e91c64", "git_parents": ["34bebed82fb488524edfbbe867efd6317d7bac3f"], "node": "979e6463eaed029b4f23c15b6967d48a0fea41c5", "parents": ["3f11dbbf4836bb44d460fa3be03cd5e88ec4a864"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086895 [wpt PR 64095] - Update wpt metadata, a=testonly\n\nwpt-pr: 64095\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-images/object-fit-none-svg-width-only.html.ini"], "git_node": "ab5557e5b34353374693ff2d90a75c63c0a3a322", "git_parents": ["29472a51bebc1e699a6410dab677aa6c47e91c64"], "node": "785b498d73b204da7c79aa5df3de1553c25dd41f", "parents": ["979e6463eaed029b4f23c15b6967d48a0fea41c5"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086898 [wpt PR 64111] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322458, a=testonly\n\nAutomatic update from web-platform-tests\nList marker is painted on top of the list item's content instead of behind it\n\nRenderListItem::paintObject paints the marker after calling the base class, so the marker ends up over the list\nitem's content instead of behind it. Content that reaches back across the marker, a first line pulled out by a\nnegative margin, is drawn under the marker rather than covering it.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322458\nWebKit-Canonical-Link: https://commits.webkit.org/319818@main\n\n--\n\nwpt-commits: c52bdebae9c5019571d5c35705130a91170b2b39\nwpt-pr: 64111\n", "files": ["testing/web-platform/tests/css/css-lists/list-marker-paint-order-ref.html", "testing/web-platform/tests/css/css-lists/list-marker-paint-order.html"], "git_node": "2a7f48e87a83546ee60b528835b065ddfe5bf5de", "git_parents": ["ab5557e5b34353374693ff2d90a75c63c0a3a322"], "node": "d1ea51d550e5150e172859b24be1744ff0b6b6df", "parents": ["785b498d73b204da7c79aa5df3de1553c25dd41f"], "tags": []}, {"author": "Daniil Sakhapov \u003csakhapov@chromium.org\u003e", "branch": "default", "desc": "Bug 2086900 [wpt PR 64115] - Add a WPT for user-action pseudo-classes when an ancestor changes, a=testonly\n\nAutomatic update from web-platform-tests\nAdd a WPT for user-action pseudo-classes when an ancestor changes\n\nFor a rule like `.a :hover`, Blink invalidates the whole subtree when\nclass `a` is added to or removed from an element. That recalc is what\nre-establishes the AffectedByHover/Active/FocusWithin flags on the\ndescendants' ComputedStyle, and those flags are what makes a later\nhover, active or focus-within change recalculate the element. So the\nover-invalidation is load-bearing: an optimization which only restyles\nthe descendants currently in the state (as attempted in\nhttps://crrev.com/c/8536747) breaks the sequence \"ancestor gains the\nclass, then the state moves to a descendant that was not restyled\".\n\nNo existing test covers that sequence: the hover/focus invalidation\ntests either have the rule in scope from the start, or only check the\nelement which is in the state at the time of the class change. This\nadds a WPT for :focus, :focus-within, :is(:focus, .other), :not(:focus),\na sibling :focus rule, :hover and :hover:active, where the state moves\nto a different element after the ancestor/sibling change.\n\nThe test passes today and serves as a regression test for the\n:focus-only optimization that follows, and for any later extension of\nit to other pseudo-classes.\n\nChange-Id: Ib24d19c3205456b1bddaee389426adad4fe1de35\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8629833\nReviewed-by: Philip J\u00e4genstedt \u003cfoolip@chromium.org\u003e\nCommit-Queue: Daniil Sakhapov \u003csakhapov@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1725743}\n\n--\n\nwpt-commits: fedc4c26a44e6399c12afdcdac2a54dadb7f6e3f\nwpt-pr: 64115\n", "files": ["testing/web-platform/tests/css/selectors/invalidation/focus-pseudo-classes-when-ancestor-changes.html", "testing/web-platform/tests/css/selectors/invalidation/hover-active-pseudo-classes-when-ancestor-changes.html"], "git_node": "c297586f3e1108d58f1986994fac3fb64b66423c", "git_parents": ["2a7f48e87a83546ee60b528835b065ddfe5bf5de"], "node": "7faea61300a282fc84aa84ba0abb603cc0d7b881", "parents": ["d1ea51d550e5150e172859b24be1744ff0b6b6df"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2086903 [wpt PR 64087] - [wdspec] Fix preload script execution order test for inline script, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Fix preload script execution order test for inline script\n\n- Fix the preload script execution order test when a new popup runs an\n  inline script, and mark multi-case wdspec tests that exceed the\n  default timeout under CI load as slow.\n- Previously, the popup subtest opened a top-level `data:` URL from\n  script. Chrome blocks script-initiated top-level `data:` navigations,\n  which the Fetch specification allows, so the popup never emitted\n  `browsingContext.load` and timed out.\n- Serve the popup document over HTTP(S) with `inline()` while keeping\n  the `data:` URL for the iframe variant.\n\nTAG=agy\n\nFixed: 576637414\nBug: 365046210, 571887196, 573055465\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel,linux-blink-rel\nChange-Id: I4432efae3c271fa8e503da7c1a12ceff0972b822\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8641570\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nReviewed-by: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1725769}\n\n--\n\nwpt-commits: f643737658df207dc26e50e23ea6a76ccc8da47e\nwpt-pr: 64087\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/script/add_preload_script/execution_order_tentative.py"], "git_node": "cc3530eec903ceaafb992be2b9480694ba401b7a", "git_parents": ["c297586f3e1108d58f1986994fac3fb64b66423c"], "node": "cab20f875eda48ac4b6a5314490ea348f6d95d0f", "parents": ["7faea61300a282fc84aa84ba0abb603cc0d7b881"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086903 [wpt PR 64087] - Update wpt metadata, a=testonly\n\nwpt-pr: 64087\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/script/add_preload_script/add_preload_script.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/script/add_preload_script/contexts.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/script/add_preload_script/execution_order_tentative.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/script/add_preload_script/invalid.py.ini"], "git_node": "e2f2f75095057cd3736c78b9d81afa03a94098a8", "git_parents": ["cc3530eec903ceaafb992be2b9480694ba401b7a"], "node": "5fd1b42cd284ec5bd53a1bfafe548ed069fa9a17", "parents": ["cab20f875eda48ac4b6a5314490ea348f6d95d0f"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2086904 [wpt PR 64119] - Don't hold references to name or id across UpdateName()/UpdateId(), a=testonly\n\nAutomatic update from web-platform-tests\nDon't hold references to name or id across UpdateName()/UpdateId()\n\nElement::InsertedInto() took a const AtomicString& reference into the\nelement's attribute storage via GetNameAttribute() and passed it to\nUpdateName(). UpdateName() calls HTMLDocument::AddNamedItem(), which\ninitializes the frame's WindowProxy before calling NamedItemAdded().\nInitializing a sandboxed frame's script context installs\nchrome.loadTimes, which can invoke a page-defined setter on a child\nframe named 'chrome'. If that setter mutates the element's attributes\nand reallocates the attribute vector, the name_value reference dangles\nwhen NamedItemAdded() reads it.\n\nThis CL copies the name and id attributes into local AtomicStrings by\nvalue before calling UpdateName() and UpdateId() in InsertedInto(),\nRemovedFrom(), and CloneAttributesFrom().\n\nFixed: 576203565\nChange-Id: If2164a83f298dcfbea9b191776016eeadd8271a3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8633114\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nCommit-Queue: David Baron \u003cdbaron@chromium.org\u003e\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1725772}\n\n--\n\nwpt-commits: 2109247de705cacce0b7f0b6eba2a2e0a5351168\nwpt-pr: 64119\n", "files": ["testing/web-platform/tests/html/dom/documents/dom-tree-accessors/nameditem-insertion-attr-mutation.html"], "git_node": "d3d58bcd534463333ed9163a05f3336af35c3225", "git_parents": ["e2f2f75095057cd3736c78b9d81afa03a94098a8"], "node": "db9227045e56cae353dc6b0144deef83569ce2e7", "parents": ["5fd1b42cd284ec5bd53a1bfafe548ed069fa9a17"], "tags": []}, {"author": "Noam Rosenthal \u003cnoamr@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2082731 [wpt PR 63724] - Align existing LoAF tests with spec and expand coverage, a=testonly\n\nAutomatic update from web-platform-tests\nAlign existing LoAF tests with spec and expand coverage (#63724)\n\n* [LoAF] Align WPTs with spec and expand coverage\n\n- Update loaf-toJSON.html to assert all specified attributes on PerformanceLongAnimationFrameTiming and PerformanceScriptTiming.\n- Update loaf-source-location*.html and loaf-script-block.html to also assert 1-based sourceLine and sourceColumn (alongside 0-based sourceCharPosition), and allow optional promise creation-time attribution (\"Promise.then\" / \"Promise.catch\" and -1 / \"\" fallback) in resources/utils.js and loaf-source-location*.html.\n- Add styleDuration, layoutDuration, forcedStyleDuration, and forcedLayoutDuration to interfaces/long-animation-frames.idl, and strengthen loaf-style-duration.html, loaf-layout-duration.html, loaf-forced-style-duration.html, and loaf-forced-layout-duration.html with positive (\u003e 0) duration assertions.\n- Add tests for windowAttribution after navigation, #id over [src] invoker precedence, multi-listener event dispatch blockingDuration, module-script executionStart === startTime, firstUIEventTimestamp coarsening, buffered PerformanceObserver entries, script entries across tasks in the same frame, and crossOriginIsolated timestamp resolution.\n\n* Fix wpt-chrome-dev-stability issues and address review feedback\n--\n\nwpt-commits: affba5aaa78c6fdfe18a0a109b3a4172d31d585d\nwpt-pr: 63724\n", "files": ["testing/web-platform/tests/interfaces/long-animation-frames.idl", "testing/web-platform/tests/lint.ignore", "testing/web-platform/tests/long-animation-frame/loaf-basic.html", "testing/web-platform/tests/long-animation-frame/loaf-blocking-duration.html", "testing/web-platform/tests/long-animation-frame/loaf-buffered.html", "testing/web-platform/tests/long-animation-frame/loaf-cross-origin-isolated.https.html", "testing/web-platform/tests/long-animation-frame/loaf-cross-origin-isolated.https.html.headers", "testing/web-platform/tests/long-animation-frame/loaf-event-listener.html", "testing/web-platform/tests/long-animation-frame/loaf-first-ui-event.html", "testing/web-platform/tests/long-animation-frame/loaf-forced-layout-duration.html", "testing/web-platform/tests/long-animation-frame/loaf-forced-style-duration.html", "testing/web-platform/tests/long-animation-frame/loaf-iframe-self.html", "testing/web-platform/tests/long-animation-frame/loaf-layout-duration.html", "testing/web-platform/tests/long-animation-frame/loaf-pause-duration.html", "testing/web-platform/tests/long-animation-frame/loaf-promise-scheduled-render.html", "testing/web-platform/tests/long-animation-frame/loaf-script-block.html", "testing/web-platform/tests/long-animation-frame/loaf-script-window-attribution.html", "testing/web-platform/tests/long-animation-frame/loaf-source-location-redirect.html", "testing/web-platform/tests/long-animation-frame/loaf-source-location.html", "testing/web-platform/tests/long-animation-frame/loaf-style-duration.html", "testing/web-platform/tests/long-animation-frame/loaf-toJSON.html", "testing/web-platform/tests/long-animation-frame/loaf-user-callback.html", "testing/web-platform/tests/long-animation-frame/loaf-visibility.html", "testing/web-platform/tests/long-animation-frame/resources/utils.js"], "git_node": "86b85d89782977f851684cf75716ebf316245ba6", "git_parents": ["d3d58bcd534463333ed9163a05f3336af35c3225"], "node": "9e9b432f0e4613dd17e250e52ee123fffe7eee66", "parents": ["db9227045e56cae353dc6b0144deef83569ce2e7"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2086910 [wpt PR 64114] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328637, a=testonly\n\nAutomatic update from web-platform-tests\nQueue Document-Isolation-Policy CORP violation reports for cached and service worker responses\n\nThe cross-origin resource policy check of a memory cache hit and of a service\nworker's response now queues reports too, for Document-Isolation-Policy and\nCross-Origin-Embedder-Policy alike. Before, both checks only blocked. The check\nthe network process does for network loads moves to WebCore as\nperformCrossOriginResourcePolicyCheck(), so all three share it.\n\nThe reports for a response from the network process's HTTP cache had an empty\nblockedURL, as nothing recorded the first URL of its URL list. That affected\nCross-Origin-Embedder-Policy too, whose reports to a ReportingObserver also kept\nthe blocked URL's credentials and fragment.\n\nA document doesn't report a memory cache hit again for an image it already uses\nor for a preload it consumes, with the same mode and origin, as the\nspecification doesn't fetch those again. A memory cache hit that the request\nloads again, such as one that is still loading for a request of another mode, is\nleft to that load, so that it doesn't report twice.\n\nNot covered yet, also for Cross-Origin-Embedder-Policy:\n- The loads of a dedicated worker report to its owner document rather than to\n  the worker, and their memory cache hits don't report.\n- The Cache API queues no reports.\n- A document that joins a load another document of its origin has in flight gets\n  neither the check nor a report.\n- A service worker's response is reported with the requested URL. That isn't the\n  first URL of the response's URL list if the worker fetched another URL, but\n  the response only has its last URL.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328637\n\n--\n\nwpt-commits: 5958ffed26d41dd69ca8527a2d2a0e99b6c28750\nwpt-pr: 64114\n", "files": ["testing/web-platform/tests/html/cross-origin-embedder-policy/reporting-cached-and-service-worker-responses.https.html", "testing/web-platform/tests/html/cross-origin-embedder-policy/resources/respond-with-fetch-sw.js", "testing/web-platform/tests/html/document-isolation-policy/reporting-cached-and-service-worker-responses.tentative.https.html", "testing/web-platform/tests/html/document-isolation-policy/resources/respond-with-fetch-sw.js"], "git_node": "afa0009097beaab69d213b2789bbcda3b25152f0", "git_parents": ["86b85d89782977f851684cf75716ebf316245ba6"], "node": "24bcff520e1cc7f380860cf0d0e149af8651e758", "parents": ["9e9b432f0e4613dd17e250e52ee123fffe7eee66"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086910 [wpt PR 64114] - Update wpt metadata, a=testonly\n\nwpt-pr: 64114\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/cross-origin-embedder-policy/reporting-cached-and-service-worker-responses.https.html.ini", "testing/web-platform/meta/html/document-isolation-policy/reporting-cached-and-service-worker-responses.tentative.https.html.ini"], "git_node": "551f188e7ee328a599b92333c1759c08ecc77bfb", "git_parents": ["afa0009097beaab69d213b2789bbcda3b25152f0"], "node": "57fdc43f2619d4b7b165b48aa15e4b6b55ab907c", "parents": ["24bcff520e1cc7f380860cf0d0e149af8651e758"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2086912 [wpt PR 64128] - [wdspec] Use visual viewport dimensions in BiDi screenshot WPTs, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Use visual viewport dimensions in BiDi screenshot WPTs\n\n- Check viewport screenshot dimensions against visualViewport in\n  WebDriver BiDi captureScreenshot WPTs.\n- Viewport screenshots capture the visual viewport, which differs from\n  the integer layout viewport on mobile and zoomed pages, and rounding\n  of fractional physical pixels is implementation-defined.\n- Read window.visualViewport dimensions before capturing and compare\n  scaled PNG sizes with a 1-pixel rounding tolerance.\n\nTAG=agy\n\nBug: 565712857\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel,linux-blink-rel,android-15-chrome-blink-rel\nChange-Id: I2cee291b0d089522f67ab01757b4ba9b0079e461\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8598329\nReviewed-by: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nCommit-Queue: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1721727}\n\n--\n\nwpt-commits: 4c84e7fd4044b24100f230219e3464f815a0ead9\nwpt-pr: 64128\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/browsing_context/capture_screenshot/__init__.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/capture_screenshot/capture_screenshot.py"], "git_node": "7eba283f0890240a85720d1f1aa4badceb6c4086", "git_parents": ["551f188e7ee328a599b92333c1759c08ecc77bfb"], "node": "3c97fec57c961e60f27e172050465be2b8f5c282", "parents": ["57fdc43f2619d4b7b165b48aa15e4b6b55ab907c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086912 [wpt PR 64128] - Update wpt metadata, a=testonly\n\nwpt-pr: 64128\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/browsing_context/capture_screenshot/capture_screenshot.py.ini"], "git_node": "1cf7cdf12a06ed0013190c107af40e8be49410a5", "git_parents": ["7eba283f0890240a85720d1f1aa4badceb6c4086"], "node": "7b79e52673eb68ee29142f92cc61485f69bdd7f6", "parents": ["3c97fec57c961e60f27e172050465be2b8f5c282"], "tags": []}, {"author": "Jose Dapena Paz \u003cjdapena@igalia.com\u003e", "branch": "default", "desc": "Bug 2086915 [wpt PR 64120] - Paint timing: attribute anonymous content-image pseudos via GeneratingNode, a=testonly\n\nAutomatic update from web-platform-tests\nPaint timing: attribute anonymous content-image pseudos via GeneratingNode\n\nAn image generated by \"content: url(...)\" on a pseudo element is laid\nout as an anonymous LayoutImage, whose GetNode() is null.\nImagePaintTimingDetector::RecordImage() resolved non-background images\nvia GetNode(), and the soft navigation paint attribution tracker skipped\nanonymous image objects, so these images were never LCP/ICP candidates\nnor attributed to a soft navigation.\n\nResolve them via LayoutObject::GeneratingNode(), as ElementTiming and\nRecordImage() for background images already do. The record keeps keying\non the painting LayoutObject, so removing the anonymous image still\nclears it. This also makes list-style-image markers, the other anonymous\nLayoutImage, LCP/ICP candidates, matching ElementTiming.\n\nBoth changes are gated on the new PaintTimingContentImagePseudoElements\nruntime flag (experimental). It replaces AllImagesPaintedSentToElementTiming,\nso a single flag covers all paint timing clients.\nPaintTimingVisualizer::RecordObject() also uses GeneratingNode(), so\nanonymous objects get a dom_node_id in traces.\n\nTests: unit tests for the enabled, disabled, removal and list marker\ncases; WPTs for hard-navigation LCP and for ICP with and without a\ncompeting text node.\n\nBug: 571179206\nChange-Id: Ie58eb5f09081e8c706852fe18538b3da11442c61\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8130402\nReviewed-by: Scott Haseley \u003cshaseley@chromium.org\u003e\nCommit-Queue: Jos\u00e9 Dapena Paz \u003cjdapena@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1725940}\n\n--\n\nwpt-commits: 77c26200baeaeffa02b95933d38258c86bdd0be9\nwpt-pr: 64120\n", "files": ["testing/web-platform/tests/largest-contentful-paint/pseudo-content-image.html", "testing/web-platform/tests/soft-navigation-heuristics/icp/tentative/pseudo-element-content-image-with-text.html", "testing/web-platform/tests/soft-navigation-heuristics/icp/tentative/pseudo-element-content-image.html"], "git_node": "1d67664070f3c81e028c5eeb302f736212033f72", "git_parents": ["1cf7cdf12a06ed0013190c107af40e8be49410a5"], "node": "ea80e1a388cd64c117dd131beeaec1d255b7efab", "parents": ["7b79e52673eb68ee29142f92cc61485f69bdd7f6"], "tags": []}, {"author": "Aaron Leventhal \u003caleventhal@google.com\u003e", "branch": "default", "desc": "Bug 2086918 [wpt PR 64131] - [HitTest] Add culled inline ancestors of self-painting items to lists, a=testonly\n\nAutomatic update from web-platform-tests\n[HitTest] Add culled inline ancestors of self-painting items to lists\n\nA culled inline is an inline element, such as a plain \u003cspan\u003e, that has\nno box fragment of its own. BoxFragmentPainter::HitTestItemsChildren()\nadds culled inline ancestors by calling HitTestCulledInlineAncestors()\nafter each item. It skips that call for items with a self-painting\nlayer, such as a position:relative child, because that layer is\nhit-tested separately. The layer's own hit test never adds the culled\nancestors outside it, so nothing does.\n\nFor example, given\n\n  \u003cspan id=a\u003e\u003cspan style=\"position:relative\"\u003eText\u003c/span\u003e\u003c/span\u003e\n\ndocument.elementsFromPoint() returns the inner span but not #a. WebKit\nreturns both, and CSSOM View says elementsFromPoint() returns every box\nat the point, in paint order. #a is also missing at points on its own\ntext after such a child, such as \"after\" in\n\n  \u003cspan id=a\u003e\u003cspan style=\"position:relative\"\u003eText\u003c/span\u003eafter\u003c/span\u003e\n\nbecause that text relies on its earlier sibling to add #a.\n\nWith this change, list-based hit tests let self-painting items fall\nthrough to the existing culled inline check, as they already do for\nother inline items.\n\nDOM event targets are unaffected. Mouse, pointer, and gesture events get\ntheir targets from single-point hit tests, which this change does not\ntouch. Those tests return the innermost element, and events bubble\nnormally through ancestor inlines. :hover and :active are set on every\nancestor of the hit element, so #a already matches them.\n\nBug: 576771254\nChange-Id: I5c8c007bbbbebd39d6f9a7c6bb6d759f8e206171\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8642474\nCommit-Queue: Aaron Leventhal \u003caleventhal@google.com\u003e\nReviewed-by: Khushal Sagar \u003ckhushalsagar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1726041}\n\n--\n\nwpt-commits: 0cdbe44ed57bdb3aeedd6f1f032d845eb6dbbb4a\nwpt-pr: 64131\n", "files": ["testing/web-platform/tests/css/cssom-view/elementsFromPoint-inline-self-painting.html"], "git_node": "0ef3987a3d7cf11146197618e7473dc96bdfde85", "git_parents": ["1d67664070f3c81e028c5eeb302f736212033f72"], "node": "c194cd9107aec5e700ae3d2213ca12d405f72a7a", "parents": ["ea80e1a388cd64c117dd131beeaec1d255b7efab"], "tags": []}, {"author": "Olga Gerchikov \u003cgerchiko@microsoft.com\u003e", "branch": "default", "desc": "Bug 2086920 [wpt PR 64125] - [ScopedVT] Fix hit testing of captured scopes\u2019 transition overlays, a=testonly\n\nAutomatic update from web-platform-tests\n[ScopedVT] Fix hit testing of captured scopes\u2019 transition overlays\n\nWhen a scoped view transition's root is also a captured participant,\nPaintLayer::HitTestLayer() rejects its ordinary content before visiting\nthe transition pseudo subtree. This incorrectly prevents hits on the\nscope's ::view-transition overlay.\n\nMove the captured-content exclusion after the transition-pseudo hit-test\npass. This allows overlay hits while continuing to exclude captured\nparticipants at their ordinary DOM locations, as required by CSS View\nTransitions Level 2:\nhttps://drafts.csswg.org/css-view-transitions-2/#view-transition-stacking-layer\n\nBug: 576731819\nChange-Id: I0366a2ce2ce3c70b6f833a5e722ef06bed24923d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8635958\nReviewed-by: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCommit-Queue: Olga Gerchikov \u003cgerchiko@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1726062}\n\n--\n\nwpt-commits: 24dc99df369390fee6fe581bd8ba7d328e180f96\nwpt-pr: 64125\n", "files": ["testing/web-platform/tests/css/css-view-transitions/scoped/hit-test-captured-scope.html"], "git_node": "ad59af919cdfec92ca2ccd90069bb3f3c29fed5d", "git_parents": ["0ef3987a3d7cf11146197618e7473dc96bdfde85"], "node": "c0df9b2d1140592bed2025f73fa466a6de2af67c", "parents": ["c194cd9107aec5e700ae3d2213ca12d405f72a7a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086920 [wpt PR 64125] - Update wpt metadata, a=testonly\n\nwpt-pr: 64125\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-view-transitions/scoped/hit-test-captured-scope.html.ini"], "git_node": "42831c7e5a3a15505feaa1136c24caedddeb0e97", "git_parents": ["ad59af919cdfec92ca2ccd90069bb3f3c29fed5d"], "node": "6f0d7c6e98d2eb7a14bfe2a1e4b9597c50ef5a08", "parents": ["c0df9b2d1140592bed2025f73fa466a6de2af67c"], "tags": []}, {"author": "Yanling Wang \u003cyanlingwang@microsoft.com\u003e", "branch": "default", "desc": "Bug 2086922 [wpt PR 64123] - [Masonry] Complete descendant standalone sizing through grid-lanes subgrids, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Complete descendant standalone sizing through grid-lanes\nsubgrids\n\n`GridLanesLayoutAlgorithm::CompleteTrackSizingAlgorithm()` returns\nearly when the requested direction is not the container's grid axis.\nThis also prevents traversal into nested regular grid subgrids whose\nstandalone tracks need sizing in that direction, leaving their geometry\nunresolved.\n\nTo fix this issue, continue sizing traversal through child subgrids\nbefore returning. Added related wpt tests.\n\nBug: 343257585\nChange-Id: I2459143c898350ee18e1e4f4f7f51962c39b2110\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8615272\nReviewed-by: Celeste Pan \u003ccelestepan@microsoft.com\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Yanling Wang \u003cyanlingwang@microsoft.com\u003e\nReviewed-by: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1726089}\n\n--\n\nwpt-commits: c15b9acdfaadd960a71fe1b8454e599aa70b59a4\nwpt-pr: 64123\n", "files": ["testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/track-sizing/column-subgrid-with-row-standalone-axis-size-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/track-sizing/column-subgrid-with-row-standalone-axis-size-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/track-sizing/column-subgrid-with-row-standalone-axis-size-002.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/track-sizing/row-subgrid-with-column-standalone-axis-size-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/track-sizing/row-subgrid-with-column-standalone-axis-size-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/track-sizing/row-subgrid-with-column-standalone-axis-size-002.html"], "git_node": "078dffb5cdf5609fdcb0bdacd05a4df8e4468994", "git_parents": ["42831c7e5a3a15505feaa1136c24caedddeb0e97"], "node": "0626c70c0fea4cf086b5ccb69da9596114a19e6d", "parents": ["6f0d7c6e98d2eb7a14bfe2a1e4b9597c50ef5a08"], "tags": []}, {"author": "Joey Arhar \u003cjarhar@chromium.org\u003e", "branch": "default", "desc": "Bug 2086924 [wpt PR 64011] - Open select picker when clicking associated label, a=testonly\n\nAutomatic update from web-platform-tests\nOpen select picker when clicking associated label\n\nWhen a \u003clabel\u003e associated with a \u003cselect\u003e is clicked,\nHTMLLabelElement::DefaultEventHandlerInternal dispatches a simulated\nclick event on the \u003cselect\u003e with an UnderlyingEvent. Handle trusted\nsimulated click events in MenuListSelectType::DefaultEventHandler by\nopening the select popup.\n\nFixed: 565410880\nChange-Id: I63438356f2a7cc87d0e174b779517d6188b01e54\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8495348\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1726145}\n\n--\n\nwpt-commits: 384ad5ff11a6b97be0747773961556be6c9bfabf\nwpt-pr: 64011\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-label-element/control-active-with-multiple-clicks.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-mouse-behavior.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/select-label-click.tentative.html"], "git_node": "581990a1b1f5e0aaaa3b5c55b44cd1a63a1ba372", "git_parents": ["078dffb5cdf5609fdcb0bdacd05a4df8e4468994"], "node": "8e19156f2858d141bb703784afef4c981d07fddf", "parents": ["0626c70c0fea4cf086b5ccb69da9596114a19e6d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086924 [wpt PR 64011] - Update wpt metadata, a=testonly\n\nwpt-pr: 64011\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/forms/the-select-element/select-label-click.tentative.html.ini"], "git_node": "f54eae390f8350eef33fefdcfe66efc29a14ab9a", "git_parents": ["581990a1b1f5e0aaaa3b5c55b44cd1a63a1ba372"], "node": "0bc9832bc95f9f4f1327a26902f4c53ba68db9ea", "parents": ["8e19156f2858d141bb703784afef4c981d07fddf"], "tags": []}, {"author": "Alison Maher \u003calmaher@microsoft.com\u003e", "branch": "default", "desc": "Bug 2086926 [wpt PR 64133] - [Masonry] Adjust column items for fragmentation expansion, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Adjust column items for fragmentation expansion\n\nWhen a grid-lanes item is fragmented, it may grow beyond the block size\nit was given during placement, for example when its content is pushed by\na fragmentainer break or when its min block size encompasses its\nfragmented intrinsic size.\n\nThis change tracks the remaining block size of each column item as it is\nfragmented. When an item reaches its block end with a negative remaining\nsize, the expansion is recorded as an item offset adjustment on every\nlane it spans, and unstarted items in those lanes are shifted down by\nthat amount.\n\nThe expansion is recorded as soon as the item reaches its block end\nrather than when it has no break token, since overflowing content may\ncontinue in the next fragmentainer while later items in its lanes are\nstill laid out in the current one. The persisted total intrinsic block\nsize is also updated so that later fragments reflect the growth.\n\nItems spanning multiple lanes need additional handling, since each\nspanned lane may have expanded by a different amount. The intrinsic\nblock size of each column in the current fragment is tracked with\n`ColumnBreakInfo`, matching column flex containers, and a spanner is\npushed down by however far the content in any of its lanes now reaches\npast its original margin-box start, minus the gap. To support this, the\nblock-start margin of each item is now persisted alongside its block-end\nmargin.\n\nRow grid-lanes containers are not changed, since their block size is\ndriven by row tracks rather than items. Row expansion will be handled\nalong with row break rules.\n\nBug: 343257585\nChange-Id: I36a4fb1545397958fafcc0b1ab428918729bc850\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8620707\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCommit-Queue: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1726198}\n\n--\n\nwpt-commits: 6ba3ec251c380207d325aca98750f70b8a67e043\nwpt-pr: 64133\n", "files": ["testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-026.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-027.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-028.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-029.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-030.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-031.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-032.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-033.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-034.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-035.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-036.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-037.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-038.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-single-lane-fragmentation-009.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-single-lane-fragmentation-010.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-single-lane-fragmentation-011.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-single-lane-fragmentation-012.html"], "git_node": "d29f58ca4cef636d101e4a8398a01a92f62984ce", "git_parents": ["f54eae390f8350eef33fefdcfe66efc29a14ab9a"], "node": "0643be75b8e7988660c97daefc13de35e931f254", "parents": ["0bc9832bc95f9f4f1327a26902f4c53ba68db9ea"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086926 [wpt PR 64133] - Update wpt metadata, a=testonly\n\nwpt-pr: 64133\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-027.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-030.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-038.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-single-lane-fragmentation-010.html.ini"], "git_node": "c5ff3618fbf83f704fce472613746f77d749b113", "git_parents": ["d29f58ca4cef636d101e4a8398a01a92f62984ce"], "node": "63664bfc1c3580d9524a74a1335354f2dbfd36b2", "parents": ["0643be75b8e7988660c97daefc13de35e931f254"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2086930 [wpt PR 64138] - Fix UAF in TransitionPseudoElementData::ClearPseudoElements, a=testonly\n\nAutomatic update from web-platform-tests\nFix UAF in TransitionPseudoElementData::ClearPseudoElements\n\nMove transition_containers_ into a local map before disposing entries\nin TransitionPseudoElementData::ClearPseudoElements, and release\ncolumn_pseudo_elements_ and transition_data_ before clearing them in\nPseudoElementData::ClearPseudoElements so re-entrant lookups or\nmutations cannot invalidate an active iterator.\n\nAlso prevent PseudoElements from being registered in TreeScope ID or\nname maps in Element::UpdateId and Element::UpdateName, and ensure\nHitTestResult::GetPosition uses inner_node_ rather than a PseudoElement\nwhen ChildPaintBlockedByDisplayLock is true.\n\nFixed: 576169244\nBug: 576169244\nChange-Id: I3d412dd2defa1eb3149d1d1fa254a8a367571f4c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8634694\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1726202}\n\n--\n\nwpt-commits: 37630a55751b69535c10bdec2b8ab223f48bbc5d\nwpt-pr: 64138\n", "files": ["testing/web-platform/tests/css/css-view-transitions/clear-pseudo-elements-nested-style-update.html"], "git_node": "203eb732299c239495d6175c81dce4af24aa29de", "git_parents": ["c5ff3618fbf83f704fce472613746f77d749b113"], "node": "5df27c4bbed0e91643ad4ff0d5ef52f920c96437", "parents": ["63664bfc1c3580d9524a74a1335354f2dbfd36b2"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2086935 [wpt PR 64132] - Close elements left open in WPTs and remove wrong closing tags, a=testonly\n\nAutomatic update from web-platform-tests\nClose elements left open in WPTs and remove wrong closing tags\n\nSVG shapes are not void elements, so \u003crect\u003e, \u003cpath\u003e and \u003canimate\u003e\nwritten without an end tag stay open until \u003c/svg\u003e closes them, which the\nparser reports as a misplaced end tag. Self-close them instead. Likewise\nclose \u003cvideo\u003e explicitly rather than leaving it to the enclosing \u003c/div\u003e,\ndrop the \u003c/command\u003e that the parser discards because \u003ccommand\u003e is void,\nand remove a leftover \u003c/script\u003e inside an inline script body.\n\nBug: 542686202\nChange-Id: I1d95a0f9a95f77bc97dda8f00c672e5a8088e696\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8220910\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nReviewed-by: Brandon Walderman \u003cbrwalder@microsoft.com\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1726228}\n\n--\n\nwpt-commits: d71a6505c5c5885488de71078fa67cc8f191d80b\nwpt-pr: 64132\n", "files": ["testing/web-platform/tests/accessibility/svg-mouse-listener.html", "testing/web-platform/tests/content-security-policy/form-action/form-action-src-get-blocked.sub.html", "testing/web-platform/tests/html/dom/documents/dom-tree-accessors/document.getElementsByName/document.getElementsByName-newelements.html", "testing/web-platform/tests/html/semantics/embedded-content/the-video-element/video-transparent-controls-ref.html", "testing/web-platform/tests/html/semantics/embedded-content/the-video-element/video-transparent-controls.html", "testing/web-platform/tests/html/semantics/interactive-elements/the-dialog-element/inert-svg-hittest.html", "testing/web-platform/tests/inert/inert-svg-hittest.html", "testing/web-platform/tests/svg/animations/restart-never-and-begin-click.html", "testing/web-platform/tests/svg/painting/animations/stroke-dasharray-composition.html", "testing/web-platform/tests/svg/painting/subpixel-clip-path-transform.html", "testing/web-platform/tests/svg/painting/text-clip-path-transform.html", "testing/web-platform/tests/svg/painting/text-mask-transform.html", "testing/web-platform/tests/svg/render/reftests/nested-svg-overflow-clip.html", "testing/web-platform/tests/svg/render/reftests/overflow-clip.html"], "git_node": "d86976e32ab040de1e5d54365ac798b02b368bcb", "git_parents": ["203eb732299c239495d6175c81dce4af24aa29de"], "node": "9a30d33f724051f2d8bd6d1d8e136730be9fbe7b", "parents": ["5df27c4bbed0e91643ad4ff0d5ef52f920c96437"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086935 [wpt PR 64132] - Update wpt metadata, a=testonly\n\nwpt-pr: 64132\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/interactive-elements/the-dialog-element/dialog-audio-video-crash.html.ini"], "git_node": "d5a99b2cbd5bab47c6cfc2639b5c2c4d08b797d5", "git_parents": ["d86976e32ab040de1e5d54365ac798b02b368bcb"], "node": "41a5a9668f106ba2b8b228ceb3d15db58416c20b", "parents": ["9a30d33f724051f2d8bd6d1d8e136730be9fbe7b"], "tags": []}, {"author": "Hoch Hochkeppel \u003cmhochk@microsoft.com\u003e", "branch": "default", "desc": "Bug 2086937 [wpt PR 64135] - Reduce flakiness for font cache bypass WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nReduce flakiness for font cache bypass WPTs\n\nAt WPT import time, these tests were found to be flaky in Firefox due\nto a race where `document.fonts` wasn't populated by the time it was\nbeing queried. This change updates the tests to wait for the document to\nload before making this query.\n\nVerified locally that this results in consistent test results for both\nChromium and Firefox.\n\nBug: 576970892\nChange-Id: Icbecda63f4af48be3de00b446fb819dc3443a429\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8638440\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCommit-Queue: Hoch Hochkeppel \u003cmhochk@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1726239}\n\n--\n\nwpt-commits: 48c7a480a6fa200b64b4b9e4875887fcfa6b7e6f\nwpt-pr: 64135\n", "files": ["testing/web-platform/tests/content-security-policy/font-src/shared-stylesheet-font-cache-bypass.html", "testing/web-platform/tests/content-security-policy/font-src/support/shared-stylesheet-font-cache-bypass-permissive.html", "testing/web-platform/tests/content-security-policy/font-src/support/shared-stylesheet-font-cache-bypass-strict.html"], "git_node": "d391373a84c0e7f00ba985e7caa3879431c47ddf", "git_parents": ["d5a99b2cbd5bab47c6cfc2639b5c2c4d08b797d5"], "node": "75e1538a12c1b1123ce36b0868052724765edf93", "parents": ["41a5a9668f106ba2b8b228ceb3d15db58416c20b"], "tags": []}, {"author": "Sam Attard \u003csamuel.r.attard@gmail.com\u003e", "branch": "default", "desc": "Bug 2086940 [wpt PR 64136] - [DBSC] Treat 429 on registration and refresh as transient, a=testonly\n\nAutomatic update from web-platform-tests\n[DBSC] Treat 429 on registration and refresh as transient\n\nA 429 from the registration or refresh endpoint was handled as a\npersistent HTTP error, which deletes the session on refresh. The\nspec keeps the session for a 429, just like a network error or a 407.\n\nTreat 429 like a 5xx instead: keep the session and count the failure\ntoward the refresh backoff.\n\nBug: None\nChange-Id: I4db4163bb5791628fddc2ab81c96eb9c6c3f2251\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8613310\nReviewed-by: Alex Ilin \u003calexilin@chromium.org\u003e\nCommit-Queue: Samuel Attard \u003csamuel.r.attard@gmail.com\u003e\nCr-Commit-Position: refs/heads/main@{#1726240}\n\n--\n\nwpt-commits: 319a1ab42b15cc07555005ed9e8bf0e3af363a15\nwpt-pr: 64136\n", "files": ["testing/web-platform/tests/device-bound-session-credentials/debug-header.https.html", "testing/web-platform/tests/device-bound-session-credentials/refresh_session.py", "testing/web-platform/tests/device-bound-session-credentials/session_manager.py"], "git_node": "9b17d53504232d2c1141e45c5222c16351b62d1a", "git_parents": ["d391373a84c0e7f00ba985e7caa3879431c47ddf"], "node": "08f73d2ffa66e0ca931063899cc422fcc0fa9e6d", "parents": ["75e1538a12c1b1123ce36b0868052724765edf93"], "tags": []}, {"author": "Javier Contreras Tenorio \u003cjaviercon@microsoft.com\u003e", "branch": "default", "desc": "Bug 2086942 [wpt PR 64139] - [gap-decorations] Fix flex main gap added twice for overflowing content, a=testonly\n\nAutomatic update from web-platform-tests\n[gap-decorations] Fix flex main gap added twice for overflowing content\n\nWhen a row flex container with gap decorations fragments, a row can end\nin one fragmentainer while one of its items has overflowing content that\ncontinues into the next one.\n\nBefore this CL, the resumed item overflow still went through the usual\nflow for gap decorations, through\n`FlexGapAccumulator::BuildGapsForCurrentItem()`, and we added a\ncorresponding `MainGap` for it even though the previous fragment had\nalready recorded it. At paint time, the stitched index of that duplicate\ngap was equal to the total row gap count, and the CHECK in\n`GapGeometry::DecorationValueAssignmentForGap()` failed.\n\nWith this CL, each `FlexLine` records in `has_inflow_continuation`\nwhether one of its items broke with in-flow content at the end of a\nfragmentainer. In the next fragmentainer, an item that resumes only for\noverflow skips gap building when its row has no in-flow continuation.\n\nFixed: 574825053\nChange-Id: I86b98b82a78f0c78ca07972c7bd92ca0c2ac0f2c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8642317\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCommit-Queue: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1726259}\n\n--\n\nwpt-commits: ef14bf54a13a3508f32e53b0212f578c38cb702e\nwpt-pr: 64139\n", "files": ["testing/web-platform/tests/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-024-crash.html"], "git_node": "4597cbf8a96aa0fea81a9aea822a53bbbb5bd9e0", "git_parents": ["9b17d53504232d2c1141e45c5222c16351b62d1a"], "node": "88e219779d2429b4e57ed128917617e1fe65f39f", "parents": ["08f73d2ffa66e0ca931063899cc422fcc0fa9e6d"], "tags": []}, {"author": "Yoav Weiss \u003cyoavweiss@chromium.org\u003e", "branch": "default", "desc": "Bug 2086951 [wpt PR 64126] - Speculative load measurement - move to dictionaries, a=testonly\n\nAutomatic update from web-platform-tests\nSpeculative load measurement - move to dictionaries\n\nThe current implementation of `performance.getSpeculations()` returns an\nobject with no toJSON implementation. That means it doesn\u2019t serialize\nits data.\n\nMoving the return values to dictionaries seems more idiomatic\nfrom a WebIDL perspective, and enables serialization with less code.\n\nChange-Id: I8f1ff1eecc6e1c48548a5ec3d0e9bad75b5e051d\nBug: 575677380\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8617337\nReviewed-by: Barry Pollard \u003cbarrypollard@chromium.org\u003e\nCommit-Queue: Yoav Weiss (@Shopify) \u003cyoavweiss@chromium.org\u003e\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1726277}\n\n--\n\nwpt-commits: e2f361f390bc0d9c46c3f9f34c2f42fec250af42\nwpt-pr: 64126\n", "files": ["testing/web-platform/tests/loading/early-hints/resources/speculation-measurement-early-hints-preconnect.html", "testing/web-platform/tests/speculation-rules/speculation-measurement/performance-speculations-navigations.tentative.https.html", "testing/web-platform/tests/speculation-rules/speculation-measurement/performance-speculations-preconnect.tentative.html", "testing/web-platform/tests/speculation-rules/speculation-measurement/performance-speculations-serialization.tentative.https.html", "testing/web-platform/tests/speculation-rules/speculation-measurement/performance-speculations-unused-preload.tentative.html"], "git_node": "cdb0aba881ac7d31781561850ebdaca2a96731b1", "git_parents": ["4597cbf8a96aa0fea81a9aea822a53bbbb5bd9e0"], "node": "22a9ed01936d138d5cc2448cd2f8ea6669109d22", "parents": ["88e219779d2429b4e57ed128917617e1fe65f39f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086951 [wpt PR 64126] - Update wpt metadata, a=testonly\n\nwpt-pr: 64126\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/speculation-rules/speculation-measurement/performance-speculations-preconnect.tentative.html.ini", "testing/web-platform/meta/speculation-rules/speculation-measurement/performance-speculations-serialization.tentative.https.html.ini", "testing/web-platform/meta/speculation-rules/speculation-measurement/performance-speculations-unused-preload.tentative.html.ini"], "git_node": "92f3005f1dd09077a2ee495ed9198a3d8dce925e", "git_parents": ["cdb0aba881ac7d31781561850ebdaca2a96731b1"], "node": "de6b7e4d9cd712d04b0f03662bf8a20c0a6efbaf", "parents": ["22a9ed01936d138d5cc2448cd2f8ea6669109d22"], "tags": []}, {"author": "Celeste Pan \u003ccelestepan@microsoft.com\u003e", "branch": "default", "desc": "Bug 2086961 [wpt PR 64137] - [Masonry] Add tests for reading-flow across tracks, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Add tests for reading-flow across tracks\n\nThis creates tests for reading-flow across tracks, using the suggested\n\"reading row\" implementation from the CSSWG issue [1] discussing reading\nflow across tracks. This covers dense-packing, track-reverse, fill-\nreverse, and writing direction impact on reading-flow across tracks.\n\nIn this change, we're counting an item as part of the reading row if at\nleast 2/3 of an item fit into the reading row's cutoff.\n\n[1]\nhttps://github.com/w3c/csswg-drafts/issues/5675#issuecomment-4848519759\n\nBug: 343257585\nChange-Id: Ia69e48276a64dfd74fdf647c58cabcc6a8cfab2f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8634426\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCommit-Queue: Celeste Pan \u003ccelestepan@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1726297}\n\n--\n\nwpt-commits: 422400b8d016046856a7533bfbdd96276f649005\nwpt-pr: 64137\n", "files": ["testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-014.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-015.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-016.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-017.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-018.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-019.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-020.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-021.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-005.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-006.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-007.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-008.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-009.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-010.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-011.html"], "git_node": "8cdd343f91bcbb242cb94a1aab54fee32d9903ea", "git_parents": ["92f3005f1dd09077a2ee495ed9198a3d8dce925e"], "node": "c1078b1d9a2e5253ad21bffc32d1c6f14ac9f05e", "parents": ["de6b7e4d9cd712d04b0f03662bf8a20c0a6efbaf"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086961 [wpt PR 64137] - Update wpt metadata, a=testonly\n\nwpt-pr: 64137\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-014.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-015.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-016.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-017.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-018.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-019.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-020.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-021.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-005.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-006.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-007.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-008.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-009.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-010.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/grid-lanes-row-reading-flow-011.html.ini"], "git_node": "847abbe291046e5a35bea40f794234f2bf7bcf72", "git_parents": ["8cdd343f91bcbb242cb94a1aab54fee32d9903ea"], "node": "080718fec247ce2c39eab341a1cd96012788e725", "parents": ["c1078b1d9a2e5253ad21bffc32d1c6f14ac9f05e"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2086963 [wpt PR 64144] - Apply contoured border outsets after pixel snapping, a=testonly\n\nAutomatic update from web-platform-tests\nApply contoured border outsets after pixel snapping\n\nPixelSnappedContouredBorderWithOutsets expanded the border rect in\nLayoutUnit space, so a huge outline-offset saturated the size and\nfolded the far edge back into the viewport. Snap the border rect first,\nthen apply integer gfx::Outsets to avoid LayoutUnit size saturation.\nRound fractional outsets at call sites and remove the obsolete\nzero-size snap helper. With zero outsets, the result now matches\nPixelSnappedContouredBorder.\n\nBug: 41269582\nChange-Id: I48e018fb35a6837afa248942700b557cf5a6f065\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8608187\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nReviewed-by: Xianzhu Wang \u003cwangxianzhu@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1726320}\n\n--\n\nwpt-commits: 530a8b92de01caf4f4a86b01cf0f00aa5d9112b4\nwpt-pr: 64144\n", "files": ["testing/web-platform/tests/css/css-painting/outline-huge-offset-not-clipped-ref.html", "testing/web-platform/tests/css/css-painting/outline-huge-offset-not-clipped.html"], "git_node": "0929ba70ce2c293826ed39609dcf5f6892eac8f5", "git_parents": ["847abbe291046e5a35bea40f794234f2bf7bcf72"], "node": "bb58b5c79e8281ee11f77c5b55cc032ba29d5cfb", "parents": ["080718fec247ce2c39eab341a1cd96012788e725"], "tags": []}, {"author": "Stephen Chenney \u003cschenney@chromium.org\u003e", "branch": "default", "desc": "Bug 2086971 [wpt PR 64142] - [HiC] Fix CSS object-fit for nested canvas, a=testonly\n\nAutomatic update from web-platform-tests\n[HiC] Fix CSS object-fit for nested canvas\n\nWe were not using the ReplacedContentRect for positioning and\nsizing the dest rect when painting a nested canvas. Fix it.\n\nFixed: 570832069\nChange-Id: I15044a6b2971a30f80b066efae46569b804ee59b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8644369\nAuto-Submit: Stephen Chenney \u003cschenney@chromium.org\u003e\nCommit-Queue: Stefan Zager \u003cszager@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1726328}\n\n--\n\nwpt-commits: 55d460664bb4d0095485cc726448ce82324beacb\nwpt-pr: 64142\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/css-object-fit-nested-canvas-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/css-object-fit-nested-canvas.tentative.html"], "git_node": "1c157463e97fa87ca99bd7f1a8abc4be9d1d0961", "git_parents": ["0929ba70ce2c293826ed39609dcf5f6892eac8f5"], "node": "2abef822a24758207d755ef75936d737711d1fe0", "parents": ["bb58b5c79e8281ee11f77c5b55cc032ba29d5cfb"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2086977 [wpt PR 64141] - [html-in-canvas] Add test that content is not culled, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Add test that content is not culled\n\nThis patch adds a test that drawable content is not culled.\n\nChange-Id: I10dd2881b88f7a6a1ab37d421e1298a84877cb06\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8636411\nAuto-Submit: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Stefan Zager \u003cszager@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1726330}\n\n--\n\nwpt-commits: 7bec10997c5a8597eee80f6bd6037873aecbf3e5\nwpt-pr: 64141\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/content-not-culled-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/content-not-culled.tentative.html"], "git_node": "5ce92097dcc0dc5b2470fe504f0dd57802104484", "git_parents": ["1c157463e97fa87ca99bd7f1a8abc4be9d1d0961"], "node": "3800e0185f75696cd175dd1f1fa0b15f1f74625d", "parents": ["2abef822a24758207d755ef75936d737711d1fe0"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2086986 [wpt PR 64124] - Render ::backdrop for content-visibility:hidden elements, a=testonly\n\nAutomatic update from web-platform-tests\nRender ::backdrop for content-visibility:hidden elements\n\nIf we render a content-visibility:hidden element in the top layer, we\nshould not remove the ::backdrop.\n\nNot explicitly stated in the spec, but this aligns with both Firefox\nand Safari.\n\nThis fixes a crash issue where a ::backdrop would be detached after\nbeing laid out as part of interleaved OOF recalc for an anchored top\nlayer element.\n\nBug: 574251151\nChange-Id: I4f0e9ba66260e1476147c4209b6de79ceb1279f7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8629849\nReviewed-by: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1726337}\n\n--\n\nwpt-commits: 7fa7dc49f9040f66f9673b5e153728d546dc0ba9\nwpt-pr: 64124\n", "files": ["testing/web-platform/tests/css/css-contain/content-visibility/content-visibility-hidden-backdrop.html"], "git_node": "20fa9972bfb60d36ecf01f17bb302ada49f05b36", "git_parents": ["5ce92097dcc0dc5b2470fe504f0dd57802104484"], "node": "dec60b499aabafaa1a31893d34fbfe90e7af1e99", "parents": ["3800e0185f75696cd175dd1f1fa0b15f1f74625d"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2086991 [wpt PR 64146] - [html-in-canvas] Disallow canvas-external SVG filters, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Disallow canvas-external SVG filters\n\nThis patch prevents elements in a canvas subtree from referencing SVG\n`\u003cfilter\u003e` elements outside the canvas subtree, similar to\nhttps://crrev.com/c/8455562. Previously,\n`FilterEffectBuilder::BuildReferenceFilter` did not check\n`IsInCanvasSubtree()` on the target `SVGFilterElement`, allowing CSS\n`filter`, CSS `backdrop-filter`, and SVG `filter` references to leak\nexternal state such as `:visited` styles.\n\n`FilterEffectBuilder` now accepts `is_in_canvas_subtree` from\n`PaintLayer` and `SVGElementResourceClient`, ignoring external\n`\u003cfilter\u003e` elements when set. `SVGElement` and `SVGFilterElement` also\ninvalidate cached filter state in `DidChangeIsInCanvasSubtree`.\nExisting `drawElementImage` filter tests that placed allowed `\u003cfilter\u003e`\nelements outside `\u003ccanvas\u003e` are updated to define them inside\n`\u003ccanvas\u003e`.\n\nFixed: 576312229\nChange-Id: I5174e5ac783667d18535cee8fd30ca8dbc596849\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8615847\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stephen Chenney \u003cschenney@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1726439}\n\n--\n\nwpt-commits: 98fef2dabee7534754649c5855361de8e99aba16\nwpt-pr: 64146\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/css-backdrop-filter-image.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/css-filter-image.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/css-filter-reference-on-div.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/backdrop-filter-png-images-ignored.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/filtered-div-drawable-added-ignored.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/filtered-div-multi-filters-ignored.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/filtered-div-ref-svg-feimage-ignored.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/filtered-div-ref-svg-feimage-svg-ignored.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/filtered-div-ref-svg-mixed-ignored.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/filtered-outside-subtree-ignored.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/svg/svg-mask-filter.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/svg/svg-mask-nested-filter.tentative.https.sub.html"], "git_node": "a1f4d2f56db4e3f38ee1026e446c5d9587cb7f07", "git_parents": ["20fa9972bfb60d36ecf01f17bb302ada49f05b36"], "node": "b062978834ffca05fc8e5eb28557b9f9a2a79aee", "parents": ["dec60b499aabafaa1a31893d34fbfe90e7af1e99"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086991 [wpt PR 64146] - Update wpt metadata, a=testonly\n\nwpt-pr: 64146\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/filtered-outside-subtree-ignored.tentative.html.ini"], "git_node": "3e3fddee75109b83ab801f5a7a86eadfafb9bda7", "git_parents": ["a1f4d2f56db4e3f38ee1026e446c5d9587cb7f07"], "node": "544c07bd48d4c4760ca6b2e0d53022a4e1a24b98", "parents": ["b062978834ffca05fc8e5eb28557b9f9a2a79aee"], "tags": []}, {"author": "Romain Menke \u003c11521496+romainmenke@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087011 [wpt PR 64149] - [css-color-5] test color-mix behavior of negative percentages in calc, a=testonly\n\nAutomatic update from web-platform-tests\n[css-color-5] test color-mix behavior of negative percentages in calc (#64149)\n--\n\nwpt-commits: 5d7f3a37547102c5b848407c934c71509773c89b\nwpt-pr: 64149\n", "files": ["testing/web-platform/tests/css/css-color/parsing/color-computed-color-mix-function.html"], "git_node": "e1f3902faecb033319ba8285f542b6ecd0bd54e5", "git_parents": ["3e3fddee75109b83ab801f5a7a86eadfafb9bda7"], "node": "2fde2c454cb27bfc976d4e2cb2a63695044b25bf", "parents": ["544c07bd48d4c4760ca6b2e0d53022a4e1a24b98"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087011 [wpt PR 64149] - Update wpt metadata, a=testonly\n\nwpt-pr: 64149\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-color/parsing/color-computed-color-mix-function.html.ini"], "git_node": "2603774ff7c8e25a8b7b4252de9fcf1f6ad9e35d", "git_parents": ["e1f3902faecb033319ba8285f542b6ecd0bd54e5"], "node": "043457dfc9f89bd951a039ed89f5aae670a42df1", "parents": ["2fde2c454cb27bfc976d4e2cb2a63695044b25bf"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2087636 [wpt PR 64148] - Clear focus when closing a dialog with no previously focused element, a=testonly\n\nAutomatic update from web-platform-tests\nClear focus when closing a dialog with no previously focused element\n\nClosing a dialog restores focus to the element that was focused when it\nopened, but when there was none, focus stayed on the node inside the\nnow-closed dialog, where it is no longer focusable: document key events\nstopped firing until the page was refocused from the browser UI. Clear\nthe focused element in that case instead.\n\nBug: 41284677\nChange-Id: I17bdb61ab57195878a1751f8cdac3b0f90986f0b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8644932\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nCr-Commit-Position: refs/heads/main@{#1726476}\n\n--\n\nwpt-commits: fd8f390197e119689114a49aa8e29fa2d94bbbcd\nwpt-pr: 64148\n", "files": ["testing/web-platform/tests/html/semantics/interactive-elements/the-dialog-element/dialog-close-focus-no-previous.html"], "git_node": "8d09904d17bbca5ae97772c424cd8689e899dff0", "git_parents": ["2603774ff7c8e25a8b7b4252de9fcf1f6ad9e35d"], "node": "5d4a83f7e12000f1751c98ed5cf7956e4fa85e88", "parents": ["043457dfc9f89bd951a039ed89f5aae670a42df1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087636 [wpt PR 64148] - Update wpt metadata, a=testonly\n\nwpt-pr: 64148\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/interactive-elements/the-dialog-element/dialog-close-focus-no-previous.html.ini"], "git_node": "62e00f7da86e8093590847474c8df16aac029ac2", "git_parents": ["8d09904d17bbca5ae97772c424cd8689e899dff0"], "node": "8bae6c0540c12e2f2cd4aa50f7dbb2b4cc3bf77d", "parents": ["5d4a83f7e12000f1751c98ed5cf7956e4fa85e88"], "tags": []}, {"author": "Romain Menke \u003c11521496+romainmenke@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087045 [wpt PR 64150] - [css-color-5] add tests for implicit alpha in relative color where origin alpha is `none`, a=testonly\n\nAutomatic update from web-platform-tests\n[css-color-5] add tests for implicit alpha in relative color where alpha is none (#64150)\n--\n\nwpt-commits: f317ab9ac4481629fff609650a78dc15b77c609b\nwpt-pr: 64150\n", "files": ["testing/web-platform/tests/css/css-color/parsing/color-computed-relative-color.html"], "git_node": "856b6c32056477d80f33fc482605a1d6258e1698", "git_parents": ["62e00f7da86e8093590847474c8df16aac029ac2"], "node": "ba54320366940cabf6c3f500b7175e86547883ec", "parents": ["8bae6c0540c12e2f2cd4aa50f7dbb2b4cc3bf77d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087045 [wpt PR 64150] - Update wpt metadata, a=testonly\n\nwpt-pr: 64150\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-color/parsing/color-computed-relative-color.html.ini"], "git_node": "e2eba789fbdaa5128f78ceda5590c092b1b294d2", "git_parents": ["856b6c32056477d80f33fc482605a1d6258e1698"], "node": "8c9fa5095b7fe4d8aa9888717671822807f4cbdf", "parents": ["ba54320366940cabf6c3f500b7175e86547883ec"], "tags": []}, {"author": "Romain Menke \u003c11521496+romainmenke@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087055 [wpt PR 64151] - [css-color-5] add tests for mixing hue where all hue values are missing, a=testonly\n\nAutomatic update from web-platform-tests\n[css-color-5] add tests for mixing hue where all hue values are missing (#64151)\n--\n\nwpt-commits: 10f6646082a91773c76fa83fba606f7267379589\nwpt-pr: 64151\n", "files": ["testing/web-platform/tests/css/css-color/parsing/color-computed-color-mix-function.html"], "git_node": "1d8a7a7f6df5c39c6a3acf067757773ef16b733a", "git_parents": ["e2eba789fbdaa5128f78ceda5590c092b1b294d2"], "node": "98f43788834c43afd1d0fb715749a2856201a531", "parents": ["8c9fa5095b7fe4d8aa9888717671822807f4cbdf"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087055 [wpt PR 64151] - Update wpt metadata, a=testonly\n\nwpt-pr: 64151\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-color/parsing/color-computed-color-mix-function.html.ini"], "git_node": "7e32258f8f18ee24f02b7c46f5ef6780b25a1570", "git_parents": ["1d8a7a7f6df5c39c6a3acf067757773ef16b733a"], "node": "7946dbfda99a971308b1ccb52a8d482b2c8a5696", "parents": ["98f43788834c43afd1d0fb715749a2856201a531"], "tags": []}, {"author": "Jelle Raaijmakers \u003cjelle@gmta.nl\u003e", "branch": "default", "desc": "Bug 2087637 [wpt PR 64156] - [wptrunner] Honor required restarts before switching executors, a=testonly\n\nAutomatic update from web-platform-tests\n[wptrunner] Honor required restarts before switching executors\n\nAn executor switch on a test-type change can bypass a restart requested\nafter a crash or harness error. Reusing the unresponsive browser may\nthen hang executor setup.\n\nSkip executor reuse when a restart is already required. Add unit tests\nfor CRASH, EXTERNAL-TIMEOUT and INTERNAL-ERROR, plus successful executor\nreuse.\n\n--\n\nwpt-commits: 2fabe206773f894d78fbe814f1c4ef6030adbe01\nwpt-pr: 64156\n", "files": ["testing/web-platform/tests/tools/wptrunner/wptrunner/testrunner.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/test_testrunner.py"], "git_node": "91aa00ce5edb6074b2ceff64e759805c10077b17", "git_parents": ["7e32258f8f18ee24f02b7c46f5ef6780b25a1570"], "node": "1bda1fe90f8918af061e6dcb277beae1c1203ce3", "parents": ["7946dbfda99a971308b1ccb52a8d482b2c8a5696"], "tags": []}, {"author": "sideshowbarker \u003cmike@w3.org\u003e", "branch": "default", "desc": "Bug 2090599 [wpt PR 64844] - Check screen-space transform changes for stale forward dependencies., a=testonly\n\nAutomatic update from web-platform-tests\nDrop Safari FAIL expectations for webtransport-h3 infrastructure tests\n\nProblem: The \u201cinfrastructure/ tests: macOS\u201d job failed on every PR\u00a0\u2014\nwith 4 unexpected passes, from the WebTransport subtests\ninfrastructure/server/webtransport-h3.https.sub.any.js.\n\nCause: aa1ade6680 marked those subtests FAIL for Safari, because a\nregression in STP 251 had left WebTransport undefined. But WebKit fixed\nthat in 320163@main, and current STP releases pass the subtests again.\nHowever, the metadata still expected them to fail. Stale.\n\nFix: Drop the four Safari conditions, so it\u2019s expected to pass again.\n\nSee https://bugs.webkit.org/show_bug.cgi?id=322745\n\n--\n\nwpt-commits: 68d964a5f292bc4b2c2eba2f21e2b916190b6ad2\nwpt-pr: 64844\n", "files": ["testing/web-platform/tests/infrastructure/metadata/infrastructure/server/webtransport-h3.https.sub.any.js.ini"], "git_node": "b773015ef34a3d36b1abb04ff7de732ee413a26d", "git_parents": ["91aa00ce5edb6074b2ceff64e759805c10077b17"], "node": "171c1687e74f8bc88b4cf3eb640be78d1101c75f", "parents": ["1bda1fe90f8918af061e6dcb277beae1c1203ce3"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090599 [wpt PR 64844] - Update wpt metadata, a=testonly\n\nwpt-pr: 64844\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-anchor-position/transform-024.html.ini"], "git_node": "871abe80039bef189a354b994c09ee7b7f6b9f85", "git_parents": ["b773015ef34a3d36b1abb04ff7de732ee413a26d"], "node": "4d28be7b46a0a94073dd13fbb797072cdc8be024", "parents": ["171c1687e74f8bc88b4cf3eb640be78d1101c75f"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087065 [wpt PR 64147] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324686, a=testonly\n\nAutomatic update from web-platform-tests\n[Navigation API] Main-frame navigation.back()/traverseTo() lands on the wrong joint session history entry when a subframe navigated (#64147)\n\nWhen a subframe does a same-document navigation while the main frame stays\nput, the joint (top-level) history item is cloned, so the main frame's\nhistory item appears in more than one back/forward list item. Traversing the\nmain frame by key (navigation.back(), navigation.forward(), traverseTo())\nmust land on the nearest such joint entry in the direction of travel.\n\nScheduledHistoryNavigationByKey::findBackForwardItemByKey short-circuited for\nthe main frame with `if (localFrame.isMainFrame()) return historyItem;`,\nreturning the entry's associated history item directly instead of resolving\nthe nearest matching back/forward item. As a result a main-frame step-back\nlanded on the farthest matching joint entry, resetting the subframe to an\nearlier state and leaving a stale, undisposed forward entry behind. Subframes\nalready performed this nearest-item search; this applies the same search to\nthe main frame, matching the top-level item's itemSequenceNumber.\n\nChrome and Firefox land on the nearest entry; the new test failed on WebKit\nbefore this change and passes after.\n\nfindBackForwardItemByKey() calls BackForwardList::allItems(), which is a\nsynchronous BackForwardAllItems IPC in WebKit2. isSameDocumentNavigation() also\ncalled it, and is reached from NavigationScheduler::locationChangePending(),\nwhich HTMLDocumentParser::pumpTokenizerLoop() checks before every token, so the\nmain frame would now make that IPC once per token. isSameDocumentNavigation()\nonly compares URLs, so make it answer from the entry's associated history item,\nas is already done with UseUIProcessForBackForwardItemLoading (324250@main).\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324686\nWebKit-Canonical-Link: https://commits.webkit.org/324589@main\n--\n\nwpt-commits: 1ec6aacb4e9194da7a7ace5fd059816e41bd7cb4\nwpt-pr: 64147\n", "files": ["testing/web-platform/tests/navigation-api/navigation-methods/back-main-frame-nearest-after-subframe-navigation.html"], "git_node": "57a3be98a53bc71f4b78b8f327e90acfe0da777f", "git_parents": ["871abe80039bef189a354b994c09ee7b7f6b9f85"], "node": "ad534b0d911309308e39880f0ce2e1b7bfd4dacb", "parents": ["4d28be7b46a0a94073dd13fbb797072cdc8be024"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2087068 [wpt PR 64158] - layout: Avoid negative size when stretching element that avoids floats, a=testonly\n\nAutomatic update from web-platform-tests\nlayout: Avoid negative size when stretching element that avoids floats\n\nSigned-off-by: Oriol Brufau \u003cobrufau@igalia.com\u003e\n\n--\n\nwpt-commits: dc1750a87e8ec78d40095da0f57fd7a9787ba510\nwpt-pr: 64158\n", "files": ["testing/web-platform/tests/css/css-sizing/stretch/stretch-with-huge-padding-avoiding-float.html"], "git_node": "fa381acfffc1b82257cb0d252506cbf3385655ee", "git_parents": ["57a3be98a53bc71f4b78b8f327e90acfe0da777f"], "node": "e5ea24bb0043737b89c92c895a56589acc934e0e", "parents": ["ad534b0d911309308e39880f0ce2e1b7bfd4dacb"], "tags": []}, {"author": "Joey Arhar \u003cjarhar@chromium.org\u003e", "branch": "default", "desc": "Bug 2087070 [wpt PR 64157] - Add long timeout to selection-readonly-keyboard.tentative.html, a=testonly\n\nAutomatic update from web-platform-tests\nAdd long timeout to selection-readonly-keyboard.tentative.html\n\nselection-readonly-keyboard.tentative.html performs 18 sequential\nWebDriver action round-trips across 5 subtests, which occasionally\nexceeds the default 10s WPT timeout during the final subtest on Firefox\nin WPT CI. Add \u003cmeta name=timeout content=long\u003e to prevent the test from\ntiming out.\n\nFixed: 576971087\nChange-Id: Ic494784a9053faa093c53dbd148fcefee9ee5fd8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8642545\nAuto-Submit: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: David Grogan \u003cdgrogan@chromium.org\u003e\nReviewed-by: David Grogan \u003cdgrogan@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1726545}\n\n--\n\nwpt-commits: fcc66ff4e3ccb2f68a12f53256507e2fe7fe11ce\nwpt-pr: 64157\n", "files": ["testing/web-platform/tests/html/semantics/forms/textfieldselection/selection-readonly-keyboard.tentative.html"], "git_node": "4d0e11bee3870a5cac9e26908099264c36e7b3a2", "git_parents": ["fa381acfffc1b82257cb0d252506cbf3385655ee"], "node": "ae17f61d5f69c7c4b89478074ec60dd5134b857c", "parents": ["e5ea24bb0043737b89c92c895a56589acc934e0e"], "tags": []}, {"author": "Tim van der Lippe \u003ctvanderlippe@gmail.com\u003e", "branch": "default", "desc": "Bug 2076855 [wpt PR 63111] - layout: Use `:root` for canvas text color, a=testonly\n\nAutomatic update from web-platform-tests\nAdd test\n\nSigned-off-by: Tim van der Lippe \u003ctvanderlippe@gmail.com\u003e\n\n--\n\nwpt-commits: bdac414a593ca5e1f9dc4fae53dc9a904e8ec27e\nwpt-pr: 63111\n", "files": ["testing/web-platform/tests/css/css-color-adjust/rendering/dark-color-scheme/color-scheme-should-apply-to-root-ref.html", "testing/web-platform/tests/css/css-color-adjust/rendering/dark-color-scheme/color-scheme-should-apply-to-root.html"], "git_node": "17c090d4ea23190f797ea0e37f524e3ea3f0d55e", "git_parents": ["4d0e11bee3870a5cac9e26908099264c36e7b3a2"], "node": "9b262a5ea8fd6986e703b9b05c170f08f9d1648e", "parents": ["ae17f61d5f69c7c4b89478074ec60dd5134b857c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076855 [wpt PR 63111] - Update wpt metadata, a=testonly\n\nwpt-pr: 63111\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-color-adjust/rendering/dark-color-scheme/color-scheme-link-crash.html.ini"], "git_node": "42080bbf3bb21bd9e1084e02e73a4cf52c442026", "git_parents": ["17c090d4ea23190f797ea0e37f524e3ea3f0d55e"], "node": "2dfab8bc6c22f14b75b8df1cb61b1b72ea76fc37", "parents": ["9b262a5ea8fd6986e703b9b05c170f08f9d1648e"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2087105 [wpt PR 64160] - layout: Floor stretch size by zero in block layout heuristics, a=testonly\n\nAutomatic update from web-platform-tests\nlayout: Floor stretch size by zero in block layout heuristics\n\nBlock layout uses some heuristics to guess whether margins are separated\nby clearance and then don't collapse. These heuristics weren't flooring\nthe stretch size in the inline axis by zero. Then the logic could end up\nthinking that the element had a negative width, and then resolve the\npercentages of its children incorrectly.\n\nSigned-off-by: Oriol Brufau \u003cobrufau@igalia.com\u003e\n\n--\n\nwpt-commits: 3d98b9b722ca38685e04dea4e5208d45ce7fd55f\nwpt-pr: 64160\n", "files": ["testing/web-platform/tests/css/css-sizing/float-clearance-with-margin-collapse-and-stretch-and-padding-percentage.html"], "git_node": "8b326d2394d65d77dad7bb7e51a3ebdd923824fd", "git_parents": ["42080bbf3bb21bd9e1084e02e73a4cf52c442026"], "node": "0f3b203f180bf567f32bd97780b071254e478ea3", "parents": ["2dfab8bc6c22f14b75b8df1cb61b1b72ea76fc37"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087105 [wpt PR 64160] - Update wpt metadata, a=testonly\n\nwpt-pr: 64160\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-sizing/float-clearance-with-margin-collapse-and-stretch-and-padding-percentage.html.ini"], "git_node": "c77b69e1be3059f643058a141c3c3922896afc16", "git_parents": ["8b326d2394d65d77dad7bb7e51a3ebdd923824fd"], "node": "3cb0f1a798204af81867b43fb440fb379542a31e", "parents": ["0f3b203f180bf567f32bd97780b071254e478ea3"], "tags": []}, {"author": "Maksim Sadym \u003c69349599+sadym-chromium@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2082641 [wpt PR 63715] - [testdriver] Add test_driver.bidi.emulation.set_scrollbar_type_override, a=testonly\n\nAutomatic update from web-platform-tests\n[testdriver] Add test_driver.bidi.emulation.set_scrollbar_type_override (#63715)\n\n* [testdriver] Add test_driver.bidi.emulation.set_scrollbar_type_override\n\n- Expose `test_driver.bidi.emulation.set_scrollbar_type_override`\n  matching WebDriver BiDi `emulation.setScrollbarTypeOverride`.\n- Allow WPT tests to emulate and override the scrollbar type\n  (`\"classic\"` or `\"overlay\"`) across browsing contexts.\n\nSpec: https://w3c.github.io/webdriver-bidi/#command-emulation-setScrollbarTypeOverride\n\n* [testdriver] Fix comments in set_scrollbar_type_override.https.html\n\n- Split combined comments so each `set_scrollbar_type_override` call has\n  its own comment matching the call immediately below it.\n\n* [testdriver] Simplify set_scrollbar_type_override.https.html\n\n- Test `overlay` scrollbar emulation and clearing (with `null` and `{}`)\n  so the test passes regardless of whether the platform default uses\n  classic or overlay scrollbars.\n--\n\nwpt-commits: c555a98a4d5f297486a7f25612145b60e07cdd5c\nwpt-pr: 63715\n", "files": ["testing/web-platform/tests/docs/writing-tests/testdriver.md", "testing/web-platform/tests/infrastructure/metadata/infrastructure/testdriver/bidi/emulation/set_scrollbar_type_override.https.html.ini", "testing/web-platform/tests/infrastructure/testdriver/bidi/emulation/set_scrollbar_type_override.https.html", "testing/web-platform/tests/resources/testdriver.js", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/asyncactions.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/executorwebdriver.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/protocol.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/testdriver-extra.js"], "git_node": "76991a975a2dd5cfab569dd90de08e4799aff2c3", "git_parents": ["c77b69e1be3059f643058a141c3c3922896afc16"], "node": "b7bcf88509b19b8339d8aa7f95ed273e26f12ca5", "parents": ["3cb0f1a798204af81867b43fb440fb379542a31e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082641 [wpt PR 63715] - Update wpt metadata, a=testonly\n\nwpt-pr: 63715\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/infrastructure/testdriver/bidi/emulation/set_scrollbar_type_override.https.html.ini"], "git_node": "ef7c057e86004b52b76d5f3318c6f8bf195cf804", "git_parents": ["76991a975a2dd5cfab569dd90de08e4799aff2c3"], "node": "20c0b39d919155c7a8c305293d1f6aeb293bcef6", "parents": ["b7bcf88509b19b8339d8aa7f95ed273e26f12ca5"], "tags": []}, {"author": "youennf \u003cyouennf@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087207 [wpt PR 64037] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328453, a=testonly\n\nAutomatic update from web-platform-tests\nRotated VideoFrames should be properly rendered (#64037)\n\nWe introduce VideoFrame::orientation and VideoFrame::rotatedSize as helpers.\nWe then use those when creating an image bitmap or when rendering to canvas 2d/webgl.\nWhen we need RGB data from video frames via getNativeImage, we apply the rotation in GPU process then convert to RGB as NativeImage does not handle rotation.\nWe add specific handling for MediaPlayerPrivateMediaStreamAVFObjC which, in WK1 still needs to handle rotation when painting a video frame.\n\nCovered by added WPT tests.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328453\n--\n\nwpt-commits: ed5926bf7261f8fcd1716f1831c9480958784a5a\nwpt-pr: 64037\n", "files": ["testing/web-platform/tests/webcodecs/videoFrame-orientation-drawImage.any.js", "testing/web-platform/tests/webcodecs/videoFrame-orientation-imageBitmap.any.js", "testing/web-platform/tests/webcodecs/videoFrame-orientation-utils.js", "testing/web-platform/tests/webcodecs/videoFrame-orientation-webgl-i420.window.js", "testing/web-platform/tests/webcodecs/videoFrame-orientation-webgl.window.js"], "git_node": "fc129bfdb1c1a41e65bd27c2c3f2f44d9d485b6b", "git_parents": ["ef7c057e86004b52b76d5f3318c6f8bf195cf804"], "node": "45e8ea6c89d308010271c4427c2b8d7efa88b999", "parents": ["20c0b39d919155c7a8c305293d1f6aeb293bcef6"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087207 [wpt PR 64037] - Update wpt metadata, a=testonly\n\nwpt-pr: 64037\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webcodecs/videoFrame-orientation-drawImage.any.js.ini", "testing/web-platform/meta/webcodecs/videoFrame-orientation-imageBitmap.any.js.ini", "testing/web-platform/meta/webcodecs/videoFrame-orientation-webgl-i420.window.js.ini", "testing/web-platform/meta/webcodecs/videoFrame-orientation-webgl.window.js.ini"], "git_node": "07bac8628efb2b104c9a85c8d7da43e03969c0bf", "git_parents": ["fc129bfdb1c1a41e65bd27c2c3f2f44d9d485b6b"], "node": "1dc0134086f3cdafaa77febed99589f6f9c9bd0e", "parents": ["45e8ea6c89d308010271c4427c2b8d7efa88b999"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2077016 [wpt PR 63144] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322683, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=322683 (#63144)\n--\n\nwpt-commits: 1b551baf204b1170a685fc1db854d868bfc40767\nwpt-pr: 63144\n", "files": ["testing/web-platform/tests/css/css-align/abspos/safe-align-self-htb.html", "testing/web-platform/tests/css/css-align/abspos/safe-align-self-vlr.html", "testing/web-p