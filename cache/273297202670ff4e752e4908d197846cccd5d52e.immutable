svg", "browser/components/aiwindow/ui/content/assets/new-chat.svg", "browser/components/aiwindow/ui/content/assets/set-default-onboarding.svg", "browser/components/aiwindow/ui/content/assets/smart-page-16.svg", "browser/components/aiwindow/ui/content/assets/smart-window-promo-default.svg", "browser/components/aiwindow/ui/content/assets/smart-window.svg", "browser/components/aiwindow/ui/content/assets/stop-generation.svg", "browser/components/aiwindow/ui/content/assets/warning.svg", "browser/components/aiwindow/ui/content/modules/AITabUtils.mjs", "browser/components/aiwindow/ui/content/modules/AgentCommands.mjs", "browser/components/aiwindow/ui/content/modules/ChatMarkdownParser.mjs", "browser/components/aiwindow/ui/content/modules/ClientErrorTelemetry.mjs", "browser/components/aiwindow/ui/content/modules/ModelIcons.mjs", "browser/components/aiwindow/ui/content/modules/SmartFormFillConstants.mjs", "browser/components/aiwindow/ui/content/modules/TrustedInternalURLs.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/A2UI.mjs", "browser/components/aiwindow/ui/modules/A2UI.sys.mjs", "browser/components/aiwindow/ui/modules/AITabUtils.mjs", "browser/components/aiwindow/ui/modules/AIWindowTabStatesManager.sys.mjs", "browser/components/aiwindow/ui/modules/AgentCommands.mjs", "browser/components/aiwindow/ui/modules/ChatMarkdownParser.mjs", "browser/components/aiwindow/ui/modules/ClientErrorTelemetry.mjs", "browser/components/aiwindow/ui/modules/ModelIcons.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillConstants.mjs", "browser/components/aiwindow/ui/modules/TrustedInternalURLs.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_telemetry.js", "browser/components/aiwindow/ui/test/xpcshell/test_A2UI.js", "browser/components/urlbar/UrlbarProviderAiChat.sys.mjs", "tools/@types/generated/tspaths.json"], "git_node": "261f9b47c5dd9f9edfc20e1e6704277a26d1d47d", "git_parents": ["669c20bc6ffa9e4d2a5a0e4fb2737093c49f02cf"], "node": "62fd08601d44834c8d4b7442a10117ec807518e4", "parents": ["573d5aa39e925a7f312d78c75f481681928b0771"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2094308 - Accelerate small 2D canvases whose first draw is an accelerated canvas. r=lsalzman\n\nDrawing an accelerated canvas into a canvas below\ngfx.canvas.accelerated.min-size (or below 16 pixels in either dimension) makes\nthe destination a software canvas in the content process. The source then has\nto be read back synchronously, and that readback waits for every command\nqueued in the GPU process before it. pdf.js downscales images in halving steps\nthrough temporary canvases, so its last steps hit this on every image.\n\nIf a canvas has no content yet and its first operation is drawImage from an\naccelerated 2D canvas, ignore the minimum size and make it accelerated too. The\nhint is passed to the GPU process in RecordedCanvasDrawTargetCreation, because\nDrawTargetWebgl::Create applies the same size checks there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343941\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "dom/canvas/DrawTargetWebgl.cpp", "dom/canvas/DrawTargetWebgl.h", "dom/canvas/test/mochitest.toml", "dom/canvas/test/test_canvas_drawImage_accelerated_small.html", "gfx/2d/DrawTargetRecording.cpp", "gfx/2d/DrawTargetRecording.h", "gfx/layers/PersistentBufferProvider.cpp", "gfx/layers/PersistentBufferProvider.h", "gfx/layers/RecordedCanvasEventImpl.h", "gfx/layers/client/TextureRecorded.cpp", "gfx/layers/client/TextureRecorded.h", "gfx/layers/ipc/CanvasChild.cpp", "gfx/layers/ipc/CanvasChild.h", "gfx/layers/ipc/CanvasTranslator.cpp", "gfx/layers/ipc/CanvasTranslator.h"], "git_node": "5ea13f1aeb4a07b59ea2c1b3357a93a450b90d0d", "git_parents": ["261f9b47c