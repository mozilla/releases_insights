221bb364d9c0676407f98114c59b94e2f194f467\nxh -\u003e 221bb364d9c0676407f98114c59b94e2f194f467\nzam -\u003e 221bb364d9c0676407f98114c59b94e2f194f467\nzh-CN -\u003e 221bb364d9c0676407f98114c59b94e2f194f467\nzh-TW -\u003e 221bb364d9c0676407f98114c59b94e2f194f467\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "b4662f12a41010a94986537bbcc9957266f2df28", "git_parents": ["80a5dd0f2007573d0a116e64d12efd7dcb3a3395"], "node": "65d83016ef889bb5ab48a746bf30fff61a172ca6", "parents": ["eef667001384cd82c81d9004eec9d58c546fe55d"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2089913 - Use a pin instead of a hold mark.\" for causing Docker image bustages.\n\nThis reverts commit 1208b78e731a206a0b19fef7e9a4bb4e7f579e6f.\n", "files": ["taskcluster/docker/debian-raw/Dockerfile"], "git_node": "8d869a9ac40f09f075729d56e4572c525bd75e09", "git_parents": ["b4662f12a41010a94986537bbcc9957266f2df28"], "node": "0c47809583f172dd11e8b850b3b8c1df1c830f5b", "parents": ["65d83016ef889bb5ab48a746bf30fff61a172ca6"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2089888 - Stop holding ca-certificates at a fixed version in the Ubuntu 22.04 images. r=glandium\" for causing Docker Image bustages.\n\nThis reverts commit e7044269f40a257128d79e03ee96bd7d4f66fb76.\n", "files": ["taskcluster/docker/debian-raw/Dockerfile"], "git_node": "e48e530c085eff6ff884e8a64098d4cef139d3a5", "git_parents": ["8d869a9ac40f09f075729d56e4572c525bd75e09"], "node": "d37695566597fa6419e0a144e3bd50a630b4057c", "parents": ["0c47809583f172dd11e8b850b3b8c1df1c830f5b"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2058620. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339977\n", "files": ["dom/file/MutableBlobStorage.cpp", "dom/xhr/XMLHttpRequestMainThread.cpp"], "git_node": "f2e305eb4ada783bb696289cb49f08fa2fb59eea", "git_parents": ["e48e530c085eff6ff884e8a64098d4cef139d3a5"], "node": "b2edaa4f5dc1eec4fb1b2ba8eb8ada2250f5d68a", "parents": ["d37695566597fa6419e0a144e3bd50a630b4057c"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089826 - Re-enable WebGL's DOM blit upload path when running on Metal ANGLE. r=gfx-reviewers,lsalzman\n\nIn bug 1800573 we disabled WebGL DOM blit uploads on Arm Macs due to\ncausing application freezes (bug 1800573). These were likely caused by a\ndriver bug in the native GL driver, therefore when running on Metal\nANGLE we should be safe to re-enable the blit path.\n\nWe must, however, ensure we still disable the path when using the native\nGL driver, meaning we can no longer simply rely on a default pref\nvalue. Instead, universally set webgl.disable-DOM-blit-uploads to false,\nand plumb a new flag through to ClientWebGLContext to indicate whether\nthe feature is allowed. Disallow it on Arm Macs unless using a Metal\nANGLE GL context.\n\nNote this means users will lose the ability to force-enable the blit\npath on the native GL driver on affected devices, but that is\nacceptable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340193\n", "files": ["dom/canvas/ClientWebGLContext.cpp", "dom/canvas/WebGLContext.cpp", "dom/canvas/WebGLTypes.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "a660e1677ad027a1791041583ab6732e140c5cfd", "git_parents": ["f2e305eb4ada783bb696289cb49f08fa2fb59eea"], "node": "0bebecd7206e29864d0ec6e4d04f8789319b2359", "parents": ["b2edaa4f5dc1eec4fb1b2ba8eb8ada2250f5d68a"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2087927 - Avoid lone surrogate pairs from web-originating content for tab and places. r=bdk,jonalmeida,android-reviewers,android-build-system-reviewers\n\nIn particular, a page \"title\" can easily have lone surrogate pairs depending on what the website does - eg,\none that slices a title to a max-length of some value without taking surrogate pairs into account will\ncause it. In general, I believe the URLs are less likely, so this patch primarily addresses title.\n\nThere's a new function, `mozilla.components.support.ktx.kotlin.toWellFormed`, which has the same\nsemantics as the JS function of the same name. This is a \"clever\" implementation in that it avoids\nextra allocations for strings which are already well-formed.\n\nIn particular:\n* tabs never made any attempt to catch `MalformedInputException` - it still does not, but instead\n  fixes any malformed titles before passing them over the FFI. Catching this exception would be tricky\n  here - if caught, we'd end up with no tabs for the client at all which seems bad.\n* places did catch `MalformedInputException` in one `HandlePlacesExceptions` implementation but not the\n  other. In addition though, the patch also sanitizes titles, meaning some history visits and bookmarks\n  can now be created where they previously silently failed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338637\n", "files": ["mobile/android/android-components/components/browser/storage-sync/build.gradle", "mobile/android/android-components/components/browser/storage-sync/src/main/java/mozilla/components/browser/storage/sync/PlacesBookmarksStorage.kt", "mobile/android/android-components/components/browser/storage-sync/src/main/java/mozilla/components/browser/storage/sync/PlacesHistoryStorage.kt", "mobile/android/android-components/components/browser/storage-sync/src/main/java/mozilla/components/browser/storage/sync/PlacesStorage.kt", "mobile/android/android-components/components/browser/storage-sync/src/main/java/mozilla/components/browser/storage/sync/RemoteTabsStorage.kt", "mobile/android/android-components/components/browser/storage-sync/src/test/java/mozilla/components/browser/storage/sync/PlacesBookmarksStorageTest.kt", "mobile/android/android-components/components/browser/storage-sync/src/test/java/mozilla/components/browser/storage/sync/PlacesHistoryStorageTest.kt", "mobile/android/android-components/components/browser/storage-sync/src/test/java/mozilla/components/browser/storage/sync/RemoteTabsStorageTest.kt", "mobile/android/android-components/components/support/ktx/src/main/java/mozilla/components/support/ktx/kotlin/String.kt", "mobile/android/android-components/components/support/ktx/src/test/java/mozilla/components/support/ktx/kotlin/StringTest.kt"], "git_node": "90bca2f731874b50fe3f816dd0e8a181bad823f2", "git_parents": ["a660e1677ad027a1791041583ab6732e140c5cfd"], "node": "49dbb57bb69ba86876880ddede936a3010367d67", "parents": ["0bebecd7206e29864d0ec6e4d04f8789319b2359"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2079668 [Wayland] Don't force commit to unmapped nsWindow r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339973\n", "files": ["widget/gtk/nsWindowWayland.cpp"], "git_node": "0bb771a5c0941b18b4e63c3c04ef841652c43914", "git_parents": ["90bca2f731874b50fe3f816dd0e8a181bad823f2"], "node": "ee840420318579b2f5460c6c5200c53f6ea0dc36", "parents": ["49dbb57bb69ba86876880ddede936a3010367d67"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088688 - Use ValidateFontDescriptor in WebRenderBridgeParent. r=gfx-reviewers,ahale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340224\n", "files": ["gfx/2d/ScaledFontFontconfig.cpp", "gfx/2d/UnscaledFontFreeType.h", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/webrender_bindings/WebRenderTypes.h"], "git_node": "17491a5e643517cb8f51e1e67fad47d45f3cdbc0", "git_parents": ["0bb771a5c0941b18b4e63c3c04ef841652c43914"], "node": "5866e035bf502ef82cdd1b4cae921b0a9f35445b", "parents": ["ee840420318579b2f5460c6c5200c53f6ea0dc36"], "tags": []}, {"author": "Mitar \u003cmitar.git@tnode.com\u003e", "branch": "default", "desc": "Bug 2064100 - [Wayland] Do not add a toplevel to the session under an ID from a previous session r=stransky,gtk-reviewers\n\nnsWindowWaylandToplevel::MoveToWorkspace() stored the passed ID also for a\nwindow which does not wait for session restore. Such a window is already shown\nor it is shown without restore, so GetWorkspaceID() later added it to the\nsession with xdg_session_v1.add_toplevel under that ID. The ID comes from the\nprevious session, and a compositor which still stores state for it has to\nraise a name_in_use protocol error, as the protocol requires add_toplevel to\nuse a name which is not known in the session. Mutter does so and Firefox\ncrashes. This happens when a previous session is restored from the menu or a\nclosed window is reopened.\n\nWhen the window had already been added under its own ID, the stored ID also\nreplaced it, and the session store then saved an ID under which the compositor\ndid not know the window.\n\nMoveToWorkspace() now stores the ID only for a window which waits for session\nrestore, which is the only case in which the window is restored under it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339348\n", "files": ["widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWaylandGtk.cpp"], "git_node": "a9569aec61960a4d84bb044b065b759a12d65d78", "git_parents": ["17491a5e643517cb8f51e1e67fad47d45f3cdbc0"], "node": "68cddba213c8ea0d5b3e5e1161a22a3f35f02900", "parents": ["5866e035bf502ef82cdd1b4cae921b0a9f35445b"], "tags": []}, {"author": "Mitar \u003cmitar.git@tnode.com\u003e", "branch": "default", "desc": "Bug 2064100 - [Wayland] Show windows which are not restored when session restore finishes r=stransky,gtk-reviewers\n\nA toplevel created while session restore is in progress is not shown until\nnsWindowWaylandToplevel::MoveToWorkspace() passes it its saved ID. The session\nstore calls moveToWorkspace() only for a window with a saved workspace ID, so a\nwindow without one stayed hidden. nsWindow::SessionRestoreFinished() released\nonly the window which requested focus.\n\nEvery profile used with session restore disabled, as it is on GNOME since bug\n2070815, saves its windows without IDs, so the first start with session restore\nenabled showed at most the window which requested focus. With\nbrowser.startup.page set to 3 and no previous session, the first window could\nstay hidden too.\n\nSessionRestoreFinished() now shows every window which still waits for session\nrestore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339349\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "89cef2ada96d1636ee0ae1fb7e46d065613fcb0e", "git_parents": ["a9569aec61960a4d84bb044b065b759a12d65d78"], "node": "c9d0238d02048994cdb70bcde3ce3f1371d5eaf0", "parents": ["68cddba213c8ea0d5b3e5e1161a22a3f35f02900"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2075886 - Use the right seat's pointer for drags with several Wayland seats. r=stransky,gtk-reviewers\n\nOn Wayland, nsDragSessionSource::InvokeDragSessionImpl() finds the origin\nwindow with gdk_device_get_window_at_position() on GdkGetPointer(). That\nreturns the window the device's seat last entered. GdkGetPointer() returns\ngdk_device_manager_get_client_pointer(), which GTK picks from the seat that\nadded a device most recently (gdk_wayland_device_manager_get_client_pointer()).\nWhen the compositor announces more than one wl_seat, that is usually not the\nseat the user is dragging with. If that seat's pointer is not over a Firefox\nwindow, the lookup returns NULL and the drag is aborted.\n\nTake the device from the saved button press (GetLastPointerDownEvent()) when\nthere is one. That is the device gtk_drag_begin_with_coordinates() drags with,\nsince it gets the device from the same event, and its pointer is over the\nwindow that was pressed.\n\nCallers with no press to go by have the same wrong-seat problem, so\nGdkGetPointer() now returns the pointer of gdk_display_get_default_seat(),\nwhich on Wayland is the first seat announced. On X11, GTK's default seat is\nthe seat of the X client pointer, so nothing changes there. The seat API is\nGTK 3.20, so it is looked up with dlsym() and the old call stays as the\nfallback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337692\n", "files": ["widget/gtk/WidgetUtilsGtk.cpp", "widget/gtk/nsDragSessionSource.cpp"], "git_node": "4b059d6b1cd1d88e01ed40f87ebcee42e00a8dd3", "git_parents": ["89cef2ada96d1636ee0ae1fb7e46d065613fcb0e"], "node": "7ee4a1b33192548be70f2be3fbbaeca014689cd3", "parents": ["c9d0238d02048994cdb70bcde3ce3f1371d5eaf0"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2035750 - Split Wayland dmabuf import failures into separate crash signatures. r=stransky,gtk-reviewers\n\nMutter reports a rejected dmabuf as \"failed to import supplied dmabufs:\n\u003creason\u003e\", and the reason names the step that failed: Cogl could not bind\nthe EGLImage (seen with the proprietary NVIDIA driver), or EGL could not\nallocate resources (seen with Mesa). Both currently crash in\nWlLogHandler_DmabufImportFailed, so the two can't be tracked apart.\n\nGive each known reason its own crash function and keep\nWlLogHandler_DmabufImportFailed for the rest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337650\n", "files": ["widget/gtk/nsWaylandDisplay.cpp"], "git_node": "e0241ef045376a5951f299674e83c8f0680a8cd6", "git_parents": ["4b059d6b1cd1d88e01ed40f87ebcee42e00a8dd3"], "node": "c66822329a6611601726f9fd56e402f14bb565e8", "parents": ["7ee4a1b33192548be70f2be3fbbaeca014689cd3"], "tags": []}, {"author": "Astor Wu \u003ccode@itdevwu.com\u003e", "branch": "default", "desc": "Bug 2089097 - Toggle hidden instead of style.display when switching about:webauthn tabs. r=mfarrell\n\nAll .tabcontent sections except the info section carry the hidden\nattribute in aboutWebauthn.html, but open_tab() only toggled\nstyle.display and never cleared hidden. As a result the PIN,\nCredentials and Biometric enrollment tabs rendered blank.\n\nThe browser tests only compared style.display against \"none\", which\npassed even though the sections were not rendered. Check actual\nvisibility with BrowserTestUtils.isVisible()/isHidden() instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339693\n", "files": ["toolkit/components/aboutwebauthn/content/aboutWebauthn.js", "toolkit/components/aboutwebauthn/tests/browser/browser_aboutwebauthn_aria_keycontrols.js", "toolkit/components/aboutwebauthn/tests/browser/browser_aboutwebauthn_bio.js", "toolkit/components/aboutwebauthn/tests/browser/browser_aboutwebauthn_credentials.js", "toolkit/components/aboutwebauthn/tests/browser/browser_aboutwebauthn_info.js", "toolkit/components/aboutwebauthn/tests/browser/browser_aboutwebauthn_pin.js"], "git_node": "d461d0156cd68cb692382203d8c56f5942ae6e00", "git_parents": ["e0241ef045376a5951f299674e83c8f0680a8cd6"], "node": "14a5e382e365ce93c86477816cd08780d0d771e1", "parents": ["c66822329a6611601726f9fd56e402f14bb565e8"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2089938 - Enable IME flat-text cache validation in test suites. r=masayuki\n\nCorrect the misspelled test preference across DOM, editor, widget and WPT tests. The StaticPrefs declaration already uses assert_valid_cache.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337886\n", "files": ["dom/base/test/chrome/test_nsITextInputProcessorCallback_at_changing_default_value_of_textarea.html", "dom/base/test/chrome/window_nsITextInputProcessor.xhtml", "dom/base/test/test_text_change_notifications_when_inserting_text_containing_line_breaks.html", "dom/events/test/test_text_event_in_content.html", "editor/libeditor/crashtests/crashtests.list", "editor/libeditor/tests/browser.toml", "editor/libeditor/tests/chrome.toml", "editor/libeditor/tests/mochitest.toml", "testing/web-platform/meta/editing/__dir__.ini", "testing/web-platform/meta/input-events/__dir__.ini", "widget/tests/window_composition_text_querycontent.xhtml"], "git_node": "2fbdf2f9ce033d356937af4fc9c16eeca90d9af8", "git_parents": ["d461d0156cd68cb692382203d8c56f5942ae6e00"], "node": "0a5bb15965e230244b2646a29f393b11380fb1d1", "parents": ["14a5e382e365ce93c86477816cd08780d0d771e1"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087583 - Initialize the modification timestamp for dirty origins. r=dom-storage-reviewers,hsingh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338769\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/test/gtest/TestQuotaManager.cpp"], "git_node": "fc543f987d94e0f079ccbc553da510fb479d059e", "git_parents": ["2fbdf2f9ce033d356937af4fc9c16eeca90d9af8"], "node": "d45910f3a1ddef58a783f601c1b3aba71a7c6606", "parents": ["0a5bb15965e230244b2646a29f393b11380fb1d1"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1860128 - Don't panic when adding a font fails. r=gfx-reviewers,ahale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340270\n", "files": ["gfx/wr/wr_glyph_rasterizer/src/platform/unix/font.rs"], "git_node": "352a053f7bf9a67e045e1c53b02687a330d96de7", "git_parents": ["fc543f987d94e0f079ccbc553da510fb479d059e"], "node": "24a0f11b59e7ba4c378a4546dbfae999eda8c09c", "parents": ["d45910f3a1ddef58a783f601c1b3aba71a7c6606"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2089941 - Limit ComparePoints ancestor walks to a caller-supplied root. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337864\n", "files": ["dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/base/test/gtest/TestContentUtils.cpp"], "git_node": "9552eb9c9075e44e143dc17fe5fd29a61a3b7738", "git_parents": ["352a053f7bf9a67e045e1c53b02687a330d96de7"], "node": "2b08a8568fccc03120e9c644b372a7f28251e046", "parents": ["24a0f11b59e7ba4c378a4546dbfae999eda8c09c"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087975 - [devtools] Preserve filter in network side panels r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339225\n", "files": ["devtools/client/netmonitor/src/components/request-details/CookiesPanel.js", "devtools/client/netmonitor/src/components/request-details/HeadersPanel.js", "devtools/client/netmonitor/src/components/request-details/RequestPanel.js", "devtools/client/netmonitor/test/browser_al.toml", "devtools/client/netmonitor/test/browser_mz.toml", "devtools/client/netmonitor/test/browser_net_cookies_filter.js", "devtools/client/netmonitor/test/browser_net_headers_filter.js", "devtools/client/netmonitor/test/browser_net_request_filter.js"], "git_node": "4e136fe1457e6a9b2754acca0dd89d03b9a85a29", "git_parents": ["9552eb9c9075e44e143dc17fe5fd29a61a3b7738"], "node": "16a98f22888e1432e832f36a9a2ed97f0797a41d", "parents": ["2b08a8568fccc03120e9c644b372a7f28251e046"], "tags": []}, {"author": "Mitar \u003cmitar.git@tnode.com\u003e", "branch": "default", "desc": "Bug 2064100 - [Wayland] Enable session restore on GNOME again r=stransky,gtk-reviewers\n\nBug 2070815 disabled Wayland session restore on GNOME, because restoring a\nsession from the History menu made Mutter raise a name_in_use protocol error\nand Firefox crashed. The two previous patches for this bug fix that error and\nshow the windows of profiles saved without IDs while session restore was\ndisabled, so the GNOME check is removed again.\n\nSession restore still needs a compositor which offers xdg_session_manager_v1,\non GNOME Mutter 51, and GTK 3 with the xdg-toplevel-realized signal, both\nchecked in the same function.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340272\n", "files": ["widget/gtk/nsAppShell.cpp"], "git_node": "fcd09a257c7a2778aded5758c8fe645c30964835", "git_parents": ["4e136fe1457e6a9b2754acca0dd89d03b9a85a29"], "node": "6ac749309747d8775a59885cd1b456688ac703c9", "parents": ["16a98f22888e1432e832f36a9a2ed97f0797a41d"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081808 - Resolve symlink when handling clang-plugin third party r=sylvestre\n\nThat way, at least under filesystems supporting symbolic links,\nreferences to headers that live in the objdir but point to files from\nsrcdir are correctly skipped if the pointed-to file is marked as\nskipped.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333719\n", "files": ["build/clang-plugin/Utils.h"], "git_node": "95944a2a7cad3855c6d91e288eed12d630ad9387", "git_parents": ["fcd09a257c7a2778aded5758c8fe645c30964835"], "node": "402d4119f8dc2b6a8a9cd3154db1a8b018f22143", "parents": ["6ac749309747d8775a59885cd1b456688ac703c9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080285 - Declare the browser window's gNavToolbox and CustomTitlebar.allowedBy for TypeScript. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340032\n", "files": ["tools/@types/browser-window-globals.d.ts", "tools/@types/browser-window.d.ts"], "git_node": "7d0d599c96a8185dc10f9d304f6674b373c9fe14", "git_parents": ["95944a2a7cad3855c6d91e288eed12d630ad9387"], "node": "c6c87091f7753115628443536c0f509eb389e976", "parents": ["402d4119f8dc2b6a8a9cd3154db1a8b018f22143"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080284 - Declare the browser window's XULBrowserWindow and MousePosTracker for TypeScript. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340045\n", "files": ["tools/@types/browser-window-globals.d.ts", "tools/@types/browser-window.d.ts"], "git_node": "b792d5952b388f4c554815b33cd41a205192a1da", "git_parents": ["7d0d599c96a8185dc10f9d304f6674b373c9fe14"], "node": "977cfe80af1250ed4593d89b6d7ea4fe0a00bfa5", "parents": ["c6c87091f7753115628443536c0f509eb389e976"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084662 - Make WorkerPrivate::GetCSPInfo return a Maybe. r=dom-worker-reviewers,asuth\n\nSome code was assuming that we always have a CSP, which doesn't really\nmake sense and will stop with the next patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336009\n", "files": ["dom/clients/api/Clients.cpp", "dom/security/trusted-types/TrustedTypeUtils.cpp", "dom/workers/WorkerPrivate.h"], "git_node": "e0c6ee2bd1fce0c0aba5cdc5f314c586f80c4f4d", "git_parents": ["b792d5952b388f4c554815b33cd41a205192a1da"], "node": "edd958f3df5f98773534eb5e61817cdabe697374", "parents": ["977cfe80af1250ed4593d89b6d7ea4fe0a00bfa5"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084662 - Use PolicyContainer::CreateForNonDocument for workers and support Connection Allowlists. r=dom-worker-reviewers,asuth\n\nThe only tricky thing here is that we need to keep applying the\nextension CSP. Considering that we do the same in Document::InitCSP it\nseems to make sense to do this everywhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336010\n", "files": ["dom/security/PolicyContainer.cpp", "dom/workers/WorkerPrivate.cpp", "dom/workers/WorkerPrivate.h", "dom/workers/loader/CacheLoadHandler.cpp", "dom/workers/loader/CacheLoadHandler.h", "dom/workers/loader/NetworkLoadHandler.cpp", "testing/web-platform/meta/connection-allowlist/tentative/dedicated-worker.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/service-worker-dedicated-worker.https.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/service-worker-shared-worker.https.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/service-worker.sub.https.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/shared-worker.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/websocket-service-worker.sub.https.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/websocket-shared-worker.https.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/webtransport-service-worker.sub.https.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/webtransport-shared-worker.https.sub.window.js.ini"], "git_node": "39aa1476d518ae49f309de2326117e87043655f9", "git_parents": ["e0c6ee2bd1fce0c0aba5cdc5f314c586f80c4f4d"], "node": "cf4709a3acb304b5f478803b78ed61ebeceb7373", "parents": ["edd958f3df5f98773534eb5e61817cdabe697374"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2088860 - Load the simplify-mode print preview sheets as additional author sheets. r=layout-reviewers,jwatt\n\nThe simplified print preview document has a null principal.\n\nWe want to make the chrome://global stylesheets not content-accessible,\nso load aboutReader.css and simplifyMode.css with\nloadSheetUsingURIString instead, which uses a sync system principal\nload.\n\nIt's also simpler because we don't need to do the waiting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339344\n", "files": ["toolkit/actors/PrintingChild.sys.mjs"], "git_node": "40170349358205da1efae7318d3ed573f9f97016", "git_parents": ["39aa1476d518ae49f309de2326117e87043655f9"], "node": "99c75dc49d1c6b9c33668250a4ec861ee335d0a6", "parents": ["cf4709a3acb304b5f478803b78ed61ebeceb7373"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086657 - Replace prefix: with logModule: in the console.createInstance calls (manual changes). r=frontend-codestyle-reviewers,urlbar-reviewers,daleharvey,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337653\n", "files": ["browser/components/urlbar/content/UrlbarShared.mjs", "docs/code-quality/lint/linters/eslint-plugin-mozilla/rules/use-console-createInstance.md", "dom/system/NetworkGeolocationProvider.sys.mjs", "mobile/shared/modules/geckoview/GeckoViewUtils.sys.mjs", "toolkit/components/passwordmgr/LoginHelper.sys.mjs", "toolkit/docs/javascript-logging.md", "xpcom/docs/logging.md"], "git_node": "a4609c02098acbc8a1b981b2d4fce110473bfbb6", "git_parents": ["40170349358205da1efae7318d3ed573f9f97016"], "node": "5bf67a1aeece54d4c7c34aac17c5dedfb5a5dddf", "parents": ["99c75dc49d1c6b9c33668250a4ec861ee335d0a6"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086657 - Add logModule: alongside prefix: in the console.createInstance calls of New Tab. r=mconley\n\nNew Tab can train-hop to a version of Firefox that ignores logModule, so\nits consoles keep their prefix until logModule reaches Release.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337654\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/lib/ExternalComponentsFeed.sys.mjs", "browser/extensions/newtab/lib/NewTabGleanUtils.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/lib/RemoteRenderer.sys.mjs", "browser/extensions/newtab/lib/SponsoredTopSitesScoreProvider/SponsoredTopSitesScoreProvider.mjs", "browser/extensions/newtab/lib/actors/MozNewTabRemoteRendererProtocolParent.sys.mjs", "browser/extensions/newtab/lib/actors/NewTabAttributionParent.sys.mjs"], "git_node": "a12ca65deb44354897d60a256f23a7031b7dc094", "git_parents": ["a4609c02098acbc8a1b981b2d4fce110473bfbb6"], "node": "659527c7414dea79231217319a2622d586239d5f", "parents": ["5bf67a1aeece54d4c7c34aac17c5dedfb5a5dddf"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089813 - Name the JSDoc API-reference cases in the documentation skill's description. r=sylvestre,ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340185\n", "files": [".agents/skills/documentation/SKILL.md", ".claude/skills/documentation/SKILL.md"], "git_node": "8597fdb024831657cf9139c2cd6a6863cfd8cdd0", "git_parents": ["a12ca65deb44354897d60a256f23a7031b7dc094"], "node": "34da2e5f68532c3e7da5882079086db3d9d41081", "parents": ["659527c7414dea79231217319a2622d586239d5f"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2088688 - Use ValidateFontDescriptor in WebRenderBridgeParent. r=gfx-reviewers,ahale\" for causing Valgrind failures.\n\nThis reverts commit 17491a5e643517cb8f51e1e67fad47d45f3cdbc0.\n", "files": ["gfx/2d/ScaledFontFontconfig.cpp", "gfx/2d/UnscaledFontFreeType.h", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/webrender_bindings/WebRenderTypes.h"], "git_node": "3086f856007fd60cea649bea29c0abb5a6e1c372", "git_parents": ["8597fdb024831657cf9139c2cd6a6863cfd8cdd0"], "node": "4a1f74192c0ffe754f31db379c187797884ad669", "parents": ["34da2e5f68532c3e7da5882079086db3d9d41081"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087975 - [devtools] Preserve filter in network side panels r=devtools-reviewers,nchevobbe\" for causing failures at browser_net_request_filter.js.\n\nThis reverts commit 4e136fe1457e6a9b2754acca0dd89d03b9a85a29.\n", "files": ["devtools/client/netmonitor/src/components/request-details/CookiesPanel.js", "devtools/client/netmonitor/src/components/request-details/HeadersPanel.js", "devtools/client/netmonitor/src/components/request-details/RequestPanel.js", "devtools/client/netmonitor/test/browser_al.toml", "devtools/client/netmonitor/test/browser_mz.toml", "devtools/client/netmonitor/test/browser_net_cookies_filter.js", "devtools/client/netmonitor/test/browser_net_headers_filter.js", "devtools/client/netmonitor/test/browser_net_request_filter.js"], "git_node": "e2f9387af51ae5f06d3b96ad85f0d6d8db11aa2c", "git_parents": ["3086f856007fd60cea649bea29c0abb5a6e1c372"], "node": "af67a0aa6ba71e0972f7be206fb95647971e019e", "parents": ["4a1f74192c0ffe754f31db379c187797884ad669"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088977 - Ensure that required annotations are always correctly populated r=schopin,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339944\n", "files": ["toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/windows.rs"], "git_node": "635a524129d8e9fcca0dd09a1711e3766f9902f6", "git_parents": ["e2f9387af51ae5f06d3b96ad85f0d6d8db11aa2c"], "node": "7bac5ce5bb911d44902edf7aea0dfc67780e378a", "parents": ["af67a0aa6ba71e0972f7be206fb95647971e019e"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088977 - Reformat crash helper files using the latest linter r=schopin,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339945\n", "files": ["toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/crash_helper_server/src/lib.rs"], "git_node": "313f3f4df7c7ad5dd7d9210914ee50eea9cf9175", "git_parents": ["635a524129d8e9fcca0dd09a1711e3766f9902f6"], "node": "7850ce80f7cc2f4f2c47ea045b382355f625a844", "parents": ["7bac5ce5bb911d44902edf7aea0dfc67780e378a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076000 - Always handle video visibility notifications async. r=alwu,media-playback-reviewers\n\nThe pause path was already async, let's do it consistently.\n\nmPaused check was already covered by the elegibility check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339886\n", "files": ["dom/media/mediaelement/HTMLVideoElement.cpp", "dom/media/mediaelement/HTMLVideoElement.h"], "git_node": "7a3ccd1d36bfff623cb3d291cbd5473f6c35b199", "git_parents": ["313f3f4df7c7ad5dd7d9210914ee50eea9cf9175"], "node": "af80ee8553699d7807d0641c6c7e8945dcf50f06", "parents": ["7850ce80f7cc2f4f2c47ea045b382355f625a844"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090007 - Remove some unneeded handling of attributes in SyncAttributesToWidget(). r=smaug\n\nMost of them are redundant because ChromeObserver::Init() does the right\nthing. Note that we rely on sizing the popup windows after initial\nlayout already so I think the dominantclientsize stuff can go away.\n\nWe do have extensive tests for popup sizing, but I can keep the\nspecial-case if this causes trouble I guess.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339662\n", "files": ["dom/xul/ChromeObserver.cpp", "dom/xul/ChromeObserver.h", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/AppWindow.h"], "git_node": "03f158a84e799d9a7fb0255d6c1928e7f85da088", "git_parents": ["7a3ccd1d36bfff623cb3d291cbd5473f6c35b199"], "node": "63551406f308e1d861b0113f0a6fd7022ea4a40c", "parents": ["af80ee8553699d7807d0641c6c7e8945dcf50f06"], "tags": []}, {"author": "Mitar \u003cmitar.git@tnode.com\u003e", "branch": "default", "desc": "Bug 2090009 - [Wayland] Restore toplevels whose workspace ID begins with decimal digits r=stransky,gtk-reviewers\n\nCreateRestoreSessionImpl() replaces an integer workspace ID saved by an older\nversion with a new UUID (bug 2059617), and recognized such an ID by\nToInteger() succeeding. ToInteger() skips the opening brace of a UUID, parses\nthe decimal digits which follow and stops without an error at the first\nhyphen, so it also succeeds for a UUID whose first group consists of decimal\ndigits only, as about one in 43 random UUIDs does ((10/16)^8). Such a window\nwas added to the session under a new ID instead of being restored.\n\nEvery ID saved for a Wayland window comes from GenerateWorkspaceID(), so an ID\nis now kept when it parses as a UUID and replaced otherwise.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340286\n", "files": ["widget/gtk/nsWindowWayland.cpp"], "git_node": "d7eb772ff65953be7b6a2556255e86e2d8307248", "git_parents": ["03f158a84e799d9a7fb0255d6c1928e7f85da088"], "node": "5c89367f236b3a5d9452a2cb88ab2942326c23b5", "parents": ["63551406f308e1d861b0113f0a6fd7022ea4a40c"], "tags": []}, {"author": "Marcin Kozi\u0144ski \u003cmkozinski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089518 - Add Android review context r=ai4dev-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339913\n", "files": ["review-context.toml"], "git_node": "538887faa1ced2864ed95069cf286f17c2940d54", "git_parents": ["d7eb772ff65953be7b6a2556255e86e2d8307248"], "node": "de36ecb21adb12fd6a68a811c0da917cd8572b7c", "parents": ["5c89367f236b3a5d9452a2cb88ab2942326c23b5"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071613 - Add desktop-theme skills for writing, reviewing and debugging front-end styling. r=ai4dev-reviewers,padenot,tgiles DONTBUILD\n\n`desktop-theme-probing` is set `name-only`: the four subject skills name it in prose, which is the only thing that routes to a `name-only` skill.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325615\n", "files": [".agents/skills/README.md", ".agents/skills/desktop-theme-colors/SKILL.md", ".agents/skills/desktop-theme-colors/references/forced-color-filter.md", ".agents/skills/desktop-theme-colors/references/system-color-pairs.md", ".agents/skills/desktop-theme-colors/scripts/contrast.py", ".agents/skills/desktop-theme-colors/scripts/pair-walk.py", ".agents/skills/desktop-theme-layout/SKILL.md", ".agents/skills/desktop-theme-layout/references/environment-sweep.md", ".agents/skills/desktop-theme-layout/references/positioning.md", ".agents/skills/desktop-theme-probing/SKILL.md", ".agents/skills/desktop-theme-probing/references/build-freshness.md", ".agents/skills/desktop-theme-probing/references/devtools-mcp.md", ".agents/skills/desktop-theme-probing/references/markup-differential.md", ".agents/skills/desktop-theme-probing/references/measuring-pixels.md", ".agents/skills/desktop-theme-probing/references/platform-linux.md", ".agents/skills/desktop-theme-probing/references/platform-macos.md", ".agents/skills/desktop-theme-probing/references/platform-windows.md", ".agents/skills/desktop-theme-probing/references/probe-recipes.md", ".agents/skills/desktop-theme-probing/references/probe-runner.md", ".agents/skills/desktop-theme-probing/references/running-a-probe.md", ".agents/skills/desktop-theme-probing/references/scratch-probe.md", ".agents/skills/desktop-theme-probing/scripts/firefox-probe.py", ".agents/skills/desktop-theme-probing/scripts/marker-probe.py", ".agents/skills/desktop-theme-probing/scripts/probelib.py", ".agents/skills/desktop-theme-probing/scripts/screen-grab.py", ".agents/skills/desktop-theme-screenshots/SKILL.md", ".agents/skills/desktop-theme-screenshots/scripts/attach-to-bug.py", ".agents/skills/desktop-theme-screenshots/scripts/capture-pair.sh", ".agents/skills/desktop-theme-screenshots/scripts/capture.js", ".agents/skills/desktop-theme-screenshots/scripts/pixel-diff.py", ".agents/skills/desktop-theme-screenshots/scripts/zoom-pair.py", ".agents/skills/desktop-theme-tokens/SKILL.md", ".agents/skills/desktop-theme-tokens/references/nova-overrides.md", ".agents/skills/desktop-theme-tokens/references/rem-roots.md", ".agents/skills/desktop-theme-tokens/references/theme-manifests.md", ".agents/sk