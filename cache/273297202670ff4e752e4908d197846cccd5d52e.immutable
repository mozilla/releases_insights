hird_party/opentelemetry-cpp/sdk/src/trace/span.cc", "third_party/opentelemetry-cpp/sdk/src/trace/span.h", "third_party/opentelemetry-cpp/sdk/src/trace/span_limits.cc", "third_party/opentelemetry-cpp/sdk/src/trace/tracer.cc", "third_party/opentelemetry-cpp/sdk/src/trace/tracer_context.cc", "third_party/opentelemetry-cpp/sdk/src/trace/tracer_provider.cc", "third_party/opentelemetry-cpp/sdk/src/trace/tracer_provider_factory.cc", "third_party/opentelemetry-cpp/sdk/src/version/version.cc"], "git_node": "3481ab17cf8fe792c78a073651be6f7b7c756ae1", "git_parents": ["a07b9d35bb5152fb113a2a363b363528f1ed224a"], "node": "206656a515ca7b4f943db1a9ca25143e77fc8618", "parents": ["a6ecdeb081ab7b3b380883050a4e8ee1ef11f7a9"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1821615 - Part 5: Add telemetry for the innerHTML fast path. r=hsivonen\" for causing mass failures @nsHtml5FragmentFastPath.cpp.\n\nThis reverts commit 6c3358bd4216d2e9db4d962a948b7dc5ca46caf5.\n\nRevert \"Bug 1821615 - Part 4: Use the innerHTML fast path for DOMParser documents. r=hsivonen\"\n\nThis reverts commit a0eb5f92df78501543f159d9919ad540c6e3e9ce.\n\nRevert \"Bug 1821615 - Part 3: Support character references in the innerHTML fast path. r=hsivonen\"\n\nThis reverts commit cebe405882f38f2b1e53c9f733ebb706c7533051.\n\nRevert \"Bug 1821615 - Part 2: Support comments in the innerHTML fast path. r=hsivonen\"\n\nThis reverts commit 1eb85064104d3efd07dad137ab485c6f3e4336d9.\n\nRevert \"Bug 1821615 - Part 1: Add an innerHTML fast path for a small subset of HTML. r=hsivonen\"\n\nThis reverts commit 99aff747e19316702d2112197e958d82f54184de.\n", "files": ["dom/base/DOMParser.cpp", "dom/base/FragmentOrElement.cpp", "dom/base/UseCounters.conf", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/base/nsDOMWindowUtils.cpp", "dom/base/test/browser.toml", "dom/base/test/browser_fragment_parsing_telemetry.js", "dom/base/test/browser_use_counters.js", "dom/base/test/file_use_counter_domparser_fast_path.html", "dom/base/test/file_use_counter_innerhtml_fast_path.html", "dom/base/test/mochitest.toml", "dom/base/test/test_innerHTML_fast_path.html", "dom/base/test/test_innerHTML_fast_path_csp.html", "dom/base/use_counter_metrics.yaml", "dom/interfaces/base/nsIDOMWindowUtils.idl", "dom/metrics.yaml", "modules/libpref/init/StaticPrefList.yaml", "parser/html/moz.build", "parser/html/nsHtml5FragmentFastPath.cpp", "parser/html/nsHtml5FragmentFastPath.h", "parser/html/nsHtml5PortabilityHSupplement.h", "parser/html/nsHtml5TokenizerCppSupplement.h", "parser/htmlaccel/gtest/TestHtmlSimd.cpp", "parser/htmlaccel/htmlaccel.h", "parser/htmlaccel/htmlaccelNotInline.cpp", "parser/htmlaccel/htmlaccelNotInline.h", "tools/clang-tidy/config.yaml"], "git_node": "a99a901c1e89785df019806afddd2208c59827cf", "git_parents": ["3481ab17cf8fe792c78a073651be6f7b7c756ae1"], "node": "fbdd1ecf450f311622fcc8bd3bab281d7badf0bc", "parents": ["206656a515ca7b4f943db1a9ca25143e77fc8618"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2088943, Bug 1998954 - Use the inherited principal URI for about:srcdoc SHEs when checking same-origin for the Navigation API. r=dom-core-reviewers,vhilla,necko-reviewers,valentin\" for causing wpt failures @navigate-iframe-to-same-url-with-document-domain.html.\n\nThis reverts commit 78d706c38dd4afedf0f0f74c77b6291f34cd1572.\n\nRevert \"Bug 1998954 - Use new push/replace path for frames. r=dom-core-reviewers,farre\"\n\nThis reverts commit c521a2d3f842417ae61856513626118b66d06751.\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/nsDocShell.cpp", "docshell/shistory/SessionHistoryEntry.cpp", "docshell/shistory/SessionHistoryEntry.h", "docshell/shistory/nsSHistory.cpp", "dom/base/nsFrameLoader.cpp", "modules/libpref/init/StaticPrefList.yaml", "netwerk/base/nsNetUtil.cpp", "netwerk/base/nsNetUtil.h", "testing/web-platform/meta/navigation-api/__dir__.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-to-srcdoc.html.ini", "testing/web-platform/meta/navigation-api/navigation-history-entry/entries-after-blank-navigation.html.ini", "testing/web-platform/meta/navigation-api/navigation-history-entry/entries-after-blob-navigation.html.ini", "testing/web-platform/meta/navigation-api/navigation-history-entry/entries-after-srcdoc-navigation.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/traverseTo-navigates-multiple-iframes.html.ini"], "git_node": "a7fed7aa92228bbc4151fa46747a4d9fd1383d56", "git_parents": ["a99a901c1e89785df019806afddd2208c59827cf"], "node": "819f3b2fa97d5d8579dedff4ef15a8a03279f4e5", "parents": ["fbdd1ecf450f311622fcc8bd3bab281d7badf0bc"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086110 - Load the dom/media review checklists for patches that change dom/media code. r=padenot\n\nReview Helper did not use the checklists in dom/media/docs/review/,\nbecause no review-context.toml rule pointed at them. A patch that\nchanges dom/media source code now loads all five: threading, async\nlifecycle, IPC, memory safety and spec correctness. Vendored code\nin dom/media is left out.\n\nThe IPC checklist loads for every such patch, because a file path\ncannot show whether a class implements an IPC actor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337149\n", "files": ["review-context.toml"], "git_node": "f2ba354adf52791a9475d225c4e3f5fd48bfbf06", "git_parents": ["a7fed7aa92228bbc4151fa46747a4d9fd1383d56"], "node": "ed6d545042a647e016c3404b982e3390c4348730", "parents": ["819f3b2fa97d5d8579dedff4ef15a8a03279f4e5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2088988 - Remove dead printReversed setting. r=layout-reviewers,AlaskanEmily\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339564\n", "files": ["toolkit/components/printing/content/printPageSetup.js", "toolkit/components/printingui/ipc/PPrintingTypes.ipdlh", "tools/@types/generated/lib.gecko.xpcom.d.ts", "widget/gtk/nsPrintSettingsGTK.cpp", "widget/gtk/nsPrintSettingsGTK.h", "widget/nsIPrintSettings.idl", "widget/nsPrintSettingsImpl.cpp", "widget/nsPrintSettingsImpl.h", "widget/nsPrintSettingsService.cpp"], "git_node": "5bebfb7a6d11ec53245b7c5d517b254c03ac9609", "git_parents": ["f2ba354adf52791a9475d225c4e3f5fd48bfbf06"], "node": "3674aaa3a293d38b679cae3228595585e221da38", "parents": ["ed6d545042a647e016c3404b982e3390c4348730"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2087166 - [Monitor+Research Agent][FE] Group monitors on the Tasks page into Active and Paused, with Show more r=yjamora,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338061\n", "files": ["browser/components/aiwindow/ui/components/ai-tasks-group/ai-tasks-group.css", "browser/components/aiwindow/ui/components/ai-tasks-group/ai-tasks-group.mjs", "browser/components/aiwindow/ui/components/ai-tasks-group/ai-tasks-group.stories.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/tasks/browser.toml", "browser/components/aiwindow/ui/test/browser/tasks/browser_tasks_monitor_groups.js", "browser/components/aiwindow/ui/test/browser/tasks/test_monitors_display.mjs", "browser/components/aiwindow/ui/test/browser/tasks/test_monitors_display_page.html", "browser/locales-preview/aiWindow.ftl"], "git_node": "1422668705f58e5afc5d8519e933fae2a575df76", "git_parents": ["5bebfb7a6d11ec53245b7c5d517b254c03ac9609"], "node": "a9b54216545d65f4992b341c616735b0960c6176", "parents": ["3674aaa3a293d38b679cae3228595585e221da38"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2089217 - Decode WebCodecs integer PCM with its own sample format. r=media-playback-reviewers,alwu\n\nDescribe only pcm-f32 to the decoder as float WAV audio, and give it the\nsample width of each integer PCM codec, as the PCM codec registration\ndefines [1].\n\nThe integer codecs were all described as 32-bit float, so they decoded to\nthe wrong number of frames with meaningless sample values.\n\n[1] https://w3c.github.io/webcodecs/pcm_codec_registration.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339748\n", "files": ["dom/media/webcodecs/AudioDecoder.cpp", "dom/media/webcodecs/WebCodecsUtils.cpp"], "git_node": "d392a58f8c76c246a3c95e21d8963986ea62321b", "git_parents": ["1422668705f58e5afc5d8519e933fae2a575df76"], "node": "88165218c7ff962370160cfc04e0970ce2363b32", "parents": ["a9b54216545d65f4992b341c616735b0960c6176"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2089217 - Add a WPT checking the samples decoded from each linear PCM codec. r=media-playback-reviewers,alwu\n\nDecode a known stereo signal encoded with each linear PCM codec [1] and\ncompare every decoded sample with the input.\n\nThe existing PCM variants only count decoder outputs, so they pass even when\nthe decoded samples are wrong.\n\n[1] https://w3c.github.io/webcodecs/pcm_codec_registration.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339749\n", "files": ["testing/web-platform/tests/webcodecs/audioDecoder-pcm-output.https.any.js"], "git_node": "2138bb55ebc2ad9185c916a239ed4a398bb76c74", "git_parents": ["d392a58f8c76c246a3c95e21d8963986ea62321b"], "node": "9411dae3233a4fe651c69e9b78a9cd2a2b9d8018", "parents": ["88165218c7ff962370160cfc04e0970ce2363b32"], "tags": []}, {"author": 