, "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF8-H.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF8-H.bcmap.br", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF8-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF8-V.bcmap.br", "toolkit/components/pdfjs/content/web/cmaps/V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/V.bcmap.br", "toolkit/components/pdfjs/content/web/cmaps/WP-Symbol.bcmap", "toolkit/components/pdfjs/content/web/cmaps/WP-Symbol.bcmap.br", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "a64aebb49bc5f523a8c53caddcb6b4690e01c738", "git_parents": ["81ab73f807b916a450afa29bfaf09c15d14e225d"], "node": "0367743cfa9025158b09525ceb0a6d052ec9be05", "parents": ["8e9281852055f8980e7252d6c2068464f1768c8e"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064404 - Accelerate two more early 'events' pings r=TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342262\n", "files": ["toolkit/components/glean/src/init/mod.rs"], "git_node": "a50ac0d83e98218086668e198244ad882b9c8a90", "git_parents": ["a64aebb49bc5f523a8c53caddcb6b4690e01c738"], "node": "73e2f28bb7caf4ece33beb61d3c581429df1f361", "parents": ["0367743cfa9025158b09525ceb0a6d052ec9be05"], "tags": []}, {"author": "Jonathan Kew \u003cjfkthame@gmail.com\u003e", "branch": "default", "desc": "Bug 2092546 - Move some nsIFrame bit flags into frame-state bits to reduce the size of nsIFrame. r=layout-reviewers,emilio,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342580\n", "files": ["layout/generic/nsContainerFrame.h", "layout/generic/nsFrameStateBits.h", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "layout/generic/nsTextFrame.h"], "git_node": "a7ac55c3646a5f24ff56ba135833a0a0715e4915", "git_parents": ["a50ac0d83e98218086668e198244ad882b9c8a90"], "node": "0122bfe44ac4f987718de5492db265ad7f2451e6", "parents": ["73e2f28bb7caf4ece33beb61d3c581429df1f361"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092532: settle WebTransport datagram writes when neqo queues them above its high water mark r=valentin,necko-reviewers\n\nneqo reports no outcome for a queued datagram that later expires or is\nevicted, and Http3Client drops the outcomes it does report, so a write()\nwaiting for one never settled and the datagram writable stalled for the\nrest of the session.  Settle every write once neqo has accepted the\ndatagram, and report a datagram neqo refuses as dropped.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342570\n", "files": ["netwerk/protocol/http/Http3Session.cpp", "netwerk/socket/neqo_glue/src/lib.rs"], "git_node": "50de4adde523f8c1181d97f48e389a2a73a86d1c", "git_parents": ["a7ac55c3646a5f24ff56ba135833a0a0715e4915"], "node": "e04bcc8b9ab2675467d5e1158f1194d69c2df44f", "parents": ["0122bfe44ac4f987718de5492db265ad7f2451e6"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092532: test that every write() of a WebTransport datagram burst that overruns the outgoing queue settles r=valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342571\n", "files": ["testing/web-platform/tests/webtransport/datagrams2.https.any.js"], "git_node": "8341cfa1f58d9f63daccd7d24f118c33d55e1058", "git_parents": ["50de4adde523f8c1181d97f48e389a2a73a86d1c"], "node": "71e3c94e7d2c354ddcf65b95e4393b0c959b0261", "parents": ["e04bcc8b9ab2675467d5e1158f1194d69c2df44f"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078235 - Ensure sidebar panels are scrollable at the window edge in hide-launcher mode r=desktop-theme-reviewers,sidebar-reviewers,mstriemer,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339696\n", "files": ["browser/components/sidebar/SidebarState.sys.mjs", "browser/components/sidebar/sidebar-customize.css", "browser/components/sidebar/sidebar-opentabs.css", "browser/components/sidebar/sidebar.css", "browser/components/sidebar/tests/browser/browser_hide_sidebar.js", "browser/themes/shared/sidebar.css"], "git_node": "a80876a1a0289d90662329fb6c05127ef4f19095", "git_parents": ["8341cfa1f58d9f63daccd7d24f118c33d55e1058"], "node": "eba29c70e33bce57cf2f780dc318ebccdedaa3d5", "parents": ["71e3c94e7d2c354ddcf65b95e4393b0c959b0261"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1971657: Do not abort flushAllWindowsAsync in response to a content process crash r=sfoster,sessionstore-reviewers,farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338156\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_shutdown_flush_tab_crash.py"], "git_node": "6b50b61de91f678fd8d7aeaa5d0e985612b8e9e0", "git_parents": ["a80876a1a0289d90662329fb6c05127ef4f19095"], "node": "f4e4ff3de91ddeb1028462955e85d16bc55f6821", "parents": ["eba29c70e33bce57cf2f780dc318ebccdedaa3d5"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077465 - Fix various crash reporting tests that were not waiting on asynchronous operations r=schopin,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342537\n", "files": ["toolkit/crashreporter/test/unit/head_win64cfi.js", "toolkit/crashreporter/test/unit/test_crash_phc.js", "toolkit/crashreporter/test/unit/test_crashreporter_crash.js", "toolkit/crashreporter/test/unit/test_event_files.js"], "git_node": "38851d434c3749fb0612de499856dbfce370ca5e", "git_parents": ["6b50b61de91f678fd8d7aeaa5d0e985612b8e9e0"], "node": "e3e6f8b64b8709d8cc094ac4185f09a304f738a4", "parents": ["f4e4ff3de91ddeb1028462955e85d16bc55f6821"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077465 - Don't record handle data in main process minidumps on Windows r=schopin,crashreporting-reviewers\n\nRequesting handle data when dumping the main process causes dbgcore.dll\nto load several other DLLs. However all the other threads have been\nsuspended at that point, including the loader worker threads which\nshould load the new DLLs. We've already tried working around this\nproblem by preloading verifier.dll in the main process, but there are\nother dependencies and they are version-dependent (I recently found us\ngetting stuck on version.dll for example on recent Windows 11\ninstallations). Trying to preload anything is not sustainable and we're\nmoving main process generation out-of-process, so the easier fix here is\nto no include handle data in main process dumps. It's a small loss of\nfunctionality that will soon be adressed in a more robust way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342538\n", "files": ["toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "66ddb60fdb2dc331e1379f079ded91dce40358cd", "git_parents": ["38851d434c3749fb0612de499856dbfce370ca5e"], "node": "3ac637c0898615b264f536400c74a4d921fbd268", "parents": ["e3e6f8b64b8709d8cc094ac4185f09a304f738a4"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077465 - Defend against spurious failures in the telemetry machinery so that the crash reporter tests still succeed r=schopin,crashreporting-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342541\n", "files": ["toolkit/crashreporter/test/unit/test_event_files.js", "toolkit/crashreporter/test/unit_ipc/test_content_annotation.js"], "git_node": "a693792dc629cc786aa9aede90396eac7daaaa1c", "git_parents": ["66ddb60fdb2dc331e1379f079ded91dce40358cd"], "node": "8663ccf5b997223082176df3e8065e48f416bee7", "parents": ["3ac637c0898615b264f536400c74a4d921fbd268"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091869 - Move the onboarding spacer conditions into a helper to satisfy CognitiveComplexMethod. r=mcarare\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt"], "git_node": "48bcce5ab5abb69099731a9a96d0735d240b68a8", "git_parents": ["a693792dc629cc786aa9aede90396eac7daaaa1c"], "node": "09c47e7480de6cb2df1b54e5e33126de97ee2bba", "parents": ["8663ccf5b997223082176df3e8065e48f416bee7"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2092149 - Extend Fenix release promotion sign-off to include both TAE and legacy UI tests r=ajoltan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342348\n", "files": ["mobile/android/test_infra/flank-configs/fenix/arm-signoff-tests.yml", "taskcluster/kinds/ui-test-apk/kind.yml"], "git_node": "ad8ff0b2c93b921fb4777579b61ded2454317aba", "git_parents": ["48bcce5ab5abb69099731a9a96d0735d240b68a8"], "node": "df9b7b9f12ef35117489c08beb10c9e85b6200d9", "parents": ["09c47e7480de6cb2df1b54e5e33126de97ee2bba"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2092399: Let Updatebot's arc diff mark non-UTF-8 files as binary. r=firefox-build-system-reviewers,ahochheiden\n\nWhen a diff contains files that aren't valid UTF-8 but don't look binary,\narc diff asks whether to mark them as binary. Updatebot runs it without a\nTTY, so arc fails instead of asking, and the update gets no Phabricator\nrevision: PDF.js's binary cmap files did this in bug 2092381. Patch\narcanist to take the prompt's default, marking them binary, when nobody\ncan answer.\n\nMarking an added (or deleted) file as binary also failed on PHP 8: arc\nruns \"hg cat\" on the side of the change that has no path, and passing\nnull there is deprecated, which arc raises as an exception. Three of the\nPDF.js files were added, so the patch also returns no data for a null\npath, as a failed \"hg cat\" already does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342442\n", "files": ["taskcluster/docker/updatebot/Dockerfile", "taskcluster/docker/updatebot/arcanist_non_utf8_binary.patch", "taskcluster/docker/updatebot/privileged-setup.sh"], "git_node": "dda77d3e170d11e0ee7f2db165eb3f4d1430e3e5", "git_parents": ["ad8ff0b2c93b921fb4777579b61ded2454317aba"], "node": "2d318e33004c83ed008eaf90c3f34d55dadc7ad4", "parents": ["df9b7b9f12ef35117489c08beb10c9e85b6200d9"], "tags": []}, {"author": "Travis Long \u003ctlong@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089195 - Remove Legacy Telemetry instrumentation from Toolkit :: Telemetry.r=chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341113\n", "files": ["toolkit/components/telemetry/Scalars.yaml", "toolkit/components/telemetry/metrics.yaml", "toolkit/components/telemetry/tests/unit/test_TelemetrySession.js"], "git_node": "2577e1ffd7c48a9b88223d850e10f1fe57a9f36f", "git_parents": ["dda77d3e170d11e0ee7f2db165eb3f4d1430e3e5"], "node": "5dcc221d6c74082c9d050cedd2d51ca8c0f80468", "parents": ["2d318e33004c83ed008eaf90c3f34d55dadc7ad4"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090613 - Enable \"mathml.a.element.enabled\" preference for referrer-policy/gen/* tests. r=freddyb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340853\n", "files": ["testing/web-platform/meta/referrer-policy/gen/__dir__.ini"], "git_node": "d7170bc4cc670e6816b2173f4e2bdc6068cf3028", "git_parents": ["2577e1ffd7c48a9b88223d850e10f1fe57a9f36f"], "node": "c325f1b5bbf633223ea458d74aa65f06ac549468", "parents": ["5dcc221d6c74082c9d050cedd2d51ca8c0f80468"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2091146 - Use separate popup pages without testharness in hide-before-reveal.html and similar tests. r=jgraham\n\nThe popups of these tests were the test files themselves, so they loaded\ntestharnessreport.js and acted as the main test window. Their testdriver\nactions were then never run, and the windows were never minimized. Each popup\nis now a separate page that only loads testdriver and sends its actions to the\nopener. hide-before-reveal.html also waits for the popup to restore its window\nbefore it finishes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341127\n", "files": ["testing/web-platform/meta/css/css-view-transitions/navigation/hide-before-reveal.html.ini", "testing/web-platform/meta/html/browsers/browsing-the-web/history-traversal/pageswap/pageswap-push-navigation-hidden-document.html.ini", "testing/web-platform/meta/infrastructure/testdriver/minimize_restore_popup.html.ini", "testing/web-platform/tests/css/css-view-transitions/navigation/hide-before-reveal.html", "testing/web-platform/tests/css/css-view-transitions/navigation/resources/hide-before-reveal-popup.html", "testing/web-platform/tests/html/browsers/browsing-the-web/history-traversal/pageswap/pageswap-push-navigation-hidden-document.html", "testing/web-platform/tests/html/browsers/browsing-the-web/history-traversal/pageswap/resources/pageswap-push-navigation-hidden-document-popup.html", "testing/web-platform/tests/infrastructure/testdriver/minimize_restore_popup.html", "testing/web-platform/tests/infrastructure/testdriver/resources/minimize_restore_popup.html"], "git_node": "f520abc1d74d8767c2e27922a1075d59f70c074f", "git_parents": ["d7170bc4cc670e6816b2173f4e2bdc6068cf3028"], "node": "363e43a8011477e57631c4e45b026d86ebf08e3d", "parents": ["c325f1b5bbf633223ea458d74aa65f06ac549468"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2075596 - Remove the divider from the homepage toolbar r=android-reviewers,skhan\n\n- Never show the BrowserToolbar divider on the homepage in normal or private mode, including while searching\n- https://www.figma.com/design/hBfKusHhCaTfERowKh1yYP/HNT-Handoff?node-id=3257-5761&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342471\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposable.kt"], "git_node": "cf7dc8682f1c9a8eb9446be758437fcecf547828", "git_parents": ["f520abc1d74d8767c2e27922a1075d59f70c074f"], "node": "870a23ff7caf10e5b40a112d4702242ee5accddf", "parents": ["363e43a8011477e57631c4e45b026d86ebf08e3d"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2092422 - Enable the Darkest theme option in Nightly and Debug builds r=android-reviewers,skhan,mobiletest-reviewers,aaronmt\n\n- Default the oled-theme Nimbus feature to enabled on the developer and nightly channels.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342466\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsCustomizeSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuCustomizeRobot.kt"], "git_node": "90e1e0804aafce810a9ce361d32b71a37cee0cc5", "git_parents": ["cf7dc8682f1c9a8eb9446be758437fcecf547828"], "node": "548e35e34d0edc219e1599bda3d6a9bca226f53c", "parents": ["870a23ff7caf10e5b40a112d4702242ee5accddf"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 2088132 - Use multiple possible formats for converting to Date r=android-reviewers,mcarare\n\nThis patch started out with the smallest possible fix is:\n\n```kotlin\nval possibleFormats =\n    when (format) {\n        \"HH:mm:ss.SSS\" -\u003e arrayOf(format, \"HH:mm:ss\", \"HH:mm\")\n        \"HH:mm:ss\" -\u003e arrayOf(format, \"HH:mm\")\n        else -\u003e arrayOf(format)\n    }\nval initialDate = initialDateString.toDate(*possibleFormats) ?: Date()\n```\n\nWhile attempting to write a test for it, there was a lot of duplication\nlogic everwhere in the area and I was adding to it instead of making it\nbetter.\n\nThis patch then grew into an attempt to extract the static functions of\nthe logic outside of the instances so that individual logic can be\ntested. With the current test coverage still passing, this gives us\nconfidence that pulling out the code into static functions has not\ncaused any regressions.\n\nA single behaviour change: instead of throwing a ParseException in some\ncases from `defaultValue` usage, we now return a default `Date` as we do\nin other places for error handling.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342038\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/prompt/GeckoPromptDelegate.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/prompt/GeckoPromptDelegateTest.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/prompt/PromptHelpersTest.kt", "mobile/android/android-components/components/support/ktx/src/main/java/mozilla/components/support/ktx/kotlin/String.kt"], "git_node": "bf3a37933374f8a0cc635d51d76ba09f06e9294e", "git_parents": ["90e1e0804aafce810a9ce361d32b71a37cee0cc5"], "node": "8741fc29a006941916761e2244d52d1196ddc93d", "parents": ["548e35e34d0edc219e1599bda3d6a9bca226f53c"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2091390 - Force ORB on for speculation-rules client-hints redirect test. r=necko-reviewers,kershaw\n\nORB is only enabled on Android in Nightly, so the (drop) subtest unexpectedly\npasses on Android beta.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342597\n", "files": ["testing/web-platform/meta/speculation-rules/prefetch/client-hints/redirect.https.sub.html.ini"], "git_node": "a1e9e06a819cf9dbf51c0806be7b3ff55e07afd4", "git_parents": ["bf3a37933374f8a0cc635d51d76ba09f06e9294e"], "node": "150bf37859e04d59ab3b5b6193321b608118e919", "parents": ["8741fc29a006941916761e2244d52d1196ddc93d"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1971657: Do not abort flushAllWindowsAsync in response to a content process crash r=sfoster,sessionstore-reviewers,farre\" for causing marionette failures on nsAboutRedirector.cpp.\n\nThis reverts commit 6b50b61de91f678fd8d7aeaa5d0e985612b8e9e0.\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_shutdown_flush_tab_crash.py"], "git_node": "7c82c0685a5669155e789b2fe188378d4861e401", "git_parents": ["a1e9e06a819cf9dbf51c0806be7b3ff55e07afd4"], "node": "30d83557ead0e90d3a9a003c8fcbe0a91bac9e3c", "parents": ["150bf37859e04d59ab3b5b6193321b608118e919"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2092098 - Add tentative WPTs for anchorNode and focusNode when the selection is in a shadow tree. r=dom-core-reviewers,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342172\n", "files": ["testing/web-platform/meta/selection/shadow-dom/tentative/Selection-anchor-focus-rescoping.tentative.html.ini", "testing/web-platform/tests/selection/shadow-dom/tentative/Selection-anchor-focus-rescoping.tentative.html"], "git_node": "e0fab0bc175b5217dd62e95e6fffc0473d19166c", "git_parents": ["7c82c0685a5669155e789b2fe188378d4861e401"], "node": "8c7f432e2ccb1d62e77d7fb4b7c45e4d485893f6", "parents": ["30d83557ead0e90d3a9a003c8fcbe0a91bac9e3c"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088234 - Add Set to Default promo to locations subview - r=ip-protection-reviewers,fluent-reviewers,flod,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341133\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/assets/location-pin.svg", "browser/components/ipprotection/content/ipprotection-constants.mjs", "browser/components/ipprotection/content/ipprotection-locations.mjs", "browser/components/ipprotection/content/locations-subview.css", "browser/components/ipprotection/tests/browser/browser_ipprotection_location_selector_telemetry.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_locations_keyboard_navigation.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_locations_list.js", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "7d92295174c6cbbd84ae6b6c0ca13ee79d75a7ce", "git_parents": ["e0fab0bc175b5217dd62e95e6fffc0473d19166c"], "node": "9547fe76bc9c6e66422c8bde1d0264bc657f679f", "parents": ["8c7f432e2ccb1d62e77d7fb4b7c45e4d485893f6"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088236 - Add Set to Default promo to built-in VPN settings - r=ip-protection-reviewers,settings-reviewers,desktop-theme-reviewers,tgiles,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341439\n", "files": ["browser/components/preferences/DefaultBrowserHelper.mjs", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection.js"], "git_node": "64bf0be265f7dbd36c0b171b2eee5d81662bac50", "git_parents": ["7d92295174c6cbbd84ae6b6c0ca13ee79d75a7ce"], "node": "1ea50ec508fbc410651a592c3c1aa280ffa9f9a3", "parents": ["9547fe76bc9c6e66422c8bde1d0264bc657f679f"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091363 - Create new deleteHistoryItemViaSearchXButtonTest regression UI test for the efficiency framework r=mobiletest-reviewers,aaronmt\n\nThe UI test successfully passed 25x on Firebase. [[https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=117539 | Try ]]\nAll efficiency UI tests successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=117538  | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341447\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SearchBarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/HistoryTest.kt"], "git_node": "1b3e377ada22a323b0b47a12159424b9b23a6d61", "git_parents": ["64bf0be265f7dbd36c0b171b2eee5d81662bac50"], "node": "0402d2938b074f948135d0adda62167aba9c149b", "parents": ["1ea50ec508fbc410651a592c3c1aa280ffa9f9a3"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083894 - Fix origin bounds in PushDB forEachOrigin. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335748\n", "files": ["build/pgo/certs/cert9.db", "build/pgo/certs/key4.db", "build/pgo/certs/mochitest.client", "build/pgo/server-locations.txt", "dom/push/PushDB.sys.mjs", "dom/push/PushServiceWebSocket.sys.mjs", "dom/push/test/file_pushsubscriptionchange_origin_prefix.html", "dom/push/test/mochitest.toml", "dom/push/test/test_pushsubscriptionchange_origin_prefix.html", "dom/push/test/worker.js"], "git_node": "a03572be3551eba3e0c271c7ea8f7c22ee19c2e0", "git_parents": ["1b3e377ada22a323b0b47a12159424b9b23a6d61"], "node": "befa48428b1e60e6bc71be4266cfcf41d8fcca8d", "parents": ["0402d2938b074f948135d0adda62167aba9c149b"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060699 - Match moz-box-group item corner radii to the group's outline. r=reusable-components-reviewers,desktop-theme-reviewers,jules\n\nBug 1998446 switched moz-box-group from a border to an outline but kept\n--box-border-radius-inner on the first and last items. Since an outline\ndoesn't inset the content, the items' 11px corners got clipped by the\ngroup's 12px overflow clip, making focus rings look thinner on the curves.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338148\n", "files": ["toolkit/content/tests/widgets/test_moz_box_group.html", "toolkit/content/widgets/moz-box-group/moz-box-group.css"], "git_node": "dcd6a8da3ca976600d018816d84bf0b96334acac", "git_parents": ["a03572be3551eba3e0c271c7ea8f7c22ee19c2e0"], "node": "f49f46533efac7cffac790cdfcec7fd156352175", "parents": ["befa48428b1e60e6bc71be4266cfcf41d8fcca8d"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1281115 - Part 1. Move FFmpegVideoDecoder image creation into CreateImageForFrame. r=media-playback-reviewers,azebrowski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342355\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h"], "git_node": "25dd0458572ce41df4a8a32edebe70d93a40e338", "git_parents": ["dcd6a8da3ca976600d018816d84bf0b96334acac"], "node": "b1ac42a80fa1135554bf6f2522056bd7861821c1", "parents": ["f49f46533efac7cffac790cdfcec7fd156352175"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1281115 - Part 2. Implement SetSeekThreshold in FFmpegVideoDecoder. r=media-playback-reviewers,azebrowski\n\nFFmpegVideoDecoder ignored the seek threshold, so every frame between the\nkeyframe and the seek target was turned into an image only to be dropped\nby the content process.\n\nFrames that end before the target are now released without creating an\nimage, which with libavcodec 58 and later also returns hardware surfaces\nand MediaCodec buffers to the decoder sooner. A frame that ends at the\ntarget is still output, so seeking to the end of the video track still has\na frame to show. Before libavcodec 58, a dropped frame is still reported as\ndecoded, so that a drain continues.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342356\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h"], "git_node": "e2c254f4b79aff891c284d22a1589ed92333ffa5", "git_parents": ["25dd0458572ce41df4a8a32edebe70d93a40e338"], "node": "900f8aca6e3430a617d52dd541c7d9bfa6e3e7ae", "parents": ["b1ac42a80fa1135554bf6f2522056bd7861821c1"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091343 - Rename stale_expected to stale_timestamp_error r=gbeckley,remote-settings-reviewers\n\n`stale_expected` sounds like stale was expected.\n\nHere we are reporting a stale timestamp error.\n\nThe `_error` suffix is also what we use to compute error rates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341364\n", "files": ["services/settings/UptakeTelemetry.sys.mjs", "services/settings/remote-settings.sys.mjs", "services/settings/test/unit/test_remote_settings_poll.js"], "git_node": "4341c31075592bfc96506b757297156fcfc4d896", "git_parents": ["e2c254f4b79aff891c284d22a1589ed92333ffa5"], "node": "2a1d3ff60f08f9907a72e54a73ff0e504998841e", "parents": ["900f8aca6e3430a617d52dd541c7d9bfa6e3e7ae"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090897 - Reset fullscreen state properly; r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341916\n", "files": ["dom/base/Document.cpp"], "git_node": "68062ebfdc4df509913f2e1251f7657e3b7170c6", "git_parents": ["4341c31075592bfc96506b757297156fcfc4d896"], "node": "cef89ffe6e50edfef8b5577e3810866525a0856b", "parents": ["2a1d3ff60f08f9907a72e54a73ff0e504998841e"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075504 - Distinguish chain-fetch failures from signature errors in telemetry r=gbeckley,remote-settings-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339207\n", "files": ["services/settings/RemoteSettingsClient.sys.mjs", "services/settings/metrics.yaml", "services/settings/test/unit/test_remote_settings.js", "services/settings/test/unit/test_remote_settings_signatures.js"], "git_node": "6886202f8bb7d9f0d4afc674128327659c45a816", "git_parents": ["68062ebfdc4df509913f2e1251f7657e3b7170c6"], "node": "f90af7d9b06aaac262698cd1c21e696f0212627b", "parents": ["cef89ffe6e50edfef8b5577e3810866525a0856b"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092493 - Don't match removed nodes against an empty ContentList. r=dom-core-reviewers,vhilla,smaug\n\nA list with no elements can't lose one, so the subtree walk in\nContentWillBeRemoved is only needed when the list has elements.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342516\n", "files": ["dom/base/ContentList.cpp"], "git_node": "e78f3dbf173e4b17664199d6fee91331ad8072f4", "git_parents": ["6886202f8bb7d9f0d4afc674128327659c45a816"], "node": "1eea5c74d1e0dc68f20b6588dbf486a26f46aa6c", "parents": ["f90af7d9b06aaac262698cd1c21e696f0212627b"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082922 - Pick up the minidump-writer remote transport panic fix r=crashreporting-reviewers,supply-chain-reviewers,afranchuk\n\nCherry pick of PR https://github.com/rust-minidump/minidump-writer/pull/248\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340429\n", "files": [".cargo/config.toml.in", "Cargo.lock", "supply-chain/audits.toml", "supply-chain/config.toml", "third_party/rust/process-backend/.cargo-checksum.json", "third_party/rust/process-backend/src/lib.rs", "third_party/rust/process-backend/src/remote/backend.rs", "third_party/rust/process-backend/tests/basic.rs", "toolkit/crashreporter/crash_helper_client/Cargo.toml", "toolkit/crashreporter/crash_helper_common/Cargo.toml", "toolkit/crashreporter/crash_helper_server/Cargo.toml", "toolkit/crashreporter/rust_minidump_writer_linux/Cargo.toml"], "git_node": "ee7dcb94e7c7637a61ff58036223369ce87bb968", "git_parents": ["e78f3dbf173e4b17664199d6fee91331ad8072f4"], "node": "0555b2d04fd404d74d5353b0f84ee29819836be0", "parents": ["1eea5c74d1e0dc68f20b6588dbf486a26f46aa6c"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082922 - Allow process_reader to read a process through the remote executor. r=crashreporting-reviewers,afranchuk\n\nSometimes on Linux we can't use the standard mechanism, and instead must\nuse the remote executor to read stuff off the crashed process, so we\nallow for that in our in-tree process_reader crate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339419\n", "files": ["Cargo.lock", "toolkit/crashreporter/process_reader/Cargo.toml", "toolkit/crashreporter/process_reader/src/error.rs", "toolkit/crashreporter/process_reader/src/lib.rs", "toolkit/crashreporter/process_reader/src/platform.rs", "toolkit/crashreporter/process_reader/src/platform/linux.rs", "toolkit/crashreporter/process_reader/src/platform/macos.rs", "toolkit/crashreporter/process_reader/src/platform/windows.rs"], "git_node": "fcd0da65a6d447da330870bed8d067ff21ad24c4", "git_parents": ["ee7dcb94e7c7637a61ff58036223369ce87bb968"], "node": "f58c00d967efa85502d89764e51864cce229558d", "parents": ["0555b2d04fd404d74d5353b0f84ee29819836be0"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082922 - mozannotation_server: add a remote reading annotation primitive r=crashreporting-reviewers,afranchuk\n\nExpose a new API to retrieve annotations through a remote executor\n(represented by a socket), rather than the standard process handle.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339420\n", "files": ["toolkit/crashreporter/mozannotation_server/src/lib.rs"], "git_node": "29f1fb674a93fdbc351b8a6bbc99b422c6902ba1", "git_parents": ["fcd0da65a6d447da330870bed8d067ff21ad24c4"], "node": "411bde13d267a417472cf47fa4a5bf8733ce78e5", "parents": ["f58c00d967efa85502d89764e51864cce229558d"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082922 - Have the remote executor serve multiple sessions r=crashreporting-reviewers,afranchuk\n\nOnce the minidump writer is done with its session, we want to keep the\nchannel open so that we can open a new session to read the process\nannotations as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339421\n", "files": ["toolkit/crashreporter/rust_minidump_writer_linux/src/lib.rs"], "git_node": "36ff9bdcd33d243d35e1136bb030e9cda941c314", "git_parents": ["29f1fb674a93fdbc351b8a6bbc99b422c6902ba1"], "node": "ffab1bd2531384e11d44f718f89d81da0d343550", "parents": ["411bde13d267a417472cf47fa4a5bf8733ce78e5"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082922 - Let callers of finalize_crash_report() retrieve the child annotations. r=crashreporting-reviewers,afranchuk\n\nIt's easier to get the necessary context to decide the method used to\ngather the annotations further up the call stack.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339422\n", "files": ["toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/windows.rs"], "git_node": "34ee244c4f1f0f3b962b492f14ce8f757955606b", "git_parents": ["36ff9bdcd33d243d35e1136bb030e9cda941c314"], "node": "bffab9581640c1a54c8e5eb919e2a1bf601e8c99", "parents": ["ffab1bd2531384e11d44f718f89d81da0d343550"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082922 - Wire through the remote executor to read annotations r=crashreporting-reviewers,geckoview-reviewers,afranchuk,ohall\n\nRather than taking ownership of the socket throughout, we duplicate it\nevery time we pass it to Rust code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339423\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/TestCrashHandler.java", "toolkit/crashreporter/breakpad-client/linux/crash_generation/client_info.h", "toolkit/crashreporter/breakpad-client/linux/crash_generation/crash_generation_server.cc", "toolkit/crashreporter/breakpad_wrapper/breakpad_wrapper.cpp", "toolkit/crashreporter/crash_helper_server/src/breakpad_crash_generator.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation/linux.rs", "toolkit/crashreporter/test/unit_ipc/test_content_remote_executor.js"], "git_node": "e2d56589eb3c71eadf2e10adf80fe74389659f27", "git_parents": ["34ee244c4f1f0f3b962b492f14ce8f757955606b"], "node": "2d6eb0fb10d2b582ff2921739cef9454f5e13c44", "parents": ["bffab9581640c1a54c8e5eb919e2a1bf601e8c99"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2088236 - Add Set to Default promo to built-in VPN settings - r=ip-protection-reviewers,settings-reviewers,desktop-theme-reviewers,tgiles,mcleinman\" for causing multiple failures\n\nThis reverts commit 64bf0be265f7dbd36c0b171b2eee5d81662bac50.\n", "files": ["browser/components/preferences/DefaultBrowserHelper.mjs", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection.js"], "git_node": "a86262f06ede3514f349fe426f1baf06eace3fed", "git_parents": ["e2d56589eb3c71eadf2e10adf80fe74389659f27"], "node": "80f10863f700c295a357c23cc8f8213b7bf28934", "parents": ["2d6eb0fb10d2b582ff2921739cef9454f5e13c44"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2088234 - Add Set to Default promo to locations subview - r=ip-protection-reviewers,fluent-reviewers,flod,mcleinman\" for causing multiple failures\n\nThis reverts commit 7d92295174c6cbbd84ae6b6c0ca13ee79d75a7ce.\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/assets/location-pin.svg", "browser/components/ipprotection/content/ipprotection-constants.mjs", "browser/components/ipprotection/content/ipprotection-locations.mjs", "browser/components/ipprotection/content/locations-subview.css", "browser/components/ipprotection/tests/browser/browser_ipprotection_location_selector_telemetry.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_locations_keyboard_navigation.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_locations_list.js", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "d58842133df9c6bb0103f8f3b014a6647565baf8", "git_parents": ["a86262f06ede3514f349fe426f1baf06eace3fed"], "node": "56292065bce51f51b7ce5b688065c9d5bb738107", "parents": ["80f10863f700c295a357c23cc8f8213b7bf28934"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090829: Use quadratic probing instead of double-hashing in mozilla::HashTable r=sergesanspaille\n\nIn our existing implementation, based on Knuth, we produce a 32-bit hash number, then take enough of the most significant bits to index into a power-of-two sized table. (Our hash function does a better job with the most significant bits.) On collision, we take the remaining bits from the hash number and use them to derive a fixed stride (forcing the low bit to be set to ensure that the stride isn't 0 and is co-prime with a power of 2). Then we test slots at that stride until we find an empty one. Double-hashing is good at minimizing the total number of collisions, but because it scatters the probe sequence randomly, it doesn't have great cache locality.\n\nOne alternative is quadratic probing, which uses a fixed sequence of increasing strides (given an initial slot h1, try h1+0, h1+1, h1+3, h1+6, h1+10, and so on). This has a few more collisions than double-hashing (because if two values map to the same initial slot, the entire probing sequence will be shared), but touches fewer cache lines. Presumably for this reason, SwissTable / hashbrown use quadratic probing. In particular, using triangular numbers (1,3,6,10,15,...) in a power-of-2 table has the nice property that it probes every slot exactly once.\n\nThis is about a 0.4% improvement in SP3 overall, so the improved cache locality wins out over the risk of a few more collisions.\n\nNote that we inline an implementation of this in jitcode. I add a comment here, but the jitcode changes are split into the next patch for review purposes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341629\n", "files": ["mfbt/HashTable.h"], "git_node": "67c79f8599e129e8d85cc9e53b0edcf7f7bea6ed", "git_parents": ["d58842133df9c6bb0103f8f3b014a6647565baf8"], "node": "a48bef37bff18a9969ef02d2a7db77c0d9ab6c04", "parents": ["56292065bce51f51b7ce5b688065c9d5bb738107"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090829: Use quadratic probing instead of double-hashing in jitcode r=jandem\n\nThis updates the inlined jitcode implementation to match the changes to the C++ implementation in the previous patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341630\n", "files": ["js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "mfbt/HashTable.h"], "git_node": "e0ebd3dc5a40eb8b364c5b3681ec5bcb2c268f5a", "git_parents": ["67c79f8599e129e8d85cc9e53b0edcf7f7bea6ed"], "node": "a18db3541781666769a281bb844bc085fb9155ba", "parents": ["a48bef37bff18a9969ef02d2a7db77c0d9ab6c04"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058167 - Ensure tab group collapsed tab count label is always centered r=desktop-theme-reviewers,tabbrowser-reviewers,sthompson,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338818\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "ea800026502e5731719d30c6fc1c542d988cc6d4", "git_parents": ["e0ebd3dc5a40eb8b364c5b3681ec5bcb2c268f5a"], "node": "5d9dd1cddab4de0a1cffb83c905a2d143ce530be", "parents": ["a18db3541781666769a281bb844bc085fb9155ba"], "tags": []}, {"author": "John Oberhauser \u003cj.git@obez.io\u003e", "branch": "default", "desc": "Bug 2086244 - Update the Terms of Use published date and only use it once that date has passed r=android-reviewers,devota,cpeterson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337714\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/termsofuse/TermsOfUseVersion.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/termsofuse/store/PrivacyNoticeBannerRepository.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/termsofuse/store/PrivacyNoticeBannerRepositoryTest.kt"], "git_node": "0d62bc1ba73ba1f93b6d5328f2b49e0ba6f99e6a", "git_parents": ["ea800026502e5731719d30c6fc1c542d988cc6d4"], "node": "38e4fbc3d4db3b2fee6d30192772310d77d4266b", "parents": ["5d9dd1cddab4de0a1cffb83c905a2d143ce530be"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081824 - [devtools] Add themes to the new settings panel r=devtools-reviewers,fluent-reviewers,bolsson,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337582\n", "files": ["devtools/client/locales-preview/settings.ftl", "devtools/client/settings/components/devtools-settings-pref.mjs", "devtools/client/settings/components/devtools-settings-theme.mjs", "devtools/client/settings/components/devtools-settings-theme.tagmap.d.ts", "devtools/client/settings/components/moz.build", "devtools/client/settings/index.html", "devtools/client/settings/inventory.mjs", "devtools/client/settings/panel.mjs", "devtools/client/settings/test/browser/browser.toml", "devtools/client/settings/test/browser/browser_settings_themes.js"], "git_node": "bff489c8aa740b819cd4cca9586307c8268f66f6", "git_parents": ["0d62bc1ba73ba1f93b6d5328f2b49e0ba6f99e6a"], "node": "bdc458e7754ca70259a5e2329a4e07750e27ab99", "parents": ["38e4fbc3d4db3b2fee6d30192772310d77d4266b"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081846 - [devtools] Add the network body size limit to the new settings panel r=devtools-reviewers,fluent-reviewers,bolsson,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337583\n", "files": ["devtools/client/locales-preview/settings.ftl", "devtools/client/settings/components/devtools-settings-body-limit.css", "devtools/client/settings/components/devtools-settings-body-limit.mjs", "devtools/client/settings/components/devtools-settings-body-limit.tagmap.d.ts", "devtools/client/settings/components/moz.build", "devtools/client/settings/index.html", "devtools/client/settings/inventory.mjs", "devtools/client/settings/test/browser/browser.toml", "devtools/client/settings/test/browser/browser_settings_netmonitor_body_limit.js", "tools/lint/fluent-lint/exclusions.yml"], "git_node": "25345c2472928a1eab72a17b3ff178eb42d1b55b", "git_parents": ["bff489c8aa740b819cd4cca9586307c8268f66f6"], "node": "698952487a312fac22f6cbaf0abb628378094aae", "parents": ["bdc458e7754ca70259a5e2329a4e07750e27ab99"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081863 - [devtools] Add the additional tools section to the new settings panel r=devtools-reviewers,fluent-reviewers,nchevobbe,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337784\n", "files": ["devtools/client/locales-preview/settings.ftl", "devtools/client/settings/components/devtools-settings.mjs", "devtools/client/settings/inventory.mjs", "devtools/client/settings/panel.mjs", "devtools/client/settings/test/browser/browser.toml", "devtools/client/settings/test/browser/browser_settings_additional_tools.js", "devtools/client/settings/types/inventory.d.ts"], "git_node": "4f7a38d818e6ac1bca38ec5233135ce6fb0a28fd", "git_parents": ["25345c2472928a1eab72a17b3ff178eb42d1b55b"], "node": "01756c285ba727b51f9b9984a2a125bc5a34513f", "parents": ["698952487a312fac22f6cbaf0abb628378094aae"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087449 - Add a TypeScript declaration for Iterator.concat r=Standard8\n\nCopied from https://github.com/microsoft/TypeScript/blob/0b0aeb31e416c280bcbef7d7734aa21e7d999cdd/tsc/internal/bundled/libs/lib.es2026.iterator.d.ts#L19\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338281\n", "files": ["devtools/client/settings/inventory.mjs", "tools/@types/lib.gecko.esnext.d.ts"], "git_node": "2ff3850524492fb92ac246b5ac92d728312256d0", "git_parents": ["4f7a38d818e6ac1bca38ec5233135ce6fb0a28fd"], "node": "f8abab0f4eefc0c7335abb4eee0acd16f0dada77", "parents": ["01756c285ba727b51f9b9984a2a125bc5a34513f"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975092 - wait for menu and label in browser_chat_page to avoid timeouts r=yjamora\n\navoid frequent test_tab_menu_has_label_and_separator failures, context-menu timeouts, verify issues\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341057\n", "files": ["browser/components/genai/tests/browser/browser.toml", "browser/components/genai/tests/browser/browser_chat_page.js"], "git_node": "bfcb341d3e2ea447329a7f4c6e9e1b1d99216394", "git_parents": ["2ff3850524492fb92ac246b5ac92d728312256d0"], "node": "efb40bc6df677e00b8c61e942936a8faff37adb1", "parents": ["f8abab0f4eefc0c7335abb4eee0acd16f0dada77"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2004437 - restore the prompt for browser_chat_request to avoid racing the auto-submit observer r=yjamora\n\nbetter handle submit in file_chat-autosubmit.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341640\n", "files": ["browser/components/genai/tests/browser/file_chat-autosubmit.html"], "git_node": "89021a79cf23666170979c46dcea1389c72e4d29", "git_parents": ["bfcb341d3e2ea447329a7f4c6e9e1b1d99216394"], "node": "efa1c741519cadab2f6c160949b698bacad2aa33", "parents": ["efb40bc6df677e00b8c61e942936a8faff37adb1"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092511 - Convert verifyShowVoiceSearchToggleTest regression UI test to the efficiency framework r=mobiletest-reviewers,aaronmt\n\nUpdated the legacy test as well to match the recently updated manual test.\n\nThe new UI test successfully passed 50x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=119276  | Try ]]\nAll efficiency UI tests successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&revision=18e327534d6e75e20969f3bd6956809821ad7be7 | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342559\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsSearchTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsSearchTest.kt"], "git_node": "bbe0dbe21f1548de22322e78b092b8c7ba713caf", "git_parents": ["89021a79cf23666170979c46dcea1389c72e4d29"], "node": "d649648202cebe318df9e024b6ca80b7bb138ee0", "parents": ["efa1c741519cadab2f6c160949b698bacad2aa33"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Factor hash algorithm/value parsing out of nsCSPParser::hashSource(); r=tschuster\n\nMove the parsing of `hash-algorithm \"-\" base64-value` into a static\nExtractAlgorithmAndHash() helper, so it can be shared with the upcoming\nurl-hash-source parsing.\n\nNo functional change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337046\n", "files": ["dom/security/nsCSPParser.cpp"], "git_node": "f97045ec8fa8783a47c1e640dd1a0dc412b0b854", "git_parents": ["bbe0dbe21f1548de22322e78b092b8c7ba713caf"], "node": "afefcb950f9f47c254aa1a546d7a1e8ba2dd079c", "parents": ["d649648202cebe318df9e024b6ca80b7bb138ee0"], "tags": []}, {"author": "John Oberhauser \u003cj.git@obez.io\u003e", "branch": "default", "desc": "Bug 2081839 - Require profile authentication to manage credit cards on Android Automotive OS r=twhite\n\n**Part 1:** On Android Automotive OS with the `automotive-sensitive-data` Nimbus feature enabled, credit card management now uses the `AutomotiveSensitiveDataAuthenticator` check from bug 2081834 instead of the once-only payment methods setup prompt. Cancelling the setup prompt or failing authentication keeps credit card management closed. Other devices are unchanged.\n\n**Part 2:** On the Compose Autofill settings screen (`enableComposeAutofillSettings`), \"Manage cards\" now goes through the same `verifyCredentialsOrShowSetupWarning` check as the classic screen; before, it opened credit card management without any authentication on every device. This also fixes the screen so the item can be reached and tapped: it now scrolls, no longer adds the bottom system bar inset twice, and passes the click handler as `onClick` instead of `onIconClick`.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/436\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/autofill/AutofillSettingFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/autofill/ui/AutofillSettingsScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/biometric/BiometricPromptPreferenceFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/autofill/AutofillSettingFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/biometric/BiometricPromptPreferenceFragmentTest.kt"], "git_node": "574dab78b78680f01623cd3b12ca4f1109ba1f73", "git_parents": ["f97045ec8fa8783a47c1e640dd1a0dc412b0b854"], "node": "d6c5b07d350e4d8e002a751bc0a02e5647ded83c", "parents": ["afefcb950f9f47c254aa1a546d7a1e8ba2dd079c"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083208 - Add browser first hosts (ie Youtube) into app links handling r=android-reviewers,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340431\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/applinks/BrowserFirstHosts.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Services.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/OpenLinksInAppsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/BaseBrowserFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/applinks/BrowserFirstHostsTest.kt"], "git_node": "bd70cbdde2568e62ab1377a49d0fb747524d6658", "git_parents": ["574dab78b78680f01623cd3b12ca4f1109ba1f73"], "node": "c7e7f51c5f0cbc6b70a15bb3edf78f4a0a13a8f9", "parents": ["d6c5b07d350e4d