xbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 127dce3ac830d68df8479b5f32c9d2430363dba2 with FIREFOX_161_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "4d2cb3c40daa5b842165593b1c291aa98359c0c9", "git_parents": ["f777df8cc22c70093af01af364f6587b0094234b"], "node": "cbd04023d9582b850ddce9d874e8cc776f2e9142", "parents": ["f23f859a5df5fe9fcf7d0f1c62ebea55f89f76b4"], "tags": []}], "date": 1793901476, "git_changesets": ["4d2cb3c40daa5b842165593b1c291aa98359c0c9"], "user": "ffxbld@lando.moz.tools"}, "45729": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 127dce3ac830d68df8479b5f32c9d2430363dba2 with DEVEDITION_161_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "85a4a2743991ff5f261d2a21c84a259a21e1f11b", "git_parents": ["4d2cb3c40daa5b842165593b1c291aa98359c0c9"], "node": "1450c3bd2059ee66df8af960606fac28e9466b39", "parents": ["cbd04023d9582b850ddce9d874e8cc776f2e9142"], "tags": []}], "date": 1793901548, "git_changesets": ["85a4a2743991ff5f261d2a21c84a259a21e1f11b"], "user": "ffxbld@lando.moz.tools"}, "45730": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 127dce3ac830d68df8479b5f32c9d2430363dba2 with FIREFOX-ANDROID_161_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "228a125bc7a9995c1678e07c9271ed93e8aefa39", "git_parents": ["85a4a2743991ff5f261d2a21c84a259a21e1f11b"], "node": "dbf1e6a2fc179048e18274c3e137526c5d83bc01", "parents": ["1450c3bd2059ee66df8af960606fac28e9466b39"], "tags": []}], "date": 1793901606, "git_changesets": ["228a125bc7a9995c1678e07c9271ed93e8aefa39"], "user": "ffxbld@lando.moz.tools"}, "45731": {"changesets": [{"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088862 - Show the animated kit illustration on the Terms of Use onboarding page in Nightly and debug builds. r=corentin\n\nThe animation plays once and replays when tapped, so `AnimatedIllustration` gains `replayOnClick`. The static fallback is the animation's first frame rendered as a vector, so loading and reduced motion show the same pose with no visible jump.\n\nThe Lottie JSON is the motion kit hero export rewritten for Lottie Android, which ignores the track matte parent key (tp) and drops the final value after a hold keyframe. Shared mattes were duplicated next to each matted layer, layer indices renumbered, and terminal keyframes after holds marked as holds. It renders identically in lottie-web.\n\n**Reviewer notes**: To test in debug, enable the `FeatureFlag`  `val onboardingFeatureEnabled = Config.channel.isDebug` and have fresh install.\n\nDemo\n\nhttps://github.com/user-attachments/assets/22ba5841-da13-41fd-be7a-067795ad2ae4\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/430\n", "files": ["mobile/android/android-components/components/ui/animation/src/main/java/mozilla/components/ui/animation/AnimatedIllustration.kt", "mobile/android/android-components/components/ui/animation/src/test/java/mozilla/components/ui/animation/AnimatedIllustrationTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FeatureFlags.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/TermsOfServiceOnboardingPage.kt", "mobile/android/fenix/app/src/main/res/drawable/terms_of_use_hero.xml", "mobile/android/fenix/app/src/main/res/raw/terms_of_use_hero_animation.json"], "git_node": "5d6c8135dc1bc4e61fcc3380b604663559b49d10", "git_parents": ["0541b854c2810a076ff3d55df54717e3708b3f8f"], "node": "f83f1e12b855bacfc98c086368c774a1d7490150", "parents": ["d6c20876386eeb31d93be40c15bf58ded75a4a25"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088944 - Keep tsconfig.json errors in the program that the checkRootOnly TypeScript plugin rebuilds. r=frontend-codestyle-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339575\n", "files": ["tools/ts/plugins/checkRootOnly.js"], "git_node": "ff1aa08a00909b24d86649994ddf2b0127dd7d61", "git_parents": ["5d6c8135dc1bc4e61fcc3380b604663559b49d10"], "node": "f458c0a9547c133882be5032ebff198b27a6baae", "parents": ["f83f1e12b855bacfc98c086368c774a1d7490150"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089530 - Keep existing subframes from inheriting parent load types. r=avandolder,dom-core-reviewers\n\nPreserve the existing-frame early return when history behavior is set so later iframe navigations do not inherit stale reload flags.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339919\n", "files": ["docshell/base/nsDocShell.cpp", "testing/web-platform/mozilla/tests/html/browsers/browsing-the-web/navigating-across-documents/iframe-navigation-after-hard-reload.html"], "git_node": "edd99989fc8fdeae72c829c55b977a2399f3f351", "git_parents": ["ff1aa08a00909b24d86649994ddf2b0127dd7d61"], "node": "6cfe82c1301710dd3b4170429def2542965dc50b", "parents": ["f458c0a9547c133882be5032ebff198b27a6baae"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088056 - Show the full tracker count animation on the first load of restored tabs and tabs loaded before the tracker count was enabled. r=urlbar-reviewers,Standard8,timhuang\n\nSwitching to a pending restored tab set the current URI before its document\nloaded, so the restore load was treated as a same-site navigation. The site a\ntab's tracker count showed a visit to is now tracked per tab instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338942\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/controlcenter/TrustPanelTrackerLogs.sys.mjs", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js"], "git_node": "b2be9e4a20a2452e770c4337bc6047a7dc7fe4e8", "git_parents": ["edd99989fc8fdeae72c829c55b977a2399f3f351"], "node": "d19e95eb2e3968a097d9cba95f08e003ba181745", "parents": ["6cfe82c1301710dd3b4170429def2542965dc50b"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033465 - remove login tp6/tp6m sites r=perftest-reviewers,sparky\n\nThis is phase 2, removing pageload sites that require a logged in\naccount. These need test accounts to record, go stale as sessions\nexpire or accounts get locked, and alerts on them have rarely led\nto a fix.\n\n* facebook, google-mail, instagram, linkedin, netflix, office,\n  outlook, paypal, pinterest, tumblr, yahoo-mail (tp6 desktop)\n* instagram (tp6 mobile)\n\ntwitter and google-search are exempt for now since they play back\nlogged out and are effectively public pages. Those and the remaining\nsites get a closer look in phase 3.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333813\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "taskcluster/kinds/browsertime/mobile.yml", "testing/perfdocs/generated/raptor-metrics.md", "testing/perfdocs/generated/raptor.md", "testing/performance/pageload_sites.json", "testing/raptor/browsertime/pageload_sites.json", "testing/raptor/raptor/perfdocs/config.yml", "testing/raptor/raptor/tests/tp6/desktop/browsertime-tp6.toml", "testing/raptor/raptor/tests/tp6/mobile/browsertime-tp6m.toml", "testing/raptor/raptor/tooltool-manifests/playback/mitm11-windows-firefox-facebook.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm5-linux-firefox-google-mail.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm5-linux-firefox-live.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm5-linux-firefox-paypal.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm5-linux-firefox-yahoo-mail.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm6-linux-firefox-facebook.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm6-linux-firefox-linkedin.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm6-linux-firefox-netflix.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm6-linux-firefox-pinterest.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm6-linux-firefox-tumblr.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm7-linux-firefox-office.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm8-android-gve-instagram.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm8-darwin-firefox-instagram.manifest"], "git_node": "9b8f19d8e1254f924fafa86050425bc6f160bd55", "git_parents": ["b2be9e4a20a2452e770c4337bc6047a7dc7fe4e8"], "node": "a6778bab73086eb94ff2c81b0242e5fb07db0887", "parents": ["d19e95eb2e3968a097d9cba95f08e003ba181745"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062084 - Return to the app after signing in through a custom tab when Open links in apps is Never. r=android-reviewers,tthibaud\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338915\n", "files": ["mobile/android/android-components/components/feature/app-links/src/main/java/mozilla/components/feature/app/links/AppLinksInterceptor.kt", "mobile/android/android-components/components/feature/app-links/src/test/java/mozilla/components/feature/app/links/AppLinksInterceptorTest.kt"], "git_node": "c22a37862290989b28c3f19285b36124e40f4104", "git_parents": ["9b8f19d8e1254f924fafa86050425bc6f160bd55"], "node": "99481a91889da7233c79c1519b11398ea2ec6d46", "parents": ["a6778bab73086eb94ff2c81b0242e5fb07db0887"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089013 - Skip the card stack needsAwait QR code test on Firefox versions without SHOW_QR_CODE. r=nbarrett\n\nSHOW_QR_CODE is only available from 161 onwards, so the tests for browser_asrouter_newtab_card_stack that\nuse it (which are also run in the trainhop CI jobs that test against Beta and Release) need to be tweaked\nto only run on 161 onwards.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339788\n", "files": ["browser/components/asrouter/tests/browser/browser_asrouter_newtab_card_stack.js"], "git_node": "e2f1f1a54791b70bd87c12caec1886b5659822b0", "git_parents": ["c22a37862290989b28c3f19285b36124e40f4104"], "node": "2622039eed369a55151344a768038df6f5571a08", "parents": ["99481a91889da7233c79c1519b11398ea2ec6d46"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2089025 - Generate the per-script interpreter entry trampoline when the JitScript is created. r=denispal\n\nWithout fix: https://share.firefox.dev/4z0q0Pq\nWith fix: https://share.firefox.dev/4BYrM6m\n\nThe trampoline was only generated when a script entered the Baseline\nInterpreter through CanEnterBaselineInterpreter. This means we wouldn't\nget it whenever the JitScript was created earlier, e.g. from JIT hints,\nor by the Baseline compiler.\n\nThis fixes that and makes our ETW profiles much more useful.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339667\n", "files": ["js/src/jit-test/tests/baseline/interpreter-entry-eager-jitscript.js", "js/src/jit/BaselineJIT.cpp", "js/src/jit/InterpreterEntryTrampoline.cpp", "js/src/jit/JitScript.cpp", "js/src/jit/JitZone.h", "js/src/vm/Interpreter.cpp", "js/src/vm/JSScript.cpp"], "git_node": "a58a2016edbb4197853a094045b802c20c37fa4b", "git_parents": ["e2f1f1a54791b70bd87c12caec1886b5659822b0"], "node": "74bb2883f9bc2de453cc1631292782a84bd34db8", "parents": ["2622039eed369a55151344a768038df6f5571a08"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 1998954 - Use new push/replace path for frames. r=dom-core-reviewers,farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D271774\n", "files": ["dom/base/nsFrameLoader.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/navigation-api/__dir__.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-to-srcdoc.html.ini", "testing/web-platform/meta/navigation-api/navigation-history-entry/entries-after-blank-navigation.html.ini", "testing/web-platform/meta/navigation-api/navigation-history-entry/entries-after-blob-navigation.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/traverseTo-navigates-multiple-iframes.html.ini"], "git_node": "c4659d8f38239dc73fe73f09b96de3e1dd614130", "git_parents": ["a58a2016edbb4197853a094045b802c20c37fa4b"], "node": "efdbe86186f76e24705669348f8c6e6afb58404b", "parents": ["74bb2883f9bc2de453cc1631292782a84bd34db8"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071335 - Tab group strip plus button opens a new HNT r=android-reviewers,android-tabs-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338897\n", "files": ["mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/TabDataCoordinator.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/repository/TabRepository.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/test/java/mozilla/components/feature/tabdata/coordinator/DefaultTabDataCoordinatorTest.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/test/java/mozilla/components/feature/tabdata/coordinator/fakes/FakeTabRepository.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/testFixtures/java/mozilla/components/feature/tabdata/coordinator/fakes/FakeTabDataCoordinator.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/tabs/DefaultTabRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/TabGroupsStrip.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/SelectedTabNavigation.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/TabGroupsStripContent.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/TabGroupsStripScrollViewModel.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripTelemetryMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/tabs/DefaultTabRepositoryTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/TabGroupsStripTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/strip/SelectedTabNavigationTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/strip/TabGroupsStripContentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripTelemetryMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddlewareTest.kt"], "git_node": "fbdad4808da83ee8cf033d2e1e5602422e2568c2", "git_parents": ["c4659d8f38239dc73fe73f09b96de3e1dd614130"], "node": "1fade594568d32513492cd8a80c0f9fb16baf926", "parents": ["efdbe86186f76e24705669348f8c6e6afb58404b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080288 - Declare the image property of tab elements for TypeScript. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332640\n", "files": ["tools/@types/lib.gecko.augmentations.d.ts"], "git_node": "e58cd11300c41d24e375c9af95a58e905c70da68", "git_parents": ["fbdad4808da83ee8cf033d2e1e5602422e2568c2"], "node": "afb631433f3c74238e51fe78ac8bc3cb4c76df96", "parents": ["1fade594568d32513492cd8a80c0f9fb16baf926"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080288 - Type the split view footer's tab and fragment. r=tabbrowser-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332641\n", "files": ["browser/components/tabbrowser/content/split-view-footer.js"], "git_node": "9eaf2f2a88a1e9733d02415dccebeb1925d28434", "git_parents": ["e58cd11300c41d24e375c9af95a58e905c70da68"], "node": "b269db1cd652b9ba0b821ee9fbdb61d01d7f51b6", "parents": ["afb631433f3c74238e51fe78ac8bc3cb4c76df96"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080288 - Rename the split view footer script to .mjs (no functional change). r=tabbrowser-reviewers,kcochrane\n\nThe file goes on the tsconfig exclude list until it becomes a module: it reads BrowserUtils as a window global, which TypeScript does not declare, and it cannot import it under that name while browser-main.js still loads it as a script.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332642\n", "files": ["browser/base/content/browser-main.js", "browser/components/tabbrowser/content/split-view-footer.js", "browser/components/tabbrowser/content/split-view-footer.mjs", "browser/components/tabbrowser/jar.mn", "browser/components/tabbrowser/tsconfig.json"], "git_node": "0cebb2aa9b6e4173be67af66c2be6846cde07ed1", "git_parents": ["9eaf2f2a88a1e9733d02415dccebeb1925d28434"], "node": "6bbf24b0705f6161449662eea7d1215688e5d5c7", "parents": ["b269db1cd652b9ba0b821ee9fbdb61d01d7f51b6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080287 - Declare the browser window's openTrustedLinkIn for TypeScript. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332643\n", "files": ["tools/@types/browser-window-globals.d.ts", "tools/@types/browser-window.d.ts"], "git_node": "4af903c06820c6775483104546a1daf0202d3abb", "git_parents": ["0cebb2aa9b6e4173be67af66c2be6846cde07ed1"], "node": "dcd0b521fbdeb445b01ce54e0dd1c914095ea868", "parents": ["6bbf24b0705f6161449662eea7d1215688e5d5c7"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080287 - Load ContentSharingUtils through the tab group menu's lazy module getters. r=tabbrowser-reviewers,kcochrane\n\nA local ContentSharingUtils binding would shadow the window's global of that name under no-shadow once the file is renamed to .mjs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332644\n", "files": ["browser/components/tabbrowser/content/tabgroup-menu.js"], "git_node": "5c0d00b59b66a60cbcceed4f1ecf8e860a69de53", "git_parents": ["4af903c06820c6775483104546a1daf0202d3abb"], "node": "ba9acc1d41b8a9e1dfd07bd8488135c4b129c5b6", "parents": ["dcd0b521fbdeb445b01ce54e0dd1c914095ea868"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080287 - Type the tab group menu's preference getters, panel, buttons and suggestion checkbox. r=tabbrowser-reviewers,kcochrane\n\nBehavior-neutral: every `activeGroup` assignment passes a group or null, `#createRow` never read the index it was passed, and the suggestion checkbox's `change` listener reads the checkbox it was added to rather than `e.target`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332645\n", "files": ["browser/components/tabbrowser/content/tabgroup-menu.js", "browser/components/tabbrowser/types/elements.ts"], "git_node": "8b5928a14dbd529087ff48300a953062c7845082", "git_parents": ["5c0d00b59b66a60cbcceed4f1ecf8e860a69de53"], "node": "9b9acd6edd53cf261013b81b196254f0590c3c43", "parents": ["ba9acc1d41b8a9e1dfd07bd8488135c4b129c5b6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080287 - Rename the tab group menu script to .mjs (no functional change). r=tabbrowser-reviewers,kcochrane\n\nThe file goes on the tsconfig exclude list until it becomes a module: it reads XPCOMUtils and other system modules as window globals, which TypeScript does not declare, and it cannot import them under those names while browser-main.js still loads it as a script.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332646\n", "files": ["browser/base/content/browser-main.js", "browser/components/tabbrowser/content/tabgroup-menu.js", "browser/components/tabbrowser/content/tabgroup-menu.mjs", "browser/components/tabbrowser/jar.mn", "browser/components/tabbrowser/moz.build", "browser/components/tabbrowser/test/browser/smarttabgrouping/performance/browser_smart_tab_grouping_perf.js", "browser/components/tabbrowser/tsconfig.json"], "git_node": "0e064a0f3eb941be0ac39df9b9b2b7e73e9361aa", "git_parents": ["8b5928a14dbd529087ff48300a953062c7845082"], "node": "31f51460221bee7566a4390d97ca1c5f53554911", "parents": ["9b9acd6edd53cf261013b81b196254f0590c3c43"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080286 - Rename the tab drag and drop script to .mjs (no functional change). r=tabbrowser-reviewers,kcochrane\n\nThe .mjs extension turns on no-shadow with builtinGlobals, so locals named after window globals (screen, top, screenX, screenY, SidebarController) are renamed, and the local Tabbrowser import is dropped in favor of the window's Tabbrowser, which is the same module.\n\nThe file joins the tsconfig exclude list: tsc reports 93 errors in it once content/*.mjs matches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332647\n", "files": ["browser/base/content/browser-main.js", "browser/base/content/test/browser-performance/browser_tabdetach.js", "browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/content/drag-and-drop.mjs", "browser/components/tabbrowser/jar.mn", "browser/components/tabbrowser/tsconfig.json"], "git_node": "88640ae9d4a6bf96feefd7f88e9dcd22b9d009ee", "git_parents": ["0e064a0f3eb941be0ac39df9b9b2b7e73e9361aa"], "node": "46aa294bd2b62203ff8388cf0ea0f2c5938ceb09", "parents": ["31f51460221bee7566a4390d97ca1c5f53554911"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080403 - Load the tabbrowser window scripts renamed to .mjs as modules. r=tabbrowser-reviewers,kcochrane\n\nDropping each block, exporting the class and loading the file with importESModule can't be split: once a block is gone, the loadSubScript line hands the file's own top-level names back to it as globals. `git diff -w` shows the actual change, plus lines prettier re-joined.\n\nLike tab.mjs and tabs.mjs, the modules import the system modules they read off the window through XPCOMUtils.declareLazy and list the window scripts' globals in a `/* global */` comment, which takes split-view-footer.mjs and tabgroup-menu.mjs off the tsconfig exclude list. tabs.mjs imports TabDragAndDrop, which loads drag-and-drop.mjs, so browser-main.js no longer loads it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332648\n", "files": ["browser/base/content/browser-main.js", "browser/components/tabbrowser/content/drag-and-drop.mjs", "browser/components/tabbrowser/content/split-view-footer.mjs", "browser/components/tabbrowser/content/tabgroup-menu.mjs", "browser/components/tabbrowser/content/tabnote-menu.mjs", "browser/components/tabbrowser/content/tabs.mjs", "browser/components/tabbrowser/tsconfig.json", "tools/@types/generated/tspaths.json"], "git_node": "1505b21466517101808bf6db4a66985555d6e433", "git_parents": ["88640ae9d4a6bf96feefd7f88e9dcd22b9d009ee"], "node": "0347c067912632eed2c7e594b1b6b718263d6e37", "parents": ["46aa294bd2b62203ff8388cf0ea0f2c5938ceb09"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071335 - Tab group strip plus button opens a new HNT r=android-reviewers,android-tabs-reviewers,007\" for causing fenix failures\n\nThis reverts commit fbdad4808da83ee8cf033d2e1e5602422e2568c2.\n", "files": ["mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/TabDataCoordinator.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/repository/TabRepository.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/test/java/mozilla/components/feature/tabdata/coordinator/DefaultTabDataCoordinatorTest.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/test/java/mozilla/components/feature/tabdata/coordinator/fakes/FakeTabRepository.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/testFixtures/java/mozilla/components/feature/tabdata/coordinator/fakes/FakeTabDataCoordinator.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/tabs/DefaultTabRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/o