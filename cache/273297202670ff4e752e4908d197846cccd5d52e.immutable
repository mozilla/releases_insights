ing/web-platform/mozilla/tests/css/css-overflow/scrollbar-gutter-reflow-counts-001.html"], "git_node": "f0805adff32948e1c1a79de0aadeebc05caf6c46", "git_parents": ["8832a8b0485146494ad20936c0624a2f6d463786"], "node": "3bb4c763e7990a46c61384030ac6b07932750209", "parents": ["eacadc243bcfd0ae61e11cd105f57893543680b3"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068648 - Test that fetch from object is filtered. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323978\n", "files": ["testing/web-platform/mozilla/tests/fetch/orb/tentative/nested-in-object-or-embed.sub.html", "testing/web-platform/mozilla/tests/fetch/orb/tentative/resources/nested-document-fetch.html"], "git_node": "9efe7568d1e44109d14602d4505e0f5f915ef562", "git_parents": ["f0805adff32948e1c1a79de0aadeebc05caf6c46"], "node": "d4717489f7ec3b70393ecc73b27c1e363da81888", "parents": ["3bb4c763e7990a46c61384030ac6b07932750209"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2094935 - Propagate GL pixel readback failures from GLReadTexImageHelper r=gfx-reviewers,lsalzman\n\nReturn a bool from ReadPixelsIntoBuffer() and ReadPixelsIntoDataSurface() to report failures in GL context activation, surface allocation or mapping, glReadPixels(), and pixel format conversion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344161\n", "files": ["gfx/gl/GLReadTexImageHelper.cpp", "gfx/gl/GLReadTexImageHelper.h"], "git_node": "ad65b96bcb4b517c2856fa371bfb842867bed464", "git_parents": ["9efe7568d1e44109d14602d4505e0f5f915ef562"], "node": "1b4814f74f13e33c8057dfb48ade18c6c3a619e4", "parents": ["d4717489f7ec3b70393ecc73b27c1e363da81888"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094800 - Update metadata for html/canvas/element/manual/draw-element-image/moved-webgl-canvas.tentative.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344250\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/moved-webgl-canvas.tentative.html.ini"], "git_node": "ae075c8fc88dc6c40cf3e2f395cb9307b4c6f37c", "git_parents": ["ad65b96bcb4b517c2856fa371bfb842867bed464"], "node": "77dc20379b2cab8b70619c7822045278f6ce6add", "parents": ["1b4814f74f13e33c8057dfb48ade18c6c3a619e4"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094668 - Update metadata for clipboard-apis/clipboard-copy-selection-line-break.https.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344251\n", "files": ["testing/web-platform/meta/clipboard-apis/clipboard-copy-selection-line-break.https.html.ini"], "git_node": "a725759a98001d03c48204093f02a35ca0d914fb", "git_parents": ["ae075c8fc88dc6c40cf3e2f395cb9307b4c6f37c"], "node": "e073a63efd1f4e61d65d05f3e9cd156f521af6a3", "parents": ["77dc20379b2cab8b70619c7822045278f6ce6add"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094732 - Update metadata for encrypted-media/drm-mp4-playback-temporary-playduration-keystatus.https.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344252\n", "files": ["testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-playduration-keystatus.https.html.ini"], "git_node": "43bfdb0f7be7b451b709bff4fcfcd67c80ca40e4", "git_parents": ["a725759a98001d03c48204093f02a35ca0d914fb"], "node": "a3d50b8d7ee4a35cc8222a57c233c838a68aeb22", "parents": ["e073a63efd1f4e61d65d05f3e9cd156f521af6a3"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094871 - part 1: move the Smart Form Fill source tabs and flow telemetry out of SmartFormFillParent r=omarg\n\nSmartFormFillSources owns which tabs each form draws from, the tab-selector dialog and page-text extraction; the page-text budget and the number of tabs considered become firefox.js prefs\n\nSmartFormFillTelemetry now tracks each form's flow, field decisions and source-editor use, and implements the controller's RequestObserver callbacks; the controller still only receives callbacks, as asked in D317197, and this is the follow-up D325479 left for later\n\nSmartFormFillParent.sys.mjs drops under 1,500 lines and off the AGENTS.md list, as does ChatStore.sys.mjs after bug 2091433 part 3\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343760\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/AGENTS.md", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillSources.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillTelemetry.sys.mjs", "browser/components/aiwindow/ui/moz.build"], "git_node": "6c62cbb87f1b2ec5ebb571649ca34dab358e5b22", "git_parents": ["43bfdb0f7be7b451b709bff4fcfcd67c80ca40e4"], "node": "88b10be962506a769cba15a8e1581058b3e885b0", "parents": ["a3d50b8d7ee4a35cc8222a57c233c838a68aeb22"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094871 - part 2: move the Smart Window toolbar buttons out of AIWindow r=gcardieri\n\nAIWindowToolbarButtons owns the ask button and the switcher, Organize Tabs and monitor CustomizableUI buttons with private members, its own observers and the monitor attention API\n\nthe Organize Tabs and monitor panels take their widget IDs and overflow anchor from it, and the buttons and SpecialMessageActions call AutoTabGrouping and MonitorPanel directly instead of through AIWindowUI\n\nAIWindow.sys.mjs drops under 1,500 lines and off the AGENTS.md list\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343759\n", "files": ["browser/components/aiwindow/AGENTS.md", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowToolbarButtons.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_interaction.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_model.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button_panel.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/aiwindow/ui/test/browser/head_aiwindow_group_tabs_button.js", "browser/components/aiwindow/ui/test/browser/head_monitor_suggest.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_open_organize_tabs_panel.js"], "git_node": "669c20bc6ffa9e4d2a5a0e4fb2737093c49f02cf", "git_parents": ["6c62cbb87f1b2ec5ebb571649ca34dab358e5b22"], "node": "573d5aa39e925a7f312d78c75f481681928b0771", "parents": ["88b10be962506a769cba15a8e1581058b3e885b0"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094871 - part 3: match Smart Window file layout to how files load r=mlucks\n\nui/modules now holds only moz-src modules, and chrome:// modules and assets live under ui/content to mirror their URLs, so one jar.mn wildcard packages them; components stay listed because they are packaged flat\n\nagent-watch-kit.svg from D319607 was never packaged, so it is allowlisted like other Remote Settings message assets\n\nAGENTS.md drops \"where things live\" entries that moz.build and jar.mn already show\n\ntspaths.json is regenerated for the moved modules; the corrected input-cta.mjs import makes SmartbarAction resolve instead of falling back to any, so the urlbar intent is typed to match\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343818\n", "files": ["browser/base/content/test/browser-static/browser_all_files_referenced.js", "browser/components/aiwindow/AGENTS.md", "browser/components/aiwindow/models/IntentClassifier.sys.mjs", "browser/components/aiwindow/ui/actors/AISmartBarParent.sys.mjs", "browser/components/aiwindow/ui/actors/AITabParent.sys.mjs", "browser/components/aiwindow/ui/assets/agent-watch-empty.svg", "browser/components/aiwindow/ui/assets/agent-watch-kit.svg", "browser/components/aiwindow/ui/assets/agent-watch.svg", "browser/components/aiwindow/ui/assets/ai-chat-grid-loading.svg", "browser/components/aiwindow/ui/assets/aitab-error-kit.svg", "browser/components/aiwindow/ui/assets/applied-policy.svg", "browser/components/aiwindow/ui/assets/ask-icon.svg", "browser/components/aiwindow/ui/assets/error-outline.svg", "browser/components/aiwindow/ui/assets/icon-grid-view.svg", "browser/components/aiwindow/ui/assets/icon-list-view.svg", "browser/components/aiwindow/ui/assets/kit-meditating.svg", "browser/components/aiwindow/ui/assets/kit.svg", "browser/components/aiwindow/ui/assets/loader.svg", "browser/components/aiwindow/ui/assets/memories-off.svg", "browser/components/aiwindow/ui/assets/memories-on.svg", "browser/components/aiwindow/ui/assets/model-choice-0.svg", "browser/components/aiwindow/ui/assets/model-choice-auto.svg", "browser/components/aiwindow/ui/assets/model-choice-gemini.svg", "browser/components/aiwindow/ui/assets/model-choice-mistral.svg", "browser/components/aiwindow/ui/assets/model-choice-qwen.svg", "browser/components/aiwindow/ui/assets/new-chat.svg", "browser/components/aiwindow/ui/assets/set-default-onboarding.svg", "browser/components/aiwindow/ui/assets/smart-page-16.svg", "browser/components/aiwindow/ui/assets/smart-window-promo-default.s