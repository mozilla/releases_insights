//phabricator.services.mozilla.com/D340523\n", "files": ["browser/components/urlbar/private/MLSuggest.sys.mjs", "browser/components/urlbar/tests/browser/browser_MLSuggest_integration.js"], "git_node": "f1c274053953d2df1d3f6321369a4d9e90ed30a6", "git_parents": ["c867fe73b2357ec96fcc3ae3fb1fe0adc823bbf5"], "node": "ace73005b4a995adfa49917f89cbc5099fbbdf8e", "parents": ["b1c6d1d5c6db1d89aeb7228566217769864aa0a0"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088234 - Add Set to Default promo to locations subview - r=ip-protection-reviewers,fluent-reviewers,flod,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341133\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/assets/location-pin.svg", "browser/components/ipprotection/content/ipprotection-constants.mjs", "browser/components/ipprotection/content/ipprotection-locations.mjs", "browser/components/ipprotection/content/locations-subview.css", "browser/components/ipprotection/tests/browser/browser_ipprotection_location_selector_telemetry.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_locations_keyboard_navigation.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_locations_list.js", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "33c97a9613d998968e191bd49917946e1234a307", "git_parents": ["f1c274053953d2df1d3f6321369a4d9e90ed30a6"], "node": "596ecdb1c905e9907681e38b813c00d54f4ed37d", "parents": ["ace73005b4a995adfa49917f89cbc5099fbbdf8e"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088236 - Add Set to Default promo to built-in VPN settings - r=ip-protection-reviewers,settings-reviewers,desktop-theme-reviewers,tgiles,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341439\n", "files": ["browser/components/preferences/DefaultBrowserHelper.mjs", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection.js"], "git_node": "c6280781b92dc2a544174ce8c7b2177fdfa04101", "git_parents": ["33c97a9613d998968e191bd49917946e1234a307"], "node": "98d777d05a8bb6febbc5aae410750b3631e63c67", "parents": ["596ecdb1c905e9907681e38b813c00d54f4ed37d"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091150 - Refactor handleEvent in IPProtectionPanel to reduce complexity - r=ip-protection-reviewers,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341517\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs"], "git_node": "3527d5124d68f22c411d6f63929e57adf34ab1b0", "git_parents": ["c6280781b92dc2a544174ce8c7b2177fdfa04101"], "node": "8a0966aa5b512017914a465dc50b6202e2016de6", "parents": ["98d777d05a8bb6febbc5aae410750b3631e63c67"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091023 - Add UK urls list for Monitor Feature Callout r=pdahiya,omc-reviewers,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340997\n", "files": ["browser/components/aiwindow/ui/modules/AgentPageDetector.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_AgentPageDetector.js", "browser/components/asrouter/docs/targeting-attributes.md"], "git_node": "364becfff59e856eb0f76d214c9b79e04017091f", "git_parents": ["3527d5124d68f22c411d6f63929e57adf34ab1b0"], "node": "8641fa8cf8d8bcd626e997c9933800d57d297855", "parents": ["8a0966aa5b512017914a465dc50b6202e2016de6"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2081135 - Make the Smartbar Ask icon follow the button text color in high contrast mode. r=echa\n\nThe icon's fill was only set outside of high contrast mode, so it was drawn black there. It now uses --button-icon-fill, which keeps the same color in normal mode and falls back to currentColor in high contrast mode.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341981\n", "files": ["browser/components/aiwindow/ui/components/input-cta/input-cta.css", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_input_cta.js"], "git_node": "6fe49159938a8f05512dc05112bed58b5536d130", "git_parents": ["364becfff59e856eb0f76d214c9b79e04017091f"], "node": "767b65e9df23e05c9b30a4afdaff537d5644f137", "parents": ["8641fa8cf8d8bcd626e997c9933800d57d297855"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092355 - Block Metal ANGLE WebGL on devices with NVIDIA GPU. r=gfx-reviewers,mac-reviewers,nical,spohl\n\nANGLE's Metal backend does not support NVIDIA GPUs, so block Metal ANGLE\nWebGL when an NVIDIA GPU is detected.\n\nIn theory we could keep it enabled when a non-NVIDIA GPU is also\npresent, and ensure we always select the non-NVIDIA one. But it has been\nobserved that GfxInfo will report both an Intel and AMD/NVIDIA adapter\nas being present when in actuality only the AMD/NVIDIA GPU is\nusable. Therefore out of an abundance of caution we block Metal ANGLE\nWebGL when any NVIDIA GPU is detected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342598\n", "files": ["widget/cocoa/GfxInfo.mm"], "git_node": "6fdb0c8fe620c7100ea338ecb911bb8e9a4efd30", "git_parents": ["6fe49159938a8f05512dc05112bed58b5536d130"], "node": "60f456e67a3b4f67e454025707d8b6a0c2544ada", "parents": ["767b65e9df23e05c9b30a4afdaff537d5644f137"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085414 - Split browser_chat_shortcuts.js into feature-grouped test files. r=yjamora\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341474\n", "files": ["browser/components/genai/tests/browser/browser.toml", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/components/genai/tests/browser/browser_chat_shortcuts_callout.js", "browser/components/genai/tests/browser/browser_chat_shortcuts_copy.js", "browser/components/genai/tests/browser/browser_chat_shortcuts_dropdown.js", "browser/components/genai/tests/browser/browser_chat_shortcuts_more_actions.js", "browser/components/genai/tests/browser/browser_chat_shortcuts_search.js", "browser/components/genai/tests/browser/browser_chat_shortcuts_suppression.js", "browser/components/genai/tests/browser/browser_chat_shortcuts_telemetry.js", "browser/components/genai/tests/browser/head.js"], "git_node": "1e1eb9a82a377f5662cb3386a45137458d3b2593", "git_parents": ["6fdb0c8fe620c7100ea338ecb911bb8e9a4efd30"], "node": "fb39e12920054fb79ce85e396924cd39e39c7622", "parents": ["60f456e67a3b4f67e454025707d8b6a0c2544ada"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019836 - Clamp GC time budgets to at least 1ms. r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338738\n", "files": ["dom/base/CCGCScheduler.cpp", "dom/base/CCGCScheduler.h", "js/public/SliceBudget.h", "js/src/jsapi-tests/testSliceBudget.cpp"], "git_node": "27e7f53990210f0226a51cacb444710574622a80", "git_parents": ["1e1eb9a82a377f5662cb3386a45137458d3b2593"], "node": "47396d62fee41801af72c4a360caed9ba6426954", "parents": ["fb39e12920054fb79ce85e396924cd39e39c7622"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 1953508 - Upgrade Storybook to 10.6.3 r=desktop-theme-reviewers,mstriemer\n\nStorybook 7 blocks addons and features that need newer releases, such\nas the visual testing considered in bug 1912476.\n\nThe upgrade uses the Vite builder, which cannot run the existing Webpack\nloaders. A Vite plugin now resolves chrome:// and moz-src:// URIs and\nrewrites stylesheet imports. It reads the resolved files directly, so\nURI resolution returns absolute paths.\n\nMarkdown docs replace the Webpack indexer and loader with an indexer\nthat compiles them in memory through the addon-docs MDX plugin. This\nkeeps authoring in plain Markdown without writing generated files.\n\nStorybook 10 no longer renders arbitrary Canvas children, so Markdown\nexamples render in Unstyled blocks that keep the previous example\nstyling. It also moves APIs into the storybook package, installs the\nmanager channel later, and only loads addon preview entries through\npreviewAnnotations.\n\nStorybook requires an ES module configuration, now named main.mjs.\nThe Vite dev server serves the generated ChromeMap to the browser\nwithout CommonJS conversion, so its default import fails. Both files\nuse module syntax, while the other Node helpers stay CommonJS.\nThe map is generated, so linting and formatting should leave it alone.\nUse Generated.txt rather than a separate ESLint exclusion, and mirror\nthat entry in Prettier\u2019s generated-file section.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337339\n", "files": [".prettierignore", "browser/components/storybook/.babelrc.json", "browser/components/storybook/.storybook/DocsContainer.jsx", "browser/components/storybook/.storybook/DocsContainer.mjs", "browser/components/storybook/.storybook/addon-component-status/StatusIndicator.jsx", "browser/components/storybook/.storybook/addon-component-status/index.js", "browser/components/storybook/.storybook/addon-component-status/preset/manager.mjs", "browser/components/storybook/.storybook/addon-fluent/FluentPanel.jsx", "browser/components/storybook/.storybook/addon-fluent/PseudoLocalizationButton.jsx", "browser/components/storybook/.storybook/addon-fluent/index.js", "browser/components/storybook/.storybook/addon-fluent/preset/manager.mjs", "browser/components/storybook/.storybook/addon-fluent/withPseudoLocalization.mjs", "browser/components/storybook/.storybook/fluent-utils.mjs", "browser/components/storybook/.storybook/main.js", "browser/components/storybook/.storybook/main.mjs", "browser/components/storybook/.storybook/manager.mjs", "browser/components/storybook/.storybook/markdown-story-generator.js", "browser/components/storybook/.storybook/markdown-story-indexer.js", "browser/components/storybook/.storybook/markdown-story-loader.js", "browser/components/storybook/.storybook/markdown-story-utils.js", "browser/components/storybook/.storybook/moz-styles-loader.js", "browser/components/storybook/.storybook/moz-uri-utils.js", "browser/components/storybook/.storybook/moz-vite-plugin.mjs", "browser/components/storybook/.storybook/preview.mjs", "browser/components/storybook/.storybook/theme-dark.mjs", "browser/components/storybook/.storybook/theme-light.mjs", "browser/components/storybook/docs/README.storybook.stories.md", "browser/components/storybook/mach_commands.py", "browser/components/storybook/package-lock.json", "browser/components/storybook/package.json", "browser/components/storybook/stories/icon-directory.stories.mjs", "eslint-file-globals.config.mjs", "tools/rewriting/Generated.txt"], "git_node": "979cfceca9dd42487340f5c0cc07c48e2ad5afa1", "git_parents": ["27e7f53990210f0226a51cacb444710574622a80"], "node": "1e5728070488e6106170b0f765f6d2d18104d045", "parents": ["47396d62fee41801af72c4a360caed9ba6426954"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 1953508 - Hash production Storybook stylesheet module identifiers r=reusable-components-reviewers,mstriemer\n\nProduction stylesheet module identifiers encode absolute file paths.\nIn deep Windows checkouts the resulting output filenames exceed the\nfilename length limit. Hashing keeps them short.\n\nDevelopment identifiers stay unchanged because they are never written\nto disk.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338910\n", "files": ["browser/components/storybook/.storybook/moz-vite-plugin.mjs", "browser/components/storybook/docs/README.storybook.stories.md"], "git_node": "47d53ffa93477116557cb672c44b0e53d6108380", "git_parents": ["979cfceca9dd42487340f5c0cc07c48e2ad5afa1"], "node": "682fd0609e0b312d0e875a2848a0c837d25bf3c1", "parents": ["1e5728070488e6106170b0f765f6d2d18104d045"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 1953508 - Parse Storybook theme globals with semicolons r=reusable-components-reviewers,mstriemer\n\nStorybook separates URL globals with semicolons, but the theme helpers\nsplit on commas. A theme followed by another global is misread, and\nchanging the theme drops the neighboring globals.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338903\n", "files": ["browser/components/storybook/.storybook/DocsContainer.jsx", "browser/components/storybook/.storybook/manager.mjs"], "git_node": "2931c5f193520c61dce9fb4461f45a4ac0fd05b9", "git_parents": ["47d53ffa93477116557cb672c44b0e53d6108380"], "node": "df32673f722b5367bd8bbc1bfc69efc08e492ae2", "parents": ["682fd0609e0b312d0e875a2848a0c837d25bf3c1"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 1953508 - Preserve nested Fluent resource paths in Storybook r=reusable-components-reviewers,mstriemer\n\nFluent files in nested preview and branding directories fail to load.\nInterpolating the remaining path segments as an array joins them with\ncommas instead of slashes, so the lookup never matches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338905\n", "files": ["browser/components/storybook/.storybook/fluent-utils.mjs"], "git_node": "8d7c7d04349e9da6a066b3210ed56807dba98249", "git_parents": ["2931c5f193520c61dce9fb4461f45a4ac0fd05b9"], "node": "e98afc3baf4c6206abab4b3a7c0205a00d82fc72", "parents": ["df32673f722b5367bd8bbc1bfc69efc08e492ae2"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092214: don't include try_task_config.json in files changed r=taskgraph-reviewers,ahal\n\nThis file's purpose is to communicate metadata to the decision task; it should be treated as a file that directly impacts scheduling (any impact it has will run through the `parameters` that it includes).\n\nBecause it is in `files_changed`, this means that virtually all try pushes are unable to use the `SCHEDULES` optimizations, which results in overscheduling. For example: https://phabricator.services.mozilla.com/D340067 only touches `mobile`, but [the try push that ran builds for it](https://treeherder.mozilla.org/jobs?repo=try&https://treeherder.mozilla.org/jobs?repo=try&revision=3532ad7174292ff7ee84cd154be094c7cb7f4150revision=3532ad7174292ff7ee84cd154be094c7cb7f4150) scheduled desktop tasks as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342277\n", "files": ["taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/test/test_decision.py"], "git_node": "0920cff2a62c4aceff3f61e7619dc5872be9ea7f", "git_parents": ["8d7c7d04349e9da6a066b3210ed56807dba98249"], "node": "05849fc6601d40d090ec00bc9d508cefb2914e12", "parents": ["e98afc3baf4c6206abab4b3a7c0205a00d82fc72"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092214: remove special handling of try_task_config.json in source_test transform r=taskgraph-reviewers,ahal\n\n`try_task_config.json` is no longer included in `files_changed`; we longer need to do special handling in tranforms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342278\n", "files": ["taskcluster/gecko_taskgraph/test/python.toml", "taskcluster/gecko_taskgraph/test/test_transforms_source_test.py", "taskcluster/gecko_taskgraph/transforms/source_test.py"], "git_node": "1a59a44d110727ee223c9a297722ee3fbdcff421", "git_parents": ["0920cff2a62c4aceff3f61e7619dc5872be9ea7f"], "node": "9fa92dc9544fd756944af48581ca534a7a4f1733", "parents": ["05849fc6601d40d090ec00bc9d508cefb2914e12"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088584: Remove webrender compositor blocklist entries for older Windows drivers. r=gfx-reviewers,aosmond\n\nThese blocklist entries were added in Bug 1602511 and Bug 1625857. Both\nof them landed in 2020.\n\nThis change is a heavy-handed approach to dealing with\nEARLY_BETA_OR_EARLIER dependency. It would be safer to remove this\ndefine and leave the blocklist entries in place for all builds. But it\nalso seems justified to remove the entries entirely for 6-year-old\nhardware and drivers, presuming that ongoing problems would manifest\ndifferently, if at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342769\n", "files": ["widget/windows/GfxInfo.cpp"], "git_node": "c81d4f49f64a6737750ff6d1ffbeed391bbeb9c9", "git_parents": ["1a59a44d110727ee223c9a297722ee3fbdcff421"], "node": "a60e094676e87c2e2c924d258f63a9c8ff63cdf5", "parents": ["9fa92dc9544fd756944af48581ca534a7a4f1733"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2054640 - Test primed peerIdentity MediaStream sinks r=webrtc-reviewers,dbaker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313934\n", "files": ["dom/media/webrtc/tests/mochitests/mochitest_getusermedia.toml", "dom/media/webrtc/tests/mochitests/srcObjectCorsTaint.js", "dom/media/webrtc/tests/mochitests/test_getUserMedia_srcObjectCorsTaint.html"], "git_node": "ec086cd87f52210cbbdf1abb70a9862ff400f4d7", "git_parents": ["c81d4f49f64a6737750ff6d1ffbeed391bbeb9c9"], "node": "2cd41d1e6cebfcb4e3f6f80dab78b7d571209357", "parents": ["a60e094676e87c2e2c924d258f63a9c8ff63cdf5"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2054640 - Test direct srcObject resource selection r=webrtc-reviewers,dbaker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313935\n", "files": ["dom/media/webrtc/tests/mochitests/cors_mode_stall.sjs", "dom/media/webrtc/tests/mochitests/mochitest_getusermedia.toml", "dom/media/webrtc/tests/mochitests/test_getUserMedia_srcObjectCorsTaintDirectSelection.html"], "git_node": "1196a14f92dc3d389fe4ab81ea8a2fd6705a4e18", "git_parents": ["ec086cd87f52210cbbdf1abb70a9862ff400f4d7"], "node": "27837c17da48c5c1dfcf56252ea4d0e8b3dd95c7", "parents": ["2cd41d1e6cebfcb4e3f6f80dab78b7d571209357"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2075722 - Keep the application menu at the end of the toolbar in Smart Window. r=desktop-theme-reviewers,mlucks,emilio\n\nSmart Window moved the application menu into the tab strip, next to the window controls. Now that Smart Window shows the address bar on every page, the menu belongs in its standard spot at the end of the toolbar, like the rest of\nFirefox.\n\nThis removes the code that moved it, and the edge padding rules that only existed because of the move.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341952\n", "files": ["browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_switcher.js", "browser/themes/shared/browser-shared.css"], "git_node": "adf6340f543a90f9825bb611bb4cd85b68c88717", "git_parents": ["1196a14f92dc3d389fe4ab81ea8a2fd6705a4e18"], "node": "368f1fe6335f42097585eb9667c7808a8a866f68", "parents": ["27837c17da48c5c1dfcf56252ea4d0e8b3dd95c7"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084985 - Remove the initial 30s wait from nav-bench. r=perftest-reviewers,kshampur\n\nThe wait costs ~150s per job. Without it the font info loader (gfx.font_loader.delay)\nfires mid-run, regressing and adding noise to the macOS loads, so set the delay to 0.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341056\n", "files": ["testing/perfdocs/generated/raptor.md", "testing/raptor/raptor/tests/nav-bench/browsertime-nav-bench-m.toml", "testing/raptor/raptor/tests/nav-bench/browsertime-nav-bench.toml"], "git_node": "c6551f916fc835d596f837d2270b39d264ca0e36", "git_parents": ["adf6340f543a90f9825bb611bb4cd85b68c88717"], "node": "14f61767274cb4d117475dec0e87f95d10fb94e6", "parents": ["368f1fe6335f42097585eb9667c7808a8a866f68"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092371 - Update android nightly application-services version bump to 19246dbfd34691148bb04e0eb3716a1b1fc749ab r=android-build-system-reviewers,beth,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342415\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "b19de992962c4cfedf4cea3c42ae6e57dfd90551", "git_parents": ["c6551f916fc835d596f837d2270b39d264ca0e36"], "node": "49b3b729c3e1b1461ca17196320d20fa21c27b3b", "parents": ["14f61767274cb4d117475dec0e87f95d10fb94e6"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2082524 - Vendor application-services to 19246dbfd34691148bb04e0eb3716a1b1fc749ab r=bdk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342284\n", "files": ["Cargo.lock", "third_party/application-services/components/ads-client/src/ads_store/store.rs", "third_party/application-services/components/ads-client/src/clock.rs", "third_party/application-services/components/ads-client/src/http_cache.rs", "third_party/application-services/components/ads-client/src/http_cache/builder.rs", "third_party/application-services/components/ads-client/src/http_cache/cache_control.rs", "third_party/application-services/components/ads-client/src/http_cache/response_age.rs", "third_party/application-services/components/ads-client/src/http_cache/store.rs", "third_p