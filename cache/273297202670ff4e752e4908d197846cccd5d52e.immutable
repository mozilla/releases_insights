-05ec-48ba-93f9-746e0981ad98.meta.json", "services/settings/dumps/main/search-config-icons/9d96547d-7575-49ca-8908-1e046b8ea90e.meta.json", "services/settings/dumps/main/search-config-icons/a06db97d-1210-ea2e-5474-0e2f7d295bfd.meta.json", "services/settings/dumps/main/search-config-icons/a06dc3fd-4bdb-41f3-2ebc-4cbed06a9bd3.meta.json", "services/settings/dumps/main/search-config-icons/a2c7d4e9-f770-51e1-0963-3c2c8401631d.meta.json", "services/settings/dumps/main/search-config-icons/acae3d3c-b09e-47f0-a9e5-57980d21fc4a.meta.json", "services/settings/dumps/main/search-config-icons/b64f09fd-52d1-c48e-af23-4ce918e7bf3b.meta.json", "services/settings/dumps/main/search-config-icons/b8ca5a94-8fff-27ad-6e00-96e244a32e21.meta.json", "services/settings/dumps/main/search-config-icons/c411adc1-9661-4fb5-a4c1-8cfe74911943.meta.json", "services/settings/dumps/main/search-config-icons/cbf9e891-d079-2b28-5617-283450d463dd.meta.json", "services/settings/dumps/main/search-config-icons/d87f251c-3e12-a8bf-e2d0-afd43d36c5f9.meta.json", "services/settings/dumps/main/search-config-icons/e02f23df-8d48-2b1b-3b5c-6dd27302c61c.meta.json", "services/settings/dumps/main/search-config-icons/e718e983-09aa-e8f6-b25f-cd4b395d4785.meta.json", "services/settings/dumps/main/search-config-icons/e7547f62-187b-b641-d462-e54a3f813d9a.meta.json", "services/settings/dumps/main/search-config-icons/f312610a-ebfb-a106-ea92-fd643c5d3636.meta.json", "services/settings/dumps/main/search-config-icons/fa0fc42c-d91d-fca7-34eb-806ff46062dc.meta.json", "services/settings/dumps/main/search-config-icons/fca3e3ee-56cd-f474-dc31-307fd24a891d.meta.json", "services/settings/dumps/main/search-config-icons/fed4f021-ff3e-942a-010e-afa43fda2136.meta.json", "services/settings/dumps/main/search-default-override-allowlist.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/main/sites-classification.json", "services/settings/dumps/main/top-sites.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/main/translations-wasm.json", "services/settings/dumps/main/url-classifier-skip-urls.json", "services/settings/dumps/main/url-parser-default-unknown-schemes-interventions.json", "services/settings/dumps/main/urlbar-persisted-search-terms.json", "services/settings/dumps/main/websites-with-shared-credential-backends.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "f33206f51700b26b30677ad6e29ac8d0ba891f73", "git_parents": ["6b01a02c24db387d37610dc7aea9b7443f7aee30"], "node": "6ee626af32eface2352434c2b9125f4b84a5a87f", "parents": ["920cb48f8995f851c42bbbfc349a32bb8d599ae8"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078472 - Forward MozAfterPaint to the parent document only from process roots in the reftest harness. r=tnikkel,layout-reviewers\n\nInvalidations in an in-process subframe already reach the process root document, and the forwarding flushes the parent document through getComputedStyle on the embedder element even with reftest-no-flush.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341216\n", "files": ["layout/reftests/reftest-sanity/reftest-no-flush-subframe-ref.html", "layout/reftests/reftest-sanity/reftest-no-flush-subframe.html", "layout/reftests/reftest-sanity/reftest.list", "layout/tools/reftest/ReftestFissionChild.sys.mjs"], "git_node": "7b4922b9ca4890d5b697c5396c743c7dbed766d3", "git_parents": ["f33206f51700b26b30677ad6e29ac8d0ba891f73"], "node": "7569216b694f842290382813718b30b391b1cd4b", "parents": ["6ee626af32eface2352434c2b9125f4b84a5a87f"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084754, Bug 1844400: Support stub frames in the megamorphic load stub r=spidermonkey-reviewers,jandem\" for causing SM failures CacheIRCompiler.cpp.\n\nThis reverts commit 6b01a02c24db387d37610dc7aea9b7443f7aee30.\n\nRevert \"Bug 1844400: Support frame pointers in generic call trampoline r=spidermonkey-reviewers,jandem\"\n\nThis reverts commit d841607f5db5eddf32e6dea26940d53baf0deafb.\n\nRevert \"Bug 1844400: Rename enable-ic-frame-pointers to enable-stub-frame-pointers r=perftest-reviewers,sparky,spidermonkey-reviewers,jandem\"\n\nThis reverts commit 1b497a6ea1762014aeeb52c1005387701c2f5c64.\n", "files": ["docs/performance/jit_profiling_with_samply.md", "js/src/jit-test/tests/ion/call-generic-stub-frame-pointers.js", "js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/BaselineCacheIRCompiler.h", "js/src/jit/CodeGenerator.cpp", "js/src/jit/JitOptions.cpp", "js/src/jit/JitOptions.h", "js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.h", "js/src/shell/js.cpp", "taskcluster/gecko_taskgraph/transforms/test/raptor.py", "testing/raptor/raptor/perf_profile.py", "testing/raptor/raptor/samply_profile.py"], "git_node": "e46c63c15af7416fb606a883755c470c27cfd416", "git_parents": ["7b4922b9ca4890d5b697c5396c743c7dbed766d3"], "node": "1ff1e8635f0c2d3fd1a3309b19e106f856551137", "parents": ["7569216b694f842290382813718b30b391b1cd4b"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085980 - Silence the `GetExceptionCode` redefinition warning in `mozilla-config.h` for MinGW builds r=RyanVM\n\n`process_define_files.py` turns `#undef GetExceptionCode` into a comment\nbecause `GetExceptionCode` is not a configure define. The `#define` that\nfollows redefines the macro from `excpt.h` and warns in every file built\nwith `MOZ_NEUTER_SEH_FOR_MINGWCLANG`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341571\n", "files": ["mozilla-config.h.in"], "git_node": "dfdb6b9f991646a2b93b5a655d55283a24a35044", "git_parents": ["e46c63c15af7416fb606a883755c470c27cfd416"], "node": "b47ed4677c394e444e601fcc78b6ca1094d466e8", "parents": ["1ff1e8635f0c2d3fd1a3309b19e106f856551137"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083959 - Allow unprivileged WebExtensions to embed widgets in New Tab (by policy - API not exposed yet). r=extension-reviewers,rpl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340009\n", "files": ["toolkit/components/extensions/WebExtensionPolicy.cpp", "toolkit/components/extensions/WebExtensionPolicy.h", "toolkit/components/extensions/test/xpcshell/test_WebExtensionPolicy.js", "toolkit/components/extensions/test/xpcshell/test_WebExtensionPolicy_aboutnewtab.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common-e10s.toml"], "git_node": "0f3c16ef6b844f0002015387fad3b513feb81f95", "git_parents": ["dfdb6b9f991646a2b93b5a655d55283a24a35044"], "node": "236c5e7bae4ecaf2c9e03f12b88726578c0dd736", "parents": ["b47ed4677c394e444e601fcc78b6ca1094d466e8"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072073 - Backport arm64e.x1 support to clang 22. r=firefox-build-system-reviewers,sylvestre\n\nThe macOS 27 SDK's linker stubs declare an arm64e.x1 target that ld64.lld rejects as an unknown architecture,\nfailing every link against the SDK. clang 23 and trunk already have the upstream fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332000\n", "files": ["build/build-clang/clang-22.json", "build/build-clang/llvmorg-24-init-8352-gb8007a8e4020.patch"], "git_node": "48cabcf157dcb1d8d0e581ee2c2d8482cff3d4b7", "git_parents": ["0f3c16ef6b844f0002015387fad3b513feb81f95"], "node": "55361990343cc2c3078fef8b63d009b58715ca30", "parents": ["236c5e7bae4ecaf2c9e03f12b88726578c0dd736"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072073 - Backport the stack_protector_ignore attribute to clang 22. r=firefox-build-system-reviewers,sergesanspaille,ahochheiden\n\nThe macOS 27 SDK applies __attribute__((stack_protector_ignore)) unconditionally in its os_log macros, which\nclang 22 rejects with -Wunknown-attributes. clang 23 and trunk already have it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332001\n", "files": ["build/build-clang/clang-22.json", "build/build-clang/llvmorg-23-init-1731-ga63696edca8b.patch"], "git_node": "41d623415809a246ed17b79af54e2a9d2be7beec", "git_parents": ["48cabcf157dcb1d8d0e581ee2c2d8482cff3d4b7"], "node": "ed306c4c7ee6f0a03e5ce451d83b564c194e7587", "parents": ["55361990343cc2c3078fef8b63d009b58715ca30"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072073: Backport the llvm-objcopy Mach-O LINKEDIT alignment fix to clang 22. r=firefox-build-system-reviewers,glandium\n\nllvm-strip from clang 22 can leave the string table of a stripped Mach-O binary 4-byte aligned. dyld on macOS 27 appears to reject such binaries once they're built against the macOS 27 SDK, which is what kept the 20261109214446 Nightly from starting (bug 2091237). clang 23 already has the fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341230\n", "files": ["build/build-clang/clang-22.json", "build/build-clang/llvmorg-23-init-20003-g18c1cbce6874.patch"], "git_node": "6ac679d0f2f29c1adba9e34a4a153c79505b9871", "git_parents": ["41d623415809a246ed17b79af54e2a9d2be7beec"], "node": "a4fc85c348bddebbaf76c0fe91b655c86a55228c", "parents": ["ed306c4c7ee6f0a03e5ce451d83b564c194e7587"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072073 - Update macOS SDK to 27.2. r=firefox-build-system-reviewers,mac-reviewers,sergesanspaille,spohl,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332003\n", "files": ["build/docs/toolchains.md", "build/macosx/catalog.py", "build/moz.configure/toolchain.configure", "python/mozbuild/mozbuild/test/configure/macos_fake_sdk/SDKSettings.plist", "taskcluster/kinds/toolchain/custom-car.yml", "taskcluster/kinds/toolchain/macos-sdk.yml"], "git_node": "4452f4cd3bc0bcd88449b6e8a0614a0f767ec787", "git_parents": ["6ac679d0f2f29c1adba9e34a4a153c79505b9871"], "node": "49569fac4100b2c0f5e2d5d693ffc627c440b5a6", "parents": ["a4fc85c348bddebbaf76c0fe91b655c86a55228c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072073 - Keep cpython from using pipe2 and dup3 on macOS. r=firefox-build-system-reviewers,sergesanspaille,glandium\n\nThe macOS 27 SDK declares pipe2 and dup3, so configure picks them up, but the libSystem of older macOS\nreleases does not export them; with pipe2 the freshly built python dies in dyld during make libinstall.\n\nThis backports upstream's configure fix from 3.13 and 3.14 (gh-153711) to the 3.10 and 3.11 sources we build.\nEach macOS python task passes its version's patch to build-cpython.sh; 3.13 and later already have the fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332004\n", "files": ["taskcluster/kinds/toolchain/python.yml", "taskcluster/scripts/misc/build-cpython.sh", "taskcluster/scripts/misc/cpython-3.10-macos-dup3-pipe2.patch", "taskcluster/scripts/misc/cpython-3.11-macos-dup3-pipe2.patch"], "git_node": "48c96e86fc8eccbf974b5f306913e69e53086e06", "git_parents": ["4452f4cd3bc0bcd88449b6e8a0614a0f767ec787"], "node": "0bb07f104b31fd91cf0b17b5e5ec2159a56e8040", "parents": ["49569fac4100b2c0f5e2d5d693ffc627c440b5a6"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072073 - Disable -Wcpp for macOS deployment targets below 11.0. r=firefox-build-system-reviewers,sergesanspaille,ahochheiden\n\nlibc++ in the macOS 27 SDK emits a #warning that deployment targets below 11.0 are no longer supported. We\nstill target 10.15 on Intel, local builds default to it on Apple Silicon as well, and #warning is not\nsuppressed in system headers, so this is the only way to keep -Werror builds and the clang-plugin -verify\ntests compiling. -Wcpp is clang's alias for -W#warnings; the # in the canonical spelling gets shell-quoted on\nits way through cargo build scripts and clang then treats it as a file name. bindgen does not see the warning\nflags, so BINDGEN_SYSTEM_FLAGS carries it too. The toolchain builds get the same flag through macos-setup.sh,\nbuild-clang.py and build-llvm-common.sh so their logs stay readable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332005\n", "files": ["build/build-clang/build-clang.py", "build/moz.configure/bindgen.configure", "build/moz.configure/warnings.configure", "taskcluster/scripts/misc/build-llvm-common.sh", "taskcluster/scripts/misc/macos-setup.sh"], "git_node": "5d4437c4b43853aff976210f531d7ba2e6449810", "git_parents": ["48c96e86fc8eccbf974b5f306913e69e53086e06"], "node": "401155dcbbf7a3795087decd0d69ddc6885198b6", "parents": ["0bb07f104b31fd91cf0b17b5e5ec2159a56e8040"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091466 - Fail packaging when a stripped Mach-O has a __LINKEDIT layout dyld rejects. r=firefox-build-system-reviewers,ahochheiden\n\ndyld refuses to load a binary whose __LINKEDIT contents overlap, run past the end of the segment or are\nmisaligned, once it is linked against a recent enough SDK. dyld on macOS 27 also requires the string pool to\nbe pointer-size aligned, which clang 22's llvm-strip does not guarantee, so a Nightly built with it against\nthe macOS 27 SDK did not start there (bug 2091237). Nothing in CI runs Firefox on macOS 27, so check the\nlayout right after stripping instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341463\n", "files": ["python/mozbuild/mozpack/executables.py", "python/mozbuild/mozpack/test/python.toml", "python/mozbuild/mozpack/test/test_macho_linkedit.py"], "git_node": "f830d9973b15cae66284326c1155d527911f7fdb", "git_parents": ["5d4437c4b43853aff976210f531d7ba2e6449810"], "node": "544f733c0349539a0cd8d4f675d15da53bbf347d", "parents": ["401155dcbbf7a3795087decd0d69ddc6885198b6"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090172: Hold a strong reference to the main-thread XHR across worker abort. r=dom-worker-reviewers,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340567\n", "files": ["dom/xhr/XMLHttpRequestWorker.cpp"], "git_node": "f1e2b7ac0053765496d74cd8409e340f5db96a4c", "git_parents": ["f830d9973b15cae66284326c1155d527911f7fdb"], "node": "46139b1d980228fbfde04f6d091a74000227570f", "parents": ["544f733c0349539a0cd8d4f675d15da53bbf347d"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2090212 - Use GetFactoryCspace() to get shared surface factory color space and possible fallback. r=lsalzman,gfx-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341360\n", "files": ["gfx/gl/GLScreenBuffer.cpp", "gfx/gl/SharedSurface.h"], "git_node": "f67e972f790caa6a18f7a0f16c31894ea715e256", "git_parents": ["f1e2b7ac0053765496d74cd8409e340f5db96a4c"], "node": "75dd10b353ec6d92c63e8b888bcdd7479b8fb0dd", "parents": ["46139b1d980228fbfde04f6d091a74000227570f"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2011576 - Listen for dragleave events on the window to know if a tab has been dragged out of the current window r=tabbrowser-reviewers,sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341058\n", "files": ["browser/components/tabbrowser/content/drag-and-drop.mjs"], "git_node": "618544cf8d27d2d238250fe77f2248f69a66e212", "git_parents": ["f67e972f790caa6a18f7a0f16c31894ea715e256"], "node": "820b61cf331446cebfedd32b068a32c8347a860c", "parents": ["75dd10b353ec6d92c63e8b888bcdd7479b8fb0dd"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066737 - Fix for selected split view corner aliasing r=desktop-theme-reviewers,tabbrowser-reviewers,jsudiaman,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340121\n", "files": ["browser/themes/shared/tabbrowser/content-area.css"], "git_node": "3bb85a542c294e63e53064e63f3da3b7179be9a5", "git_parents": ["618544cf8d27d2d238250fe77f2248f69a66e212"], "node": "88e5011258bbf7fc0c8550647d10c84361753e55", "parents": ["820b61cf331446cebfedd32b068a32c8347a860c"], "tags": []}, {"author": "Andrej \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1865812 - Mention TOML manifests instead of ini files in the mozperftest docs. r=mozperftest-reviewers,perftest-reviewers,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339655\n", "files": ["python/mozperftest/perfdocs/vision.md", "testing/perfdocs/generated/vision.md"], "git_node": "504db4ac267c86a87d5c5fa7e3ff26c44d1c664a", "git_parents": ["3bb85a542c294e63e53064e63f3da3b7179be9a5"], "node": "4097033e31ee874bebcf3f0c772392993a002358", "parents": ["88e5011258bbf7fc0c8550647d10c84361753e55"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2071556 - Fold GuardSpecificFunction when its input is the expected function behind other guards. r=iain\n\nSince bug 1824085, scalar replacement of a bound function leaves the call's\nGuardSpecificFunction comparing the target with itself behind GuardShape and\nGuardFunctionScript. The guard always passes, but on riscv64 comparing a\nregister with itself emitted no branch, so the bailout label was unused and\nion/bound-function-scalar-replacement.js asserted in debug builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341005\n", "files": ["js/src/jit/MIR.cpp"], "git_node": "3b82d780f3441a7ad85c5adbc00ee16e262b5a5f", "git_parents": ["504db4ac267c86a87d5c5fa7e3ff26c44d1c664a"], "node": "c27f23f95beace437205652c29be43f1796e51e6", "parents": ["4097033e31ee874bebcf3f0c772392993a002358"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2090764 - Add a content description to the close button of the Collections migration card r=android-reviewers,android-l10n-reviewers,npoon,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341256\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/collections/CollectionsMigrationPromoCard.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "2550a3cb7ffcd6d3d0262ee97de74eb23a1c4f61", "git_parents": ["3b82d780f3441a7ad85c5adbc00ee16e262b5a5f"], "node": "b573fa2e15ea95bd653a25224bddb1bbd463ddeb", "parents": ["c27f23f95beace437205652c29be43f1796e51e6"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091501: Defer native menu icon loads while macOS opens menus without showing them. r=mac-reviewers,bradwerth\n\nSpotlight on macOS 26 and later makes AppKit open every menu in the menubar without showing it (`-[NSMenu _simulateOpening:]`) to collect the app's menu commands. With many bookmarks, every item then loaded and drew its favicon, which kept the main thread busy for seconds after the menus had closed again.\n\nThe menu items are still built during these simulated opens, so Spotlight still sees them, but their icon loads now wait until the menu is actually shown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341521\n", "files": ["widget/cocoa/nsMenuItemIconX.h", "widget/cocoa/nsMenuItemIconX.mm", "widget/cocoa/nsMenuItemX.h", "widget/cocoa/nsMenuX.h", "widget/cocoa/nsMenuX.mm"], "git_node": "29a7ddc9801ca56e33adb7a041b3c797aef514b4", "git_parents": ["2550a3cb7ffcd6d3d0262ee97de74eb23a1c4f61"], "node": "e6b48e6bdbf839899b9750377e34349aa3363555", "parents": ["b573fa2e15ea95bd653a25224bddb1bbd463ddeb"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091427 - Keep strong pointer to source element in nsDocShellLoadState. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341029\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/nsDocShell.cpp", "docshell/base/nsDocShellLoadState.cpp", "docshell/base/nsDocShellLoadState.h", "docshell/test/navigation/mochitest.toml", "docshell/test/navigation/test_navigate_event_strong_sourceElement.html"], "git_node": "7e272e6724903ca8d2fd9c0b640a5e3a48dda170", "git_parents": ["29a7ddc9801ca56e33adb7a041b3c797aef514b4"], "node": "3bd509aab43df4ebbbe271407744576fe201f4a9", "parents": ["e6b48e6bdbf839899b9750377e34349aa3363555"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2091281 - Only declare sScalesInitialized in debug builds. r=sergesanspaille\n\nIt is only used in a MOZ_ASSERT.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341252\n", "files": ["mozglue/misc/TimeStamp.cpp"], "git_node": "049b76302addea6354d228d7bd5bc836559c153c", "git_parents": ["7e272e6724903ca8d2fd9c0b640a5e3a48dda170"], "node": "2b1e23d5e6c4ed055c815b7d36767f67584301ab", "parents": ["3bd509aab43df4ebbbe271407744576fe201f4a9"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2090172: Hold a strong reference to the main-thread XHR across worker abort. r=dom-worker-reviewers,edenchuang\" for causing bustages in XMLHttpRequestWorker.cpp.\n\nThis reverts commit f1e2b7ac0053765496d74cd8409e340f5db96a4c.\n", "files": ["dom/xhr/XMLHttpRequestWorker.cpp"], "git_node": "1cd8fca6b2778e26a1bafe6e0e8dad23da7f6c70", "git_parents": ["049b76302addea6354d228d7bd5bc836559c153c"], "node": "3615b03607e069566e6fb42634d5d5c388dd947c", "parents": ["2b1e23d5e6c4ed055c815b7d36767f67584301ab"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2005078 - Remove unused .footer-button CSS r=desktop-theme-reviewers,akulyk\" for causing failures at browser_RemoteSettingsCrashPull_notification.js.\n\nThis reverts commit d13b1ab8a543f1a9c551c8e69433f5317be94f86.\n\nRevert \"Bug 2005078 - Replace button.footer with moz-button in toolkit/content/widgets/ r=reusable-components-reviewers,omc-reviewers,akulyk,emcminn,media-playback-reviewers,urlbar-reviewers,nimbus-reviewers,jteow,padenot,sachung\"\n\nThis reverts commit 27ff3068f6069c553344d03747523d7420811b65.\n\nRevert \"Bug 2005078 - Replace button.footer with moz-button in browser/components/translations/ r=translations-reviewers,akulyk,desktop-theme-reviewers,nordzilla\"\n\nThis reverts commit d19513b12b2b842aaadc5a3e1a79ca9d76592685.\n\nRevert \"Bug 2005078 - Replace button.footer with moz-button in browser/components/reportbrokensite/ r=desktop-theme-reviewers,webcompat-reviewers,akulyk,twisniewski\"\n\nThis reverts commit f5f03864b6bcf7bc57a56fcbf056dbd08e75159e.\n\nRevert \"Bug 2005078 - Replace button.footer with moz-button in browser/components/remotecontrol/ r=akulyk,desktop-theme-reviewers\"\n\nThis reverts commit afa5169787e00cb94ad120139feb8fe2795040f7.\n\nRevert \"Bug 2005078 - Replace button.footer with moz-button in browser/components/downloads/ r=akulyk\"\n\nThis reverts commit bafa1af235625445ffda24c273080e6c821b17ed.\n\nRevert \"Bug 2005078 - Replace button.footer with moz-button in browser/components/customizableui/ r=desktop-theme-reviewers,akulyk\"\n\nThis reverts commit e5d79af54c8063120856e72cc8cf7679fbcc15f9.\n\nRevert \"Bug 2005078 - Replace button.footer with moz-button in browser/base/content/ r=places-reviewers,akulyk\"\n\nThis reverts commit 12f750a10326ae9cdeb8e8d686aec4038321a5a3.\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-captivePortal.js", "browser/base/content/browser-places.js", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/base/content/test/browser-captivePortal/browser_CaptivePortalWatcher_1.js", "browser/base/content/test/browser-captivePortal/browser_captivePortal_lna.js", "browser/base/content/test/browser-captivePortal/head.js", "browser/base/content/test/browser-general/browser_storagePressure_notification.js", "browser/base/content/test/browser-popups/browser_popup_blocker.js", "browser/components/asrouter/modules/InfoBar.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_infobar.js", "browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/customizableui/content/customizeMode.inc.xhtml", "browser/components/customizableui/test/browser_customize_telemetry.js", "browser/components/downloads/content/downloads.js", "browser/components/downloads/content/downloadsPanel.inc.xhtml", "browser/components/downloads/test/browser/browser.toml", "browser/components/downloads/test/browser/browser_private_downloads_subview.js", "browser/components/nimbus/Heartbeat.sys.mjs", "browser/components/privatebrowsing/ResetPBMPanel.sys.mjs", "browser/components/remotecontrol/RemoteControlPanel.sys.mjs", "browser/components/remotecontrol/content/remoteControlPanel.inc.xhtml", "browser/components/reportbrokensite/ReportBrokenSite.sys.mjs", "browser/components/reportbrokensite/content/reportBrokenSitePanel.inc.xhtml", "browser/components/translations/content/fullPageTranslationsPanel.inc.xhtml", "browser/components/translations/content/fullPageTranslationsPanel.js", "browser/components/translations/content/selectTranslationsPanel.inc.xhtml", "browser/components/translations/content/selectTranslationsPanel.js", "browser/components/translations/tests/browser/head.js", "browser/components/urlbar/tests/browser-search/browser_searchSingleWordNotification.js", "browser/modules/test/browser/browser_ProcessHangNotifications.js", "browser/modules/test/browser/browser_ReducedProtectionNotification.js", "browser/themes/shared/customizableui/customizeMode.css", "browser/themes/shared/customizableui/panelUI-shared.css", "browser/themes/shared/downloads/downloads.inc.css", "browser/themes/shared/translations/panel.css", "dom/media/doctor/test/browser/browser_decoderDoctor.js", "toolkit/components/url-classifier/tests/mochitest/test_reporturl.html", "toolkit/content/tests/chrome/test_notificationbox.xhtml", "toolkit/content/widgets/notificationbox.js", "uriloader/exthandler/tests/mochitest/browser_ftp_protocol_handlers.js", "uriloader/exthandler/tests/mochitest/browser_web_protocol_handlers.js"], "git_node": "0d5d1eeddb7edf2a2a780dae44df0f355956431c", "git_parents": ["1cd8fca6b2778e26a1bafe6e0e8dad23da7f6c70"], "node": "31f86d797417bfb5c386e53c4c6223f54110e332", "parents": ["3615b03607e069566e6fb42634d5d5c388dd947c"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088433 - Dispatch an autocomplete secondary action for its own row, not the selected one. r=mtigley,credential-management-reviewers,reusable-components-reviewers,tgiles\n\n`selectAutoCompleteEntry()` looked up the entry from\n`openedPopup.selectedIndex`, and only `mousemove` selects a row. After a\ndelete, `FormHistoryChild` repopulates the popup, and `ClearResults()`\nsets the selection to -1. The next row moves up under the pointer. Its\ntrash button shows on `:hover`, and its `mousedown` handler stops the\nevent before the richlistitem can select the row. Clicking it did\nnothing until the mouse moved again.\n\nEach row's `activateAction` closure now captures the row index and\npasses it to `selectAutoCompleteEntry(secondary, actionIndex, index)`.\n`index` defaults to `openedPopup.selectedIndex`, so the primary\n`AutoComplete:SelectEntry` path is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340063\n", "files": ["toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_secondary_actions.js", "toolkit/components/satchel/test/browser/browser_popup_secondary_action.js", "toolkit/content/widgets/autocomplete-popup.js"], "git_node": "1af0c8d3cbb92c70a84847b2ec16ce306fdaacbb", "git_parents": ["0d5d1eeddb7edf2a2a780dae44df0f355956431c"], "node": "5d3a2e9c26aaab415aacb651c4a5191fb6187741", "parents": ["31f86d797417bfb5c386e53c4c6223f54110e332"], "tags": []}, {"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077077 - Dispatch the worker memory reporter's runnable through the worker's control event target. r=edenchuang,dom-worker-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338019\n", "files": ["dom/workers/WorkerPrivate.cpp"], "git_node": "7d1c05e5b9e950a72d6951578092919213c96532", "git_parents": ["1af0c8d3cbb92c70a84847b2ec16ce306fdaacbb"], "node": "1ac001ef3e1b06d452644b993b911bb1fc287da1", "parents": ["5d3a2e9c26aaab415aacb651c4a5191fb6187741"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2089199: Add an artifact-build Updatebot option, and use it for the application-services version bump r=RyanVM,android-build-system-reviewers\n\nUpdatebot passes --artifact to ./mach try when a library's moz.yaml sets\nartifact-build: true (mozilla-services/updatebot#450). The application-services\nversion bump doesn't change compiled Gecko code, so its try runs can use\nartifact builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339918\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml", "python/mozbuild/mozbuild/test/test_manifest.py", "python/mozbuild/mozbuild/vendor/docs/template.yaml", "python/mozbuild/mozbuild/vendor/moz_yaml.py"], "git_node": "da99aefb1ba6d5537b39506881092921bae60f76", "git_parents": ["7d1c05e5b9e950a72d6951578092919213c96532"], "node": "644cb9f238c80cc769c1629294c15c6281786c33", "parents": ["1ac001ef3e1b06d452644b993b911bb1fc287da1"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2089199: Remove the platform key from Updatebot moz.yaml tasks r=firefox-build-system-reviewers,sergesanspaille\n\nUpdatebot only runs on Linux, so a moz.yaml asking for a task on another platform\nwould silently never run. Remove the key, so setting it is an error.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341065\n", "files": ["python/mozbuild/mozbuild/test/test_manifest.py", "python/mozbuild/mozbuild/vendor/docs/template.yaml", "python/mozbuild/mozbuild/vendor/moz_yaml.py", "python/mozbuild/mozbuild/vendor/test_vendor_changes.sh"], "git_node": "40da43c4050a6afd70e769df6830618b447988ff", "git_parents": ["da99aefb1ba6d5537b39506881092921bae60f76"], "node": "b1cd7228936202e788ee56598f22f21e9fc79b4b", "parents": ["644cb9f238c80cc769c1629294c15c6281786c33"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2089199: Bump Updatebot r=firefox-build-system-reviewers,sylvestre,sergesanspaille\n\nThis includes:\nAdd an optional artifact-build moz.yaml key that passes --artifact to mach try. Fixes #410\nKeep Sentry events under its size limit, and log events it rejects. Fixes #378\nInclude the revision we vendored in the mach vendor commands we suggest in bug comments. Fixes #71\nLog job statuses and outcomes by name instead of number. Fixes #348\nRetry a failed git clone of a library's upstream repository. Fixes #264\nFix directory change in SCM checkout test\nRemove the code for running Updatebot on Windows. Fixes #204\nDon't log the patches failing to apply during the spurious update check as an error\nAdd a test with the real try results of an intermittent build failure (#453)\nRetrigger builds that failed with a known intermittent instead of reporting a build failure. Fixes #453\nRetry Treeherder errors for bug suggestions, and never retrigger a build twice\nIgnore retriggers people made when deciding whether we've retriggered a build\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341066\n", "files": ["taskcluster/docker/updatebot/updatebot-version.sh"], "git_node": "73602dfc2d0970c189362ccc505f0c2a9999bc16", "git_parents": ["40da43c4050a6afd70e769df6830618b447988ff"], "node": "f0720d578a34edad565bc0202e3b5f70f230e7f5", "parents": ["b1cd7228936202e788ee56598f22f21e9fc79b4b"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091550 - Use generic error for vpn unavailable - r=ip-protection-reviewers,lesleynorton\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341608\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_status_box.js"], "git_node": "145735c0d0f99ce70e5159db330fa8558ac9b5cb", "git_parents": ["73602dfc2d0970c189362ccc505f0c2a9999bc16"], "node": "d630d5c13318b7781af9c5ac5696d991e26df5a9", "parents": ["f0720d578a34edad565bc0202e3b5f70f230e7f5"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091323 - Number the accesskeys of spelling suggestions and dictionaries. r=reusable-components-reviewers,tgiles\n\nExtension items with no typeable letter share that numbering, so past nine they now get 0 and then wrap around and cycle where they used to go without an accesskey.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336135\n", "files": ["browser/base/content/test/browser-contextMenu/browser_contextmenu_spellcheck.js", "toolkit/content/tests/chrome/test_menu_accesskey_conflicts.xhtml", "toolkit/content/widgets/auto-accesskey.mjs", "toolkit/modules/InlineSpellChecker.sys.mjs"], "git_node": "f35e967e822dcf3deea7b82a618032a7d26070fd", "git_parents": ["145735c0d0f99ce70e5159db330fa8558ac9b5cb"], "node": "1070d7fbe4d2cfd43573b0ec5399648f1e71c831", "parents": ["d630d5c13318b7781af9c5ac5696d991e26df5a9"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089582 - Bail out early from Document::EditingStateChanged for non-HTML/XHTML documents. r=masayuki,ltenenbaum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341212\n", "files": ["dom/base/Document.cpp"], "git_node": "722206359759697780a3e840345923c185b2c8cd", "git_parents": ["f35e967e822dcf3deea7b82a618032a7d26070fd"], "node": "91d56937cfd6453346981906a6ec98e60d29776d", "parents": ["1070d7fbe4d2cfd43573b0ec5399648f1e71c831"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2087979 - Compare the rounded event timing duration against durationThreshold. r=bas\n\nThe threshold checks used the raw duration while the duration getter\nexposes the value rounded to 8ms, so observers could get entries below\ntheir threshold.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338655\n", "files": ["dom/performance/PerformanceEventTiming.cpp", "dom/performance/PerformanceMainThread.cpp"], "git_node": "eeb1a3fb3603dcd4c3e7c77d27faf823ba261788", "git_parents": ["722206359759697780a3e840345923c185b2c8cd"], "node": "1d98215fc30512abebeba96985b2a286d1711377", "parents": ["91d56937cfd6453346981906a6ec98e60d29776d"], "tags": []}], "date": 1794375100, "git_changesets": ["464b0cfab6e8773f563768329505a8a310908639", "12f750a10326ae9cdeb8e8d686aec4038321a5a3", "e5d79af54c8063120856e72cc8cf7679fbcc15f9", "bafa1af235625445ffda24c273080e6c821b17ed", "afa5169787e00cb94ad120139feb8fe2795040f7", "f5f03864b6bcf7bc57a56fcbf056dbd08e75159e", "d19513b12b2b842aaadc5a3e1a79ca9d76592685", "27ff3068f6069c553344d03747523d7420811b65", "d13b1ab8a543f1a9c551c8e69433f5317be94f86", "3d102ba7c44c23d65b0a9b4f13b72f2c30f881aa", "b4a977d317817389097e0fdcd5be441455a3a823", "b100228694be4520ef39901a634383d48031187f", "2fc928d24fc