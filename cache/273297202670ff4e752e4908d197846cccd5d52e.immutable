/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/tabs/TabGroupTools.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/FenixTabGroupsFeatureDiscoveryConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/TabGroupMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/TabGroupsFeatureDiscoveryConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/repository/uistate/TabManagerUiStateDataStore.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/repository/uistate/TabManagerUiStateRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/repository/uistate/data/PersistedUIState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/bindings/NormalTabToolbarMenuHighlightBindingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuItemProvidersFactoryTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/middleware/ToolbarMenuHighlightMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/toolbar/BrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/FenixTabGroupsFeatureDiscoveryConfigurationTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/TabGroupMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/fake/FakeTabGroupsFeatureDiscoveryConfiguration.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/fakes/FakeTabManagerUiStateRepository.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/repository/uistate/DefaultTabManagerUiStateRepositoryTest.kt"], "git_node": "d5d1b01886fce10a1652dea8f81c4dfc1fd0b470", "git_parents": ["2d000acda636f1f47b69928f3b00dc7baa41a30a"], "node": "fc0f4e8f91c8d2babf097c74b3036ed98c7fed50", "parents": ["ad6774037d8c7a20b23b32f332addf67c94415de"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2092364 - Allocate WebGL AHardwareBuffers with GPU-only usage flags r=gfx-reviewers,lsalzman\n\nAdd an optional usage parameter to AndroidHardwareBuffer::Create(), preserving the existing flags as kDefaultUsage. Allocate WebGL shared surfaces with only GPU sampling and color output flags, since their readback paths use GL rather than direct CPU mapping.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342407\n", "files": ["gfx/gl/SharedSurfaceAndroidHardwareBuffer.cpp", "gfx/layers/AndroidHardwareBuffer.cpp", "gfx/layers/AndroidHardwareBuffer.h"], "git_node": "7e2a39c54e865a6e93832daec2dfc45a7f1bad72", "git_parents": ["d5d1b01886fce10a1652dea8f81c4dfc1fd0b470"], "node": "4746460abfd357f5d7c2339c6c34b590d3c2164f", "parents": ["fc0f4e8f91c8d2babf097c74b3036ed98c7fed50"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2092367 - Reset shared video processor HDR state between video streams in DCLayerTree r=gfx-reviewers,lsalzman\n\nTrack AutoHDR state on the shared VideoProcessor in DCLayerTree and disable it when no longer needed. Clear input and output HDR metadata when absent, and retry without AutoHDR if enabling it fails.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342413\n", "files": ["gfx/webrender_bindings/DCLayerTree.cpp", "gfx/webrender_bindings/DCLayerTree.h"], "git_node": "a851ca18efb96bed45427b2e17088afc360e7ce0", "git_parents": ["7e2a39c54e865a6e93832daec2dfc45a7f1bad72"], "node": "5878f7d886809263f056b73d913fb51eeea48297", "parents": ["4746460abfd357f5d7c2339c6c34b590d3c2164f"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2090123 - part 1: Make `HTMLEditor::GetTableCellElementAt` callers ignore generated cell r=m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341688\n", "files": ["editor/libeditor/HTMLEditor.cpp", "editor/libeditor/HTMLEditor.h", "editor/libeditor/HTMLEditorInlines.h", "editor/libeditor/HTMLTableEditor.cpp"], "git_node": "3e4ea02a32a23151ae7a4c8c4af5416d88073dea", "git_parents": ["a851ca18efb96bed45427b2e17088afc360e7ce0"], "node": "3674d1ce15741571059f4ef2319edf17d9b9b48b", "parents": ["5878f7d886809263f056b73d913fb51eeea48297"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2090123 - part 2: Make `EditorBase::CollapseSelectionTo` return error if the editor tries to collapse selection into a native anonymous subtree r=m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341689\n", "files": ["editor/libeditor/EditorBase.h"], "git_node": "fc36f59627142b1d2c333b48405c494860258488", "git_parents": ["3e4ea02a32a23151ae7a4c8c4af5416d88073dea"], "node": "3bf785df7d5d88e49a28cc4f5ffbd2345e346026", "parents": ["3674d1ce15741571059f4ef2319edf17d9b9b48b"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2090123 - part 3: Make the style editor ensure handling only editable ranges r=m_kato\n\nChrome considers whether a range is editable with the start boundary\ncontainer. However, if only the start boundary container is editable,\nonly editable nodes are styled with `execCommand`.\n\nOn the other hand, we don't check it first. Therefore, the range may\nstart or end at non-editable node and that may cause modifying the\nnon-editable node.\n\nFor now, we should ignore ranges whose start or end container is\nnon-editable to avoid the case that the non-editable reason is that\nit's in native anonymous subtree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341690\n", "files": ["editor/libeditor/AutoClonedRangeArray.cpp", "editor/libeditor/HTMLStyleEditor.cpp", "testing/web-platform/meta/editing/run/bold.html.ini", "testing/web-platform/tests/editing/data/bold.js"], "git_node": "c095f8466ada4f9d45e7f6ffb39ac92d96cc09cb", "git_parents": ["fc36f59627142b1d2c333b48405c494860258488"], "node": "ea4e0fdf3a5a4fcf92ac4b2a67c50f07ed3ddbe5", "parents": ["3bf785df7d5d88e49a28cc4f5ffbd2345e346026"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2090123 - part 3: Make the style editor ensure handling only editable ranges r=m_kato\" for causing build bustages on HTMLStyleEditor.\n\nThis reverts commit c095f8466ada4f9d45e7f6ffb39ac92d96cc09cb.\n\nRevert \"Bug 2090123 - part 2: Make `EditorBase::CollapseSelectionTo` return error if the editor tries to collapse selection into a native anonymous subtree r=m_kato\"\n\nThis reverts commit fc36f59627142b1d2c333b48405c494860258488.\n\nRevert \"Bug 2090123 - part 1: Make `HTMLEditor::GetTableCellElementAt` callers ignore generated cell r=m_kato\"\n\nThis reverts commit 3e4ea02a32a23151ae7a4c8c4af5416d88073dea.\n", "files": ["editor/libeditor/AutoClonedRangeArray.cpp", "editor/libeditor/EditorBase.h", "editor/libeditor/HTMLEditor.cpp", "editor/libeditor/HTMLEditor.h", "editor/libeditor/HTMLEditorInlines.h", "editor/libeditor/HTMLStyleEditor.cpp", "editor/libeditor/HTMLTableEditor.cpp", "testing/web-platform/meta/editing/run/bold.html.ini", "testing/web-platform/tests/editing/data/bold.js"], "git_node": "31bbc88bd3374c99bea9b21d03477016e290f6ac", "git_parents": ["c095f8466ada4f9d45e7f6ffb39ac92d96cc09cb"], "node": "a1353016775a4af716d6d086a34dce56674d4368", "parents": ["ea4e0fdf3a5a4fcf92ac4b2a67c50f07ed3ddbe5"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2091623: Let Updatebot clone V8 and PDF.js from the copies in its image. r=firefox-build-system-reviewers,sergesanspaille\n\nThe image has clones of V8 and PDF.js, which mach vendor brings up to\nthe revision being vendored. Updatebot then clones the same repository\nagain from scratch to list the commits in the update. Give Updatebot a\nfile mapping those libraries to the copies, so that its clones borrow\nobjects from them and download only what they lack, and stop git from\ngarbage collecting the copies out from under those clones.\n\nUpdatebot ignores the new setting until it is bumped to a revision that\nreads it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341819\n", "files": ["taskcluster/docker/updatebot/Dockerfile", "taskcluster/docker/updatebot/pre-existing-repos.json", "taskcluster/docker/updatebot/privileged-setup.sh", "taskcluster/docker/updatebot/run.py"], "git_node": "606d4e50a982d1d2a383853ca998eb93b9972a71", "git_parents": ["31bbc88bd3374c99bea9b21d03477016e290f6ac"], "node": "5bb550c7dbea8035dd349bde403d051d0b2465e5", "parents": ["a1353016775a4af716d6d086a34dce56674d4368"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2090123 - part 1: Make `HTMLEditor::GetTableCellElementAt` callers ignore generated cell r=m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341688\n", "files": ["editor/libeditor/HTMLEditor.cpp", "editor/libeditor/HTMLEditor.h", "editor/libeditor/HTMLEditorInlines.h", "editor/libeditor/HTMLTableEditor.cpp"], "git_node": "159d7613e3ccb4b7d4f85a9859f87c933241c128", "git_parents": ["606d4e50a982d1d2a383853ca998eb93b9972a71"], "node": "768237af6fe4e51e6bad9cad31a95601e8f9a160", "parents": ["5bb550c7dbea8035dd349bde403d051d0b2465e5"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2090123 - part 2: Make `EditorBase::CollapseSelectionTo` return error if the editor tries to collapse selection into a native anonymous subtree r=m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341689\n", "files": ["editor/libeditor/EditorBase.h"], "git_node": "89e1e28730e1602e5028ad3c7abf59eb06c34922", "git_parents": ["159d7613e3ccb4b7d4f85a9859f87c933241c128"], "node": "b7c6a01c92dc7d4275cc9ffd75e261f405e2a7c4", "parents": ["768237af6fe4e51e6bad9cad31a95601e8f9a160"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2090123 - part 3: Make the style editor ensure handling only editable ranges r=m_kato\n\nChrome considers whether a range is editable with the start boundary\ncontainer. However, if only the start boundary container is editable,\nonly editable nodes are styled with `execCommand`.\n\nOn the other hand, we don't check it first. Therefore, the range may\nstart or end at non-editable node and that may cause modifying the\nnon-editable node.\n\nFor now, we should ignore ranges whose start or end container is\nnon-editable to avoid the case that the non-editable reason is that\nit's in native anonymous subtree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341690\n", "files": ["editor/libeditor/AutoClonedRangeArray.cpp", "editor/libeditor/HTMLStyleEditor.cpp", "testing/web-platform/meta/editing/run/bold.html.ini", "testing/web-platform/tests/editing/data/bold.js"], "git_node": "7d141c850d534d1ffbe2f08b6796aa620712a7d1", "git_parents": ["89e1e28730e1602e5028ad3c7abf59eb06c34922"], "node": "5f90236516382f6d1db6a434c6225e60e31e7ad0", "parents": ["b7c6a01c92dc7d4275cc9ffd75e261f405e2a7c4"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2087937 - Proper \u003crandom-ua-ident\u003e for early substituted random() in substitution functions. r=firefox-style-system-reviewers,emilio\n\nBug 2080511 added support for arbitrary substitution functions that parse their\narguments at substitution/computed-value time. This is called early substitution\nand it affects the prefix used by `property-scoped` / `property-index-scoped` random\nkeys -- for example, when `random()` is used in attribute values of a typed `attr()`,\nthe conditions of `if()`, or the `ident()` function.\n\nGenerating the correct `\u003crandom-ua-ident\u003e` for such random keys requires adding a\nparsing mode to indicate early substitution, and introducing a separate counter for\nearly `random()` functions. This patch also propagates the correct property name\nthrough the entire substitution process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338646\n", "files": ["servo/components/style/custom_properties.rs", "servo/components/style/parser.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/mod.rs", "servo/components/style/properties_and_values/value.rs", "servo/components/style/substitution/attr.rs", "servo/components/style/substitution/env.rs", "servo/components/style/substitution/mod.rs", "servo/components/style/values/specified/random.rs", "servo/components/style_traits/lib.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/tests/css/css-values/random-computed.tentative.html"], "git_node": "424e490bbe648cd9f849874bcf0adc8797a47a44", "git_parents": ["7d141c850d534d1ffbe2f08b6796aa620712a7d1"], "node": "c4c9ead74e0d40fa3d7deb78ab8310b7707362de", "parents": ["5f90236516382f6d1db6a434c6225e60e31e7ad0"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2087544 - Optimize invalidation for attr() in container queries with nested substitution functions. r=firefox-style-system-reviewers,emilio\n\nPreviously, the presence of any container query with an unparsed `attr()` function\nwould cause all container elements to restyle style-query-dependent descendants on\nall attribute changes, since it's not known which attribute will eventually be used\nwhen evaluating the query. It also caused all elements to snapshot all attributes\nwhen they're modified. This patch optimizes invalidation by:\n\n- When collecting stylesheet rules, tracking all container query conditions with\n  any unparsed `attr()` functions.\n- When evaluating a container query, adding a flag to evaluated container elements\n  if the container query had an unparsed `attr()` function.\n- When handling a modified attribute, if the element has the new flag, evaluating\n  tracked container queries on the element to see if the attribute was referenced.\n\nThis tracking and flag approach is over-broad in that all container query conditions\nwith unparsed `attr()` functions are evaluated on the element, since the flag doesn't\nindicate /which/ query condition was evaluated on the container. Still, this isolates\nthe effect of attribute modification and invalidation to just the relevant containers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338647\n", "files": ["dom/base/nsINode.h", "layout/style/test/mochitest.toml", "layout/style/test/test_invalidation_container_query_unparsed_attr.html", "servo/components/selectors/matching.rs", "servo/components/style/gecko/wrapper.rs", "servo/components/style/stylesheets/container_rule.rs", "servo/components/style/stylist.rs", "testing/web-platform/tests/css/css-conditional/container-queries/style-query-custom-attr-nested-name-change.html"], "git_node": "6f691c9a234b652f265cf2d7e8c360237685a901", "git_parents": ["424e490bbe648cd9f849874bcf0adc8797a47a44"], "node": "7afb81d38121376980fe432b98fe68f7335aa379", "parents": ["c4c9ead74e0d40fa3d7deb78ab8310b7707362de"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2091710 - Implement CSS inherit() substitution function. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341682\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "servo/components/style/custom_properties.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/substitution/inherit.rs", "servo/components/style/substitution/mod.rs", "servo/components/style/substitution/var.rs", "testing/web-platform/meta/css/__dir__.ini", "testing/web-platform/meta/css/css-properties-values-api/custom-property-explicit-inherit-invalidation.html.ini", "testing/web-platform/meta/css/css-values/inherit-function-basic.html.ini", "testing/web-platform/meta/css/css-values/inherit-function-invalidation.html.ini", "testing/web-platform/meta/css/css-values/inherit-function-parsing.html.ini", "testing/web-platform/tests/css/css-values/inherit-function-basic.html", "testing/web-platform/tests/css/css-values/inherit-function-invalidation.html"], "git_node": "c881f64879c8ec0d0c5bb3271cd47e423dd1bc4a", "git_parents": ["6f691c9a234b652f265cf2d7e8c360237685a901"], "node": "86467aa65610ef7db2786a25376999b98662d900", "parents": ["7afb81d38121376980fe432b98fe68f7335aa379"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091197 - Part 1: Add a composer to the Widget Studio. r=nina-py,fluent-reviewers,flod\n\nAdds a `widget-composer` element to the bottom of the sidebar panel for writing the widget prompt.\n\n- Enter sends a `WidgetComposer:Submit` event with the trimmed prompt.\n- Shift+Enter adds a new line.\n- Escape sends a `WidgetComposer:Dismiss` event.\n- Submit is disabled until the prompt has text.\n- Adds a \"New widget\" button that opens the composer.\n- Focusing the sidebar panel moves focus into the composer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341583\n", "files": ["browser/components/widgets/content/sidebar-widget-studio.css", "browser/components/widgets/content/sidebar-widget-studio.mjs", "browser/components/widgets/content/widget-composer.css", "browser/components/widgets/content/widget-composer.mjs", "browser/components/widgets/jar.mn", "browser/components/widgets/tests/browser/browser_sidebar_widget_studio.js", "browser/components/widgets/tests/chrome/chrome.toml", "browser/components/widgets/tests/chrome/test_widget_composer.html", "browser/locales-preview/widgets.ftl"], "git_node": "05e51ebabd7386b38febcf79af2ba81d48fe9712", "git_parents": ["c881f64879c8ec0d0c5bb3271cd47e423dd1bc4a"], "node": "eea803a58d945a996d6cd39240c40682dbfc3e3a", "parents": ["86467aa65610ef7db2786a25376999b98662d900"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091197 - Part 2: Only show the widget composer when authenticated. r=nina-py\n\nAdds a Lit reactive controller to track FxA sign-in status.\n\nThe widget studio subscribes to it with `new AuthenticationController(this)` and reads `authenticated` while rendering. Account changes update that boolean and request an update.\n\n- Observes `UIState.ON_UPDATE` to get changes to the account status.\n- Shows the composer and the \"New widget\" button only when signed in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341584\n", "files": ["browser/components/widgets/AuthenticationController.sys.mjs", "browser/components/widgets/content/sidebar-widget-studio.mjs", "browser/components/widgets/moz.build", "browser/components/widgets/tests/browser/browser_generated_widgets.js", "browser/components/widgets/tests/browser/browser_sidebar_widget_studio.js", "browser/components/widgets/tests/browser/head.js"], "git_node": "7970cb8523fdb03261bbda7ac0f825994731557b", "git_parents": ["05e51ebabd7386b38febcf79af2ba81d48fe9712"], "node": "0f8e3eeb239e65d55b9334e5266b09a7da80cec8", "parents": ["eea803a58d945a996d6cd39240c40682dbfc3e3a"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091650 - Report only the real schema mismatch in SessionSta