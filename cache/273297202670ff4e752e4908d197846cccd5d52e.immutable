["devtools/client/netmonitor/src/components/messages/ColumnSize.js", "devtools/client/netmonitor/src/components/messages/MessagePayload.js", "devtools/client/netmonitor/src/selectors/messages.js", "devtools/client/netmonitor/test/websockets/browser.toml", "devtools/client/netmonitor/test/websockets/browser_net_ws-utf8.js", "devtools/server/actors/resources/websockets.js", "devtools/server/tests/xpcshell/test_websocket_watcher.js"], "git_node": "b336405fd9a9f6656cf88b31b9a8652b204709ed", "git_parents": ["69055218068ed7602b79bb5b5a4726bf95653dfe"], "node": "ae5cac4fe3a589dcb2bfe8ea9eeae952b61afbe4", "parents": ["01303d6fefe6cf6c6be69c9fac989aa05ae29a8e"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2028654, Bug 2084819, Bug 2073261, Bug 2073260 - Re-enable SmartWindow telemetry tests on Windows debug standalone r=jlewis\" for causing bc failures @browser_smartwindow_first_action_log_telemetry.js.\n\nThis reverts commit 2e0e9761433d40858fa69eb32974072e61eb5d09.\n\nRevert \"Bug 2084819 - Fix overlapping starter prompt cancellation r=jlewis\"\n\nThis reverts commit 8cea3fea73250957e652967273b1e4f8ed8841d6.\n\nRevert \"Bug 2084819 - Prefer reduced motion in SmartWindow chaos tests r=jlewis\"\n\nThis reverts commit 83224a7d2fb3837d90a749cb302654506db72f38.\n\nRevert \"Bug 2084819 - Disable semantic history in SmartWindow prompts tests r=jlewis\"\n\nThis reverts commit d909f502a2323f1616ea009a4da1d885aaf6a532.\n\nRevert \"Bug 2084819 - Stabilize SmartWindow prompts test readiness and runtime r=jlewis\"\n\nThis reverts commit bd6147c3e750b768beee71690cefa5c6414f0a98.\n\nRevert \"Bug 2084819 - Control search-handoff responses and cleanup r=jlewis,omarg\"\n\nThis reverts commit 300a5bfddcf6d3b45646f9f0896babe77e364385.\n\nRevert \"Bug 2084819 - Finish HTTP chat work in request/response telemetry tests r=jlewis\"\n\nThis reverts commit 91ebfd0200f49841c7eabdd1991ab35892dd1356.\n\nRevert \"Bug 2084819 - Split SmartWindow request/response telemetry tests r=jlewis\"\n\nThis reverts commit a16df6fbb8ec9223326c818594ca595163dc9041.\n\nRevert \"Bug 2073261 - Cover turn completion telemetry across search handoff r=jlewis\"\n\nThis reverts commit 8b269775adb167137428f42cabd6e4f9a9626c4e.\n\nRevert \"Bug 2073261 - Measure completed chat turns r=jlewis,mzhang\"\n\nThis reverts commit 608183c27636bc73902f77d6d385370dfd749224.\n\nRevert \"Bug 2073260 - Cover action-log telemetry across search handoff r=jlewis\"\n\nThis reverts commit 234f5efdba8852b325c4dba6ad2c4ac7c48dfa77.\n\nRevert \"Bug 2073260 - Measure time to first rendered action log r=jlewis\"\n\nThis reverts commit 231465e64156164c3a9faf65361346e662b5c2f5.\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/ui/actors/AIChatContentChild.sys.mjs", "browser/components/aiwindow/ui/actors/AIChatContentParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_first_action_log_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_first_turn_direct_answer_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_first_turn_outcomes_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_first_turn_sidebar_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_first_turn_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_first_turn_work_counts_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_request_response_build_errors_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_request_response_retry_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_request_response_stream_errors_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_request_response_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_run_search.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_run_search_telemetry.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/aiwindow/ui/test/browser/head_smartwindow_first_turn_telemetry.js", "browser/components/aiwindow/ui/test/browser/head_smartwindow_request_response_telemetry.js"], "git_node": "67f7faaf7bf651c307e16c97deda0761afe62ad9", "git_parents": ["b336405fd9a9f6656cf88b31b9a8652b204709ed"], "node": "6eaaaaff0ee5d610f31d1d585f71b0302afcd372", "parents": ["ae5cac4fe3a589dcb2bfe8ea9eeae952b61afbe4"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050939 - Remove invisible select subtree. r=accessibility-platform-reviewers,Jamie,devtools-reviewers,morgan,ochameau\" for causing lint failures @browser_accessibility_keyboard_audit.js.\n\nThis reverts commit 69055218068ed7602b79bb5b5a4726bf95653dfe.\n", "files": ["accessible/base/HTMLMarkupMap.inc", "accessible/base/nsAccessibilityService.cpp", "accessible/base/nsCoreUtils.cpp", "accessible/generic/DocAccessible.cpp", "accessible/generic/LocalAccessible.cpp", "accessible/html/HTMLSelectAccessible.cpp", "accessible/html/HTMLSelectAccessible.h", "accessible/tests/browser/e10s/browser_caching_value.js", "accessible/tests/browser/e10s/browser_obj_group.js", "accessible/tests/browser/e10s/browser_treeupdate_optgroup.js", "accessible/tests/browser/e10s/doc_language.html", "accessible/tests/browser/mac/browser_popupbutton.js", "accessible/tests/browser/name_and_description/browser_name_markup.js", "accessible/tests/browser/selectable/browser_test_select.js", "accessible/tests/browser/states/browser.toml", "accessible/tests/browser/states/browser_test_select_visibility.js", "accessible/tests/browser/tree/browser_select.js", "accessible/tests/mochitest/attributes/test_obj_group.html", "accessible/tests/mochitest/elm/test_HTMLSpec.html", "accessible/tests/mochitest/events/test_coalescence.html", "accessible/tests/mochitest/events/test_focus_selects.html", "accessible/tests/mochitest/events/test_selection.html", "accessible/tests/mochitest/name/markuprules.xml", "accessible/tests/mochitest/relations/test_general.html", "accessible/tests/mochitest/states/test_selects.html", "accessible/tests/mochitest/tree/test_select.html", "accessible/tests/mochitest/treeupdate/test_optgroup.html", "accessible/tests/mochitest/treeupdate/test_select.html", "devtools/server/tests/browser/browser_accessibility_keyboard_audit.js", "testing/web-platform/tests/html-aam/roles.html"], "git_node": "68ffee116d0b78672931e2566ec3fa08cf423df7", "git_parents": ["67f7faaf7bf651c307e16c97deda0761afe62ad9"], "node": "4aab83fff42a481bc9e542c32d3bf924d1a10fa2", "parents": ["6eaaaaff0ee5d610f31d1d585f71b0302afcd372"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2090001 - Disable forced AImageReader and ANGLE in Android Java media tests r=media-playback-reviewers,alwu\n\nThe Android Java media test variant runs media tests using the Java MediaCodec pipeline instead of the NDK MediaCodec pipeline.\n\nJava MediaCodec uses Android SurfaceTexture. The SurfaceTexture usage causes tests failures when either AImageReader is forced or ANGLE is enabled, so both preferences must be disabled for the Java media test variant.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340382\n", "files": ["taskcluster/test_configs/variants.yml"], "git_node": "4f6b3b85cd0e343ec06ff4f640d163fbe5ffb012", "git_parents": ["68ffee116d0b78672931e2566ec3fa08cf423df7"], "node": "d5a6e2713eb8482add25da24b8ba84a3f9098315", "parents": ["4aab83fff42a481bc9e542c32d3bf924d1a10fa2"], "tags": []}, {"author": "Atharva Wadodkar \u003catharva.wadodkar2003@gmail.com\u003e", "branch": "default", "desc": "Bug 2085966 - Group the parameters of GeckoSession.Compositor.notifyCompositorScrollUpdate into a ScrollPositionUpdate. r=botond,geckoview-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337618\n", "files": ["gfx/layers/apz/src/APZCTreeManager.cpp", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "widget/android/nsWindow.cpp"], "git_node": "d9ed631134be6cfa89c8158668e405e4b613e113", "git_parents": ["4f6b3b85cd0e343ec06ff4f640d163fbe5ffb012"], "node": "120a9e87bf2ed9b0d4c2c439f1566dfcf88cae7f", "parents": ["d5a6e2713eb8482add25da24b8ba84a3f9098315"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090333 - Reduce the gap between the moz-widget header and content. r=mconley\n\nPadded moz-widget cards now leave --space-xsmall between the header and\ncontent, the same spacing as the other New Tab widgets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340546\n", "files": ["browser/components/widgets/content/moz-widget.css"], "git_node": "da8837339cadcc1d3d884be7274a4471119b70f0", "git_parents": ["d9ed631134be6cfa89c8158668e405e4b613e113"], "node": "1066fb20848e8a1bb04d322944f5912d0653c9df", "parents": ["120a9e87bf2ed9b0d4c2c439f1566dfcf88cae7f"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073260 - Measure time to first rendered action log r=jlewis\n\nThis commit records request latency when SmartWindow displays its first\naction-log entry. This event records independently of the first-character\ntelemetry event, since a tool call may happen before an assistant message,\nafter an assistant message, or not at all during a chat.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332935\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/actors/AIChatContentChild.sys.mjs", "browser/components/aiwindow/ui/actors/AIChatContentParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_first_action_log_telemetry.js"], "git_node": "a7b05999d6d985c5f6799f08494627aa3836bf66", "git_parents": ["da8837339cadcc1d3d884be7274a4471119b70f0"], "node": "e97e5a5de00d623d69e054b51dd3ddff7d3f4f87", "parents": ["1066fb20848e8a1bb04d322944f5912d0653c9df"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073260 - Cover action-log telemetry across search handoff r=jlewis\n\nThis commit verifies that a pending search action log records against the\noriginal request before navigation and remains a single event after the\nconversation continues in the sidebar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332936\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_smartwindow_run_search_telemetry.js"], "git_node": "0c3f4943f881c3e8116193cf0973e506d9fa1876", "git_parents": ["a7b05999d6d985c5f6799f08494627aa3836bf66"], "node": "5f8e1a66e08c9aabe58a9c46996c8386cb5f3032", "parents": ["e97e5a5de00d623d69e054b51dd3ddff7d3f4f87"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073261 - Measure completed chat turns r=jlewis,mzhang\n\nThis commit records completion duration and work counts for each\nsuccessful non-retry chat turn. The turn index and initial context size\nallow dashboards to distinguish the first turn from later turns.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333003\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_first_turn_direct_answer_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_first_turn_outcomes_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_first_turn_sidebar_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_first_turn_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_first_turn_work_counts_telemetry.js", "browser/components/aiwindow/ui/test/browser/head_smartwindow_first_turn_telemetry.js"], "git_node": "81331e0108f22373cb02bfe910e004f85c87de15", "git_parents": ["0c3f4943f881c3e8116193cf0973e506d9fa1876"], "node": "1ab94b4b56b4374ca38cdc87405e5e71b4629770", "parents": ["5f8e1a66e08c9aabe58a9c46996c8386cb5f3032"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073261 - Cover turn completion telemetry across search handoff r=jlewis\n\nThis commit verifies that search handoff does not prematurely record\nturn completion and documents the missing completion event as an\nexpected failure under bug 2075708.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333004\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_smartwindow_run_search_telemetry.js"], "git_node": "3ec955d19182ff9c4aa8cde73959427ac47922e9", "git_parents": ["81331e0108f22373cb02bfe910e004f85c87de15"], "node": "64639a18dc1cea1f8c606bcdb3347df2d33d0fda", "parents": ["1ab94b4b56b4374ca38cdc87405e5e71b4629770"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084819 - Split SmartWindow request/response telemetry tests r=jlewis\n\nThis commit separates the existing cases into success, build-error,\nstream-error, and retry test files with shared setup. Test bodies and\nassertions are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336082\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_request_response_build_errors_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_request_response_retry_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_request_response_stream_errors_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_request_response_telemetry.js", "browser/components/aiwindow/ui/test/browser/head_smartwindow_request_response_telemetry.js"], "git_node": "e8d2c60e7f2e0937e5ac24f6932f40ff19272be7", "git_parents": ["3ec955d19182ff9c4aa8cde73959427ac47922e9"], "node": "b294c90e3d6bbdf3266aa4432d4356ed1a61d9ad", "parents": ["64639a18dc1cea1f8c606bcdb3347df2d33d0fda"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084819 - Finish HTTP chat work in request/response telemetry tests r=jlewis\n\nThis commit gives successful request/response telemetry tests an owned\nHTTP chat fixture and waits for response and title work before advancing\nto another conversation or closing the window.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336083\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_smartwindow_request_response_telemetry.js"], "git_node": "19368b4a005b78e7c60e10f9622a9a4818fc4856", "git_parents": ["e8d2c60e7f2e0937e5ac24f6932f40ff19272be7"], "node": "f7165342a3f93297002866fa6260fdb7dc8464ad", "parents": ["b294c90e3d6bbdf3266aa4432d4356ed1a61d9ad"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084819 - Control search-handoff responses and cleanup r=jlewis,omarg\n\nThis commit uses engine and search mocks to complete search handoffs\nthrough the real chat and sidebar paths.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336084\n", "files": ["browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_run_search.js"], "git_node": "144a4a5954340b8240cf3b93f28c412b774f806c", "git_parents": ["19368b4a005b78e7c60e10f9622a9a4818fc4856"], "node": "56559d90748547b39a250ca8d174b33b1679091f", "parents": ["f7165342a3f93297002866fa6260fdb7dc8464ad"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084819 - Stabilize SmartWindow prompts test readiness and runtime r=jlewis\n\nThis commit waits for the chat content shadow root before observing its\nfooter and allows the prompts test file more time to finish.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336085\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js"], "git_node": "532179c4152e4fa972670522ec9aad53ed3966a1", "git_parents": ["144a4a5954340b8240cf3b93f28c412b774f806c"], "node": "589b7cbecb845fcf9a9f962abeefa7e0f1c511b1", "parents": ["56559d90748547b39a250ca8d174b33b1679091f"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084819 - Disable semantic history in SmartWindow prompts tests r=jlewis\n\nThis commit disables semantic-history background work in the prompts test\nfile to avoid embedding-model initialization during prompt UI tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336086\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js"], "git_node": "5c30d063e7848057ac081c53c80edb6b97f3bdbe", "git_parents": ["532179c4152e4fa972670522ec9aad53ed3966a1"], "node": "241f9bb73cec7aed6153546718f5c1eafffbd3ab", "parents": ["589b7cbecb845fcf9a9f962abeefa7e0f1c511b1"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084819 - Prefer reduced motion in SmartWindow chaos tests r=jlewis\n\nThis commit requests reduced motion for SmartWindow tests running under\nMOZ_CHAOSMODE. Other test runs retain their existing animation settings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336087\n", "files": ["browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "4e7cf41380a1d50e38b332c1bd9169bd86c166b0", "git_parents": ["5c30d063e7848057ac081c53c80edb6b97f3bdbe"], "node": "0115ba9e928f387625fd81d77d5cfb328e6d3d79", "parents": ["241f9bb73cec7aed6153546718f5c1eafffbd3ab"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084819 - Fix overlapping starter prompt cancellation r=jlewis\n\nThis commit preserves cancellation of the latest starter load when an\nolder load finishes, preventing prompts from reappearing after chat\nsubmission. A regression test exercises the overlapping loads before\nconversation messages arrive.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336088\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js"], "git_node": "86d9aef45ae4346f8760a7f906167647622b3326", "git_parents": ["4e7cf41380a1d50e38b332c1bd9169bd86c166b0"], "node": "54c580e321834289c5efa0040c817d79394b4d48", "parents": ["0115ba9e928f387625fd81d77d5cfb328e6d3d79"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028654 - Re-enable SmartWindow telemetry tests on Windows debug standalone r=jlewis\n\nThis commit restores SmartWindow telemetry test coverage on\nWindows debug standalone builds by removing the skips associated\nwith Bug 2028654.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336089\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/head_smartwindow_request_response_telemetry.js"], "git_node": "8b848e114a9869591cbfd5bad37803502b118ddb", "git_parents": ["86d9aef45ae4346f8760a7f906167647622b3326"], "node": "b8a09eec1c70f03076838a95bacad3b3c7ce6440", "parents": ["54c580e321834289c5efa0040c817d79394b4d48"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2090328 - [riscv64] Fold the low twelve bits of an absolute address into the access. r=csmantle\n\nload32, loadPtr, store32 and storePtr of an AbsoluteAddress, and inc64,\nloaded the whole address into a scratch register and then accessed\noffset 0 through it. ma_li ends the address with an addi of its low\ntwelve bits, which the access's own 12-bit offset can take instead, so\nload the address without them and use them as the offset. The branch32,\nbranchPtr and branchTest32 overloads that take an AbsoluteAddress go\nthrough load32 and loadPtr.\n\nThe stack limit check in an Ion prologue:\n\n  lui   t5, 0xfe4\n  addiw t5, t5, 0x58f\n  slli  t5, t5, 0xe\n  addi  t5, t5, 0x218\n  ld    t4, 0x0(t5)\n  bgeu  t4, sp, \u003cool\u003e\n\nbecomes\n\n  lui   t5, 0xfe4\n  addiw t5, t5, 0x58f\n  slli  t5, t5, 0xe\n  ld    t4, 0x218(t5)\n  bgeu  t4, sp, \u003cool\u003e\n\nIn a JetStream 3 run on a SpacemiT K3 this shortens about 226,000\naccesses by an instruction each: 118,000 in Ion code, 86,000 in Baseline\ncode and 21,000 in regexps. Code that loads such an address with movePtr\nand then accesses it, like the nursery's bump allocation, is unchanged.\n\nFound with riscvlint.\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340539\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64-inl.h", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.h"], "git_node": "143ecaa96637f38aa6616c758bcc5dbee70b6554", "git_parents": ["8b848e114a9869591cbfd5bad37803502b118ddb"], "node": "ada87d71d164b5d3d4d5488faab5a16866affdc9", "parents": ["b8a09eec1c70f03076838a95bacad3b3c7ce6440"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2090211 - Raise the Windows fuzz of the paint holding in iframe tests. r=layout-reviewers,TYLin\n\nThe held snapshot draws text with grayscale antialiasing where the reference\nuses ClearType, so the two differ slightly on Windows. The difference is a bit\nlarger when the test runs in a fresh browser, as in test-verify.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340573\n", "files": ["testing/web-platform/meta/css/css-view-transitions/paint-holding-in-iframe-no-captured-elements.html.ini", "testing/web-platform/meta/css/css-view-transitions/paint-holding-in-iframe.html.ini"], "git_node": "2853fbd9d4ffcdf90855c3414d09e3e16da773bf", "git_parents": ["143ecaa96637f38aa6616c758bcc5dbee70b6554"], "node": "2c363edc93cf1e908d6d6447e806e1cc4e8b8a06", "parents": ["ada87d71d164b5d3d4d5488faab5a16866affdc9"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2088702 - Part 1: Scaffold the service-merino-sports component r=android-reviewers,android-build-system-reviewers,npoon\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339342\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/service/merino-sports/README.md", "mobile/android/android-components/components/service/merino-sports/build.gradle", "mobile/android/android-components/components/service/merino-sports/lint-baseline.xml", "mobile/android/android-components/components/service/merino-sports/proguard-rules.pro", "mobile/android/android-components/components/service/merino-sports/src/main/AndroidManifest.xml", "mobile/android/android-components/components/service/merino-sports/src/test/resources/mockito-extensions/org.mockito.plugins.MockMaker", "mobile/android/android-components/components/service/merino-sports/src/test/resources/robolectric.properties", "taskcluster/config.yml"], "git_node": "371a39b2145acbae87f36203c1d7b33131f46dee", "git_parents": ["2853fbd9d4ffcdf90855c3414d09e3e16da773bf"], "node": "586d3dcf22f6f7299b9b848709999d3d9093343a", "parents": ["2c363edc93cf1e908d6d6447e806e1cc4e8b8a06"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2088702 - Part 2: Add the matches model, JSON parsing, and MerinoSportsProvider r=android-reviewers,android-build-system-reviewers,npoon\n\n- Fetch previous, current and upcoming matches from the Merino Wrexham matches endpoint\n- Return null on a failed request or response so consumers can tell it apart from a valid empty response\n- Coerce unknown match status and period values instead of failing the whole response\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339343\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/service/merino-sports/build.gradle", "mobile/android/android-components/components/service/merino-sports/src/main/java/mozilla/components/service/merino/sports/MerinoMatches.kt", "mobile/android/android-components/components/service/merino-sports/src/main/java/mozilla/components/service/merino/sports/MerinoSportsProvider.kt", "mobile/android/android-components/components/service/merino-sports/src/test/java/mozilla/components/service/merino/sports/MerinoSportsProviderTest.kt", "mobile/android/android-components/components/service/merino-sports/src/test/resources/matches.json"], "git_node": "3bd0e187d887f0aea773ccb45c50b701fff7b019", "git_parents": ["371a39b2145acbae87f36203c1d7b33131f46dee"], "node": "e08d8186435a2b66e2041339d2a0fb8ae6143b5c", "parents": ["586d3dcf22f6f7299b9b848709999d3d9093343a"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2045720 - Encapsulate child cookie list lookups. r=cookie-reviewers,baku\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326571\n", "files": ["netwerk/cookie/CookieServiceChild.cpp", "netwerk/cookie/CookieServiceChild.h"], "git_node": "c4f85407584e49ebf2faacb69fbb940323fb716e", "git_parents": ["3bd0e187d887f0aea773ccb45c50b701fff7b019"], "node": "e1783371566bcf7ddd1a1686dfdb624edbeda992", "parents": ["e08d8186435a2b66e2041339d2a0fb8ae6143b5c"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2045720 - Use a hash set for unusually large child cookie lists. r=cookie-reviewers,baku\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326572\n", "files": ["netwerk/cookie/CookieServiceChild.cpp"], "git_node": "d154e14287ef1cbf02465025b7d1fa7fb88faa5d", "git_parents": ["c4f85407584e49ebf2faacb69fbb940323fb716e"], "node": "70e47d900e0888d9c652cf41ee82f71bc14c3007", "parents": ["e1783371566bcf7ddd1a1686dfdb624edbeda992"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2045720 - Test large child cookie lists. r=cookie-reviewers,baku\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326573\n", "files": ["netwerk/cookie/test/browser/browser.toml", "netwerk/cookie/test/browser/browser_cookie_child_large_list.js"], "git_node": "1673f8ef6dc4a1852ff8177ea3aec28654336fd2", "git_parents": ["d154e14287ef1cbf02465025b7d1fa7fb88faa5d"], "node": "c5a77f2031be9cd5ee75dc9e9ffee460e6b97a2b", "parents": ["70e47d900e0888d9c652cf41ee82f71bc14c3007"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2089286 - Batch nonbreaking spans and continued words in line-break setup. r=layout-reviewers,jfkthame\n\nScan nonbreaking Latin-1 word interiors without repeating whitespace and\nboundary-state work for each character. Fill their break flags in bulk,\nretaining word-level Unicode breaking, capitalization and hyphenation.\n\nAppend cross-chunk word continuations in bulk for both character widths,\nand update the continuation language once per UTF-16 chunk.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339776\n", "files": ["dom/base/nsLineBreaker.cpp"], "git_node": "4a567730aee6aad9a86d258d0a75e558011a9e74", "git_parents": ["1673f8ef6dc4a1852ff8177ea3aec28654336fd2"], "node": "c5c753b891080005f7a385e7dc22894e039198f0", "parents": ["c5a77f2031be9cd5ee75dc9e9ffee460e6b97a2b"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2045720 - Test large child cookie lists. r=cookie-reviewers,baku\" for causing build bustages @CookieServiceChild.cpp.\n\nThis reverts commit 1673f8ef6dc4a1852ff8177ea3aec28654336fd2.\n\nRevert \"Bug 2045720 - Use a hash set for unusually large child cookie lists. r=cookie-reviewers,baku\"\n\nThis reverts commit d154e14287ef1cbf02465025b7d1fa7fb88faa5d.\n\nRevert \"Bug 2045720 - Encapsulate child cookie list lookups. r=cookie-reviewers,baku\"\n\nThis reverts commit c4f85407584e49ebf2faacb69fbb940323fb716e.\n", "files": ["netwerk/cookie/CookieServiceChild.cpp", "netwerk/cookie/CookieServiceChild.h", "netwerk/cookie/test/browser/browser.toml", "netwerk/cookie/test/browser/browser_cookie_child_large_list.js"], "git_node": "1b16633d67cc9fd0f55dd0ad908a5ea101472381", "git_parents": ["4a567730aee6aad9a86d258d0a75e558011a9e74"], "node": "9382834954fb167a4da590a4e31ec5b22b282083", "parents": ["c5c753