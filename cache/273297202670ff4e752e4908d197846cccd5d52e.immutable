", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/fit-tolerance/fit-tolerance-percentage-intrinsic-column-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/fit-tolerance/fit-tolerance-percentage-intrinsic-row-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/fit-tolerance/fit-tolerance-percentage-row-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/fit-tolerance/fit-tolerance-row-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/fit-tolerance/fit-tolerance-row-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/fit-tolerance/fit-tolerance-row-004.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/fit-tolerance/row-fit-tolerance-infinite.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/fit-tolerance/row-initial-fit-tolerance.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/column-flow-tolerance-infinite.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/column-initial-flow-tolerance.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-column-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-column-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-column-004.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-dynamic-update.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-column-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-intrinsic-column-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-intrinsic-row-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-row-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-row-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-row-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-row-004.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/row-flow-tolerance-infinite.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/row-initial-flow-tolerance.html.ini"], "git_node": "f8de7df484a18a490cf9842c5435bd40c91894f1", "git_parents": ["20885e7e30858735a5f9c398807e0387ca31fcc9"], "node": "e6515eb54640425fcf897df4ca9c245f610a66fd", "parents": ["1ef59eefa2ada767e939b138dc574325ccb26609"], "tags": []}, {"author": "Jonathan Lee \u003cjonathan-j-lee@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087549 [wpt PR 64240] - [wdspec] Remove previous window focus check in browsingContext.create, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Remove previous window focus check in browsingContext.create (#64240)\n\n- Stop asserting that the previous browsing context loses focus when\n  creating a new window in `browsingContext.create`, while keeping the\n  visibility check and the tab focus check.\n- Neither the WebDriver BiDi nor the HTML specification prohibits\n  multiple windows from having system focus simultaneously when a new\n  window is created and activated.\n\nTAG=agy\n\nBug: 523199907\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nInclude-Ci-Only-Tests: chromium.fyi:linux-surface-embed-rel|surface_embed_chrome_wpt_tests\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel,mac-webdriver-bidi-rel,win-webdriver-bidi-rel,linux-blink-rel,linux-surface-embed-rel\nChange-Id: I4e3a4e7b3b66e0184ff6784363011b17aba71883\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8631593\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nReviewed-by: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724894}\n\nCo-authored-by: Maksim Sadym \u003csadym@chromium.org\u003e\n--\n\nwpt-commits: cefbcdebe9344327393af16c572162be3cbaa107\nwpt-pr: 64240\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/browsing_context/create/type.py"], "git_node": "1daa4337fffa23fff879c676be06f92953f05cd2", "git_parents": ["f8de7df484a18a490cf9842c5435bd40c91894f1"], "node": "2ca6114fb48e530e33447a23248145e9bd29f512", "parents": ["e6515eb54640425fcf897df4ca9c245f610a66fd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087549 [wpt PR 64240] - Update wpt metadata, a=testonly\n\nwpt-pr: 64240\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/browsing_context/create/reference_context.py.ini"], "git_node": "27414cc944296d8cd40168f9b6560e4ef8dbd7a7", "git_parents": ["1daa4337fffa23fff879c676be06f92953f05cd2"], "node": "810ad8c48d5d4fcf15fdd82cbac8be2f3bd22df1", "parents": ["2ca6114fb48e530e33447a23248145e9bd29f512"], "tags": []}, {"author": "Jonathan Lee \u003cjonathan-j-lee@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087552 [wpt PR 64227] - Expect `FAIL` for `infrastructure/assumptions/blank.html`, a=testonly\n\nAutomatic update from web-platform-tests\nExpect `FAIL` for `infrastructure/assumptions/blank.html` (#64227)\n\nThe unexpected failure is blocking multiple PRs (#64226).\n--\n\nwpt-commits: 74d50a16f2ee7d2fd0f03501d58355834232cb85\nwpt-pr: 64227\n", "files": ["testing/web-platform/tests/infrastructure/metadata/infrastructure/assumptions/blank.html.ini"], "git_node": "2075d57865e9167c7ed403387f900af67683fde8", "git_parents": ["27414cc944296d8cd40168f9b6560e4ef8dbd7a7"], "node": "10e6809578d5c13404400345e03267fa2e5ad7fe", "parents": ["810ad8c48d5d4fcf15fdd82cbac8be2f3bd22df1"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2087557 [wpt PR 64238] - Defer HTMLPlugInElement image loads from style recalc to a task, a=testonly\n\nAutomatic update from web-platform-tests\nDefer HTMLPlugInElement image loads from style recalc to a task\n\nPreviously, HTMLPlugInElement::CustomStyleForLayoutObject() invoked\nImageLoader::UpdateFromElement(kUpdateNormal) directly during style\nrecalculation. When an \u003cobject\u003e or \u003cembed\u003e transitioned to an image\ntype with a cached broken or immediate image resource, ImageLoader took\nthe synchronous load path inside style recalc, synchronously firing\nerror events or triggering HTMLObjectElement::RenderFallbackContent()\nand DetachLayoutTree() while the style engine was in the middle of\nrecalculating style.\n\nAdd ImageLoader::kUpdateFromTask (guarded by\nHTMLPlugInDeferStyleRecalcImageLoad) to post the image load update as a\nDOM manipulation task while keeping the document load event delayed\nuntil the task runs, and update\nDocument::InitiateStyleOrLayoutDependentLoadForPrint() to also wait on\nIsDelayingLoadEvent().\n\nFixed: 575053155\nBug: 575053155\nChange-Id: I55acfa7c5a7331248fd396776f51679064f2bf85\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8639987\nReviewed-by: Christoph Schwering \u003cschwering@google.com\u003e\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1727790}\n\n--\n\nwpt-commits: 8e5405e58e1a113206e18dfca2a6cb1d96a01d0f\nwpt-pr: 64238\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-object-element/object-image-style-recalc-fallback.html"], "git_node": "9dbb81224b4b9d1dd77145a85aa8f9c325e05091", "git_parents": ["2075d57865e9167c7ed403387f900af67683fde8"], "node": "3da02420625dd2f32bc209c46a054c98d0bea302", "parents": ["10e6809578d5c13404400345e03267fa2e5ad7fe"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087557 [wpt PR 64238] - Update wpt metadata, a=testonly\n\nwpt-pr: 64238\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/the-object-element/object-image-style-recalc-fallback.html.ini"], "git_node": "c0999be021cfc6e640a8756a059258facc3b2372", "git_parents": ["9dbb81224b4b9d1dd77145a85aa8f9c325e05091"], "node": "4dc0516d314d20ed55ba216aa9e7c0713a6d8452", "parents": ["3da02420625dd2f32bc209c46a054c98d0bea302"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087558 [wpt PR 64078] - Update wpt metadata, a=testonly\n\nwpt-pr: 64078\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/bidi/start_alignment.html.ini"], "git_node": "c8587fcd59fc8e3c6e6813e390abf47feb8c9a6f", "git_parents": ["c0999be021cfc6e640a8756a059258facc3b2372"], "node": "caa29eafa9e7f2b01c8e1bfc91860066a6992f93", "parents": ["4dc0516d314d20ed55ba216aa9e7c0713a6d8452"], "tags": []}, {"author": "Jer Noble \u003cjer.noble@apple.com\u003e", "branch": "default", "desc": "Bug 2087561 [wpt PR 64076] - [WebVTT] WPT tests webvtt/rendering/cues-with-video/processing-model/bidi/vertical_lr.html and vertical_rl.html are image failures, a=testonly\n\nAutomatic update from web-platform-tests\n[WebVTT] WPT tests webvtt/rendering/cues-with-video/processing-model/bidi/vertical_lr.html and vertical_rl.html are image failures (#64076)\n\nThe WebVTT spec says that, when a cue's snap-to-lines flag is true, the step amount when moving a cue\nbetween lines shall be the height or width of the \"first line box in _boxes_\". However, we were using\nthe height or width of the first _inline box_ in _boxes_, which resulted in step being too large by\nabout 1px for cues whose font size is 9px.\n\nUpdate RenderVTTCue::initializeLayoutParameters() to use the first _line box_ of the cue to determine\nthe step value, and also use the _line box_ children of the cue to account for padding and and border\ncontributions of the cue's height.\n\nAdditionally, these changes allow selectors/cue/font_properties.html, selectors/cue/font_shorthand.html,\nselectors/cue_function/font_properties.html, and selectors/cue_function/font_shorthand.html to pass,\nbut the reference files need to have `text-wrap:balance` added.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328425\nWebKit-Canonical-Link: https://commits.webkit.org/324447@main\n--\n\nwpt-commits: 213d629c1239732d3403904c8a14f3328bb1f98f\nwpt-pr: 64076\n", "files": ["testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/vertical_lr-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/vertical_lr.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/vertical_rl-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/vertical_rl.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue/font_properties-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue/font_shorthand-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/font_properties-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/font_shorthand-ref.html"], "git_node": "d2cf95d5136977b84e61cb231f6ca916e9147fef", "git_parents": ["c8587fcd59fc8e3c6e6813e390abf47feb8c9a6f"], "node": "6cd967a3f16dbf0dbf411af0effc3d730a36a40a", "parents": ["caa29eafa9e7f2b01c8e1bfc91860066a6992f93"], "tags": []}, {"author": "Jer Noble \u003cjer.noble@apple.com\u003e", "branch": "default", "desc": "Bug 2087566 [wpt PR 64075] - [WebVTT] WPT test webvtt/rendering/cues-with-video/processing-model/bidi/bidi_ruby.html is an Image failure, a=testonly\n\nAutomatic update from web-platform-tests\n[WebVTT] WPT test webvtt/rendering/cues-with-video/processing-model/bidi/bidi_ruby.html is an Image failure (#64075)\n\nbidi_ruby.html does not specify a background color for the \u003crt\u003e span in the cue under test. On\nother browsers, this causes the cue to render as white-on-white and to be nearly invisible. WebKit\napplies the same background-color to \u003crt\u003e spans as the cue background for legibility reasons.\n\nFor the purposes of the test, however, set an explicit background color for the cue \u003crt\u003e both to\nunify WebKit and other browsers' behaviors, and also to make the text in the \u003crt\u003e legible to the test.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328419\nWebKit-Canonical-Link: https://commits.webkit.org/324445@main\n--\n\nwpt-commits: cf115d77c65f5bf4c07aaff500f02793f7481f51\nwpt-pr: 64075\n", "files": ["testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/bidi_ruby-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/bidi_ruby.html"], "git_node": "2388a1728d8f9ebfc346a4d616360a5a892baeb9", "git_parents": ["d2cf95d5136977b84e61cb231f6ca916e9147fef"], "node": "82a969b78ff5074bb6965fe8679ca4c864786923", "parents": ["6cd967a3f16dbf0dbf411af0effc3d730a36a40a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087566 [wpt PR 64075] - Update wpt metadata, a=testonly\n\nwpt-pr: 64075\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/bidi/bidi_ruby.html.ini"], "git_node": "2f9565220eb409c7e2c992ed2140e9dc284ffbd3", "git_parents": ["2388a1728d8f9ebfc346a4d616360a5a892baeb9"], "node": "c7ccb50b2a44e08185d011370434570d6164a5d1", "parents": ["82a969b78ff5074bb6965fe8679ca4c864786923"], "tags": []}, {"author": "Sampath Samaraweera \u003csampath.samaraweera@codimite.com\u003e", "branch": "default", "desc": "Bug 2087573 [wpt PR 64231] - Keep percent hint of math functions returning a number, a=testonly\n\nAutomatic update from web-platform-tests\nKeep percent hint of math functions returning a number\n\nMath functions that return a \u003cnumber\u003e, like round(), mod(), sign()\nor exp(), are typed by their category alone, which can't express a\npercent hint. So in e.g. calc(100% / round(100% / 10px)), the fact\nthat the percentage inside round() resolves against a length was\nlost, and the whole expression was categorized as a plain\n\u003cpercentage\u003e. CSSPrimitiveValue::ConvertToLength() then resolved it\nbefore layout via ComputePercentage(), which treats every percentage\nas a plain number, i.e. as if 100% were always 100px.\n\nPer css-values-4, such functions are made consistent with the type\nof their arguments, so they keep the arguments' percent hint.\nRecover that hint from the operands when computing the CSSMathType\nof a \u003cnumber\u003e math function, and keep it for the invert node created\nfor division. The example above is then a \u003clength-percentage\u003e and is\nresolved against the actual percentage basis at layout time.\n\nThe change is guarded by the CSSNumberMathFunctionPercentHint\nruntime flag.\n\nFixed: 562857754\nChange-Id: Ia0554fe14dff632357fe33365a63ca7293db7527\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8607729\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCr-Commit-Position: refs/heads/main@{#1727822}\n\n--\n\nwpt-commits: 6cb21e579a9876402d4e01afa9230a53f1fe56b7\nwpt-pr: 64231\n", "files": ["testing/web-platform/tests/css/css-values/calc-background-size-round-percentage.html", "testing/web-platform/tests/css/css-values/calc-percentage-in-number-functions.html"], "git_node": "39c2e52dc057cee2b11598f2b559d6519bc4a63e", "git_parents": ["2f9565220eb409c7e2c992ed2140e9dc284ffbd3"], "node": "b2081c6bbfc5dc126727ab8d708bd5b3f4f90b20", "parents": ["c7ccb50b2a44e08185d011370434570d6164a5d1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087573 [wpt PR 64231] - Update wpt metadata, a=testonly\n\nwpt-pr: 64231\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/calc-size/calc-size-svg-001-crash.html.ini"], "git_node": "6a93b89111975b0d41f091af894246b5053fc9f9", "git_parents": ["39c2e52dc057cee2b11598f2b559d6519bc4a63e"], "node": "dc1bf9bad3989a71ff956d08cf3496a11bf26161", "parents": ["b2081c6bbfc5dc126727ab8d708bd5b3f4f90b20"], "tags": []}, {"author": "Sampath Samaraweera \u003csampath.samaraweera@codimite.com\u003e", "branch": "default", "desc": "Bug 2087576 [wpt PR 64232] - Allow animation-tainted var() in -internal-visited-* properties, a=testonly\n\nAutomatic update from web-platform-tests\nAllow animation-tainted var() in -internal-visited-* properties\n\nOn a visited link, `color: var(--x)` painted the inherited color\nwhen --x came from an animation or transition. getComputedStyle()\nreports the unvisited color, so it showed the correct value.\n\nAnimated custom property values are animation-tainted, and\nCascadeResolver::AllowSubstitution() rejects tainted values in\nanimation-affecting properties. The generated set of\nanimation-affecting properties includes every -internal-* property,\nso the -internal-visited-* properties rejected the substitution and\nfell back to 'unset'.\n\nAllowSubstitution() now checks a visited property's unvisited\ncounterpart instead. None of those counterparts are\nanimation-affecting, so visited properties accept the same values as\nthe unvisited ones. This reveals nothing new about visited state,\nsince animating 'color' directly already reaches the visited color.\n\nThe change is guarded by the VisitedAnimationTaintedSubstitution\nruntime flag.\n\nFixed: 569257985\nChange-Id: Ic06b69e8cc023ad6f4323b439aef6540e8f1d5ef\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8618433\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1727828}\n\n--\n\nwpt-commits: d697fd3c6dfb7497f2c90208599f9cf1ffa38214\nwpt-pr: 64232\n", "files": ["testing/web-platform/tests/css/css-variables/variable-animation-visited-link-ref.html", "testing/web-platform/tests/css/css-variables/variable-animation-visited-link.html"], "git_node": "5277a36ca90a1f5fc8e41e8c0565c3e3deed8fd1", "git_parents": ["6a93b89111975b0d41f091af894246b5053fc9f9"], "node": "207244a769f94b9c9e054a543a8ded98ca75bd27", "parents": ["dc1bf9bad3989a71ff956d08cf3496a11bf26161"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087576 [wpt PR 64232] - Update wpt metadata, a=testonly\n\nwpt-pr: 64232\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-variables/variable-animation-visited-link.html.ini"], "git_node": "220d3f32bbcaa2fa8459d0a7b93cdc4b28766a90", "git_parents": ["5277a36ca90a1f5fc8e41e8c0565c3e3deed8fd1"], "node": "1cd5cf7d7f3550828764d6de2e2dfea17a37fe9a", "parents": ["207244a769f94b9c9e054a543a8ded98ca75bd27"], "tags": []}, {"author": "Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e", "branch": "default", "desc": "Bug 2086556 [wpt PR 64253] - [layout] Store position:relative insets on PhysicalBoxFragment., a=testonly\n\nAutomatic update from web-platform-tests\n[layout] Store position:relative insets on PhysicalBoxFragment.\n\nThis patch stores the insets calculated for a position:relative object\non the PhysicalBoxFragment.\n\nThis patch doesn't use these insets yet.\n\nAdditionally patch fixes a subtle bug. When we had an empty inline its\nposition:relative offset would get applied twice.\n\nChange-Id: Ie18813c706b3f28ff9bae066d7038c3b94ef6845\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8613699\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCommit-Queue: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1727947}\n\n--\n\nwpt-commits: c4eb69df651acb32578ce475d7466e5fda9d9aa3\nwpt-pr: 64253\n", "files": ["testing/web-platform/tests/css/css-position/position-relative-empty-inline.html"], "git_node": "d3476292e9f0a65f0f4a44b463b8c963134fcfea", "git_parents": ["220d3f32bbcaa2fa8459d0a7b93cdc4b28766a90"], "node": "434076eb992244071189b5ab2bd845997953b9bc", "parents": ["1cd5cf7d7f3550828764d6de2e2dfea17a37fe9a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086556 [wpt PR 64253] - Update wpt metadata, a=testonly\n\nwpt-pr: 64253\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-position/position-absolute-iframe-print-002.sub.html.ini"], "git_node": "ea90627382a967b00773ff7839a5749c3052cc5f", "git_parents": ["d3476292e9f0a65f0f4a44b463b8c963134fcfea"], "node": "76465cd728d3091cc17294866cacb0386b01281a", "parents": ["434076eb992244071189b5ab2bd845997953b9bc"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2086563 [wpt PR 64255] - Fix conditional processing on SVG \u003cmask\u003e and \u003cpattern\u003e elements, a=testonly\n\nAutomatic update from web-platform-tests\nFix conditional processing on SVG \u003cmask\u003e and \u003cpattern\u003e elements\n\nThis patch stops evaluating conditional processing attributes\n(systemLanguage, requiredExtensions) on masks and patterns so\nreferenced masks and patterns still apply, aligning with the spec:\nhttps://svgwg.org/svg2-draft/struct.html#ConditionalProcessingOverview.\nThis was heavily inspired by https://commits.webkit.org/320207@main by\nAhmad Saleem.\n\nFixed: 40510937\nChange-Id: Ie7cbc08a53224c7e953c3e879e5647445ee757ae\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8664378\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCr-Commit-Position: refs/heads/main@{#1727961}\n\n--\n\nwpt-commits: f44cb2dbab71aff09e6c749be8d091c45a2ed501\nwpt-pr: 64255\n", "files": ["testing/web-platform/tests/svg/struct/reftests/conditional-processing-never-rendered-resources.svg"], "git_node": "179c5695552486b6c8b81244c275afaf0d7e3bfb", "git_parents": ["ea90627382a967b00773ff7839a5749c3052cc5f"], "node": "43a727e106c7bc65eeedfa7cd3ee73ef6d932bdc", "parents": ["76465cd728d3091cc17294866cacb0386b01281a"], "tags": []}, {"author": "Natalia Markoborodova \u003c50494110+ewewraw@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086571 [wpt PR 64256] - Add WEB_FEATURES.yml for HTML-in-Canvas draw-element-image tests, a=testonly\n\nAutomatic update from web-platform-tests\nAdd WEB_FEATURES.yml for HTML-in-Canvas draw-element-image tests (#64256)\n\nCo-authored-by: Natalia Markoborodova \u003cnmarkoborodova@google.com\u003e\n--\n\nwpt-commits: 5ccef26dd9f159b58cffd6e89aa786a6f1e47305\nwpt-pr: 64256\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/WEB_FEATURES.yml", "testing/web-platform/tests/html/canvas/offscreen/manual/draw-element-image/WEB_FEATURES.yml"], "git_node": "e5a5bc9493c54d23871aefe9dad379cb44790a4e", "git_parents": ["179c5695552486b6c8b81244c275afaf0d7e3bfb"], "node": "b26b1104e92a0b13a50069b3b1e2ea8e2a0c8a30", "parents": ["43a727e106c7bc65eeedfa7cd3ee73ef6d932bdc"], "tags": []}, {"author": "amraboelkher \u003camraboelkher@chromium.org\u003e", "branch": "default", "desc": "Bug 2086622 [wpt PR 64218] - [dbsc] Add WPTs and browser tests for session retrieval, a=testonly\n\nAutomatic update from web-platform-tests\n[dbsc] Add WPTs and browser tests for session retrieval\n\nAt present the unit tests for DeviceBoundSessionRegistrationObserver use\na fake manager, and the browser tests from part 4 bind the manager by\nhand. No test registers a real session and reads it back through the\nAPI.\n\nAdd five WPTs in device-bound-session-credentials/. The API has an\nexplainer but no spec yet, so their names carry .tentative.\n- registration-observer: the callback gets the observer and each\n  session's ID, refresh URL and creation time; the first call lists the\n  sessions that already exist and a later call holds only the new\n  session; repeated observe() calls neither subscribe twice nor resend\n  the existing sessions; after disconnect() nothing arrives, and a new\n  observe() gets the existing sessions again; a session scoped to\n  another origin of the same site is not seen.\n- registration-observer-abort: an AbortSignal aborted before or after\n  observe() stops every later callback, while an observer without a\n  signal still sees the session, and observe() does not restart the\n  observer.\n- registration-observer-cross-subdomain: a site-wide session that a\n  subdomain registers is seen from the site root.\n- registration-observer-opaque-origin: the constructor throws a\n  SecurityError in a sandboxed iframe and does not work in a data:\n  document.\n- registration-observer-not-eligible: a credentialless iframe, and an\n  iframe from the test's origin inside a cross-site iframe, observe\n  nothing and keep running, because Blink does not ask for the manager\n  there. The inner iframe shares the test page's origin, so it has a\n  session it could leak. observer_frame.html is the iframe page; with\n  ?embed= it also holds the inner iframe.\n\nLike the rest of the directory, they run in chrome_wpt_tests\n(TestLists/chrome.filter), where wptrunner runs chrome with\n--enable-experimental-web-platform-features, which turns\nDeviceBoundSessionJsApi on through part 4's switch override.\n\nThe negative checks wait for a later session or a later observer, not\nfor a fixed time: the network service pushes to a document's observers\nin the order they subscribed, on one pipe. Only checks where nothing\ncan arrive, such as an iframe whose document never binds the manager,\nkeep a fixed wait.\n\nAdd browser tests that register a site-wide a.test session with the test\nserver. The fixture turns on the DeviceBoundSessionJsApi feature, which\nturns on the Blink runtime flag through runtime_features.cc.\n- A session registered on accounts.a.test is seen on mail.a.test after a\n  redirect.\n- An a.test iframe under b.test sees no session, while a top-level\n  a.test page does.\n- A credentialless a.test iframe sees no session, and its renderer is\n  not killed, because Blink does not ask for the manager.\n- A same-origin iframe sees the session. It commits into the window of\n  its initial empty document, so this checks that a kept window gets\n  the commit-time value.\n- A new a.test page commits, then cookies and site data for a.test are\n  blocked. The page's first observe() binds the manager after that and\n  sees no session, and its renderer stays alive: the setting can change\n  while the page is open, so it never causes a kill.\n- Incognito and the regular profile each register a session with their\n  own ID. The regular profile's first callback holds only its own\n  session, and a second Incognito window sees only the Incognito one.\n- HttpsPageBindsManager and SameSiteIframeBindsManager, from part 4,\n  register a session and read it back through the page's observer,\n  which works only if the browser bound the manager with the frame's\n  origin and isolation info. The part 4 tests that expect a bad message\n  still bind by hand, as the comment on BindManager() explains.\n\nPart 6 of 6.\n\nTest: run_wpt_tests.py -p chrome external/wpt/device-bound-session-credentials/\nTest: content_browsertests --gtest_filter=DeviceBoundSessionJsApi*\nBug: 494489935\nChange-Id: If68c369f55c87b5307de53c0687376d76a6a6964\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8579637\nReviewed-by: Kenichi Ishibashi \u003cbashi@chromium.org\u003e\nReviewed-by: Jan Wilken D\u00f6rrie \u003cjdoerrie@chromium.org\u003e\nCommit-Queue: Amr Aboelkher \u003camraboelkher@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1728002}\n\n--\n\nwpt-commits: a3cfb21a74bdbea3d575b941748314542b1fded1\nwpt-pr: 64218\n", "files": ["testing/web-platform/tests/device-bound-session-credentials/observer_frame.html", "testing/web-platform/tests/device-bound-session-credentials/registration-observer-abort.tentative.https.html", "testing/web-platform/tests/device-bound-session-credentials/registration-observer-cross-subdomain.tentative.https.html", "testing/web-platform/tests/device-bound-session-credentials/registration-observer-not-eligible.tentative.https.html", "testing/web-platform/tests/device-bound-session-credentials/registration-observer-opaque-origin.tentative.https.html", "testing/web-platform/tests/device-bound-session-credentials/registration-observer.tentative.https.html"], "git_node": "1c6a0d60cbec11a559d0f141b3b03eb86ce1f747", "git_parents": ["e5a5bc9493c54d23871aefe9dad379cb44790a4e"], "node": "297693a38d2a8294a1e4e0ff25089a821ec99b16", "parents": ["b26b1104e92a0b13a50069b3b1e2ea8e2a0c8a30"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086622 [wpt PR 64218] - Update wpt metadata, a=testonly\n\nwpt-pr: 64218\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/device-bound-session-credentials/registration-observer-abort.tentative.https.html.ini", "testing/web-platform/meta/device-bound-session-credentials/registration-observer-cross-subdomain.tentative.https.html.ini", "testing/web-platform/meta/device-bound-session-credentials/registration-observer-not-eligible.tentative.https.html.ini", "testing/web-platform/meta/device-bound-session-credentials/registration-observer-opaque-origin.tentative.https.html.ini", "testing/web-platform/meta/device-bound-session-credentials/registration-observer.tentative.https.html.ini"], "git_node": "7f3bc3159c1e465e5e4665b4d288978a712617ec", "git_parents": ["1c6a0d60cbec11a559d0f141b3b03eb86ce1f747"], "node": "306d3495870df62ae704808bd23166436beb7d18", "parents": ["297693a38d2a8294a1e4e0ff25089a821ec99b16"], "tags": []}, {"author": "Jose Dapena Paz \u003cjdapena@igalia.com\u003e", "branch": "default", "desc": "Bug 2086648 [wpt PR 64262] - ContainerTiming WPT: fix outdated test names, a=testonly\n\nAutomatic update from web-platform-tests\nContainerTiming WPT: fix outdated test names\n\nThree nested-* tests still described the nesting policies removed when\nnested roots became transparent, and one even said the parent root got\nno paints while asserting that it did. The two pseudo-element image\ntests also shared the same title and subtest name.\n\nChange-Id: I0fb5afbe38e2411e078870188640377341fa5cb2\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8629362\nCommit-Queue: Jos\u00e9 Dapena Paz \u003cjdapena@igalia.com\u003e\nReviewed-by: Scott Haseley \u003cshaseley@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1728138}\n\n--\n\nwpt-commits: 0133ea8dabb93f77eeb12c2693859eae19e9270b\nwpt-pr: 64262\n", "files": ["testing/web-platform/tests/container-timing/tentative/nested-containertiming-child-img-with-ignore.html", "testing/web-platform/tests/container-timing/tentative/nested-containertiming-child-img.html", "testing/web-platform/tests/container-timing/tentative/nested-containertiming-with-ignore.html", "testing/web-platform/tests/container-timing/tentative/pseudo-with-image-content-in-container-timing.html"], "git_node": "26243785a1c1518cace157abfe1f9c87b6feed7b", "git_parents": ["7f3bc3159c1e465e5e4665b4d288978a712617ec"], "node": "7458934c51912841dbf172bf091d87fd7b5ee6c7", "parents": ["306d3495870df62ae704808bd23166436beb7d18"], "tags": []}, {"author": "github-actions[bot] \u003c41898282+github-actions[bot]@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086655 [wpt PR 64122] - Sync interfaces/ with @webref/idl 3.86.0, a=testonly\n\nAutomatic update from web-platform-tests\nSync interfaces/ with @webref/idl 3.86.0 (#64122)\n\nCo-authored-by: wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e\n--\n\nwpt-commits: b89f6908fc80a6818471f12f930ac204f5625ec9\nwpt-pr: 64122\n", "files": ["testing/web-platform/tests/interfaces/EXT_clip_control.idl", "testing/web-platform/tests/interfaces/EXT_conservative_depth.idl", "testing/web-platform/tests/interfaces/EXT_depth_clamp.idl", "testing/web-platform/tests/interfaces/EXT_polygon_offset_clamp.idl", "testing/web-platform/tests/interfaces/EXT_render_snorm.idl", "testing/web-platform/tests/interfaces/EXT_texture_mirror_clamp_to_edge.idl", "testing/web-platform/tests/interfaces/NV_shader_noperspective_interpolation.idl", "testing/web-platform/tests/interfaces/OES_sample_variables.idl", "testing/web-platform/tests/interfaces/OES_shader_multisample_interpolation.idl", "testing/web-platform/tests/interfaces/SVG.idl", "testing/web-platform/tests/interfaces/WEBGL_blend_func_extended.idl", "testing/web-platform/tests/interfaces/WEBGL_polygon_mode.idl", "testing/web-platform/tests/interfaces/WEBGL_render_shared_exponent.idl", "testing/web-platform/tests/interfaces/WEBGL_shader_pixel_local_storage.idl", "testing/web-platform/tests/interfaces/WEBGL_stencil_texturing.idl", "testing/web-platform/tests/interfaces/device-memory.idl", "testing/web-platform/tests/interfaces/html.idl", "testing/web-platform/tests/interfaces/install-element.idl", "testing/web-platform/tests/interfaces/long-animation-frames.idl", "testing/web-platform/tests/interfaces/longtasks.idl", "testing/web-platform/tests/interfaces/model-element.idl", "testing/web-platform/tests/interfaces/notifications.idl", "testing/web-platform/tests/interfaces/prompt-api.idl", "testing/web-platform/tests/interfaces/speech-api.idl", "testing/web-platform/tests/interfaces/webgpu.idl", "testing/web-platform/tests/interfaces/webnn.idl"], "git_node": "e19015629f2c8317ff49d7fbafcd9d1df6ab7c10", "git_parents": ["26243785a1c1518cace157abfe1f9c87b6feed7b"], "node": "1de914c1ee2a03191749ac9945c58408dde0a016", "parents": ["7458934c51912841dbf172bf091d87fd7b5ee6c7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086655 [wpt PR 64122] - Update wpt metadata, a=testonly\n\nwpt-pr: 64122\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-view-transitions/offscreen-element-modified-before-coming-onscreen.html.ini", "testing/web-platform/meta/html/dom/idlharness.https.html.ini", "testing/web-platform/meta/pointerevents/compat/pointerevent_touch_target_after_pointerdown_target_removed.tentative.html.ini", "testing/web-platform/meta/speech-api/idlharness.https.window.js.ini", "testing/web-platform/meta/touch-events/hover-state-caused-by-compatibility-mouse-events.tentative.html.ini", "testing/web-platform/meta/webdriver/tests/classic/get_element_text/get.py.ini", "testing/web-platform/meta/webrtc/RTCPeerConnection-addTransceiver-renegotiation.https.html.ini"], "git_node": "7a0b4710a94b5f2a1b2bc07efac7729363d249a4", "git_parents": ["e19015629f2c8317ff49d7fbafcd9d1df6ab7c10"], "node": "178e3ac51936345b843f620485fbf99adf48d97f", "parents": ["1de914c1ee2a03191749ac9945c58408dde0a016"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2086670 [wpt PR 64152] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328777, a=testonly\n\nAutomatic update from web-platform-tests\nQueue the CORP violation reports of a worker's loads on the worker\n\nThe Document-Isolation-Policy and Cross-Origin-Embedder-Policy reports for a\ndedicated worker's loads went to its owner document's ReportingObserver, with\nthe owner's URL, rather than to the worker. The network process now gets the\nworker's URL with each of its loads and sends their reports to the worker.\nWebKit has no reporting endpoints for workers, so reports still go to the owner\ndocument's endpoints, now with the worker's URL.\n\nThe Cross-Origin-Embedder-Policy \"worker initialization\" report for a nested\ndedicated worker now goes to the worker that creates it. Content-Security-Policy\nreports the network process queues for a dedicated worker's loads go to the\nworker as well, though still with the owner document's URL.\n\nThreadableLoaderOptions::isolatedCopy() now also copies the worker identifier,\nwhich it dropped.\n\nNot covered yet:\n- A worker's memory cache hits don't report, and use its owner's\n  Cross-Origin-Embedder-Policy.\n- The loads of shared and service workers still don't report to them.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328777\n\n--\n\nwpt-commits: 4ca58c72f7a256ac9ffc5bf1050153417883a2df\nwpt-pr: 64152\n", "files": ["testing/web-platform/tests/html/document-isolation-policy/reporting-dedicated-worker.tentative.https.html"], "git_node": "799ea08179ae65216467a3005dbbe0f090225bd5", "git_parents": ["7a0b4710a94b5f2a1b2bc07efac7729363d249a4"], "node": "339d4596a19b22878054442c16548bbd9fc82d1c", "parents": ["178e3ac51936345b843f620485fbf99adf48d97f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086670 [wpt PR 64152] - Update wpt metadata, a=testonly\n\nwpt-pr: 64152\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/document-isolation-policy/reporting-dedicated-worker.tentative.https.html.ini"], "git_node": "ce948256953499a574092e9f6d814b53d78761eb", "git_parents": ["799ea08179ae65216467a3005dbbe0f090225bd5"], "node": "b1f73ed3f4f1108b8067e9daa6d34eaee09a8ebe", "parents": ["339d4596a19b22878054442c16548bbd9fc82d1c"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2086682 [wpt PR 64165] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327781, a=testonly\n\nAutomatic update from web-platform-tests\nCSSCounterStyleRule.name setter does not update the name getter or cssText\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nStyleRuleCounterStyle stored the counter style name twice: in its own m_name\nand in CSSCounterStyleDescriptors::m_name. CSSCounterStyleRule::setName()\nonly updated the descriptors' copy, while the name getter and cssText read the\nrule's copy. After `rule.name = \"bar\"`, `rule.name` and `rule.cssText` still\nreported the old name, while the counter style registry (which keys on the\ndescriptors' name) used the new one.\n\nDrop StyleRuleCounterStyle::m_name and have name() return the descriptors'\nname, so there is a single source of truth. Also remove the now-unneeded name\nparameter from StyleRuleCounterStyle::create() and the unused\nStyleRuleCounterStyle::setName().\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327781\nWebKit-Canonical-Link: https://commits.webkit.org/324049@main\n\n--\n\nwpt-commits: 3f0a85f85c9d361d373a95387eed3dfe5882742e\nwpt-pr: 64165\n", "files": ["testing/web-platform/tests/css/css-counter-styles/cssom/cssom-name-setter-getter.html"], "git_node": "28266c4fbe20fd03a18eb61e576f8ae5555db0ad", "git_parents": ["ce948256953499a574092e9f6d814b53d78761eb"], "node": "2db0607515717bb03d49ca4955af8aac2f4418e0", "parents": ["b1f73ed3f4f1108b8067e9daa6d34eaee09a8ebe"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2086695 [wpt PR 64164] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328778, a=testonly\n\nAutomatic update from web-platform-tests\nReport the first URL of a service worker's response in CORP violation reports\n\nThe CORP violation reports for a service worker's response named the requested\nURL, rather than the first URL of the response's URL list. These differ when the\nworker responds with a fetch of another URL, including through the Cache API.\n\nThe service worker process now sends the first URL along with the response. As\nResourceResponse only has the last URL of a redirected response, FetchResponse\nrecords the URL that fetch() requested. A response that the worker constructs\nhas an empty URL list, so it is still reported with the request's URL.\n\nNot covered yet:\n- A redirected response from the Cache API is reported with the requested URL,\n  as the Cache API only stores the last URL of a response's URL list.\n- A response that a static routing rule takes from the cache is reported with\n  the requested URL.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328778\n\n--\n\nwpt-commits: 448aa6752f3179cef89a0fde1b0f27f1029397eb\nwpt-pr: 64164\n", "files": ["testing/web-platform/tests/html/cross-origin-embedder-policy/reporting-cached-and-service-worker-responses.https.html", "testing/web-platform/tests/html/cross-origin-embedder-policy/resources/respond-with-fetch-sw.js", "testing/web-platform/tests/html/document-isolation-policy/reporting-cached-and-service-worker-responses.tentative.https.html", "testing/web-platform/tests/html/document-isolation-policy/resources/respond-with-fetch-sw.js"], "git_node": "bebfca5ada956d5e7965aaa3f784eb0481f02567", "git_parents": ["28266c4fbe20fd03a18eb61e576f8ae5555db0ad"], "node": "2b77847faa1c5c34837b92bd78784fa2d065cb74", "parents": ["2db0607515717bb03d49ca4955af8aac2f4418e0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086695 [wpt PR 64164] - Update wpt metadata, a=testonly\n\nwpt-pr: 64164\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/cross-origin-embedder-policy/reporting-cached-and-service-worker-responses.https.html.ini", "testing/web-platform/meta/html/document-isolation-policy/reporting-cached-and-service-worker-responses.tentative.https.html.ini"], "git_node": "c4bac39131bb802f1682e9f937414761bb8ce0e3", "git_parents": ["bebfca5ada956d5e7965aaa3f784eb0481f02567"], "node": "2d89df6d5a96da4bed49d0836ee24b5bbbad6fab", "parents": ["2b77847faa1c5c34837b92bd78784fa2d065cb74"], "tags": []}, {"author": "Sam Weinig \u003csam@webkit.org\u003e", "branch": "default", "desc": "Bug 2086721 [wpt PR 64166] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327309, a=testonly\n\nAutomatic update from web-platform-tests\nAdd CoreText support for palette-mix()\n\nAdds the final piece need for palette-mix() to actually do anything.\n\nDue to CoreText not natively supporting a mixing of components, we can't utilize the\nbuilt in support that was used previously. Instead, we have to manually parse the\nfont's CPAL table, using a new OpenTypeCPAL parser, and manually mix ourselves.\nWe also now need to pass a set of palettes from CSSFontSelector to the platform\nlayer as a mix function can reference multiple palettes.\n\nWith this complete, the feature is working so the CSSFontPaletteMixFunctionEnabled\npreference is now enabled by default.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327309\nWebKit-Canonical-Link: https://commits.webkit.org/324044@main\n\n--\n\nwpt-commits: 7960109667aa5912b973304078eb96b47446bc86\nwpt-pr: 64166\n", "files": ["testing/web-platform/tests/css/css-fonts/font-palette-mix-ref.html", "testing/web-platform/tests/css/css-fonts/font-palette-mix.html"], "git_node": "3054344c59d82c7990f0e5505bcfd7f3b048b99c", "git_parents": ["c4bac39131bb802f1682e9f937414761bb8ce0e3"], "node": "b1a9921512d53baf10e733f7b3f8beb5884931b7", "parents": ["2d89df6d5a96da4bed49d0836ee24b5bbbad6fab"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086721 [wpt PR 64166] - Update wpt metadata, a=testonly\n\nwpt-pr: 64166\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-fonts/font-face-array-buffer-parsing-failure-crash.html.ini", "testing/web-platform/meta/css/css-fonts/font-palette-mix.html.ini"], "git_node": "0cb5d973d63df9c8d29b7459a38bc553777ecc93", "git_parents": ["3054344c59d82c7990f0e5505bcfd7f3b048b99c"], "node": "58901d1e5782d1bc3fbca383c37de3a65bb2b277", "parents": ["b1a9921512d53baf10e733f7b3f8beb5884931b7"], "tags": []}, {"author": "Sam Weinig \u003csam@webkit.org\u003e", "branch": "default", "desc": "Bug 2086734 [wpt PR 64167] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327939, a=testonly\n\nAutomatic update from web-platform-tests\n[Image Redux] An SVG image with a width or height less than 1 fails to load\n\nAn SVG image with a width or height less than a 1 failed to load due to SVGImage's hasSomethingToDraw() returning\nfalse for that case.\n\nTo fix this, hasSomethingToDraw() now checks if there is a renderer, rather than checking if the legacy m_intrinsicSize\nwas not empty. This is correct since an SVG image is draw at the negotiated concrete image size, and that can be positive\neven when the explicit width and height of the SVG are 0.  Along with hasSomethingToDraw() moving off m_intrinsicSize,\ndraw() also moves off it, and uses the container size it just applied (a.k.a. the concrete object size).\n\nThis leaves m_intrinsicSize only used for the implementation of SVGImage::size(), which we are working towards removing.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327939\nWebKit-Canonical-Link: https://commits.webkit.org/324048@main\n\n--\n\nwpt-commits: 877ec0be3de40341b51f2b63ae4fc90a97652634\nwpt-pr: 64167\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-img-element/svg-image-subpixel-size-loads.html"], "git_node": "8f6c46dd8282f98f71f983fb08e37085d2597dc1", "git_parents": ["0cb5d973d63df9c8d29b7459a38bc553777ecc93"], "node": "ee7fa06dea5b004ecb307539d154191ec8f45fe7", "parents": ["58901d1e5782d1bc3fbca383c37de3a65bb2b277"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086763 [wpt PR 64168] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322338, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] Margin does not collapse after a self collapsing block level box on a line\n\nA block level box on a line is handed to block layout at the line's top, and block layout applies the pending\nmargin from the container's own position, so LineBuilder::handleBlockContent takes that margin back off the line\ntop first - but only when the margin was no longer at the before side of the block, while the line was advanced by\nit whenever the margin could not collapse out through the root's before edge. With a border or padding on the\nroot the two disagree: the line top already holds the margin and block layout adds it again, so\n\u003cspan\u003e\u003cdiv style=\"margin-top:100px\"\u003e\u003c/div\u003e\u003c/span\u003e\u003cdiv\u003e puts the second block 200px down instead of 100px. Make\nthe rollback test the condition the advance already uses.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322338\nWebKit-Canonical-Link: https://commits.webkit.org/319697@main\n\n--\n\nwpt-commits: 719ebd3d054ae2013a046a24b7352e07f2f83894\nwpt-pr: 64168\n", "files": ["testing/web-platform/tests/css/CSS2/normal-flow/margin-collapse-through-block-in-inline-001-ref.html", "testing/web-platform/tests/css/CSS2/normal-flow/margin-collapse-through-block-in-inline-001.html"], "git_node": "55ace236bb085c92cf401baf2d9515afb9faedda", "git_parents": ["8f6c46dd8282f98f71f983fb08e37085d2597dc1"], "node": "6277626994bdeb6c792d9bc76f694b13c5096a35", "parents": ["ee7fa06dea5b004ecb307539d154191ec8f45fe7"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086772 [wpt PR 64189] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321143, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] Inline box with cloned decoration generates an extra line between two block level boxes\n\n  \u003cspan style=\"-webkit-box-decoration-break: clone; border: 20px solid magenta\"\u003e\n    a\n    \u003cdiv\u003eblock\u003c/div\u003e\n    \u003cspan\u003e\u003c/span\u003e\n    \u003cdiv\u003eblock\u003c/div\u003e\n    c\n  \u003c/span\u003e\n\nThe two block level boxes should be right next to each other, the way they are in\nBlink. Instead a 20px tall line with a 40px wide magenta border box showed up\nbetween them, for the empty inline box.\nThe test case is adapted from Oriol Brufau's reduction in\nhttps://github.com/w3c/csswg-drafts/issues/14104\n\nLine::initialize hands a line spanning inline box run the width of its cloned\ndecoration, so isContentfulOrHasDecoration answered \"contentful\" on its very first\ncheck (run.logicalWidth()) and the line got a full strut. The fragment's display box\nwas then built from the border box, so all four cloned edges painted.\n\nCloned decoration wraps the content of a box fragment, so it can't make a line\ncontentful by itself. A line spanning inline box start no longer does, and on a line\nwith no inline content its display box uses the content box -the rule block lines\nalready followed. This matches Blink.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321143\nWebKit-Canonical-Link: https://commits.webkit.org/318718@main\nCo-Authored-By: Claude Opus 5 (1M context) \u003cnoreply@anthropic.com\u003e\n\n--\n\nwpt-commits: 48bff3dd0a320fa17742219a54f825b267e564e1\nwpt-pr: 64189\n", "files": ["testing/web-platform/tests/css/css-break/box-decoration-break-clone-block-in-inline-001.html"], "git_node": "60849f003f7c8488666a2a1f9c80f650a4f4b508", "git_parents": ["55ace236bb085c92cf401baf2d9515afb9faedda"], "node": "df152caeedf3c791ad24a2c4c2082610e17a41e7", "parents": ["6277626994bdeb6c792d9bc76f694b13c5096a35"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086772 [wpt PR 64189] - Update wpt metadata, a=testonly\n\nwpt-pr: 64189\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-break/box-decoration-break-clone-block-in-inline-001.html.ini"], "git_node": "dea3ff3cc25d9803d1a2242ae1642cf9c6c7b7f2", "git_parents": ["60849f003f7c8488666a2a1f9c80f650a4f4b508"], "node": "fb48df336911b2719f9312948faf4011b90949a6", "parents": ["df152caeedf3c791ad24a2c4c2082610e17a41e7"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086777 [wpt PR 64169] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322298, a=testonly\n\nAutomatic update from web-platform-tests\n[block] align-content moves a float child twice\n\nalign-content distributes a block container's extra space by moving its content. shiftForAlignContent moves\nevery child box and FloatingObjects::shiftFloatsBy then moves the float renderers again, so a float that is a\nchild of the container travels twice as far as the content it sits with.\n\nA float taken from a child's float list moves twice as well: the child moves with the rest of the content and\nshiftFloatsBy then moves the float's renderer, which belongs to that child. Only the FloatingObject's frame\nrect needs the shift there, since that rect is in this container's coordinate space.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322298\nWebKit-Canonical-Link: https://commits.webkit.org/319665@main\n\n--\n\nwpt-commits: 9df53f9d847f7d3b15e1b4d1615f167af39a3357\nwpt-pr: 64169\n", "files": ["testing/web-platform/tests/css/css-align/blocks/align-content-block-float-001.html"], "git_node": "5de68700a510bb500bb5c5bb9158dd2cce2956f1", "git_parents": ["dea3ff3cc25d9803d1a2242ae1642cf9c6c7b7f2"], "node": "4243fbede00c2eb1b7229995caef3c84ddbad623", "parents": ["fb48df336911b2719f9312948faf4011b90949a6"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086780 [wpt PR 64170] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322292, a=testonly\n\nAutomatic update from web-platform-tests\n[cleanup] Ask whether a document is fully active rather than whether it has a render tree\n\nThese call sites checked whether a document had a render tree when what they meant was whether it can ever render, which is what separates a\ndocument in a page from one made by DOMParser or held by a template. The spec calls that fully active, and its \"Updating the image data\"\nalgorithm names it directly. A non-rendered placeholder is fully active yet never gets a render tree, so Document::canEverRender() asks\nboth.\n\nhttps://html.spec.whatwg.org/multipage/images.html#updating-the-image-data\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322292\nWebKit-Canonical-Link: https://commits.webkit.org/319668@main\n\n--\n\nwpt-commits: f6da754c2a51f9bab36c90767e13ec11e7a1388e\nwpt-pr: 64170\n", "files": ["testing/web-platform/tests/css/cssom/stylesheets-in-non-rendered-document.html"], "git_node": "466e3663a903c72c70369c898521991775c59025", "git_parents": ["5de68700a510bb500bb5c5bb9158dd2cce2956f1"], "node": "903540c80b995569a18ec72ec54db143256cb5e9", "parents": ["4243fbede00c2eb1b7229995caef3c84ddbad623"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2086806 [wpt PR 64171] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320186, a=testonly\n\nAutomatic update from web-platform-tests\nTrailing whitespace is not trimmed when setting a value containing var() through the CSSOM\n\nSetting a property to a value that contains an arbitrary substitution function\n(var(), env(), attr(), ...) through the CSSOM kept any trailing whitespace in\nthe serialized value:\n\n    element.style.color = '    var(--a)   ';\n    element.style.color; // \"var(--a)   \" instead of \"var(--a)\"\n\nSuch a value cannot be parsed into a CSSValue, so it is stored as the original\ntoken sequence in a CSSSubstitutionValue and serialized back from those tokens.\nCSSPropertyParser::parseValue only consumed leading whitespace, so the trailing\nwhitespace tokens ended up in the sequence and in its serialization. Values\nthat do parse (e.g. \"red \") were unaffected, as was any value coming from\na style attribute or a style sheet, since CSSParser::consumeDeclaration trims\ntrailing whitespace per the \"consume a declaration\" algorithm, and so does the\nCSSOM path for custom properties in CSSParser::parseCustomPropertyValue.\n\nTrim trailing whitespace in CSSPropertyParser::parseValue as well, which covers\nboth the longhand and the shorthand case. Firefox and Chrome both trim here.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=320186\nWebKit-Canonical-Link: https://commits.webkit.org/319554@main\n\n--\n\nwpt-commits: 9bbf01ba9ba7f8e793f8aaeeaa1d2db54fe7d6c5\nwpt-pr: 64171\n", "files": ["testing/web-platform/tests/css/cssom/serialize-variable-reference-whitespace.html"], "git_node": "ef33de1501b36837a9b89ffc5445613083fa00e4", "git_parents": ["466e3663a903c72c70369c898521991775c59025"], "node": "9ebca74a59fe4b15ee95a3616aa1c9ea85b0f3cc", "parents": ["903540c80b995569a18ec72ec54db143256cb5e9"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086814 [wpt PR 64172] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322111, a=testonly\n\nAutomatic update from web-platform-tests\n[list-marker] A dynamic font change does not reach the list marker's content renderers\n\n  \u003cstyle\u003e\n  li { list-style-type: \"\\627\\644\\641\"; font-size: 16px }\n  \u003c/style\u003e\n  \u003cul\u003e\u003cli\u003etext\n  \u003cscript\u003e\n  document.body.offsetTop;\n  document.querySelector(\"li\").style.fontSize = \"32px\";\n  \u003c/script\u003e\n\nNow that markers create their own subtrees, style needs to get propagated too.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322111\nWebKit-Canonical-Link: https://commits.webkit.org/319476@main\n\n--\n\nwpt-commits: 3392ee7d5777c20449f29ad45be502a0f65302fe\nwpt-pr: 64172\n", "files": ["testing/web-platform/tests/css/css-lists/list-marker-font-size-mutation-ref.html", "testing/web-platform/tests/css/css-lists/list-marker-font-size-mutation.html"], "git_node": "dbac6babd4983df997d8cfd296b46350d8ce60de", "git_parents": ["ef33de1501b36837a9b89ffc5445613083fa00e4"], "node": "981b4c3df5f4f1e36058cd0060a96afd74f61c56", "parents": ["9ebca74a59fe4b15ee95a3616aa1c9ea85b0f3cc"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086830 [wpt PR 64173] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321874, a=testonly\n\nAutomatic update from web-platform-tests\nAccessible name of a display: contents element includes text from its siblings\n\nName from contents walks the element's children by taking its first child and then repeatedly the next\nsibling. A display: contents element has no box for its children to hang off, so the object after its last\nchild is one of the element's own siblings, and the walk carries on into it. The check meant to stop this only\ndid so when the next object had a display: contents parent of its own that differed, which the siblings do\nnot have, so nothing stopped it. Ask instead whether the next object is still a child of the element we\nstarted from.\n\nChrome and Firefox name all of the cases in the test \"x\". Whether the leak was visible depended on what\nfollowed in the markup, which is why the div at line 66 of\ncss/css-display/accessibility/display-contents-role-and-label.html reported \"x x x x\" while the same shape\nwith the link role a hundred lines later reported \"x\": the latter is followed by a display: contents list\nwhose item did trip the old check, and the two objects it had already walked into were whitespace only.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321874\nWebKit-Canonical-Link: https://commits.webkit.org/319287@main\n\n--\n\nwpt-commits: 46ca6e7124a10dfad7668ea25e81d4e4579998db\nwpt-pr: 64173\n", "files": ["testing/web-platform/tests/accname/name/comp_name_from_content_display_contents.html"], "git_node": "84689942037da3b39b29be97c6c58b308cea09f4", "git_parents": ["dbac6babd4983df997d8cfd296b46350d8ce60de"], "node": "8ccd5c38e63ab71262a7fb7fc737688b330a43fd", "parents": ["981b4c3df5f4f1e36058cd0060a96afd74f61c56"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086849 [wpt PR 64174] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321807, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] A block level box on a line is handed its own float as an intruding float\n\nlayoutSimpleBlockContentInInline lays the block level boxes on our lines out and gives up when the result is not\nusable, but the floats that layout propagated up into us stay on our float list. Normal inline layout then lays the\nsame boxes out again and takes that list for the floats intruding from outside, so a box both avoids and stops\ncontributing the overflow of the float it places itself. Put the list back the way it was before falling back.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321807\nWebKit-Canonical-Link: https://commits.webkit.org/319290@main\n\n--\n\nwpt-commits: 3f0f2fd2d29bc856feae37233a3ede9a3ea4b816\nwpt-pr: 64174\n", "files": ["testing/web-platform/tests/css/CSS2/floats/float-in-block-in-inline-001-ref.html", "testing/web-platform/tests/css/CSS2/floats/float-in-block-in-inline-001.html"], "git_node": "a29d08afde3094350815d4fb223373126b9c4911", "git_parents": ["84689942037da3b39b29be97c6c58b308cea09f4"], "node": "0149c84d5285d71b55beade16b6f1b0a00e8cc9c", "parents": ["8ccd5c38e63ab71262a7fb7fc737688b330a43fd"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086861 [wpt PR 64175] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321879, a=testonly\n\nAutomatic update from web-platform-tests\nanchor(right) does not resolve to an inline anchor's right edge in vertical-rl\n\nboxBoundingBoxInContainer maps the anchor's box into the containing block with localToContainerQuad. For a\nRenderInline, borderBoundingBox() is a rect at the origin carrying only the size (see RenderInline.h), so\nwhat gets mapped has no position, and the position was added afterwards from linesBoundingBox().location().\nThat composes in an unflipped writing mode but not in a flipped one, where mapping through a box flips\nagainst that box's own size: the flip lands on a rect sitting at the origin. Map the line boxes' rect\ninstead, which carries the position through the flip.\n\nMeasured for a 200px wide containing block in vertical-rl, with the anchor one Ahem glyph on the second line:\nanchor(right) is 180 and the anchored element's left edge came out at 220. The error is the anchor's block\naxis offset doubled, so it grows per line: 40 with one line break, 80 with two.\n\nThe inline needs a non-zero block axis offset, which is why the last case in the test passes without this\nchange. Anonymous block generation hides the other cases where the anchor's inline content sits in an\nanonymous block of its own, because that block's block axis extent equals the inline's and flipping inside\nit is a no-op.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321879\nWebKit-Canonical-Link: https://commits.webkit.org/319286@main\n\n--\n\nwpt-commits: 09146fb42a38c2742cecf24c7a9be59459f4c98f\nwpt-pr: 64175\n", "files": ["testing/web-platform/tests/css/css-anchor-position/anchor-inline-box-vrl.html"], "git_node": "fb95d1288b04dd38fa4db934eeedc34286be77b9", "git_parents": ["a29d08afde3094350815d4fb223373126b9c4911"], "node": "de19d489e6d41ffd8f0f8139980a625f61d0dd8e", "parents": ["0149c84d5285d71b55beade16b6f1b0a00e8cc9c"], "tags": []}, {"author": "Sam Weinig \u003csam@webkit.org\u003e", "branch": "default", "desc": "Bug 2086872 [wpt PR 64176] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321939, a=testonly\n\nAutomatic update from web-platform-tests\n[EvaluationTimeZoom] px values in calc() expressions that survive through computed style are being serialized incorrectly\n\nRemoves incorrect zoom unscaling of px values in computed value calc() expressions\nthat was left over from build time zoom.\n\nNow that no zoom unscaling is needed, the Style::ComputedStyle passed during conversion\nfrom Style::UnevaluatedCalculation to CSS::UnevalutatedCalc can be removed. Also simplified\ntoCSS conversion for numeric types a bit by using unresolvedValue() for all numeric types\ninstead of specializing for Length\u003c\u003e.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321939\nWebKit-Canonical-Link: https://commits.webkit.org/319320@main\n\n--\n\nwpt-commits: b634c99d9d2f8733cf439a2e1318553ac843f0ed\nwpt-pr: 64176\n", "files": ["testing/web-platform/tests/css/css-viewport/zoom/calc-computed.html"], "git_node": "b85548a3f3b44bb840b554d043b11c037692397a", "git_parents": ["fb95d1288b04dd38fa4db934eeedc34286be77b9"], "node": "974292671c9d0d685f7f0463b51862224434fffb", "parents": ["de19d489e6d41ffd8f0f8139980a625f61d0dd8e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086872 [wpt PR 64176] - Update wpt metadata, a=testonly\n\nwpt-pr: 64176\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-viewport/zoom/iframe-very-small-zoom-001-crash.html.ini", "testing/web-platform/meta/css/css-viewport/zoom/massive-zoom-viewbox-crash.html.ini"], "git_node": "25109ac144efad750f9fa96a279f70540c25e2ff", "git_parents": ["b85548a3f3b44bb840b554d043b11c037692397a"], "node": "a9bbb7377eaa811915bf8668267e0b0852fd1697", "parents": ["974292671c9d0d685f7f0463b51862224434fffb"], "tags": []}, {"author": "Taher Ali \u003ctaher_ali@apple.com\u003e", "branch": "default", "desc": "Bug 2086879 [wpt PR 64177] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321208, a=testonly\n\nAutomatic update from web-platform-tests\n[css-link-params] Add the link-parameters property\n\nThe link-parameters property sets named values on the external resources an\nelement references, which the resource reads with env():\n\nimg { link-parameters: param(--color, green); }\n\nThis PR parses, computes and serializes the property. The computed value is not\nused yet, so it has no rendering effect. That follows seperately.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321208\nWebKit-Canonical-Link: https://commits.webkit.org/319240@main\n\n--\n\nwpt-commits: 35d0ff644e98156160a606a1b2a818dbf4353d69\nwpt-pr: 64177\n", "files": ["testing/web-platform/tests/css/css-link-params/link-parameters-substitution.html"], "git_node": "1c752f27748c9efe46af808b15c2fe2252e5b329", "git_parents": ["25109ac144efad750f9fa96a279f70540c25e2ff"], "node": "8afa8b8c2d9b8014ca40d52100ca89c3445c9c47", "parents": ["a9bbb7377eaa811915bf8668267e0b0852fd1697"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086896 [wpt PR 64178] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321643, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] A box that collapsed through with clearance on a line pushes the content after it down by its margin\n\n  \u003cdiv style=\"float: left; height: 120px\"\u003e\u003c/div\u003e\n  \u003cspan\u003e\n    \u003cdiv style=\"clear: both; height: 0; margin-top: 50px\"\u003e\u003c/div\u003e\n  \u003c/span\u003e\n  foo\n\nClearance sits above the box's margin (CSS 2.2 9.5.2), so the 50px is already inside the space the clearance took\nand \"foo\" belongs at the float's bottom edge. It ends up 50px lower.\n\nA box whose margins collapse through keeps them for the content after it (CSS 2.2 8.3.1, \"If the top and bottom\nmargins of an element with clearance are adjoining, its margins collapse with the adjoining margins of following\nsiblings\"), and block layout applies them from the box's margin box top rather than from where its border box\nended up, which is also what the spec asks for: \"the positions of elements that have been collapsed through have\nno effect on the positions of the other elements with whose margins they are being collapsed\". It does that by\ntaking the container's height back to that position before the collapsed margin goes on.\n\nA line has no such position to take back. It starts where the content before it ended, which for this box is its\nborder box, and the margin then goes on top of that.\n\nThe clearance sits between the two margins (\"because the margins no longer collapse with a clearance between them\",\nCSS 2.2 9.5.2 example 1), so the box's margin before is behind that border box already and only the rest of the\ncollapsed margin is left for the content after it. Carry that margin in the margin state, next to the margin\nitself, and take it off what a line places.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321643\nWebKit-Canonical-Link: https://commits.webkit.org/319160@main\n\n--\n\nwpt-commits: 8d06fa6f3f07098e50c8d67001a1a36b279ba8c2\nwpt-pr: 64178\n", "files": ["testing/web-platform/tests/css/CSS2/normal-flow/clearance-covers-the-margin-of-a-collapsed-through-block-in-inline-ref.html", "testing/web-platform/tests/css/CSS2/normal-flow/clearance-covers-the-margin-of-a-collapsed-through-block-in-inline.html"], "git_node": "b9ee8823bc6e896726aabe6b782dc357431f64cd", "git_parents": ["1c752f27748c9efe46af808b15c2fe2252e5b329"], "node": "4c15a1903ed0382d5b1e7e1503103a0f555ea64d", "parents": ["8afa8b8c2d9b8014ca40d52100ca89c3445c9c47"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086902 [wpt PR 64179] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321504, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] A fieldset on a line takes its legend's overhang twice\n\nA legend that reaches past its fieldset's border edge is carried as an intrinsic border, which\nRenderBlock::borderBefore adds to the fieldset's border. The border box height the fieldset ends up with is\nmeasured with that border in it, so RenderBox::contentBoxHeight has nothing left and clamps at zero.\n\nupdateLayoutBoxDimensions builds the geometry for a box on a line from both of those: the content box height from\nthe renderer, and the border from adjustBorderForTableAndFieldset, which adds the intrinsic border again. The\nmargin box the line gets is then max(0, H - BP) + BP, which is BP rather than H whenever the legend overhangs, so\nthe fieldset takes the overhang twice and its container grows by it.\n\nThe overhang belongs to the fieldset's own content: the lines inside it start below the legend. It says nothing\nabout the box a line holds, whose inner layout the render tree does. So take it where the fieldset is the\nformatting context root and nowhere else, which leaves logicalBorder about a table's collapsed borders. The\ncontent box size comes from what is left of the border box, since the renderer's own answer is measured against a\nborder that has the overhang in it. Only the fieldset's own block axis grew, which is the container's inline axis\nwhen the two writing modes differ in orientation.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321504\nWebKit-Canonical-Link: https://commits.webkit.org/319033@main\n\n--\n\nwpt-commits: ecd7c3fb10d78e132a9b99c41adb6d7e7d94136e\nwpt-pr: 64179\n", "files": ["testing/web-platform/tests/html/rendering/non-replaced-elements/the-fieldset-and-legend-elements/fieldset-with-overhanging-legend-on-a-line-ref.html", "testing/web-platform/tests/html/rendering/non-replaced-elements/the-fieldset-and-legend-elements/fieldset-with-overhanging-legend-on-a-line.html"], "git_node": "39eb6c6d6fc864ea406d7f959f6cb6caa6d45e77", "git_parents": ["b9ee8823bc6e896726aabe6b782dc357431f64cd"], "node": "c279798e9b25c3e420903b8c4f790edebf12e860", "parents": ["4c15a1903ed0382d5b1e7e1503103a0f555ea64d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086902 [wpt PR 64179] - Update wpt metadata, a=testonly\n\nwpt-pr: 64179\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/rendering/non-replaced-elements/the-fieldset-and-legend-elements/crashtests/fieldset-middleclick.html.ini", "testing/web-platform/meta/html/rendering/non-replaced-elements/the-fieldset-and-legend-elements/fieldset-crash.html.ini"], "git_node": "3be3b60120d29c7c53853507ab2a9b3a48e04982", "git_parents": ["39eb6c6d6fc864ea406d7f959f6cb6caa6d45e77"], "node": "ebe0a2c6647542d861fda920a2db5618b2c741da", "parents": ["c279798e9b25c3e420903b8c4f790edebf12e860"], "tags": []}, {"author": "Joanne Pan \u003cjpan0917@gmail.com\u003e", "branch": "default", "desc": "Bug 2086908 [wpt PR 64180] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320984, a=testonly\n\nAutomatic update from web-platform-tests\n[css-values-5 inherit()] Implement inherit() substitution function\n\nImplement the inherit() arbitrary substitution function, which resolves to the\ninherited value of a custom property, meaning the parent's computed value, with\nan optional second argument as a fallback when the first resolves to the\nguaranteed-invalid value.\n\n\u003cinherit()\u003e = inherit( \u003ccustom-property-name\u003e, \u003cdeclaration-value\u003e? )\n\nThe argument grammar is the same as attr()'s, so parsing and argument\nsubstitution are shared with it. The first argument is substituted before being\nparsed as a custom property name, and failing that parse falls through to the\nfallback rather than being an error.\n\nInside a custom function the parent is the calling context's element, whose\ncustom properties resolve lazily, so the read forces that property first.\nOtherwise the result would depend on the calling element's declaration order.\n\nThe cascade now re-applies a declaration containing inherit() when the parent's\nnon-inherited style changes, where it previously recognised only a literally\nwritten inherit keyword. This covers custom property declarations too, which\nalso fixes the pre-existing case of `--y: inherit` on a non-inherited\nregistered property. A declaration that only reads such a property, as in\n`border-color: var(--y)`, is still not re-applied; that is the more general\nproblem tracked in bug 321094.\n\nBehind the CSSInheritFunctionEnabled setting, off by default.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=320984\nWebKit-Canonical-Link: https://commits.webkit.org/318999@main\n\n--\n\nwpt-commits: 8e94afd22bdd1606c176dfa081f30017a6892806\nwpt-pr: 64180\n", "files": ["testing/web-platform/tests/css/css-properties-values-api/custom-property-explicit-inherit-invalidation.html"], "git_node": "60431291f38ca289b0c40e11e0e5ec1681950dfd", "git_parents": ["3be3b60120d29c7c53853507ab2a9b3a48e04982"], "node": "ec1631ea8ba2c1f24dd81ba091f04ef66e80377c", "parents": ["ebe0a2c6647542d861fda920a2db5618b2c741da"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086908 [wpt PR 64180] - Update wpt metadata, a=testonly\n\nwpt-pr: 64180\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-properties-values-api/custom-property-explicit-inherit-invalidation.html.ini"], "git_node": "c5f164ff30a2aa2f14f24a4d182056b5d2ce0667", "git_parents": ["60431291f38ca289b0c40e11e0e5ec1681950dfd"], "node": "da77bbcc9d503ae6edcd207fa32eb1a82312c3c2", "parents": ["ec1631ea8ba2c1f24dd81ba091f04ef66e80377c"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086913 [wpt PR 64181] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321399, a=testonly\n\nAutomatic update from web-platform-tests\n[list-marker] direction on ::marker moves the marker box to the wrong side of the list item\n\n  \u003cstyle\u003e\n  ::marker { direction: rtl }\n  \u003c/style\u003e\n  \u003col\u003e\u003cli\u003etext\n\nThe marker should stay outside the list item's content, to its left. Instead it moved on\ntop of the content.\n\nAn outside marker is pulled out of the line by a negative inline-start margin, which\nupdateInlineMargins() wrote with the logical setter. That resolves start against the\nmarker's own direction, so a right-to-left marker got the negative margin on its right\nedge. Both readers ask the other way around, BoxGeometryUpdater against the parent's\nwriting mode and RenderBlock::marginStartForChild against the containing block's, so\nthey found nothing on the left and the marker stayed on the content.\n\nWrite the physical edges of the list item's inline axis instead: left and right in a\nhorizontal writing mode, top and bottom in a vertical one, which is the axis those readers\ntake them from. That is what css-lists-3 asks for as well: with marker-side: match-self,\nits initial value, the marker box is positioned using the directionality of the ::marker's\noriginating element rather than the marker's own.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321399\nWebKit-Canonical-Link: https://commits.webkit.org/318888@main\n\n--\n\nwpt-commits: b6a1af67c0c5ecb39e1078bd9d3f03dca9c6f8e9\nwpt-pr: 64181\n", "files": ["testing/web-platform/tests/css/css-lists/marker-direction-does-not-move-box-ref.html", "testing/web-platform/tests/css/css-lists/marker-direction-does-not-move-box.html"], "git_node": "d8f1962bcb76f2f747c622bbadcafcd8bee15a41", "git_parents": ["c5f164ff30a2aa2f14f24a4d182056b5d2ce0667"], "node": "30d24942919ea62b7b303d7a6c706c97cc9e3b32", "parents": ["da77bbcc9d503ae6edcd207fa32eb1a82312c3c2"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086921 [wpt PR 64182] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321351, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] An excluded list marker aligns with a block level box on a line instead of the first line of text\n\nAn outside list marker that takes no part in the list item's in-flow layout is positioned after layout,\naligned with the first line of the content. setExcludedMarkerPositions finds that line with\nInlineDisplay::Line::hasContentfulInFlowBox(), which a line whose only content is a block level box\nsatisfies. The marker then aligns with that box instead of with the text, landing at the top of the\ncontent rather than beside its first line of text.\n\nPrefer the first line with inline content on it, and fall back to a block content line only when there\nis none: a content box whose only line carries a block level box has no other line to align with.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321351\nWebKit-Canonical-Link: https://commits.webkit.org/318908@main\n\n--\n\nwpt-commits: 65c09c9a58c13cd1ace7eaab9451ed3db9f3b949\nwpt-pr: 64182\n", "files": ["testing/web-platform/tests/css/css-lists/outside-marker-alignment-with-block-content-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-alignment-with-block-content.html"], "git_node": "3e77e081ecc3d6b983749ad059e98e3e611199e4", "git_parents": ["d8f1962bcb76f2f747c622bbadcafcd8bee15a41"], "node": "fe4a6bba4411019dff0a9e58d2eb3faa72810236", "parents": ["30d24942919ea62b7b303d7a6c706c97cc9e3b32"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086929 [wpt PR 64183] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321302, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] A block level box on a line contributes its margin box to its container's overflow\n\nA block level box nested in an inline box sits on a line, and the line is made as wide as that box's margin\nbox so the box occupies the inline space it needs (InlineFormattingUtils::inlineItemWidth, and\nLine::appendBlock which sets the line's content width to it). That is the right width for laying out the\nline. It is not the right width for the container's overflow, and it was being used for both.\n\nThe two disagree because the inline formatting context and the render tree resolve the box's margins\ndifferently. The render tree resolves an over-constrained block level box by adjusting its end margin, which\ncan go negative, and layoutOverflowRectForPropagation() then adds max(0, marginEnd), so an over-constrained\nbox's overflow ends at its border box. The inline formatting context does not run that resolution - it is\nsizing a line, not placing a block sibling - so its margin box keeps the specified end margin.\n\n    \u003cdiv style=\"width: 100px; overflow: hidden\"\u003e\n        \u003cdiv\u003etext\u003cspan\u003e\u003cdiv style=\"width: 150px; margin-right: 20px\"\u003e\u003c/div\u003e\u003c/span\u003e\u003c/div\u003e\n    \u003c/div\u003e\n\nreports scrollWidth 170 instead of 150. The used end margin is 100 - 150 = -50 and extends nothing, but the line is 170 wide and hands that to the container.\n\nInk overflow needs the same treatment for a different reason. It was based on the line's scrollable\noverflow, and scrollable overflow is meant to enclose the box - you can scroll to it. Visual overflow is\nnot: RenderBox::addOverflowFromChild() returns early for a child with a self painting layer, so a composited\nblock level box must contribute nothing. Using the scrollable rect bypassed that, and the container's\ncomposited bounds grew to enclose a layer it does not paint. A line whose content is a block level box paints\nnothing itself, so start its ink overflow empty and let the box's own contribution be collected, which\nalready happens only when the box is not self painting.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321302\nWebKit-Canonical-Link: https://commits.webkit.org/318906@main\n\n--\n\nwpt-commits: 3cd3dcfa0f047009f9b3e733892f3e7281fe6635\nwpt-pr: 64183\n", "files": ["testing/web-platform/tests/css/cssom-view/scroll-width-with-over-constrained-block-in-inline.html"], "git_node": "43fb8e4eb08f0f7127618564273e8424cc2829ac", "git_parents": ["3e77e081ecc3d6b983749ad059e98e3e611199e4"], "node": "5f8055ff107372400a079d7f867eb65175cf080a", "parents": ["fe4a6bba4411019dff0a9e58d2eb3faa72810236"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086939 [wpt PR 64184] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321397, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] Only a relatively positioned inline offsets its out-of-flow children by the position of its line\n\nAn out-of-flow box whose containing block is an inline box is laid out against the nearest non-anonymous\nblock, so the distance from that block to the inline's own first fragment has to be added back.\nRenderInline::offsetForInFlowPositionedInline is what returns it, taking the inline box's logicalTop, and\nall four of its callers ask for it only when the inline is in-flow positioned. An inline is the containing\nblock for other reasons too, a filter among them, and in those cases the offset was dropped.\n\nAn anonymous block around the inline hid this. The wrapper is a RenderBox, so its own topLeftLocationOffset\ncarries the distance up the box chain in offsetFromContainer, and the inline sits at the top of the\nwrapper's first line, which leaves the half-leading at most to add. With a block level box on a line there\nis no wrapper: the inline's parent is the container itself, a RenderInline contributes no location offset\nof its own, and the whole distance down to the line is left to offsetForInFlowPositionedInline.\n\nAsk whether the inline is the containing block rather than whether it is in-flow positioned. For a\nRenderInline canContainAbsolutelyPositionedObjects covers the fixed position case as well, since the\nwillChange term of each only applies to a RenderBlock, leaving mayContainOutOfFlowPositionedObjects and a\nnon-static position.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321397\nWebKit-Canonical-Link: https://commits.webkit.org/318897@main\n\n--\n\nwpt-commits: d6d0177cacec3ff00182c4b2e8e2a4bb79a3fb85\nwpt-pr: 64184\n", "files": ["testing/web-platform/tests/css/filter-effects/filtered-inline-is-container-with-block-content-ref.html", "testing/web-platform/tests/css/filter-effects/filtered-inline-is-container-with-block-content.html"], "git_node": "2409ce62c18c2cdb0bfce1c3c4b595c2e11b1805", "git_parents": ["43fb8e4eb08f0f7127618564273e8424cc2829ac"], "node": "edcf91dfe798d909feb654ac11a433b4f4e556a0", "parents": ["5f8055ff107372400a079d7f867eb65175cf080a"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086959 [wpt PR 64185] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321236, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] A block level box's margin after is counted twice when only that box needs layout\n\nlayoutSimpleBlockContentInInline() is the fast-path taken when a container with inline children needs\nlayout only because one of its block level boxes does. It walks the block level boxes, lays each one out,\nand takes the MarginInfo the last one leaves behind. The lines are not laid out at all.\n\nThat is fine while the block level box is the only in-flow content, since its margins are then the\ncontainer's own. A line next to the box changes that: the line consumes the adjacent margin as its own\nspacing, so nothing is left to collapse with the container. Normal line layout accounts for this in\nLineBuilder::layoutInlineContent (see updateMarginStateIfNeeded), which does two things once a line places\ncontentful inline content - it resets the margin values, and it leaves the before side of the block. The\nshortcut lays out no lines, so it has to do both itself as the walk passes contentful inline content.\n\n    \u003cdiv\u003e\u003cspan\u003e\u003cdiv style=\"margin-bottom: 16px\"\u003eblock\u003c/div\u003e\u003c/span\u003eline after\u003c/div\u003e\n\nreports a 16px margin after on the container once something inside the block changes and this path runs:\nthe margin is still in MarginInfo when the caller hands it to handleAfterSideOfBlock(), so it is counted a\nsecond time.\n\n    \u003cdiv\u003eline before\u003cspan\u003e\u003cdiv style=\"margin-top: 16px\"\u003eblock\u003c/div\u003e\u003c/span\u003e\u003c/div\u003e\n\nreports a 16px margin before for the same reason. Resetting the margin values is not enough here, because\ncanCollapseWithMarginBefore() reads m_atBeforeSideOfBlock rather than the values, so collapseMargins()\nstill promotes the block's own margin before into the container's collapsed margin before and the container\nis then repositioned by its parent.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321236\nWebKit-Canonical-Link: https://commits.webkit.org/318792@main\n\n--\n\nwpt-commits: 48f16e4d9580d775768dcb25835ac41fb4d53a0c\nwpt-pr: 64185\n", "files": ["testing/web-platform/tests/css/CSS2/normal-flow/block-in-inline-margin-after-relayout.html", "testing/web-platform/tests/css/CSS2/normal-flow/block-in-inline-margin-before-relayout.html"], "git_node": "535de902b1eb6d39bc3e397a1f1f38fbd41a170d", "git_parents": ["2409ce62c18c2cdb0bfce1c3c4b595c2e11b1805"], "node": "5d85c3656cb90ff71e79769781f5e3d40c7e14d5", "parents": ["edcf91dfe798d909feb654ac11a433b4f4e556a0"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086987 [wpt PR 64186] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321198, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] A block whose content is a table is treated as self-collapsing\n\nLineLayout::isSelfCollapsingContent() looks for the block level box on a line so it can ask whether that\nbox is self-collapsing. It iterates the line's display boxes with\n\n    for (auto index = line.firstBoxIndex(); index \u003c line.lastBoxIndex(); ++index)\n\nbut lastBoxIndex() is firstBoxIndex() + boxCount() - 1, an inclusive index, so the last box on the line is\nnever examined. A block level box on a line is typically the last box on it, in which case the look-up\nreturns nullptr and the \"renderBox && !renderBox-\u003eisSelfCollapsingBlock()\" test is skipped altogether.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321198\nWebKit-Canonical-Link: https://commits.webkit.org/318782@main\n\n--\n\nwpt-commits: c67571241645b430205d7e32e1129172a2dd68e8\nwpt-pr: 64186\n", "files": ["testing/web-platform/tests/css/CSS2/normal-flow/block-with-table-content-is-not-self-collapsing.html"], "git_node": "d3718e63ddee360001cc7b6ef768e13f6216b7f4", "git_parents": ["535de902b1eb6d39bc3e397a1f1f38fbd41a170d"], "node": "7c284f69102ef0b0cfcef874a0112167475a2cf4", "parents": ["5d85c3656cb90ff71e79769781f5e3d40c7e14d5"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086987 [wpt PR 64186] - Update wpt metadata, a=testonly\n\nwpt-pr: 64186\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/CSS2/normal-flow/crashtests/block-in-inline-remove-crash.html.ini"], "git_node": "12cc387300aed5b90359ff06656730a3fac0c6c0", "git_parents": ["d3718e63ddee360001cc7b6ef768e13f6216b7f4"], "node": "1a6210a00d4a62ae122ec77418226b66f5d7400f", "parents": ["7c284f69102ef0b0cfcef874a0112167475a2cf4"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2086995 [wpt PR 64187] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321117, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] Nested inline boxes around a block level box are stretched by their nesting depth\n\nAn InlineLevelBox's logical top is stored relative to its parent inline box - LineBox::inlineLevelBoxAbsoluteTop\nwalks the ancestor chain adding each one up. LineBoxBuilder::constructBlockContent was assigning the same\nabsolute value to every line spanning inline box around the block:\n\n    lineSpanningInlineBox.setLogicalTop(blockGeometry.marginBefore());\n\nso the offset was counted once per nesting level. With a 16px offset, three levels of inline boxes ended up at\n16, 32 and 48, and the innermost one was stretched past its own content - taller than the box containing it,\nwhich cannot be right.\n\nOnly the outermost spanning box may carry that offset; the nested ones are already positioned relative to it.\n\nThe positions of the content were always correct - this is purely the inline boxes' reported bounds, which\nlinesBoundingBox() exposes to the render tree dump, to getBoundingClientRect() and to getClientRects().\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321117\nWebKit-Canonical-Link: https://commits.webkit.org/318704@main\n\n--\n\nwpt-commits: 37b4acd2b4e7f4c4de40684c0abdcadfbd796c30\nwpt-pr: 64187\n", "files": ["testing/web-platform/tests/css/CSS2/normal-flow/nested-inline-boxes-around-block-in-inline-001.html"], "git_node": "f6a4656d050ec34c1c6247b1abfea8bfd175a663", "git_parents": ["12cc387300aed5b90359ff06656730a3fac0c6c0"], "node": "d0e83d34bdc125f4e2cc5612c6518e45963ba824", "parents": ["1a6210a00d4a62ae122ec77418226b66f5d7400f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086995 [wpt PR 64187] - Update wpt metadata, a=testonly\n\nwpt-pr: 64187\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/CSS2/normal-flow/nested-inline-boxes-around-block-in-inline-001.html.ini"], "git_node": "9f0f99ab21945040920dec6ad535fb08d6422776", "git_parents": ["f6a4656d050ec34c1c6247b1abfea8bfd175a663"], "node": "d5c01e949a6a8c287b749b9662d6a808bc27ecbc", "parents": ["d0e83d34bdc125f4e2cc5612c6518e45963ba824"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2087056 [wpt PR 64188] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321124, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] Baseline of an inline-block whose last line box holds a block level box drops that line's offset\n\nFollow-up to bug 321083, which fixed firstLineBaseline() only. lastLineBaseline() has the same defect and\nneeded a second change alongside it, which is why it was left out there.\n\nAn inline-block's baseline is the baseline of its last line box. When that line box holds a block level box,\nLineLayout::lastLineBaseline() returned the block's own baseline without adding the block's offset within the\ninline-block, so the content after the inline-block aligned to the *first* line instead:\n\n    \u003cdiv style=\"display: inline-block\"\u003e\u003cbr\u003e\u003cspan\u003e\u003cdiv\u003ex\u003c/div\u003e\u003c/span\u003e\u003c/div\u003eafter\n\n\"after\" sat at the top of the inline-block rather than 20px down. Legacy line layout gets this right - it\nreports 32 where modern reported 14 on the reduction this came from.\n\nTwo changes are needed together:\n\n- Add the block's logicalTop, matching RenderBlock::lastLineBaseline() and firstLineBaseline().\n- Skip lines clamped away in the block direction. A line with no visible content is not the last line with\n  content. A line holding a block level box is excluded from that skip: what is visible\n  there is decided inside that block, which runs this same look-up on its own lines.\n\n(fast/overflow/line-clamp.html \u003c- visual progression)\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321124\nWebKit-Canonical-Link: https://commits.webkit.org/318702@main\n\n--\n\nwpt-commits: d88708b1675f7856d1ec9ccd98cdc6b473ddaa67\nwpt-pr: 64188\n", "files": ["testing/web-platform/tests/css/CSS2/visudet/inline-block-baseline-with-block-in-inline-001.html"], "git_node": "fb03502755041518b7a79faece7e4057606de3dd", "git_parents": ["9f0f99ab21945040920dec6ad535fb08d6422776"], "node": "59d25ca4d74376f0674ea7c6e197714ecb2d5c87", "parents": ["d5c01e949a6a8c287b749b9662d6a808bc27ecbc"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087056 [wpt PR 64188] - Update wpt metadata, a=testonly\n\nwpt-pr: 64188\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/CSS2/visudet/crashtests/canvas-huge-min-max-sizes.html.ini", "testing/web-platform/meta/css/CSS2/visudet/inline-block-baseline-with-block-in-inline-001.html.ini"], "git_node": "d65fdcf9658b0e662011ba0666cdd1bb3602f29f", "git_parents": ["fb03502755041518b7a79faece7e4057606de3dd"], "node": "4f2ab18c8492b4a29ef9959a3f905c4ef9e352e8", "parents": ["59d25ca4d74376f0674ea7c6e197714ecb2d5c87"], "tags": []}, {"author": "taher \u003ctaher_ali@apple.com\u003e", "branch": "default", "desc": "Bug 2075458 [wpt PR 62944] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324731, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=324731\n\n--\n\nwpt-commits: bdd8436aca30d87da48bcf5fbf1a7467316309f4\nwpt-pr: 62944\n", "files": ["testing/web-platform/tests/svg/styling/css-linked-parameters/link-parameters-fragment-shared-resource-ref.html", "testing/web-platform/tests/svg/styling/css-linked-parameters/link-parameters-fragment-shared-resource.html"], "git_node": "a3b49f74c5d4179eda7c49c104697120e96dd2db", "git_parents": ["d65fdcf9658b0e662011ba0666cdd1bb3602f29f"], "node": "4ea1342e0c5d2e2781294aa75715e53445510a96", "parents": ["4f2ab18c8492b4a29ef9959a3f905c4ef9e352e8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075458 [wpt PR 62944] - Update wpt metadata, a=testonly\n\nwpt-pr: 62944\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/styling/css-linked-parameters/link-parameters-fragment-shared-resource.html.ini"], "git_node": "c12bfd89ade3d5490cdaf41a69ae2e1cfdf11bc4", "git_parents": ["a3b49f74c5d4179eda7c49c104697120e96dd2db"], "node": "17a77756ed29736e51153a71db2f6c1253009acc", "parents": ["4ea1342e0c5d2e2781294aa75715e53445510a96"], "tags": []}, {"author": "Sam Weinig \u003csam@webkit.org\u003e", "branch": "default", "desc": "Bug 2087079 [wpt PR 64127] - Set the document language before creating the OffscreenCanvas in 2d.text.measure.lang.inherit, a=testonly\n\nAutomatic update from web-platform-tests\nSet the document language before creating the OffscreenCanvas in 2d.text.measure.lang.inherit\n\n--\n\nwpt-commits: bdf786fd19c5dd7691b8058dd4e39df4e8f9d059\nwpt-pr: 64127\n", "files": ["testing/web-platform/tests/html/canvas/element/text/2d.text.measure.lang.inherit.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.measure.lang.inherit.html", "testing/web-platform/tests/html/canvas/tools/gentest.py", "testing/web-platform/tests/html/canvas/tools/templates/testharness_element.html", "testing/web-platform/tests/html/canvas/tools/templates/testharness_offscreen.html", "testing/web-platform/tests/html/canvas/tools/yaml/text.yaml"], "git_node": "39d5ebc967f6068d20ff787014ad1d93d0779362", "git_parents": ["c12bfd89ade3d5490cdaf41a69ae2e1cfdf11bc4"], "node": "91bfde4d7b3df36f7ba2d35e56f66d66777a0bbd", "parents": ["17a77756ed29736e51153a71db2f6c1253009acc"], "tags": []}, {"author": "Andrew Martinez \u003camartinez55@apple.com\u003e", "branch": "default", "desc": "Bug 2074988 [wpt PR 62905] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324272, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=324272\n\n--\n\nwpt-commits: 107c4f6a9ad47f141e8b5713782b5c5d020cb872\nwpt-pr: 62905\n", "files": ["testing/web-platform/tests/css/css-sizing/parsing/max-size-invalid.html", "testing/web-platform/tests/css/css-sizing/parsing/max-size-shorthand.html", "testing/web-platform/tests/css/css-sizing/parsing/max-size-valid.html", "testing/web-platform/tests/css/css-sizing/parsing/min-size-invalid.html", "testing/web-platform/tests/css/css-sizing/parsing/min-size-shorthand.html", "testing/web-platform/tests/css/css-sizing/parsing/min-size-valid.html", "testing/web-platform/tests/css/css-sizing/size-shorthand-serialization.tentative.html"], "git_node": "3c7437b1052787fccab8aa62606e5a306b753441", "git_parents": ["39d5ebc967f6068d20ff787014ad1d93d0779362"], "node": "0bf3bae921610542c64cbe7e7fd4619d7edc9e59", "parents": ["91bfde4d7b3df36f7ba2d35e56f66d66777a0bbd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074988 [wpt PR 62905] - Update wpt metadata, a=testonly\n\nwpt-pr: 62905\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-sizing/parsing/max-size-shorthand.html.ini", "testing/web-platform/meta/css/css-sizing/parsing/max-size-valid.html.ini", "testing/web-platform/meta/css/css-sizing/parsing/min-size-shorthand.html.ini", "testing/web-platform/meta/css/css-sizing/parsing/min-size-valid.html.ini", "testing/web-platform/meta/css/css-sizing/size-shorthand-serialization.tentative.html.ini"], "git_node": "d8cff419029624a29a740e5976387b302858b814", "git_parents": ["3c7437b1052787fccab8aa62606e5a306b753441"], "node": "16a34465a642a778449dcfaa1338322554a75d42", "parents": ["0bf3bae921610542c64cbe7e7fd4619d7edc9e59"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2087326 [wpt PR 64258] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=329099, a=testonly\n\nAutomatic update from web-platform-tests\nA moved \u003cselectedcontent\u003e should be updated through its \u003cselect\u003e\n\nAlign with https://github.com/whatwg/html/pull/13005 which no longer gives\n\u003cselectedcontent\u003e a pending update of its own.\n\n324149@main gave \u003cselectedcontent\u003e a pending update flag so that moving it\nrepeatedly queues a single microtask, which does nothing once the element is\nupdated otherwise. The update of its \u003cselect\u003e's \u003cselectedcontent\u003e elements,\nwhich removing or moving an \u003coption\u003e queues, already works that way, so moving\na \u003cselectedcontent\u003e now queues that instead. Moving a \u003cselectedcontent\u003e and then\nremoving the selected option thus updates it once, where both microtasks\nupdated it before. The \u003cselect\u003e's other \u003cselectedcontent\u003e elements are now\nupdated as well.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329099\n\n--\n\nwpt-commits: 9e2aa03d31184dedc4079bf3f17c901f6156b414\nwpt-pr: 64258\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/selectedcontent-queued-update.html"], "git_node": "a1af52b821fd17d3cb758750553c3a4da650788f", "git_parents": ["d8cff419029624a29a740e5976387b302858b814"], "node": "748151ff687b7c49c036888e25ea60273f17611e", "parents": ["16a34465a642a778449dcfaa1338322554a75d42"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087326 [wpt PR 64258] - Update wpt metadata, a=testonly\n\nwpt-pr: 64258\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/selectedcontent-queued-update.html.ini"], "git_node": "cf34548c4180528be4347c349afcf67551ec1db7", "git_parents": ["a1af52b821fd17d3cb758750553c3a4da650788f"], "node": "1e11562bb21873d6e06da5a357fe59daaf41779b", "parents": ["748151ff687b7c49c036888e25ea60273f17611e"], "tags": []}, {"author": "Jose Dapena Paz \u003cjdapena@igalia.com\u003e", "branch": "default", "desc": "Bug 2087366 [wpt PR 64261] - ContainerTiming WPT: don't use Element Timing helpers in pseudo tests, a=testonly\n\nAutomatic update from web-platform-tests\nContainerTiming WPT: don't use Element Timing helpers in pseudo tests\n\nThe pseudo-element tests loaded element-timing-helpers.js only for\ncheckRect(), which checks the same intersection rect edges as\ncheckContainerIntersectionRect(). Use the container timing helper, so\nthese tests no longer depend on the Element Timing test resources.\n\nChange-Id: If17f5e07ad9afc6f24ead7a9a8239a81cdbab312\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8629363\nReviewed-by: Scott Haseley \u003cshaseley@chromium.org\u003e\nCommit-Queue: Jos\u00e9 Dapena Paz \u003cjdapena@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1728195}\n\n--\n\nwpt-commits: d9e192dd3b5887d411ce89cdd109c45a7a6b8a22\nwpt-pr: 64261\n", "files": ["testing/web-platform/tests/container-timing/tentative/pseudo-background-image-before-in-container-timing.html", "testing/web-platform/tests/container-timing/tentative/pseudo-with-image-content-in-container-timing.html", "testing/web-platform/tests/container-timing/tentative/pseudo-with-text-content-in-container-timing.html"], "git_node": "87b1ed015c23f5faaa5561b23c7b34a85455b637", "git_parents": ["cf34548c4180528be4347c349afcf67551ec1db7"], "node": "d60346fab167a9d699f578acc67b542523410412", "parents": ["1e11562bb21873d6e06da5a357fe59daaf41779b"], "tags": []}, {"author": "David Baron \u003cdbaron@chromium.org\u003e", "branch": "default", "desc": "Bug 2087378 [wpt PR 64264] - Correct cross-origin check for relatedTarget to handle null execution context., a=testonly\n\nAutomatic update from web-platform-tests\nCorrect cross-origin check for relatedTarget to handle null execution context.\n\nThis fixes the cross-origin check for relatedTarget for both of the\nfixes in commit bb79a99bd4473e26031cd5433e34d047fa527f3c to handle null\nexecution context better (by treating it as cross-origin).\n\nThis also changes the defense-in-depth part of the fix to CHECK() rather\nthan setting relatedTarget to null, since I think that's more\nappropriate for a defense-in-depth check (and if we're actually\nhitting it we may need to fix the callers that are causing it in other\nways).\n\nFixed: 577072000\nBug: 572556403, 574379564, 574843953, 577359831\nChange-Id: I954eadb02e7a9bec59c0a0306d62cbdfad3543ea\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8641583\nCommit-Queue: David Baron \u003cdbaron@chromium.org\u003e\nReviewed-by: Mustaq Ahmed \u003cmustaq@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1728234}\n\n--\n\nwpt-commits: fd3d5e4c393a0ee7ff29b7e6c2281e486f7699ee\nwpt-pr: 64264\n", "files": ["testing/web-platform/tests/pointerevents/pointerevent_boundary_events_cross_document_same_origin.tentative.html", "testing/web-platform/tests/pointerevents/pointerevent_boundary_events_cross_origin.html", "testing/web-platform/tests/pointerevents/resources/pointerevent_boundary_events_cross_origin_child.html"], "git_node": "9566f85a6c99c12aeee324edc951290b219c6ead", "git_parents": ["87b1ed015c23f5faaa5561b23c7b34a85455b637"], "node": "18682d558b62e5833df13ee85d6ad13cfe5a8746", "parents": ["d60346fab167a9d699f578acc67b542523410412"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087378 [wpt PR 64264] - Update wpt metadata, a=testonly\n\nwpt-pr: 64264\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/pointerevents/pointerevent_boundary_events_cross_document_same_origin.tentative.html.ini", "testing/web-platform/meta/pointerevents/pointerevent_boundary_events_cross_origin.html.ini"], "git_node": "a95e6d4a526ac432cb45b59fb903cbb494371f0d", "git_parents": ["9566f85a6c99c12aeee324edc951290b219c6ead"], "node": "be252d16bee390481a6d4d09b68056621520fd8e", "parents": ["18682d558b62e5833df13ee85d6ad13cfe5a8746"], "tags": []}, {"author": "Jer Noble \u003cjer.noble@apple.com\u003e", "branch": "default", "desc": "Bug 2087389 [wpt PR 64269] - [WebVTT] 8x wpt/webvtt tests are failing with small pixel differences due to reference file issues, a=testonly\n\nAutomatic update from web-platform-tests\n[WebVTT] 8x wpt/webvtt tests are failing with small pixel differences due to reference file issues (#64269)\n\n8 different tests in wpt/webvtt set `display:inline-block` to text-runs under test; however this\ncauses rounding errors to accumulate during text painting due to the difference in layout between\ninline-block with relative positioning and \"normal\" inline text runs. What's more, setting these\nruns to be `inline-block` appears to be unnecessary in the first place; `margin` and `border` styles\ndon't require the run to be set to `inline-block` in order to have any effect. Removing this setting\ncauses all 8 tests to pass.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328950\nWebKit-Canonical-Link: https://commits.webkit.org/324846@main\n--\n\nwpt-commits: 11c3275cb8c447f51c028ffc466aa1f3d5f22746\nwpt-pr: 64269\n", "files": ["testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/bold_object/bold_outline_properties-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/bold_object/bold_outline_shorthand-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/class_object/class_outline_properties-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/class_object/class_outline_shorthand-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/italic_object/italic_outline_properties-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/italic_object/italic_outline_shorthand-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/underline_object/underline_outline_properties-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/underline_object/underline_outline_shorthand-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_outline_properties-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_outline_shorthand-ref.html"], "git_node": "c383071f57ef4cd314bf00f1ac88d20a62398dcf", "git_parents": ["a95e6d4a526ac432cb45b59fb903cbb494371f0d"], "node": "a6d63b41104925205a4c7c3a105d8071262b7382", "parents": ["be252d16bee390481a6d4d09b68056621520fd8e"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2087680 [wpt PR 63688] - [chromium-bidi] Emit worker network events to user contexts, a=testonly\n\nAutomatic update from web-platform-tests\n[chromium-bidi] Emit worker network events to user contexts\n\n- Emit network events originating from dedicated workers to\n  subscriptions scoped to the worker's user context.\n- Previously, dedicated worker network requests fell back to global\n  event registration without a browsing context, which ignored\n  subscriptions filtered by `userContexts`.\n- Pass the CDP target's user context when registering global network\n  events and match it against `userContexts` subscriptions.\n\nBug: 571526261\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nChange-Id: If5cc2d2d0b58de60ea1ba6cd670e7e32a240d6a4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8579178\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nReviewed-by: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nCommit-Queue: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1719400}\n\n--\n\nwpt-commits: c8979e94f57ba4de44bfbfc9258ab736dc0733cd\nwpt-pr: 63688\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/network/combined/network_events.py", "testing/web-platform/tests/webdriver/tests/support/bidi/fixtures.py"], "git_node": "688d21e8ec27e86e624ee41b805604e40d68a8c2", "git_parents": ["c383071f57ef4cd314bf00f1ac88d20a62398dcf"], "node": "29b505416fdd3170d43ae5ad0c03dd0e072cfc9a", "parents": ["a6d63b41104925205a4c7c3a105d8071262b7382"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087680 [wpt PR 63688] - Update wpt metadata, a=testonly\n\nwpt-pr: 63688\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/network/combined/network_events.py.ini"], "git_node": "5d43df0ffea395d1287c5093fc8bc0a7728325fb", "git_parents": ["688d21e8ec27e86e624ee41b805604e40d68a8c2"], "node": "997b656d6d9a7c7c4e11fecea23e39629f84927b", "parents": ["29b505416fdd3170d43ae5ad0c03dd0e072cfc9a"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2085079 [wpt PR 63953] - Remove void element end tags from WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nRemove void element end tags from WPTs\n\nimg, input and embed have no end tag. Writing \u003c/img\u003e or \u003c/input\u003e anyway\nis a parse error, and the parser drops the tag, so the source suggests a\nstructure the document never had. \u003c/br\u003e is the one exception: the parser\nrewrites it into a \u003cbr\u003e start tag, so it is spelled \u003cbr\u003e instead of\nbeing deleted.\n\nThis CL removes end tags like these from some WPT tests. There's no\nbehavioral change.\n\nBug: 542686202\nChange-Id: I81a9054f866ccf11a1f2ee486c5328ba91195629\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8220271\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCommit-Queue: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nReviewed-by: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1723284}\n\n--\n\nwpt-commits: eb8f1a9c8889b5c39f7acfd735085a421d0b5037\nwpt-pr: 63953\n", "files": ["testing/web-platform/tests/editing/other/password-bidi-dblclick.html", "testing/web-platform/tests/focus/support/iframe-activeelement-after-focusing-out-different-site-iframes-outer.sub.html", "testing/web-platform/tests/focus/support/iframe-activeelement-after-focusing-out-iframes-inner.html", "testing/web-platform/tests/focus/support/iframe-activeelement-after-focusing-out-same-site-iframes-outer.html", "testing/web-platform/tests/inert/inert-label-focus.html", "testing/web-platform/tests/infrastructure/testdriver/actions/multiDevice.html", "testing/web-platform/tests/mathml/relations/html5-tree/focus-blur-001.html", "testing/web-platform/tests/pointerevents/capturing_boundary_event_handler_at_ua_shadowdom.html", "testing/web-platform/tests/selection/shadow-dom/cross-shadow-boundary-img-ref.html", "testing/web-platform/tests/selection/stringifier_editable_element.tentative.html", "testing/web-platform/tests/shadow-dom/leaktests/html-collection.html", "testing/web-platform/tests/svg/styling/svg-filter-render-web-plugin-ref.tentative.html", "testing/web-platform/tests/svg/styling/svg-filter-render-web-plugin.tentative.https.html", "testing/web-platform/tests/webrtc/getstats.html", "testing/web-platform/tests/window-management/multi-screen-fullscreen-companion.tentative.https.html", "testing/web-platform/tests/window-management/multi-screen-window-open.tentative.https.html"], "git_node": "bcf6afd1aee1d53a724dd97221edf1a6b4cd2855", "git_parents": ["5d43df0ffea395d1287c5093fc8bc0a7728325fb"], "node": "05e955c30415c32c259e4307808198daa0f36bd6", "parents": ["997b656d6d9a7c7c4e11fecea23e39629f84927b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085079 [wpt PR 63953] - Update wpt metadata, a=testonly\n\nwpt-pr: 63953\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webrtc/RTCRtpTransceiver.https.html.ini", "testing/web-platform/meta/webrtc/protocol/rtp-extension-support.html.ini"], "git_node": "f23646394cbb74dd4610c3c2b45ea402dcc7095e", "git_parents": ["bcf6afd1aee1d53a724dd97221edf1a6b4cd2855"], "node": "af0f9aa488c51492d5891394698e7e500742121e", "parents": ["05e955c30415c32c259e4307808198daa0f36bd6"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2087683 [wpt PR 64270] - Move reading-flow/reading-order tests out of tentative, a=testonly\n\nAutomatic update from web-platform-tests\nMove reading-flow/reading-order tests out of tentative\n\nThe CSS specs for these concepts has been landed for almost\ntwo years, and is located here:\n\nhttps://www.w3.org/TR/css-display-4/\n\nChange-Id: I558d2b20450084924088753135901effed57ffcf\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8613448\nCommit-Queue: Chris Harrelson \u003cchrishtr@chromium.org\u003e\nReviewed-by: Chris Harrelson \u003cchrishtr@chromium.org\u003e\nCommit-Queue: Mason Freed \u003cmasonf@chromium.org\u003e\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1725224}\n\n--\n\nwpt-commits: 0645c5a40d9d26541256af5b4f7a1b8d3d13930c\nwpt-pr: 64270\n", "files": ["testing/web-platform/tests/css/css-display/reading-flow/WEB_FEATURES.yml", "testing/web-platform/tests/css/css-display/reading-flow/reading-flow-computed.html", "testing/web-platform/tests/css/css-display/reading-flow/reading-flow-invalid.html", "testing/web-platform/tests/css/css-display/reading-flow/reading-flow-valid.html", "testing/web-platform/tests/css/css-display/reading-flow/reading-order-computed.html", "testing/web-platform/tests/css/css-display/reading-flow/reading-order-invalid.html", "testing/web-platform/tests/css/css-display/reading-flow/reading-order-valid.html", "testing/web-platform/tests/css/css-display/reading-flow/tentative/WEB_FEATURES.yml", "testing/web-platform/tests/css/css-display/reading-flow/tentative/reading-flow-computed.html", "testing/web-platform/tests/css/css-display/reading-flow/tentative/reading-flow-invalid.html", "testing/web-platform/tests/css/css-display/reading-flow/tentative/reading-flow-valid.html", "testing/web-platform/tests/css/css-display/reading-flow/tentative/reading-order-computed.html", "testing/web-platform/tests/css/css-display/reading-flow/tentative/reading-order-invalid.html", "testing/web-platform/tests/css/css-display/reading-flow/tentative/reading-order-valid.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/WEB_FEATURES.yml", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/carousel-grid-order.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/flex-flow.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/flex-visual-fragmentation.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/flex-visual-order.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/flex-visual-wrapped-fragmentation.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-auto-flow-reading-order.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-columns-fragmentation.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-columns.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-001.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-002.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-003.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-004.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/grid-lanes-column-reading-flow-006.html", "testing/web-platform/tests/shadow-dom/focus-navigat