d47cf5fc7fd21e90742b0360dead0c71f568b02", "parents": ["ddaad66bdfd03ec64505d4a3388f70bed4d0ad58"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090040 - Use nsIPrincipal instead of PrincipalInfo in PBackgroundLocalStorageCache. r=dom-storage-reviewers,ipc-reviewers,nika,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340325\n", "files": ["dom/storage/LocalStorageManager.cpp", "dom/storage/PBackgroundLocalStorageCache.ipdl", "dom/storage/StorageIPC.cpp", "dom/storage/StorageIPC.h", "ipc/glue/BackgroundChildImpl.cpp", "ipc/glue/BackgroundChildImpl.h", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/BackgroundParentImpl.h", "ipc/glue/PBackground.ipdl"], "git_node": "cd0c8bcfd573b091c5251d1bb671e237f07b65af", "git_parents": ["e30693296ed9e16f3c3702f31cd6c04a8252bd66"], "node": "8511b35d62520f9bb18a00b830b1c43b4a6aa3f5", "parents": ["5d47cf5fc7fd21e90742b0360dead0c71f568b02"], "tags": []}, {"author": "Dave Vandyke \u003ckzar@kzar.co.uk\u003e", "branch": "default", "desc": "Bug 2091125 - Ensure sender.verified where possible for WebExtension messages r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342806\n", "files": ["toolkit/components/extensions/ExtensionParent.sys.mjs"], "git_node": "db5366807a4e2fd6e567077b90b2c13131ceacf2", "git_parents": ["cd0c8bcfd573b091c5251d1bb671e237f07b65af"], "node": "0ca4de2d07afac126877f576a64668037929ced4", "parents": ["8511b35d62520f9bb18a00b830b1c43b4a6aa3f5"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091301 - [customizable menu] Hide the notification dot from the menu button if the menu item needing attention was hidden r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341769\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserToolbarStoreBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/TabPreview.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/configuration/BrowserMenuConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/configuration/BrowserMenuConfigurationTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddlewareTest.kt"], "git_node": "40ab6f7e9a07f31eefd14f0b51792b6e703de810", "git_parents": ["db5366807a4e2fd6e567077b90b2c13131ceacf2"], "node": "860d6c983868dfe894be383901082be0d599fa23", "parents": ["0ca4de2d07afac126877f576a64668037929ced4"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2092102 [Wayland] Move VSyncDispatcher to nsWindowWayland and implement OnUnmapNative() r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342154\n", "files": ["widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h", "widget/gtk/nsWindowWaylandGtk.cpp", "widget/gtk/nsWindowWaylandGtk.h"], "git_node": "08ba0f44ced58d63cc6b33882f14ce5d75d53561", "git_parents": ["40ab6f7e9a07f31eefd14f0b51792b6e703de810"], "node": "94364c1f25365594169b6c2d1348e5e77033f173", "parents": ["860d6c983868dfe894be383901082be0d599fa23"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2092102 [Wayland] Remove direct MozContainer use r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342736\n", "files": ["widget/gtk/GtkCompositorWidget.cpp", "widget/gtk/IMContextWrapper.cpp", "widget/gtk/MozContainerWayland.cpp", "widget/gtk/WaylandVsyncSource.cpp", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/gtk/nsWindowWayland.cpp"], "git_node": "3d42d1a68f64cad8cb68f1212308de3a7ad94c2c", "git_parents": ["08ba0f44ced58d63cc6b33882f14ce5d75d53561"], "node": "d7ac792d40b866a0a174393a29dfae2c96b3c601", "parents": ["94364c1f25365594169b6c2d1348e5e77033f173"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2092102: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "b5cd4459c5bcdf93bdf66834d1e3d02b4978b980", "git_parents": ["3d42d1a68f64cad8cb68f1212308de3a7ad94c2c"], "node": "2f1ebeebce3194ae0890664cc4080f6c7a6b4dbf", "parents": ["d7ac792d40b866a0a174393a29dfae2c96b3c601"], "tags": []}, {"author": "Mitar \u003cmitar.git@tnode.com\u003e", "branch": "default", "desc": "Bug 2086801 - [Linux] Install the SIGTERM handler once the app shell exists r=stransky,gtk-reviewers\n\nXREMain::XRE_mainStartup() called nsAppShell::InstallTermSignalHandler(),\nwhich returns early while sAppShell is null, and XRE_main() creates the app\nshell only afterwards, when it initializes XPCOM. So the handler from bug\n1837907 was never installed, SIGTERM killed Firefox without writing its\nsession, and the next start treated the session as crashed.\n\nThe handler is now installed in XREMain::XRE_mainRun(), next to the other\nGTK setup there, when the app shell exists. Background tasks keep the\ndefault disposition, as marSuccessPartialWhileBackgroundTaskRunning.js\nexpects a background task to die from the signal.\n\nThe handler replaces the FatalSignalHandler which nsProfileLock installed\nfor SIGTERM when it locked the profile, so debug builds warn that a handler\nis already set. The clean shutdown removes the lock files itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340638\n", "files": ["toolkit/xre/nsAppRunner.cpp", "widget/gtk/nsAppShell.cpp"], "git_node": "2cdc881b9879bee3786c1fcbf53fa44ffa265ca4", "git_parents": ["b5cd4459c5bcdf93bdf66834d1e3d02b4978b980"], "node": "a28643e04015fc5f6afb7e43d2d1def8dc2acc76", "parents": ["2f1ebeebce3194ae0890664cc4080f6c7a6b4dbf"], "tags": []}, {"author": "lottiehope \u003clottie_hope@hotmail.co.uk\u003e", "branch": "default", "desc": "Bug 2082513 - Add the \"Verified by\" line to the certificate details sub-page. r=android-reviewers,android-l10n-reviewers,cbect,parker\n\nShows the issuer organization, falling back to the issuer common name. Until the\nmissing-field behaviour is decided, the line is hidden when neither is present.\nThe sub-page previews now use the issued-to card and the \"Verified by\" line.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342239\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/CertificateDetailsPanel.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/CertificateVerifiedBy.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/CertificateVerifiedByTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/IssuerDisplayNameTest.kt"], "git_node": "d357ff4b115e60677ecbd8b44db9d9ec56bdedba", "git_parents": ["2cdc881b9879bee3786c1fcbf53fa44ffa265ca4"], "node": "6237a5a9e1d0d161864c51cd500c7a4f4feecd1f", "parents": ["a28643e04015fc5f6afb7e43d2d1def8dc2acc76"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091152 - Don't clear alt-svc mappings for a connection inside a tunnel, r=necko-reviewers,jesup\n\nA connection inside a CONNECT tunnel can fail because the tunnel was torn down, rather than because the origin reset the connection. Such errors do not indicate whether the origin\u2019s Alt-Svc mappings are still valid. However, closing a proxy connection caused the validated Alt-Svc mappings for every origin tunneled through it to be cleared.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342639\n", "files": ["netwerk/protocol/http/HttpConnectionUDP.cpp", "netwerk/protocol/http/nsHttpConnection.cpp"], "git_node": "41ad1192787686685aec75de279b7c83b391967a", "git_parents": ["d357ff4b115e60677ecbd8b44db9d9ec56bdedba"], "node": "79dd0bdf68888b2de041bb2f69276ffa45b3b053", "parents": ["6237a5a9e1d0d161864c51cd500c7a4f4feecd1f"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2092518 - Skip sync if the broadcast value is older than the local timestamp r=gbeckley,remote-settings-reviewers\" for causing failures at test_remote_settings_poll.js.\n\nThis reverts commit 4046543e5ba85fc64aaf0f22b88a8d3a105e10a8.\n", "files": ["services/settings/remote-settings.sys.mjs", "services/settings/test/unit/test_remote_settings_poll.js"], "git_node": "d893c2495362e72b570c85951dc98840b2f5d512", "git_parents": ["41ad1192787686685aec75de279b7c83b391967a"], "node": "f68866e19be4abf947d77767475551875edd1c29", "parents": ["79dd0bdf68888b2de041bb2f69276ffa45b3b053"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2088719 - Stop initializing graphics devices for media in content and parent processes. r=aosmond,media-playback-reviewers\n\nDecoders in these processes never use the devices: DXVA is only used in the RDD\nand GPU processes. Initializing them could hit the win32k lockdown assertion\nwhen a media.rdd-* pref was changed after startup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341315\n", "files": ["dom/media/MediaDecoder.cpp", "dom/media/test/browser/browser.toml", "dom/media/test/browser/browser_rdd_pref_change_new_content_process.js", "gfx/layers/wr/WebRenderBridgeChild.cpp"], "git_node": "5501219211168237d74fb2021176c3af47f38f3b", "git_parents": ["d893c2495362e72b570c85951dc98840b2f5d512"], "node": "f7a2468d576c4c679380a36aee4af829398180db", "parents": ["f68866e19be4abf947d77767475551875edd1c29"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092621 - Update the docs on the isIntentComponentSyncAuth sync-auth custom tab exemption to explain why it is still needed. r=john-oberhauser\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/448\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/AllowedDuringOnboardingIntent.kt"], "git_node": "184587ce4d8f3d63e63edb48f173aac97a9c8169", "git_parents": ["5501219211168237d74fb2021176c3af47f38f3b"], "node": "f4d49242dc5d3872a92ffc49868dfa11583c410e", "parents": ["f7a2468d576c4c679380a36aee4af829398180db"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2076741 - Run platform tests with fission on GeckoView. r=geckoview-reviewers,owlish\n\nSome tests are still failing, so we run it on mozilla-central push without fission as tier 2.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337927\n", "files": ["taskcluster/kinds/web-platform-tests/kind.yml", "testing/web-platform/meta/clipboard-apis/async-write-blobs-read-blobs.https.html.ini", "testing/web-platform/meta/css/CSS2/floats/floats-in-inline-content-intrinsic-size-001.html.ini", "testing/web-platform/meta/css/CSS2/normal-flow/nested-inline-boxes-around-block-in-inline-001.html.ini", "testing/web-platform/meta/css/css-view-transitions/navigation/old_vt_promises_bfcache.html.ini", "testing/web-platform/meta/css/cssom/getComputedStyle-inset-inline-containing-block-vertical.html.ini", "testing/web-platform/meta/fetch/fetch-later/quota/cross-origin-iframe/empty-payload.https.window.js.ini", "testing/web-platform/meta/fetch/fetch-later/quota/cross-origin-iframe/small-payload.https.window.js.ini", "testing/web-platform/meta/html/browsers/browsing-the-web/history-traversal/history-traversal-navigate-parent-while-child-loading.html.ini", "testing/web-platform/meta/html/browsers/browsing-the-web/history-traversal/same-url.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/combination_history_004.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/combination_history_005.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/combination_history_006.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/combination_history_007.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/bfcache/embedded-img.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/decode/image-decode-path-changes.html.ini", "testing/web-platform/meta/intersection-observer/transformed-iframe-004-cross-origin.html.ini", "testing/web-platform/meta/mathml/relations/css-styling/ignored-properties-001.html.ini", "testing/web-platform/meta/mathml/relations/css-styling/lengths-vi-vb-units.html.ini", "testing/web-platform/meta/media-source/mediasource-changetype-play-without-codecs-parameter.html.ini", "testing/web-platform/meta/media-source/mediasource-changetype-play.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/intercept-history-pushState.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/intercept-history-replaceState.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-history-back-noop.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-history-pushState.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-history-replaceState.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/navigate-state-repeated-await.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/navigate-state-repeated.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/return-value/reload-intercept.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/traverseTo-after-data-url.html.ini", "testing/web-platform/meta/preload/link-header-preload.html.ini", "testing/web-platform/mozilla/meta/css/css-view-transitions/navigation/old_vt_promises_bfcache_uncacheable.html.ini", "testing/web-platform/mozilla/meta/fetch/fetchpriority/fetchpriority.h2.html.ini"], "git_node": "78936a12a9ebb7ac0a84f5d88f43bad8efdeaf80", "git_parents": ["184587ce4d8f3d63e63edb48f173aac97a9c8169"], "node": "161a9a53e14bbd2fcb4c220e96ec0837ddfb439a", "parents": ["f4d49242dc5d3872a92ffc49868dfa11583c410e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2089807 - Clear the HTTP cache after test_override_ui_with_mixed_content in browser_trust_panel_security_view.js, r=emz.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342134\n", "files": ["browser/base/content/test/browser-trustPanel/browser_trust_panel_security_view.js"], "git_node": "d178aadcde1f5b5b20ac17cf67c4bf0966f2b340", "git_parents": ["78936a12a9ebb7ac0a84f5d88f43bad8efdeaf80"], "node": "a414d40afe0c8e2413164ac7c22ff1e0643e348b", "parents": ["161a9a53e14bbd2fcb4c220e96ec0837ddfb439a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2091375 - Clear history before testing schemeless URL bar loads in browser_schemeless.js, r=freddyb.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341429\n", "files": ["dom/security/test/https-first/browser_schemeless.js"], "git_node": "f54be06457606ff2651a434844df3d30eb0fabb3", "git_parents": ["d178aadcde1f5b5b20ac17cf67c4bf0966f2b340"], "node": "42711af8ef1b818da1d733ca6146cfa31f6bda82", "parents": ["a414d40afe0c8e2413164ac7c22ff1e0643e348b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092277 - Remove the quit-application-requested observer of test_new_profile_delete_telemetry when done, r=mossop.\n\nThe observer cancelling quit was never removed, so when the test runs a second time in the same browser, it cancels the quit that test_new_profile_beforeunload expects to reach deleteCurrentProfile. Test-verify on Linux runs it 10 times in one browser and fails the same way, so the Linux skip-if goes. The verify-standalone skip-ifs come from bug 1995208, so the remaining Windows one now cites it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342342\n", "files": ["browser/components/profiles/tests/browser/browser.toml", "browser/components/profiles/tests/browser/browser_create_profile_page_test.js"], "git_node": "d31e9d2098f158eb8f9943e972ed77fa501740b8", "git_parents": ["f54be06457606ff2651a434844df3d30eb0fabb3"], "node": "99311c4faaf5611fd0bfd484a533f893a892f4f0", "parents": ["42711af8ef1b818da1d733ca6146cfa31f6bda82"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092273 - Clear the per-site download directory content pref in browser_privatebrowsing_downloadLastDir.js cleanup, r=firefox-desktop-core-reviewers ,Gijs.\n\nOtherwise a second run in the same profile starts the file picker in the directory the first run last saved to for test1.com.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342340\n", "files": ["browser/components/privatebrowsing/test/browser/browser_privatebrowsing_downloadLastDir.js"], "git_node": "9aa8ef1e8595d7f9395a24697f52404e26e3bc6b", "git_parents": ["d31e9d2098f158eb8f9943e972ed77fa501740b8"], "node": "de68ce057da80cd9a36dcd87fc765b71f38ae12b", "parents": ["99311c4faaf5611fd0bfd484a533f893a892f4f0"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2091464 - Focus the selected browser before replacing the tab between browser-chrome tests, r=firefox-desktop-core-reviewers ,Gijs.\n\nTests start with the selected browser focused, but replacing the tab between tests does not reset focus. A test that leaves focus on a tab in the tab strip hands it to the next test's tab, which then starts with the page unfocused and the tab strip keyboard-focused. This also applies to --repeat runs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342374\n", "files": ["testing/mochitest/browser-test.js"], "git_node": "00c403bcb6a4e0a5446b82075a1fa37bdadb1c2b", "git_parents": ["9aa8ef1e8595d7f9395a24697f52404e26e3bc6b"], "node": "b8a1eb3262da73957a01a1a0223f81f4442e46e2", "parents": ["de68ce057da80cd9a36dcd87fc765b71f38ae12b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092543 - Stop findXULWidgetInWindow's search for a customization target at the document element, r=firefox-desktop-core-reviewers ,Gijs.\n\nFor a node outside every area and the palette, the ancestor walk reached the Document and getCustomizationTarget threw calling hasAttribute on it, instead of the lookup returning null.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342585\n", "files": ["browser/components/customizableui/CustomizableUI.sys.mjs"], "git_node": "e0ca4bb7d0727adc17dd850b9c644960cc613df3", "git_parents": ["00c403bcb6a4e0a5446b82075a1fa37bdadb1c2b"], "node": "11eb9487a7d3b8a2666846cb969cd28ea04fc5af", "parents": ["b8a1eb3262da73957a01a1a0223f81f4442e46e2"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2092342. Run the WebGL canvas reftests on Android. r=gfx-reviewers,jnicol\n\nThe per-line skip-if(Android) annotations on the WebGL reftests were added in\nbug 1285531 (2016) for memory corruption on the Android emulators of the time,\nand the one on the WebGL section's defaults line in bug 1654459 (2020) for\nreadback failures on the Android 7 emulator.\n\nOn try the 149 WebGL reftests that this enables passed on the Android emulator\n(reftest, nofis, nogpu, swr and swr-nofis, opt and debug) and on the A55\nhardware workers (qr-nofis and qr-nogpu, opt and debug), running both just the\ncanvas reftests and the whole reftest suite, apart from one instance of the\nexisting cross-platform intermittent bug 1788351.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342390\n", "files": ["dom/canvas/test/reftest/reftest.list"], "git_node": "a1a6a6a88798a6a250f8bddd5e3b641653653b50", "git_parents": ["e0ca4bb7d0727adc17dd850b9c644960cc613df3"], "node": "f23b8816b3d935fb0b464498009015c5c64b7357", "parents": ["11eb9487a7d3b8a2666846cb969cd28ea04fc5af"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092489 - Resolve relative jstestbrowser paths against the staged tests r=layout-reviewers,dshin\n\n`mach jstestbrowser \u003cpath\u003e` with a path relative to the source tree currently\nfails with \"unknown test type test262-raw\". This is because these tests must\nrun with the preprocessed versions of their manifest files that are created in\nthe staged area but relative paths are currently resolved to a source path\noutside the staged area that only has the raw manifest files.\n\nInstead, resolve relative paths for these tests against the staged tests\ndirectory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342524\n", "files": ["layout/tools/reftest/reftestcommandline.py", "layout/tools/reftest/runreftest.py"], "git_node": "31dd11d067fad9a4108775afc3dd41fb25dde137", "git_parents": ["a1a6a6a88798a6a250f8bddd5e3b641653653b50"], "node": "10a8aa6db8dda8dbd6b111d7737929816361c7d8", "parents": ["f23b8816b3d935fb0b464498009015c5c64b7357"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090842 - [customizable-menu] Remove the legacy menu code r=android-reviewers,android-l10n-reviewers,parker,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342126\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/AboutHomeBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/BrowserDirection.kt", "mobile/andr