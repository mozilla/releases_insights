5d1e2c72e81672bf6e5", "19f4be23f11edbc25be14868c71628611befe456", "41db707342feaa6722e4a2076a24ec3d01fe96d2"], "user": "csabou@mozilla.com"}, "45800": {"changesets": [{"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add a characterization for OPFS behavior for model downloading; r=nordzilla,ai-platform-reviewers\n\nThis is a test to show the current behavior of OPFS with a private browsing\nwindow, when you get a somewhat spurious error when a Private Browsing\nwindow just happens to be on top. This sets the stage for the following\nfix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328143\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_opfs_private_window.js"], "git_node": "a671b8ecab72e20c5c6c87a894ffbfa4924be75c", "git_parents": ["41db707342feaa6722e4a2076a24ec3d01fe96d2"], "node": "40dc36d970fe629daf857d85cfa26fe1440e16b5", "parents": ["2e616e4a4ae55056aec51edf21e0683eda5a2491"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Remove incorrect isPrivateBrowsing call and test; r=nordzilla,ai-platform-reviewers\n\nThis code uses the most recent browsing window, and doesn't work correctly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328144\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/content/Utils.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_privatebrowsing.js"], "git_node": "a5084a86d9bb3f9f56de467326c9ec435047f72c", "git_parents": ["a671b8ecab72e20c5c6c87a894ffbfa4924be75c"], "node": "3c2f27610da653bfc3438c1d29fac7649bc21cbc", "parents": ["40dc36d970fe629daf857d85cfa26fe1440e16b5"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Re-work OPFS.sys.mjs to pass TypeScript and remove dead code; r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328145\n", "files": ["toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/content/Utils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_cache.js"], "git_node": "8a8c864b9475f6c28e4fcabcc5bd48e8fd836b49", "git_parents": ["a5084a86d9bb3f9f56de467326c9ec435047f72c"], "node": "80530630080782168507b789dcbf603bc6983136", "parents": ["3c2f27610da653bfc3438c1d29fac7649bc21cbc"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Remove OPFS usage in workers; r=nordzilla,ai-platform-reviewers\n\nThe inference process workers reached OPFS through their own global, which\nmeant two code paths for the same storage and a copy of the file lookup in\neach pipeline. The parent already reads the file when it resolves a model, so\nhave it send the blob rather than a path, and let the worker build the\nResponse it needs from that.\n\nImporting OPFS into a worker also failed outright, since its XPCOMUtils\nimport needs a privileged global: browser_ml_native_backend_error.js and\nbrowser_ml_smollm2_chat.js both died with \"Cu is not defined\" before this.\n\nWith nothing loading OPFS outside the parent, the worker plumbing goes too.\nOPFS.toResponse had no other caller, and the module no longer needs the\nIN_WORKER branch or the globalThis.navigator fallback.\n\nThe OPFS tests still cover toResponse and are fixed up later in the series.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328146\n", "files": ["toolkit/components/ml/actors/MLEngineChild.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/MLEngine.worker.mjs", "toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/content/backends/LlamaCppPipeline.mjs", "toolkit/components/ml/content/backends/StaticEmbeddingsPipeline.mjs", "toolkit/components/ml/tests/browser/browser_ml_opfs.js"], "git_node": "ae6f1eef4f9d8f606d114303914e0169a57cc388", "git_parents": ["8a8c864b9475f6c28e4fcabcc5bd48e8fd836b49"], "node": "8fcc30a84e176fe815738cc04e5b52769312ca49", "parents": ["80530630080782168507b789dcbf603bc6983136"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add type checking to ModelHub.sys.mjs r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339596\n", "files": ["toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/ml.d.ts"], "git_node": "c1000332fd7e1ad348eb0deeacd8e2a077b87b54", "git_parents": ["ae6f1eef4f9d8f606d114303914e0169a57cc388"], "node": "c5cc98703929f4717be999c3cef3debee22ccfdb", "parents": ["8fcc30a84e176fe815738cc04e5b52769312ca49"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add a mock model hub r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339597\n", "files": ["toolkit/components/ml/tests/MLTestUtils.sys.mjs"], "git_node": "42e9efbcfa58ffaf1402d885cb549cdccc79c061", "git_parents": ["c1000332fd7e1ad348eb0deeacd8e2a077b87b54"], "node": "ddf974ebf56f8239e824fd40580a13effae6410a", "parents": ["c5cc98703929f4717be999c3cef3debee22ccfdb"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for downloading and caching model files r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339598\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_download.js"], "git_node": "6165c5f0575aa17c29d575bfdf4dee814be18e28", "git_parents": ["42e9efbcfa58ffaf1402d885cb549cdccc79c061"], "node": "6945302ebb615a987653e3626b6d32fed9b52723", "parents": ["ddf974ebf56f8239e824fd40580a13effae6410a"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for engine downloads through the model hub r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339599\n", "files": ["toolkit/components/ml/tests/MLTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_engine_e2e.js", "toolkit/components/ml/tests/browser/ml_model_hub_echo_stub.worker.mjs"], "git_node": "90f1e5e8df0820a6498362e1c7758024f5ab6bb2", "git_parents": ["6165c5f0575aa17c29d575bfdf4dee814be18e28"], "node": "af7a6f6e1614809b14964b32448a5ccd8b5f1cb8", "parents": ["6945302ebb615a987653e3626b6d32fed9b52723"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for failed and retried downloads r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339600\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_download_failures.js"], "git_node": "8d448a606cc597c314eba1dbc69affe3e75925dc", "git_parents": ["90f1e5e8df0820a6498362e1c7758024f5ab6bb2"], "node": "81aabac8e5d8a48c408cfbd7fc6488f38b684f66", "parents": ["af7a6f6e1614809b14964b32448a5ccd8b5f1cb8"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for ETag revalidation r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339601\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_etag.js"], "git_node": "cf9be8471b7902221b0bb236335c5b14fa7c4b45", "git_parents": ["8d448a606cc597c314eba1dbc69affe3e75925dc"], "node": "3a54348032b726d0286b37ad18c5f842bb9a7e45", "parents": ["81aabac8e5d8a48c408cfbd7fc6488f38b684f66"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for deleting models r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339602\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_delete.js"], "git_node": "9efd682bf06fdff526d0afc4e6d588995e83de9b", "git_parents": ["cf9be8471b7902221b0bb236335c5b14fa7c4b45"], "node": "89462e922c2cfb4d2b529dc7f75ed971ebca50b8", "parents": ["3a54348032b726d0286b37ad18c5f842bb9a7e45"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for the model hub denylist and listing r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339603\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_denylist.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_list.js"], "git_node": "07de9e425a3e0941da952e19d20db829c26b117c", "git_parents": ["9efd682bf06fdff526d0afc4e6d588995e83de9b"], "node": "81bcad1e68622a5babd30ee14a31b75f035ef151", "parents": ["89462e922c2cfb4d2b529dc7f75ed971ebca50b8"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Restore MOZ_ALLOW_EXTERNAL_ML_HUB after the tests that set it r=nordzilla,ai-platform-reviewers\n\nbrowser_ml_engine_e2e.js and browser_ml_telemetry.js set the variable and never\nput it back. It is process-wide and makes ModelHub's constructor leave\nallowDenyList null, so every ModelHub built after those files ran skipped the\nallow/deny list entirely. browser_ml_model_hub_denylist.js runs later in\nbrowser.toml and so failed every one of its assertions in a full suite run\nwhile passing on its own.\n\nbrowser_ml_cache.js already restored it; the other two now do the same, and the\ndenylist test asserts the variable is unset so a future leak fails where it can\nbe diagnosed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339604\n", "files": ["toolkit/components/ml/tests/browser/browser_ml_engine_e2e.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_denylist.js", "toolkit/components/ml/tests/browser/browser_ml_telemetry.js"], "git_node": "5de37b3de22cfe70889fbc1d82990e55cde54834", "git_parents": ["07de9e425a3e0941da952e19d20db829c26b117c"], "node": "67f22f4fa3ff60a050617691ec9ef68a835a0ed9", "parents": ["81bcad1e68622a5babd30ee14a31b75f035ef151"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Delete browser_ml_cache.js now that the model hub tests cover it r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339605\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_cache.js", "toolkit/components/ml/tests/browser/shared-head.js"], "git_node": "a3ae0af0c0fdc18e797406f95a2431b52da9c55b", "git_parents": ["5de37b3de22cfe70889fbc1d82990e55cde54834"], "node": "9baf985ac683bde7cf1c0b13b7254d16f413e8b7", "parents": ["67f22f4fa3ff60a050617691ec9ef68a835a0ed9"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Remove unused getModelFileAsResponse r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339606\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs"], "git