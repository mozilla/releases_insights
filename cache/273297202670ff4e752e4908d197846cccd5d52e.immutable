s", "third_party/rust/valuable/src/structable.rs", "third_party/rust/valuable/src/tuplable.rs", "third_party/rust/valuable/src/valuable.rs", "third_party/rust/valuable/src/value.rs", "third_party/rust/valuable/src/visit.rs"], "git_node": "213940b323571c7dd2583da3efa9f5b6e232dbd4", "git_parents": ["231a61cec27ab948720aa2115c520aa5a7f41428"], "node": "79ac0ddb060d8df1245770239e5e42c25024dda8", "parents": ["91841f68bcf5ab368e53c862e8b2d0be39e8396a"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089515 - Initialize the InitOtherFamilyNames reply on the main thread (Coverity CID 1515749) r=jfkthame\n\nIf the sync IPC failed, the uninitialized reply was stored into\nmOtherFamilyNamesInitialized. The worker-thread branch already starts\nfrom false.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339890\n", "files": ["gfx/thebes/gfxPlatformFontList.cpp"], "git_node": "5494df4fdbbdd0b66f27f663c34f10248352f02e", "git_parents": ["213940b323571c7dd2583da3efa9f5b6e232dbd4"], "node": "fd0e3a2f695f0603fdea87b03c75cc50718bdc1b", "parents": ["79ac0ddb060d8df1245770239e5e42c25024dda8"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2092576 - Replace Mercurial instructions and hg.mozilla.org links in the remaining docs. r=firefox-source-docs-reviewers,ahal\n\nRevision links point to the matching git commit on GitHub, links to the tip of a file to Searchfox, and Mercurial-only setup steps are removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342685\n", "files": ["browser/docs/how_to/add_preview_strings.md", "docs/code-quality/coding-style/coding_style_python.md", "docs/code-quality/coding-style/format_cpp_code_with_clang-format.md", "docs/code-quality/coding-style/svg_guidelines.md", "docs/code-quality/static-analysis/writing-new/adding-a-check.md", "docs/code-quality/static-analysis/writing-new/advanced-check-features.md", "docs/contributing/build/artifact_builds.md", "docs/gtest/index.md", "docs/performance/perfstats.md", "docs/setup/common_build_errors.md", "docs/setup/windows_wsl_build.md", "dom/docs/ipc/jsactors.md", "dom/docs/webIdlBindings/index.md", "gfx/docs/Silk.md", "gfx/wr/README.md", "intl/l10n/docs/migrations/overview.md", "js/src/doc/build.md", "testing/docs/automated-testing/index.md", "testing/docs/automated-testing/manifest-sandbox.md", "testing/docs/tests-for-new-config/index.md", "testing/docs/xpcshell/index.md", "testing/mozbase/docs/manifestparser.md", "testing/mozbase/docs/mozinfo.md", "testing/mozbase/docs/mozprofile.md", "testing/mozbase/docs/mozversion.md", "tools/lint/eslint/eslint-plugin-mozilla/README.md", "tools/moztreedocs/docs/jsdoc-support.md", "tools/tryselect/docs/configuration.md", "tools/tryselect/docs/tasks.md"], "git_node": "5d8b36e4e0a0516ed370d03c6d96f1fea49ebbdf", "git_parents": ["5494df4fdbbdd0b66f27f663c34f10248352f02e"], "node": "eb5c5aa552f7136ccdfee4da57a2b9d104c68f59", "parents": ["fd0e3a2f695f0603fdea87b03c75cc50718bdc1b"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081888 - Check the printed randomization ID in the message task test r=beth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343164\n", "files": ["toolkit/components/backgroundtasks/tests/xpcshell/test_backgroundtask_experiments.js"], "git_node": "31d82d929ae8ead5af8e7af799ad2bb324074769", "git_parents": ["5d8b36e4e0a0516ed370d03c6d96f1fea49ebbdf"], "node": "5da4a93dd33a9306412ebf6b12f0427f48b32520", "parents": ["eb5c5aa552f7136ccdfee4da57a2b9d104c68f59"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081888 - Use the profile group ID for the message task's randomizationId flag r=beth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343165\n", "files": ["toolkit/components/backgroundtasks/BackgroundTask_message.sys.mjs", "toolkit/components/backgroundtasks/tests/xpcshell/experiment.json", "toolkit/components/backgroundtasks/tests/xpcshell/test_backgroundtask_experiments.js"], "git_node": "8d72c4c0b74754cb2148b90c9e260b2399cf7c17", "git_parents": ["31d82d929ae8ead5af8e7af799ad2bb324074769"], "node": "fe0ce2d101b8394a3ff81175abc449b7c6fd20a3", "parents": ["5da4a93dd33a9306412ebf6b12f0427f48b32520"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083674 - Reopen the Remote Settings database after its connection was closed without being asked to. r=remote-settings-reviewers,leplatrem\n\nWhen the IndexedDB connection is closed by the browser, e.g. when QuotaManager\nresets the storage, every following Remote Settings operation failed with\n\"Can't start a transaction on a closed database\" until restart, since the\nclosed connection kept being reused.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335270\n", "files": ["services/settings/Database.sys.mjs", "services/settings/test/unit/test_database_closed_connection.js", "services/settings/test/unit/xpcshell.toml"], "git_node": "357b9ec3cbf5bd1d7a75e2e8cb64d702cc5796d4", "git_parents": ["8d72c4c0b74754cb2148b90c9e260b2399cf7c17"], "node": "c2e3d5a872a23d318427f31a0ac3819aba9ab086", "parents": ["fe0ce2d101b8394a3ff81175abc449b7c6fd20a3"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1815163 - Abort pending dump imports at shutdown by terminating the Remote Settings worker r=Gijs\n\nWaiting for dump imports was done in Bug 1635408 to prevent imports to be aborted halfway.\n\nBug 1636256 made it a single transaction, aborted at shutdow.\n\nWe can now cancel dump imports rather than waiting for them, and this simplifies the code greatly.\n\nWaiting was only in charge to wait worker's acknowledgement, which never comes if the worker is stuck opening the database.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341491\n", "files": ["services/settings/RemoteSettings.worker.mjs", "services/settings/RemoteSettingsWorker.sys.mjs", "services/settings/test/unit/test_shutdown_handling.js"], "git_node": "7813f86ce06e32096408c63508294fc85fa4ccc8", "git_parents": ["357b9ec3cbf5bd1d7a75e2e8cb64d702cc5796d4"], "node": "daa1a8d4726c675cbbb8a139022181f9df8d5f36", "parents": ["c2e3d5a872a23d318427f31a0ac3819aba9ab086"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092495 - Look up mapped SVG attributes in a bitset of static atoms. r=dom-core-reviewers,smaug\n\nSVGElement::IsNoNamespaceAttrMapped scanned its attribute table linearly for\nevery attribute change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342521\n", "files": ["dom/svg/SVGElement.cpp", "mfbt/BitSet.h", "mfbt/tests/TestBitSet.cpp", "xpcom/ds/nsGkAtoms.h"], "git_node": "0ab3281d624adf9295b390c8557070417fda2ca4", "git_parents": ["7813f86ce06e32096408c63508294fc85fa4ccc8"], "node": "359948a0519c2c0fe95658ac5a02a9ac3e6ce6e7", "parents": ["daa1a8d4726c675cbbb8a139022181f9df8d5f36"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092614 - Read the visitor before setting chain item flags in EventTargetChainItem::GetEventTargetParent. r=dom-core-reviewers,smaug\n\nThe bool bitfield stores may alias the bool loads from the visitor, so the\ncompiler stored the flags word once per flag. Loading the visitor fields first\nlets it combine them into a single store.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342666\n", "files": ["dom/events/EventDispatcher.cpp"], "git_node": "28da1563e5cb3f392d46e8763dfc09611e3116c4", "git_parents": ["0ab3281d624adf9295b390c8557070417fda2ca4"], "node": "aecb91e0505dad530dcc75992c25088eba70ac72", "parents": ["359948a0519c2c0fe95658ac5a02a9ac3e6ce6e7"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092625 - Allocate attribute arrays from a main-thread-only arena. r=dom-core-reviewers,smaug\n\nA main-thread-only arena takes no lock, which saves a lock and unlock on\nevery allocation and free of an attribute array.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342690\n", "files": ["dom/base/AttrArray.cpp"], "git_node": "34d470167dba939553055861c2a64ccac3e71c11", "git_parents": ["28da1563e5cb3f392d46e8763dfc09611e3116c4"], "node": "23135ddbf9d6ff1b8edb9d2730cf26926215a0de", "parents": ["aecb91e0505dad530dcc75992c25088eba70ac72"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070365 - Skip updating the media element ready state in the final shutdown cycle collection. r=media-playback-reviewers,aosmond\n\nHTMLTrackElement::UnbindFromTree() calls UpdateReadyState() on its media\nelement, which the final shutdown cycle collection does when it unlinks a\nmedia element. That notifies the element's WatchManager. The next commit makes\nthe main thread have no current AbstractThread during that cycle collection, as\nAbstractThread::ShutdownMainThread() clears it, like\nnsThreadManager::ReleaseMainThread() clears the main thread's current serial\nevent target. The notification would then crash. Nothing observes the ready\nstate that late, so skip it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340935\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/mediaelement/HTMLMediaElement.h"], "git_node": "292c0144843cf9c69abb7ebb83ca5a9f02547bfd", "git_parents": ["34d470167dba939553055861c2a64ccac3e71c11"], "node": "e50a30e77508b4f47593921755b33f683f9856dc", "parents": ["23135ddbf9d6ff1b8edb9d2730cf26926215a0de"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070365 - Run late MediaTrackGraph control events synchronously during final shutdown cycle collection. r=karlt\n\nOnce AbstractThread::ShutdownMainThread() clears the main thread's\nAbstractThread before the final cycle collection, as the next commit makes it\ndo, AbstractThread::GetCurrent() is null on the main thread there and\nRequiresTailDispatchFromCurrentThread() returns false. Consumers still\ndisconnect mirrors of graph tracks while unlinking, which dispatches to the\ngraph, e.g. AudioDestinationNode's mirror of its track's current time through\nAudioNode::DisconnectFromGraph().\n\nRoute main thread Dispatch() calls without an AbstractThread, which happen only\nduring final shutdown cycle collection, to QueueMessageForTailDispatch(), and\nexempt them from the RequiresTailDispatchFromCurrentThread() assertion.\nQueueMessageForTailDispatch() already runs them synchronously once the graph has\nstopped, instead of TailDispatchMessage() dispatching to a main thread that no\nlonger accepts events.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340205\n", "files": ["dom/media/MediaTrackGraph.cpp"], "git_node": "ea3e9f00a2569a8b7536617b78ae1df1aca57c0c", "git_parents": ["292c0144843cf9c69abb7ebb83ca5a9f02547bfd"], "node": "d5ad18b40a96ce6a6817e2cd1a9f690b1f0fa4e2", "parents": ["e50a30e77508b4f47593921755b33f683f9856dc"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070365 - Add AutoXPCOMThreadWrapper for making an XPCOM thread an AbstractThread for a scope. r=xpcom-reviewers,nika\n\nAutoXPCOMThreadWrapper wraps the current XPCOM thread in an AbstractThread\nand makes it what AbstractThread::GetCurrent() returns there until it goes\nout of scope. It is meant for threads that run a unit of work within one\ntask, like worker threads, so that the wrapper does not outlive that unit of\nwork. Tasks on the thread can use its tail dispatcher whether or not they\nwere dispatched through the wrapper.\n\nThe main thread uses it too, instead of its own permanent wrapper. It is held\nfrom InitMainThread() until ShutdownMainThread(), which now clears the main\nthread's current AbstractThread deterministically. Before, that happened when\nthe last reference to the wrapper went away. ShutdownMainThread() runs before\nthe final shutdown cycle collection, so GetCurrent() is null on the main\nthread during it.\n\nWhen the scope ends the wrapper is unregistered: from then on it is not the\ncurrent thread anywhere and dispatching to it fails. The owner must have\nprocessed the thread's pending events by then.\n\nShutdown tasks registered with the wrapper are registered with the thread,\nas they are with GetCurrentSerialEventTarget() from any task running on it.\nThey run when the thread shuts down, which can be after the wrapper has been\nunregistered.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328488\n", "files": ["build/clang-plugin/ThreadFileAllows.txt", "xpcom/tests/gtest/TestXPCOMThreadWrapper.cpp", "xpcom/tests/gtest/moz.build", "xpcom/threads/AbstractThread.cpp", "xpcom/threads/AbstractThread.h"], "git_node": "78ee35017e0095e6daee7925059e94145da67d76", "git_parents": ["ea3e9f00a2569a8b7536617b78ae1df1aca57c0c"], "node": "45518515dd02e56125bd2b0311cb5f554fd20ca8", "parents": ["d5ad18b40a96ce6a6817e2cd1a9f690b1f0fa4e2"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070365 - Make worker threads AbstractThreads with tail dispatch while they run a worker. r=dom-worker-reviewers,asuth\n\nWorkerThreadPrimaryRunnable::Run() holds an AutoXPCOMThreadWrapper around\nthe worker's run loop and shutdown tasks, from right after the profiler's JS\ncontext is set, making it what AbstractThread::GetCurrent() returns on the\nworker thread meanwhile. The wrapper is unregistered before the profiler's JS\ncontext is cleared and before the final GC and cycle collection, as the main\nthread's is in ShutdownXPCOM(), rather than when the thread exits, so that it\nis not registered on a thread that is winding down.\n\nShutdown tasks registered with the wrapper are registered with the worker\nthread, as they are with GetCurrentSerialEventTarget() from a task running on\nit, and so run when the thread shuts down.\n\nTasks on the worker may use its tail dispatcher whether or not they were\ndispatched through the wrapper, since the worker's run loop itself runs\nwithin the primary runnable. Code shared with windows already copes with tail\ndispatch, as the main thread has had a tail dispatching AbstractThread all\nalong.\n\nThis is for MediaStreamTracks transferred to workers, which communicate with\nthe MediaTrackGraph that way and mirror state from it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328489\n", "files": ["dom/workers/RuntimeService.cpp"], "git_node": "69f2c2513d09228345cb01c6b5c450271767e96c", "git_parents": ["78ee35017e0095e6daee7925059e94145da67d76"], "node": "e67bb32f8374afef8cb927b0f66ed3b2c6cca62a", "parents": ["45518515dd02e56125bd2b0311cb5f554fd20ca8"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2093222 - Ensure index into SMIL values array is in range r=dholbert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343348\n", "files": ["dom/smil/SMILAnimationFunction.cpp", "dom/smil/crashtests/2093222.html", "dom/smil/crashtests/crashtests.list"], "git_node": "3c8aa724680540a141cf4a52484e69350f7d9905", "git_parents": ["69f2c2513d09228345cb01c6b5c450271767e96c"], "node": "02aad1e807301c5850eaa23f90c0cd368722eacb", "parents": ["e67bb32f8374afef8cb927b0f66ed3b2c6cca62a"], "tags": []}, {"author": "lottiehope \u003clottie_hope@hotmail.co.uk\u003e", "branch": "default", "desc": "Bug 2082517 - Open the certificate details sub-page from the Trust Panel header. r=android-reviewers,android-l10n-reviewers,twhite,flod\n\nAdds the \"Secure connection\" link from Figma to the Trust Panel header. When the\nQWAC UI is enabled, it replaces the connection security row, so the certificate\ndetails are only opened from one place. Until the behaviour for pages without a\ncertificate is decided, the link is only shown on secure pages with a certificate.\nGoing back from the sub-page returns to the Trust Panel instead of dismissing it.\nThe \"Verified by\" slot is filled once D342239 lands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343091\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/TrustPanelFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/store/TrustPanelState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/ProtectionPanel.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/ProtectionPanelHeader.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/CertificateDetailsTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/RouteTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/ProtectionPanelTest.kt"], "git_node": "c2749a2ff99701f9227d49169b96fe165d88d9fa", "git_parents": ["3c8aa724680540a141cf4a52484e69350f7d9905"], "node": "2523a14e1386443d89f818698c754778620ae999", "parents": ["02aad1e807301c5850eaa23f90c0cd368722eacb"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2093222 - Ensure index into SMIL values array is in range r=dholbert\" for causing crashtest failures at crashtests/2093222.html\n\nThis reverts commit 3c8aa724680540a141cf4a52484e69350f7d9905.\n", "files": ["dom/smil/SMILAnimationFunction.cpp", "dom/smil/crashtests/2093222.html", "dom/smil/crashtests/crashtests.list"], "git_node": "3ee67366f8ab60da120d20a3604a91131fc6db52", "git_parents": ["c2749a2ff99701f9227d49169b96fe165d88d9fa"], "node": "3dbcfeb9167ab29c17d4790184c99851ef041b70", "parents": ["2523a14e1386443d89f818698c754778620ae999"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2050088 - Remove the jssources profiler feature and collect JS source text with the js feature. r=profiler-reviewers,extension-reviewers,rpl,mstange\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342168\n", "files": ["devtools/client/performance-new/shared/utils.js", "mozglue/baseprofiler/public/BaseProfilerState.h", "toolkit/components/extensions/schemas/geckoProfiler.json", "tools/profiler/core/platform.cpp", "tools/profiler/public/ProfilerState.h", "tools/profiler/tests/browser/browser_test_feature_js_source_table.js", "tools/profiler/tests/browser/browser_test_feature_js_sourceindex.js", "tools/profiler/tests/browser/browser_test_feature_js_sources_deduplication.js", "tools/profiler/tests/browser/browser_test_feature_js_sources_retrieval.js", "tools/profiler/tests/browser/browser_test_feature_js_sources_shutdown_process.js", "tools/profiler/tests/xpcshell/test_marker_jit_sourceindex.js", "tools/profiler/tests/xpcshell/test_source_table.js"], "git_node": "e16d11ecade5e93c3b16a8fb7b6c60f993e731b2", "git_parents": ["3ee67366f8ab60da120d20a3604a91131fc6db52"], "node": "022c03cba91a042a4e29411e30ef7d215465b9f4", "parents": ["3dbcfeb9167ab29c17d4790184c99851ef041b70"], "tags": []}, {"author": "lottiehope \u003clottie_hope@hotmail.co.uk\u003e", "branch": "default", "desc": "Bug 2082518 - Return to the Trust Panel from the certificate details sub-page. r=android-reviewers,twhite\n\nSystem back and the back gesture return from the certificate details sub-page to\nthe Trust Panel, which keeps its scroll position and focuses the \"Secure connection\"\nlink. The current page is kept across configuration changes, except for pages whose\ncontent is only loaded when opening them, which fall back to the page they were\nopened from, as the Trust Panel store does not survive process death. The Trust\nPanel is dismissed if its tab is closed. There is no back button in the sub-page\nheader, as the design does not include one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343098\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/SecurityInfoBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/TrustPanelFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/ProtectionPanel.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/ProtectionPanelHeader.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/RouteTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/SecurityInfoBindingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/TrustPanelBackHandlerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/ProtectionPanelTest.kt"], "git_node": "75428ef0648ac41a7aaf04ce762aa0afdfd7bf47", "git_parents": ["e16d11ecade5e93c3b16a8fb7b6c60f993e731b2"], "node": "dac1fad4ba4422c9a8e57c994aa8df7b3d212315", "parents": ["022c03cba91a042a4e29411e30ef7d215465b9f4"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092252 - Fail builds in automation when no build times are recorded. r=firefox-build-system-reviewers,sergesanspaille\n\nThe \"build times\" Perfherder suite silently disappeared in bug 1425785; make\nthat kind of regression visible.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342502\n", "files": ["testing/mozharness/mozharness/mozilla/building/buildbase.py"], "git_node": "d5f70bb6d62edee2816bc540064c297376531cee", "git_parents": ["75428ef0648ac41a7aaf04ce762aa0afdfd7bf47"], "node": "9c50df15be5377cf0bb291fd742b34ee88d9d8ac", "parents": ["dac1fad4ba4422c9a8e57c994aa8df7b3d212315"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075450: run lint and build/test code-review tasks in `codereview` target tasks r=marco,taskgraph-reviewers,jcristau\n\nThis is necessary before we can get rid of the second try push currently used for build/test in phabricator (https://github.com/mozilla/code-review/pull/3758).\n\nWe need to keep `codereview-build-test` for now, until the reviewbot changes are deployed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342733\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py"], "git_node": "4d63d31777afcdddadda1d8e6fb2c9950beddb1b", "git_parents": ["d5f70bb6d62edee2816bc540064c297376531cee"], "node": "f515617648d595ab1a91385301d49a64e9affa04", "parents": ["9c50df15be5377cf0bb291fd742b34ee88d9d8ac"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086697 - Add support for raw-secret/raw-public key formats in WebCrypto r=crypto-reviewers,jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337649\n", "files": ["dom/crypto/WebCryptoCommon.h", "dom/crypto/WebCryptoTask.cpp", "testing/web-platform/meta/WebCryptoAPI/modern-algos/import_export/AES-OCB_importKey.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/modern-algos/import_export/Argon2_importKey.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/modern-algos/import_export/ChaCha20-Poly1305_importKey.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/modern-algos/import_export/KMAC_importKey.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/modern-algos/import_export/raw_format_aliases.https.any.js.ini"], "git_node": "200ca4557dedd117981185f071dc5795d2f0a25c", "git_parents": ["4d63d31777afcdddadda1d8e6fb2c9950beddb1b"], "node": "8a7bd949520ce1ce0cab127e5f681bafd1381122", "parents": ["f515617648d595ab1a91385301d49a64e9affa04"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090087 - Check export support before extraction in exportKey() and wrapKey() r=crypto-reviewers,jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340392\n", "files": ["dom/crypto/WebCryptoTask.cpp", "dom/crypto/test/mochitest.toml", "dom/crypto/test/test_WebCrypto_MLKEM_Pref.html", "dom/crypto/test/test_WebCrypto_Structured_Cloning.html", "testing/web-platform/meta/WebCryptoAPI/export-key-error-order.https.any.js.ini"], "git_node": "aee3ca91b0381e954611d702f035a4c2e5caa736", "git_parents": ["200ca4557dedd117981185f071dc5795d2f0a25c"], "node": "4797a238922a41f6ac9bbeef377d0b648042c817", "parents": ["8a7bd949520ce1ce0cab127e5f681bafd1381122"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088023 - Fix configuration for ESLint jsx-a11y rules so that they are correctly applied. r=frontend-codestyle-reviewers,omc-reviewers,Dre,aminomancer,Gijs\n\nThis changes the rules to warnings for the current failures, with follow-ups filed for future.\n\nThis also centralises the configuration as it makes it easier to update in future patches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338713\n", "files": ["browser/components/aboutwelcome/.eslintrc.mjs", "browser/components/asrouter/.eslintrc.mjs", "browser/extensions/newtab/.eslintrc.mjs", "eslint-rollouts.config.mjs", "eslint.config.mjs"], "git_node": "6d88d0350aae81b2d11728dbc4a62ab5c57b2618", "git_parents": ["aee3ca91b0381e954611d702f035a4c2e5caa736"], "node": "fbefd9941fb3775391c5876c1e2ec182310fc443", "parents": ["4797a238922a41f6ac9bbeef377d0b648042c817"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088404 - Centralise the eslint-plugin-react configuration into the main config. r=frontend-codestyle-reviewers,devtools-reviewers,omc-reviewers,Dre,nchevobbe,andhuang,mossop\n\nThis applies the rules more consistently across the projects where they are used and makes it easier for future updates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339458\n", "files": ["browser/components/aboutwelcome/.eslintrc.mjs", "browser/components/asrouter/.eslintrc.mjs", "browser/extensions/newtab/.eslintrc.mjs", "devtools/.eslintrc.mjs", "devtools/client/debugger/src/.eslintrc.mjs", "eslint.config.mjs"], "git_node": "de37bb6d2bae6120816c12cc185d0fb0f8281a7e", "git_parents": ["6d88d0350aae81b2d11728dbc4a62ab5c57b2618"], "node": "0c6ff529a03e269a58b3d17ed74dd28d7f8f0860", "parents": ["fbefd9941fb3775391c5876c1e2ec182310fc443"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088404 - Change from eslint-plugin-jsx-a11y to eslint-plugin-jsx-a11y-x. r=frontend-codestyle-reviewers,omc-reviewers,Dre,andhuang,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339459\n", "files": ["browser/components/aboutwelcome/.eslintrc.mjs", "browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/asrouter/content-src/components/ContentTiles.jsx", "browser/components/asrouter/content-src/components/LinkParagraph.jsx", "browser/components/asrouter/content-src/components/OnboardingVideo.jsx", "browser/components/asrouter/content-src/components/SingleSelect.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/extensions/newtab/.eslintrc.mjs", "browser/extensions/newtab/content-src/components/ContextMenu/ContextMenu.jsx", "browser/extensions/newtab/content-src/components/Spaces/Spaces.jsx", "browser/extensions/newtab/content-src/components/TopSites/TopSite.jsx", "browser/extensions/newtab/content-src/components/TopSites/TopSiteFormInput.jsx", "eslint-rollouts.config.mjs", "eslint.config.mjs", "package-lock.json", "package.json"], "git_node": "ff120c37797211f7ec179f838eab58bab3883d4b", "git_parents": ["de37bb6d2bae6120816c12cc185d0fb0f8281a7e"], "node": "2f6f0ee613a56ff559043ef3d4273e23651af33d", "parents": ["0c6ff529a03e269a58b3d17ed74dd28d7f8f0860"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2093153 - Use macros for ErrorObject untyped slots. r=spidermonkey-reviewers,jonco\n\nBug 2058580 converted typed slots in ErrorObject to be defined with a\nmacro, but there was no macro for untyped slots at the time. Convert the\nremaining slot definitions to use JS_DEFINE_UNTYPED_SLOT for\nconsistency.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343001\n", "files": ["js/src/vm/ErrorObject.h"], "git_node": "27706068ffc9792e10ef623b8130176d7895c2c8", "git_parents": ["ff120c37797211f7ec179f838eab58bab3883d4b"], "node": "59a0a3616cd869d92ee6c6319b6a7b50d0780601", "parents": ["2f6f0ee613a56ff559043ef3d4273e23651af33d"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2093153 - Convert ArrayBufferViewObject to TypedSlot. r=spidermonkey-reviewers,jonco\n\nArrayBufferViewObject stores many private pointers, which all require\npre- and post-barrier checks. Convert the object to use the TypedSlot\ninterface, with a measured throughput improvement of 5-20% in assorted\ncreation microbenchmarks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343002\n", "files": ["js/src/jit/MacroAssembler.cpp", "js/src/jit/VMFunctions.cpp", "js/src/vm/ArrayBufferViewObject.cpp", "js/src/vm/ArrayBufferViewObject.h", "js/src/vm/PortableBaselineInterpret.cpp", "js/src/vm/TypedArrayObject.cpp", "js/src/vm/TypedArrayObject.h"], "git_node": "d219c4d8f9087cc841c71ab8cbbb79e68d952949", "git_parents": ["27706068ffc9792e10ef623b8130176d7895c2c8"], "node": "77e6e9100da331e9468977658c5a37318fc7225a", "parents": ["59a0a3616cd869d92ee6c6319b6a7b50d0780601"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2093153 - Convert PromiseCombinatorDataHolderObject to TypedSlot. r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343003\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "ef8125f34a6b8e8830bb4bca1917b2e7b1f58aaf", "git_parents": ["d219c4d8f9087cc841c71ab8cbbb79e68d952949"], "node": "dfd9aa9de1e27cc5a146e44bebd0524b767436e9", "parents": ["77e6e9100da331e9468977658c5a37318fc7225a"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087975 - [devtools] Preserve filter in network side panels r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339225\n", "files": ["devtools/client/netmonitor/src/components/request-details/CookiesPanel.js", "devtools/client/netmonitor/src/components/request-details/HeadersPanel.js", "devtools/client/netmonitor/src/components/request-details/RequestPanel.js", "devtools/client/netmonitor/test/browser_al.toml", "devtools/client/netmonitor/test/browser_mz.toml", "devtools/client/netmonitor/test/browser_net_cookies_filter.js", "devtools/client/netmonitor/test/browser_net_headers_filter.js", "devtools/client/netmonitor/test/browser_net_request_filter.js"], "git_node": "d7020b0eff83defc7189190214c064e777f9ad01", "git_parents": ["ef8125f34a6b8e8830bb4bca1917b2e7b1f58aaf"], "node": "dcbc4da67db222c842c704aeedc640a3582ef6c1", "parents": ["dfd9aa9de1e27cc5a146e44bebd0524b767436e9"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087975 - [devtools] Update waitForRequestData to get selectors from windowRequire r=devtools-reviewers,nchevobbe\n\nLoading getSortedRequests etc. via the regular require instead of netmonitor's windowRequire\nends up creating duplicate modules and leaks when running the new tests in debug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341738\n", "files": ["devtools/client/netmonitor/test/browser_net_auth-request.js", "devtools/client/netmonitor/test/browser_net_cache_details_revalidated.js", "devtools/client/netmonitor/test/browser_net_cause_redirect.js", "devtools/client/netmonitor/test/browser_net_clear.js", "devtools/client/netmonitor/test/browser_net_cookies_filter.js", "devtools/client/netmonitor/test/browser_net_file_uri.js", "devtools/client/netmonitor/test/browser_net_headers-link_clickable.js", "devtools/client/netmonitor/test/browser_net_headers_filter.js", "devtools/client/netmonitor/test/browser_net_headers_sorted.js", "devtools/client/netmonitor/test/browser_net_http3_request_details.js", "devtools/client/netmonitor/test/browser_net_request_filter.js", "devtools/client/netmonitor/test/browser_net_requests-keep-alive.js", "devtools/client/netmonitor/test/browser_net_send-beacon.js", "devtools/client/netmonitor/test/browser_net_simple-request-data.js", "devtools/client/netmonitor/test/browser_net_simple-request-details.js", "devtools/client/netmonitor/test/browser_net_telemetry_edit_resend.js", "devtools/client/netmonitor/test/browser_net_telemetry_sidepanel_changed.js", "devtools/client/netmonitor/test/browser_net_throttle.js", "devtools/client/netmonitor/test/browser_net_throttling_disable_unblocks_requests.js", "devtools/client/netmonitor/test/browser_net_throttling_profiles.js", "devtools/client/netmonitor/test/filters/browser_net_filter-flags.js", "devtools/client/netmonitor/test/head.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_edit_resend_caret.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_edit_resend_xhr.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_resend.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_resend_headers.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_resend_hidden_headers.js"], "git_node": "7127632276814e0b2f27248d01c353da48446dec", "git_parents": ["d7020b0eff83defc7189190214c064e777f9ad01"], "node": "74971016bfe14bf841a66101ec36ba6561f8095d", "parents": ["dcbc4da67db222c842c704aeedc640a3582ef6c1"], "tags": []}, {"author": "elkal98 \u003ckhalid.alhaddad98@gmail.com\u003e", "branch": "default", "desc": "Bug 2074485 - Create a new container icon for automation / remote control containers r=jdescottes,fluent-reviewers,mkaply,webdriver-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341709\n", "files": ["browser/components/contextualidentity/content/robot.svg", "browser/components/contextualidentity/content/usercontext.css", "browser/components/contextualidentity/jar.mn", "browser/components/enterprisepolicies/schemas/policies-schema.json", "remote/shared/test/browser/browser_UserContextManager.js", "remote/shared/webdriver/Session.sys.mjs", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/locales/en-US/toolkit/global/contextual-identity.ftl"], "git_node": "5c73f38f7383a0aaef29538475824308db74ea14", "git_parents": ["7127632276814e0b2f27248d01c353da48446dec"], "node": "01d6de9e743ecc5152bda1f148005cf48b48927a", "parents": ["74971016bfe14bf841a66101ec36ba6561f8095d"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081511 - Fix nsWebBrowserPersist total progress decreasing and unknown sizes. r=Gijs\n\nFinished requests are removed from mOutputMap and mUploadList, and the total\nprogress was recalculated from those maps alone, so it decreased every time a\nrequest completed. Downloads turned that into a negative speed when saving\npages with subresources. Accumulate the progress of finished requests so the\ntotal never decreases.\n\nRequests of unknown size were also adding -1 to the total maximum, making it\nwrong once mixed with known sizes, and requests that didn't report a size yet\nwere counted as 10000 bytes. Report the total maximum as unknown until every\npending request has a known size, including data to upload, whose size is only\nknown once its upload starts. This replaces the fallback reporting 10000 bytes\nwhen nothing was counted, which could also make the total decrease. With the\ndefault flags all the subresources of a local save are requested together, so\nits total maximum goes from unknown to known only once, which Downloads\nhandles. As a consequence, the Downloads progress bar of a page save is now\nundetermined until the sizes of all its resources are known, rather than\nshowing a progress based on made-up sizes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336147\n", "files": ["dom/tests/browser/browser.toml", "dom/tests/browser/browser_persist_progress.js", "dom/tests/browser/file_browserPersist_progress.sjs", "dom/webbrowserpersist/nsWebBrowserPersist.cpp", "dom/webbrowserpersist/nsWebBrowserPersist.h"], "git_node": "d43238398bff5a264827f770c6ece2f774826a8b", "git_parents": ["5c73f38f7383a0aaef29538475824308db74ea14"], "node": "32a6cfa3b73ff4091c4dae25bede0d5bdea05d40", "parents": ["01d6de9e743ecc5152bda1f148005cf48b48927a"], "tags": []}, {"author": "fatadel \u003cafatkhutdinov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094103 - Update the Firefox Profiler toolchain to the November 17, 2026 deploy r=profiler-reviewers,canova\n\nThis revision includes profiler-cli 0.14.0.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343508\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "9b4b2a6540e11415e0f6e54ea7df36d2c260b36c", "git_parents": ["d43238398bff5a264827f770c6ece2f774826a8b"], "node": "d0c86b1ba1af0d5df24b77f3855d6fadc3019f74", "parents": ["32a6cfa3b73ff4091c4dae25bede0d5bdea05d40"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2084295 p1 - Add BrokerGeckoServices to allow the sandbox broker to use Gecko code. r=sandbox-reviewers,ipc-reviewers,handyman\n\nThis is like TargetGeckoServices, but for the broker. The services are set from\nSandboxBroker::Initialize, before any sandboxed process is launched. The font\nfile validator service will be used in a later patch.\n\nThe executable exports the function to set the BrokerGeckoServices, which xul\nlooks up, rather than it being passed in BootstrapConfig. This means that a\nbroken installation with mismatched executable and xul versions doesn't crash\nbefore it can be updated. For the same reason, BrokerGeckoServices has a size,\nso that members can be added later.\n\nGeckoDependentInitialize now only caches directories from the directory\nservice, so it is renamed to CacheGeckoDirs. It is now called as soon as the\nprofile has been set, because profile migration can launch sandboxed processes.\n\nGTest now calls SandboxBroker::CacheGeckoDirs for all tests, because many of\nthem launch sandboxed processes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335734\n", "files": ["ipc/glue/test/gtest/TestUtilityProcess.cpp", "js/xpconnect/src/XPCShellImpl.cpp", "security/sandbox/chromium-shim/sandbox/win/BrokerGeckoClient.cpp", "security/sandbox/chromium-shim/sandbox/win/BrokerGeckoClient.h", "security/sandbox/chromium-shim/sandbox/win/BrokerGeckoServices.h", "security/sandbox/moz.build", "security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp", "security/sandbox/win/src/sandboxbroker/sandboxBroker.h", "testing/gtest/mozilla/GTestRunner.cpp", "toolkit/xre/nsAppRunner.cpp"], "git_node": "ef21f34e0dde5ff903e3bd05e2d5019a97e36d75", "git_parents": ["9b4b2a6540e11415e0f6e54ea7df36d2c260b36c"], "node": "b372d2ca7f8190635809413d572c05d4a4a59ac0", "parents": ["d0c86b1ba1af0d5df24b77f3855d6fadc3019f74"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2084295 p2 - Add sandbox font file rules that are validated by Gecko. r=sandbox-reviewers,handyman\n\nThis allows a single set of rules to replace the individual font file rules.\nThe rules use a new policy opcode, which always matches in the target, so that\nthe request is sent to the broker. In the broker, the opcode uses\nBrokerGeckoServices to validate the requested path against installed font\nfiles, so paths that are not font files fall through to any later rules.\n\nMost of the implementation is in new chromium-shim files, so that the patch\nto the chromium code is mainly declarations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335735\n", "files": ["security/sandbox/chromium-shim/patches/57_add_font_file_rule.patch", "security/sandbox/chromium-shim/sandbox/win/src/font_file_policy.cc", "security/sandbox/chromium-shim/sandbox/win/src/font_file_policy.h", "security/sandbox/chromium-shim/sandbox/win/src/font_file_policy_opcode.cc", "security/sandbox/chromium-shim/sandbox/win/src/font_file_policy_opcode.h", "security/sandbox/chromium/sandbox/win/src/filesystem_policy.cc", "security/sandbox/chromium/sandbox/win/src/filesystem_policy.h", "security/sandbox/chromium/sandbox/win/src/policy_engine_opcodes.cc", "security/sandbox/chromium/sandbox/win/src/policy_engine_opcodes.h", "security/sandbox/chromium/sandbox/win/src/policy_low_level.h", "security/sandbox/chromium/sandbox/win/src/sandbox_policy.h", "security/sandbox/chromium/sandbox/win/src/sandbox_policy_base.h", "security/sandbox/moz.build", "security/sandbox/win/gtest/TestConfigHelpers.cpp"], "git_node": "6e700695b499c129df48c5dc487beb589bd0a6c3", "git_parents": ["ef21f34e0dde5ff903e3bd05e2d5019a97e36d75"], "node": "59bfbcb49a7ef83003944a85930bb3e77b8a14fd", "parents": ["b372d2ca7f8190635809413d572c05d4a4a59ac0"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2084295 p3 - Add a set of installed font file paths built from DirectWrite. r=gfx-reviewers,jfkthame,bradwerth\n\nThis will be used by the sandbox broker to validate font file access from child\nprocesses. It is built and rebuilt off the main thread, but only once enabled.\n\nIt is enabled behind a pref in the parent process when the gfx platform is\ncreated, which is before the GPU process is launched and before the font list\nis created.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335736\n", "files": ["gfx/tests/gtest/TestFontPathSet.cpp", "gfx/tests/gtest/moz.build", "gfx/thebes/FontPathSet.cpp", "gfx/thebes/FontPathSet.h", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxWindowsPlatform.cpp", "gfx/thebes/moz.build", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "66aa9ba93d68888806d85ea8324fe7aa0ad9b4ff", "git_parents": ["6e700695b499c129df48c5dc487beb589bd0a6c3"], "node": "5a9427afe749f914ba980b9fad34360cf1d1f654", "parents": ["59bfbcb49a7ef83003944a85930bb3e77b8a14fd"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2084295 p4 - Add a broker font file validator using the installed font path set. r=sandbox-reviewers,handyman\n\nThe validator is always registered, but it only allows access once gfx has\nenabled the font path set. No policies use the font file rules yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335737\n", "files": ["security/sandbox/win/gtest/TestConfigHelpers.cpp", "security/sandbox/win/gtest/TestFontFileValidator.cpp", "security/sandbox/win/gtest/moz.build", "security/sandbox/win/src/sandboxbroker/ConfigHelpers.cpp", "security/sandbox/win/src/sandboxbroker/ConfigHelpers.h", "security/sandbox/win/src/sandboxbroker/FontFileValidator.cpp", "security/sandbox/win/src/sandboxbroker/FontFileValidator.h", "security/sandbox/win/src/sandboxbroker/moz.build", "security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp"], "git_node": "e1242c4c14433ec94da5d1563330b28103c68bfb", "git_parents": ["66aa9ba93d68888806d85ea8324fe7aa0ad9b4ff"], "node": "d0780d955ef4ac96bbf610c5e2e8c1d919d2a81d", "parents": ["5a9427afe749f914ba980b9fad34360cf1d1f654"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2084295 p5 - Use the font file rules for the GPU process. r=sandbox-reviewers,handyman\n\nWhen enabled, this replaces the individual rules for user fonts. The standard\nper-user fonts directory is still allowed directly, as a safety net.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335738\n", "files": ["security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp"], "git_node": "02629b9414a5638131c5a2e1fd477984315278fe", "git_parents": ["e1242c4c14433ec94da5d1563330b28103c68bfb"], "node": "8989915d39e0ebfbe278376298bdf014ed5a6589", "parents": ["d0780d955ef4ac96bbf610c5e2e8c1d919d2a81d"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2084295 p6 - Use the font file rules for content processes. r=sandbox-reviewers,handyman\n\nWhen enabled, this gives access to user fonts installed outside the standard\nfont directories, which are still allowed by the existing rules.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335739\n", "files": ["security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp"], "git_node": "a31bd53f9290ccb8f025e998f11625bcba9f580e", "git_parents": ["02629b9414a5638131c5a2e1fd477984315278fe"], "node": "194c79e19db9e5a7ffce9d18c056d99d1437c93c", "parents": ["8989915d39e0ebfbe278376298bdf014ed5a6589"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2084294 - Enable the sandbox font file rules on Nightly. r=sandbox-reviewers,handyman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335740\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "33fe00a047538540cfbdaf68d7c8aadbc8c61bb4", "git_parents": ["a31bd53f9290ccb8f025e998f11625bcba9f580e"], "node": "af1b6b8ef83da1204d1e31c4922c0f846cddd933", "parents": ["194c79e19db9e5a7ffce9d18c056d99d1437c93c"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2094100 - Update mozdevice version to 4.3.0. r=Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343507\n", "files": ["testing/mozbase/mozdevice/setup.py"], "git_node": "3d9fd096daed5a7137f65a2d9722a39a42488ab0", "git_parents": ["33fe00a047538540cfbdaf68d7c8aadbc8c61bb4"], "node": "4339b5df42ca15c2ddc86ca5a18a406541db7093", "parents": ["af1b6b8ef83da1204d1e31c4922c0f846cddd933"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2093566 - Rename PersistentBufferProviderAccelerated to PersistentBufferProviderRemote, and add IsRemote(). r=lsalzman\n\nAt the moment, canvas being remote is tied to whether it's accelerated.\nThis doesn't necessarily need to be true; as a first step we can rename\nclasses and methods that are clearly about remoteness as oppossed to acceleration.\n\nFor example, callers that ask IsAccelerated() really want to know whether\nthe canvas is drawn in another process: whether it can be lost, whether\nit needs a refresh, and whether DrawImage can hand it surface descriptors.\nHave them call IsRemote() instead, so that IsAccelerated() can\nlater mean what it says.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343208\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "gfx/layers/PersistentBufferProvider.cpp", "gfx/layers/PersistentBufferProvider.h"], "git_node": "e8def5ea7095fe1c6982430c70660b3b72e52abf", "git_parents": ["3d9fd096daed5a7137f65a2d9722a39a42488ab0"], "node": "339131403501eae88fa25afc167c8a93d0b10c43", "parents": ["4339b5df42ca15c2ddc86ca5a18a406541db7093"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "f485d6e75b1033466280a41716a931ab159289ab", "git_parents": ["e8def5ea7095fe1c6982430c70660b3b72e52abf", "77bdc2893ade1d2e9029d11fc4fe261fc310fe54"], "node": "069647e78df6806e0686ab222373f7c887776084", "parents": ["339131403501eae88fa25afc167c8a93d0b10c43", "f685a69cdc831886b3dd8923b1a15e4da2b2ad2e"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042153 - Delete moz_places before moz_historyvisits to short-circuit the afterdelete trigger. r=places-reviewers,daisuke\n\nmoz_historyvisits_afterdelete_v2_trigger updates the visit's page for every\ndeleted visit. When removing pages with all their visits, delete the pages\nfirst, so those updates match nothing. Visits of kept bookmarked pages still\nupdate them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302327\n", "files": ["toolkit/components/places/History.sys.mjs"], "git_node": "11f77f3aaccfc1bff82f5f9d3e7bdfd812e3befe", "git_parents": ["f485d6e75b1033466280a41716a931ab159289ab"], "node": "c50ae915d64ed049be29d05d92ccdda94e0357f3", "parents": ["069647e78df6806e0686ab222373f7c887776084"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093861 - Update Sentry to version 8.64.0. r=android-reviewers,android-build-system-reviewers,ahochheiden,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343382\n", "files": ["gradle/libs.versions.toml"], "git_node": "d2f13dc9ac55317d73d0cc32e142da83ba0b2bb6", "git_parents": ["11f77f3aaccfc1bff82f5f9d3e7bdfd812e3befe"], "node": "450d01368e13d88f341899f0198691231b688b08", "parents": ["c50ae915d64ed049be29d05d92ccdda94e0357f3"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050088 - Remove the jssources profiler feature and collect JS source text with the js feature. r=profiler-reviewers,extension-reviewers,rpl,mstange\" for causing bc tests failures at ProtocolUtils.cpp\n\nThis reverts commit e16d11ecade5e93c3b16a8fb7b6c60f993e731b2.\n", "files": ["devtools/client/performance-new/shared/utils.js", "mozglue/baseprofiler/public/BaseProfilerState.h", "toolkit/components/extensions/schemas/geckoProfiler.json", "tools/profiler/core/platform.cpp", "tools/profiler/public/ProfilerState.h", "tools/profiler/tests/browser/browser_test_feature_js_source_table.js", "tools/profiler/tests/browser/browser_test_feature_js_sourceindex.js", "tools/profiler/tests/browser/browser_test_feature_js_sources_deduplication.js", "tools/profiler/tests/browser/browser_test_feature_js_sources_retrieval.js", "tools/profiler/tests/browser/browser_test_feature_js_sources_shutdown_process.js", "tools/profiler/tests/xpcshell/test_marker_jit_sourceindex.js", "tools/profiler/tests/xpcshell/test_source_table.js"], "git_node": "17de15f9d7ac726d6afd5326e5e2ff0158190e6c", "git_parents": ["d2f13dc9ac55317d73d0cc32e142da83ba0b2bb6"], "node": "a7e8114a92f88e362d8096eb56947847ef84d16d", "parents": ["450d01368e13d88f341899f0198691231b688b08"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093862 - Update Kotlin Serialization to version 1.13.0. r=android-reviewers,android-build-system-reviewers,ahochheiden,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343383\n", "files": ["gradle/libs.versions.toml"], "git_node": "9e90db2e361def7bd28e83b3404f2cdb6250bdf9", "git_parents": ["17de15f9d7ac726d6afd5326e5e2ff0158190e6c"], "node": "9d8e1ff50322a48bf00bb0131eac4225fc7668a8", "parents": ["a7e8114a92f88e362d8096eb56947847ef84d16d"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088997 - Part 2: Skip four browser-chrome tests that fail mostly on the macOS tart VMs. r=intermittent-reviewers,extension-reviewers,sessionstore-reviewers,places-reviewers,ai-platform-reviewers,nsharpley,aryx,mak,valentinp,rpl\n\nFailures on autoland in the 6 days after bug 2084943 landed, VM vs bare metal:\nbrowser_ext_commands_update.js (37 vs 3, the cross-platform bug 2084556),\nbrowser_bug485100-change-case-loses-tag.js (21 vs 0),\nbrowser_ml_hwinference_device_discovery.js (12 vs 0, no Metal on the VMs) and\nbrowser_tab_groups_undo.js (9 vs 0).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339587\n", "files": ["browser/components/extensions/test/browser/browser.toml", "browser/components/places/tests/browser/browser.toml", "browser/components/sessionstore/test/browser.toml", "toolkit/components/ml/tests/browser/browser.toml"], "git_node": "274c1fb48ae2dcaa7f4302c1e10c474d6692e4a5", "git_parents": ["9e90db2e361def7bd28e83b3404f2cdb6250bdf9"], "node": "19838384936fc7640faf3739edadedbc4a6662bf", "parents": ["9d8e1ff50322a48bf00bb0131eac4225fc7668a8"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088997 - Part 3: Skip browser_formless_submit_chrome.js on the macOS tart VMs. r=credential-management-reviewers,joschmidt\n\n16 failures on the VMs vs 1 on bare metal on autoland in the 6 days after\nbug 2084943 landed.\n\nDepends on D339587\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340956\n", "files": ["toolkit/components/passwordmgr/test/browser/browser.toml"], "git_node": "6594472561325d4866b887efe9a8c96d764a17d5", "git_parents": ["274c1fb48ae2dcaa7f4302c1e10c474d6692e4a5"], "node": "c192c80af2673624e47e9ee9e8869185b40ab76b", "parents": ["19838384936fc7640faf3739edadedbc4a6662bf"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2093256 - Reject HTTP/2 header blocks that repeat a pseudo-header field. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343113\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/Http2Compression.cpp", "netwerk/protocol/http/Http2Compression.h", "netwerk/test/gtest/TestHttp2Compression.cpp", "netwerk/test/gtest/moz.build"], "git_node": "dbc867c63335536f38cd96a900d6e5d21462ce05", "git_parents": ["6594472561325d4866b887efe9a8c96d764a17d5"], "node": "6e34f7474f33557ad96f4166a15445bb6754dfb4", "parents": ["c192c80af2673624e47e9ee9e8869185b40ab76b"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2093321 - Part 1: Limit the decoded size of HTTP/2 response header blocks. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343114\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/Http2Compression.cpp", "netwerk/protocol/http/Http2Compression.h", "netwerk/test/gtest/TestHttp2Compression.cpp"], "git_node": "36f269747ddde0546e84b38e2cfb45eb283a3e83", "git_parents": ["dbc867c63335536f38cd96a900d6e5d21462ce05"], "node": "209527e84831377839598360e05de7358c351b61", "parents": ["6e34f7474f33557ad96f4166a15445bb6754dfb4"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2093321 - Part 2: Advertise the HTTP/2 header list size limit to the server. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343115\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/Http2Session.cpp", "netwerk/protocol/http/Http2Session.h", "netwerk/test/unit/test_http2_max_header_list_size.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "29d8b76344c154f646cf71bef3090464004dfd29", "git_parents": ["36f269747ddde0546e84b38e2cfb45eb283a3e83"], "node": "ad1325a5b2713d3f2b7530a5606e305354f8869f", "parents": ["209527e84831377839598360e05de7358c351b61"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2048205 - Check for the cache index file only once per iteration in test_cache_encryption_flip_purge.py. r=necko-reviewers,kershaw\n\nEach index rewrite removes the old file before renaming index.tmp over it, so\nre-checking after the loop could hit that window.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343106\n", "files": ["netwerk/test/marionette/test_cache_encryption_flip_purge.py"], "git_node": "58de3544e6224486a6f85a48d880c844a47ce3d2", "git_parents": ["29d8b76344c154f646cf71bef3090464004dfd29"], "node": "6b5235dc40b7c1541283dab3e0fe4f16e7ed1ad4", "parents": ["ad1325a5b2713d3f2b7530a5606e305354f8869f"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094076 - Update android nightly application-services version bump to 07c2cc4697ac9c20b18825a82df84b953f400bc1 r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343491\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "feb2648f9732b5f9c092727981e82ae0b4daddb7", "git_parents": ["58de3544e6224486a6f85a48d880c844a47ce3d2"], "node": "3fde65ff0a9050b09682a659be94cac3ceb95184", "parents": ["6b5235dc40b7c1541283dab3e0fe4f16e7ed1ad4"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2091111 - Add telemetry to show when messaging system impressions fail to save and how many impressions an action-only message had already recorded r=omc-reviewers,jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341646\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/ASRouterStorage.sys.mjs", "browser/components/asrouter/tests/unit/ASRouter.test.js", "browser/components/asrouter/tests/unit/ASRouterStorage.test.js"], "git_node": "ac694463ffe6fc4e8314755617a57e3422c80a39", "git_parents": ["feb2648f9732b5f9c092727981e82ae0b4daddb7"], "node": "560284452260f69764e3709cc5a536842f55c36b", "parents": ["3fde65ff0a9050b09682a659be94cac3ceb95184"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093701 - Expose record removal from autocomplete dropdown to Nimbus. r=mtigley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343284\n", "files": ["toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "a8dd8ace502d02abab4792f62f1a7c821e0e0fb3", "git_parents": ["ac694463ffe6fc4e8314755617a57e3422c80a39"], "node": "dc6a05b79fc28238057e8e2535a5c20812f29e78", "parents": ["560284452260f69764e3709cc5a536842f55c36b"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2072337: Remove support for usrsctp. r=ng\n\nDoing this now so there's no need to modify this dead code to keep up\nwith the change to DataChannelConnection::Destroy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342212\n", "files": ["dom/media/webrtc/tests/mochitests/mochitest_datachannel.toml", "dom/media/webrtc/tests/mochitests/test_dataChannel_dcsctp_interop.html", "dom/media/webrtc/transport/test/moz.build", "dom/media/webrtc/transport/test/sctp_unittest.cpp", "modules/libpref/init/all.js", "netwerk/moz.build", "netwerk/sctp/datachannel/DataChannel.cpp", "netwerk/sctp/datachannel/DataChannelUsrsctp.cpp", "netwerk/sctp/datachannel/DataChannelUsrsctp.h", "netwerk/sctp/datachannel/moz.build", "netwerk/sctp/src/LICENSE-NOTICE.txt", "netwerk/sctp/src/LICENSE.md", "netwerk/sctp/src/README.md", "netwerk/sctp/src/flush-before-process-init.patch", "netwerk/sctp/src/interleaving-supported-define.patch", "netwerk/sctp/src/moz.build", "netwerk/sctp/src/moz.yaml", "netwerk/sctp/src/netinet/sctp.h", "netwerk/sctp/src/netinet/sctp_asconf.c", "netwerk/sctp/src/netinet/sctp_asconf.h", "netwerk/sctp/src/netinet/sctp_auth.c", "netwerk/sctp/src/netinet/sctp_auth.h", "netwerk/sctp/src/netinet/sctp_bsd_addr.c", "netwerk/sctp/src/netinet/sctp_bsd_addr.h", "netwerk/sctp/src/netinet/sctp_callout.c", "netwerk/sctp/src/netinet/sctp_callout.h", "netwerk/sctp/src/netinet/sctp_cc_functions.c", "netwerk/sctp/src/netinet/sctp_constants.h", "netwerk/sctp/src/netinet/sctp_crc32.c", "netwerk/sctp/src/netinet/sctp_crc32.h", "netwerk/sctp/src/netinet/sctp_header.h", "netwerk/sctp/src/netinet/sctp_indata.c", "netwerk/sctp/src/netinet/sctp_indata.h", "netwerk/sctp/src/netinet/sctp_input.c", "netwerk/sctp/src/netinet/sctp_input.h", "netwerk/sctp/src/netinet/sctp_lock_userspace.h", "netwerk/sctp/src/netinet/sctp_os.h", "netwerk/sctp/src/netinet/sctp_os_userspace.h", "netwerk/sctp/src/netinet/sctp_output.c", "netwerk/sctp/src/netinet/sctp_output.h", "netwerk/sctp/src/netinet/sctp_pcb.c", "netwerk/sctp/src/netinet/sctp_pcb.h", "netwerk/sctp/src/netinet/sctp_peeloff.c", "netwerk/sctp/src/netinet/sctp_peeloff.h", "netwerk/sctp/src/netinet/sctp_process_lock.h", "netwerk/sctp/src/netinet/sctp_sha1.c", "netwerk/sctp/src/netinet/sctp_sha1.h", "netwerk/sctp/src/netinet/sctp_ss_functions.c", "netwerk/sctp/src/netinet/sctp_structs.h", "netwerk/sctp/src/netinet/sctp_sysctl.c", "netwerk/sctp/src/netinet/sctp_sysctl.h", "netwerk/sctp/src/netinet/sctp_timer.c", "netwerk/sctp/src/netinet/sctp_timer.h", "netwerk/sctp/src/netinet/sctp_uio.h", "netwerk/sctp/src/netinet/sctp_userspace.c", "netwerk/sctp/src/netinet/sctp_usrreq.c", "netwerk/sctp/src/netinet/sctp_var.h", "netwerk/sctp/src/netinet/sctputil.c", "netwerk/sctp/src/netinet/sctputil.h", "netwerk/sctp/src/netinet6/sctp6_usrreq.c", "netwerk/sctp/src/netinet6/sctp6_var.h", "netwerk/sctp/src/restore_mod.sh", "netwerk/sctp/src/tsn-gap-check.patch", "netwerk/sctp/src/user_atomic.h", "netwerk/sctp/src/user_environment.c", "netwerk/sctp/src/user_environment.h", "netwerk/sctp/src/user_inpcb.h", "netwerk/sctp/src/user_ip6_var.h", "netwerk/sctp/src/user_ip_icmp.h", "netwerk/sctp/src/user_malloc.h", "netwerk/sctp/src/user_mbuf.c", "netwerk/sctp/src/user_mbuf.h", "netwerk/sctp/src/user_queue.h", "netwerk/sctp/src/user_recv_thread.c", "netwerk/sctp/src/user_recv_thread.h", "netwerk/sctp/src/user_route.h", "netwerk/sctp/src/user_socket.c", "netwerk/sctp/src/user_socketvar.h", "netwerk/sctp/src/user_uma.h", "netwerk/sctp/src/usrsctp.h"], "git_node": "44725fe4fa48c4abb02f2ae20fe05821b16b67ce", "git_parents": ["a8dd8ace502d02abab4792f62f1a7c821e0e0fb3"], "node": "ddf09c0410157a83304797d7920e8fe799f4f834", "parents": ["dc6a05b79fc28238057e8e2535a5c20812f29e78"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2072337: Wait until DataChannel is shut down before shutting down the transport. r=ng\n\nAlso some simplification; it looks like there is no situation where we\nreally wanted/needed to reset all streams during teardown, so I've\nremoved that.\n\nMake DataChannelConnection::SendPacket STS-only; the usrsctp\nimplementation called this from a different thread, but that's gone now.\n\nLastly, for the virtual functions in DataChannelConnection, document\nwhat thread they are called on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342213\n", "files": ["dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "netwerk/sctp/datachannel/DataChannel.cpp", "netwerk/sctp/datachannel/DataChannel.h", "netwerk/sctp/datachannel/DataChannelDcSctp.cpp", "netwerk/sctp/datachannel/DataChannelDcSctp.h"], "git_node": "fe102a6b3c9d5aa386e3e30af288a786bf364a55", "git_parents": ["44725fe4fa48c4abb02f2ae20fe05821b16b67ce"], "node": "6831d48769695302e46344c89725c50a927402f6", "parents": ["ddf09c0410157a83304797d7920e8fe799f4f834"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084622 - Call upstream Taskgraph's `use_secrets` transforms, r=taskgraph-reviewers,bhearsum\n\nThis allows tasks in Gecko to use Taskgraph 24.9.0's new ability to\nfetch secrets in `run-task` (assuming they are using the upstream\nrun-task).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343262\n", "files": ["taskcluster/gecko_taskgraph/transforms/job/__init__.py"], "git_node": "62b733f1ceaee8dc578e60b46473cf888b595669", "git_parents": ["fe102a6b3c9d5aa386e3e30af288a786bf364a55"], "node": "50348879a0a82ad3d35e32435f3c0f2f0b7f62cc", "parents": ["6831d48769695302e46344c89725c50a927402f6"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084622 - Run source-test-taskgraph-diff on git pushes against the derived base revision, r=taskgraph-reviewers,bhearsum\n\nTaskgraph's run-task replaces \u003cPREFIX\u003e_BASE_REV with the merge base found\nthrough GitHub's compare API and fetches it. Pass the base revision and ref to\nthe task through GECKO_BASE_REV and GECKO_BASE_REF, and read the base at\nruntime so the diff runs against the corrected value instead of the one baked\ninto the task definition. This makes tgdiff work for pushes that create a\nbranch or force push one, such as the code review bot's.\n\nSupport Taskgraph's `secrets` key in job descriptions by reusing its\n`use_secrets` transform, and use it on git pushes to give run-task a GitHub\ntoken, so its compare requests aren't rate limited as anonymous ones.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343263\n", "files": ["taskcluster/kinds/source-test/taskgraph.yml"], "git_node": "90b99095608a8a38c62262e807811bc373448161", "git_parents": ["62b733f1ceaee8dc578e60b46473cf888b595669"], "node": "68e78809c2a13eb732af6ac43510bb828070c15a", "parents": ["50348879a0a82ad3d35e32435f3c0f2f0b7f62cc"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093988: append new DumperErrors to previous values r=crashreporting-reviewers,gsvelto\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343462\n", "files": ["toolkit/crashreporter/crash_helper_server/src/crash_generation.rs", "toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "f746d8af3e5231