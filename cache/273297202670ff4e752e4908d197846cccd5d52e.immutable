["dom/gamepad/Gamepad.cpp", "dom/gamepad/Gamepad.h", "dom/gamepad/GamepadManager.cpp", "dom/gamepad/GamepadManager.h", "dom/gamepad/GamepadPlatformService.cpp", "dom/gamepad/GamepadPlatformService.h", "dom/gamepad/GamepadServiceTest.cpp", "dom/gamepad/GamepadServiceTest.h", "dom/gamepad/android/AndroidGamepad.cpp", "dom/gamepad/cocoa/CocoaGamepad.cpp", "dom/gamepad/ipc/GamepadEventTypes.ipdlh", "dom/gamepad/ipc/GamepadTestChannelParent.cpp", "dom/gamepad/linux/LinuxGamepad.cpp", "dom/gamepad/windows/WindowsGamepad.cpp", "dom/tests/mochitest/gamepad/test_gamepad_connect_events_iframe.html", "dom/tests/mochitest/gamepad/test_gamepad_extensions_iframe.html", "dom/tests/mochitest/gamepad/test_gamepad_frame_state_sync_iframe.html", "dom/tests/mochitest/gamepad/test_gamepad_hidden_frame.html", "dom/tests/mochitest/gamepad/test_gamepad_iframe.html", "dom/tests/mochitest/gamepad/test_gamepad_multitouch_crossorigin_iframe.html", "dom/tests/mochitest/gamepad/test_gamepad_user_activation_background_tab.html", "dom/tests/mochitest/gamepad/test_gamepad_user_activation_iframe.html", "dom/tests/mochitest/gamepad/test_navigator_gamepads_iframe.html", "dom/vr/XRInputSource.cpp", "dom/webidl/GamepadServiceTest.webidl", "gfx/vr/VRDisplayClient.cpp"], "git_node": "80321b6a54ff119ab7bf4321df30a024cf08e03f", "git_parents": ["c1d11dcb40fbc30a212ccbef5266209ea3830252"], "node": "0629f1938e55805e7486e621d01fba471cd2e489", "parents": ["7a21406aec93f0aa41e9111edc7cb599b8e8b177"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 2050234 - Update documentation for feature-ipprotection r=sfamisa,android-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342005\n", "files": ["mobile/android/android-components/components/feature/ipprotection/README.md", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt"], "git_node": "329d9b4c0256dc2798852ef86e264905395d73b8", "git_parents": ["80321b6a54ff119ab7bf4321df30a024cf08e03f"], "node": "ba6c1df31e04d198aa6ba33f513348e97ce68d21", "parents": ["0629f1938e55805e7486e621d01fba471cd2e489"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2091015 - Make GamepadHand implementation empty r=gamepad-reviewers,webidl,smaug,jesup\" for causing build bustages in XRInputSource.cpp\n\nThis reverts commit 80321b6a54ff119ab7bf4321df30a024cf08e03f.\n\nRevert \"Bug 2091015 - Make GamepadPose implementation empty r=gamepad-reviewers,webidl,smaug,jesup\"\n\nThis reverts commit c1d11dcb40fbc30a212ccbef5266209ea3830252.\n", "files": ["dom/gamepad/Gamepad.cpp", "dom/gamepad/Gamepad.h", "dom/gamepad/GamepadManager.cpp", "dom/gamepad/GamepadManager.h", "dom/gamepad/GamepadPlatformService.cpp", "dom/gamepad/GamepadPlatformService.h", "dom/gamepad/GamepadPose.cpp", "dom/gamepad/GamepadPose.h", "dom/gamepad/GamepadPoseState.h", "dom/gamepad/GamepadRemapping.h", "dom/gamepad/GamepadServiceTest.cpp", "dom/gamepad/GamepadServiceTest.h", "dom/gamepad/android/AndroidGamepad.cpp", "dom/gamepad/cocoa/CocoaGamepad.cpp", "dom/gamepad/ipc/GamepadEventTypes.ipdlh", "dom/gamepad/ipc/GamepadMessageUtils.h", "dom/gamepad/ipc/GamepadTestChannelParent.cpp", "dom/gamepad/linux/LinuxGamepad.cpp", "dom/gamepad/windows/WindowsGamepad.cpp", "dom/tests/mochitest/gamepad/test_gamepad_connect_events_iframe.html", "dom/tests/mochitest/gamepad/test_gamepad_extensions_iframe.html", "dom/tests/mochitest/gamepad/test_gamepad_frame_state_sync_iframe.html", "dom/tests/mochitest/gamepad/test_gamepad_hidden_frame.html", "dom/tests/mochitest/gamepad/test_gamepad_iframe.html", "dom/tests/mochitest/gamepad/test_gamepad_multitouch_crossorigin_iframe.html", "dom/tests/mochitest/gamepad/test_gamepad_user_activation_background_tab.html", "dom/tests/mochitest/gamepad/test_gamepad_user_activation_iframe.html", "dom/tests/mochitest/gamepad/test_navigator_gamepads_iframe.html", "dom/vr/XRInputSource.cpp", "dom/webidl/GamepadServiceTest.webidl", "gfx/vr/VRDisplayClient.cpp", "gfx/vr/service/OculusSession.cpp", "gfx/vr/service/OpenVRSession.cpp"], "git_node": "671251d7ec5008b57dbcd6b02c1d7be84408d540", "git_parents": ["329d9b4c0256dc2798852ef86e264905395d73b8"], "node": "41b2a4edc6efb69fd57eca0e1e6d63b175764d68", "parents": ["ba6c1df31e04d198aa6ba33f513348e97ce68d21"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2094360 - Remove the homepage-hide-frecent-top-sites Nimbus feature r=android-reviewers,Roger\n\n- The feature defaults to false on every channel, so frecent top sites are always shown\n- The top sites config now always includes the frecency config\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343831\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/TopSitesConfigCreator.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/TopSitesConfigCreatorTest.kt"], "git_node": "92b931e3d6fe57df5359fea3b57244daaf412867", "git_parents": ["671251d7ec5008b57dbcd6b02c1d7be84408d540"], "node": "0b5dd974a92b68e74ae632a1a4f8ca904e64df6a", "parents": ["41b2a4edc6efb69fd57eca0e1e6d63b175764d68"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Keep the unchanged files of the l10n merge tree r=firefox-build-system-reviewers,sylvestre\n\n`l10n_merge` wiped `merge-dir/\u003clocale\u003e` before every run, so every merged\nfile got a new mtime and everything that reads the merge tree became stale.\nThe merge now builds into a temporary directory, rewrites only the files whose\ncontent changed, and removes the files it no longer produces.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340120\n", "files": ["python/mozbuild/mozbuild/action/l10n_merge.py", "python/mozbuild/mozbuild/test/action/test_l10n_merge.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "a9616776a415ce51f969d4e6c32164db29e066c9", "git_parents": ["92b931e3d6fe57df5359fea3b57244daaf412867"], "node": "4fe3e1cb67c8561d6a4bb8f403982a81baf1abcb", "parents": ["0b5dd974a92b68e74ae632a1a4f8ca904e64df6a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the `SYMBOLS_FILE` link dependency from `RecursiveMakeBackend` to `extra_link_deps` r=firefox-build-system-reviewers,sergesanspaille\n\nA shared library now lists its symbols file in `extra_link_deps`, so every\nbackend reads the files a link waits for from one list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341553\n", "files": ["python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/extra-link-deps/sharedlib/lib.symbols", "python/mozbuild/mozbuild/test/backend/data/extra-link-deps/sharedlib/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/frontend/data/extra-link-deps-symbols-file/foo.py", "python/mozbuild/mozbuild/test/frontend/data/extra-link-deps-symbols-file/moz.build", "python/mozbuild/mozbuild/test/frontend/test_emitter.py"], "git_node": "931ef73c7cb0d532e54cd33f42b6d08db86f3aad", "git_parents": ["a9616776a415ce51f969d4e6c32164db29e066c9"], "node": "bb7a2c2001fa27de55b0f120c296dc50f80fcd34", "parents": ["4fe3e1cb67c8561d6a4bb8f403982a81baf1abcb"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Add `--prebuilt` to `check_binary` to skip the checks that only apply to binaries we link r=firefox-build-system-reviewers,sylvestre,sergesanspaille\n\nPrebuilt libraries that `FINAL_TARGET_FILES` installs only need the checks that\nthey work on the systems we support, `check_binary_compat` and `check_textrel`.\n`RecursiveMakeBackend` passes `--prebuilt` for them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341649\n", "files": ["python/mozbuild/mozbuild/action/check_binary.py", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/action/test_check_binary.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "483b6166a0c2082245e8966f3930d373bd55709e", "git_parents": ["931ef73c7cb0d532e54cd33f42b6d08db86f3aad"], "node": "a115b056f5c6fe07ca136516edaabaa3b2e716cb", "parents": ["bb7a2c2001fa27de55b0f120c296dc50f80fcd34"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Run `./mach build install` in the `sm-package` task r=sfink\n\nNo task ran the SpiderMonkey install before. The task now installs into a\nstaging directory, checks for the pkg-config file, `js-config`, the shell, the\nshared library and `jsapi.h`, and uploads `install-files.txt` with every\ninstalled path and mode and the header hashes.\n\nautospider now moves `CC`, `CXX`, `CFLAGS` and `CXXFLAGS` from its environment\ninto `mozconfig.autospider`. Every mach command in its objdir, inside autospider\nor not, then configures with the same compilers and flags. The 32 bit SSE flags\nfor C now go to `CFLAGS`, because configure never read `CCFLAGS`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341103\n", "files": ["js/src/devtools/automation/autospider.py", "taskcluster/scripts/builder/build-sm-package.sh"], "git_node": "5dc300a265ef272227761c0c8a8e9abf147d427c", "git_parents": ["483b6166a0c2082245e8966f3930d373bd55709e"], "node": "1ba84e30630659ac5a19c6c1a3912c76627a510e", "parents": ["a115b056f5c6fe07ca136516edaabaa3b2e716cb"], "tags": []}], "d