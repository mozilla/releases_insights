 ["testing/web-platform/meta/css/css-backgrounds/parsing/background-shorthand-serialization.html.ini", "testing/web-platform/meta/css/css-backgrounds/parsing/background-valid.html.ini"], "git_node": "a8e510ed61111351202b9776c5811090cb013369", "git_parents": ["8911f85948614a3d7fa63de18334790f962b30ee"], "node": "208750f279833e24fe8e75a67851359f3d138167", "parents": ["153941e81d5723c22f00700931869f2871ab0868"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2087242 [wpt PR 64053] - Consolidate Link header target URL and PMI redirect WPT files, a=testonly\n\nAutomatic update from web-platform-tests\nConsolidate Link header target URL and PMI redirect WPT files (#64053)\n\nConsolidate single-test Link header target URL WPT files and PMI\nredirect WPT files, and replace WPT server-side substitution\n(.sub.window.js) with get_host_info() and options.origin on helper\nfunctions:\n\n   - Merge link-header-non-https.https.sub.window.js and\n     link-header-redirect-resolution.https.window.js into\n     link-header-target-url.https.window.js.\n\n   - Merge pmi-redirect-limits.https.window.js and\n     pmi-redirect-origins.https.sub.window.js into\n     pmi-redirects.https.window.js.\n\nFixed: 552832440\nChange-Id: Ieaa196b89f6ee078fd7149e99c82839872c9bab3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8484465\nReviewed-by: Xuehui Chen \u003cxuehuichen@google.com\u003e\nCommit-Queue: Xuehui Chen \u003cxuehuichen@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1716015}\n\nCo-authored-by: Stephen McGruer \u003csmcgruer@chromium.org\u003e\n--\n\nwpt-commits: 253f2fc78a0229504c237a71cc4d2ce4e6d512f9\nwpt-pr: 64053\n", "files": ["testing/web-platform/tests/common/get-host-info.sub.js", "testing/web-platform/tests/payment-method-manifest/link-header-non-https.https.sub.window.js", "testing/web-platform/tests/payment-method-manifest/link-header-redirect-resolution.https.window.js", "testing/web-platform/tests/payment-method-manifest/link-header-target-url.https.window.js", "testing/web-platform/tests/payment-method-manifest/pmi-redirect-limits.https.window.js", "testing/web-platform/tests/payment-method-manifest/pmi-redirect-origins.https.sub.window.js", "testing/web-platform/tests/payment-method-manifest/pmi-redirects.https.window.js", "testing/web-platform/tests/payment-method-manifest/resources/helpers.js"], "git_node": "cae64a6de657ad035988952979f05e303a8e95c2", "git_parents": ["a8e510ed61111351202b9776c5811090cb013369"], "node": "5eb523c1517bd483dc582a919c24782857e45066", "parents": ["208750f279833e24fe8e75a67851359f3d138167"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087242 [wpt PR 64053] - Update wpt metadata, a=testonly\n\nwpt-pr: 64053\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/payment-method-manifest/link-header-non-https.https.sub.window.js.ini", "testing/web-platform/meta/payment-method-manifest/link-header-redirect-resolution.https.window.js.ini", "testing/web-platform/meta/payment-method-manifest/pmi-redirect-limits.https.window.js.ini", "testing/web-platform/meta/payment-method-manifest/pmi-redirect-origins.https.sub.window.js.ini"], "git_node": "4aaaedb6ca0b0ea17f33b6e98c15000ce24b8b26", "git_parents": ["cae64a6de657ad035988952979f05e303a8e95c2"], "node": "deccbffaa643e3154e72b129af3833db41566402", "parents": ["5eb523c1517bd483dc582a919c24782857e45066"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2075457 [wpt PR 62943] - WebXR: Support projection layers without layers feature enabled, a=testonly\n\nAutomatic update from web-platform-tests\nWebXR: Support projection layers without layers feature enabled (#62943)\n\nAllow projection layers to use the layer manager even when the\noptional 'layers' feature is not requested, and validate that\nonly projection layers and single layers are allowed.\n\nBug: 462131288\nChange-Id: Icc82e28140d28e6000f7e081c8911e080e2559e5\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8426586\nReviewed-by: Brian Sheedy \u003cbsheedy@chromium.org\u003e\nCommit-Queue: Yong Li (xWF) \u003cyyonglii@google.com\u003e\nReviewed-by: Brandon Jones \u003cbajones@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1704627}\n\nCo-authored-by: Yong Li \u003cyyonglii@xwf.google.com\u003e\n--\n\nwpt-commits: a50a958a6e4c822d7330aa08447f345e85c67c99\nwpt-pr: 62943\n", "files": ["testing/web-platform/tests/resources/chromium/webxr-test.js", "testing/web-platform/tests/webxr/layers/xrSession_updateRenderState.https.html"], "git_node": "d2b9a14a38fad793e5d80a3cb921610dac786125", "git_parents": ["4aaaedb6ca0b0ea17f33b6e98c15000ce24b8b26"], "node": "6a448d5c639eb2928acb08e31923e1c13b271a75", "parents": ["deccbffaa643e3154e72b129af3833db41566402"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2087258 [wpt PR 64079] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328578, a=testonly\n\nAutomatic update from web-platform-tests\nClean up TextResourceDecoder's ContentType and EncodingSource\n\nMake TextResourceDecoder::ContentType and TextResourceDecoder::EncodingSource enum classes, and drop\nthe now redundant \"Encoding\" from the names of EncodingSource's values, as in\nEncodingSource::HTTPHeader rather than EncodingFromHTTPHeader.\n\nTextResourceDecoder::create() took either a MIME type, which it mapped to a ContentType and used to\nadjust the fallback encoding, or a ContentType, which it used as is. Keep only the ContentType\nversion, have it adjust the fallback encoding too, and make the mapping public as\nTextResourceDecoder::contentTypeForMIMEType() for the callers whose MIME type is not fixed. Callers\nthat passed a MIME type literal now pass the ContentType it maps to, and callers that passed\n\"UTF-8\"_s now pass PAL::UTF8Encoding(). create() loses its LEGACY_NODELETE annotation, as the\nfallback encoding adjustment calls PAL::UTF8Encoding() and PAL::Latin1Encoding().\n\ncontentTypeForMIMEType() matches some MIME types ignoring ASCII case and one, text/xsl, exactly. Its\ncallers pass a MIME type that the network stack already lowercased, as CFNetwork and the curl\nbackend do, so it now asserts that. A new subtest loads a JSON document served as APPLICATION/JSON,\nso that debug bots catch a port that passes a MIME type through unchanged.\n\nThe style checker flagged a few existing issues on the lines this touches, so remove trailing\nwhitespace in TextResourceDecoder::setEncoding(), add braces to the nested if statements in\nTextResourceDecoder::decode(), and let check-webkit-style accept HTML and XML as enum values, as it\nalready does CSS and JSON.\n\nNo change in behavior.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328578\n\n--\n\nwpt-commits: 58bd525e77094b7a1710e45d6a842aab0dbae25e\nwpt-pr: 64079\n", "files": ["testing/web-platform/tests/encoding/json-document-utf8.html"], "git_node": "cb749230f6d305c2136f8e8a9f990d37ce8ae9c9", "git_parents": ["d2b9a14a38fad793e5d80a3cb921610dac786125"], "node": "5bcc3673785c87bd2c2f4a82202500b9bd7587a5", "parents": ["6a448d5c639eb2928acb08e31923e1c13b271a75"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087270 [wpt PR 64194] - Update Wasm tests, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate Wasm tests (core)\n\n--\n\nwpt-commits: ff06e653c31aeacc78b9275e36ee1c80bf638e60\nwpt-pr: 64194\n", "files": ["testing/web-platform/tests/wasm/core/exceptions/cast.wast.js.html", "testing/web-platform/tests/wasm/core/js/binary.wast.js", "testing/web-platform/tests/wasm/core/js/exceptions/cast.wast.js", "testing/web-platform/tests/wasm/core/js/gc/array_init_data.wast.js", "testing/web-platform/tests/wasm/core/js/gc/array_new_data.wast.js", "testing/web-platform/tests/wasm/core/js/memory64/memory_grow64.wast.js", "testing/web-platform/tests/wasm/core/js/memory64/table_grow64.wast.js", "testing/web-platform/tests/wasm/core/js/memory_grow.wast.js", "testing/web-platform/tests/wasm/core/js/relaxed-simd/relaxed_madd_nmadd.wast.js", "testing/web-platform/tests/wasm/core/js/table_grow.wast.js", "testing/web-platform/tests/wasm/core/js/utf8-invalid-encoding.wast.js"], "git_node": "ed20057a710fedc6a84a89368e6ca62e34e8242b", "git_parents": ["cb749230f6d305c2136f8e8a9f990d37ce8ae9c9"], "node": "1ed146b31d79cfe47727422ad5bde7c1229e7847", "parents": ["5bcc3673785c87bd2c2f4a82202500b9bd7587a5"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087270 [wpt PR 64194] - Update wpt metadata, a=testonly\n\nwpt-pr: 64194\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/wasm/core/memory64/memory_grow64.wast.js.html.ini", "testing/web-platform/meta/wasm/core/memory64/table_grow64.wast.js.html.ini"], "git_node": "68bbb331bc67f9c1ee578bf6225d2bf16c6833c2", "git_parents": ["ed20057a710fedc6a84a89368e6ca62e34e8242b"], "node": "64761e206ae3e8d91216f6e8c85e32e00c55f3fb", "parents": ["1ed146b31d79cfe47727422ad5bde7c1229e7847"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2087299 [wpt PR 64202] - SVG text: keep combining marks with their base character, a=testonly\n\nAutomatic update from web-platform-tests\nSVG text: keep combining marks with their base character\n\nx/y/dx/dy/rotate lists were consumed and applied per code point, so a\ncombining mark took a list value and was shaped and positioned apart\nfrom its base. A code point that extends the previous typographic\ncharacter is now the \"middle\" of that character: it still consumes a\nvalue of every list, which keeps the lists indexed by addressable\ncharacters, but its x and y are dropped and its dx and dy are\naccumulated into the next typographic character.\n\nBug: 41007184\nChange-Id: Ic9437365bdf5795122a1a1cac284914be47fe506\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8644950\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1726687}\n\n--\n\nwpt-commits: c1197659b972f88d77bbf77acdb0a65d6f38c83f\nwpt-pr: 64202\n", "files": ["testing/web-platform/tests/svg/text/reftests/text-positioning-list-combining-marks-indexing-ref.html", "testing/web-platform/tests/svg/text/reftests/text-positioning-list-combining-marks-indexing.html", "testing/web-platform/tests/svg/text/reftests/text-positioning-list-combining-marks-ref.html", "testing/web-platform/tests/svg/text/reftests/text-positioning-list-combining-marks.html"], "git_node": "960dbed056c30ac535546bab0a15a7f4afdefe3e", "git_parents": ["68bbb331bc67f9c1ee578bf6225d2bf16c6833c2"], "node": "94add6d32aa37f55ea6c9dc600fe5a86e05c661c", "parents": ["64761e206ae3e8d91216f6e8c85e32e00c55f3fb"], "tags": []}, {"author": "Matt Hargett \u003cplaztiksyke@gmail.com\u003e", "branch": "default", "desc": "Bug 2084482 [wpt PR 63663] - WebNN: cover full-range int32 values and produced copies, a=testonly\n\nAutomatic update from web-platform-tests\nWebNN: cover full-range int32 values and produced copies (#63663)\n\n* test(webnn): cover full-range int32 values and produced copies\n\nCheck adjacent large integers, signed extrema, truncating division, unique argument-reduction winners and a hidden producer through Identity. Validate browser contexts, defective controls and historical faulty versus repaired RustNN execution.\n\n* test(webnn): clarify full-range int32 regression cases\n\nRename the test-case collection, expand nested-object formatting, and explain why only the Identity output is exposed. Preserve all generated test data and the zero-ULP accuracy gate.\n\nValidation: WPT lint, Node syntax check, git diff --check, and equality of all 11 generated cases against the prior revision.\n--\n\nwpt-commits: ffc4686d117de150daf1287809302e3edea82dc6\nwpt-pr: 63663\n", "files": ["testing/web-platform/tests/webnn/conformance_tests/int32-full-range.https.any.js"], "git_node": "0cc825b094bddf08c276b262956c3c5a5f2bf20f", "git_parents": ["960dbed056c30ac535546bab0a15a7f4afdefe3e"], "node": "32c94d9fa931d03cf506a02a731d91ff280f4643", "parents": ["94add6d32aa37f55ea6c9dc600fe5a86e05c661c"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2087327 [wpt PR 64134] - layout: Account for percentage quirk during intrinsic sizing (part 2), a=testonly\n\nAutomatic update from web-platform-tests\nlayout: Account for percentage quirk during intrinsic sizing (part 2)\n\nSigned-off-by: Oriol Brufau \u003cobrufau@igalia.com\u003e\n\n--\n\nwpt-commits: 3440698d998297e77244cd041be28dcc91c440ce\nwpt-pr: 64134\n", "files": ["testing/web-platform/tests/css/css-sizing/intrinsic-percent-replaced-034.html", "testing/web-platform/tests/css/css-sizing/intrinsic-percent-replaced-035.html"], "git_node": "3328a8eb31fb8141f223f96124b78142f937c0a3", "git_parents": ["0cc825b094bddf08c276b262956c3c5a5f2bf20f"], "node": "0901162dbbd0b0142e0d4abbeadfc32c85bce73b", "parents": ["32c94d9fa931d03cf506a02a731d91ff280f4643"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087327 [wpt PR 64134] - Update wpt metadata, a=testonly\n\nwpt-pr: 64134\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-sizing/intrinsic-percent-replaced-034.html.ini", "testing/web-platform/meta/css/css-sizing/intrinsic-percent-replaced-035.html.ini"], "git_node": "749b2b1296e3e9c3465914081ce888fcf1ac0be2", "git_parents": ["3328a8eb31fb8141f223f96124b78142f937c0a3"], "node": "51ed736ac44b012e9d476d448d73a395ee61cfbd", "parents": ["0901162dbbd0b0142e0d4abbeadfc32c85bce73b"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2087329 [wpt PR 64201] - [html-in-canvas] Fix filter dirty bit clearing, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Fix filter dirty bit clearing\n\nThis patch moves clearing of `filter_on_effect_node_dirty_` and\n`backdrop_filter_on_effect_node_dirty_` out of `PaintLayer`'s filter\nbuilder methods (which are now `const`) and into\n`PaintLayer::ClearFilterAndBackdropFilterOnEffectNodeDirty()`, called\nfrom `PaintPropertyTreeBuilder::UpdateForSelf` once the object's last\nfragment updates.\n\nPreviously, `UpdateCompositorFilterOperationsForFilter` and\n`UpdateCompositorFilterOperationsForBackdropFilter` cleared the shared\n`PaintLayer` dirty bits immediately. An earlier fragment in a multicol\ncontainer would clear the dirty bit before later fragments updated,\ncausing those fragments to early-return and keep stale filter\noperations after moving into a `\u003ccanvas content=drawable\u003e` subtree.\n\nFixed: 574759287\nChange-Id: I9efea4ec9e717e2d087376ab21b925313bc93a71\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8639479\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1726725}\n\n--\n\nwpt-commits: ac7939c9e8b73d0f22962191b3c7c065ff36374c\nwpt-pr: 64201\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/box-reflect-images-in-iframe-multicol-moved-ignored.tentative.https.sub.html"], "git_node": "df1bfb9d9c1460c0d11b4914045ef1c0fce45904", "git_parents": ["749b2b1296e3e9c3465914081ce888fcf1ac0be2"], "node": "2fb9294850a2f770b4afe48fcaa4c2fbdc1e3b9b", "parents": ["51ed736ac44b012e9d476d448d73a395ee61cfbd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087329 [wpt PR 64201] - Update wpt metadata, a=testonly\n\nwpt-pr: 64201\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/box-reflect-images-in-iframe-multicol-moved-ignored.tentative.https.sub.html.ini"], "git_node": "cfb82c1643f58e04ac98152e2e4b3cd4d6b3f808", "git_parents": ["df1bfb9d9c1460c0d11b4914045ef1c0fce45904"], "node": "7da2cba136fd2ff4e4f811358116ab0588fca1c4", "parents": ["2fb9294850a2f770b4afe48fcaa4c2fbdc1e3b9b"], "tags": []}, {"author": "Samuel Huang \u003chuangs@chromium.org\u003e", "branch": "default", "desc": "Bug 2087341 [wpt PR 64203] - [Blink] Fix layout lifecycle crash on gesture long-press, a=testonly\n\nAutomatic update from web-platform-tests\n[Blink] Fix layout lifecycle crash on gesture long-press\n\nFix a layout lifecycle assertion crash in `HitTestResult::GetPosition()`\nduring touch long-press gestures.\n\nWhen a touch long-press occurs, `HandleGestureLongPress()` calls\n`SelectClosestWordFromHitTestResult()` to select the word. If word\nselection fails or is cancelled by a `selectstart` event listener, it\nfalls back to placing a caret via `SetCaretAtHitTestResult()`. Both\nmethods query `HitTestResult::GetPosition()`, which asserts (DCHECK)\nthat the document lifecycle is at least `kPrePaintClean`.\n\nHowever, gesture selection previously lacked proper layout lifecycle\nupdates:\n* `HandleGestureLongPress()` only invoked `UpdateStyleAndLayoutTree()`,\n  skipping layout geometry and pre-paint property tree updates needed\n  by `SelectClosestWordFromHitTestResult()`.\n* When `SelectClosestWordFromHitTestResult()` dispatches `selectstart`,\n  author JavaScript can mutate styles or DOM and cancel selection.\n  This re-dirties the document lifecycle mid-gesture before the\n  fallback caret placement in `SetCaretAtHitTestResult()`.\n\nWhile mouse press paths were long ago guarded with full lifecycle\nupdates in `MouseEventManager::HandleMousePressEvent()`, gesture paths\nwere missing these guards.\n\nChange details: In `blink::SelectionController`:\n* `HandleGestureLongPress()`: Advance all lifecycle phases through\n  pre-paint by replacing `UpdateStyleAndLayoutTree()` call with\n  `UpdateAllLifecyclePhasesExceptPaint()`.\n* `SetCaretAtHitTestResult()`: Add the same call to ensure any\n  mid-gesture mutations (and other callers like\n  `HandleGestureTwoFingerTap()`) operate on clean layout geometry.\n* Add regression unit tests in `selection_controller_test.cc`, covering\n  both pre-gesture dirty layout and mid-gesture selectstart mutations.\n* Add WPT crashtest in `longpress-selection-crash.html`.\n\nBug: 570656468\nChange-Id: Ic00654959ef8b61e7645a0f55a780d634133a05e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8520941\nCommit-Queue: Samuel Huang \u003chuangs@chromium.org\u003e\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1726736}\n\n--\n\nwpt-commits: cd8bb9af3efb5feeb179fe09e5886937e530cb3a\nwpt-pr: 64203\n", "files": ["testing/web-platform/tests/selection/longpress-selection.html"], "git_node": "e1947c0a281f24d93bc35d87c7b1e0aa42f400f0", "git_parents": ["cfb82c1643f58e04ac98152e2e4b3cd4d6b3f808"], "node": "5d3f5ced7eaea0c22dbf110d7c28898eb1a4868e", "parents": ["7da2cba136fd2ff4e4f811358116ab0588fca1c4"], "tags": []}, {"author": "Koji Ishii \u003ckojii@chromium.org\u003e", "branch": "default", "desc": "Bug 2084977 [wpt PR 63950] - [iframe] Lock ICB size only for responsive axis, a=testonly\n\nAutomatic update from web-platform-tests\n[iframe] Lock ICB size only for responsive axis\n\nThis patch updates `NaturalSizeLayoutScope` to query\n`FrameOwner::GetResponsiveSizing()` and lock only the physical axis\ncontrolled by `frame-sizing`, keeping the current layout size for the\northogonal axis.\n\nGuard this behavior behind the `ResponsiveIframesSingleAxisIcb` runtime\nfeature flag, enabled by default as a kill switch.\n\nBug: 565383556\nChange-Id: Id31196f33566500183d7e081751f31aea8473120\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8597128\nCommit-Queue: Koji Ishii \u003ckojii@chromium.org\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1726820}\n\n--\n\nwpt-commits: 84dd53268b3fa142337931b8ab4706e59ffc8d12\nwpt-pr: 63950\n", "files": ["testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-icb.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/responsive-iframe-icb.html"], "git_node": "d8b39e46d815970f345d6ca3d173604d3d285b3a", "git_parents": ["e1947c0a281f24d93bc35d87c7b1e0aa42f400f0"], "node": "299928ccc86803c52d19ffb57ffd9ad78b79ff56", "parents": ["5d3f5ced7eaea0c22dbf110d7c28898eb1a4868e"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2087349 [wpt PR 64219] - Fix inconsistent subpixel snapping in checkbox painting, a=testonly\n\nAutomatic update from web-platform-tests\nFix inconsistent subpixel snapping in checkbox painting\n\nTheme parts snapped their paint rect with ToPixelSnappedRect(), which\nrounds both edges, so a fractional-size checkbox or radio painted one\npixel larger or smaller depending on where it sat on the pixel grid:\nresizing a window made some of a row of equally sized checkboxes\nvisibly change size while others stayed put. Round the size of those\ntwo parts on its own instead, in rendering coordinates, so the painted\nsize only depends on the layout size. Whole-pixel controls, i.e. the\ncommon case, are unaffected, and other theme parts keep snapping both\nedges so they stay flush with adjacent boxes.\n\nBehind the default-on ConsistentFormControlPaintSnapping kill switch.\n\nBug: 41288048\nChange-Id: I47cd6c981397e15964887c69015964357052825e\nInclude-Ci-Only-Tests: true\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8649429\nAuto-Submit: Helmut Januschka \u003chelmut@januschka.com\u003e\nCommit-Queue: Stephen Chenney \u003cschenney@chromium.org\u003e\nReviewed-by: Stephen Chenney \u003cschenney@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1726944}\n\n--\n\nwpt-commits: 0b079118622f8f57274bbaba18d4eca5bf9ad5c0\nwpt-pr: 64219\n", "files": ["testing/web-platform/tests/html/rendering/widgets/input-checkbox-subpixel-paint-size-ref.html", "testing/web-platform/tests/html/rendering/widgets/input-checkbox-subpixel-paint-size.html"], "git_node": "0e7ac4990a2d03f9ff9686139c9061fefa08688d", "git_parents": ["d8b39e46d815970f345d6ca3d173604d3d285b3a"], "node": "9f95bcaad031eb71a538725f3705a07832f9eaee", "parents": ["299928ccc86803c52d19ffb57ffd9ad78b79ff56"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087349 [wpt PR 64219] - Update wpt metadata, a=testonly\n\nwpt-pr: 64219\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/rendering/widgets/button-layout/input-fragmentation-crash.html.ini", "testing/web-platform/meta/html/rendering/widgets/input-checkbox-subpixel-paint-size.html.ini"], "git_node": "10caf827131987abd6de4f623e904ec24426c928", "git_parents": ["0e7ac4990a2d03f9ff9686139c9061fefa08688d"], "node": "cedbcb354910a9cd39454a78f485b285039e72eb", "parents": ["9f95bcaad031eb71a538725f3705a07832f9eaee"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2087351 [wpt PR 64216] - Clear selection on range slider press to fix slider drag, a=testonly\n\nAutomatic update from web-platform-tests\nClear selection on range slider press to fix slider drag\n\nBox-selecting across a range input and then dragging it started a\nselection drag instead of moving the thumb, because the press sits\ninside the selection. Clear the selection in StartDragging() when it\ncovers the input, which covers both the thumb press and the track\npress; selections that do not cover the input are left alone.\n\nBug: 40796813\nChange-Id: Iafda8176af635e1b3992dbb9f61821ab61af35b2\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8625727\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1727011}\n\n--\n\nwpt-commits: 7269b0c6fb011c8167d2767f81215aa8f39c4ebb\nwpt-pr: 64216\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-input-element/range-drag-after-selection.html"], "git_node": "c67d497f80dd60afeff2e51b777514c6a3ba044e", "git_parents": ["10caf827131987abd6de4f623e904ec24426c928"], "node": "7cdc26b3eb4532afb349d140040669e0efb320c9", "parents": ["cedbcb354910a9cd39454a78f485b285039e72eb"], "tags": []}, {"author": "David Liu \u003clcdavid@google.com\u003e", "branch": "default", "desc": "Bug 2087352 [wpt PR 64220] - [scroll-snap] Apply the multicol scroll origin to ::column snap areas, a=testonly\n\nAutomatic update from web-platform-tests\n[scroll-snap] Apply the multicol scroll origin to ::column snap areas\n\nA snap area rect is mapped to the snap container with\nkIgnoreScrollOffset, which adds the scroll origin of each scroll\ncontainer the mapping steps into. For a normal snap area, the mapping\nstarts at the snap area, inside the scroll container. For a ::column,\nit starts at the multicol container itself, so if the multicol\ncontainer is a scroll container, its scroll origin is never added.\n\nIn RTL, the scroll origin is non-zero, so every column snap position\nwas off by -ScrollOrigin() and clamped to the far end: a multicol\ncarousel opened on its last column and always snapped back to it.\n\nBug: 576762163\nChange-Id: I7cf2e3dffd6e891bd5841fe6f3be3be9f0a900e0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8639029\nCommit-Queue: David Liu \u003clcdavid@google.com\u003e\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1727098}\n\n--\n\nwpt-commits: d5375db28bf2a1dd1ead39ea147d067175e908c9\nwpt-pr: 64220\n", "files": ["testing/web-platform/tests/css/css-scroll-snap/snap-to-column-scroll-origin.html"], "git_node": "e03438f8328fa2ad4236fcbc1c7f580c288b5a53", "git_parents": ["c67d497f80dd60afeff2e51b777514c6a3ba044e"], "node": "3b08ebb01ccd105245f792f8b50be2a41800c17c", "parents": ["7cdc26b3eb4532afb349d140040669e0efb320c9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087352 [wpt PR 64220] - Update wpt metadata, a=testonly\n\nwpt-pr: 64220\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-scroll-snap/snap-to-column-scroll-origin.html.ini"], "git_node": "26b79dfcbe16d1f06df03d9a7fb9de0b49c64e70", "git_parents": ["e03438f8328fa2ad4236fcbc1c7f580c288b5a53"], "node": "08eb205fc97d81fbcae5ea429057ee086f999733", "parents": ["3b08ebb01ccd105245f792f8b50be2a41800c17c"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2080330 [wpt PR 63464] - Deflake orthogonal-parent-shrink-to-fit-* by waiting for Ahem, a=testonly\n\nAutomatic update from web-platform-tests\nDeflake orthogonal-parent-shrink-to-fit-* by waiting for Ahem (#63464)\n\nTests in `wpt/css/css-writing-modes/orthogonal-parent-shrink-to-fit-*`\nare flaky due to not waiting for Ahem to load. The flakiness is\nconsistently reproducible on several of these tests without this patch\nand goes away with this fix, which waits for the font to be ready.\n\nExamples of flakiness:\nhttps://ci.chromium.org/ui/test/chromium/%3A%2F%2F%5C%3Aheadless_shell_wpt!webtest%3A%3Aexternal%2Fwpt%2Fcss%2Fcss-writing-modes%23orthogonal-parent-shrink-to-fit-001.html\n\nBug: 568337130\nChange-Id: Ifc98ea432fef1bf02386566f2148cffd4d493b58\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8539949\nAuto-Submit: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCr-Commit-Position: refs/heads/main@{#1715383}\n\nCo-authored-by: Philip Rogers \u003cpdr@chromium.org\u003e\n--\n\nwpt-commits: 225a0ae402bb04c2fe9449611b36a2ecb1e5ae47\nwpt-pr: 63464\n", "files": ["testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-002.html"], "git_node": "78dfd19a71a7b0d1c31398e8282a02bf2a0dd901", "git_parents": ["26b79dfcbe16d1f06df03d9a7fb9de0b49c64e70"], "node": "27e878bdb8ad11b7fc36055a39a64440e1c6fce0", "parents": ["08eb205fc97d81fbcae5ea429057ee086f999733"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080330 [wpt PR 63464] - Update wpt metadata, a=testonly\n\nwpt-pr: 63464\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-writing-modes/bidi-inline-fragment-crash.html.ini"], "git_node": "186f7c60c2e2057687e73ce752fb2eaef1f2c960", "git_parents": ["78dfd19a71a7b0d1c31398e8282a02bf2a0dd901"], "node": "c26ad84bbaf63fb5952eef247f259bc416675b04", "parents": ["27e878bdb8ad11b7fc36055a39a64440e1c6fce0"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2081279 [wpt PR 63592] - [Sanitizer] Sanitize is= attribute on document element., a=testonly\n\nAutomatic update from web-platform-tests\n[Sanitizer] Sanitize is= attribute on document element. (#63592)\n\nIn Document.parseHTML (and Document.parseHTMLUnsafe) treats the document\nelement seperately and has a seperate code path for it\n(HTMLContrsuctionSite::InsertHMLStartTagInBody). This code path was\noverlooked in crrev.com/c/7883146 and now also checks whether the is=\nattribute is allowed on this element.\n\nFixed: 571722742\nChange-Id: If99538f13a6b741f28c50db1b0001d8cf147c342\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8559025\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCommit-Queue: Daniel Vogelheim \u003cvogelheim@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1717444}\n\nCo-authored-by: Daniel Vogelheim \u003cvogelheim@chromium.org\u003e\n--\n\nwpt-commits: c861cd3a610c3b7141e5c4543be8c3d89189b6ff\nwpt-pr: 63592\n", "files": ["testing/web-platform/tests/sanitizer-api/sanitizer-custom-elements-is.html"], "git_node": "fb96815628725d5bd6fc9377ff774644f422cb00", "git_parents": ["186f7c60c2e2057687e73ce752fb2eaef1f2c960"], "node": "c9aa31f260af1cc9b2b321cb36cd481e2821c47c", "parents": ["c26ad84bbaf63fb5952eef247f259bc416675b04"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2087374 [wpt PR 64084] - Use the dimension attribute aspect ratio for srcset source selection, a=testonly\n\nAutomatic update from web-platform-tests\nUse the dimension attribute aspect ratio for srcset source selection\n\nThird part of https://github.com/whatwg/html/pull/13053, behind the\n`SrcsetTwoDimensionalSizes` runtime flag.\n\nFor srcset candidates without an `h` descriptor, use the dimension\nattribute aspect ratio (from the `width`/`height` attributes of the\n`\u003cimg\u003e`, or of the `\u003csource\u003e` when it has one of them) as the source\naspect ratio when computing the source concrete width for a\ntwo-dimensional size. This is also applied in the preload scanner.\n\nSince these attributes now affect source selection, changing them on an\n`\u003cimg\u003e` or a previous sibling `\u003csource\u003e` is a relevant mutation, so re-run\nsource selection. To keep that re-selection side-effect free when the\nselected URL did not change, `SelectSourceURL()` now only resets the\nlayout disposition when it actually updates the image loader.\n\nBug: 572724710\nChange-Id: I2317a0b452ef8f0ca2438c41d8574312d19b9135\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8563321\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1724591}\n\n--\n\nwpt-commits: 41a91b97e0ee996c8d9e6f9ac9beda5f014ab7cf\nwpt-pr: 64084\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-img-element/sizes/sizes-2d.tentative.html", "testing/web-platform/tests/html/semantics/embedded-content/the-img-element/sizes/sizes-auto-2d.tentative.html"], "git_node": "b4a215d9e670c3f5cb76683708e1501637191144", "git_parents": ["fb96815628725d5bd6fc9377ff774644f422cb00"], "node": "32041176a193e436160930d3e4d7c1cbcebcab11", "parents": ["c9aa31f260af1cc9b2b321cb36cd481e2821c47c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087374 [wpt PR 64084] - Update wpt metadata, a=testonly\n\nwpt-pr: 64084\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/the-img-element/sizes/sizes-2d.tentative.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-img-element/sizes/sizes-auto-2d.tentative.html.ini"], "git_node": "2a43ebd0a07bc657f7093fb5f5b0a012f61838c3", "git_parents": ["b4a215d9e670c3f5cb76683708e1501637191144"], "node": "e9a0d13b79ef76ef5104f1c48a582401bd727b77", "parents": ["32041176a193e436160930d3e4d7c1cbcebcab11"], "tags": []}, {"author": "Hyowon Kim \u003chyowon@igalia.com\u003e", "branch": "default", "desc": "Bug 2087380 [wpt PR 64048] - Fix before-as-flex-container WPT test, a=testonly\n\nAutomatic update from web-platform-tests\nFix before-as-flex-container WPT test\n\n\"A B\" forms a single anonymous flex item, not two separate items.\nUse flex-end on both axes and update the reference accordingly.\n\nBug: 442769076\nChange-Id: Ia4226d13535a7df27338b6affcba10dc5521fbee\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8619573\nCommit-Queue: Hyowon Kim \u003chyowon@igalia.com\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1725573}\n\n--\n\nwpt-commits: b78f759548a2ffe95aefc73f60b651d0072db035\nwpt-pr: 64048\n", "files": ["testing/web-platform/tests/css/css-pseudo/before-as-flex-container-ref.html", "testing/web-platform/tests/css/css-pseudo/before-as-flex-container.html"], "git_node": "a96966035607f810bdd897d7fba98c25c3b81f79", "git_parents": ["2a43ebd0a07bc657f7093fb5f5b0a012f61838c3"], "node": "60057733800ab51ef9f2557db8476cd27f3612e6", "parents": ["e9a0d13b79ef76ef5104f1c48a582401bd727b77"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087380 [wpt PR 64048] - Update wpt metadata, a=testonly\n\nwpt-pr: 64048\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-pseudo/before-as-flex-container.html.ini"], "git_node": "ff525065395045a943a13bec9cbb4e0bbd167b9e", "git_parents": ["a96966035607f810bdd897d7fba98c25c3b81f79"], "node": "ef7ae362c4f3bc2b7fb4e33f55955253ea8c2874", "parents": ["60057733800ab51ef9f2557db8476cd27f3612e6"], "tags": []}, {"author": "Hyowon Kim \u003chyowon@igalia.com\u003e", "branch": "default", "desc": "Bug 2087383 [wpt PR 64024] - Match .class selectors on elements in unknown XML namespaces, a=testonly\n\nAutomatic update from web-platform-tests\nMatch .class selectors on elements in unknown XML namespaces\n\nThe rule collector and selector filter only checked class names when\nIsStyledElement() was true, so `.foo` did not match elements in other\nXML namespaces. This CL removes the IsStyledElement() check in both\nplaces.\n\nBug: 41276987\nChange-Id: I014c55b9217fcc8eb06bfa1cd9328c3995d38e39\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8577217\nCommit-Queue: Hyowon Kim \u003chyowon@igalia.com\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1725589}\n\n--\n\nwpt-commits: 5c478262a383e1bbe3c35f9c74204738e1ad6bc0\nwpt-pr: 64024\n", "files": ["testing/web-platform/tests/css/selectors/xml-class-selector-combinators.xml"], "git_node": "8b906f59e0e2049707f6c66a2191260a095a6f88", "git_parents": ["ff525065395045a943a13bec9cbb4e0bbd167b9e"], "node": "8766086c7f11fb23810e354482760553f4e8f430", "parents": ["ef7ae362c4f3bc2b7fb4e33f55955253ea8c2874"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2087385 [wpt PR 64228] - Harden Element attribute mutation methods against re-entrant changes, a=testonly\n\nAutomatic update from web-platform-tests\nHarden Element attribute mutation methods against re-entrant changes\n\nElement::WillModifyAttribute() can run script both by pausing in the\ndebugger (via probe::WillModifyDOMAttr) and when UpdateName() lazily\ninitializes a frame's WindowProxy and synchronously invokes a\npage-defined setter (e.g. via chrome.loadTimes). If script mutates the\nelement's attributes and reallocates or re-indexes\nUniqueElementData::attribute_vector_, references and indices into the\nattribute storage acquired before WillModifyAttribute() become invalid.\n\nWhile https://crrev.com/c/8510124 already hardened\nSetAttributeInternal() and RemoveAttributeInternal(), this CL:\n1. Checks in AppendAttributeInternal() whether WillModifyAttribute()\n   already added the attribute re-entrantly before appending.\n2. Copies id_attr and class_attr by value in DidMoveToNewDocument()\n   before calling SetIdAttribute() / setAttribute().\n3. Updates comments in SetAttributeInternal() and\n   RemoveAttributeInternal() and adds regression tests.\n\nBug: 576203565, 575317938\nChange-Id: Ic63c0b5a15568a9c8d2331e7b49dde89e36b5283\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8633017\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Mason Freed \u003cmasonf@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1727352}\n\n--\n\nwpt-commits: 08f19ee263d9c0989f382e0b67de17d88e67643e\nwpt-pr: 64228\n", "files": ["testing/web-platform/tests/html/dom/documents/dom-tree-accessors/nameditem-setattribute-attr-mutation.html"], "git_node": "6e76c2e0f7180602da066fb9b00770b208a810aa", "git_parents": ["8b906f59e0e2049707f6c66a2191260a095a6f88"], "node": "f22e359849b85ccd06b3386339913acc7e145151", "parents": ["8766086c7f11fb23810e354482760553f4e8f430"], "tags": []}, {"author": "Alex Nahas \u003calexmnahas@gmail.com\u003e", "branch": "default", "desc": "Bug 2078012 [wpt PR 63240] - [WebMCP] Use HTTPS targets for declarative form tests, a=testonly\n\nAutomatic update from web-platform-tests\n[WebMCP] Use HTTPS targets for declarative form tests (#63240)\n\n* [WebMCP] Use HTTPS targets for declarative form tests\n\nSafari shows a native insecure-form confirmation when these HTTPS tests submit to about:blank. The sheet can block WebDriver window cleanup, causing WPT to discard completed subtest results.\n\nUse the existing same-origin /common/blank.html resource so submissions remain on HTTPS. Keep iframe targets and all test assertions unchanged.\n\n* [WebMCP] Use HTTPS targets for newer declarative form tests\n--\n\nwpt-commits: 6275ce039362b0e256e40b21d6c6f0dda3fa2481\nwpt-pr: 63240\n", "files": ["testing/web-platform/tests/webmcp/declarative/executeTool-flexible-types.https.html", "testing/web-platform/tests/webmcp/declarative/executeTool-no-autosubmit.https.html", "testing/web-platform/tests/webmcp/declarative/executeTool-pseudo-classes.https.html", "testing/web-platform/tests/webmcp/declarative/executeTool-respondWith-reject.https.html", "testing/web-platform/tests/webmcp/declarative/executeTool-respondWith.https.html", "testing/web-platform/tests/webmcp/declarative/execute_tool_change_event.https.html", "testing/web-platform/tests/webmcp/declarative/execute_tool_submit_from_js.https.html", "testing/web-platform/tests/webmcp/declarative/form_removal_submit_crash.https.html", "testing/web-platform/tests/webmcp/declarative/select-multiple-events.https.html"], "git_node": "60f440c422cbf1b90c039c4f7893451c9e388e30", "git_parents": ["6e76c2e0f7180602da066fb9b00770b208a810aa"], "node": "53dbf95a04ef4d54d4b4cd64829d661d5a525186", "parents": ["f22e359849b85ccd06b3386339913acc7e145151"], "tags": []}, {"author": "Gaston Rodriguez \u003cgastonr@microsoft.com\u003e", "branch": "default", "desc": "Bug 2087652 [wpt PR 64223] - Automate drag and drop remove/ tests, a=testonly\n\nAutomatic update from web-platform-tests\nAutomate drag and drop remove/ tests\n\nThis CL updates tests 002 to 008 in the WPT dnd/remove/ directory to run\nautomatically. The new tests follow the model in test 001 introduced in\nCL:7748202.\n\nBug: 452406602\nChange-Id: Ia22b73167d499347a9d905a96e9f6c3d92f4b91b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8569674\nCommit-Queue: Gaston Rodriguez \u003cgastonr@microsoft.com\u003e\nReviewed-by: Mustaq Ahmed \u003cmustaq@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1727160}\n\n--\n\nwpt-commits: 79d042b864845ab74c2b2337dd3c7458dc365f44\nwpt-pr: 64223\n", "files": ["testing/web-platform/tests/html/editing/dnd/remove/001.html", "testing/web-platform/tests/html/editing/dnd/remove/002.html", "testing/web-platform/tests/html/editing/dnd/remove/002.xhtml", "testing/web-platform/tests/html/editing/dnd/remove/003.html", "testing/web-platform/tests/html/editing/dnd/remove/003.xhtml", "testing/web-platform/tests/html/editing/dnd/remove/004.html", "testing/web-platform/tests/html/editing/dnd/remove/004.xhtml", "testing/web-platform/tests/html/editing/dnd/remove/005.html", "testing/web-platform/tests/html/editing/dnd/remove/005.xhtml", "testing/web-platform/tests/html/editing/dnd/remove/006.html", "testing/web-platform/tests/html/editing/dnd/remove/006.xhtml", "testing/web-platform/tests/html/editing/dnd/remove/007.html", "testing/web-platform/tests/html/editing/dnd/remove/007.xhtml", "testing/web-platform/tests/html/editing/dnd/remove/008.html", "testing/web-platform/tests/html/editing/dnd/remove/008.xhtml", "testing/web-platform/tests/html/editing/dnd/remove/support/drag-source-removal.js", "testing/web-platform/tests/html/editing/dnd/resources/test-helper.js"], "git_node": "63b4f9a7d76beb8043b2057fcfc4a707fc3c8b4f", "git_parents": ["60f440c422cbf1b90c039c4f7893451c9e388e30"], "node": "fa38404a76b1dd8d969db51f1908621fa5e0fe4d", "parents": ["53dbf95a04ef4d54d4b4cd64829d661d5a525186"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087652 [wpt PR 64223] - Update wpt metadata, a=testonly\n\nwpt-pr: 64223\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/editing/dnd/remove/002.html.ini", "testing/web-platform/meta/html/editing/dnd/remove/003.html.ini", "testing/web-platform/meta/html/editing/dnd/remove/004.html.ini", "testing/web-platform/meta/html/editing/dnd/remove/005.html.ini", "testing/web-platform/meta/html/editing/dnd/remove/006.html.ini", "testing/web-platform/meta/html/editing/dnd/remove/007.html.ini", "testing/web-platform/meta/html/editing/dnd/remove/008.html.ini"], "git_node": "d3c449929f8e79c8805cf309768cd69abe766f1f", "git_parents": ["63b4f9a7d76beb8043b2057fcfc4a707fc3c8b4f"], "node": "910f45e85ed52c9566888038805d6707418f3bcf", "parents": ["fa38404a76b1dd8d969db51f1908621fa5e0fe4d"], "tags": []}, {"author": "Jonathan Lee \u003cjonathan-j-lee@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087419 [wpt PR 64239] - [chromium-bidi] Fix lost channel messages sent right before navigation, a=testonly\n\nAutomatic update from web-platform-tests\n[chromium-bidi] Fix lost channel messages sent right before navigation (#64239)\n\n- Deliver all `script.message` events when a page sends multiple channel\n  messages in the same task right before navigating away.\n- Previously, `ChannelProxy` kept only one `Runtime.callFunctionOn`\n  `getMessage` request in flight at a time, so a second message queued\n  right before navigation was lost when the execution context was\n  destroyed before the next poll arrived.\n- Pipeline multiple pending `getMessage` requests and track waiting\n  resolvers in a FIFO queue so back-to-back messages resolve in-flight\n  CDP calls before navigation commits.\n\nBug: 572278423\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nChange-Id: I8c6e5d237a07a58b52d29854858358ca612d1eee\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8575201\nCommit-Queue: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nReviewed-by: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1719624}\n\nCo-authored-by: Maksim Sadym \u003csadym@chromium.org\u003e\n--\n\nwpt-commits: e6d594d06f7f4aa504e5e3c83ba588b1a1683df1\nwpt-pr: 64239\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/script/add_preload_script/arguments.py"], "git_node": "54fdf954e4b417070cbc73bbeb1c440ec6ef10d6", "git_parents": ["d3c449929f8e79c8805cf309768cd69abe766f1f"], "node": "6dff648ff37f586c263be61d3a9ae76ecbc49589", "parents": ["910f45e85ed52c9566888038805d6707418f3bcf"], "tags": []}, {"author": "Martin Robinson \u003cmrobinson@igalia.com\u003e", "branch": "default", "desc": "Bug 2087423 [wpt PR 64224] - layout: Do not paint collapsed box fragments, a=testonly\n\nAutomatic update from web-platform-tests\nlayout: Do not paint collapsed box fragments\n\nThese are skipped during stacking context tree constructions, so\npainting them can mean that they have stale data. We should just skip\nthem in this traversal.\n\nSigned-off-by: Martin Robinson \u003cmrobinson@igalia.com\u003e\n\n--\n\nwpt-commits: 3e7ed2531bc4d606bf5cc92ed4394bade71fce69\nwpt-pr: 64224\n", "files": ["testing/web-platform/tests/css/css-tables/visibility-collapse-colgroup-crash.html"], "git_node": "4d1c8b629cd14e0795464e93e7e4ab1b91948348", "git_parents": ["54fdf954e4b417070cbc73bbeb1c440ec6ef10d6"], "node": "22020e1e1d5c7eed0079541a204e221a115d9b0f", "parents": ["6dff648ff37f586c263be61d3a9ae76ecbc49589"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2085165 [wpt PR 63961] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328274, a=testonly\n\nAutomatic update from web-platform-tests\nA frame that a replace navigation moves to another process has no navigation API entries\n\nWith site isolation, a subframe navigation that doesn't add a session history\nentry, such as one from location.replace(), updates the frame's current history\nitem. When the navigation moves the frame to another process, that process has\nno history item for the frame, and as the frame's parent is in another process,\nit doesn't create one either. So the new document's navigation.entries() was\nempty and navigation.activation was null. Since 324264@main this also happens\nfor navigation.navigate() with history: \"replace\".\n\nFor a main frame, the UI process gives the new process the current history item\nbefore such a load, with a SetCurrentHistoryItemForReattach message. For a\nsubframe it now passes the item in the LoadParameters of the load, so the load\nupdates the frame's item as it does when the frame stays in its process, but\nonly when the frame moves to another process. Neither sends the replaced\ndocument's children anymore, and for a document of another origin both only send\nthe item's identity and the flags that describe the entry, as\nHistoryController::updateCurrentItem() resets the rest. So the replaced entry\nalso no longer keeps the old document's scroll position, form state, and policy\ncontainer. Using LoadParameters for the main frame will happen in a subsequent\nchange.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328274\n\n--\n\nwpt-commits: c243db3331f639aaa0f0fee4023cffc924e9820e\nwpt-pr: 63961\n", "files": ["testing/web-platform/tests/html/browsers/history/the-location-interface/location-replace-cross-site.html", "testing/web-platform/tests/html/document-isolation-policy/location-replace-keeps-entry.tentative.https.html", "testing/web-platform/tests/navigation-api/navigation-methods/navigate-replace-cross-site.html"], "git_node": "d651b688bb934da8a22ea76317eb64ce82422ca3", "git_parents": ["4d1c8b629cd14e0795464e93e7e4ab1b91948348"], "node": "c2c90a4d0bc306db7ba3faf01670ec831e195deb", "parents": ["22020e1e1d5c7eed0079541a204e221a115d9b0f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085165 [wpt PR 63961] - Update wpt metadata, a=testonly\n\nwpt-pr: 63961\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/document-isolation-policy/location-replace-keeps-entry.tentative.https.html.ini"], "git_node": "d345d3c52f660148f33f554865de4f39aa2c2595", "git_parents": ["d651b688bb934da8a22ea76317eb64ce82422ca3"], "node": "96cdc84dbc23eff8289a3896ed85c1a164707116", "parents": ["c2c90a4d0bc306db7ba3faf01670ec831e195deb"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2087453 [wpt PR 64145] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328736, a=testonly\n\nAutomatic update from web-platform-tests\nA \u003cselect\u003e whose form state is restored keeps showing the old option\n\nA \u003cselect\u003e restores its form state, for instance when going back to a page, at\nits end tag, or at the end tag of its form if it has one.\nHTMLSelectElement::restoreFormControlState() changed which options are selected,\nbut didn't update \u003cselectedcontent\u003e descendants or the button text of a native\ndrop-down. \u003cselectedcontent\u003e kept showing the option selected during parsing,\nand so did the button text if it was rendered before the state was restored.\n\nLike reset(), restoreFormControlState() now invalidates the button text and\nupdates \u003cselectedcontent\u003e.\n\nselectedcontent-restore.optional.html timed out before checking\n\u003cselectedcontent\u003e. WebKit only adds a session history entry for a form\nsubmission that script triggers in a frame during a user gesture, which\ntest_driver.bless() doesn't provide. The test now submits from a click handler\nand is no longer skipped. Its second subtest still fails: WebKit restores the\nform before the script in the frame adds the named control that is part of\nthe form's key.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328736\n\n--\n\nwpt-commits: b93db7e18058b04542085de2939e787629999944\nwpt-pr: 64145\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/selectedcontent-restore.optional.html"], "git_node": "cf0f8ed16a56f439926178e12c1cd2749c7d9432", "git_parents": ["d345d3c52f660148f33f554865de4f39aa2c2595"], "node": "125e5f492e63835cfca1c58a68561ad7e2026c7b", "parents": ["96cdc84dbc23eff8289a3896ed85c1a164707116"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2087457 [wpt PR 64205] - Test option and optgroup boxes in base appearance select elements, a=testonly\n\nAutomatic update from web-platform-tests\nTest option and optgroup boxes in base appearance select elements\n\nTest getBoundingClientRect() and getClientRects() of option and optgroup\nelements in a base appearance list box and picker. Each has one box, laid out in\norder and found by hit testing, and the boxes are up to date right after changes\nthat affect them, including opening and closing the picker and switching\nappearance.\n\n--\nCheck that the boxes exist before comparing them right after a change\n\nOtherwise these two tests pass where options have no boxes at all.\n\n--\n\nwpt-commits: e17d5413951075317c718c6e3b9196068f2b6f41, 01cb245c0a2e25cada15de93c2221f294894eba0\nwpt-pr: 64205\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select-listbox/select-listbox-option-optgroup-client-rects.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-picker-option-optgroup-client-rects.html"], "git_node": "9800d2f30911f8c4c6b974170def2affed5a4f46", "git_parents": ["cf0f8ed16a56f439926178e12c1cd2749c7d9432"], "node": "6c3aa671a062c9239e48539bdd4a7df273b908b7", "parents": ["125e5f492e63835cfca1c58a68561ad7e2026c7b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087457 [wpt PR 64205] - Update wpt metadata, a=testonly\n\nwpt-pr: 64205\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select-listbox/select-listbox-option-optgroup-client-rects.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-multiple-keydown-crash.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-picker-option-optgroup-client-rects.html.ini"], "git_node": "bc35cdbc136d9eff72d7f1ab086682f19ce13693", "git_parents": ["9800d2f30911f8c4c6b974170def2affed5a4f46"], "node": "5ef5b60760a81832148c75ccdfb46a546ee3a7c6", "parents": ["6c3aa671a062c9239e48539bdd4a7df273b908b7"], "tags": []}, {"author": "Martin Robinson \u003cmrobinson@igalia.com\u003e", "branch": "default", "desc": "Bug 2087459 [wpt PR 64088] - layout: Create non-transform stacking contexts with `PrimitiveFlags::default`, a=testonly\n\nAutomatic update from web-platform-tests\nlayout: Create non-transform stacking contexts with `PrimitiveFlags::default`\n\nCreating these with `PrimitiveFlags::empty` or the primitive flags from\nthe style means that backface visiblity might be set to false. These\nintermediary stacking contexts are really \"pass-through\" so they\nshouldn't be affecting backface visibility at all.\n\nSigned-off-by: Martin Robinson \u003cmrobinson@igalia.com\u003e\n\n--\n\nwpt-commits: e619a178967af9b77a76bbaa2aac7eb2eee85552\nwpt-pr: 64088\n", "files": ["testing/web-platform/tests/css/css-transforms/backface-visibility-hidden-background-blend-mode.html", "testing/web-platform/tests/css/css-transforms/backface-visibility-hidden-filter.html"], "git_node": "8f8161fc156e9e583d1df27cb1243fc43fb9fd0e", "git_parents": ["bc35cdbc136d9eff72d7f1ab086682f19ce13693"], "node": "8f1281ae276c5f0b56bfcb6577d9404f97b1cdd5", "parents": ["5ef5b60760a81832148c75ccdfb46a546ee3a7c6"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2087508 [wpt PR 64229] - Invalidate descendants when forced stacking context reasons change, a=testonly\n\nAutomatic update from web-platform-tests\nInvalidate descendants when forced stacking context reasons change\n\nThis patch adds ComputedStyle::AllowsZIndexOnChildren() and\nIsInZIndexAllowingDisplay (mirroring BlockifiesChildren() and\nIsInBlockifyingDisplay) to invalidate descendant style when an\nelement's display changes whether layout children allow z-index and\nforce a stacking context. This handles both container display changes\n(e.g., math to flex) and display changes on display: contents\nintermediaries (e.g., contents to block inside -webkit-box).\n\nStyle invalidation is needed because AllowsZIndex and\nForcesStackingContext are computed on ComputedStyle from the layout\nparent, and full descendant invalidation is needed because layout\nchildren can be deeper descendants via display: contents.\n\nThis fixes the root-cause of a test flake on\nHTMLDomScenarioRunner.MathMLInHTML.\n\nFixed: 575912180\nChange-Id: If78a039a2ab6f67499b6521e66b89d275d6f8c43\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8615310\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1727445}\n\n--\n\nwpt-commits: 572be6c6d603f8f612ebb7295920e3790895223d\nwpt-pr: 64229\n", "files": ["testing/web-platform/tests/compat/webkit-box-z-index-002.html", "testing/web-platform/tests/css/css-flexbox/flex-item-z-ordering-003.html", "testing/web-platform/tests/css/css-flexbox/flex-item-z-ordering-004.html"], "git_node": "facb5dd93928743cf5322b25cca48a2b4ce50b85", "git_parents": ["8f8161fc156e9e583d1df27cb1243fc43fb9fd0e"], "node": "50bbaadf035d702f5d64dac7e4ba4cb8ccec5df8", "parents": ["8f1281ae276c5f0b56bfcb6577d9404f97b1cdd5"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087508 [wpt PR 64229] - Update wpt metadata, a=testonly\n\nwpt-pr: 64229\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-flexbox/flex-item-z-ordering-003.html.ini", "testing/web-platform/meta/css/css-flexbox/flex-item-z-ordering-004.html.ini"], "git_node": "96b2902e39536da58fe84d05cb234fd33f9b13eb", "git_parents": ["facb5dd93928743cf5322b25cca48a2b4ce50b85"], "node": "a2baefba8db8c551cce7851e78da1d5430bc9438", "parents": ["50bbaadf035d702f5d64dac7e4ba4cb8ccec5df8"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2087524 [wpt PR 64236] - [html-in-canvas] Strip tainted filters when painting box contents, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Strip tainted filters when painting box contents\n\nThis patch adds `PropertyTreeStateOrAlias::StripTaintedFilters` and\nshares it between `ScopedSVGPaintState::ApplyPaintPropertyState` and\n`ScopedBoxContentsPaintState::AdjustForBoxContents`, preventing box\ndescendants such as transformed SVG `\u003ctext\u003e` (`LayoutSVGText`) in\nnon-drawable SVG resources from re-entering an ancestor's tainted\nfilter effect via `ContentsProperties()` when\n`PaintFlag::kReadBackAllowedRendering` is set.\n\nFixed: 575832235\nChange-Id: Id6058d7e1554dcf49635d13fcc2039b77c2870a5\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8639478\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1727547}\n\n--\n\nwpt-commits: 5d13573aea108a72a968e8a2875ec32ade343f80\nwpt-pr: 64236\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/svg/svg-pattern-filter-transformed-text.tentative.https.sub.html"], "git_node": "f5c67346c7364a98f300d665cf0c6e07a8094c85", "git_parents": ["96b2902e39536da58fe84d05cb234fd33f9b13eb"], "node": "a2dd4d04b63a465e25488217c75abd35463e55fa", "parents": ["a2baefba8db8c551cce7851e78da1d5430bc9438"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087524 [wpt PR 64236] - Update wpt metadata, a=testonly\n\nwpt-pr: 64236\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/svg/svg-pattern-filter-transformed-text.tentative.https.sub.html.ini"], "git_node": "f9b32d6dfc94e9d4b16dd8400a984be4c4ce3562", "git_parents": ["f5c67346c7364a98f300d665cf0c6e07a8094c85"], "node": "c59dd24c785be994f7034e46842937b006f08526", "parents": ["a2dd4d04b63a465e25488217c75abd35463e55fa"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2087527 [wpt PR 64237] - [html-in-canvas] Keep drawable subtree flag in SVG hidden containers, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Keep drawable subtree flag in SVG hidden containers\n\nThis patch preserves `is_in_drawable_canvas_subtree` when resetting\n`PaintPropertyTreeBuilderFragmentContext` for SVG hidden containers, so\norigin-tainted filters inside drawable SVG resources are not used.\nData other than `is_in_drawable_canvas_subtree` in fragment_context is\nsafe to reset.\n\nBug: 575832235\nChange-Id: I18879b88a0b261a8c62cb3f991732fbda69757b2\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8638199\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1727550}\n\n--\n\nwpt-commits: 1b91f9cc9edd4a990e62e841aedd0cf6ec5b1bc6\nwpt-pr: 64237\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/svg/svg-pattern-with-feImage-transformed-text.tentative.https.sub.html"], "git_node": "b140abe720c10d74351ad889c708b32dd28ee8c6", "git_parents": ["f9b32d6dfc94e9d4b16dd8400a984be4c4ce3562"], "node": "7770d4f41aae24c1c3bd1b3c17c4efedd9363d93", "parents": ["c59dd24c785be994f7034e46842937b006f08526"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087527 [wpt PR 64237] - Update wpt metadata, a=testonly\n\nwpt-pr: 64237\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/svg/svg-pattern-with-feImage-transformed-text.tentative.https.sub.html.ini"], "git_node": "f689d57bdd4fac68c8ea08fec9d658c1dcb4b12e", "git_parents": ["b140abe720c10d74351ad889c708b32dd28ee8c6"], "node": "68d77a976ac22d9257bd1f0b12e44540b487eda9", "parents": ["7770d4f41aae24c1c3bd1b3c17c4efedd9363d93"], "tags": []}, {"author": "Ari Chivukula \u003carichiv@chromium.org\u003e", "branch": "default", "desc": "Bug 2087528 [wpt PR 64242] - [SVG] Re-paint when reference filters are added/removed, a=testonly\n\nAutomatic update from web-platform-tests\n[SVG] Re-paint when reference filters are added/removed\n\nCurrently, there's an issue with cross-site, in-process frames not\ngetting updates when the applied filter changes.\n\nThis change ensures subtree updates are forced when a reference\nfilter is applied or unapplied.\n\nFixed: 574586896\nChange-Id: I8955c4532043c6f374ddd734c24d7fc1068283c6\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8651864\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nAuto-Submit: Ari Chivukula \u003carichiv@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1727553}\n\n--\n\nwpt-commits: 067af4d21aa9a1ff0e053d57e67cae9824a97931\nwpt-pr: 64242\n", "files": ["testing/web-platform/tests/svg/styling/svg-filter-render-swap-ref.tentative.html", "testing/web-platform/tests/svg/styling/svg-filter-render-swap.tentative.https.html"], "git_node": "54e9909a1c188ecd0bcd63d0dd675c91a6ce5a4c", "git_parents": ["f689d57bdd4fac68c8ea08fec9d658c1dcb4b12e"], "node": "95d1652f389d446d5f5951a1bb2dd9b32dacd6b9", "parents": ["68d77a976ac22d9257bd1f0b12e44540b487eda9"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2087529 [wpt PR 64230] - Fix SVG filter tainting for :visited colors, a=testonly\n\nAutomatic update from web-platform-tests\nFix SVG filter tainting for :visited colors\n\nThis patch updates TaintsOrigin() for feFlood, feDropShadow,\nfeDiffuseLighting, and feSpecularLighting to taint when inside a link\nwhose -internal-visited-flood-color or -internal-visited-lighting-color\ndiffers from the unvisited color, in addition to checking currentColor\ndependencies. These primitives now also read ComputedStyle from\nGetLayoutObject() so display:none primitives with ensured styles do not\nrender or bypass style invalidation.\n\nFor dynamic updates, LayoutSVGFilterPrimitive::StyleDidChange now\ninvalidates the filter chain when :visited tainting or resolved color\nchanges, Canvas2DRecorderContext flushes style and layout before\ndrawing when a CSS filter may contain a url(), and\nCompositorFilterOperations::Clear() properly reset origin tainting.\n\nFixed: 576328037\nChange-Id: I5fabe2bf67ab67e72b896f67bc483f7246270b34\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8623654\nReviewed-by: Stephen Chenney \u003cschenney@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1727602}\n\n--\n\nwpt-commits: 314668a92f15a10af77bbba55ede29f6def54768\nwpt-pr: 64230\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/filters/svg-filter-visited-link-color-taints.html"], "git_node": "8eb3c141313a3dc01ff1bf8d554a79ece01101c9", "git_parents": ["54e9909a1c188ecd0bcd63d0dd675c91a6ce5a4c"], "node": "7a8d63378ca1a337a98e8ac5061acaa26225b28f", "parents": ["95d1652f389d446d5f5951a1bb2dd9b32dacd6b9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087529 [wpt PR 64230] - Update wpt metadata, a=testonly\n\nwpt-pr: 64230\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/filters/svg-filter-visited-link-color-taints.html.ini"], "git_node": "b19671dad896a111dc6803fc9135f1c432adcc89", "git_parents": ["8eb3c141313a3dc01ff1bf8d554a79ece01101c9"], "node": "a808fe2a01a312ddafb448b863c191f68e8152ad", "parents": ["7a8d63378ca1a337a98e8ac5061acaa26225b28f"], "tags": []}, {"author": "dependabot[bot] \u003c49699333+dependabot[bot]@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087531 [wpt PR 64233] - Bump docker/login-action from 4.6.0 to 4.7.0, a=testonly\n\nAutomatic update from web-platform-tests\nBump docker/login-action from 4.6.0 to 4.7.0\n\nBumps [docker/login-action](https://github.com/docker/login-action) from 4.6.0 to 4.7.0.\n- [Release notes](https://github.com/docker/login-action/releases)\n- [Commits](https://github.com/docker/login-action/compare/dbcb813823bdd20940b903addbd779551569679f...81c6f93d4bc991e510b342a00b419b3bb4efc5c6)\n", "files": ["testing/web-platform/tests/.github/workflows/docker.yml"], "git_node": "afaf905c8cabe1264eb984776db57d74397b6a7f", "git_parents": ["b19671dad896a111dc6803fc9135f1c432adcc89"], "node": "ff41fac9e538a779d1d0af00079a9d48e274ae81", "parents": ["a808fe2a01a312ddafb448b863c191f68e8152ad"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2087535 [wpt PR 64235] - [html-in-canvas] Fully update when clearing origin-tainted filters, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Fully update when clearing origin-tainted filters\n\nThis patch forces an isolation-piercing subtree paint property update\nwhen clearing `ObjectPaintProperties` with an origin-tainted filter\n(`Filter()-\u003eFilter()-\u003eOriginTainted()`), matching `UpdateFilter()` and\nsimilar to https://crrev.com/026bad204a461a059d709ad5b81c20f210c6ea78.\n\nWhen an element no longer needs paint properties, `InitPaintProperties`\nclears `ObjectPaintProperties` before `UpdateFilter()` runs. Without\nan isolation-piercing update, descendant effect nodes inside a\n`contain: paint` subtree retain stale `IsInTaintedSubtree()` state\nafter an ancestor's cross-origin filter is removed.\n\nChange-Id: I877bb792a5b363edcb7941f04ea6b00494ee27ec\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8641040\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1727632}\n\n--\n\nwpt-commits: 4d0cdba6d4627abf45f8887c0de803b51b3f0799\nwpt-pr: 64235\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/filtered-div-removed-contain-paint.tentative.https.sub.html"], "git_node": "2b36c76793a5344530645cd13dc42709991f5ec0", "git_parents": ["afaf905c8cabe1264eb984776db57d74397b6a7f"], "node": "833159ce6ba1e6e3a3ea971f7d49c3ed9896af5c", "parents": ["ff41fac9e538a779d1d0af00079a9d48e274ae81"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087535 [wpt PR 64235] - Update wpt metadata, a=testonly\n\nwpt-pr: 64235\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/filtered-div-removed-contain-paint.tentative.https.sub.html.ini"], "git_node": "f4b29384e92ef49f2ecfd34532dcd6946f62618a", "git_parents": ["2b36c76793a5344530645cd13dc42709991f5ec0"], "node": "e3470eaeb969d4aa760942c98f265ef2a406d10a", "parents": ["833159ce6ba1e6e3a3ea971f7d49c3ed9896af5c"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2087658 [wpt PR 64027] - pywebsocket3: work on Python 3.15, a=testonly\n\nAutomatic update from web-platform-tests\npywebsocket3: work on Python 3.15\n\nPython 3.15 removed http.server.CGIHTTPRequestHandler. WebSocketRequestHandler\nsubclasses it, so importing pywebsocket3 fails and wpt serve can't start.\n\nwpt doesn't use pywebsocket3's CGI support, so subclass\nSimpleHTTPRequestHandler instead, on every Python version so that CI runs the\nsame code as 3.15. Passing CGI paths to standalone.py now exits with an error.\n\nThis isn't fixed upstream yet (GoogleChromeLabs/pywebsocket3#49), so like the\nPython 3.12 fix in #45929 it's a change to the vendored copy.\n\nTested on Python 3.15 by running websockets/ in Firefox, no unexpected results.\n\n--\n\nwpt-commits: d6d83998cdc31f3314f79d3d653f6d78be8a0b25\nwpt-pr: 64027\n", "files": ["testing/web-platform/tests/tools/third_party/pywebsocket3/pywebsocket3/request_handler.py", "testing/web-platform/tests/tools/third_party/pywebsocket3/pywebsocket3/standalone.py"], "git_node": "237a4224d0a3d476b29f3e33d5be0fcd8a3de1de", "git_parents": ["f4b29384e92ef49f2ecfd34532dcd6946f62618a"], "node": "cd91b3e5806b661a8671564d46858328ec44739e", "parents": ["e3470eaeb969d4aa760942c98f265ef2a406d10a"], "tags": []}, {"author": "cathiechen \u003ccathiechen@igalia.com\u003e", "branch": "default", "desc": "Bug 2087543 [wpt PR 26116] - Add test for user scroll interrupts smooth scroll, a=testonly\n\nAutomatic update from web-platform-tests\nAdd test for user scroll interrupts smooth scroll (#26116)\n\nStart the smooth scroll from the keydown listener to avoid a race\nStart the smooth scroll from a keydown listener, that is right\nbefore the default action of the key is performed. The user scroll is\nthen guaranteed to happen while the smooth scroll is in progress.\n--\n\nwpt-commits: ae3a0d80b8e627c70eb11390696b72787b8cbac5\nwpt-pr: 26116\n", "files": ["testing/web-platform/tests/css/cssom-view/user-scroll-interrupts-smooth-scroll.html"], "git_node": "15262a7f71586218cc5c8b46f3c6a320d603ea14", "git_parents": ["237a4224d0a3d476b29f3e33d5be0fcd8a3de1de"], "node": "9e4d0c67edf3dda055b250900b599ce8f89bc65b", "parents": ["cd91b3e5806b661a8671564d46858328ec44739e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087543 [wpt PR 26116] - Update wpt metadata, a=testonly\n\nwpt-pr: 26116\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/cssom-view/user-scroll-interrupts-smooth-scroll.html.ini"], "git_node": "bab6e78772fc60155f9ab9d2b4d4dc44617c7a8b", "git_parents": ["15262a7f71586218cc5c8b46f3c6a320d603ea14"], "node": "1f746215aa224a76db72e21b9a2d8808d5047670", "parents": ["9e4d0c67edf3dda055b250900b599ce8f89bc65b"], "tags": []}, {"author": "Jonathan Lee \u003cjonathan-j-lee@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087546 [wpt PR 64234] - Rename flow-tolerance to fit-tolerance, a=testonly\n\nAutomatic update from web-platform-tests\nRename flow-tolerance to fit-tolerance (#64234)\n\nRename `flow-tolerance` to `fit-tolerance` following the CSSWG\nresolution: https://github.com/w3c/csswg-drafts/issues/10884\n\nUpdate the implementation and tests to use the new name. No behavior\nchanges.\n\nBug: 343257585\nChange-Id: Iff380c4d1d273b045180e0da361a9e7ac6346a23\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8545302\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCommit-Queue: Yanling Wang \u003cyanlingwang@microsoft.com\u003e\nReviewed-by: Celeste Pan \u003ccelestepan@microsoft.com\u003e\nSLSA-Policy-Verified: SLSA Policy Verification Service \u003cdevtools-gerritcodereview-exitgate@google.com\u003e\