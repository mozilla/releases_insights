/shadow-dom/reference-target/tentative/label-for.html.ini"], "git_node": "875085b4b6c625610de455298036c8632d2a8dd9", "git_parents": ["b98e700b62d4eb212b88f13a74ef80b24318dc83"], "node": "1be2476e033e660fa9f2c68194418e95b35998c6", "parents": ["1f70b0a4242e0c80cf49f89aeecce5e647e87bd0"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2090037 - Enable headingoffset pref for invalidation tests r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340302\n", "files": ["testing/web-platform/meta/css/selectors/invalidation/__dir__.ini", "testing/web-platform/meta/css/selectors/invalidation/heading-pseudo-class-in-has-with-headingoffset.html.ini", "testing/web-platform/meta/css/selectors/invalidation/heading-pseudo-class-in-has-with-slot-reassignment.html.ini", "testing/web-platform/meta/css/selectors/invalidation/heading-pseudo-class-in-has.html.ini"], "git_node": "fc55e22d767cbcf181edd4623b0013a9b26c13b7", "git_parents": ["875085b4b6c625610de455298036c8632d2a8dd9"], "node": "31f55b567ce579c73e0a0746c25f18bc40c5456c", "parents": ["1be2476e033e660fa9f2c68194418e95b35998c6"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079058 - Add a mochitest for media elements sharing a resource. r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333035\n", "files": ["dom/media/test/bug2079058.sjs", "dom/media/test/file_bug2079058_frame.html", "dom/media/test/mochitest_bugs.toml", "dom/media/test/test_bug2079058.html"], "git_node": "34f3543ce763de9cccf690146d4a3f68b186fcb6", "git_parents": ["fc55e22d767cbcf181edd4623b0013a9b26c13b7"], "node": "6b2f87ac06b25108a3086038b590c255932b286c", "parents": ["31f55b567ce579c73e0a0746c25f18bc40c5456c"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2088856 - Fix browser_ext_slow_script.js looking up the Stop button by its label, and avoid hangs when it fails. r=extension-reviewers,rpl\n\nThe Stop button label is now set asynchronously by Fluent. If the test fails,\nstop the hung script during cleanup, and let the hang notification fall back\nto the add-on ID once the extension has been unloaded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339511\n", "files": ["browser/components/extensions/test/browser/browser_ext_slow_script.js", "browser/modules/ProcessHangMonitor.sys.mjs"], "git_node": "5ebc7d35f7aa2cb11ecd0284d7350623f45fa192", "git_parents": ["34f3543ce763de9cccf690146d4a3f68b186fcb6"], "node": "bde9ac7bdb888593b34cd846da170fa6587e8f7c", "parents": ["6b2f87ac06b25108a3086038b590c255932b286c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086753 - Keep the single-test chrome mochitest frame inside the harness window, r=reusable-components-reviewers,tgiles.\n\n#xulharness is fixed-positioned with a top offset, but the singletest rule also made it as tall as the viewport, pushing the bottom of the test frame below the window. Popups in the frame are constrained to its on-screen part, so tall popups came out shorter than requested in test_popupanchor.xhtml and test_popupincontent.xhtml when run alone (skipped on Windows standalone in bug 2026600).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337706\n", "files": ["testing/mochitest/static/harness.css", "toolkit/content/tests/chrome/chrome.toml", "toolkit/content/tests/widgets/chrome.toml"], "git_node": "d994be76753a63577a89666964e63aff456e8693", "git_parents": ["5ebc7d35f7aa2cb11ecd0284d7350623f45fa192"], "node": "9e1791601e0a06287be4236cd6d034da277e1f8d", "parents": ["bde9ac7bdb888593b34cd846da170fa6587e8f7c"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update HSTS HPKP r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340467\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "9b669cbaf212813b13b834853c07a6c9f212d122", "git_parents": ["d994be76753a63577a89666964e63aff456e8693"], "node": "99cca3b27634def196342b59c37febf8c8576d7d", "parents": ["9e1791601e0a06287be4236cd6d034da277e1f8d"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077970 - Account for descendant max-height in containers with line-clamp: auto. r=AlaskanEmily\n\nMoved handling of constrained block and into `LineClampIterator()`, so\n`FindLineClampAutoTarget()` is solely focused on inline line checks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337397\n", "files": ["layout/generic/nsBlockFrame.cpp", "layout/generic/nsBlockFrame.h", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-039.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-043.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-044.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-045.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-063.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-023.html.ini"], "git_node": "cefd6338feda7004f7c965be23e6131602167d30", "git_parents": ["9b669cbaf212813b13b834853c07a6c9f212d122"], "node": "ac63de064872d4258473fc6963df7f360857d926", "parents": ["99cca3b27634def196342b59c37febf8c8576d7d"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052224 - Reparse the speculation rules when the base url changes. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339760\n", "files": ["dom/base/Document.cpp", "dom/base/SpeculationRules.cpp", "dom/base/SpeculationRules.h", "testing/web-platform/meta/speculation-rules/prefetch/document-rules.https.html.ini"], "git_node": "2a49c44e14d94095e35f380207a70e8899fb972d", "git_parents": ["cefd6338feda7004f7c965be23e6131602167d30"], "node": "6a08b8bd9e7709051c72db747dfa7829a104011c", "parents": ["ac63de064872d4258473fc6963df7f360857d926"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089272 - Prefetch speculation rules candidates with the same URI as the current document. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339761\n", "files": ["dom/base/SpeculationRules.cpp", "testing/web-platform/meta/speculation-rules/prefetch/document-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/navigation-timing-delivery-type.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/prefetch-traverse-reload.sub.html.ini"], "git_node": "3a00cbeb57ec712c43f508dd92317f469bc4011d", "git_parents": ["2a49c44e14d94095e35f380207a70e8899fb972d"], "node": "6632bdbd63ce9605c9dacd3d119fa2c8c5a1e1e5", "parents": ["6a08b8bd9e7709051c72db747dfa7829a104011c"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2085919 - Remove the GeckoView config after each Gecko profiler run of the Android startup tests. r=mozperftest-reviewers,aglavic\n\nThe config used to stay on the device until the layer's teardown, so the app\nlaunches between the profiled runs were profiled too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336926\n", "files": ["python/mozperftest/mozperftest/system/geckoprofiler.py"], "git_node": "60e9083380c6465f36cc199eb960d435d2bc7dbd", "git_parents": ["3a00cbeb57ec712c43f508dd92317f469bc4011d"], "node": "ac6c1c55a6f567df659cba4c44be37badc1708af", "parents": ["6632bdbd63ce9605c9dacd3d119fa2c8c5a1e1e5"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2085919 - Merge the Gecko profiler markers into the simpleperf profiles in the combined profiling run of the Android startup tests. r=mozperftest-reviewers,aglavic\n\nIn our --gecko-profile newssite-applink-startup jobs, we do three profiling\nruns: one with simpleperf, one with only the gecko profiler, and one with both.\n\nFor the run with both profilers, we were outputting the collected profiles separately.\nThis patch makes us use the new profiler-edit functionality from\nhttps://github.com/firefox-devtools/profiler/pull/5448\nto create a merged profile: we take the samples from simpleperf and the markers\nfrom the Gecko profile.\n\nExample merged profile: https://share.firefox.dev/3U3xSRP\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336907\n", "files": ["python/mozperftest/mozperftest/profiler.py", "python/mozperftest/mozperftest/system/geckoprofiler.py", "python/mozperftest/mozperftest/system/simpleperf.py", "python/mozperftest/mozperftest/tests/test_geckoprofiler.py", "python/mozperftest/mozperftest/tests/test_profiler.py", "python/mozperftest/mozperftest/tests/test_simpleperf.py"], "git_node": "e550107a4eebb07bfee37da727a339cb40f18751", "git_parents": ["60e9083380c6465f36cc199eb960d435d2bc7dbd"], "node": "c3f3a46b41f5afc84c352d4c0d0df97b379df862", "parents": ["ac6c1c55a6f567df659cba4c44be37badc1708af"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2085919 - Add JS frames to the simpleperf profiles, using jitdump. r=mozperftest-reviewers,aglavic\n\nTo get JS frames into the stacks from simpleperf, we need to do similar\nthings as we do for the simpleperf sp3 profiles:\n\n- Set env vars for the JS engine, e.g. turn on jitdump output\n- Make simpleperf use framepointer unwinding, so that it can unwind JIT code\n  (only in the run with both profilers; the simpleperf-only run keeps DWARF\n  unwinding, which gives us Java stacks)\n- Fetch jitdump files so that samply import sees them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336927\n", "files": ["python/mozperftest/mozperftest/profiler.py", "python/mozperftest/mozperftest/system/geckoprofiler.py", "python/mozperftest/mozperftest/system/simpleperf.py", "python/mozperftest/mozperftest/tests/test_geckoprofiler.py", "python/mozperftest/mozperftest/tests/test_profiler.py", "python/mozperftest/mozperftest/tests/test_simpleperf.py"], "git_node": "080da00b42014ddab54755bfb6bd532dc36a2f80", "git_parents": ["e550107a4eebb07bfee37da727a339cb40f18751"], "node": "35725ba957c16c9a8d629ddf5a353e6cb1d0aa9f", "parents": ["c3f3a46b41f5afc84c352d4c0d0df97b379df862"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2084740 - Choose What To Sync Modal: Per-device settings notice r=settings-reviewers,fluent-reviewers,sync-reviewers,mconley,bolsson,skhamis\n\nAdd a notification that the browser is using the new per-device Choose What To Sync feature. Notification should be dismissable by the user.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336833\n", "files": ["browser/components/preferences/config/account-sync.mjs", "browser/components/preferences/dialogs/syncChooseWhatToSync.js", "browser/components/preferences/dialogs/syncChooseWhatToSync.xhtml", "browser/locales/en-US/browser/preferences/preferences.ftl"], "git_node": "e185f97a8dc638e100a5089d74887207760d4c95", "git_parents": ["080da00b42014ddab54755bfb6bd532dc36a2f80"], "node": "5672dd64775fc71b7ad87894d80a3c2a52820e16", "parents": ["35725ba957c16c9a8d629ddf5a353e6cb1d0aa9f"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087259 - Add telemetry for the Choose What To Sync banners r=sync-reviewers,settings-reviewers,mconley,skhamis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338395\n", "files": ["browser/components/preferences/config/account-sync.mjs", "browser/components/preferences/dialogs/syncChooseWhatToSync.js", "browser/components/preferences/dialogs/syncChooseWhatToSync.xhtml", "browser/components/preferences/tests/sync/browser_sync_chooseWhatToSync.js", "browser/components/preferences/tests/sync/browser_sync_settings_ui.js", "browser/components/preferences/tests/sync/head.js", "services/fxaccounts/metrics.yaml"], "git_node": "1f4ca95b59833ed46084507677aea203d894ef5e", "git_parents": ["e185f97a8dc638e100a5089d74887207760d4c95"], "node": "d4fba87cc7c632c4499911c27c10d4bd5870a0c7", "parents": ["5672dd64775fc71b7ad87894d80a3c2a52820e16"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 1813529 - Do not override the Configuration in Application#attachBaseContext r=android-reviewers,nalexander\n\nThe six year old bug here is a combination of bandaids to separate\nproblems, which together hides a caching bug.\n\nWe introduced and upstreamed a `LocaleAwareApplication` [^1] that\noverrides the `onConfigurationChanged` so that our browsers can update the\napplication to the system locale and notify the browser engine as well\n(so web content can be notified too).\nThis change also overrode the `attachBaseContext` which passes in a\nconfiguration _only during Application start_.\n\nThe `LocaleManager` consumes this via `updateResources` that makes a copy\nof the new locale, and returns a new Context with the updated\n`Configuration` in the `Application`. This is fine to do for the most\npart (although there are only clear examples of this being done at the\nActivity level [^3]).\n\nIn `Application#attachBaseContext`, `LocaleManager.updateResources`\ngives `createConfigurationContext` a full copy of the start-up\n`Configuration`. This makes every field an override, including\n`uiMode`, so the application context never gets the new `uiMode`\nwhen the system theme changes.\n\nOther considerations:\n\n - We also do not want to add `uiMode` to the `HomeActivity` configChange\n   flags because we don't want to observe those ourselves and update the\n   theme; it can be handled by the system today because a GeckoSession has\n   an application lifetime, so an activity recreation does not lose state\n   when it's recreated with the theme changes applied to web content as\n   well. A simple verification technique is to open a private tab in\n   Fenix/Focus and force a theme change; the private tab should not be\n   destroyed since it is only retained in memory and never persisted to\n   disk.\n - Removing the `Application#attachBaseContext` is the foot-gun as far\n   as I can tell, but this code has been here long enough, that I would\n   like to see us still apply the locale updates while fixing `uiMode`\n   bug.\n - The bug was reported ~three months after the changes to use the\n   `LocaleAwareApplication` landed mozilla-mobile/fenix#7070 which lines\n   up with train schedule. The fix in mozilla-mobile/fenix#10036 was\n   possibly overlooked as a bug that was introduced and dormant from that\n   time and undiscovered until it reached a release population, so it's\n   possible that it was considered a theming bug from the third party\n   library and hence why the workaround was used (that masked the root\n   cause).\n - The upstream [^2] fixed the `uiMode` bug a few months after the patch\n   had landed, and while we did update to that version, we never\n   removed the workaround that could have surfaced the root cause in\n   `LocaleAwareApplication`. This was attempted in bug 1926334 which\n   also discovered that the bug still existed after the upstream fixes.\n\n**TL;DR:** When you override `attachBaseContext` use `Configuration()`,\nwhen overriding `onConfigurationChanged` use `Configuration(newConfig)`.\n\nVerified this with a simple script that switches system `uimode` when\nthe application is in the background. I was able to reproduce the original\nbug without the `config.uiMode` patch, and then saw the bug\ndisappear with the additions to the `LocaleManager`.\n\n```bash\n#!/bin/bash\n\nPACKAGE_NAME=\"org.mozilla.fenix.debug\"\n\nwhile true; do\n  # Set to light mode\n  adb shell cmd uimode night no\n  echo \"Switched to Light Mode\"\n\n  # Send the app to the background\n  adb shell input keyevent 3\n  echo \"Sent $PACKAGE_NAME to background\"\n\n  # Relaunch the app\n  adb shell monkey \\\n    -p \"$PACKAGE_NAME\" \\\n    -c android.intent.category.LAUNCHER 1\n  echo \"Relaunched $PACKAGE_NAME\"\n\n  sleep 1.2\n\n  # Set to dark mode\n  adb shell cmd uimode night yes\n  echo \"Switched to Dark Mode\"\n\n  # Send the app to the background\n  adb shell input keyevent 3\n  echo \"Sent $PACKAGE_NAME to background\"\n\n  # Relaunch the app\n  adb shell monkey \\\n    -p \"$PACKAGE_NAME\" \\\n    -c android.intent.category.LAUNCHER 1\n  echo \"Relaunched $PACKAGE_NAME\"\n\n  sleep 1.2\ndone\n```\n\n[^1]: The original LocaleAwareApplication in Focus only override the\n `onConfigurationChange`, but the upstream might\n have been the first to introduce the `attachBaseContext`\n in mozilla-mobile/android-components#3584\n[^2]: https://issuetracker.google.com/issues/140607881#comment15\n[^3]: https://cs.android.com/androidx/platform/frameworks/support/+/androidx-main:appcompat/appcompat/src/androidTest/java/androidx/appcompat/app/NightModeActivity.java;drc=a4a5393ead9e12a8cd9a2a6e0b27cd108dbe803d\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340229\n", "files": ["mobile/android/android-components/components/support/locale/src/main/java/mozilla/components/support/locale/LocaleManager.kt", "mobile/android/android-components/components/support/locale/src/test/java/mozilla/components/support/locale/LocaleManagerTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/FocusApplication.kt"], "git_node": "386980b2696eff64b037687b06b476c4a045ca19", "git_parents": ["1f4ca95b59833ed46084507677aea203d894ef5e"], "node": "f376f8c4785fb14e612fc1e69a2679af6ef297de", "parents": ["d4fba87cc7c632c4499911c27c10d4bd5870a0c7"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2088764 - Make the urlbar result menu behave like a native context menu. r=adw,desktop-theme-reviewers,urlbar-reviewers,kcochrane\n\nThis makes the urlbar result menu behave like a native context menu:\n\n1. Other results don't change their hover state while the result menu is open.\n2. Clicking another result while the result menu is open only closes the menu.\n3. Right-clicking another result still opens the result menu for that result.\n\nThis only affects the urlbar results.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340203\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js", "browser/themes/shared/urlbar/view-nova.css"], "git_node": "a9b8eeb3ca3c27491dba8e970873320154642ab6", "git_parents": ["386980b2696eff64b037687b06b476c4a045ca19"], "node": "c8fcf29db5c62fde854fb1a9425aee7a4375971c", "parents": ["f376f8c4785fb14e612fc1e69a2679af6ef297de"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2089710 - Treat block size as indefinite on a multicol element that is an auto-main-size flex item in an auto-sized flex container. r=layout-reviewers,emilio\n\nThe CSS flexbox spec defines some cases where a flex item's post-flexing\nblock-size needs to be explicitly treated it as if it were indefinite, i.e.\nunusable for resolving percent sizes on children:\nhttps://drafts.csswg.org/css-flexbox-1/#definite-sizes\n\nWe keep track of that using a ReflowInput flag called\n'mTreatBSizeAsIndefinite'.\n\nWhen we're reflowing a column-wrapper block frame (in a multicol element), we\nwalk up to the nsColumnSetFrame to get its block-size, for the purpose of\nresolving percentages on children, as noted in the existing code-comment in\nthis patch's contextual code.  Before this patch, this lookup didn't consider\nwhether this block-size might be indefinite.  This patch now accounts for this\nby using ComputedBSizeAsPercentageBasis, which returns a sentinel value\n(matching what a content-based height would provide) if the size is considered\nindefinite.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340161\n", "files": ["layout/generic/nsBlockFrame.cpp", "testing/web-platform/tests/css/css-multicol/multicol-percent-height-in-flex-item-001.html"], "git_node": "13cb7320aa2325bf340ee876406e5773a7338fc6", "git_parents": ["a9b8eeb3ca3c27491dba8e970873320154642ab6"], "node": "af92f1d5d49627fc97d17ac97e0b7af8c365422a", "parents": ["c8fcf29db5c62fde854fb1a9425aee7a4375971c"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089633 - Allow forms in framed widget iframes r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340102\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/Crossword/Crossword.jsx", "browser/extensions/newtab/content-src/components/Widgets/Horoscopes/Horoscopes.jsx", "browser/extensions/newtab/content-src/components/Widgets/Solitaire/Solitaire.jsx", "browser/extensions/newtab/content-src/components/Widgets/Travel/Travel.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Crossword.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Horoscopes.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Solitaire.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Travel.test.jsx"], "git_node": "d0b7d704abe7c1caba3d6b1d3a2607169263df88", "git_parents": ["13cb7320aa2325bf340ee876406e5773a7338fc6"], "node": "67ee4de02814a26d38e84e403886acfb9307417f", "parents": ["af92f1d5d49627fc97d17ac97e0b7af8c365422a"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089611 - Make the Travel widget's framed content full bleed with a floating badge and menu r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340104\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Stocks/_Stocks.scss", "browser/extensions/newtab/content-src/components/Widgets/Travel/Travel.jsx", "browser/extensions/newtab/content-src/components/Widgets/Travel/_Travel.scss", "browser/extensions/newtab/content-src/styles/_mixins.scss"], "git_node": "fa7809eb13d1cfe38f8277d0acf18698c925cfaf", "git_parents": ["d0b7d704abe7c1caba3d6b1d3a2607169263df88"], "node": "ca2fb268a8d584c347fb6400936a3711f3ade305", "parents": ["67ee4de02814a26d38e84e403886acfb9307417f"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089616 - Resize the Travel widget on the frame's change_size action, and show it only after widget_ready r=mconley\n\nFramedWidgetsFeed now skips rebroadcasting a manifest identical to the last\none. The periodic resend replaced the FramedWidgets state, which cleared the\nunavailable marker a tab sets when a widget's document fails to load.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340105\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/Travel/Travel.jsx", "browser/extensions/newtab/content-src/components/Widgets/Travel/_Travel.scss", "browser/extensions/newtab/content-src/components/Widgets/useFramedWidgetMessages.jsx", "browser/extensions/newtab/lib/Widgets/FramedWidgetsFeed.sys.mjs", "browser/extensions/newtab/test/jest/common/Reducers.test.js", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Travel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/useFramedWidgetMessages.test.jsx", "browser/extensions/newtab/test/xpcshell/test_FramedWidgetsFeed.js"], "git_node": "8af1f471c834e89be8e537adcf8db5588c68794d", "git_parents": ["fa7809eb13d1cfe38f8277d0acf18698c925cfaf"], "node": "fe99996933c9d9599a4df7f89df092ebe18a31ea", "parents": ["ca2fb268a8d584c347fb6400936a3711f3ade305"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2084831 - update response card to new layout r=jlewis,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339697\n", "files": ["browser/components/aiwindow/ui/components/aitab-tool-ui/aitab-tool-ui.css", "browser/components/aiwindow/ui/components/aitab-tool-ui/aitab-tool-ui.mjs", "browser/locales-preview/aiWindow.ftl"], "git_node": "93f02ea44b459aa3314245dd2012d94d2023e0f0", "git_parents": ["8af1f471c834e89be8e537adcf8db5588c68794d"], "node": "70741cb816c31782d8d21bd95763ef2a69be33ff", "parents": ["fe99996933c9d9599a4df7f89df092ebe18a31ea"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2087530 - Do not retry failing tests in test-verify, r=ahal.\n\nA retry hides the intermittent failures test-verify is looking for. xpcshell\nalready did not retry, but passed the retry keyword twice when --retry was given.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338885\n", "files": ["testing/mochitest/runtests.py", "testing/mochitest/tests/python/test_mochitest_integration.py", "testing/xpcshell/runxpcshelltests.py", "testing/xpcshell/selftest.py"], "git_node": "0b36fe64a62b4674d551daf3622e8fa9af16f9a4", "git_parents": ["93f02ea44b459aa3314245dd2012d94d2023e0f0"], "node": "fb3605fbefbb004f74f7a25df04dbf8c91f6ab2e", "parents": ["70741cb816c31782d8d21bd95763ef2a69be33ff"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2087532 - Do not run xpcshell self-tests in test-verify and per-test coverage jobs, r=releng-reviewers,ahal.\n\nThey check the harness rather than the tests being verified, and the first\nverified xpcshell test paid for them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338886\n", "files": ["testing/mozharness/scripts/desktop_unittest.py"], "git_node": "4f0c3965d05f315613a4c054e9fc72f9c5e7d191", "git_parents": ["0b36fe64a62b4674d551daf3622e8fa9af16f9a4"], "node": "ba103a39daeccf28244942e1b94719f8195bdbee", "parents": ["fb3605fbefbb004f74f7a25df04dbf8c91f6ab2e"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090281 - Expire the FramedWidgetsFeed manifest cache after 30 minutes instead of at the local day change. r=maxx\n\nFramedWidgetsFeed.isStale() now treats a cached manifest as stale once it is 30 minutes old (CACHE_EXPIRY_MS), instead of when the local calendar day changes. A lastUpdated timestamp in the future (e.g. the system clock was set back) is also treated as stale, so a skewed clock can't pin the cache.\n\nRefreshes still happen through the existing SYSTEM_TICK / INIT paths. If the fetch fails, the stale cached manifest is still served as before.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340530\n", "files": ["browser/extensions/newtab/lib/Widgets/FramedWidgetsFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_FramedWidgetsFeed.js"], "git_node": "0a48ce2c3e60a0dbcda1b0ec9cc0afb455d8a2d7", "git_parents": ["4f0c3965d05f315613a4c054e9fc72f9c5e7d191"], "node": "7077571d31f3772c124acb581cdf66b38d78dc4e", "parents": ["ba103a39daeccf28244942e1b94719f8195bdbee"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2087537 - Enter chaos mode once the mochitest harness has started in test-verify, r=ahal,dom-core-reviewers,smaug.\n\nStarting Firefox in chaos mode made every browser startup of the chaos steps,\nand on debug builds every shutdown and leak check, much slower.\nnsIDOMWindowUtils.enterChaosMode() can now be given the chaos features to\nenable, so the harness enters chaos mode with the usual test-verify features\nonce it has started, and leaves it before shutdown. Only the random thread\npriorities and CPU affinities of chaos mode's thread scheduling are assigned\nwhen a thread starts, so threads started before then, like the main thread,\nkeep their normal ones; the other chaos features apply to all threads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338887\n", "files": ["dom/base/nsDOMWindowUtils.cpp", "dom/interfaces/base/nsIDOMWindowUtils.idl", "mfbt/ChaosMode.cpp", "mfbt/ChaosMode.h", "testing/mochitest/api.js", "testing/mochitest/browser-test.js", "testing/mochitest/runtests.py", "testing/mochitest/runtestsremote.py"], "git_node": "522c0ac7852b33fcc2a1cbe853a031f10ec045af", "git_parents": ["0a48ce2c3e60a0dbcda1b0ec9cc0afb455d8a2d7"], "node": "3edcac1f5a6d3900b68ce22fa418291fe8fdc99b", "parents": ["7077571d31f3772c124acb581cdf66b38d78dc4e"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085919 - Add JS frames to the simpleperf profiles, using jitdump. r=mozperftest-reviewers,aglavic\" for causing perftest failures.\n\nThis reverts commit 080da00b42014ddab54755bfb6bd532dc36a2f80.\n\nRevert \"Bug 2085919 - Merge the Gecko profiler markers into the simpleperf profiles in the combined profiling run of the Android startup tests. r=mozperftest-reviewers,aglavic\"\n\nThis reverts commit e550107a4eebb07bfee37da727a339cb40f18751.\n\nRevert \"Bug 2085919 - Remove the GeckoView config after each Gecko profiler run of the Android startup tests. r=mozperftest-reviewers,aglavic\"\n\nThis reverts commit 60e9083380c6465f36cc199eb960d435d2bc7dbd.\n", "files": ["python/mozperftest/mozperftest/profiler.py", "python/mozperftest/mozperftest/system/geckoprofiler.py", "python/mozperftest/mozperftest/system/simpleperf.py", "python/mozperftest/mozperftest/tests/test_geckoprofiler.py", "python/mozperftest/mozperftest/tests/test_profiler.py", "python/mozperftest/mozperftest/tests/test_simpleperf.py"], "git_node": "5ba81c0d961ffe0f83c4698b052a98a5cf298224", "git_parents": ["522c0ac7852b33fcc2a1cbe853a031f10ec045af"], "node": "8cf39380927b8c706e9b4420944ce1551744c1b5", "parents": ["3edcac1f5a6d3900b68ce22fa418291fe8fdc99b"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087450 - [devtools] Update the tooltip for style links when the stylesheet in debugger pref is enabled r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338280\n", "files": ["devtools/client/inspector/rules/test/browser_rules_original-source-link.js", "devtools/client/inspector/rules/test/browser_rules_style-editor-link.js", "devtools/client/inspector/rules/views/rule-editor.js", "devtools/client/shared/components/Frame.js", "devtools/client/shared/components/test/chrome/test_frame_01.html"], "git_node": "47f0c9821d8c89eca0d52ff5c4f365f7fba9235f", "git_parents": ["5ba81c0d961ffe0f83c4698b052a98a5cf298224"], "node": "238585d2069c61eeddf259b20b47ffd02195fc77", "parents": ["8cf39380927b8c706e9b4420944ce1551744c1b5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2089704. r=webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozil