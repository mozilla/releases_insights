ection.py", "third_party/python/pip/pip/_vendor/urllib3/http2/probe.py", "third_party/python/pip/pip/_vendor/urllib3/packages/__init__.py", "third_party/python/pip/pip/_vendor/urllib3/packages/backports/__init__.py", "third_party/python/pip/pip/_vendor/urllib3/packages/backports/makefile.py", "third_party/python/pip/pip/_vendor/urllib3/packages/backports/weakref_finalize.py", "third_party/python/pip/pip/_vendor/urllib3/packages/six.py", "third_party/python/pip/pip/_vendor/urllib3/poolmanager.py", "third_party/python/pip/pip/_vendor/urllib3/py.typed", "third_party/python/pip/pip/_vendor/urllib3/request.py", "third_party/python/pip/pip/_vendor/urllib3/response.py", "third_party/python/pip/pip/_vendor/urllib3/util/__init__.py", "third_party/python/pip/pip/_vendor/urllib3/util/connection.py", "third_party/python/pip/pip/_vendor/urllib3/util/proxy.py", "third_party/python/pip/pip/_vendor/urllib3/util/queue.py", "third_party/python/pip/pip/_vendor/urllib3/util/request.py", "third_party/python/pip/pip/_vendor/urllib3/util/response.py", "third_party/python/pip/pip/_vendor/urllib3/util/retry.py", "third_party/python/pip/pip/_vendor/urllib3/util/ssl_.py", "third_party/python/pip/pip/_vendor/urllib3/util/ssl_match_hostname.py", "third_party/python/pip/pip/_vendor/urllib3/util/ssltransport.py", "third_party/python/pip/pip/_vendor/urllib3/util/timeout.py", "third_party/python/pip/pip/_vendor/urllib3/util/url.py", "third_party/python/pip/pip/_vendor/urllib3/util/util.py", "third_party/python/pip/pip/_vendor/urllib3/util/wait.py", "third_party/python/pip/pip/_vendor/vendor.txt", "third_party/python/pyproject.toml", "third_party/python/requirements.txt", "third_party/python/uv.lock", "third_party/python/uv.lock.hash", "tools/lint/trojan-source.yml"], "git_node": "911575e983c40de193011e2a405a7cc57574d3da", "git_parents": ["519f6a9233b96c9d7832dc71a7ea1bffd6f5d5cb"], "node": "43068c3f417efcd846a52a07993a5392396b8759", "parents": ["78ba09265b24c7cbf31cd516c72c4afb8b67b675"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091603 - Stop copying certifi into pip after vendoring r=firefox-build-system-reviewers,mach-reviewers,sergesanspaille,ahal\n\npip 26.3 bundles the same certifi 2026.10.23 that is vendored separately, so\nthe copy has nothing left to do. Re-vendoring without it restores the RECORD\nfile as shipped in the wheel.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341676\n", "files": ["python/mozbuild/mozbuild/vendor/vendor_python.py", "third_party/python/pip/pip-26.3.dist-info/RECORD"], "git_node": "70dae84fcd19ffec371833a84e5fc8a6d930209e", "git_parents": ["911575e983c40de193011e2a405a7cc57574d3da"], "node": "f48657e71dd8772320ebe7867a972bb14a51c4aa", "parents": ["43068c3f417efcd846a52a07993a5392396b8759"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091603 - Remove the vendored pip-tools r=firefox-build-system-reviewers,mach-reviewers,sergesanspaille,ahal\n\nNothing has called pip-compile since bug 1659593 moved `./mach vendor python`\noff it, and pip-tools 7.4.1 no longer imports against pip 26. build and\npyproject-hooks were only pulled in by pip-tools.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341678\n", "files": ["python/sites/mach.txt", "third_party/python/build/build-1.2.2.post1.dist-info/LICENSE", "third_party/python/build/build-1.2.2.post1.dist-info/METADATA", "third_party/python/build/build-1.2.2.post1.dist-info/RECORD", "third_party/python/build/build-1.2.2.post1.dist-info/WHEEL", "third_party/python/build/build-1.2.2.post1.dist-info/entry_points.txt", "third_party/python/build/build/__init__.py", "third_party/python/build/build/__main__.py", "third_party/python/build/build/_builder.py", "third_party/python/build/build/_compat/__init__.py", "third_party/python/build/build/_compat/importlib.py", "third_party/python/build/build/_compat/tarfile.py", "third_party/python/build/build/_compat/tomllib.py", "third_party/python/build/build/_ctx.py", "third_party/python/build/build/_exceptions.py", "third_party/python/build/build/_types.py", "third_party/python/build/build/_util.py", "third_party/python/build/build/env.py", "third_party/python/build/build/py.typed", "third_party/python/build/build/util.py", "third_party/python/pip_tools/pip_tools-7.4.1.dist-info/LICENSE", "third_party/python/pip_tools/pip_tools-7.4.1.dist-info/METADATA", "third_party/python/pip_tools/pip_tools-7.4.1.dist-info/RECORD", "third_party/python/pip_tools/pip_tools-7.4.1.dist-info/WHEEL", "third_party/python/pip_tools/pip_tools-7.4.1.dist-info/entry_points.txt", "third_party/python/pip_tools/pip_tools-7.4.1.dist-info/top_level.txt", "third_party/python/pip_tools/piptools/__init__.py", "third_party/python/pip_tools/piptools/__main__.py", "third_party/python/pip_tools/piptools/_compat/__init__.py", "third_party/python/pip_tools/piptools/_compat/pip_compat.py", "third_party/python/pip_tools/piptools/build.py", "third_party/python/pip_tools/piptools/cache.py", "third_party/python/pip_tools/piptools/exceptions.py", "third_party/python/pip_tools/piptools/locations.py", "third_party/python/pip_tools/piptools/logging.py", "third_party/python/pip_tools/piptools/py.typed", "third_party/python/pip_tools/piptools/repositories/__init__.py", "third_party/python/pip_tools/piptools/repositories/base.py", "third_party/python/pip_tools/piptools/repositories/local.py", "third_party/python/pip_tools/piptools/repositories/pypi.py", "third_party/python/pip_tools/piptools/resolver.py", "third_party/python/pip_tools/piptools/scripts/__init__.py", "third_party/python/pip_tools/piptools/scripts/compile.py", "third_party/python/pip_tools/piptools/scripts/options.py", "third_party/python/pip_tools/piptools/scripts/sync.py", "third_party/python/pip_tools/piptools/subprocess_utils.py", "third_party/python/pip_tools/piptools/sync.py", "third_party/python/pip_tools/piptools/utils.py", "third_party/python/pip_tools/piptools/writer.py", "third_party/python/pyproject.toml", "third_party/python/pyproject_hooks/pyproject_hooks-1.2.0.dist-info/LICENSE", "third_party/python/pyproject_hooks/pyproject_hooks-1.2.0.dist-info/METADATA", "third_party/python/pyproject_hooks/pyproject_hooks-1.2.0.dist-info/RECORD", "third_party/python/pyproject_hooks/pyproject_hooks-1.2.0.dist-info/WHEEL", "third_party/python/pyproject_hooks/pyproject_hooks/__init__.py", "third_party/python/pyproject_hooks/pyproject_hooks/_impl.py", "third_party/python/pyproject_hooks/pyproject_hooks/_in_process/__init__.py", "third_party/python/pyproject_hooks/pyproject_hooks/_in_process/_in_process.py", "third_party/python/pyproject_hooks/pyproject_hooks/py.typed", "third_party/python/requirements.txt", "third_party/python/uv.lock", "third_party/python/uv.lock.hash"], "git_node": "a3816968e4f84f6449b94381633338c2d0af4fd7", "git_parents": ["70dae84fcd19ffec371833a84e5fc8a6d930209e"], "node": "ad4c502c256c8b72fb9def035e24a5f9397d0fa1", "parents": ["f48657e71dd8772320ebe7867a972bb14a51c4aa"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2091692 - gn_processor.py: Include subdirs of root gen dir in LOCAL_INCLUDES. r=firefox-build-system-reviewers,sergesanspaille\" for causing lint failures\n\nThis reverts commit 60c44e3ce01e05c57e7d2ee396b318d7592dd64c.\n\nRevert \"Bug 2091692 - Escape commas when formatting generated file flags. r=firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit 74ed5c8a4fe83b8f6d007f73c572e2736a8fc08f.\n\nRevert \"Bug 2091692 - Treat .inc files as required before compile. r=firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit 9dcedccaf27e0b6ed850f861c08293eb264e0adf.\n\nRevert \"Bug 2091692 - Make file_generate_wrapper.py use cwd relative to topobjdir. r=firefox-build-system-reviewers,sylvestre,sergesanspaille\"\n\nThis reverts commit 8152c3f5bf2b15cff3fade741025705d3f2684dc.\n", "files": ["build/gn_processor.py", "config/makefiles/functions.mk", "python/mozbuild/mozbuild/action/file_generate_wrapper.py", "python/mozbuild/mozbuild/backend/make.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/test/backend/data/generated-files/moz.build", "python/mozbuild/mozbuild/test/backend/data/xpi-stage-compile-output/staged/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/backend/test_xpi_archive.py"], "git_node": "eadfd06affb877913fb792f60d647c680a1ceeab", "git_parents": ["a3816968e4f84f6449b94381633338c2d0af4fd7"], "node": "c4659f56b4cd143dce3c358dc8cf20aebdd6b0b9", "parents": ["ad4c502c256c8b72fb9def035e24a5f9397d0fa1"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087594 - Move widget user action values into one shared list in WidgetsRegistry.mjs r=maxx\n\nMost New Tab widgets define change_size and learn_more in their own USER_ACTION_TYPES. This puts those two in a shared WIDGET_USER_ACTIONS export from WidgetsRegistry.mjs. Each widget still lists its own actions locally and includes the shared ones. The values sent to Glean don\u2019t change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338374\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/Clocks/Clocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Crossword/Crossword.jsx", "browser/extensions/newtab/content-src/components/Widgets/FocusTimer/FocusTimer.jsx", "browser/extensions/newtab/content-src/components/Widgets/Horoscopes/Horoscopes.jsx", "browser/extensions/newtab/content-src/components/Widgets/Lists/Lists.jsx", "browser/extensions/newtab/content-src/components/Widgets/MozWidgetCard.jsx", "browser/extensions/newtab/content-src/components/Widgets/PictureOfTheDay/PictureOfTheDay.jsx", "browser/extensions/newtab/content-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/content-src/components/Widgets/RecentSearches/RecentSearches.jsx", "browser/extensions/newtab/content-src/components/Widgets/Solitaire/Solitaire.jsx", "browser/extensions/newtab/content-src/components/Widgets/Travel/Travel.jsx", "browser/extensions/newtab/content-src/components/Widgets/Weather/Weather.jsx"], "git_node": "c4f01f7748a82f99c1291112934aa0aeadedb651", "git_parents": ["eadfd06affb877913fb792f60d647c680a1ceeab"], "node": "943cb7136d8045288539600036372040ce707c58", "parents": ["c4659f56b4cd143dce3c358dc8cf20aebdd6b0b9"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083876 - Solitaire: Add the context menu r=fluent-reviewers,maxx,bolsson\n\nThis adds a \u201cPowered by Yahoo\u201d link at the top of Solitaire\u2019s menu using the shared WidgetMenuPoweredBy component. The string lives in newtabPreview.ftl, so it won\u2019t be sent for translation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338943\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Solitaire/Solitaire.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Solitaire.test.jsx", "browser/locales-preview/newtabPreview.ftl"], "git_node": "9c434deeb6acd06b3562cb4c2787f48b3940782d", "git_parents": ["c4f01f7748a82f99c1291112934aa0aeadedb651"], "node": "d4e765315c17ec3f3d0ae73fd2e1f5d01a675c43", "parents": ["943cb7136d8045288539600036372040ce707c58"], "tags": []}, {"author": "Justin Link \u003cjlink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092407 - Build with -mcx16 on x86_64 Windows to inline std::atomic operations. r=firefox-build-system-reviewers,glandium\n\nThe MSVC STL marks every function in \u003catomic\u003e as target(\"cx16\") under clang,\nand clang 23 refuses to inline them into callers built without that feature,\nso every std::atomic and mozilla::Atomic operation became an out-of-line call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342453\n", "files": ["build/moz.configure/windows.configure"], "git_node": "2f6a5fc44e2f25720bd0460378ba712e97001e02", "git_parents": ["9c434deeb6acd06b3562cb4c2787f48b3940782d"], "node": "9de0684778a1ce1ef509a86ccd4fb0f33290cdf0", "parents": ["d4e765315c17ec3f3d0ae73fd2e1f5d01a675c43"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2087829 - Show in the Smart Window action log when Exa wrote the reply. r=fluent-reviewers,mlucks,cdipersio,flod\n\nOn the Exa /answers path, Exa writes the reply instead of the assistant the user picked. The action log now says \"Searched and answered with Exa\" in that case.\n\nThe fast path, custom endpoints and failed /answers requests keep \"Searched the web with Exa\", because the user's assistant still writes the reply there. runAnswersSearch adds a directAnswer flag to its result so the action log can tell these cases apart, since the reply stream is not saved with the tool result.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338556\n", "files": ["browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_chat_tool_calls.js", "browser/components/aiwindow/models/tests/browser/browser_search_the_web.js", "browser/components/aiwindow/ui/modules/ToolActionLog.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_ai_action_result.js", "browser/components/aiwindow/ui/test/xpcshell/test_ToolActionLog.js", "browser/locales/en-US/browser/aiWindowContent.ftl"], "git_node": "e75562c5edca121125099586b0d68fb98f50d1c5", "git_parents": ["2f6a5fc44e2f25720bd0460378ba712e97001e02"], "node": "948610c14215fae9049c0248c89556879a2b77e1", "parents": ["9de0684778a1ce1ef509a86ccd4fb0f33290cdf0"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "