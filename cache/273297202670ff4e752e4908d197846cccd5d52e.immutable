f42d6ed120da0f856\nson -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nsq -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nsr -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nsv-SE -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nta -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nte -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nth -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\ntl -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\ntr -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\ntrs -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nuk -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nur -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nuz -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nvi -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nwo -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nxh -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nzam -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nzh-CN -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\nzh-TW -\u003e 2ae8a1be8b836e555608d72f42d6ed120da0f856\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "71fbc7bf44017e048db62d764b8b9c469a751f7a", "git_parents": ["b3b0736e04f99682c43a10367986e901db19b1a0"], "node": "c547ec9f000c61cbbb159cdb3fa020e62e970e2c", "parents": ["6f523b3bcaa7da11b0d2951526420666ac84ea2e"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070746 - Remove the unused learn more link style from Settings r=settings-reviewers,desktop-theme-reviewers,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341488\n", "files": ["browser/themes/shared/preferences/preferences.css"], "git_node": "5ab4aaff8c6d492beaaa37fb580f52c598b35ba5", "git_parents": ["71fbc7bf44017e048db62d764b8b9c469a751f7a"], "node": "ab21c6a4d4ad3c125d70e8bceb81cf9a1830af41", "parents": ["c547ec9f000c61cbbb159cdb3fa020e62e970e2c"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091692 - Make file_generate_wrapper.py use cwd relative to topobjdir. r=firefox-build-system-reviewers,sylvestre,sergesanspaille\n\nfile_generate_wrapper.py's `action()` resolves the script's working\ndirectory by joining the provided `target_dir` onto `Path.cwd()`. The\ntarget_dir provided by gn_processor.py is expressed relative to the\ngenerated project's build root, so this is only correct if `Path.cwd()`\nis the top-level objdir.\n\nThat assumption was previously true for all GeneratedFiles emitted by\ngn_processor.py, as they all produced files that land in the \"export\"\ntier and therefore the top-level backend.mk file.\n\nWhen vendoring ANGLE's Vulkan backend, however, we now encounter\nGeneratedFiles that output \".inc\" files, which currently land in the\n\"pre-compile\" tier instead, and therefore a nested target-specific\nbackend.mk. This results in the action being executed with an incorrect\ncwd, resulting in failures.\n\nMake action() instead join the provided `target_dir` to\n`buildconfig.topobjdir`, ensuring the correct working directory is used.\n\nNote that these files do in fact belong in the \"export\" tier, which will\nbe addressed in the following patch, making this moot. But we take this\nopportunity to fix this bug, hopefully saving somebody a headache in the\nfuture.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341759\n", "files": ["python/mozbuild/mozbuild/action/file_generate_wrapper.py"], "git_node": "71ec2dc8c23e49467229bdd5d6f67f1498be7f9c", "git_parents": ["5ab4aaff8c6d492beaaa37fb580f52c598b35ba5"], "node": "b7ed04248f902cdf11e21cc147633a51745c4f64", "parents": ["ab21c6a4d4ad3c125d70e8bceb81cf9a1830af41"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091692 - Treat .inc files as required before compile. r=firefox-build-system-reviewers,sergesanspaille\n\nANGLE's Vulkan backend generates several .inc files at build time, which\nwe must ensure are generated before any code which tries to include them\nis compiled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341760\n", "files": ["python/mozbuild/mozbuild/frontend/data.py"], "git_node": "4f66461ac95d5ddf18db3dbe1ff1a86168d0333e", "git_parents": ["71ec2dc8c23e49467229bdd5d6f67f1498be7f9c"], "node": "a0298b84c775ab76237fdf349ea24944add8d845", "parents": ["b7ed04248f902cdf11e21cc147633a51745c4f64"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091692 - Escape commas when formatting generated file flags. r=firefox-build-system-reviewers,sergesanspaille\n\nVendoring ANGLE's Vulkan backend introduces GeneratedFiles with flags\nsuch as `--extinst=,\u003cpath\u003e`, i.e. containing a literal comma.\n\nWe shell-escape flags before writing them into $(call py_action, ...),\nso each flag reaches the script as a single shell argument. But `$(call\n...)` itself splits on unescaped commas in its own argument list before\nthe shell is ever involved, so a flag containing a comma is mistaken for\na boundary between py_action's own arguments.\n\nFix by escaping commas embedded within flags as `$(comma)`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341761\n", "files": ["config/makefiles/functions.mk", "python/mozbuild/mozbuild/backend/make.py", "python/mozbuild/mozbuild/test/backend/data/generated-files/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "bf7b7796413b402faea38df2e1a735ca7f0c5603", "git_parents": ["4f66461ac95d5ddf18db3dbe1ff1a86168d0333e"], "node": "20e664aec806ef63fad45411cd9a846c0a8dab32", "parents": ["a0298b84c775ab76237fdf349ea24944add8d845"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091692 - gn_processor.py: Include subdirs of root gen dir in LOCAL_INCLUDES. r=firefox-build-system-reviewers,sergesanspaille\n\ngn_processor.py has existing logic for ensuring the root `gen_path`\ndirectory is added to LOCAL_INCLUDES when required. However, some\ntargets may require a subdirectory of `gen_path` as an include dir. This\nensures that subdirectories of `gen_path` are also rebased correctly and\nadded to LOCAL_INCLUDES.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341762\n", "files": ["build/gn_processor.py"], "git_node": "818063d8091dced6e10bd939cd3564e7a610fec3", "git_parents": ["bf7b7796413b402faea38df2e1a735ca7f0c5603"], "node": "4abd206dd9aa61a82ec035d7aa1057e347e6b7b0", "parents": ["20e664aec806ef63fad45411cd9a846c0a8dab32"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088258 - One clean restart per test. r=sessionstore-reviewers,jswinarton\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339746\n", "files": ["browser/components/sessionstore/test/marionette/session_store_test_case.py"], "git_node": "975f2cc087d6bd7bde05c269894a607a9357bcff", "git_parents": ["818063d8091dced6e10bd939cd3564e7a610fec3"], "node": "537daf972ab277d412bb47813bfe68c81dead68e", "parents": ["4abd206dd9aa61a82ec035d7aa1057e347e6b7b0"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088258 - Let sessionstore marionette tests start up with prefs instead of restarting to apply them. r=sessionstore-reviewers,jswinarton\n\nTest classes can set startup_prefs, which the setup restart writes to the new profile's prefs.js. Unlike the user.js prefs from setUp, they aren't reapplied at later startups, so the browser can still change them. The sidebar tests use this instead of setting prefs and restarting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339747\n", "files": ["browser/components/sessionstore/test/marionette/session_store_test_case.py", "browser/components/sessionstore/test/marionette/test_restore_sidebar.py"], "git_node": "eef2a1a112845f0c9517ecd8f87902d3d6984c45", "git_parents": ["975f2cc087d6bd7bde05c269894a607a9357bcff"], "node": "f9b754b0f9e6c2d47f3487f69c01cfcc27ddb228", "parents": ["537daf972ab277d412bb47813bfe68c81dead68e"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087268 - Update sanitize dialog theme CSS so it passes use-design-tokens r=desktop-theme-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341522\n", "files": ["browser/themes/shared/sanitizeDialog_v2.css", "stylelint-rollouts.config.js"], "git_node": "108db1deb38570eb6d20d8049872107242f8ae86", "git_parents": ["eef2a1a112845f0c9517ecd8f87902d3d6984c45"], "node": "3ae0ece82c49660543c922dbc3e9061ba3396b68", "parents": ["f9b754b0f9e6c2d47f3487f69c01cfcc27ddb228"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 2084314 - Use viewLifecycleOwner with collectionStorageObserver r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342046\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt"], "git_node": "f7f87a78a3c593a9b7b4dac7bca5eac6a092f705", "git_parents": ["108db1deb38570eb6d20d8049872107242f8ae86"], "node": "b5d6968eb08bb7063803b280b8841244660d5242", "parents": ["3ae0ece82c49660543c922dbc3e9061ba3396b68"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2092031 - Clean up dom.shadowdom.shadowRootSlotAssignment.enabled flag r=webidl,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342103\n", "files": ["dom/base/nsContentUtils.cpp", "dom/html/HTMLTemplateElement.cpp", "dom/webidl/HTMLTemplateElement.webidl", "modules/libpref/init/StaticPrefList.yaml", "parser/html/nsHtml5TreeBuilderCppSupplement.h", "testing/web-platform/meta/shadow-dom/declarative/__dir__.ini"], "git_node": "aa997f16a0af91e83fe6894cf7e9c9fccb2c7517", "git_parents": ["f7f87a78a3c593a9b7b4dac7bca5eac6a092f705"], "node": "c231b1c598185e82e719dd92ab99988f20558c35", "parents": ["b5d6968eb08bb7063803b280b8841244660d5242"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 1966642 - Avoid linear scans of Http3Session stream queues on stream removal and shutdown. r=necko-reviewers,jesup\n\nSkipping the scans relies on IsInTxQueue() and Queued() accurately tracking\nqueue membership, which fixes two existing inconsistencies:\n\n- Every insertion into mReadyForWrite now goes through\n  AddStreamToReadyForWrite, so ProcessPending, FinishNegotiation and\n  Finish0Rtt no longer insert a stream that is already queued a second time.\n- RemoveStreamFromQueues now clears both flags. Previously a stream that\n  outlived the removal could keep IsInTxQueue() set, making later\n  StreamReadyToWrite calls no-ops, or keep Queued() set after Finish0Rtt,\n  making TryActivating return WOULD_BLOCK forever.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336989\n", "files": ["netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/Http3Session.h"], "git_node": "b30c6d947e1ddbc640b6d5bcc6c4adf03f0f9dd0", "git_parents": ["aa997f16a0af91e83fe6894cf7e9c9fccb2c7517"], "node": "d4c06ca9b66de7069c3b1522fb15e3616c8e6dc3", "parents": ["c231b1c598185e82e719dd92ab99988f20558c35"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2005419 - Run the TextDecoder state reset code on all return paths. r=platform-i18n-reviewers,jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322546\n", "files": ["dom/encoding/TextDecoder.cpp", "testing/web-platform/meta/encoding/textdecoder-mistakes.any.js.ini"], "git_node": "58945c971a0cdcf66b41945a17503353af3e52d6", "git_parents": ["b30c6d947e1ddbc640b6d5bcc6c4adf03f0f9dd0"], "node": "d45d13ff067dabd79754c41c80fad2d0cc7e3a2a", "parents": ["d4c06ca9b66de7069c3b1522fb15e3616c8e6dc3"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2091692 - gn_processor.py: Include subdirs of root gen dir in LOCAL_INCLUDES. r=firefox-build-system-reviewers,sergesanspaille\" for causing failures on test_xpi_archive.\n\nThis reverts commit 818063d8091dced6e10bd939cd3564e7a610fec3.\n\nRevert \"Bug 2091692 - Escape commas when formatting generated file flags. r=firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit bf7b7796413b402faea38df2e1a735ca7f0c5603.\n\nRevert \"Bug 2091692 - Treat .inc files as required before compile. r=firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit 4f66461ac95d5ddf18db3dbe1ff1a86168d0333e.\n\nRevert \"Bug 2091692 - Make file_generate_wrapper.py use cwd relative to topobjdir. r=firefox-build-system-reviewers,sylvestre,sergesanspaille\"\n\nThis reverts commit 71ec2dc8c23e49467229bdd5d6f67f1498be7f9c.\n", "files": ["build/gn_processor.py", "config/makefiles/functions.mk", "python/mozbuild/mozbuild/action/file_generate_wrapper.py", "python/mozbuild/mozbuild/backend/make.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/test/backend/data/generated-files/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "351f922d36c06a50e0ec142c193eac5bd11238b7", "git_parents": ["58945c971a0cdcf66b41945a17503353af3e52d6"], "node": "44d94d59a32259c5bd6d6ac168a359c5e18b1e47", "parents": ["d45d13ff067dabd79754c41c80fad2d0cc7e3a2a"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091785 - Part 1: Remove Nova-disabled test branches from newtab mochitests r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341878\n", "files": ["browser/extensions/newtab/test/browser/browser_as_render.js", "browser/extensions/newtab/test/browser/browser_customize_menu_content.js", "browser/extensions/newtab/test/browser/browser_discovery_render.js", "browser/extensions/newtab/test/browser/browser_newtab_header.js", "browser/extensions/newtab/test/browser/browser_newtab_last_LinkMenu.js", "browser/extensions/newtab/test/browser/browser_newtab_spaces.js"], "git_node": "6c5a9e0e59cf81b4004a1175f5c1296a7e3a72e5", "git_parents": ["351f922d36c06a50e0ec142c193eac5bd11238b7"], "node": "4b7903df37bae252ee9ad47a15a5c817345d5d2a", "parents": ["44d94d59a32259c5bd6d6ac168a359c5e18b1e47"], "tags": []}, {"author": "Sarah Clements \u003csclements@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082898 - Lock nova pref r=sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340958\n", "files": ["browser/app/profile/firefox.js"], "git_node": "be2b0fb66042e8a28229826439b3919e7ecb0ed8", "git_parents": ["6c5a9e0e59cf81b4004a1175f5c1296a7e3a72e5"], "node": "1240ef063d70685345f1399558afc03c32602591", "parents": ["4b7903df37bae252ee9ad47a15a5c817345d5d2a"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2092027 - Clean up dom.intersection_observer.scroll_margin.enabled flag r=webidl,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342099\n", "files": ["dom/webidl/IntersectionObserver.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/intersection-observer/__dir__.ini"], "git_node": "7f666c32ce7c9557a2810211e490ad94aedeabb3", "git_parents": ["be2b0fb66042e8a28229826439b3919e7ecb0ed8"], "node": "14da2bc446ce413670ff42a322c0b02af3360e47", "parents": ["1240ef063d70685345f1399558afc03c32602591"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076525 - Stack the Edit Clocks panel rows from the top. r=maxx\n\nBug 2053151 added justify-content: space-evenly to the edit list, which spread the rows down the whole panel. One clock ended up in the middle. This removes it and puts back the small top padding that change also dropped, so the first row doesn't touch the header.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341035\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Clocks/_Clocks.scss"], "git_node": "5aa4b6ce05b2988e3657f8c3a5631cdfdfcf2c4f", "git_parents": ["7f666c32ce7c9557a2810211e490ad94aedeabb3"], "node": "914f521533cef88d594a25969c054b904c1635d5", "parents": ["14da2bc446ce413670ff42a322c0b02af3360e47"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083804 - Expand Weather widget availability to more locales. r=maxx\n\nWeather was limited to locales in discoverystream.locale-weather-config. This removes that check from showWeather, making Weather available in every locale. The region list and Nimbus rollouts still control where it appears.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339260\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "fd3a0b292083db168fa7b0ad471332d4fa2e1dc1", "git_parents": ["5aa4b6ce05b2988e3657f8c3a5631cdfdfcf2c4f"], "node": "bcb6feedc48ebdba33b50ead124c84a3a4f7d3ec", "parents": ["914f521533cef88d594a25969c054b904c1635d5"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091956 - Ignore DataChannel open requests that arrive after the connection is destroyed. r=webrtc-reviewers,bwc\n\nThe main thread task posted for an incoming open request can run after\nDestroy() cleared mListener, for example when the page goes away while\nthe SCTP association is still coming up. The DataChannel created then\nnever gets an RTCDataChannel, so its StopGapEventTarget never gets a real\ntarget and the queued AnnounceClosed runnable keeps the channel and its\nconnection alive forever.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342041\n", "files": ["netwerk/sctp/datachannel/DataChannel.cpp"], "git_node": "17624682d0c842c57e46cfd373a113a8bc40a514", "git_parents": ["fd3a0b292083db168fa7b0ad471332d4fa2e1dc1"], "node": "4cfd4d52fa2243021150c090bee497d0205552b5", "parents": ["bcb6feedc48ebdba33b50ead124c84a3a4f7d3ec"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2091986 - Remove the cookie set by browser_thumbnails_bg_no_cookies_sent.js at the end of the test, r=firefox-desktop-core-reviewers ,mossop.\n\nThe color=green cookie stayed set for mochi.test, so a second run of the test found the page already green.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342129\n", "files": ["toolkit/components/thumbnails/test/browser_thumbnails_bg_no_cookies_sent.js"], "git_node": "0bce156df4387f17cf74e06256933505e6262304", "git_parents": ["17624682d0c842c57e46cfd373a113a8bc40a514"], "node": "f63658214e963a0880eb1b44527f9277fdd1d546", "parents": ["4cfd4d52fa2243021150c090bee497d0205552b5"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2022645 - Remove the wallet scheme handler in browser_protocol_ask_dialog_permission.js cleanup, r=firefox-desktop-core-reviewers ,mossop.\n\nThe cleanup only removed the handlers of TEST_PROTOS, so a second run of\nthe test found the moz-test-wallet handler still stored and failed the\nblank handler assertion in initTestHandlers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342131\n", "files": ["uriloader/exthandler/tests/mochitest/browser_protocol_ask_dialog_permission.js"], "git_node": "193d3393dbc2eace6d90374aeea4da7326d0c3be", "git_parents": ["0bce156df4387f17cf74e06256933505e6262304"], "node": "4ff072e1c89ad280896977b58206b51a26c68340", "parents": ["f63658214e963a0880eb1b44527f9277fdd1d546"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2091988 - Remove the panelview browser_981418-widget-onbeforecreated-handler.js creates, r=firefox-desktop-core-reviewers ,mossop.\n\nWhen the test runs again in the same window, the stale panelview shares its id with the new one, so the overflow panel shows the stale one and the test times out waiting for ViewShown on the new one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342132\n", "files": ["browser/components/customizableui/test/browser_981418-widget-onbeforecreated-handler.js"], "git_node": "1c431bb72bf81c6b92c7de284ce5ee014d2f5c8d", "git_parents": ["193d3393dbc2eace6d90374aeea4da7326d0c3be"], "node": "3f03eba4b1076343e5b602f29a6d64a001388337", "parents": ["4ff072e1c89ad280896977b58206b51a26c68340"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092058 - Remove the XUL button and destroy its widget at the end of browser_987177_destroyWidget_xul.js, r=firefox-desktop-core-reviewers ,mossop.\n\nThe button left in the palette by a first run made the old and new wrappers find a node in a second run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342136\n", "files": ["browser/components/customizableui/test/browser_987177_destroyWidget_xul.js"], "git_node": "5de4cb60b303340eb9f64916f239328df98a0498", "git_parents": ["1c431bb72bf81c6b92c7de284ce5ee014d2f5c8d"], "node": "dca824c24cff8360636e42706e3e3e045cdfadfe", "parents": ["3f03eba4b1076343e5b602f29a6d64a001388337"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092060 - Forget the test widget's seen state in browser_993322_widget_notoolbar.js, so it passes when run twice, r=firefox-desktop-core-reviewers ,mossop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342137\n", "files": ["browser/components/customizableui/test/browser_993322_widget_notoolbar.js"], "git_node": "007460942beea5209c7da240f275a59cdb4a31a0", "git_parents": ["5de4cb60b303340eb9f64916f239328df98a0498"], "node": "25e1c349c842ed4321c296bdc6fd792aef22d083", "parents": ["dca824c24cff8360636e42706e3e3e045cdfadfe"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092065 - Clear the client auth decisions remembered by originattributes/browser_clientAuth.js, r=firefox-desktop-core-reviewers ,mossop.\n\nA later run of the test would otherwise find the certificate remembered in\nevery tab and report the tabs as not isolated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342139\n", "files": ["browser/components/originattributes/test/browser/browser_clientAuth.js"], "git_node": "6bdb9857fabc223195f249b28e5e0839aa434cc0", "git_parents": ["007460942beea5209c7da240f275a59cdb4a31a0"], "node": "d7611cd9899465b47d8311ab4f9752f0449bd112", "parents": ["25e1c349c842ed4321c296bdc6fd792aef22d083"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092076 - Clear the cookie browser_save_link-perwindowpb.js sets, so the test passes when run again, r=firefox-desktop-core-reviewers ,mossop.\n\nThe first save sets a foopy cookie in the regular session; it outlived the test, so a second run's regular-window request sent it and no new cookie was set. The verify-standalone skip-if from bug 1995208 is no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342145\n", "files": ["browser/base/content/test/browser-general/browser.toml", "browser/base/content/test/browser-general/browser_save_link-perwindowpb.js"], "git_node": "bcc3739ee4b60d7dbae1c2500ac573fd7a9cb760", "git_parents": ["6bdb9857fabc223195f249b28e5e0839aa434cc0"], "node": "9b706d8f6412779b1dda436187b4e5edea441c9e", "parents": ["d7611cd9899465b47d8311ab4f9752f0449bd112"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1775943 - Wait for webrtcUI to forget every stopped stream in browser_stop_streams_on_indicator_close.js, r=firefox-desktop-core-reviewers ,mossop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342146\n", "files": ["browser/base/content/test/browser-webrtc/browser_stop_streams_on_indicator_close.js"], "git_node": "f248f44996fca95abae9dc72da5c68ac1eb83170", "git_parents": ["bcc3739ee4b60d7dbae1c2500ac573fd7a9cb760"], "node": "9da30f633d3bdfa88c01edd8a96dfca9a9587857", "parents": ["9b706d8f6412779b1dda436187b4e5edea441c9e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092082 - Destroy the test widget before resetting customization in browser_952963_areaType_getter_no_area.js, r=firefox-desktop-core-reviewers ,mossop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342147\n", "files": ["browser/components/customizableui/test/browser_952963_areaType_getter_no_area.js"], "git_node": "a65fa5dadc793c68603f6edec9e9d9d3e49457a2", "git_parents": ["f248f44996fca95abae9dc72da5c68ac1eb83170"], "node": "6a1cb93929366f01bbba4b80d8501b6096ca1fd8", "parents": ["9da30f633d3bdfa88c01edd8a96dfca9a9587857"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2068983 - Forget the test widgets' seen state in browser_vertical_tabs_default_area.js, r=firefox-desktop-core-reviewers ,mossop.\n\nCustomizableUI only auto-adds a widget id it hasn't seen before, so when the test ran a second time in the same browser every widget stayed unplaced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342148\n", "files": ["browser/components/customizableui/test/browser_vertical_tabs_default_area.js"], "git_node": "f3f8574cc437ecefb88f221292b18e23fbbdc24d", "git_parents": ["a65fa5dadc793c68603f6edec9e9d9d3e49457a2"], "node": "8c63d0866fabc466d2bdd916d84fa28b2d23e4b6", "parents": ["6a1cb93929366