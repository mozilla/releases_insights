: "2ac618f9cca8e2e948ac67bbd544848e4437fbe0", "parents": ["ac3d7bc5f304ea8dc00d30ce44f0fc5f92e3dcd9"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2089112: Remove the Windows Updatebot cron job r=firefox-build-system-reviewers,ahochheiden\n\nUpdatebot no longer runs anything on Windows, so remove the updatebot-cron-win\ntask along with its setup script, PHP config, arcanist patches, fetches, tooltool\nmanifest and worker-type alias, and the Windows code paths in run.py.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339687\n", "files": ["taskcluster/config.yml", "taskcluster/docker/updatebot/arcanist_patch_size.patch", "taskcluster/docker/updatebot/arcanist_windows_stream.patch", "taskcluster/docker/updatebot/run.py", "taskcluster/docker/updatebot/setup.sh", "taskcluster/docker/updatebot/windows-php.ini", "taskcluster/docker/updatebot/windows-setup.sh", "taskcluster/kinds/fetch/kind.yml", "taskcluster/kinds/fetch/updatebot.yml", "taskcluster/kinds/updatebot/kind.yml", "taskcluster/kinds/updatebot/tooltool-manifests/updatebot.manifest"], "git_node": "65895c2038e9dba901e21e276f8afc4b26394e80", "git_parents": ["19e7d5d9aafca72bf4a0621a39af66573ce8cdd4"], "node": "1266cec9f21b9d74b6951396106f0c2cd5bebb58", "parents": ["2ac618f9cca8e2e948ac67bbd544848e4437fbe0"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087908 - Replace AndroidAsync with mockwebserver3 in the GeckoView test server. r=geckoview-reviewers,ohall\n\nThe stall endpoint advertises one byte more than it sends so a download through it never completes. start()\nbinds the wildcard address directly because MockWebServer.start(port) resolves \"localhost\" on the calling\nthread, which is the main thread in GeckoSessionTestRule.\n\nAsset types now come from MimeTypeMap. Of the assets served, only the .ttf font changes type, and Gecko does\nnot check MIME types for fonts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338632\n", "files": ["mobile/android/geckoview/build.gradle", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/util/TestServer.kt"], "git_node": "c476cddcd015aab36c30f56feab827225e033e06", "git_parents": ["65895c2038e9dba901e21e276f8afc4b26394e80"], "node": "96c340a155694cbc36671b2e8dbeb51a0ea2d537", "parents": ["1266cec9f21b9d74b6951396106f0c2cd5bebb58"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088573 - Use NIGHTLY_BUILD instead of EARLY_BETA_OR_EARLIER to enable WebGPU. r=webidl,smaug,webgpu-reviewers,ErichDonGubler\n\nNothing uses the earlyBetaOrEarlier interface exposure key anymore, so the checker drops it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339689\n", "files": ["dom/serviceworkers/test/test_serviceworker_interfaces.js", "dom/tests/mochitest/general/interface_exposure_checker.js", "dom/tests/mochitest/general/test_interfaces.js", "dom/webgpu/tests/mochitest/mochitest-no-pref.toml", "dom/webgpu/tests/mochitest/mochitest-resistfingerprinting.toml", "dom/workers/test/navigator_worker.js", "dom/workers/test/test_worker_interfaces.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "e71ec6870452a47ee9ecd2dd8f1af848d1e802c2", "git_parents": ["c476cddcd015aab36c30f56feab827225e033e06"], "node": "8758d64e49b1703a7929d3aae9b7d9db3800d580", "parents": ["96c340a155694cbc36671b2e8dbeb51a0ea2d537"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058060 - Enable XInput2 on GTK 3.24.49+ in all channels. r=stransky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338617\n", "files": ["toolkit/xre/nsAppRunner.cpp"], "git_node": "cc2ebcbde3c11e350f0edc815678a5e07e4409b3", "git_parents": ["e71ec6870452a47ee9ecd2dd8f1af848d1e802c2"], "node": "3dfb367bab859858cbd57ace921663c487936e78", "parents": ["8758d64e49b1703a7929d3aae9b7d9db3800d580"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087980 - Apply [Tainted] to nsIPrincipal in IPDL r=ipc-reviewers,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331089\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/DOMTypes.ipdlh", "dom/ipc/IPCTransferable.ipdlh", "dom/ipc/PContent.ipdl", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/payments/ipc/PPaymentRequest.ipdl", "dom/webbrowserpersist/PWebBrowserPersistDocument.ipdl", "dom/webbrowserpersist/WebBrowserPersistDocumentParent.cpp", "dom/webbrowserpersist/WebBrowserPersistDocumentParent.h", "dom/workers/remoteworkers/RemoteWorkerTypes.ipdlh", "ipc/docs/ipdl.md", "ipc/glue/BackgroundParent.h", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/BackgroundParentImpl.h", "ipc/glue/URIParams.ipdlh", "ipc/ipdl/ipdl/type.py", "netwerk/ipc/PNecko.ipdl"], "git_node": "7bb5e017dfb98b8974d34c15923bb96c34aa47dd", "git_parents": ["cc2ebcbde3c11e350f0edc815678a5e07e4409b3"], "node": "dbc505dd7742553b0fa66d6896cce3639e54d541", "parents": ["3dfb367bab859858cbd57ace921663c487936e78"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089514 - Return the addition decode error from ProtocolParserProtobufV5::ProcessOneResponse (Coverity CIDs 1679306, 1678706, 1678345, 1678944) r=timhuang\n\nThe result of ProcessAddition{4,8,16,32}Bytes was overwritten by\nProcessRemoval or dropped, so an update whose added prefixes failed to\ndecode was still applied. Return it like the V4 parser does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339889\n", "files": ["toolkit/components/url-classifier/ProtocolParser.cpp"], "git_node": "f73fcd86c9d05a49a16e5d40ac10a05a251da41e", "git_parents": ["7bb5e017dfb98b8974d34c15923bb96c34aa47dd"], "node": "17a45ef22eb4b78177ba144874da1a24405edaf3", "parents": ["dbc505dd7742553b0fa66d6896cce3639e54d541"], "tags": []}, {"author": "JJ_EMPTY_STRING \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2079668 [Linux] Don't create EGLWindow for non-accelerated nsWindow r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333159\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "05f067e3f41a2fb6e3e95025627dc5514baf104b", "git_parents": ["f73fcd86c9d05a49a16e5d40ac10a05a251da41e"], "node": "b8c02e9a3428a908d5afef18ee1253f6d51c3cbf", "parents": ["17a45ef22eb4b78177ba144874da1a24405edaf3"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1883388 - Remove the --browsertime-upload-apk and --mozperftest-upload-apk options from mach try perf. r=perftest-reviewers,mozperftest-reviewers,sparky\n\nThese options copied a local APK in-tree so that raptor and mozperftest\nwould install it in place of the CI build. Remove them, along with the\nuser_upload.apk lookups in mozharness raptor and the mozperftest android\nlayer that only existed to support them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339542\n", "files": ["python/mozperftest/mozperftest/system/android.py", "python/mozperftest/mozperftest/tests/test_android.py", "testing/mozharness/mozharness/mozilla/testing/raptor.py", "testing/perfdocs/generated/mach-try-perf.md", "testing/performance/mach-try-perf/perfdocs/index.md", "tools/tryselect/selectors/perf.py", "tools/tryselect/test/test_perf.py"], "git_node": "45c08b33a2fdf0baa80f831d91de1e3e89889498", "git_parents": ["05f067e3f41a2fb6e3e95025627dc5514baf104b"], "node": "8d0373dda0fb872f505a52f4cdc90d7d19fc0545", "parents": ["b8c02e9a3428a908d5afef18ee1253f6d51c3cbf"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075832 - Stop waiting for the next chunk once a Smart Window chat request is aborted, r=mshillabeer.\n\nThe abort signal was only checked when a chunk arrived, so a request whose server stalled kept its closed window alive until the request finished.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337548\n", "files": ["browser/components/aiwindow/models/openAIEngine.sys.mjs", "browser/components/aiwindow/models/tests/xpcshell/test_Utils.js"], "git_node": "eecbfe1df702e9fb5a63d8c0d4bd3357838355a8", "git_parents": ["45c08b33a2fdf0baa80f831d91de1e3e89889498"], "node": "5e94bdcd0ae9572db752865a08873063ff4cdc44", "parents": ["8d0373dda0fb872f505a52f4cdc90d7d19fc0545"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089508 - Keep SnakeYAML class names in GeckoView's consumer rules r=ohall\n\nR8 obfuscation moves renamed classes into the root package, where SnakeYAML's static `getPackage().getName()` calls throw, crashing `DebugConfig.fromFile` in obfuscated apps whenever a test harness provides a config file.\n\n[here is a try](https://treeherder.mozilla.org/jobs?repo=try&revision=aa06c379f356dd2530426d42a6683afb4e2dada8)\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/434\n", "files": ["mobile/android/geckoview/proguard-rules.txt"], "git_node": "5b89fedac1496a836c713c2148fb86d8aada6f7c", "git_parents": ["eecbfe1df702e9fb5a63d8c0d4bd3357838355a8"], "node": "057a5ecddaef500be345a228b6e36fb0ae61bda7", "parents": ["5e94bdcd0ae9572db752865a08873063ff4cdc44"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089446 - Document updating one revision in a stack with moz-phab submit --single in the firefox-commits skill. r=ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339904\n", "files": [".agents/skills/firefox-commits/SKILL.md", ".claude/skills/firefox-commits/SKILL.md"], "git_node": "f7249eb0409