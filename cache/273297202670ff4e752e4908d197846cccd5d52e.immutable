1ddd97216bd194b8ed5b12a16", "54fe737cafd80c3757ce046a49bdc5d5d813165f", "a68e8655921ab8b8202a051c076b2cfb03d05196", "207a3dae4129a351c7f8974714562d5ae436407b", "ccd26bd4d58d02d13630b9fcd587a32081476ef6", "9d22d89b42b76dac19559500fc776731bd3fb96a", "df7cb126fe0dafe46d631e1dd6ed69e131c5cf6d", "ef4d8f09ec03bd79cb228a12a58eaf5d566333c0", "487ed5f79d2bd0f89cbebc4bd43c3f7b6980ac3b", "4eb31ae45d4fa5e8611b8d8934fb09f2f700f372", "d544b220f44890e7dedad53b6ba65a7f947a6e21", "c4b06718d8241dd94631ad4220f3ebac62b5f069", "0e6902a13cee000e7891b2bb9d14ca39582c2533"], "user": "pstanciu@mozilla.com"}, "45801": {"changesets": [{"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092309: Split browser_aswebauth_session.js into smaller test files. r=mac-reviewers,bradwerth\n\nIn test-verify's chaos mode, the file as a whole ran past the 180 second limit once bug 2088585 added the window geometry test. The shared helpers move to head_aswebauth.js and the tests themselves are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342785\n", "files": ["browser/modules/test/browser/browser.toml", "browser/modules/test/browser/browser_aswebauth_session.js", "browser/modules/test/browser/browser_aswebauth_session_cancel.js", "browser/modules/test/browser/browser_aswebauth_session_ephemeral.js", "browser/modules/test/browser/browser_aswebauth_session_window.js", "browser/modules/test/browser/head_aswebauth.js"], "git_node": "83a1ef1dd8aad72f7424de6b3e85252884cfa7a0", "git_parents": ["0e6902a13cee000e7891b2bb9d14ca39582c2533"], "node": "54534a5e37a9b806484653eee65310ccf5e2902c", "parents": ["5cf01bc240c97ade2f447325ee28344dd98416f0"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093155 - Update Address Bar team contact channels in the Firefox source docs. r=urlbar-reviewers,Standard8 DONTBUILD\n\nDeprecate the #search Slack channel in favor of #search-and-suggest. Also\nmention the public #search channel on Matrix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343000\n", "files": ["browser/components/urlbar/docs/contact.md"], "git_node": "40571803ce42521e03de3a7429e41df211fda0a3", "git_parents": ["83a1ef1dd8aad72f7424de6b3e85252884cfa7a0"], "node": "d2ff3f46132e49150e180de62c7196e8a7cff937", "parents": ["54534a5e37a9b806484653eee65310ccf5e2902c"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2092607 - Part 1: Fold SpiderMonkey-internal constants at compile time. r=jandem\n\nTempAllocator::BallastSize and the lazy proto tag were defined out of line,\nso every inline use loaded them from memory. In scalar replacement, the\nloaded ballast size was spilled and reloaded after every switch arm.\nWrapper::defaultProto no longer needs a static constructor, and the x86 SIMD\nconstants no longer need an initialization guard.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342787\n", "files": ["js/src/jit/Ion.cpp", "js/src/jit/JitAllocPolicy.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared-SIMD.cpp", "js/src/proxy/Proxy.cpp", "js/src/proxy/Wrapper.cpp", "js/src/vm/TaggedProto.h"], "git_node": "c09596f28056489bbd47a4054d4cb46e5872ec41", "git_parents": ["40571803ce42521e03de3a7429e41df211fda0a3"], "node": "a692f7fc5bdcbe3f082bb49bec7d902e54a78834", "parents": ["d2ff3f46132e49150e180de62c7196e8a7cff937"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2092607 - Part 2: Define the constant HandleValues in Value.h. r=jandem\n\nWith the definitions out of line, every use of UndefinedHandleValue and the\nother constant handles loaded the handle from memory. Defined inline, each use\nis a single address computation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342788\n", "files": ["js/public/CallArgs.h", "js/public/Value.h", "js/src/vm/Value.cpp"], "git_node": "d9de130bfd3b2956d8bdca60665d0655d1d0dcba", "git_parents": ["c09596f28056489bbd47a4054d4cb46e5872ec41"], "node": "5b1ef66452600c6c857633c385de87793632b42d", "parents": ["a692f7fc5bdcbe3f082bb49bec7d902e54a78834"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2092607 - Part 3: Remove FunctionClassPtr and FunctionExtendedClassPtr. r=jandem\n\nThese pointers are stored in memory, so every is\u003cJSFunction\u003e() computed the\naddress of each pointer and then loaded it. Comparing against the addresses of\nFunctionClass and ExtendedFunctionClass lets the compiler compare against them\nin one instruction each.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342789\n", "files": ["js/public/Class.h", "js/src/vm/JSFunction-inl.h", "js/src/vm/JSFunction.cpp", "js/src/vm/JSFunction.h"], "git_node": "40e7a6c44da0aa343795b62bd85f27d850ca7b1f", "git_parents": ["d9de130bfd3b2956d8bdca60665d0655d1d0dcba"], "node": "fe862f1bedb14d37b062812b736aa2746b230b09", "parents": ["5b1ef66452600c6c857633c385de87793632b42d"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093294 - Clear targetFunction for non-function guards during trial inlining. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343167\n", "files": ["js/src/jit-test/tests/warp/bug2093294.js", "js/src/jit/TrialInlining.cpp"], "git_node": "5170b5461731bff4e60f93b58ed329cd3a939a94", "git_parents": ["40e7a6c44da0aa343795b62bd85f27d850ca7b1f"], "node": "5c64db441e0751d6cd6b5c9a5cbe630599d7d263", "parents": ["fe862f1bedb14d37b062812b736aa2746b230b09"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093273 - Fix model picker labels when switching from Auto during single page onboarding r=pdahiya\n\nKeep Auto's label localized and ensure switching to a plain-text model\nlabel updates the button even when the underlying label values match.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343328\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-onboarding/smartwindow-onboarding.mjs", "browser/components/aiwindow/ui/components/smartwindow-option-select/smartwindow-option-select.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_option_select.js"], "git_node": "0f9f26fe2ba1e938179394469feb6ffeb77f7390", "git_parents": ["5170b5461731bff4e60f93b58ed329cd3a939a94"], "node": "1024643995c06d025c5457efa488b155d5e58034", "parents": ["5c64db441e0751d6cd6b5c9a5cbe630599d7d263"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2093858 - Skip swapchain compositing for empty integer dirty rectangles r=gfx-reviewers,bradwerth\n\nIn composite_simple(), clip the dirty rectangle to the device bounds and check whether it is empty after conversion to integer coordinates. For swapchain layers, skip the entire bind, draw, and present sequence when the resulting rectangle is empty.\n\nPass the same validated integer rectangle to both bind_layer() and present_layer(). Framebuffer compositing remains unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343373\n", "files": ["gfx/wr/webrender/src/renderer/composite.rs"], "git_node": "aa2b30cbb905dd3a2f4f3c5f980247e0c65bf9d6", "git_parents": ["0f9f26fe2ba1e938179394469feb6ffeb77f7390"], "node": "81c017d4115dc3f46e56ba9068e401070b05bffd", "parents": ["1024643995c06d025c5457efa488b155d5e58034"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092680: Define the Windows CPU architecture macro without a compile environment, so localized ARM64 installers say AArch64. r=firefox-build-system-reviewers,glandium\n\nBug 1906797 moved `_ARM64_`, `_AMD64_` and `_X86_` into `windows.configure`, which only runs with a compile environment. L10n repacks use `--disable-compile-environment`, so `defines.nsi.in` fell back to \"x64\" for ARM64 repacks. This moves the define to `init.configure`, for Windows targets, as `old-configure` did before.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343404\n", "files": ["build/moz.configure/init.configure", "build/moz.configure/windows.configure"], "git_node": "2ffe034397053b84e05543a224ebb438c661abae", "git_parents": ["aa2b30cbb905dd3a2f4f3c5f980247e0c65bf9d6"], "node": "1536502f52003ab4c0b04723060f449e2e4bc119", "parents": ["81c017d4115dc3f46e56ba9068e401070b05bffd"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093804 - Update PDF.js to 60aefc5b51d526e39bbcbae1c6cb760763b65b0a r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343354\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.renderer.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "80976b4a8517b3e3281aa055f06f4afd0cf36899", "git_parents": ["2ffe034397053b84e05543a224ebb438c661abae"], "node": "cbd005454de359aa128db34b208b88f5b1a7f378", "parents": ["1536502f52003ab4c0b04723060f449e2e4bc119"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e b66fdb05531527cbf36366c158e0e314f35367de\naf -\u003e b66fdb05531527cbf36366c158e0e314f35367de\nan -\u003e b66fdb05531527cbf36366c158e0e314f35367de\nar -\u003e b66fdb05531527cbf36366c158e0e314f35367de\nast -\u003e b66fdb05531527cbf36366c158e0e314f35367de\naz -\u0