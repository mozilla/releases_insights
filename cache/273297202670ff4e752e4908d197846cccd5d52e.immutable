iles": ["browser/base/content/nsContextMenu.sys.mjs", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/test/browser/browser_open_url.js", "browser/components/miniwindow/test/browser/browser_telemetry.js"], "git_node": "341c36dbe69f8c2f1ec5e080f95d4a43f3d86c71", "git_parents": ["530201dc3bd8fdea1e368ecd3dcd6de498f648fe"], "node": "a173870bf518f9c86999fbd191742bc55388d520", "parents": ["0a75ed07cb4988d4e9f8a8b594d509c17cb2c15c"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083998 - Allow opening links in a mini window from mini windows.r=niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343687\n", "files": ["browser/base/content/nsContextMenu.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_open_link_unsupported_windows.js", "browser/components/miniwindow/test/browser/browser_open_url.js"], "git_node": "aa839eba734d24cbaf4ef7de85936ede5e0807fe", "git_parents": ["341c36dbe69f8c2f1ec5e080f95d4a43f3d86c71"], "node": "5988b311e55a189856f9a86f7dbbe68103c44534", "parents": ["a173870bf518f9c86999fbd191742bc55388d520"], "tags": []}, {"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086044: Fixing the pref reset order in executormarionette.py, r=jgraham,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343353\n", "files": ["testing/web-platform/tests/tools/wptrunner/wptrunner/executors/executormarionette.py"], "git_node": "21eb1f353601a6e757c5fcebdd488f5d61571207", "git_parents": ["aa839eba734d24cbaf4ef7de85936ede5e0807fe"], "node": "badd66520c7c8a5b85ff0db38a4c86711cc47b29", "parents": ["5988b311e55a189856f9a86f7dbbe68103c44534"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090348 - [devtools] Do not set the cursor of a destroyed StyleSheetEditor. r=devtools-reviewers,bomsy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343949\n", "files": ["devtools/client/styleeditor/StyleEditorUI.sys.mjs"], "git_node": "15b9a9416ce7ec92c33f944e72514349f7e70942", "git_parents": ["21eb1f353601a6e757c5fcebdd488f5d61571207"], "node": "9b09d734f2adee8fc57c1ee35de774fb2dacb6d3", "parents": ["badd66520c7c8a5b85ff0db38a4c86711cc47b29"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087076 - [devtools] Wait for all threads in browser_dbg-content-script-sources.js. r=devtools-reviewers,bomsy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343943\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-content-script-sources.js"], "git_node": "0505ebfdc04f94d4a02d40ac8cb33560c028c193", "git_parents": ["15b9a9416ce7ec92c33f944e72514349f7e70942"], "node": "6b77b63551e26ca0c5ecf0e4aec4320a4697f745", "parents": ["9b09d734f2adee8fc57c1ee35de774fb2dacb6d3"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068884 - Enable alerting on JS shell benchmark subtests. r=perftest-reviewers,kshampur\n\nPerfherder only alerts on a subtest when it sets shouldAlert or its suite\nhas no summary value. Every jsshell-bench suite reports a summary, so set\nshouldAlert on the ares6, octane, six-speed and web-tooling-benchmark\nsubtests, except octane-score and web-tooling-benchmark-mean, which repeat\nthe suite value. Octane subtests also need lowerIsBetter, since Perfherder\ndefaults it to true.\n\nSubtests use a 5% alertThreshold instead of the 2% default to limit noise.\nsunspider subtests are not of interest, so sunspider keeps suite-level\nalerts only. The v8 shell comes from a toolchain and only changes on\ntoolchain bumps, so its suites no longer alert at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342706\n", "files": ["testing/jsshell/benchmark.py"], "git_node": "67fa20478b3dd5c91f0b4c63ce1a9cdce767bf05", "git_parents": ["0505ebfdc04f94d4a02d40ac8cb33560c028c193"], "node": "bc2c94558a0e59a6a29c5b0935c4190800b03e22", "parents": ["6b77b63551e26ca0c5ecf0e4aec4320a4697f745"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088982 - Use moz-src for toolkit/components/translations r=extension-reviewers,translations-reviewers,gregtatum,rpl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341270\n", "files": ["browser/base/content/test/browser-performance/browser_startup_content.js", "browser/components/translations/content/selectTranslationsPanel.js", "browser/components/translations/tests/browser/head.js", "dom/security/nsContentSecurityUtils.cpp", "toolkit/components/extensions/ExtensionContent.sys.mjs", "toolkit/components/extensions/parent/ext-i18n.js", "toolkit/components/reader/ReaderMode.sys.mjs", "toolkit/components/translations/LanguageDetector.sys.mjs", "toolkit/components/translations/actors/AboutTranslationsChild.sys.mjs", "toolkit/components/translations/actors/TranslationsParent.sys.mjs", "toolkit/components/translations/moz.build", "toolkit/components/translations/tests/unit/test_cld2.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "abc222b8cd19a8efcf37fec3704bda95911c2e6c", "git_parents": ["67fa20478b3dd5c91f0b4c63ce1a9cdce767bf05"], "node": "c8f4b587b1905d397caad8ba1991d30646a34112", "parents": ["bc2c94558a0e59a6a29c5b0935c4190800b03e22"], "tags": []}, {"author": "Ben Dean-Kawamura \u003cbdk@mozilla.com\u003e", "branch": "default", "desc": "No bug: fix breadcrumb deserialization errors, r=sfamisa,android-reviewers\n\nSegun noticed deserialization errors in a recent build.  The reason is\nthat `message` is one of the fields that isn't stored in the JSON blob,\nit's part of the struct itself.  This means we don't need any\ndeserialization at all which simplifies things.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344090\n", "files": ["mobile/android/android-components/components/support/appservices/build.gradle", "mobile/android/android-components/components/support/appservices/src/main/java/mozilla/components/support/rusterrors/RustErrors.kt"], "git_node": "333dd84cdcb285c10d6f8ac0ff99636725a2062a", "git_parents": ["abc222b8cd19a8efcf37fec3704bda95911c2e6c"], "node": "943f833fcc5a8bc7cbedd52f2b902bc4ac130a0c", "parents": ["c8f4b587b1905d397caad8ba1991d30646a34112"], "tags": []}, {"author": "andyh \u003candhuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091687 - Fix carousel navigation pill button text truncation. r=omc-reviewers,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344059\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "68df633f59079823756c1b45f2fed16ba6b84d2d", "git_parents": ["333dd84cdcb285c10d6f8ac0ff99636725a2062a"], "node": "542277633fa43e4db17e3dde9a48390fa8570574", "parents": ["943f833fcc5a8bc7cbedd52f2b902bc4ac130a0c"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091809: Don't enter JIT code from C++ for functions with too many formals r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343769\n", "files": ["js/src/jit-test/tests/basic/many-formals-enter-jit.js", "js/src/jit/BaselineJIT.cpp", "js/src/jit/Jit.cpp"], "git_node": "c7cdf0d0c80a1e7eeec34bcc370f9147b0cf6a96", "git_parents": ["68df633f59079823756c1b45f2fed16ba6b84d2d"], "node": "723a9f01116936dfc56e0c7226c1d49cccb59f4f", "parents": ["542277633fa43e4db17e3dde9a48390fa8570574"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091809: Don't call functions with too many formals from CacheIR stubs r=jandem\n\nClaude's initial prototype added a whole new op here, but I think it's simpler and more robust to make it part of the existing guard.\n\nIn Ion, calls to unknown targets go through the generic call trampoline or the emitApplyGeneric/emitConstructGeneric cases for spread calls. The generic call trampoline already handles this case in generateIonGenericHandleUnderflow. The spread/apply case is fixed in the next patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343771\n", "files": ["js/src/jit-test/tests/cacheir/many-formals-call.js", "js/src/jit/CacheIR.cpp", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CacheIROps.yaml", "js/src/jit/WarpCacheIRTranspiler.cpp", "js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "8129f1f202468ecaa77433389a5f0b9158118776", "git_parents": ["c7cdf0d0c80a1e7eeec34bcc370f9147b0cf6a96"], "node": "08766ba5039e4bf3e0ad57dbc4a012f2fae4b80e", "parents": ["723a9f01116936dfc56e0c7226c1d49cccb59f4f"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091809: Call functions through the VM from Ion apply calls if too many arguments are missing r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343774\n", "files": ["js/src/jit-test/tests/ion/many-formals-apply.js", "js/src/jit/CodeGenerator.cpp"], "git_node": "8d5cee00458f3ce2c1762f54ff71189319a46a99", "git_parents": ["8129f1f202468ecaa77433389a5f0b9158118776"], "node": "e0c4193fe760427542e371f5f6b11f80fee0e095", "parents": ["08766ba5039e4bf3e0ad57dbc4a012f2fae4b80e"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091809: Resume generators with too many formals in the VM r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343775\n", "files": ["js/src/jit-test/tests/generators/many-formals-resume.js", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/Lowering.cpp", "js/src/jit/VMFunctionList-inl.h", "js/src/jit/VMFunctions.cpp", "js/src/jit/VMFunctions.h"], "git_node": "bef977666c129ec94475a493a85b37c8a1892735", "git_parents": ["8d5cee00458f3ce2c1762f54ff71189319a46a99"], "node": "54fda3ccfdea707b4de8acb92c2b5189a8dbb36e", "parents": ["e0c4193fe760427542e371f5f6b11f80fee0e095"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091809: Don't call sort comparators with too many formals from JIT code r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343776\n", "files": ["js/src/builtin/Sorting-inl.h", "js/src/jit-test/tests/basic/many-formals-sort-comparator.js"], "git_node": "ca1bcccd098515f6eb3b40838a57207afff0e5e4", "git_parents": ["bef977666c129ec94475a493a85b37c8a1892735"], "node": "692b6eb6082a42dc63278e7d34ffebbe329ae11f", "parents": ["54fda3ccfdea707b4de8acb92c2b5189a8dbb36e"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089109 - upgrade NSS to NSS_3_134_RTM. r=keeler UPGRADE_NSS_RELEASE\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344082\n", "files": ["security/nss/.claude/skills/nss-review/SKILL.md", "security/nss/TAG-INFO", "security/nss/automation/release/nspr-version.txt", "security/nss/cmd/certutil/certutil.c", "security/nss/cmd/certutil/keystuff.c", "security/nss/doc/src/releases/index.md", "security/nss/doc/src/releases/nss_3_134.md", "security/nss/gtests/common/util.h", "security/nss/gtests/pk11_gtest/pk11_eddsa_unittest.cc", "security/nss/gtests/pk11_gtest/pk11_import_unittest.cc", "security/nss/gtests/pk11_gtest/pk11_keygen.cc", "security/nss/gtests/pk11_gtest/pk11_keygen.h", "security/nss/gtests/pk11_gtest/pk11_signature_test.cc", "security/nss/gtests/pk11_gtest/pk11_signature_test.h", "security/nss/gtests/pk11_gtest/pk11_x25519_unittest.cc", "security/nss/gtests/softoken_gtest/softoken_gtest.cc", "security/nss/gtests/ssl_gtest/ssl_ecdh_unittest.cc", "security/nss/lib/certdb/certdb.c", "security/nss/lib/certdb/certt.h", "security/nss/lib/nss/nss.h", "security/nss/lib/pk11wrap/pk11auth.c", "security/nss/lib/pk11wrap/pk11cert.c", "security/nss/lib/pk11wrap/pk11pk12.c", "security/nss/lib/pk11wrap/pk11slot.c", "security/nss/lib/softoken/lowkey.c", "security/nss/lib/softoken/pkcs11.c", "security/nss/lib/softoken/pkcs11i.h", "security/nss/lib/softoken/pkcs11u.c", "security/nss/lib/softoken/sftkpwd.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/ssl/ssl3con.c", "security/nss/lib/ssl/sslsecur.c", "security/nss/lib/ssl/sslsnce.c", "security/nss/lib/ssl/sslsock.c", "security/nss/lib/ssl/tls13con.c", "security/nss/lib/util/eccutil.h", "security/nss/lib/util/nssutil.h", "security/nss/moz.yaml", "security/nss/review-context.toml", "security/nss/tests/chains/chains.sh", "security/nss/tests/chains/scenarios/mlkem_leaf.cfg"], "git_node": "056979dbdbefd406e7ab7437c53fb0bed8fbbd03", "git_parents": ["ca1bcccd098515f6eb3b40838a57207afff0e5e4"], "node": "8b3b20298e01ff8dc5a87daed6a9a8e0977ff3d0", "parents": ["692b6eb6082a42dc63278e7d34ffebbe329ae11f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094461 - Replace the deprecated accessibility APIs in SessionAccessibility where possible. r=geckoview-reviewers,accessibility-platform-reviewers,eeejay,ohall\n\naddAction(int) only looks up the matching AccessibilityAction singleton and adds it, so the\nAccessibilityAction constants are exact equivalents. getNodeFromGecko now reads the client bounds that\npopulateNodeInfo stores back as screen bounds instead of bounds in parent.\n\nThe remaining uses are suppressed in the narrowest scope: the obtain() factories until minSdk reaches 30\n(their constructors need API 30, and obtain() is plain construction once pooling is gone), the\nsetChecked(boolean) branch until minSdk reaches 36, and setBoundsInParent, which has no replacement and still\nfeeds the bounds View.onProvideVirtualStructure reports.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343807\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": "4211a02759f8413493b6f2c9becad805698d3ea9", "git_parents": ["056979dbdbefd406e7ab7437c53fb0bed8fbbd03"], "node": "76df3ceeeb1b996c3c84c47103e92486fa44f4e4", "parents": ["8b3b20298e01ff8dc5a87daed6a9a8e0977ff3d0"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083998 - Allow opening links in a mini window from mini windows.r=niklas\" for causing bc failures in browser_contextmenu.js\n\nThis reverts commit aa839eba734d24cbaf4ef7de85936ede5e0807fe.\n\nRevert \"Bug 2083998 - Keep the container and referrer when opening a link in a mini window. r=kpatenio\"\n\nThis reverts commit 341c36dbe69f8c2f1ec5e080f95d4a43f3d86c71.\n\nRevert \"Bug 2083998 - Add url as a new mini window flavour to collect telemetry for mini windows opened from links. r=niklas\"\n\nThis reverts commit 530201dc3bd8fdea1e368ecd3dcd6de498f648fe.\n\nRevert \"Bug 2083998 - Wire open link mini window behavior to the link context menu. r=niklas,fluent-reviewers,bolsson\"\n\nThis reverts commit 40b345606e536a4ef0d0539670780daacc2f2a83.\n\nRevert \"Bug 2083998 - Add the ability to open a new url in a mini window. r=mconley,tabbrowser-reviewers,niklas\"\n\nThis reverts commit 4b3ae8b88673f00e5a8ddec0653f136487575b85.\n", "files": ["browser/base/content/browser-context.inc.xhtml", "browser/base/content/browser-context.js", "browser/base/content/browser-init.js", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/browser-contextMenu/browser_contextmenu.js", "browser/base/content/test/browser-sync/browser_contextmenu_sendpage.js", "browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/metrics.yaml", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_context_menu_badge.js", "browser/components/miniwindow/test/browser/browser_open_link_unsupported_windows.js", "browser/components/miniwindow/test/browser/browser_open_url.js", "browser/components/miniwindow/test/browser/browser_telemetry.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/locales/en-US/browser/browserContext.ftl", "browser/locales/en-US/browser/miniWindow.ftl", "browser/modules/URILoadingHelper.sys.mjs"], "git_node": "a5fbdaa4289e903488a2e7261556b1704ddfee25", "git_parents": ["4211a02759f8413493b6f2c9becad805698d3ea9"], "node": "f8a4119b18878c5c8428d7508df5c49559f57bc4", "parents": ["76df3ceeeb1b996c3c84c47103e92486fa44f4e4"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094717 - Vendor application-services to af1ea21aef8b44f535b5a343daeb97ced0d4faee r=bdk\n\nThe workspace hack gains the empty uniffi-bindgen-library-mode feature that the vendored\nuniffi-bindgen-library-mode now names.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344028\n", "files": ["Cargo.lock", "build/workspace-hack/Cargo.toml", "third_party/application-services/automation/kotlin-components-docs/build.gradle", "third_party/application-services/build-scripts/component-common.gradle", "third_party/application-services/components/fxcontainers/src/definitions.rs", "third_party/application-services/components/init_rust_components/android/build.gradle", "third_party/application-services/megazords/full/android/build.gradle", "third_party/application-services/megazords/ios-rust/Cargo.toml", "third_party/application-services/megazords/ios-rust/focus/Cargo.toml", "third_party/application-services/megazords/ios-rust/focus/src/lib.rs", "third_party/application-services/megazords/ios-rust/src/lib.rs", "third_party/application-services/moz.yaml", "third_party/application-services/publish.gradle", "third_party/application-services/settings.gradle", "third_party/application-services/tools/uniffi-bindgen-library-mode/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFxcontainers.sys.mjs"], "git_node": "cdbe969d5f54344e3a7fac44883de912476d02cc", "git_parents": ["a5fbdaa4289e903488a2e7261556b1704ddfee25"], "node": "62620ccb3ee8b68755b21bf60e021da0b4994191", "parents": ["f8a4119b18878c5c8428d7508df5c49559f57bc4"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094717 - Remove the unused gradle-python-envs plugin from the version catalog r=android-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344029\n", "files": ["gradle/libs.versions.toml"], "git_node": "4a0bc97dfda7a8e1318d4f4ae8cc497e0cddf6c6", "git_parents": ["cdbe969d5f54344e3a7fac44883de912476d02cc"], "node": "8cf71857e6beb50ef35f32b8242bd0e2ea8a64aa", "parents": ["62620ccb3ee8b68755b21bf60e021da0b4994191"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094717 - Update android nightly application-services version bump to af1ea21aef8b44f535b5a343daeb97ced0d4faee r=android-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344064\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "e952f62fb37bc91951e3c67c9011d81780b3d952", "git_parents": ["4a0bc97dfda7a8e1318d4f4ae8cc497e0cddf6c6"], "node": "3522b1f3e1685df6d7654155a27382945b4a5c22", "parents": ["8cf71857e6beb50ef35f32b8242bd0e2ea8a64aa"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094699 - Enable Listen to Page in Beta r=android-reviewers,zfatima\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343988\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml"], "git_node": "d1612358cb74110abdb22af5ced5ec32cea8b39c", "git_parents": ["e952f62fb37bc91951e3c67c9011d81780b3d952"], "node": "d8550be3ec3256270a13188d1e3f59fbe49824ab", "parents": ["3522b1f3e1685df6d7654155a27382945b4a5c22"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094424 - write Smart Window Fluent IDs in full and lint against building them from template strings r=pdahiya,frontend-codestyle-reviewers\n\ninput-cta and AgentUI map keys to complete IDs, and an aiwindow-scoped no-restricted-syntax block flags template strings or + concatenations that start with a Smart Window Fluent prefix or interpolate into a quoted data-l10n-id\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343787\n", "files": ["browser/components/aiwindow/ui/components/input-cta/input-cta.mjs", "browser/components/aiwindow/ui/modules/AgentUI.sys.mjs", "eslint.config.mjs"], "git_node": "d06936db045322bb2cc34114810ffb1b780950b0", "git_parents": ["d1612358cb74110abdb22af5ced5ec32cea8b39c"], "node": "122b6db573e3c36345a29797e415a624184fdcbf", "parents": ["d8550be3ec3256270a13188d1e3f59fbe49824ab"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092549 - Run the startup default browser check in browser_browserGlue_fxa_client_info_ping.js so it can run twice in the same browser, r=markh.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342583\n", "files": ["browser/components/tests/browser/browser_browserGlue_fxa_client_info_ping.js"], "git_node": "18ea936e5b4dd04a9df5b31606b46d7a1fbffda6", "git_parents": ["d06936db045322bb2cc34114810ffb1b780950b0"], "node": "70249e468d8eeee799972f3c8fd3b6ee1df5ed2b", "parents": ["122b6db573e3c36345a29797e415a624184fdcbf"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2087533 - Run copies of each xpcshell test concurrently in test-verify, r=ahal,mozbase-reviewers.\n\nRunning a test only sequentially misses the failures caused by running it\nconcurrently with other tests, as regular xpcshell jobs do. Chaos mode also\nstayed enabled for the tests verified after the first one. Copies are logged\nas \"\u003ctest\u003e#\u003cn\u003e\" because mozlog rejects concurrent test_start for one test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338888\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "6094c2826eebb0c00c5b7171d30550b5c1c9e4b5", "git_parents": ["18ea936e5b4dd04a9df5b31606b46d7a1fbffda6"], "node": "c12e7e1eb1f11ef0c12b64429b29c585dfb31440", "parents": ["70249e468d8eeee799972f3c8fd3b6ee1df5ed2b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086055 - Part 4: Reject test-verify-path paths without a test manifest in them or in a direct subdirectory, r=taskgraph-reviewers,bhearsum.\n\nThis avoids verifying a whole tree by mistake. `mach try` checks the paths\nbefore pushing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338891\n", "files": ["tools/tryselect/push.py", "tools/tryselect/tasks.py", "tools/tryselect/test/test_push.py"], "git_node": "fc19214d4871adff4e8b6b33e2fe1dd95ab24740", "git_parents": ["6094c2826eebb0c00c5b7171d30550b5c1c9e4b5"], "node": "462fe2a99fa2f151b4364118189d346d2d25c36f", "parents": ["c12e7e1eb1f11ef0c12b64429b29c585dfb31440"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2094529 - Release the transaction scheduler outside the monitor in RemoteTextureMap::WaitForTxn() r=gfx-reviewers,bradwerth\n\nDeclare the scheduler\u2019s RefPtr before MonitorAutoLock so it is released after the monitor is unlocked, including on early returns. This prevents the scheduler\u2019s destructor from attempting to reacquire mMonitor while it is already held.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343851\n", "files": ["gfx/layers/RemoteTextureMap.cpp"], "git_node": "a97f9c7081334bbf200ddf0e4a04a44e0489ffc0", "git_parents": ["fc19214d4871adff4e8b6b33e2fe1dd95ab24740"], "node": "787aa6b7551f5b470b3ddab6953fff3ba7000d29", "parents": ["462fe2a99fa2f151b4364118189d346d2d25c36f"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089597 - nsBaseHashTable: rename PtrGetWeak to GetRawPtr. r=xpcom-reviewers,necko-reviewers,webrtc-reviewers,dom-storage-reviewers,layout-reviewers,gamepad-reviewers,chumphreys,jesup,bwc,saschanaz,emilio,janv\n\nPtrGetWeak is a confusing name, because it seems to refer to a smart pointer that keeps track of the underlying object's lifetime (like our WeakPtr or ThreadSafeWeakPtr classes, or something like std::weak_ptr). But it actually returns a raw pointer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340011\n", "files": ["accessible/base/DocManager.cpp", "chrome/nsChromeRegistryChrome.cpp", "dom/base/Document.cpp", "dom/base/RadioGroupContainer.cpp", "dom/base/nsDOMAttributeMap.cpp", "dom/base/nsFrameMessageManager.cpp", "dom/base/nsGlobalWindowInner.cpp", "dom/base/nsGlobalWindowInner.h", "dom/base/nsWindowMemoryReporter.cpp", "dom/commandhandler/nsCommandManager.cpp", "dom/events/PointerEventHandler.cpp", "dom/file/uri/BlobURLProtocolHandler.cpp", "dom/gamepad/GamepadManager.cpp", "dom/indexedDB/ActorsParent.cpp", "dom/ipc/SharedMap.cpp", "dom/localstorage/ActorsParent.cpp", "dom/localstorage/LSWriteOptimizer.cpp", "dom/media/systemservices/MediaParent.cpp", "dom/storage/LocalStorageManager.cpp", "dom/storage/SessionStorageManager.cpp", "dom/webbrowserpersist/nsWebBrowserPersist.cpp", "gfx/layers/CompositorAnimationStorage.cpp", "gfx/layers/wr/AsyncImagePipelineManager.cpp", "gfx/thebes/gfxFcPlatformFontList.cpp", "layout/base/ContainStyleScopeManager.cpp", "layout/base/nsCounterManager.cpp", "layout/base/nsRefreshDriver.cpp", "modules/libpref/Preferences.cpp", "netwerk/cache2/CacheStorageService.cpp", "netwerk/dns/nsHostResolver.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/PendingTransactionQueue.cpp", "netwerk/protocol/http/nsHttpConnectionMgr.cpp", "netwerk/streamconv/nsStreamConverterService.cpp", "storage/mozStorageBindingParams.cpp", "toolkit/components/telemetry/core/TelemetryEvent.cpp", "toolkit/components/telemetry/core/TelemetryHistogram.cpp", "toolkit/components/telemetry/core/TelemetryScalar.cpp", "toolkit/components/url-classifier/LookupCache.cpp", "toolkit/components/url-classifier/LookupCacheV4.cpp", "toolkit/components/url-classifier/RealTimeRequestSimulator.cpp", "toolkit/components/url-classifier/tests/gtest/Common.cpp", "toolkit/components/url-classifier/tests/gtest/TestProtocolParser.cpp", "toolkit/components/url-classifier/tests/gtest/TestUrlClassifierTableUpdateV4.cpp", "xpcom/base/nsINIParser.cpp", "xpcom/components/nsCategoryManager.cpp", "xpcom/ds/nsBaseHashtable.h", "xpcom/ds/nsHashPropertyBag.cpp", "xpcom/ds/nsTHashSet.h", "xpcom/tests/gtest/TestHashtables.cpp"], "git_node": "ace887715a4e56f3423632cd4477ac99f0f939e6", "git_parents": ["a97f9c7081334bbf200ddf0e4a04a44e0489ffc0"], "node": "213840d3d424ea05aeb2aca859ca1ae98bc9ef85", "parents": ["787aa6b7551f5b470b3ddab6953fff3ba7000d29"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091523 - Build mingw plugin-container, private_browsing and windbgdlg as GUI programs. r=firefox-build-system-reviewers,yjuglaret,ahochheiden\n\nWINCONSOLE now sets the subsystem of every C and C++ Windows program, including in directories that set\nnothing else in WIN32_EXE_LDFLAGS. On mingw, private_browsing, windbgdlg and, in non-debug builds,\nplugin-container become GUI programs again, as their WINCONSOLE = False asks and as they were before bug\n1972782. On clang-cl, where the linker already picked the same subsystems from the entry points, programs such\nas crashhelper, pingsender, private_browsing and the C++ unit tests get subsystem version 10.0, like\nfirefox.exe, instead of 6.0.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342784\n", "files": ["python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/test/frontend/data/winconsole-default/moz.build", "python/mozbuild/mozbuild/test/frontend/data/winconsole-false/moz.build", "python/mozbuild/mozbuild/test/frontend/data/winconsole-true/moz.build", "python/mozbuild/mozbuild/test/frontend/test_emitter.py"], "git_node": "3b8e2344442939e012b8086db99633b3d9c05393", "git_parents": ["ace887715a4e56f3423632cd4477ac99f0f939e6"], "node": "135baf0412549b3bf012bfd5d9198b9a02f96881", "parents": ["213840d3d424ea05aeb2aca859ca1ae98bc9ef85"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add a characterization for OPFS behavior for model downloading; r=nordzilla,ai-platform-reviewers\n\nThis is a test to show the current behavior of OPFS with a private browsing\nwindow, when you get a somewhat spurious error when a Private Browsing\nwindow just happens to be on top. This sets the stage for the following\nfix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328143\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_opfs_private_window.js"], "git_node": "de48c168a8bd4ab2935161f170012e1cd57de388", "git_parents": ["3b8e2344442939e012b8086db99633b3d9c05393"], "node": "49c85e3b8ac8b980a869f8c465daae0ae0f8b7cd", "parents": ["135baf0412549b3bf012bfd5d9198b9a02f96881"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Remove incorrect isPrivateBrowsing call and test; r=nordzilla,ai-platform-reviewers\n\nThis code uses the most recent browsing window, and doesn't work correctly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328144\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/content/Utils.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_privatebrowsing.js"], "git_node": "7fa219157075d347838428fc30cfb4db70faaf1f", "git_parents": ["de48c168a8bd4ab2935161f170012e1cd57de388"], "node": "e8e724b22e46b177c6af0c1b898c9121ba74296c", "parents": ["49c85e3b8ac8b980a869f8c465daae0ae0f8b7cd"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Re-work OPFS.sys.mjs to pass TypeScript and remove dead code; r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328145\n", "files": ["toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/content/Utils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_cache.js"], "git_node": "232fa5bce31b30f5203e70a7cd678b35f7d80ae4", "git_parents": ["7fa219157075d347838428fc30cfb4db70faaf1f"], "node": "eb26ced07c6f98a2cd6a222887cfa92313689a20", "parents": ["e8e724b22e46b177c6af0c1b898c9121ba74296c"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Remove OPFS usage in workers; r=nordzilla,ai-platform-reviewers\n\nThe inference process workers reached OPFS through their own global, which\nmeant two code paths for the same storage and a copy of the file lookup in\neach pipeline. The parent already reads the file when it resolves a model, so\nhave it send the blob rather than a path, and let the worker build the\nResponse it needs from that.\n\nImporting OPFS into a worker also failed outright, since its XPCOMUtils\nimport needs a privileged global: browser_ml_native_backend_error.js and\nbrowser_ml_smollm2_chat.js both died with \"Cu is not defined\" before this.\n\nWith nothing loading OPFS outside the parent, the worker plumbing goes too.\nOPFS.toResponse had no other caller, and the module no longer needs the\nIN_WORKER branch or the globalThis.navigator fallback.\n\nThe OPFS tests still cover toResponse and are fixed up later in the series.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328146\n", "files": ["toolkit/components/ml/actors/MLEngineChild.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/MLEngine.worker.mjs", "toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/content/backends/LlamaCppPipeline.mjs", "toolkit/components/ml/content/backends/StaticEmbeddingsPipeline.mjs", "toolkit/components/ml/tests/browser/browser_ml_opfs.js"], "git_node": "222a5578a99727bc395fa2bd7ad86d0bfe9d3477", "git_parents": ["232fa5bce31b30f5203e70a7cd678b35f7d80ae4"], "node": "9ccc80fc7e93431fda09703fe27975877da71226", "parents": ["eb26ced07c6f98a2cd6a222887cfa92313689a20"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add type checking to ModelHub.sys.mjs r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339596\n", "files": ["toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/ml.d.ts"], "git_node": "64344499332ae83af9223344a1dd6d7dd335895e", "git_parents": ["222a5578a99727bc395fa2bd7ad86d0bfe9d3477"], "node": "0d4845787775eb190c46ab20928a267ab780c6fd", "parents": ["9ccc80fc7e93431fda09703fe27975877da71226"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add a mock model hub r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339597\n", "files": ["toolkit/components/ml/tests/MLTestUtils.sys.mjs"], "git_node": "00694932e14ababf8f6b20e7b7fb24428c4b58ed", "git_parents": ["64344499332ae83af9223344a1dd6d7dd335895e"], "node": "4ecc2f86c43f4d1625319ed6f29ff36fb003fe72", "parents": ["0d4845787775eb190c46ab20928a267ab780c6fd"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for downloading and caching model files r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339598\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_download.js"], "git_node": "2b1e09622d278fa28bf59eb7aa0ba974cd0f73dc", "git_parents": ["00694932e14ababf8f6b20e7b7fb24428c4b58ed"], "node": "16aa4ff68ddb024cb972a24feb6d21d46863d61a", "parents": ["4ecc2f86c43f4d1625319ed6f29ff36fb003fe72"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for engine downloads through the model hub r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339599\n", "files": ["toolkit/components/ml/tests/MLTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_engine_e2e.js", "toolkit/components/ml/tests/browser/ml_model_hub_echo_stub.worker.mjs"], "git_node": "488ea27f4ed48c97fc8141bb6c49f207da37fae2", "git_parents": ["2b1e09622d278fa28bf59eb7aa0ba974cd0f73dc"], "node": "dacd4d422507511fb82c2f68716612ac3e5a3aaf", "parents": ["16aa4ff68ddb024cb972a24feb6d21d46863d61a"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for failed and retried downloads r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339600\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_download_failures.js"], "git_node": "7b7fd3527e94ab71818e0925a9b853b665f39365", "git_parents": ["488ea27f4ed48c97fc8141bb6c49f207da37fae2"], "node": "7f8fdb2aa71fb1327cf56321947efcffa4cab976", "parents": ["dacd4d422507511fb82c2f68716612ac3e5a3aaf"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for ETag revalidation r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339601\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_etag.js"], "git_node": "1a6a93bd2853e955c644a34aae5eecb825d20161", "git_parents": ["7b7fd3527e94ab71818e0925a9b853b665f39365"], "node": "3e50c16267e690000f10fafea58288c9d400ceb3", "parents": ["7f8fdb2aa71fb1327cf56321947efcffa4cab976"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for deleting models r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339602\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_delete.js"], "git_node": "c99b7297a6ae6f26c2add3a7d224425a523fbc0d", "git_parents": ["1a6a93bd2853e955c644a34aae5eecb825d20161"], "node": "aec9098955eb95d5b8270af03e975bc070022fb6", "parents": ["3e50c16267e690000f10fafea58288c9d400ceb3"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for the model hub denylist and listing r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339603\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_denylist.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_list.js"], "git_node": "0ad9c5eb29170d5be2c833448f9ed957c043d63d", "git_parents": ["c99b7297a6ae6f26c2add3a7d224425a523fbc0d"], "node": "10407c26a6acdb4e9c8de95216c7cae03b9747c5", "parents": ["aec9098955eb95d5b8270af03e975bc070022fb6"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Restore MOZ_ALLOW_EXTERNAL_ML_HUB after the tests that set it r=nordzilla,ai-platform-reviewers\n\nbrowser_ml_engine_e2e.js and browser_ml_telemetry.js set the variable and never\nput it back. It is process-wide and makes ModelHub's constructor leave\nallowDenyList null, so every ModelHub built after those files ran skipped the\nallow/deny list entirely. browser_ml_model_hub_denylist.js runs later in\nbrowser.toml and so failed every one of its assertions in a full suite run\nwhile passing on its own.\n\nbrowser_ml_cache.js already restored it; the other two now do the same, and the\ndenylist test asserts the variable is unset so a future leak fails where it can\nbe diagnosed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339604\n", "files": ["toolkit/components/ml/tests/browser/browser_ml_engine_e2e.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_denylist.js", "toolkit/components/ml/tests/browser/browser_ml_telemetry.js"], "git_node": "566a8046c303a697999f2dde0441d943614824d9", "git_parents": ["0ad9c5eb29170d5be2c833448f9ed957c043d63d"], "node": "b712045dcd3dcbe38f905a4da231e4552b20c3ea", "parents": ["10407c26a6acdb4e9c8de95216c7cae03b9747c5"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Delete browser_ml_cache.js now that the model hub tests cover it r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339605\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_cache.js", "toolkit/components/ml/tests/browser/shared-head.js"], "git_node": "6c353fa9c6446c43efe80ec50b2c59f8fb859722", "git_parents": ["566a8046c303a697999f2dde0441d943614824d9"], "node": "956b58f06a30a4d47bb9075e05b18e6c18b79987", "parents": ["b712045dcd3dcbe38f905a4da231e4552b20c3ea"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Remove unused getModelFileAsResponse r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339606\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs"], "git_node": "915a851019951cfddf8e8ef6a48144bcddaee5b8", "git_parents": ["6c353fa9c6446c43efe80ec50b2c59f8fb859722"], "node": "c4b731a6829c9a24a47f212fedc2fc0504109a60", "parents": ["956b58f06a30a4d47bb9075e05b18e6c18b79987"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Fix denied models not being purged from the cache r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339607\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_model_hub_denylist.js"], "git_node": "8fc001af6f772f4fe1c83c914d8f5ee1f8fb1e86", "git_parents": ["915a851019951cfddf8e8ef6a48144bcddaee5b8"], "node": "8a30885da9cb0cc3120a33ef1c33f751bd068c56", "parents": ["c4b731a6829c9a24a47f212fedc2