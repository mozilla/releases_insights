s:6738973:"{
"lastpushid": 45871,
"pushes": {"45724": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 46631d72c611be62e77f8713b8966fa8b770317a with FIREFOX_BETA_160_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "864166e0f3ae56c9e3fd5324e35a575855d4841c", "git_parents": ["4de14a84838e326c846d464c40a5e8b288193b06"], "node": "c178b3f1fd90c934813b7e3d9468666c990f0d08", "parents": ["8065475b8c184db1a43ef6c164eaef52ba4365ad"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging c4c42dae1d0d3b75e92b93fad45620c86b26878f with FIREFOX_BETA_161_BASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "95c93b104d57096a19a3a186d81e909eb17b152c", "git_parents": ["864166e0f3ae56c9e3fd5324e35a575855d4841c"], "node": "3e3b394940c64b0bf60db8341dc39f94c68d341a", "parents": ["c178b3f1fd90c934813b7e3d9468666c990f0d08"], "tags": []}], "date": 1793879485, "git_changesets": ["864166e0f3ae56c9e3fd5324e35a575855d4841c", "95c93b104d57096a19a3a186d81e909eb17b152c"], "user": "ffxbld@lando.moz.tools"}, "45725": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt", "mobile/android/version.txt"], "git_node": "7c6690c3277c428ea13be03fc22fba38abb9bfcf", "git_parents": ["cac25a6fa321b0051932359b84c4e2fe3caabdc5"], "node": "9362173672da4b438e26e613fad1250205113633", "parents": ["c4c42dae1d0d3b75e92b93fad45620c86b26878f"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Update configs after merge day operations a=release\n\nIGNORE BROKEN CHANGESETS\nCLOSED TREE\n", "files": ["CLOBBER", "browser/extensions/newtab/manifest.json", "browser/extensions/webcompat/manifest.json", "mobile/android/android-components/docs/changelog.md", "services/sync/modules/constants.sys.mjs"], "git_node": "935e9f7e39fcb9d738d3ac064905dcf4cc0c9cfc", "git_parents": ["7c6690c3277c428ea13be03fc22fba38abb9bfcf"], "node": "c36a59444fc4e9cac860bee18aa49621e0071bce", "parents": ["9362173672da4b438e26e613fad1250205113633"], "tags": []}], "date": 1793880012, "git_changesets": ["7c6690c3277c428ea13be03fc22fba38abb9bfcf", "935e9f7e39fcb9d738d3ac064905dcf4cc0c9cfc"], "user": "ffxbld@lando.moz.tools"}, "45726": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging c4c42dae1d0d3b75e92b93fad45620c86b26878f with FIREFOX_NIGHTLY_161_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "f777df8cc22c70093af01af364f6587b0094234b", "git_parents": ["95c93b104d57096a19a3a186d81e909eb17b152c"], "node": "f23f859a5df5fe9fcf7d0f1c62ebea55f89f76b4", "parents": ["3e3b394940c64b0bf60db8341dc39f94c68d341a"], "tags": []}], "date": 1793880030, "git_changesets": ["f777df8cc22c70093af01af364f6587b0094234b"], "user": "ffxbld@lando.moz.tools"}, "45727": {"changesets": [{"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086592 - fix browser_pop_tab test and add it back to the mini window toml. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338810\n", "files": ["browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_pop_tab.js"], "git_node": "d0bd8fd2551c23b9af3097455d48c4048da737ef", "git_parents": ["cac25a6fa321b0051932359b84c4e2fe3caabdc5"], "node": "71cc731d34355fbaf4e3c1c0c04d8bb74b5b24a1", "parents": ["c4c42dae1d0d3b75e92b93fad45620c86b26878f"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088158 - Move Wrexham AFC widget strings out from preview into newtab.ftl for localization. r=fluent-reviewers,fchasen,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339526\n", "files": ["browser/locales-preview/newtabPreview.ftl", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "a0bb2db0a2e328bf7ffaf1466fff2b2408bfec73", "git_parents": ["d0bd8fd2551c23b9af3097455d48c4048da737ef"], "node": "952039abe7f2ce90d7df0c34ea500f3248f806ac", "parents": ["71cc731d34355fbaf4e3c1c0c04d8bb74b5b24a1"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085856 - Part 1 - Expand the glob excludes in one walk r=linter-reviewers,sylvestre\n\n`filterpaths` walked the tree once per glob exclude, about 30 seconds of\nCPU in each worker. It now walks once, and `mozpath.matcher` tests each\npath against a set of the plain excludes and one regex of the globs.\n`FileFinder` matches its ignores with `mozpath.matcher` too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336636\n", "files": ["python/mozbuild/mozpack/files.py", "python/mozbuild/mozpack/path.py", "python/mozbuild/mozpack/test/test_path.py", "python/mozlint/mozlint/pathutils.py", "python/mozlint/test/test_pathutils.py"], "git_node": "1962c2214abaced3a22542b52c551e472e2a0c66", "git_parents": ["a0bb2db0a2e328bf7ffaf1466fff2b2408bfec73"], "node": "84591286e09d8a32c486ef5791d4115935c58644", "parents": ["952039abe7f2ce90d7df0c34ea500f3248f806ac"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085856 - Part 2 - Check the extension before building a `File` in `expand_exclusions` r=linter-reviewers,sergesanspaille\n\n`FileFinder.find(\"**\")` built a `File` for every file in the tree and\ntested it against the excludes before `expand_exclusions` dropped the\nones with other extensions. The new `FileFinder.walk_unfiltered` yields\nthe same paths in the same order without building a `File`, so the\nextension is checked first. A whole tree `mach lint -l license` on\nWindows went from about 22 to 17 seconds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336639\n", "files": ["python/mozbuild/mozpack/files.py", "python/mozlint/mozlint/pathutils.py", "python/mozlint/test/test_pathutils.py"], "git_node": "72b603652452df88fffbe40cc7c9b01746fddc14", "git_parents": ["1962c2214abaced3a22542b52c551e472e2a0c66"], "node": "c92fb827d0a69af0893fcf4d8403d6f0c1db6735", "parents": ["84591286e09d8a32c486ef5791d4115935c58644"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085856 - Part 3 - Walk each directory once in the string and regex types r=linter-reviewers,sylvestre\n\n`BaseType._lint_dir` walked a directory once for each extension a\nlinter lists. It now walks it once and skips the other extensions. A\nwhole tree `mach lint -l mscom-init` on Windows went from about 39 to\n16 seconds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336640\n", "files": ["python/mozlint/mozlint/types.py", "python/mozlint/test/test_types.py"], "git_node": "0a303a9d9afb0fe2e72df79338f6a0dcf47831bb", "git_parents": ["72b603652452df88fffbe40cc7c9b01746fddc14"], "node": "f50986122a9e92160c6837490f0f1585eabb135a", "parents": ["c92fb827d0a69af0893fcf4d8403d6f0c1db6735"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085856 - Part 4 - Compute the path components of a `FilterPath` once r=linter-reviewers,sergesanspaille\n\n`filterpaths` tested every path against every exclude with\n`FilterPath.contains`, which made both paths absolute, normalized and\nsplit them on each call, and it gathered the excludes under each include\nagain for every path. The components are now kept on the `FilterPath`\nand the excludes under each include are gathered once. A whole tree\n`mach lint -l includes` on Windows went from about 9.0 to 8.0 seconds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336642\n", "files": ["python/mozlint/mozlint/pathutils.py"], "git_node": "9f59778520e58f3655f6350b41a6221a03768a8d", "git_parents": ["0a303a9d9afb0fe2e72df79338f6a0dcf47831bb"], "node": "7b5beb5b3e3689ffac09e5d7191ee294bec5dbe7", "parents": ["f50986122a9e92160c6837490f0f1585eabb135a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085854 - Part 1 - Exclude the local cache and scratch directories from every linter r=linter-reviewers,marco\n\n`mach lint .` passes each top level directory to the linters, including\ndot directories like `.ruff_cache`. A walker skips dot entries only below\nthe directory it starts from, so every whole tree run walked and linted\nthe tool caches in a local checkout. `.ruff_cache` alone holds over\n250000 files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336633\n", "files": ["tools/lint/mach_commands.py"], "git_node": "ae29378a9a18bf85c637cc85593c3b986c2dcd1d", "git_parents": ["9f59778520e58f3655f6350b41a6221a03768a8d"], "node": "0d1866a3dfbcae22e727fc714b45fff6753f0908", "parents": ["7b5beb5b3e3689ffac09e5d7191ee294bec5dbe7"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085854 - Part 2 - Apply the global excludes to every walk in `expand_exclusions` r=linter-reviewers,sergesanspaille\n\nThe global excludes were merged into each linter's excludes, which\n`BaseType` then replaced with only the excludes inside the linted paths.\nA walk outside those paths, like the whole tree walk in\n`license-declarations`, went into every objdir and `node_modules`.\n`expand_exclusions` now always applies the global excludes unless\nfiltering is turned off.\n\nA literal exclude now matches an explicitly passed file only by whole\npath components, so `subdir1/b` no longer excludes `subdir1/b.js`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336634\n", "files": ["python/mozlint/mozlint/pathutils.py", "python/mozlint/test/test_pathutils.py"], "git_node": "03e4860a3ef30643597a8473a227033b7be1792b", "git_parents": ["ae29378a9a18bf85c637cc85593c3b986c2dcd1d"], "node": "779ecac4969be30b43bcef80d478eb00470e059d", "parents": ["0d1866a3dfbcae22e727fc714b45fff6753f0908"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085858 - Lint the moz.build files `license-declarations` already walked r=linter-reviewers,sylvestre\n\n`license-declarations` walked the whole tree to gather the declared ids\nand then walked the linted paths again, parsing every moz.build twice. The\nlinted files are now the ones from the first walk under the given paths.\nA moz.build in a dot directory is no longer linted when that directory is\npassed explicitly, since the tree walk skips dot directories.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336641\n", "files": ["tools/lint/license/__init__.py", "tools/lint/test/test_license_declarations.py"], "git_node": "8337f6b07ac460a47aae99770ebdda9a4001151d", "git_parents": ["03e4860a3ef30643597a8473a227033b7be1792b"], "node": "a90d9728410ad8e720b3857e4eb48c2d2bd3c7d7", "parents": ["779ecac4969be30b43bcef80d478eb00470e059d"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1994717 - Part 1 - Split directories into smaller jobs for slow per file linters r=linter-reviewers,marco\n\nA whole tree run gave each job a handful of top level directories, so\nthe job that got `dom` or `js` set the wall time of slow per file\nlinters. A linter can now set `split-dirs` to split each directory that\nmany levels deep. `includes` uses 2, which took a whole tree run on\nWindows from 45 to 17 seconds. Every linter's paths are now handed to\nits jobs round robin instead of in consecutive runs. A dot directory\nthat is passed in is kept whole. The dot entries inside a directory are\ndropped unless `find-dotfiles` is set, matching how the mozlint walkers\ntreat a directory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336643\n", "files": ["docs/code-quality/lint/create.md", "python/mozlint/mozlint/parser.py", "python/mozlint/mozlint/roller.py", "python/mozlint/test/linters/invalid_split_dirs.yml", "python/mozlint/test/linters/invalid_split_dirs_global.yml", "python/mozlint/test/test_parser.py", "python/mozlint/test/test_roller.py", "tools/lint/includes.yml"], "git_node": "4c9097df41f40b0b73ae4b1827d95c380a129223", "git_parents": ["8337f6b07ac460a47aae99770ebdda9a4001151d"], "node": "e0bbe7146a7fea9e564a3bfd392c0d2cee3a995f", "parents": ["a90d9728410ad8e720b3857e4eb48c2d2bd3c7d7"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1994717 - Part 2 - Split directories by weight so each job gets an equal share r=linter-reviewers,sergesanspaille\n\nA fixed split depth leaves one job holding a directory like\n`browser/components`, which then sets the wall time. With\n`split-dirs: auto`, the roller weighs every path in one walk, splits\nany directory heavier than an equal share, and hands the pieces out\nheaviest first, one job per core. A file the linter checks weighs 1,\nevery entry walked weighs 0.2, and paths matched by\n`split-ignore-files` weigh nothing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337768\n", "files": ["docs/code-quality/lint/create.md", "python/mozlint/mozlint/parser.py", "python/mozlint/mozlint/roller.py", "python/mozlint/test/linters/non_existing_split_ignore_files.yml", "python/mozlint/test/linters/split_dirs_auto.yml", "python/mozlint/test/test_parser.py", "python/mozlint/test/test_roller.py"], "git_node": "acedc93c3c4ef4aaaab48ea32b1f4deb6a9225b9", "git_parents": ["4c9097df41f40b0b73ae4b1827d95c380a129223"], "node": "45375aaba9da7fe77cc4959a6dd9e2fd292e752a", "parents": ["e0bbe7146a7fea9e564a3bfd392c0d2cee3a995f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1994717 - Part 3 - Split the eslint paths by weight r=linter-reviewers,marco\n\nA whole tree ESLint run gave each job a few top level directories, so\nthe job with `devtools` and `toolkit` set the wall time. On a 12 core\nmachine one job wrote more JSON than fits in a V8 string, so ESLint\ncrashed and the results for `docshell`, `layout` and `netwerk` were\nlost.\n\neslint now uses `split-dirs: auto` with the ignore lists\n`eslint.config.mjs` reads as `split-ignore-files`. On try the lint step\non 8 cores went from about 300 to 262 seconds, and on 30 cores it takes\n88 seconds.\nESLint and Prettier lint the dot files inside a directory, so the split\nkeeps dot entries, and `--no-warn-ignored` and `--ignore-unknown` stop\nan explicitly passed ignored entry from producing a warning or an\nerror. Prettier also starts alongside ESLint instead of after it when\nnothing is being fixed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336644\n", "files": ["tools/lint/eslint.yml", "tools/lint/eslint/__init__.py", "tools/lint/eslint/prettier_utils.py", "tools/lint/test/test_eslint.py"], "git_node": "a950498c54ac9c8c0f697dff6ba17e9651e22406", "git_parents": ["acedc93c3c4ef4aaaab48ea32b1f4deb6a9225b9"], "node": "3eac5b6ff7fc430f653dc012c2e28b760bec4c9d", "parents": ["45375aaba9da7fe77cc4959a6dd9e2fd292e752a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086815 - Run eslint on 30 core workers r=sylvestre,linter-reviewers,marco\n\neslint is limited by CPU and finishes last on more review bot pushes\nthan any other task. On try its lint step takes 262 seconds on the 8\ncore workers and 88 seconds on 30 cores.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337769\n", "files": ["taskcluster/kinds/source-test/mozlint.yml"], "git_node": "bb27f7d2f9776680086dc4020342af9a002109dc", "git_parents": ["a950498c54ac9c8c0f697dff6ba17e9651e22406"], "node": "fa2e3e2e720f46bec0df34a200ea8534cb46eb43", "parents": ["3eac5b6ff7fc430f653dc012c2e28b760bec4c9d"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088328 - Part 1 - Upload the docs once per push r=linter-reviewers,firefox-source-docs-reviewers,sylvestre\n\nOnly level 3 needs to upload to the bucket root, which is what publishes\nfirefox-source-docs.mozilla.org. Try pushes don't need that copy, since\nnothing reads it, and the review bot links to the per run copy instead.\n\nThe reverse holds too. The per run link always points at the level 1\nbucket, so the per run copy a level 3 push uploads is never read, and\nnothing ever deletes it. Each push now uploads one copy, which halves the\nupload.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339031\n", "files": ["tools/moztreedocs/mach_commands.py"], "git_node": "64fe75f34a97f0417efc5bec17225a7fa678a811", "git_parents": ["bb27f7d2f9776680086dc4020342af9a002109dc"], "node": "509912a4beda4e6e63f0b2441e4ad0fd16712305", "parents": ["fa2e3e2e720f46bec0df34a200ea8534cb46eb43"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088328 - Part 2 - Upload the docs with 128 threads r=linter-reviewers,firefox-source-docs-reviewers,sylvestre\n\nThe upload of a few thousand small files is bound by request latency,\nnot bandwidth. More threads help when the worker is far from the bucket\nand make no noticeable difference when it is close. With 128 threads\ninstead of 20 the upload took 29 to 33 seconds instead of 26 to 47. The\nS3 client's connection pool grows with the threads so they don't wait on\nit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339032\n", "files": ["tools/moztreedocs/upload.py"], "git_node": "ac33dddf3c202c40ea01e14fc20f74b9d0f80a74", "git_parents": ["64fe75f34a97f0417efc5bec17225a7fa678a811"], "node": "baafdd4e3b5ffbaa38f2760488c9d45a2fe2da68", "parents": ["509912a4beda4e6e63f0b2441e4ad0fd16712305"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088328 - Part 3 - Stop copying the page sources into the built docs r=linter-reviewers,sergesanspaille\n\nThe \"View page source\" link points at GitHub, so the `_sources` copies\nwere unused, yet they were 40% of the files uploaded on every run.\nDropping them cuts the upload from about 30 to 19 seconds. The link no\nlonger depends on `has_source`, which follows `html_copy_source`, and the\ngenerated pages without a source file are skipped explicitly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339033\n", "files": ["docs/_templates/breadcrumbs.html", "docs/conf.py"], "git_node": "206e3b5593d74f3beccb80e132953e70a62eb0c0", "git_parents": ["ac33dddf3c202c40ea01e14fc20f74b9d0f80a74"], "node": "1c6cfae77195ed3a42b6441de1ad3fde3b73cbce", "parents": ["baafdd4e3b5ffbaa38f2760488c9d45a2fe2da68"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088327 - Run doc-upload on 30 core workers r=linter-reviewers,sylvestre\n\nWith the sources read in parallel, doc-upload scales with cores. On try\nthe docs build takes 102 seconds on 30 core AMD workers instead of 154 on\nthe 8 core Intel ones, and the whole task 235 seconds instead of 324.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339034\n", "files": ["taskcluster/kinds/source-test/doc.yml"], "git_node": "ee5492d10dee9dd792010143294654cf7792e783", "git_parents": ["206e3b5593d74f3beccb80e132953e70a62eb0c0"], "node": "6661bc86c42a902889ea3edc8f0ed4beeddfd413", "parents": ["1c6cfae77195ed3a42b6441de1ad3fde3b73cbce"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083966 - [SmartWindow] Add Account Signin link to temporarily unavailable message r=ngrato,again,fluent-reviewers,omc-reviewers,mviar,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339368\n", "files": ["browser/components/aboutwelcome/content/onboarding.ftl", "browser/components/aiwindow/models/tests/browser/browser_auth_guest.js", "browser/components/aiwindow/ui/modules/ToUSpotlight.sys.mjs"], "git_node": "2f5ab9772acc8bc455cec751334869ad9636d3fc", "git_parents": ["ee5492d10dee9dd792010143294654cf7792e783"], "node": "6ff6b93befd5eb26d62b82a31d24fca9c1432ee2", "parents": ["6661bc86c42a902889ea3edc8f0ed4beeddfd413"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087803 - Land assets for final animated card to improve load time r=omc-reviewers,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339197\n", "files": ["browser/components/asrouter/content/assets/hnt-center-animated-no-loop.svg", "browser/components/asrouter/jar.mn", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs"], "git_node": "279742789fe3cea5cd4c605d6b558fb64afaa630", "git_parents": ["2f5ab9772acc8bc455cec751334869ad9636d3fc"], "node": "05d0f5cc92fe6e271dae50c5d5a8d1e10f515864", "parents": ["6ff6b93befd5eb26d62b82a31d24fca9c1432ee2"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078452: Part 1 - Send network:networkid-changed for the initial network ID r=necko-reviewers,valentin\n\nThe initial ID notification was suppressed on some platforms along with\nnetwork:link-status-changed with the \"changed\" payload -- the latter of which\nmust not be sent for the first calculation.  Suppressing\nnetwork:networkid-changed was not needed.  Windows is already sending\nnetwork:networkid-changed when the ID is determined.  This brings other\nplatforms in alignment, allowing geolocation to know when the ID is available.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331368\n", "files": ["netwerk/base/nsINetworkLinkService.idl", "netwerk/system/mac/nsNetworkLinkService.mm", "netwerk/system/netlink/NetlinkService.cpp"], "git_node": "df4385761c157cdcc90ca2bc17bfd6d487cd7fd2", "git_parents": ["279742789fe3cea5cd4c605d6b558fb64afaa630"], "node": "98c036a8f13e107504d299e1cc38fdb23fb234b5", "parents": ["05d0f5cc92fe6e271dae50c5d5a8d1e10f515864"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078452: Part 2 - Keep the unseeded network ID hash state with the network ID r=necko-reviewers,jesup\n\nEach link service now keeps the hash state of its network ID's inputs from\nbefore SeedNetworkId() is applied.  It is updated in the same critical section\nas mNetworkId, so the two always describe the same network.  Part 3 uses it to\nrecognize a network ID computed by an earlier session.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333440\n", "files": ["netwerk/system/mac/nsNetworkLinkService.h", "netwerk/system/mac/nsNetworkLinkService.mm", "netwerk/system/netlink/NetlinkService.cpp", "netwerk/system/netlink/NetlinkService.h", "netwerk/system/win32/nsNotifyAddrListener.cpp", "netwerk/system/win32/nsNotifyAddrListener.h"], "git_node": "38a20a42014e825c289af546c0a747d8f85271a4", "git_parents": ["df4385761c157cdcc90ca2bc17bfd6d487cd7fd2"], "node": "1c7232bb6cb6dd4412f9293369168d4854897012", "parents": ["98c036a8f13e107504d299e1cc38fdb23fb234b5"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078452: Part 3 - Let nsINetworkLinkService recognize a network ID from an earlier session r=necko-reviewers,jesup\n\nnetworkID is salted with a per-process seed (bug 1817756), so an ID stored by\none session never equals the one computed by the next. networkIDSeed exposes\nthe seed, and matchNetworkID re-hashes the current network with a given seed.\nA caller that kept an ID together with its seed can thus check whether it still\nidentifies the current network.  Part 5 stores the seed in a\nparent-process-only pref, alongside its cache file, so that geolocation can\nreuse that cache across browser sessions, as suggested in bug 1817756 comment 0.\n\nKeeping an ID together with its seed makes that ID linkable across sessions,\nwhich partly undoes bug 1817756.  The geolocation cache already reveals\nlocation, so Part 5 accepts that for its own entry.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332622\n", "files": ["netwerk/base/nsINetworkLinkService.idl", "netwerk/system/LinkServiceCommon.cpp", "netwerk/system/LinkServiceCommon.h", "netwerk/system/android/nsAndroidNetworkLinkService.cpp", "netwerk/system/linux/nsNetworkLinkService.cpp", "netwerk/system/mac/nsNetworkLinkService.mm", "netwerk/system/netlink/NetlinkService.cpp", "netwerk/system/netlink/NetlinkService.h", "netwerk/system/win32/nsNotifyAddrListener.cpp", "netwerk/test/gtest/TestLinkServiceCommon.cpp", "netwerk/test/gtest/moz.build", "netwerk/test/unit/test_network_id_match.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "86de18123faed82eab642a798c36811d24341b2e", "git_parents": ["38a20a42014e825c289af546c0a747d8f85271a4"], "node": "884327254af422f8e1e96088b465650a8b5c4dbf", "parents": ["1c7232bb6cb6dd4412f9293369168d4854897012"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078452: Part 4 - Move the NetworkGeolocationProvider request cache into its own module r=geoprovider-reviewers,saschanaz\n\nNo functional change. The cache moves verbatim to NetworkGeolocationCache.sys.mjs\nahead of being extended to persist across sessions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332623\n", "files": ["dom/system/NetworkGeoPosition.sys.mjs", "dom/system/NetworkGeolocationCache.sys.mjs", "dom/system/NetworkGeolocationProvider.sys.mjs", "dom/system/moz.build"], "git_node": "e7e894bfb1c930ff65a2eca960564d2866e5c401", "git_parents": ["86de18123faed82eab642a798c36811d24341b2e"], "node": "e12d5d1c62cdfb903508b162024965d17c93eed5", "parents": ["884327254af422f8e1e96088b465650a8b5c4dbf"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078452: Part 5 - Persist NetworkGeolocationProvider cache to file r=geoprovider-reviewers,jjaschke,saschanaz,timhuang\n\nThe entry records the network ID it was obtained on and is only reused in a\nlater session on the same network.  During the period where the ID is still\nbeing determined after startup, the entry stays pending until\nnetwork:networkid-changed is sent.  Because networkID is salted per browser\nsession, the check goes through nsINetworkLinkService.matchNetworkID with\nthe seed of the session that stored the entry, which is kept in the parent-only\npref geo.provider.network.requestCache.networkIDSeed.\n\ngeo.provider.network.requestCache.maxAgeDays invalidates the cache after\nthat number of days.  It is clamped to [1,30].  The limit is set to 30 to\ncomply with current licensing agreements.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331369\n", "files": ["dom/geolocation/test/unit/test_geolocation_network_cache.js", "dom/system/NetworkGeolocationCache.sys.mjs", "dom/system/NetworkGeolocationProvider.sys.mjs", "modules/libpref/init/all.js"], "git_node": "296dbee870b8683d24251e478c124096eac21e6a", "git_parents": ["e7e894bfb1c930ff65a2eca960564d2866e5c401"], "node": "46f368f6521c975f99f49180cc0ac3175be43cdb", "parents": ["e12d5d1c62cdfb903508b162024965d17c93eed5"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078452: Part 6 - Clear the persisted geolocation cache when requested r=geoprovider-reviewers,timhuang,saschanaz\n\nThe cache is now persisted so clearing cached data drops it along with the\nnetwork ID seed it is keyed on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332624\n", "files": ["dom/system/NetworkGeolocationCache.sys.mjs", "toolkit/components/cleardata/ClearDataService.sys.mjs", "toolkit/components/cleardata/nsIClearDataService.idl", "toolkit/components/cleardata/tests/unit/test_geolocation_cache.js", "toolkit/components/cleardata/tests/unit/xpcshell.toml"], "git_node": "19bbbcfad368fe984603adf599ea7e07f1e25d13", "git_parents": ["296dbee870b8683d24251e478c124096eac21e6a"], "node": "483f0105d4e85df78f04adfff65f26a7f6aa23f9", "parents": ["46f368f6521c975f99f49180cc0ac3175be43cdb"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078452: Part 7 - Add telemetry for persisted NetworkGeolocationProvider cache r=geoprovider-reviewers,saschanaz\n\nRecording telemetry for the state of the persisted entry when a session first\nconsults the cache measures how often persistence helps.  Only one state of\nthe four, \"adopted\", indicates cache use in a new session.  The others detect\nno cache file (\"absent\"), no cache hit (\"rejected\") and no key for cache (ie\nno network name yet -- \"superseded\").\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332625\n", "files": ["dom/geolocation/metrics.yaml", "dom/geolocation/test/unit/test_geolocation_network_cache.js", "dom/system/NetworkGeolocationCache.sys.mjs"], "git_node": "06d2c02f0a07501e33e02a0f1b7937177bdd2fb7", "git_parents": ["19bbbcfad368fe984603adf599ea7e07f1e25d13"], "node": "a0c69ab929dfe80f64448d16b50ead2ad697d1d6", "parents": ["483f0105d4e85df78f04adfff65f26a7f6aa23f9"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the LTO flags from `config.mk` to `ComputedFlags` r=firefox-build-system-reviewers,sergesanspaille\n\nThe `config.mk` guard that cleared the LTO flags is gone, because configure\nomits `MOZ_LTO_CFLAGS` and `MOZ_LTO_LDFLAGS` when LTO is off.\n\n`compose_env` adds `RUST_LTO_CFLAGS` and `MOZ_LTO_LDFLAGS` around the computed\nflags it passes to Cargo, and `RUST_LTO_CFLAGS` stays empty with GCC, so the\n`LTO` category is left out of those flags.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328999\n", "files": ["build/moz.configure/lto-pgo.configure", "config/config.mk", "python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/rust_commands.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/frontend/test_emitter.py"], "git_node": "6c0e61d1dd0ed96d954fcc8b3c309005ba940095", "git_parents": ["06d2c02f0a07501e33e02a0f1b7937177bdd2fb7"], "node": "da757f4591504c973fbfb8f939d7923e2bb5fcba", "parents": ["a0c69ab929dfe80f64448d16b50ead2ad697d1d6"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the LTO object path from `config.mk` to `Linkable` r=firefox-build-system-reviewers,sergesanspaille\n\nThe flag named the binary with `$(@F)`, so it belongs to the linkable rather\nthan to a flag category, and the backend attaches it to each link target.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329000\n", "files": ["config/config.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/lto-object-path/moz.build", "python/mozbuild/mozbuild/test/backend/data/lto-object-path/prog/moz.build", "python/mozbuild/mozbuild/test/backend/data/lto-object-path/shared/moz.build", "python/mozbuild/mozbuild/test/backend/data/lto-object-path/simple/asimple.cpp", "python/mozbuild/mozbuild/test/backend/data/lto-object-path/simple/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/frontend/test_emitter.py"], "git_node": "9f6f43c24f84757142bd06dc65f66be74f6ed787", "git_parents": ["6c0e61d1dd0ed96d954fcc8b3c309005ba940095"], "node": "fd70aa364a23a41343c0f87642382a50962251be", "parents": ["da757f4591504c973fbfb8f939d7923e2bb5fcba"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the PGO flags from `config.mk` to `ComputedFlags` r=firefox-build-system-reviewers,sergesanspaille\n\nThe instrumentation gets its own `COMPUTED_PGO_CFLAGS` category because a\nsingle source can opt out of it. `-DNS_FREE_PERMANENT_DATA=1` stays with the\nordinary compile flags, since Make gave it to every source in the directory and\nonly filtered the instrumentation per source.\n\n`compose_env` adds `RUST_PGO_CFLAGS` and `RUST_PGO_LDFLAGS` around the computed\nflags it passes to Cargo, and `RUST_PGO_CFLAGS` drops `-fprofile-generate` so\nhost build scripts are not instrumented, so the `PGO` and `PGO_DEFINES`\ncategories are left out of those flags.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329001\n", "files": ["config/config.mk", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/rust_commands.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/frontend/data/pgo-cpp-unit-tests/TestPgo.cpp", "python/mozbuild/mozbuild/test/frontend/data/pgo-cpp-unit-tests/moz.build", "python/mozbuild/mozbuild/test/frontend/data/pgo-no-pgo/moz.build", "python/mozbuild/mozbuild/test/frontend/data/pgo-no-pgo/test1.c", "python/mozbuild/mozbuild/test/frontend/test_emitter.py"], "git_node": "f192037583ee4242cc4e721e46a32e7c861e5cc6", "git_parents": ["9f6f43c24f84757142bd06dc65f66be74f6ed787"], "node": "b4f21f07cece7746c244cc7cde0edb79c67e2fbd", "parents": ["fd70aa364a23a41343c0f87642382a50962251be"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the per source PGO opt out from `config.mk` to `PerSourceFlag` r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329002\n", "files": ["config/config.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/no-pgo-source/moz.build", "python/mozbuild/mozbuild/test/backend/data/no-pgo-source/profiled.cpp", "python/mozbuild/mozbuild/test/backend/data/no-pgo-source/unprofiled.cpp", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "0d9b609ef09cbb359f413e460ba0be034407513b", "git_parents": ["f192037583ee4242cc4e721e46a32e7c861e5cc6"], "node": "287f7326c020323abf5c9cf14ca0c1dca5eaf99f", "parents": ["b4f21f07cece7746c244cc7cde0edb79c67e2fbd"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the macOS shared library install name from `rules.mk` to `SharedLibrary` r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329005\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "56381346c5c74a3e7eff17ed75a8df8697c47919", "git_parents": ["0d9b609ef09cbb359f413e460ba0be034407513b"], "node": "8a4f76f636e352ae4f83124e5f5ac80d3e5320ef", "parents": ["287f7326c020323abf5c9cf14ca0c1dca5eaf99f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the mingw import library flag from `rules.mk` to `SharedLibrary` r=firefox-build-system-reviewers,sergesanspaille\n\n`rules.mk` appended it to `DSO_LDOPTS`, a configure subst that `MKSHLIB`\nexpands lazily, so the flag existed only by mutating a configure value at Make\ntime.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329006\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "b20ef8f87f2df51311f7d1dadd5b0909b3d8586e", "git_parents": ["56381346c5c74a3e7eff17ed75a8df8697c47919"], "node": "3375101a5221fb0a25324990ee7cde88e3101a1f", "parents": ["8a4f76f636e352ae4f83124e5f5ac80d3e5320ef"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the clang-cl import library flag from `rules.mk` to `SharedLibrary` r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329502\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "9fd3dd05dc059af1ed7b9b7d5b98663a3ec2c9ce", "git_parents": ["b20ef8f87f2df51311f7d1dadd5b0909b3d8586e"], "node": "2a44a3e8b8eb1d19291549624866ff95f5828fbe", "parents": ["3375101a5221fb0a25324990ee7cde88e3101a1f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the Android pre-export traversal from `recurse.mk` to the backend r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329010\n", "files": ["config/recurse.mk", "mobile/android/moz.build", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/data/generated-files-pre-export/app/generate.py", "python/mozbuild/mozbuild/test/backend/data/generated-files-pre-export/app/moz.build", "python/mozbuild/mozbuild/test/backend/data/generated-files-pre-export/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "9a789fd2cfe068c5538d23b4a45e66d62698742d", "git_parents": ["9fd3dd05dc059af1ed7b9b7d5b98663a3ec2c9ce"], "node": "489d0602f88252f3248475eab572a614a125419c", "parents": ["2a44a3e8b8eb1d19291549624866ff95f5828fbe"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the header entries from `StaticAnalysisBackend` to `CompileDBBackend` r=firefox-build-system-reviewers,sergesanspaille\n\nThe Clangd and CompileDB databases had no entry for a header listed in\n`EXPORTS` or `SOURCE_HEADERS`, so clangd guessed its flags from a nearby\nsource file. All three databases now carry those entries. A header takes its\nlanguage from what its directory compiles, C++ first, then Objective-C++,\nObjective-C and C, so a directory that compiles only C no longer compiles its\nheaders as C++.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331378\n", "files": ["python/mozbuild/mozbuild/backend/static_analysis.py", "python/mozbuild/mozbuild/compilation/database.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/database-c/foo.c", "python/mozbuild/mozbuild/test/backend/data/database-c/foo.h", "python/mozbuild/mozbuild/test/backend/data/database-c/moz.build", "python/mozbuild/mozbuild/test/backend/data/database-objc/moz.build", "python/mozbuild/mozbuild/test/backend/data/database-objc/qux.h", "python/mozbuild/mozbuild/test/backend/data/database/foo.h", "python/mozbuild/mozbuild/test/backend/data/database/moz.build", "python/mozbuild/mozbuild/test/backend/test_database.py"], "git_node": "9b3c8ad52cee56239d8177a6ed2a9b90be438f5a", "git_parents": ["9a789fd2cfe068c5538d23b4a45e66d62698742d"], "node": "7c111a8b097f364973ee33194fafed7e0ab38231", "parents": ["489d0602f88252f3248475eab572a614a125419c"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move `./mach compileflags` from make `showbuild` to the compilation database r=firefox-build-system-reviewers,sergesanspaille\n\n`./mach compileflags` reads the database the Clangd backend writes in\nevery compile build, or the CompileDB one. A file with its own entry,\nwhich includes most headers listed in `EXPORTS` or `SOURCE_HEADERS`,\ngets that entry's flags. Any other file takes the directory flags of a\nfile compiled in the nearest directory at or above it. Files in the\ndirectories the database skips, such as `build/clang-plugin`, get no\nflags.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329021\n", "files": ["python/mozbuild/mozbuild/compilation/codecomplete.py", "python/mozbuild/mozbuild/compilation/util.py", "python/mozbuild/mozbuild/test/compilation/test_util.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "0588834e3c91acd10c4d438950d9a4055af1f61b", "git_parents": ["9b3c8ad52cee56239d8177a6ed2a9b90be438f5a"], "node": "7934309e359acc1663b61aa72696298643ea2daf", "parents": ["7c111a8b097f364973ee33194fafed7e0ab38231"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the host `NSPR_CFLAGS` from `rules.mk` to `ComputedFlags` r=firefox-build-system-reviewers,sylvestre\n\nThe flags passed to Cargo leave the `NSPR` category out, because Cargo host\nbuilds never received it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329474\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/rust_commands.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/frontend/test_emitter.py"], "git_node": "23d00582af0ec6bd2743bd722284e986586b2ab7", "git_parents": ["0588834e3c91acd10c4d438950d9a4055af1f61b"], "node": "4bf963030861cf5d0097ae6906c71a0a0badc9c2", "parents": ["7934309e359acc1663b61aa72696298643ea2daf"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the faster make header prerequisites from `faster/rules.mk` to `PP_FILES_EXTRA_DEPS` r=firefox-build-system-reviewers,sergesanspaille\n\nEvery faster make install waited for `buildid.h` and `source-repo.h`. The\nFasterMake backend now reads `PP_FILES_EXTRA_DEPS`, as the recursive make\nbackend already did, so only the installs that preprocess those headers wait\nfor them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329475\n", "files": ["config/faster/rules.mk", "python/mozbuild/mozbuild/backend/fastermake.py", "python/mozbuild/mozbuild/test/backend/data/pp-files-extra-deps-jar/consumer/jar.mn", "python/mozbuild/mozbuild/test/backend/data/pp-files-extra-deps-jar/consumer/main.js", "python/mozbuild/mozbuild/test/backend/data/pp-files-extra-deps-jar/consumer/moz.build", "python/mozbuild/mozbuild/test/backend/data/pp-files-extra-deps-jar/generate-header.py", "python/mozbuild/mozbuild/test/backend/data/pp-files-extra-deps-jar/moz.build", "python/mozbuild/mozbuild/test/backend/data/pp-files-extra-deps-jar/plain/moz.build", "python/mozbuild/mozbuild/test/backend/data/pp-files-extra-deps-jar/plain/plain.js", "python/mozbuild/mozbuild/test/backend/test_fastermake.py"], "git_node": "39ee60a817085f372fbb8eadad1481aaab718787", "git_parents": ["23d00582af0ec6bd2743bd722284e986586b2ab7"], "node": "c3e84411b450c3cf4d7949c52458afe038489326", "parents": ["4bf963030861cf5d0097ae6906c71a0a0badc9c2"], "tags": []}, {"author": "Andrej \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1716377 - Fix references in and to the AWSY documentation. r=perftest-reviewers,kshampur\n\nThe about:memory and AWSY MDN pages are gone, so link to the in-tree about:memory docs instead, and merge the short AWSY overview from docs/performance/memory into the AWSY perfdocs page.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339656\n", "files": ["docs/config.yml", "docs/performance/index.md", "docs/performance/memory/awsy.md", "docs/performance/memory/index.md", "testing/awsy/perfdocs/index.md", "testing/perfdocs/generated/awsy.md"], "git_node": "67cbecb629d60b4bf38ff678fe5c55c3d47ba6cd", "git_parents": ["39ee60a817085f372fbb8eadad1481aaab718787"], "node": "2d91baa21ae0e2cdc74e9fc333d39e1917f930ca", "parents": ["c3e84411b450c3cf4d7949c52458afe038489326"], "tags": []}, {"author": "Andrej \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1890534 - Document the AWSY Base Content Resident Unique Memory test. r=perftest-reviewers,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339657\n", "files": ["testing/awsy/perfdocs/index.md", "testing/perfdocs/generated/awsy.md"], "git_node": "aa540cb5b2357bf10033d0f83f7dbc9358f705cf", "git_parents": ["67cbecb629d60b4bf38ff678fe5c55c3d47ba6cd"], "node": "3177ff1f02943e4c6be886ea0bc4380d76199e84", "parents": ["2d91baa21ae0e2cdc74e9fc333d39e1917f930ca"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2088308 - Use \"Search in ...\" labels for search results in the context menu r=fluent-reviewers,adw,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338993\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js", "browser/locales/en-US/browser/browser.ftl"], "git_node": "d0e772bf02936dd68b9d87fde8aad99c9c24365c", "git_parents": ["aa540cb5b2357bf10033d0f83f7dbc9358f705cf"], "node": "ecfe4fffe23d03b1d8505d1106a7df7488cc37ff", "parents": ["3177ff1f02943e4c6be886ea0bc4380d76199e84"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2072745 - Make `SelectionMovementUtils::AdjustFrameForLineStart` look for next frame in the block r=layout-reviewers,emilio\n\n`SelectionMovementUtils::AdjustFrameForLineStart` look for next frame\nsimply with `nsIFrame::GetNextSibling`. However, if the parent of the\ntext frame is an `nsInlineFrame`, the terminal newline does not cause\nan empty text continuation but split the parent inline frame.\nTherefore, it should look for next frame in the next line with climbing\nup the tree in current block.\n\n(The new lambda in `SelectionMovementUtils` is written by Emilio.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336998\n", "files": ["layout/base/tests/caret-in-empty-last-line-1.html", "layout/base/tests/caret-in-empty-last-line-2.html", "layout/base/tests/caret-in-empty-last-line-3.html", "layout/base/tests/caret-in-empty-last-line-4.html", "layout/base/tests/caret-in-empty-last-line-ref.html", "layout/base/tests/caret-in-invisible-last-line-1.html", "layout/base/tests/caret-in-invisible-last-line-2.html", "layout/base/tests/caret-in-invisible-last-line-ref.html", "layout/base/tests/mochitest.toml", "layout/base/tests/test_reftests_with_caret.html", "layout/generic/SelectionMovementUtils.cpp"], "git_node": "8fe498496a85a45d4e589e8f85753c0489f4c4e2", "git_parents": ["d0e772bf02936dd68b9d87fde8aad99c9c24365c"], "node": "79bebdfb8420564401c38996d08b573fc54f819a", "parents": ["ecfe4fffe23d03b1d8505d1106a7df7488cc37ff"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088509 - Use the regular zero prefix layout and result count when no temporal suggestions are shown - r=adw,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339205\n", "files": ["browser/components/urlbar/UrlbarMuxerStandard.sys.mjs", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/docs/UrlbarQueryContext.md", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_temporal_zeroPrefixLayout.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_temporal.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_temporalResults.js", "browser/components/urlbar/tests/quicksuggest/unit/xpcshell.toml", "browser/components/urlbar/tests/unit/test_UrlbarPrefs.js", "browser/components/urlbar/tests/unit/test_muxer.js"], "git_node": "1a7471cfe044f92ed6b2eb2a22e4efa4cdd2500a", "git_parents": ["8fe498496a85a45d4e589e8f85753c0489f4c4e2"], "node": "6daeb8037e5927d655012dbed7a8a3d588ed86f4", "parents": ["79bebdfb8420564401c38996d08b573fc54f819a"], "tags": []}, {"author": "Astor Wu \u003ccode@itdevwu.com\u003e", "branch": "default", "desc": "Bug 2089099 - Don't send pinUvAuthParam with credential management GetNext subcommands. r=mfarrell\n\nenumerateRPsGetNextRP (0x03) and enumerateCredentialsGetNextCredential\n(0x05) are sent without pinUvAuthProtocol/pinUvAuthParam (CTAP 2.1,\nsections 6.8.3 and 6.8.4). Previously GetNextRP was sent with a freshly\nderived PUAP, and GetNextCredential reused the stale PUAP of the\npreceding EnumerateCredentialsBegin.\n\nFeitian BioPass FIDO2 Plus (FIDO_2_1_PRE, credentialMgmtPreview) rejects\nGetNextRP carrying a PUAP with CTAP2_ERR_PIN_AUTH_INVALID. handle_errors!\nthen fetches a new token and resends GetNextRP, which fails with\nCTAP2_ERR_INVALID_PARAMETER because the enumeration state was reset, so\nlisting credentials in about:webauthn fails whenever the key holds\ncredentials for more than one RP.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339694\n", "files": ["dom/webauthn/authenticator/src/crypto/mod.rs", "dom/webauthn/authenticator/src/ctap2/commands/credential_management.rs", "dom/webauthn/authenticator/src/ctap2/mod.rs"], "git_node": "241ef212845838ceba7a8a346719bc96ab963edf", "git_parents": ["1a7471cfe044f92ed6b2eb2a22e4efa4cdd2500a"], "node": "249b6b4990966e88f8c5db71a4e5782972aa1b2c", "parents": ["6daeb8037e5927d655012dbed7a8a3d588ed86f4"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2089033. Clamp the blur std deviation when padding SVG filter node subregions. r=gfx-reviewers,lsalzman\n\nA huge stdDeviation makes the blur padding in new_svg_filter_graph overflow to\ninfinity, so the loop that scales the node down to fit MAX_SURFACE_SIZE never\ngets below it and ends with a NaN task size, which panics in to_i32. Use the\nsame clamp that the blur task already applies to the std deviation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339773\n", "files": ["gfx/tests/crashtests/2089033.html", "gfx/tests/crashtests/crashtests.list", "gfx/wr/webrender/src/render_task.rs"], "git_node": "a6c87012964643df4a6299ae92baec8a70dedbbc", "git_parents": ["241ef212845838ceba7a8a346719bc96ab963edf"], "node": "354495b91376042acb67beed120e6aa49f2baefe", "parents": ["249b6b4990966e88f8c5db71a4e5782972aa1b2c"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084759 - Remove DOMParser from Lit patches r=hjones,tschuster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336536\n", "files": ["toolkit/content/vendor/lit/0001-disable-terser-step.patch", "toolkit/content/vendor/lit/0002-Remove-DOMParser.patch", "toolkit/content/vendor/lit/0002-use-DOMParser-not-innerHTML.patch", "toolkit/content/vendor/lit/0003-Disable-source-maps.patch", "toolkit/content/vendor/lit/0004-Remove-the-bundled-warning.patch", "toolkit/content/vendor/lit/0005-Bug-1808741-Do-not-set-style-attributes-when-using-s.patch", "toolkit/content/vendor/lit/0006-Don-t-modify-Symbol-for-Symbol.metadata-polyfill.patch", "toolkit/content/vendor/lit/0007-Freeze-template-literals-to-match-the-spec.patch"], "git_node": "cbdf7020a469b0ad52c66f0d8622f8a0f9c35ac2", "git_parents": ["a6c87012964643df4a6299ae92baec8a70dedbbc"], "node": "199356d3c0178f5e842eff56a0738bbf9aca1912", "parents": ["354495b91376042acb67beed120e6aa49f2baefe"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084759 - Build Lit r=hjones,Gijs,reusable-components-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336537\n", "files": ["toolkit/content/widgets/vendor/lit.all.mjs"], "git_node": "5847b0cede1f87ea3228785b3c8e9fcc439e1d8e", "git_parents": ["cbdf7020a469b0ad52c66f0d8622f8a0f9c35ac2"], "node": "1ed777c49c80d22b514cea76c4dacdde4801d5bc", "parents": ["199356d3c0178f5e842eff56a0738bbf9aca1912"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2086970 - Use an opaque pointer for BreakpadContext.generator. r=crashreporting-reviewers,afranchuk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338283\n", "files": ["toolkit/crashreporter/breakpad_wrapper/breakpad_wrapper.cpp", "toolkit/crashreporter/crash_helper_server/src/breakpad_crash_generator.rs", "toolkit/crashreporter/crash_helper_server/src/crash_generation.rs"], "git_node": "719326d633aae22310c65faa4e37e938516988cf", "git_parents": ["5847b0cede1f87ea3228785b3c8e9fcc439e1d8e"], "node": "05df1ae0ff55aa3141065b733a423e4170748c60", "parents": ["1ed777c49c80d22b514cea76c4dacdde4801d5bc"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2088696. Don't use the deprecated YUV to RGB32 conversion functions for Y8. r=gfx-reviewers,lsalzman\n\nThe deprecated functions don't handle Y8 (monochrome, no chroma planes) and\nread the null chroma planes, so a monochrome BT601 AVIF crashes when\ngfx.ycbcr.accurate-conversion is set (or on CPUs without SSE3 for limited\nrange). Use the libyuv path for Y8 instead, it handles Y8.\n\nThe RGB565 functions have the same problem, so make\nGetYCbCrToRGBDestFormatAndSize pick B8G8R8X8 instead of RGB565 for Y8. They\nare only used on 32-bit ARM Android with a 16-bit screen.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339781\n", "files": ["gfx/ycbcr/YCbCrUtils.cpp", "gfx/ycbcr/yuv_convert.cpp", "image/test/crashtests/2088696-1.avif", "image/test/crashtests/crashtests.list"], "git_node": "398fb36b68b44471a84647997b35b3a581b96f62", "git_parents": ["719326d633aae22310c65faa4e37e938516988cf"], "node": "714d7067a0c2a7b5b10a5c5d12d353816c3c7ebe", "parents": ["05df1ae0ff55aa3141065b733a423e4170748c60"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078936 - Add a widget studio sidebar panel. r=nina-py,fluent-reviewers,sidebar-reviewers,jsudiaman,bolsson\n\nAdds a Widget Studio panel to the sidebar with a custom header so that content can flow under it.\n\n- Shows the panel while browser.widgets.generated.enabled is set.\n- Registers the panel with a custom header and a floating close button.\n- Adds a slot for widgets hosted in browser elements, which must be in the light DOM so moveBefore can reorder them without reloading.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339373\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/browser.xhtml", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-customize.html", "browser/components/sidebar/sidebar-customize.mjs", "browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/sidebar-panel-header.mjs", "browser/components/widgets/content/sidebar-widget-studio.css", "browser/components/widgets/content/sidebar-widget-studio.html", "browser/components/widgets/content/sidebar-widget-studio.mjs", "browser/components/widgets/jar.mn", "browser/components/widgets/tests/browser/browser.toml", "browser/components/widgets/tests/browser/browser_sidebar_widget_studio.js", "browser/components/widgets/tests/browser/head.js", "browser/locales-preview/widgets.ftl", "browser/locales/jar.mn"], "git_node": "e0e5e77e2667232b61f7e55b06fd2ca60e0bcc11", "git_parents": ["398fb36b68b44471a84647997b35b3a581b96f62"], "node": "6652b4e64e2ebb77b7ff1fa3070ae93ce687cfa1", "parents": ["714d7067a0c2a7b5b10a5c5d12d353816c3c7ebe"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084759 - Build Lit r=hjones,Gijs,reusable-components-reviewers\" for causing mochitest failures @ test_moz_widget.html\n\nThis reverts commit 5847b0cede1f87ea3228785b3c8e9fcc439e1d8e.\n\nRevert \"Bug 2084759 - Remove DOMParser from Lit patches r=hjones,tschuster\"\n\nThis reverts commit cbdf7020a469b0ad52c66f0d8622f8a0f9c35ac2.\n", "files": ["toolkit/content/vendor/lit/0001-disable-terser-step.patch", "toolkit/content/vendor/lit/0002-Remove-DOMParser.patch", "toolkit/content/vendor/lit/0002-use-DOMParser-not-innerHTML.patch", "toolkit/content/vendor/lit/0003-Disable-source-maps.patch", "toolkit/content/vendor/lit/0004-Remove-the-bundled-warning.patch", "toolkit/content/vendor/lit/0005-Bug-1808741-Do-not-set-style-attributes-when-using-s.patch", "toolkit/content/vendor/lit/0006-Don-t-modify-Symbol-for-Symbol.metadata-polyfill.patch", "toolkit/content/vendor/lit/0007-Freeze-template-literals-to-match-the-spec.patch", "toolkit/content/widgets/vendor/lit.all.mjs"], "git_node": "25b460c555a79b7783a762d5b1f1e7238ec190a9", "git_parents": ["e0e5e77e2667232b61f7e55b06fd2ca60e0bcc11"], "node": "77605910a01099c6ea502a8caadaa9df09e305d8", "parents": ["6652b4e64e2ebb77b7ff1fa3070ae93ce687cfa1"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2079660 - Make `nsIFrame::UsedUserSelectRecurse` treat `nsTableColFrame` as non-selectable r=layout-reviewers,emilio\n\n`nsTableFrame` has `nsTableColGroupFrame`s which have some\n`nsTableColFrame`s after `nsTableRowGroupFrame`s. Then, peeking offset\nafter the last content in the last cell returns a `nsTableColFrame` and\nits content may be the `\u003ctable\u003e` or a `\u003ccolgroup\u003e` or a `\u003ccol\u003e`. Then,\nthe caller treat it as start of the content. Then, from HTML point of\nview, the position appears after the last cell so that caret navigation\nmay be locked into the `\u003ctable\u003e`.\n\n`nsTableColFrame` shouldn't have visible content like the usual frames.\nTherefore, we should be able to treat it as non-selectable by **user**.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338976\n", "files": ["layout/generic/nsIFrame.cpp", "testing/web-platform/tests/selection/selection-modify-across-minimum-table.html", "testing/web-platform/tests/selection/selection-modify-across-table-containing-caption.html", "testing/web-platform/tests/selection/selection-modify-across-table-containing-col.html", "testing/web-platform/tests/selection/selection-modify-across-table-containing-tfoot-after-tbody.html", "testing/web-platform/tests/selection/selection-modify-across-table-containing-tfoot-before-tbody.html", "testing/web-platform/tests/selection/selection-modify-across-table-containing-thead.html"], "git_node": "1aa9a48e23be50773e7da967403803fd28ad14ac", "git_parents": ["25b460c555a79b7783a762d5b1f1e7238ec190a9"], "node": "0509feb3e0fe918766e489c230bb98ddd05c7c25", "parents": ["77605910a01099c6ea502a8caadaa9df09e305d8"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2079660 - Make `AutoClonedSelectionRangeArray::ExtendAnchorFocusRangeFor` never extend the range with newly crossing an any table element boundary r=m_kato\n\nWhen the range is collapsed at end of the last cell, it starts returning\na range crosses the table element boundary. Therefore, when pressing\n`Delete` key, no content will be deleted but selection is collapsed to\nend of the extended range so that caret will be moved after the table.\n\nWe shouldn't touch content across any table element boundaries outside\nthe range. Therefore, we should set the limiter to the closest inclusive\nancestor any table element of the common ancestor of the range.\n\nThe new passes of the tests are almost compatible with the other\nbrowsers. However, 2 new passes in `forwarddelete.html.ini` cause only\nFirefox start passing. The tests are `foo{}\u003cp\u003e` cases. The other\nbrowsers do not remove the empty `\u003cp\u003e`. However, this case should not\nbe used in the wild because empty blocks are not visible with the\ndefault style. Therefore, it should be okay.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338977\n", "files": ["editor/libeditor/AutoClonedRangeArray.cpp", "editor/libeditor/AutoClonedRangeArray.h", "editor/libeditor/HTMLEditUtils.h", "editor/libeditor/HTMLEditorDeleteHandler.cpp", "editor/libeditor/TextEditSubActionHandler.cpp", "editor/libeditor/tests/browserscope/lib/richtext2/currentStatus.js", "testing/web-platform/meta/editing/run/forwarddelete.html.ini", "testing/web-platform/meta/input-events/input-events-get-target-ranges-forwarddelete.tentative.html.ini", "testing/web-platform/tests/editing/data/forwarddelete.js"], "git_node": "ba4cbd4ca6b89f81ab330bd713d5bca02f4acfee", "git_parents": ["1aa9a48e23be50773e7da967403803fd28ad14ac"], "node": "09d32113e7989ea71f2a347a281f39c95ce39b75", "parents": ["0509feb3e0fe918766e489c230bb98ddd05c7c25"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2088723 - Get rid of `dom.selection.exclude_non_selectable_nodes` pref r=jjaschke\n\nStopping excluding non-selectable nodes from selection ranges fixed web\ncompat issues and improved the performance. Therefore, we won't use the\nold behavior anymore. Let's delete the pref.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339372\n", "files": ["dom/base/Selection.cpp", "dom/base/test/test_user_select.html", "layout/base/tests/multi-range-user-select.html", "modules/libpref/init/StaticPrefList.yaml", "toolkit/components/aboutconfig/test/browser/browser_clipboard.js"], "git_node": "f7bc0ba29ec78ddb03e5ee987e6858a48add6764", "git_parents": ["ba4cbd4ca6b89f81ab330bd713d5bca02f4acfee"], "node": "d769b0c370cfdf7a0db9ffca52fb9d93e5629ed2", "parents": ["09d32113e7989ea71f2a347a281f39c95ce39b75"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2088732 - Apply upstream fix to handle legacy bitcode without GUID metadata properly. r=firefox-build-system-reviewers,ahochheiden\n\nTests are filtered out from the patch because:\n- that makes the patch larger than necessary.\n- binary files can't be applied with `patch`.\n- we don't run them anyways.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339387\n", "files": ["build/build-clang/clang-23.json", "build/build-clang/llvmorg-24-init-18148-g72e032ac6e74.patch"], "git_node": "e300a81c9ce8c3ea7121ce3d9c767872b5cf47c8", "git_parents": ["f7bc0ba29ec78ddb03e5ee987e6858a48add6764"], "node": "fc151ceb0cca1b49b170e42fc822abf51012e951", "parents": ["d769b0c370cfdf7a0db9ffca52fb9d93e5629ed2"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2088337 - Implement CSS ident() substitution function. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339036\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "servo/components/style/custom_properties.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/mod.rs", "servo/components/style/substitution/ident.rs", "servo/components/style/substitution/mod.rs", "servo/components/style/values/mod.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/__dir__.ini", "testing/web-platform/meta/css/css-anchor-position/anchor-ident-function.html.ini", "testing/web-platform/meta/css/css-anchor-position/position-try-ident-function.html.ini", "testing/web-platform/meta/css/css-conditional/container-queries/container-ident-function.html.ini", "testing/web-platform/meta/css/css-link-params/link-parameters-computed.html.ini", "testing/web-platform/meta/css/css-properties-values-api/registered-property-ident-function.html.ini", "testing/web-platform/meta/css/css-values/ident-function-computed.html.ini", "testing/web-platform/meta/css/css-values/ident-function-parsing.html.ini", "testing/web-platform/meta/css/css-values/ident-function-substitution.html.ini", "testing/web-platform/meta/css/css-values/random-computed.tentative.html.ini", "testing/web-platform/meta/css/css-variables/var-ident-function.html.ini", "testing/web-platform/meta/scroll-animations/css/timeline-names-ident-function.html.ini"], "git_node": "ea36bf068b0eefdc8e3dd315d662e5d98cf3e2b2", "git_parents": ["e300a81c9ce8c3ea7121ce3d9c767872b5cf47c8"], "node": "22f78cc869cd785c1ddb4cbfa2fa050f1cb521d8", "parents": ["fc151ceb0cca1b49b170e42fc822abf51012e951"], "tags": []}, {"author": "Shravan Narayan \u003cshravanrn@gmail.com\u003e", "branch": "default", "desc": "Bug 2087743 - Update rlbox_wasm2c_sandbox to new version r=glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338505\n", "files": ["config/external/rlbox_wasm2c_sandbox/moz.yaml", "third_party/rlbox_wasm2c_sandbox/include/wasm2c_rt_mem.h", "third_party/rlbox_wasm2c_sandbox/src/wasm2c_rt_mem.c", "third_party/rlbox_wasm2c_sandbox/src/wasm2c_rt_minwasi.c"], "git_node": "4e0698f2e885c36794be05e9b9ff61c0eb5198bb", "git_parents": ["ea36bf068b0eefdc8e3dd315d662e5d98cf3e2b2"], "node": "db706f1f4d8ea2b8b0bbcc2e12e12cd59979428c", "parents": ["22f78cc869cd785c1ddb4cbfa2fa050f1cb521d8"], "tags": []}, {"author": "python273 \u003ciam@python273.pw\u003e", "branch": "default", "desc": "Bug 2080469 - Prevent texture feedback when rendering blurred Canvas2D strokes. r=lsalzman,gfx-reviewers\n\nAllocate new stroke masks and uploaded surfaces away from the current\nrender target's backing texture while preserving shared-page allocation.\nReject aliased surface draws so cached masks use the existing fallback\ninstead of silently losing the filtered 