arents": ["27450e2575dbc3840778847b08fb0cd99dd97e9d"], "node": "aab55355fb615c4887b4d7e7ff6f6e2a97f030e0", "parents": ["6207dd694ade72b2de6f58ebd02123f31be4df8a"], "tags": []}], "date": 1794410935, "git_changesets": ["b2cad409d0297fa1a2cdcfc763cb8162a32525f9"], "user": "ffxbld@lando.moz.tools"}, "45763": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging b2d23f34c7a571b8a44e2dfbbc95e169222adac1 with DEVEDITION_161_0b2_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "cb5f4e83a0f198a8fdf0a844f15d5bf9dfb4066b", "git_parents": ["b2cad409d0297fa1a2cdcfc763cb8162a32525f9"], "node": "d071e8e3bdd8178b6355a7f6343506e06bef559c", "parents": ["aab55355fb615c4887b4d7e7ff6f6e2a97f030e0"], "tags": []}], "date": 1794411745, "git_changesets": ["cb5f4e83a0f198a8fdf0a844f15d5bf9dfb4066b"], "user": "ffxbld@lando.moz.tools"}, "45764": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073679 - Report a slice as cloneable only when its wrapped stream is r=necko-reviewers,kershaw\n\nSlicedInputStream::GetCloneable() returned true whenever the wrapped stream\nimplemented nsICloneableInputStream, but implementing that interface does not\nmean a stream can be cloned right now: nsMultiplexInputStream and\nnsBufferedInputStream both refuse once they have been read from.  Callers that\ncheck before cloning, such as NS_InputStreamIsCloneable(), were told yes and\nthen got a failure out of Clone().  Delegate to the wrapped stream, the way\nnsBufferedInputStream already does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328176\n", "files": ["xpcom/io/SlicedInputStream.cpp", "xpcom/tests/gtest/TestSlicedInputStream.cpp"], "git_node": "b579a69612a61d71ea1c3d1a49febed39908de6d", "git_parents": ["33abb900fc1646fef2e5ffed2d6b22e806ae10c1"], "node": "f5c2026342ea1f65ba479699b5251c181e749ea3", "parents": ["b03a18cc5ae8462246b00ac87f67435e3d9bbca9"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073679 - Reject an upload stream that NormalizeUploadStream can't make cloneable r=necko-reviewers,nika\n\nNormalizeUploadStream() promises that a parent-process upload stream is\ncloneable, seekable and synchronous, but the nsIBufferedInputStream and\nnsIMultiplexInputStream branches normalized the streams they wrap and then\nreturned the wrapper untouched, even when the wrapper itself could not be\ncloned because it had already been read from.  Callers that rely on the\nguarantee, such as HttpBaseChannel::CloneUploadStream and\nnsHttpTransaction::Init, are then left unable to clone it.\n\nCheck whether the stream can be used as-is first, and fail when a wrapper\nwould otherwise be returned unchanged, as that means it has been read from\nand can't be rebuilt without losing the data it has buffered.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328177\n", "files": ["netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/test/unit/test_upload_stream_normalization.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "35466dcd6cbd55a000d7ef1a2c96941f4495cc7d", "git_parents": ["b579a69612a61d71ea1c3d1a49febed39908de6d"], "node": "02cc3731b83e379411dbc552a939277e81f3c40f", "parents": ["f5c2026342ea1f65ba479699b5251c181e749ea3"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073679 - Don't fall back to sharing a seekable upload stream with the socket thread r=necko-reviewers,kershaw\n\nnsHttpTransaction::Init() reads the channel's own upload stream when it cannot\nclone it, which leaves the socket thread reading a stream the main thread may\nrewind for a redirect or an auth retry.  InternalSetUploadStream now refuses an\nupload stream that can't be cloned, so in the parent process make the fallback\nan error for seekable streams rather than sharing them, and assert that it\nisn't reached.  A stream the channel cannot rewind, such as an async pipe, is\nstill read directly.\n\nThe socket process is exempt: it reads its own deserialized copy of the body,\nwhich nothing else touches and which may not be cloneable (a file stream sent\nas a descriptor never is outside the parent).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328178\n", "files": ["netwerk/protocol/http/nsHttpTransaction.cpp"], "git_node": "97e43dd508b8a6583cc24a3fbd612996d8a71c6c", "git_parents": ["35466dcd6cbd55a000d7ef1a2c96941f4495cc7d"], "node": "882b3eeb5199f73f46e7a2d2a4fe81bcefb63f6d", "parents": ["02cc3731b83e379411dbc552a939277e81f3c40f"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074521 - Don't clone a non-seekable streaming upload body in nsHttpTransaction r=necko-reviewers,valentin\n\nA streaming body is usually an async pipe.  Cloning it adds a second reader\nthat nobody ever reads, so the pipe holds on to every segment written to it\nand buffers the whole upload in memory instead of staying at one pipe's\ncapacity.  HttpBaseChannel::CloneUploadStream already refuses to tee an upload\nstream for exactly that reason.\n\nOnly a parent-process fetch() with a ReadableStream body could hit this: a\ncontent-process streaming body crosses IPC as a DataPipeReceiver, which is not\ncloneable, so the clone attempt failed there anyway.\n\nA pipe can't be rewound, so the channel never touches it once the transaction\nhas it.  A streaming body can also be a Blob's own seekable stream, which the\nchannel may rewind for a redirect or an auth retry, so keep cloning that one.\nAdd a Blob stream case to test_fetch_streaming_upload.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328179\n", "files": ["netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/test/unit/test_fetch_streaming_upload.js"], "git_node": "29048bc19ae78bc8ec0df607e21463ee59ae181d", "git_parents": ["97e43dd508b8a6583cc24a3fbd612996d8a71c6c"], "node": "f73aa8ad8a88cfa925908eea0a127d42b86018d2", "parents": ["882b3eeb5199f73f46e7a2d2a4fe81bcefb63f6d"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090172: Hold a strong reference to the main-thread XHR across worker abort. r=dom-worker-reviewers,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340567\n", "files": ["dom/xhr/XMLHttpRequestWorker.cpp"], "git_node": "dcfe4882cc7f8caf3afacde608038d0e7e8e70fc", "git_parents": ["29048bc19ae78bc8ec0df607e21463ee59ae181d"], "node": "2c48d5fdd8c0ac30400787443de55a77aec958fd", "parents": ["f73aa8ad8a88cfa925908eea0a127d42b86018d2"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089908 - Add a Nimbus feature that turns on custom widgets from Nightly Labs r=maxx\n\nA Nimbus feature for custom widgets has been added so that a Nightly\nLabs recipe can turn them on. Its one variable, `enabled`, sets\n`browser.widgets.generated.enabled`, which shows the Widget Studio\npanel in the sidebar.\n\nThe variable sets the pref on the user branch, as the Link previews\nfeature does for `browser.ml.linkPreview.enabled`, so changing the\npref by hand unenrols the user.\n\nThe new test enrols in the feature and checks that the Widget Studio\ntool appears, then unenrols and checks that it's hidden again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340642\n", "files": ["browser/components/widgets/tests/browser/browser_sidebar_widget_studio.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "61977c1761532190e2d6b7c8bf15fa7f63c93aed", "git_parents": ["dcfe4882cc7f8caf3afacde608038d0e7e8e70fc"], "node": "f6e521f02456d48841624b211e7e20a57684b62c", "parents": ["2c48d5fdd8c0ac30400787443de55a77aec958fd"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\naf -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nan -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nar -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nast -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\naz -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nbe -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nbg -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nbn -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nbo -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nbqi -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nbr -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nbrx -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nbs -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nca -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nca-valencia -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\ncak -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nckb -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\ncs -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\ncy -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nda -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nde -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\ndsb -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nel -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nen-CA -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nen-GB -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\neo -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nes-AR -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nes-CL -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nes-ES -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nes-MX -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\net -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\neu -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nfa -\u003e 4dbb293af5820231d85747677e494dfa26b7aacc\nff -\u003e 4dbb293af5820231d85747677