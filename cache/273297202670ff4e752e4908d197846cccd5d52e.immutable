2768bf42a59f31f11402ce25a2791a971\nur -\u003e 6a7e0b92768bf42a59f31f11402ce25a2791a971\nuz -\u003e 6a7e0b92768bf42a59f31f11402ce25a2791a971\nvi -\u003e 6a7e0b92768bf42a59f31f11402ce25a2791a971\nwo -\u003e 6a7e0b92768bf42a59f31f11402ce25a2791a971\nxh -\u003e 6a7e0b92768bf42a59f31f11402ce25a2791a971\nzam -\u003e 6a7e0b92768bf42a59f31f11402ce25a2791a971\nzh-CN -\u003e 6a7e0b92768bf42a59f31f11402ce25a2791a971\nzh-TW -\u003e 6a7e0b92768bf42a59f31f11402ce25a2791a971\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "a6ec9352545e446c457dd2ea697d00fbe2e62689", "git_parents": ["8ed9d28bd4fce1b4eddcae2efb3de4a8401675d1"], "node": "dc072310ca888cf57d24eddeb85928a475298916", "parents": ["33ba65f615425eb7dd13407319ef8ab0b80d5bd4"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091872 - Update browser.storage.extension.html.ini for unexpected OK on macOS.\n", "files": ["testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini"], "git_node": "8eb03a2c70d5f592b199c05f06b61e54d7334fc5", "git_parents": ["a6ec9352545e446c457dd2ea697d00fbe2e62689"], "node": "de63947e032f05c21604be1a00d0d08129296ed0", "parents": ["dc072310ca888cf57d24eddeb85928a475298916"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093773 - Update wpt metadata @ traverseTo-and-forward-in-cross-site-iframe.html.ini r=Sasha DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343341\n", "files": ["testing/web-platform/meta/navigation-api/navigation-methods/traverseTo-and-forward-in-cross-site-iframe.html.ini"], "git_node": "b6de193c35e44269dd132a71534b75b03688aec9", "git_parents": ["8eb03a2c70d5f592b199c05f06b61e54d7334fc5"], "node": "98741d90d775f40849451008a62eb3d34dc478eb", "parents": ["de63947e032f05c21604be1a00d0d08129296ed0"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2091718 - Create a new verifyTheNewTabAppShortcutTest regression UI tests r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341831\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/LauncherPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/LauncherSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/HomescreenLauncherIconTest.kt"], "git_node": "ac2a3adc8e7c3374f45b5c95e0f15b844be76b80", "git_parents": ["b6de193c35e44269dd132a71534b75b03688aec9"], "node": "631eccffa550bd69d14ecca138e5d2361ca4a182", "parents": ["98741d90d775f40849451008a62eb3d34dc478eb"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2083581 - Also check HTTPS endpoint to confirm locked captive portal r=necko-reviewers,sunil,extension-reviewers,robwu\n\nWhen the canonical captive portal check looks intercepted, we now make a second\nrequest to an HTTPS endpoint before deciding the network is locked. If that\nrequest gets through, the portal isn't actually blocking traffic, so we report\nthe network as an unlocked portal and skip the login flow. The endpoint is set\nby `captivedetect.httpsCheck.url`, and the check can be turned off with\n`captivedetect.httpsCheck.enabled`.\n\nThe new path can go straight from `UNKNOWN` to `UNLOCKED_PORTAL` without\npassing through the login or login-success notifications. So the\n`ipc:network:captive-portal-set-state` notification is now sent from\nStateTransition and fires on every real state change.\nContent processes now always see the current state, and repeated notifications\nfor an unchanged state are dropped.\n\nOne side effect for WebExtensions: `browser.captivePortal.onStateChanged` now\nfires whenever the state changes. This includes the first transition to\nnot_captive and the reset to unknown when detection stops.\nThat matches the documented behaviour of the event: \"Fired when the captive\nportal state changes\" - which it previously didn't quite meet.\nThe webextension xpcshell-test now expects the initial not_captive event.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335048\n", "files": ["modules/libpref/init/all.js", "netwerk/base/CaptivePortalService.cpp", "netwerk/base/nsICaptivePortalService.idl", "netwerk/test/unit/test_captive_portal_service.js", "testing/profiles/unittest-required/user.js", "testing/profiles/xpcshell/user.js", "toolkit/components/captivedetect/CaptiveDetect.sys.mjs", "toolkit/components/captivedetect/nsICaptivePortalDetector.idl", "toolkit/components/captivedetect/test/unit/test_captive_portal_https_check.js", "toolkit/components/captivedetect/test/unit/xpcshell.toml", "toolkit/components/extensions/test/xpcshell/test_ext_captivePortal.js", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "7750f742b9433767f2ffa57ba81235e11fc9629e", "git_parents": ["ac2a3adc8e7c3374f45b5c95e0f15b844be76b80"], "node": "6838ea02564caa5167cc916b0037afd6a51187ab", "parents": ["631eccffa550bd69d14ecca138e5d2361ca4a182"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2090463 - Coalesce queued spellchecks over dirty DOM ranges. r=masayuki\n\nKeep the previous check queued if extending its range fails.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337032\n", "files": ["editor/libeditor/HTMLEditorMutationObserver.cpp", "editor/spellchecker/tests/mochitest.toml", "editor/spellchecker/tests/test_spellcheck_after_many_dom_mutations.html", "extensions/spellcheck/src/mozInlineSpellChecker.cpp", "extensions/spellcheck/src/mozInlineSpellChecker.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "b54e3f1d48c005f39e532840b224646fd7b83f6a", "git_parents": ["7750f742b9433767f2ffa57ba81235e11fc9629e"], "node": "4048043a4059b6b66da8030aad021a337b491250", "parents": ["6838ea02564caa5167cc916b0037afd6a51187ab"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2090463 - Check the modified text node for spellcheck eligibility. r=masayuki\n\nHTMLEditor::CharacterDataChanged() used the parent of the modified node to\ndecide whether to queue a spellcheck. InclusiveDescendantMayNeedSpellchecking()\nreturns true whenever the parent may have element children, because one of them\nmay enable spellchecking. However, only the modified node is checked, so its\nelement siblings are irrelevant. As a result, modifying text under\nspellcheck=\"false\" next to an element, or modifying a comment, queued a\nspellcheck. Each queued check holds a Range which observes DOM mutations, so\nmodifying a lot of such text nodes in one task became quadratic.\n\nTherefore, this patch ignores character data changes of non-Text nodes and asks\nShouldSpellCheckNode() about the modified Text node itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337906\n", "files": ["editor/libeditor/HTMLEditorMutationObserver.cpp", "editor/spellchecker/tests/mochitest.toml", "editor/spellchecker/tests/test_spellcheck_after_dom_text_change.html"], "git_node": "fa0e1bca0189d6a8d9ecd5379f324e31369cabe8", "git_parents": ["b54e3f1d48c005f39e532840b224646fd7b83f6a"], "node": "745a436c0b70bf3dbcbae72b57b392f0736b7304", "parents": ["4048043a4059b6b66da8030aad021a337b491250"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2093551 - Stop reverting the urlbar when opening a result in a background tab r=adw,urlbar-reviewers\n\nDepends on D343396\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343448\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js", "browser/components/urlbar/tests/browser/browser_locationBarCommand.js"], "git_node": "98b7cf31f8354e71f5229ace0f8eca660eee8782", "git_parents": ["fa0e1bca0189d6a8d9ecd5379f324e31369cabe8"], "node": "dc5a1e5a4781e3cdcae8b46e754ccfa5bc38c08e", "parents": ["745a436c0b70bf3dbcbae72b57b392f0736b7304"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082507 - Part 1: Add DeleteBuffer function to dispose of a buffer allocated with NewBuffer r=spidermonkey-reviewers,dminor\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335671\n", "files": ["js/src/gc/Allocator-inl.h"], "git_node": "4c56501ca2567456cb4d95900e0968b20eb2ce88", "git_parents": ["98b7cf31f8354e71f5229ace0f8eca660eee8782"], "node": "38b795bbb644057f2107b8064e04ba88da5e3f44", "parents": ["dc5a1e5a4781e3cdcae8b46e754ccfa5bc38c08e"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082507 - Part 2: Refactor usesEnvironmentChain_ to use a single byte r=spidermonkey-reviewers,dminor\n\nThe following patches will replace use of special pointers to IonScript and\nBaselineScript with separate state enums. To do this without increasing the\nsize of JitScript we need an extra byte. It turns out the this field uses two\nbyte to represent three possible states (because of its use of Maybe). This can\nbe changed to use a single byte.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335672\n", "files": ["js/src/jit/JitScript.cpp", "js/src/jit/JitScript.h"], "git_node": "9acfa3f9a913a6886164447cc1c72a58f1ae2373", "git_parents": ["4c56501ca2567456cb4d95900e0968b20eb2ce88"], "node": "8828b8a16ca2d9df00eb61d474e26aa02349d015", "parents": ["38b795bbb644057f2107b8064e04ba88da5e3f44"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082507 - Part 3: Move state flags out of BaselineScript pointer r=spidermonkey-reviewers,iain\n\nWe'll need to trace the baseline script field of a JitScript so it's helpful to\nmove the state information out of there. This adds an enum for the script state\nand stores it in a separate field.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335673\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/JSJitFrameIter.cpp", "js/src/jit/JitScript.cpp", "js/src/jit/JitScript.h", "js/src/jit/MacroAssembler.cpp", "js/src/vm/JSScript-inl.h"], "git_node": "ad051a67437cf7e92d7f5aa7956f5050b6120eac", "git_parents": ["9acfa3f9a913a6886164447cc1c72a58f1ae2373"], "node": "6e94dde9f3a84a8991efe7ff3998656ac272e936", "parents": ["8828b8a16ca2d9df00eb61d474e26aa02349d015"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082507 - Part 4: Move state flags out of IonScript pointer r=spidermonkey-reviewers,iain\n\nThis does the same as the previous patch for the ion script pointer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335674\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/JSJitFrameIter.cpp", "js/src/jit/JitScript.cpp", "js/src/jit/JitScript.h", "js/src/jit/MacroAssembler.cpp", "js/src/vm/JSScript-inl.h"], "git_node": "20352bab997498e547a0d276380caa83c17029a0", "git_parents": ["ad051a67437cf7e92d7f5aa7956f5050b6120eac"], "node": "8667c45c2847a325f89621d3591988b85e4db8f9", "parents": ["6e94dde9f3a84a8991efe7ff3998656ac272e936"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082507 - Part 5: Use the buffer allocator for BaselineScript r=spidermonkey-reviewers,iain\n\nThis adds some extra tracking of GC state in GCContext so we can assert which\nparts of the GC can't destroy baseline scripts. We can skip explicitly freeing\nthis data in the prepare phase of the GC since it will be collected later.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335675\n", "files": ["js/public/MemoryMetrics.h", "js/src/frontend/Stencil.cpp", "js/src/gc/GC.cpp", "js/src/gc/GCContext.h", "js/src/gc/GCEnum.h", "js/src/gc/GCInternals.h", "js/src/gc/RootMarking.cpp", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineDebugModeOSR.cpp", "js/src/jit/BaselineJIT.cpp", "js/src/jit/BaselineJIT.h", "js/src/jit/JitScript.cpp", "js/src/jit/JitScript.h", "js/src/vm/JSScript.cpp", "js/src/vm/MemoryMetrics.cpp", "js/src/vm/Runtime.h", "js/src/vm/SelfHosting.cpp", "js/xpconnect/src/XPCJSRuntime.cpp"], "git_node": "5d60c295ce8500b43d4daba2ca37a274bd181e9c", "git_parents": ["20352bab997498e547a0d276380caa83c17029a0"], "node": "c7455380ea6b8550d2af27cee487206918a95dad", "parents": ["8667c45c2847a325f89621d3591988b85e4db8f9"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082507 - Part 6: Use the buffer allocator for IonScript r=spidermonkey-reviewers,iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335676\n", "files": ["js/src/gc/GCEnum.h", "js/src/gc/Tracer.h", "js/src/jit/Bailouts.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/Ion.cpp", "js/src/jit/Ion.h", "js/src/jit/IonScript.h", "js/src/jit/JitFrames.cpp", "js/src/jit/JitScript.cpp", "js/src/jit/JitScript.h", "js/src/vm/JSScript.cpp", "js/src/vm/MemoryMetrics.cpp", "js/xpconnect/src/XPCJSRuntime.cpp"], "git_node": "d184f55acd6dc355224e3b4cd8bece869ca7852d", "git_parents": ["5d60c295ce8500b43d4daba2ca37a274bd181e9c"], "node": "0ad4f19384bbbd063567ccbd2335b57bf32e2131", "parents": ["c7455380ea6b8550d2af27cee487206918a95dad"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082507 - Part 7: Remove unused GCStructPtr r=spidermonkey-reviewers,iain\n\nThis is no longer used following the previous patches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335677\n", "files": ["js/src/gc/Barrier.h"], "git_node": "335d8ff8a6daab1c64b5aeaab871f89a6fc5a179", "git_parents": ["d184f55acd6dc355224e3b4cd8bece869ca7852d"], "node": "6514ee9ec439889e79ca5c10b40de31c3fed4ce2", "parents": ["0ad4f19384bbbd063567ccbd2335b57bf32e2131"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082507 - Part 8: Use GCPtr in IonScript r=spidermonkey-reviewers,iain\n\nWe can use GCPtr for these fields as this has an empty destructor. We do have\nto clear the fields if we are destroying them outside GC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335678\n", "files": ["js/src/jit/Ion.cpp", "js/src/jit/IonScript.h"], "git_node": "93b02a823ff8bfb9682fc0d315777a0f9a40f026", "git_parents": ["335d8ff8a6daab1c64b5aeaab871f89a6fc5a179"], "node": "ec6678e7821107bdc8ce1c04043df50749a4852f", "parents": ["6514ee9ec439889e79ca5c10b40de31c3fed4ce2"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082507 - Part 9: Root IonScript pointers in SnapshotIterator and InlineFrameIterator r=spidermonkey-reviewers,iain\n\nThis is otherwise a rooting hazard. The GC can't yet move buffers but this is\nlikely to be implemented eventually.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343155\n", "files": ["js/src/jit/BaselineBailouts.cpp", "js/src/jit/JSJitFrameIter.h", "js/src/jit/JitFrames.cpp"], "git_node": "54651e9be14e395323e95903a04472c1b4d8366e", "git_parents": ["93b02a823ff8bfb9682fc0d315777a0f9a40f026"], "node": "74c37af8a799956ec5e8ee4fec0494c61d0aaef2", "parents": ["ec6678e7821107bdc8ce1c04043df50749a4852f"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082507 - Part 10: Root IonScript use in Ion ICs and HandleException r=spidermonkey-reviewers,iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343156\n", "files": ["js/src/jit/IonIC.cpp", "js/src/jit/JitF