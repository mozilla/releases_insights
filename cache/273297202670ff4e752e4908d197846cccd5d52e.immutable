la.com\u003e", "branch": "default", "desc": "Bug 2088600 - Remove EV treatment from DigiCert Trusted Root G4. r=keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340385\n", "files": ["security/certverifier/ExtendedValidation.cpp"], "git_node": "2048670d0046dc3013327e5d98fb05854bcf9f1d", "git_parents": ["09755ae32aaafcdb8b46aa6c95806338f047a906"], "node": "13d8b9bae905f7579b011382ec11ef6fa09f71d0", "parents": ["c650550afc8224d5635746170d85da3964bb1abd"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 1998954 - Use new push/replace path for frames. r=dom-core-reviewers,farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D271774\n", "files": ["docshell/base/nsDocShell.cpp", "dom/base/nsFrameLoader.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/navigation-api/__dir__.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-to-srcdoc.html.ini", "testing/web-platform/meta/navigation-api/navigation-history-entry/entries-after-blank-navigation.html.ini", "testing/web-platform/meta/navigation-api/navigation-history-entry/entries-after-blob-navigation.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/traverseTo-navigates-multiple-iframes.html.ini"], "git_node": "c521a2d3f842417ae61856513626118b66d06751", "git_parents": ["2048670d0046dc3013327e5d98fb05854bcf9f1d"], "node": "92b24bc8cbd888cfb0b1cf9311f6b5f5419cdc3e", "parents": ["13d8b9bae905f7579b011382ec11ef6fa09f71d0"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088943 - Use the inherited principal URI for about:srcdoc SHEs when checking same-origin for the Navigation API. r=dom-core-reviewers,vhilla,necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339566\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/nsDocShell.cpp", "docshell/shistory/SessionHistoryEntry.cpp", "docshell/shistory/SessionHistoryEntry.h", "docshell/shistory/nsSHistory.cpp", "netwerk/base/nsNetUtil.cpp", "netwerk/base/nsNetUtil.h", "testing/web-platform/meta/navigation-api/navigation-history-entry/entries-after-srcdoc-navigation.html.ini"], "git_node": "78d706c38dd4afedf0f0f74c77b6291f34cd1572", "git_parents": ["c521a2d3f842417ae61856513626118b66d06751"], "node": "a7ce6f48d509bcaad549e398e52b1ab49462f5b7", "parents": ["92b24bc8cbd888cfb0b1cf9311f6b5f5419cdc3e"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1821615 - Part 1: Add an innerHTML fast path for a small subset of HTML. r=hsivonen\n\nSimple markup whose tags trigger no implied end tags, foster parenting or\nadoption agency doesn't need the full parser's state machine and tree\nbuilder. The fast path validates all of the input before it creates any node,\nso a rejected input leaves the target untouched for the full parser. It is\ncontrolled by dom.html_fragment_fast_path.enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337962\n", "files": ["dom/base/FragmentOrElement.cpp", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/base/nsDOMWindowUtils.cpp", "dom/base/test/mochitest.toml", "dom/base/test/test_innerHTML_fast_path.html", "dom/base/test/test_innerHTML_fast_path_csp.html", "dom/interfaces/base/nsIDOMWindowUtils.idl", "modules/libpref/init/StaticPrefList.yaml", "parser/html/moz.build", "parser/html/nsHtml5FragmentFastPath.cpp", "parser/html/nsHtml5FragmentFastPath.h", "parser/html/nsHtml5PortabilityHSupplement.h", "parser/html/nsHtml5TokenizerCppSupplement.h", "parser/htmlaccel/gtest/TestHtmlSimd.cpp", "parser/htmlaccel/htmlaccel.h", "parser/htmlaccel/htmlaccelNotInline.cpp", "parser/htmlaccel/htmlaccelNotInline.h", "tools/clang-tidy/config.yaml"], "git_node": "99aff747e19316702d2112197e958d82f54184de", "git_parents": ["78d706c38dd4afedf0f0f74c77b6291f34cd1572"], "node": "ce76e4e1f8a04982e202ea0bf4ae4e8f3f2cbeda", "parents": ["a7ce6f48d509bcaad549e398e52b1ab49462f5b7"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1821615 - Part 2: Support comments in the innerHTML fast path. r=hsivonen\n\nComments don't trigger any tree builder fix-up in the supported contexts, and\ntemplates commonly contain them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337963\n", "files": ["dom/base/test/test_innerHTML_fast_path.html", "parser/html/nsHtml5FragmentFastPath.cpp", "parser/html/nsHtml5FragmentFastPath.h"], "git_node": "1eb85064104d3efd07dad137ab485c6f3e4336d9", "git_parents": ["99aff747e19316702d2112197e958d82f54184de"], "node": "3bf5009e1e64fba0c57ac8dbe902e2e819f9fd2d", "parents": ["ce76e4e1f8a04982e202ea0bf4ae4e8f3f2cbeda"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1821615 - Part 3: Support character references in the innerHTML fast path. r=hsivonen\n\nOnly the references whose decoding doesn't depend on the context are decoded.\nThe full parser handles the rest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337964\n", "files": ["dom/base/test/test_innerHTML_fast_path.html", "parser/html/nsHtml5FragmentFastPath.cpp", "parser/html/nsHtml5FragmentFastPath.h"], "git_node": "cebe405882f38f2b1e53c9f733ebb706c7533051", "git_parents": ["1eb85064104d3efd07dad137ab485c6f3e4336d9"], "node": "c04181102b3895b812cf59bca044dfaf20679ddc", "parents": ["3bf5009e1e64fba0c57ac8dbe902e2e819f9fd2d"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1821615 - Part 4: Use the innerHTML fast path for DOMParser documents. r=hsivonen\n\nInput that is only body content after optional whitespace parses into the\nbody that the full parser would create, in quirks mode as without a doctype.\nPages that render through DOMParser.parseFromString() benefit like innerHTML\ndoes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337965\n", "files": ["dom/base/DOMParser.cpp", "dom/base/test/test_innerHTML_fast_path.html", "parser/html/nsHtml5FragmentFastPath.cpp", "parser/html/nsHtml5FragmentFastPath.h"], "git_node": "a0eb5f92df78501543f159d9919ad540c6e3e9ce", "git_parents": ["cebe405882f38f2b1e53c9f733ebb706c7533051"], "node": "5f2a43645571c75724391fd5641d2bb0dcf850e5", "parents": ["c04181102b3895b812cf59bca044dfaf20679ddc"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1821615 - Part 5: Add telemetry for the innerHTML fast path. r=hsivonen\n\nUse counters record whether innerHTML and DOMParser input was parsed by the\nfast path or left to the full parser. Sampled timing distributions, labeled by\nthat outcome and the input length, show what the fast path saves and what a\nrejection costs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337966\n", "files": ["dom/base/DOMParser.cpp", "dom/base/FragmentOrElement.cpp", "dom/base/UseCounters.conf", "dom/base/test/browser.toml", "dom/base/test/browser_fragment_parsing_telemetry.js", "dom/base/test/browser_use_counters.js", "dom/base/test/file_use_counter_domparser_fast_path.html", "dom/base/test/file_use_counter_innerhtml_fast_path.html", "dom/base/use_counter_metrics.yaml", "dom/metrics.yaml", "modules/libpref/init/StaticPrefList.yaml", "parser/html/nsHtml5FragmentFastPath.cpp", "parser/html/nsHtml5FragmentFastPath.h"], "git_node": "6c3358bd4216d2e9db4d962a948b7dc5ca46caf5", "git_parents": ["a0eb5f92df78501543f159d9919ad540c6e3e9ce"], "node": "93d9956f42b522dae4533d3b4ed337924de6660d", "parents": ["5f2a43645571c75724391fd5641d2bb0dcf850e5"], "tags": []}, {"author": "Mitchell Plyler \u003cmlplyler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089796 - Flip smart shortcuts default consts to match rollout. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340169\n", "files": ["browser/extensions/newtab/lib/SmartShortcutsRanker/RankShortcuts.mjs", "browser/extensions/newtab/test/xpcshell/test_ShortcutRanker.js"], "git_node": "8c530a19691d1a3dcb51a2219acd9f084da4cc39", "git_parents": ["6c3358bd4216d2e9db4d962a948b7dc5ca46caf5"], "node": "4462b76b4fb3449a0ed6cad4f2b6ac180babf47c", "parents": ["93d9956f42b522dae4533d3b4ed337924de6660d"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058495 - Local storage: LSFlushOp::Commit failures lead to wrong quota usage r=dom-storage-reviewers,jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314652\n", "files": ["dom/localstorage/ActorsParent.cpp", "dom/localstorage/LSWriteOptimizer.cpp", "dom/localstorage/LSWriteOptimizer.h", "dom/localstorage/LSWriteOptimizerImpl.h", "dom/localstorage/test/gtest/TestLSWriteOptimizer.cpp", "dom/localstorage/test/gtest/moz.build", "dom/localstorage/test/unit/test_flushFailure.js", "dom/localstorage/test/unit/xpcshell.toml", "dom/quota/nsIQuotaArtificialFailure.idl"], "git_node": "608303da52ddcb500c532cd61d7ca8ec5ae8e02d", "git_parents": ["8c530a19691d1a3dcb51a2219acd9f084da4cc39"], "node": "dba6cb55fd0b20c3d032686f8515f62a4d83507b", "parents": ["4462b76b4fb3449a0ed6cad4f2b6ac180babf47c"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2089357 - Apply alpha: \"discard\" only in VideoFrame::Resource::CreateOpaque. r=media-playback-reviewers,padenot\n\nInitializeFrameWithResourceAndSize made the format opaque itself before\nvalidating the image, while InitializeFrameFromOtherFrame used CreateOpaque.\nBoth now go through CreateOpaque, and Format::MakeOpaque is private, so the\ndiscard can be recorded in one place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340030\n", "files": ["dom/media/webcodecs/VideoFrame.cpp", "dom/media/webcodecs/VideoFrame.h"], "git_node": "acd769560e5b7c23acef0d264ebd1431764581b2", "git_parents": ["608303da52ddcb500c532cd61d7ca8ec5ae8e02d"], "node": "b285c838bd12bb7ae7a4df6923615439adec5970", "parents": ["dba6cb55fd0b20c3d032686f8515f62a4d83507b"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082486 - Make the shortcuts tests set up their own state and balance their pref changes. r=omarg\n\nTests that left their pref changes in place, or relied on state left by earlier tests, failed when run on their own. Each test now sets up what it needs, and the SearchService status is forced inside the tab it is needed for.\n\nNote: I've made significant changes to `browser_chat_shortcuts.js` since I initially filed this bug. I'm no longer able to repro the memory leak that was present earlier. I'm also working on a separate bug to break this test up into multiple different files, as I made `browser_chat_shortcuts.js` very large as I worked to get Hightlight to Search ready. (See [[ https://bugzilla.mozilla.org/show_bug.cgi?id=2085414 | bug 2085414 ]])\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340216\n", "files": ["browser/components/genai/tests/browser/browser_chat_shortcuts.js"], "git_node": "d50e4186678dbd4afb5896a86ca830cc48bb71b9", "git_parents": ["acd769560e5b7c23acef0d264ebd1431764581b2"], "node": "4bdeb0fbc057b87c123ff63c9e6ba6ec1c8a7f6b", "parents": ["b285c838bd12bb7ae7a4df6923615439adec5970"], "tags": []}, {"author": "RuslanSemchenko \u003cuncleruc2075@gmail.com\u003e", "branch": "default", "desc": "Bug 2042673 - Shut down SpiderMonkey before static destructors r=iain\n\nMove SpiderMonkey shutdown into an atexit handler to ensure that helper threads are shut down before static synchronization primitives are destroyed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339434\n", "files": ["js/src/fuzz-tests/tests.cpp"], "git_node": "59b4c18a69f4a6fc444b6f5eb968483e01af6547", "git_parents": ["d50e4186678dbd4afb5896a86ca830cc48bb71b9"], "node": "7d487b75ff7eb3837fabe630f887fed84a2f403f", "parents": ["4bdeb0fbc057b87c123ff63c9e6ba6ec1c8a7f6b"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087584 - Requeue dirty origins until they are initialized. r=dom-storage-reviewers,hsingh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338770\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/test/gtest/TestQuotaManager.cpp"], "git_node": "3e79b46d53d9331555d8684c4fb08c0296a1cc2f", "git_parents": ["59b4c18a69f4a6fc444b6f5eb968483e01af6547"], "node": "d37810f156a6a8a717b7627fa10389f54d690c16", "parents": ["7d487b75ff7eb3837fabe630f887fed84a2f403f"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089933 - Move the hostname into the by-name target in HappyEyeballsConnectionAttempt::ProcessHappyEyeballsOutput (Coverity CID 1704736) r=necko-reviewers,valentin\n\ndnsHostname is filled by happy_eyeballs_process_output on each loop\niteration and is not used after building the ByNameTarget, so move it\ninstead of copying it, as is already done for echConfig.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340269\n", "files": ["netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp"], "git_node": "e0a405cc205fd1c742039888ce5a3ab7571e2084", "git_parents": ["3e79b46d53d9331555d8684c4fb08c0296a1cc2f"], "node": "25da37a6233e1a3c27cc111fde6a9679e2966686", "parents": ["d37810f156a6a8a717b7627fa10389f54d690c16"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2088806 - Explicitly ignore the PrepareAbsoluteFrames result in the grid continuation setup (Coverity CID 1694862) r=TYLin,layout-reviewers\n\nIt is only called to pull the abspos frames into the list, which the\nfollowing loop walks regardless.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339445\n", "files": ["layout/generic/nsGridContainerFrame.cpp"], "git_node": "5a84fa626fa7c964c8421431eeef8a5cd885cbe4", "git_parents": ["e0a405cc205fd1c742039888ce5a3ab7571e2084"], "node": "796533e053e350d4c86f2f62931533f30c686a4a", "parents": ["25da37a6233e1a3c27cc111fde6a9679e2966686"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086981 - Report GMP process crashes to GeckoView r=geckoview-reviewers,m_kato\n\nWhen a GMP process crashes, we already generate the minidump and its\nparent will fire a \"gmp-plugin-crash\" event, but on Android nothing was\nlistening for it. ChildCrashHandler now does, and fires the appropriate\nintent for a background crash.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338250\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/GmpCrashTest.kt", "mobile/shared/components/geckoview/GeckoViewStartup.sys.mjs", "mobile/shared/modules/geckoview/ChildCrashHandler.sys.mjs"], "git_node": "6e72b0c7fca56976c3d3372e37359433ad6e0efd", "git_parents": ["5a84fa626fa7c964c8421431eeef8a5cd885cbe4"], "node": "85e9512ac93f75f5c05451370ef627ce97e978ff", "parents": ["796533e053e350d4c86f2f62931533f30c686a4a"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084089 - Skip the mots path index when exporting the governance docs r=firefox-source-docs-reviewers,ahal\n\nThe export only needs the module metadata. Directory.load() globs every\nmodule's include and exclude patterns over the whole tree, which took about\n4 seconds at the start of every docs build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335885\n", "files": ["python/mozbuild/mozbuild/sphinx.py"], "git_node": "54d19002b902c9230d72c8b506d43d04ec15c7f3", "git_parents": ["6e72b0c7fca56976c3d3372e37359433ad6e0efd"], "node": "dbbb7a0d9b8b05486ee48bbda9216b1bb4770602", "parents": ["85e9512ac93f75f5c05451370ef627ce97e978ff"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071700 - Update opentelemetry-cpp to v1.30.0 r=ArnaudBienner\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333553\n", "files": ["third_party/opentelemetry-cpp/CHANGELOG.md", "third_party/opentelemetry-cpp/README.md", "third_party/opentelemetry-cpp/api/include/opentelemetry/common/attribute_value.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/common/detail/ascii.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/common/key_value_iterable_view.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/common/kv_properties.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/common/spin_lock_mutex.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/common/string_util.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/context/context_value.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/context/runtime_context.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/nostd/string_view.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/semconv/telemetry_attributes.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/context.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/default_span.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/noop.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/provider.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/span_context.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/span_id.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/span_startoptions.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/trace_flags.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/trace_id.h", "t