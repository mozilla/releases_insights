26b650ec91265583cf782f0d579ca4b7417abb1", "25cf212c60fa60e877f35835299207adb7f5783b", "c62213b5fd412991cfc9a981adfa31e35c671049", "2711a83511c14ed61335411cee612e8aaa27bc5e", "140c43ecc618cc73aa4d46b3a3a7f2146d06b129", "51370d09db458f64aa2d610dc67c0a58dbc7daa9", "7f55e4ba1b9a75d163a960b7d97ddcd8d8566f5f", "5172d16b8127866b0a7d0f484d1091de08bf0c20", "3ab77a27140f5bdfee63c17a0ae38e02e8d3615d", "3d747f45151a27a04a6055adb841401b2caa0d1a", "6b8bd45d132ddcaf83183a24621e01f7ce4e792b", "d6ba48c569465e9f00c9d9521683f3c5f6f046b6", "3e7bc342ee743e006e7b11e9af1f9bcfbc720442", "498649bd2702da0e4895edffafe64f5f39472983", "d735660da6dd18fc1c290b527814faab5847fd8f", "fcd7ba65814cca6f61b375c2869e0c07225b4d52", "0242c516319c3cc900e8b3f6f45635c751021fff", "8afd6e8f846499ecfa2b4643f2af6ec1da242784", "7902cf35c88da2f0065139c430ede62fd69a4f32", "7f408e81968a6e2a39f7a18857ae3fa5b063a74d", "613914e84a3a7b955420a6812fd6ec71e6bd06dc", "ffd1e6bd71c58e2c275c5df7334d217cc14585ac", "696fc41d0864aa2d32c5aeb7f7e2a26f064e0437", "6d64132b63e1eee699fb4b7ffa622e5937f87206", "32008faeaba601519b2b55b149d22c8ebbabd61d", "b42441b06bc2b98160f12ee2dff262dd55583a9f"], "user": "imoraru@mozilla.com"}, "45737": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090612 - Remove nsIDocShellTreeOwner.sizeShellTo. r=smaug\n\nIt was only effectively used generically from SetPrimaryContentSize().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340611\n", "files": ["docshell/base/nsDocShellTreeOwner.cpp", "docshell/base/nsIDocShellTreeOwner.idl", "dom/base/nsGlobalWindowOuter.cpp", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/AppWindow.h", "xpfe/appshell/nsChromeTreeOwner.cpp", "xpfe/appshell/nsContentTreeOwner.cpp"], "git_node": "55e94d6647b0fc06312aa1e9800ba54ba862e0f3", "git_parents": ["b42441b06bc2b98160f12ee2dff262dd55583a9f"], "node": "f4226b1f4f9027526d4e25424b21ae878d002614", "parents": ["03e72d184a093fa3fda976ebfbe294a53b0bf969"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090612 - Remove dead tree owner code. r=smaug\n\nnsContentTreeOwner::mPrimary was never read, so AppWindow's primary and\nnon-primary owners were equivalent.\n\nnsDocShellTreeOwner::mTreeOwner could only be set via\nnsWebBrowser::SetTreeOwner(), which is never called since nsWebBrowser\nis never a child docshell.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340612\n", "files": ["docshell/base/nsDocShellTreeOwner.cpp", "docshell/base/nsDocShellTreeOwner.h", "toolkit/components/browser/nsWebBrowser.cpp", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/AppWindow.h", "xpfe/appshell/nsContentTreeOwner.cpp", "xpfe/appshell/nsContentTreeOwner.h"], "git_node": "d9d2b674be104583fd79424ee0f67339256335c8", "git_parents": ["55e94d6647b0fc06312aa1e9800ba54ba862e0f3"], "node": "0effc24ddf95aa9cce2098c2da5572161ec9ed95", "parents": ["f4226b1f4f9027526d4e25424b21ae878d002614"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090612 - Move window sizing methods from nsIDocShellTreeOwner to nsIAppWindow. r=smaug\n\nThey only make sense for AppWindow, and nsDocShellTreeOwner just returned\nNS_ERROR_NOT_IMPLEMENTED for them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340619\n", "files": ["browser/extensions/newtab/test/browser/browser_newtab_last_LinkMenu.js", "docshell/base/nsDocShellTreeOwner.cpp", "docshell/base/nsIDocShellTreeOwner.idl", "dom/base/nsGlobalWindowOuter.cpp", "toolkit/components/windowwatcher/nsWindowWatcher.cpp", "widget/DimensionRequest.cpp", "widget/DimensionRequest.h", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/AppWindow.h", "xpfe/appshell/nsChromeTreeOwner.cpp", "xpfe/appshell/nsContentTreeOwner.cpp", "xpfe/appshell/nsIAppWindow.idl"], "git_node": "ddbaa616c2fcbe34a9ee7b01965e39144f636b71", "git_parents": ["d9d2b674be104583fd79424ee0f67339256335c8"], "node": "77adf1cb80f6e6d58f88e8a0667995260f423410", "parents": ["0effc24ddf95aa9cce2098c2da5572161ec9ed95"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2083581 - Also check HTTPS endpoint to confirm locked captive portal r=necko-reviewers,sunil\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335048\n", "files": ["modules/libpref/init/all.js", "netwerk/base/CaptivePortalService.cpp", "netwerk/base/nsICaptivePortalService.idl", "netwerk/test/unit/test_captive_portal_service.js", "testing/profiles/unittest-required/user.js", "testing/profiles/xpcshell/user.js", "toolkit/components/captivedetect/CaptiveDetect.sys.mjs", "toolkit/components/captivedetect/nsICaptivePortalDetector.idl", "toolkit/components/captivedetect/test/unit/test_captive_portal_https_check.js", "toolkit/components/captivedetect/test/unit/xpcshell.toml", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "9ac81ad071b436fac05d3481a829eaff7a4edf21", "git_parents": ["ddbaa616c2fcbe34a9ee7b01965e39144f636b71"], "node": "68050628b2c9c2821b750a6613faa372ff3cb5fd", "parents": ["77adf1cb80f6e6d58f88e8a0667995260f423410"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2085919 - Remove the GeckoView config after each Gecko profiler run of the Android startup tests. r=mozperftest-reviewers,aglavic\n\nThe config used to stay on the device until the layer's teardown, so the app\nlaunches between the profiled runs were profiled too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336926\n", "files": ["python/mozperftest/mozperftest/system/geckoprofiler.py"], "git_node": "38bc925fac77dc47810c96bd7a50f5bf98b6025c", "git_parents": ["9ac81ad071b436fac05d3481a829eaff7a4edf21"], "node": "9ad3f0d929dc8cd693282e0396278f10b8881e96", "parents": ["68050628b2c9c2821b750a6613faa372ff3cb5fd"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2085919 - Merge the Gecko profiler markers into the simpleperf profiles in the combined profiling run of the Android startup tests. r=mozperftest-reviewers,aglavic\n\nIn our --gecko-profile newssite-applink-startup jobs, we do three profiling\nruns: one with simpleperf, one with only the gecko profiler, and one with both.\n\nFor the run with both profilers, we were outputting the collected profiles separately.\nThis patch makes us use the new profiler-edit functionality from\nhttps://github.com/firefox-devtools/profiler/pull/5448\nto create a merged profile: we take the samples from simpleperf and the markers\nfrom the Gecko profile.\n\nExample merged profile: https://share.firefox.dev/3U3xSRP\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336907\n", "files": ["python/mozperftest/mozperftest/profiler.py", "python/mozperftest/mozperftest/system/geckoprofiler.py", "python/mozperftest/mozperftest/system/simpleperf.py", "python/mozperftest/mozperftest/tests/test_geckoprofiler.py", "python/mozperftest/mozperftest/tests/test_profiler.py", "python/mozperftest/mozperftest/tests/test_simpleperf.py"], "git_node": "bf97ea568f0202681c02ff25918e3ef2dd7d4175", "git_parents": ["38bc925fac77dc47810c96bd7a50f5bf98b6025c"], "node": "7a605f909ea746794e426a76669ae5d0836e55af", "parents": ["9ad3f0d929dc8cd693282e0396278f10b8881e96"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2085919 - Add JS frames to the simpleperf profiles, using jitdump. r=mozperftest-reviewers,aglavic\n\nTo get JS frames into the stacks from simpleperf, we need to do similar\nthings as we do for the simpleperf sp3 profiles:\n\n- Set env vars for the JS engine, e.g. turn on jitdump output\n- Make simpleperf use framepointer unwinding, so that it can unwind JIT code\n  (only in the run with both profilers; the simpleperf-only run keeps DWARF\n  unwinding, which gives us Java stacks)\n- Fetch jitdump files so that samply import sees them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336927\n", "files": ["python/mozperftest/mozperftest/profiler.py", "python/mozperftest/mozperftest/system/geckoprofiler.py", "python/mozperftest/mozperftest/system/simpleperf.py", "python/mozperftest/mozperftest/tests/conftest.py", "python/mozperftest/mozperftest/tests/test_geckoprofiler.py", "python/mozperftest/mozperftest/tests/test_profiler.py", "python/mozperftest/mozperftest/tests/test_simpleperf.py"], "git_node": "ec7a4079b713d9f01bf93a208693c1e33afcc9ad", "git_parents": ["bf97ea568f0202681c02ff25918e3ef2dd7d4175"], "node": "02235177d73743e6fc1f5341ec6068bfc489230e", "parents": ["7a605f909ea746794e426a76669ae5d0836e55af"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083581 - Also check HTTPS endpoint to confirm locked captive portal r=necko-reviewers,sunil\" for causing xpc failures at /test_ext_captivePortal.js\n\nThis reverts commit 9ac81ad071b436fac05d3481a829eaff7a4edf21.\n", "files": ["modules/libpref/init/all.js", "netwerk/base/CaptivePortalService.cpp", "netwerk/base/nsICaptivePortalService.idl", "netwerk/test/unit/test_captive_portal_service.js", "testing/profiles/unittest-required/user.js", "testing/profiles/xpcshell/user.js", "toolkit/components/captivedetect/CaptiveDetect.sys.mjs", "toolkit/components/captivedetect/nsICaptivePortalDetector.idl", "toolkit/components/captivedetect/test/unit/test_captive_portal_https_check.js", "toolkit/components/captivedetect/test/unit/xpcshell.toml", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "a899ce0d009790d2b022938ad7f1b617232df18f", "git_parents": ["ec7a4079b713d9f01bf93a208693c1e33afcc9ad"], "node": "0836dba9a7a2ae62e31166db117b47a252f7e09b", "parents": ["02235177d73743e6fc1f5341ec6068bfc489230e"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mo