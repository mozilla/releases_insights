d4b4e427d09", "2fb28dd8d91dfc91c8a8234e627e1bda119f43ab", "b1176f2b0be7a5ff9675f80d762707f61e37e3df", "f2c3375aba65d66ec499d2ab83feaf1f25d9258b", "0e0221a364b4ebc31f8f72572135badf3275d43d", "18043b8f42119af24b7735acd346cd71ba73c422", "4d3434bb9a8c8e7279b4e33ef72c849d63b1f7b6", "3a9788c1a5f11fa72491ff25864c8ce71c70837e", "ac785d1b7768c5d9d59ad003be3073d73bc4a040", "e3a79ab92465e49e1058b2de8359865e24082686", "a35301b6717cf9a78900f37018809591dc6a9f0a", "1ec153273d535be36875281a41a78c3d80061db6", "88ba12b7b3c89a2fccac1f856f0eb529a6ffa6c5", "dfa673c9a8dfd6c16f5a775763ba1daf599676bb", "60e3e480f4ed93e9cb0aab44a9cb61a868427583", "f112fd560d25544b145df8ff2d9a4f3f786ae72a", "474df7e6aab787a8ad1fb64f74ccfd24a4666aaa", "a050a36da07b307171aaaad0248e9f8ab4ef4c3f", "fa1e90ea670c4234c61b65a05dc02032b9bcde03"], "user": "smolnar@mozilla.com"}, "45732": {"changesets": [{"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996221 - Support the Navigation API in javascript: URL documents. r=vhilla\n\nA javascript: navigation replaces the active session history entry,\nkeeping its navigation key and URL. The new document's Navigation\nentries are the previous document's with that entry replaced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338111\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/nsDocShell.cpp", "docshell/shistory/SessionHistoryEntry.cpp", "docshell/shistory/SessionHistoryEntry.h", "dom/navigation/Navigation.cpp", "testing/web-platform/meta/navigation-api/navigation-history-entry/entries-after-javascript-url-navigation.html.ini", "testing/web-platform/meta/navigation-api/navigation-history-entry/entries-in-new-javascript-url-iframe.html.ini", "testing/web-platform/tests/html/browsers/browsing-the-web/navigating-across-documents/javascript-url-nested-history.html", "testing/web-platform/tests/html/browsers/browsing-the-web/navigating-across-documents/resources/page-with-iframe.html", "testing/web-platform/tests/navigation-api/navigation-activation/activation-javascript-url.html", "testing/web-platform/tests/navigation-api/navigation-history-entry/entries-after-javascript-url-navigation-forward.html", "testing/web-platform/tests/navigation-api/navigation-history-entry/entries-after-traversing-to-javascript-url-entry.html", "testing/web-platform/tests/navigation-api/navigation-history-entry/entries-in-new-javascript-url-window.html"], "git_node": "9332ac41783dd33f8aa5c213ed757ef23e6e497a", "git_parents": ["fa1e90ea670c4234c61b65a05dc02032b9bcde03"], "node": "8d406f3202f06cb624820234b7b215be52b30419", "parents": ["ab3ff1cb2d0111f1bcbffd6433a02b858463163f"], "tags": []}, {"author": "Perf AI Bot \u003cperf-ai-bot@bmo.tld\u003e", "branch": "default", "desc": "Bug 2070888 - Inline the HTML tree builder's trivial scripting, srcdoc, quirks, and declarative-shadow-root configuration accessors. r=hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324935\n", "files": ["parser/html/javasrc/TreeBuilder.java", "parser/html/nsHtml5TreeBuilder.cpp", "parser/html/nsHtml5TreeBuilder.h"], "git_node": "76fa334f55814b1806d253f69dd549e40113778c", "git_parents": ["9332ac41783dd33f8aa5c213ed757ef23e6e497a"], "node": "edc927da4c65e42950f10ba535d7ace52612405f", "parents": ["8d406f3202f06cb624820234b7b215be52b30419"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086722 - Finalize the record on tab close in the BTP bfcache tests. r=bvandersloot\n\nThe 3s client bounce detection timer could fire before the history traversal\nunder chaos mode. Use a timer long enough to never fire and let closing the tab\nfinalize the record instead. Wait for the parent's STATE_STOP for B, since\nwithout the timer delay the tab could close before B's finalHost was set.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340023\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/test/browser/browser_bouncetracking_bfcache_finalhost.js", "toolkit/components/antitracking/bouncetrackingprotection/test/browser/browser_bouncetracking_bfcache_restore_redirect.js"], "git_node": "2460dd726fbef33ca8a8dc76facf88f8517400b1", "git_parents": ["76fa334f55814b1806d253f69dd549e40113778c"], "node": "facc8b31f9d4c8ba035ef1fda9d8a3fec65faaf5", "parents": ["edc927da4c65e42950f10ba535d7ace52612405f"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076890 - Release-assert that interrupt handlers don't run script in the current realm r=spidermonkey-reviewers,mgaudet\n\nSet a flag on the realm while an interrupt is being handled and release-assert\nin RunScript that it is not set for the current realm. Interrupt optimizations\nassume that interrupts do not modify arbitrary state in the realm. The shell's\ninterrupt function is allowed to run script, so it clears the flag while it\nruns.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339217\n", "files": ["js/src/jsfriendapi.cpp", "js/src/jsfriendapi.h", "js/src/shell/js.cpp", "js/src/vm/Interpreter.cpp", "js/src/vm/Realm.h", "js/src/vm/Runtime.cpp", "js/xpconnect/src/XPCShellImpl.cpp"], "git_node": "5bd03dd809029e6e4913b53d0829d601359f5eb1", "git_parents": ["2460dd726fbef33ca8a8dc76facf88f8517400b1"], "node": "13dd00b9c47a15fe8c97021cb725a51b1e64739c", "parents": ["facc8b31f9d4c8ba035ef1fda9d8a3fec65faaf5"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089569 - Silence cargo-audit warnings r=supply-chain-reviewers,nika\n\n`basic-toml`, `unsafe-libyaml`, and `pin-utils` have unmaintained\nwarnings.\n\n`tokio` has a soundness bug warning, however we don't use the affected\nAPI nor do we deploy the code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340010\n", "files": [".cargo/audit.toml"], "git_node": "94fa84ed6d891cf5dcb0f4b4c3f3e46d319c6fd3", "git_parents": ["5bd03dd809029e6e4913b53d0829d601359f5eb1"], "node": "de9ce3b6375e20d9147131af95febffe11bbcb2c", "parents": ["13dd00b9c47a15fe8c97021cb725a51b1e64739c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089480 - Stop the backward scan of IonScript::getSafepointIndex at the first entry (Coverity CID 1639158) r=iain\n\nWith an unsigned index and minEntry == 0, the `--guess \u003e= minEntry`\ncondition never became false, so a missing displacement read before the\ntable instead of reaching the MOZ_CRASH.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339854\n", "files": ["js/src/jit/Ion.cpp"], "git_node": "0aa6447d878d50a29368f555a1f7f2fa57c3196d", "git_parents": ["94fa84ed6d891cf5dcb0f4b4c3f3e46d319c6fd3"], "node": "7a07c2348a1a14e47bc3f0e6aef7d2f8eda9ba88", "parents": ["de9ce3b6375e20d9147131af95febffe11bbcb2c"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996168 - Use logical properties for spacing/positioning r=desktop-theme-reviewers,tabbrowser-reviewers,emilio,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337176\n", "files": ["browser/themes/shared/tabbrowser/content-area.css", "browser/themes/shared/tabbrowser/fullscreen-and-pointerlock.css"], "git_node": "04f0a323b95172c8a1b5acb23164782cbd53b25c", "git_parents": ["0aa6447d878d50a29368f555a1f7f2fa57c3196d"], "node": "164523b10799482eb07ba72bd4eee36a607d48de", "parents": ["7a07c2348a1a14e47bc3f0e6aef7d2f8eda9ba88"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086470 - Update metadata for html/semantics/interactive-elements/the-summary-element/interactive-content.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340036\n", "files": ["testing/web-platform/meta/html/semantics/interactive-elements/the-summary-element/interactive-content.html.ini"], "git_node": "c9a53467d3fe17fcbf0cb4d26afc7b3ad3510cb9", "git_parents": ["04f0a323b95172c8a1b5acb23164782cbd53b25c"], "node": "523d9fbf5e38b4ab933e5895de007c3d00bef569", "parents": ["164523b10799482eb07ba72bd4eee36a607d48de"], "tags": []}, {"author": "Tyler Etchart \u003ctetchart@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088877 - added pref to fix test issue r=vazish\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340049\n", "files": ["browser/components/aiwindow/models/tests/browser/browser_prompt_loader_chat_system_prompt.js"], "git_node": "f54628b51586614bb4c0064ba82596990cfedbce", "git_parents": ["c9a53467d3fe17fcbf0cb4d26afc7b3ad3510cb9"], "node": "3c51a6731d13681a957f4ef47dd5ffef05a25566", "parents": ["523d9fbf5e38b4ab933e5895de007c3d00bef569"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084876 - Run the zucchini page error handlers in functions that need no object unwinding. r=yjuglaret,application-update-reviewers\n\nzucchini is built with C++ exceptions enabled, and like MSVC, clang 23 rejects __try in any function that\nneeds object unwinding in that mode. The guarded code now runs in a lambda called from a helper that holds\nonly the __try, and the __except block logs through a separate function. The mapped output file is created\noutside the lambda, since unwinding from a structured exception does not run C++ destructors under /EHs and\nthe updater could not remove the draft file it keeps mapped. Windows updater tests inject an\nEXCEPTION_IN_PAGE_ERROR while the patch is read and while the new file is written, to check that both are\nrecovered from and that the draft file is released.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336968\n", "files": ["third_party/zucchini/moz_zucchini.cc", "third_party/zucchini/moz_zucchini.h", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniReadPageError_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniWritePageError_win.js", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "ac5bdf02a5580397cfc3e126048e3a4537547fc4", "git_parents": ["f54628b51586614bb4c0064ba82596990cfedbce"], "node": "bc51033d6650d067f3382cb8defecedac5a2a0e9", "parents": ["3c51a6731d13681a957f4ef47dd5ffef05a25566"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084876 - Build zucchini_integration.cc as part of the zucchini executable. r=yjuglaret\n\nOnly the zucchini executable uses zucchini::Apply. Outside of the library it builds without C++ exceptions, as\nupstream does, which keeps the __try in ApplyCommon valid with clang 23.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336969\n", "files": ["mozilla-config.h.in", "third_party/zucchini/README.md", "third_party/zucchini/executable/moz.build", "third_party/zucchini/moz.build"], "git_node": "d9bfb5b3fc1f8fe9e24815c6838d8c93f62936e0", "git_parents": ["ac5bdf02a5580397cfc3e126048e3a4537547fc4"], "node": "8fdd2dcd5de241ea3226f9cc05a6408a2a985a0a", "parents": ["bc51033d6650d067f3382cb8defecedac5a2a0e9"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064150 - Record the app's R8 mapping UUID in Gecko profiles on Android. r=mstange,geckoview-reviewers,profiler-reviewers,android-reviewers,jonalmeida\n\nAdds GeckoRuntimeSettings.Builder.proguardUuid, which Fenix and Focus set from\nBuildMetadata. The profiler writes it as meta.proguardUuid so that Java frames\ncan be matched with the build's R8 mapping. Unlike a stored crash, a profile\nalways comes from the running build, so the runtime's own UUID is the right one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332523\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/gecko/GeckoProvider.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/components/EngineProvider.kt", "mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoJavaSampler.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoRuntime.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoRuntimeSettings.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "tools/profiler/core/platform.cpp"], "git_node": "be0906c4f1745639c1f4e7ab9ae62d579ab4bf7b", "git_parents": ["d9bfb5b3fc1f8fe9e24815c6838d8c93f62936e0"], "node": "494899c1139c296b034e5f5730022fe020b2e4c1", "parents": ["8fdd2dcd5de241ea3226f9cc05a6408a2a985a0a"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064150 - Record line numbers for Java frames in Gecko profiles on Android. r=mstange,geckoview-reviewers,profiler-reviewers,jonalmeida\n\nR8 retrace needs line numbers to expand inlined frames and tell overloads apart.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332524\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoJavaSampler.java", "tools/profiler/core/platform.cpp"], "git_node": "9d5bc66c73f7ce85d57abe1bd60d47ec35845c68", "git_parents": ["be0906c4f1745639c1f4e7ab9ae62d579ab4bf7b"], "node": "524d7784a2084ddf08e038e03facf872a5fb5f7e", "parents": ["494899c1139c296b034e5f5730022fe020b2e4c1"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2088890 - Only check the eviction result when CacheStorageService::ClearOriginInternal evicts (Coverity CID 1594500) r=necko-reviewers,kershaw\n\nFor a private context with no global entry tables, rv was never\nassigned before the final NS_ENSURE_SUCCESS, so the function could\nreturn an arbitrary error code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339506\n", "files": ["netwerk/cache2/CacheStorageService.cpp"], "git_node": "758f5ada6e975fca57da2796bbdcd206f2cf01c6", "git_parents": ["9d5bc66c73f7ce85d57abe1bd60d47ec35845c68"], "node": "c6241e058e00703a40f4433a59f63db8dd60ba73", "parents": ["524d7784a2084ddf08e038e03facf872a5fb5f7e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2087787 - Avoid duplicate outer dependency handling for a given anchor. r=jwatt\n\nThis is the kind of dedup the original version of the patch was trying\nto do but at what I think is a better place (that also doesn't depend on\nrule placement), and without the correctness error that it introduced.\n\nThe WPT covers that correctness issue (passes both with and without the\npatch).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338722\n", "files": ["servo/components/style/invalidation/element/relative_selector.rs", "testing/web-platform/tests/css/selectors/invalidation/has-shared-argument-multiple-rules.html"], "git_node": "4dd4ea65d06e8c80b3a1ef70bd243371070a5c23", "git_parents": ["758f5ada6e975fca57da2796bbdcd206f2cf01c6"], "node": "948afa540966b6fc68ba0fe22549f76c03b4c5d5", "parents": ["c6241e058e00703a40f4433a59f63db8dd60ba73"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057158 - Fix startup on OpenBSD due to missing ANGLE symbols. r=gfx-reviewers,gaston,bradwerth\n\nPatch ANGLE to build system_utils_posix.cpp on BSD, avoiding missing\nsymbol errors preventing startup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339541\n", "files": ["gfx/angle/patches/0019-Build-system_utils_posix.cpp-on-BSD.patch", "third_party/angle/angle_common_gn/moz.build", "third_party/angle/angle_program_version_id_gn/ANGLEShaderProgramVersion.h-c5df9b35e76f7eab.rsp.in", "third_party/angle/angle_program_version_id_gn/ANGLEShaderProgramVersion.h-da9ca5d47e7c27c1.rsp.in", "third_party/angle/angle_program_version_id_gn/moz.build", "third_party/angle/src/libGLESv2.gni"], "git_node": "62d660b689d8caf5e5c487bf6f69d868ba3db557", "git_parents": ["4dd4ea65d06e8c80b3a1ef70bd243371070a5c23"], "node": "5c6c33f7d8e3785aade66fc0c7534737955dd4d8", "parents": ["948afa540966b6fc68ba0fe22549f76c03b4c5d5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089306 - Ship the nimbus-fml archive in the android-gradle-dependencies toolchain. r=android-build-system-reviewers,ahochheiden\n\nBuilds against nightly application-services download nimbus-fml.zip in assembleNimbusTools, so every Android\ntask depends on that download succeeding. The toolchain already rebuilds whenever ApplicationServices.kt\nchanges, so it now fetches the archive once and packages it, and automation points the Nimbus Gradle plugin's\ncache at it through the new NIMBUS_FML_CACHE_DIR. The toolchain's own mozconfig points it at the directory\nafter.sh packages.\n\nA cache miss under Gradle's --offline now fails assembleNimbusTools instead of downloading, so a task that\nshould have used the packaged archive cannot silently fall back to the network.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339791\n", "files": ["build/sparse-profiles/taskgraph", "mobile/android/config/mozconfigs/android-arm-gradle-dependencies/base", "mobile/android/config/mozconfigs/common", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusAssembleToolsTask.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusGradlePlugin.kt", "mobile/android/moz.configure", "taskcluster/kinds/source-test/python-android.yml", "taskcluster/kinds/toolchain/android.yml", "taskcluster/scripts/misc/android-gradle-dependencies.sh", "taskcluster/scripts/misc/android-gradle-dependencies/after.sh"], "git_node": "dc797cdb140d118d6d1d28c6806942ae450245a8", "git_parents": ["62d660b689d8caf5e5c487bf6f69d868ba3db557"], "node": "34ae1a20b85978e0c9531811df5526153c3c1787", "parents": ["5c6c33f7d8e3785aade66fc0c7534737955dd4d8"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1934809 - Add a pref to send only the Entra device credential, not the user's. r=necko-reviewers,jesup\n\nWindows and macOS SSO attach every credential the platform returns for a\nURL, which includes the signed-in user's token alongside the device proof.\nAdmins who sign in by hand with a separate account only want the device\nproof, so Conditional Access can see a trusted device without the OS user\nbeing signed in.\n\nWhen network.http.microsoft-entra-sso.device-only is set, Windows only sends\nx-ms-DeviceCredential and macOS drops prt_headers.\n\nnetwork.http.microsoft-entra-sso.device-only.N overrides it for a container,\nso a container used for a separate account can send only the device credential\nwhile the default container keeps full SSO. It only has an effect if SSO is\nalready enabled for that container. The same pref names are used on Windows\nand macOS on purpose.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333335\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/HttpWinUtils.cpp", "netwerk/protocol/http/HttpWinUtils.h", "netwerk/protocol/http/MicrosoftEntraSSOUtils.h", "netwerk/protocol/http/MicrosoftEntraSSOUtils.mm", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/unit/test_windows_sso.js"], "git_node": "3a65eb8815ac968bbf8deb87bce7a98dfff5978e", "git_parents": ["dc797cdb140d118d6d1d28c6806942ae450245a8"], "node": "869b6a92e4616c3c3ce756d8179214c4022e6734", "parents": ["34ae1a20b85978e0c9531811df5526153c3c1787"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089551 - Update PDF.js to 1c3fdc2597152