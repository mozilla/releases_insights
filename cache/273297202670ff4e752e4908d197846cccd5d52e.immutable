bc8d663be8de28f0214de6452e32b8"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049029 - Remove old \"More from Mozilla\" code. r=settings-reviewers,desktop-theme-reviewers,mkennedy,mstriemer\n\nThe Settings redesign is now locked on, leaving the legacy More from\nMozilla pane unused. Remove the unused implementation to avoid maintaining\ntwo versions of the pane.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332111\n", "files": ["browser/base/content/test/browser-static/browser_all_files_referenced.js", "browser/components/preferences/findInPage.js", "browser/components/preferences/jar.mn", "browser/components/preferences/moreFromMozilla.inc.xhtml", "browser/components/preferences/moreFromMozilla.js", "browser/components/preferences/preferences.js", "browser/components/preferences/preferences.xhtml", "browser/components/preferences/tests/moreFromMozilla/browser.toml", "browser/components/preferences/tests/moreFromMozilla/browser_moreFromMozilla.js", "browser/locales/en-US/browser/preferences/moreFromMozilla.ftl", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/preferences/mdn-logo.svg", "browser/themes/shared/preferences/monitor-logo.svg", "browser/themes/shared/preferences/preferences.css", "browser/themes/shared/preferences/relay-logo.svg", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "5ba6a496d5d88d64205deece0155632c8f80dea8", "git_parents": ["14f491342ab31bdab10daca66468f79cb2feacb2"], "node": "a148ca192545c4a5a417f9485921fef3f5fd0009", "parents": ["ecf077f9280bd28401919aef27dbacf22438402b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086055 - Part 1: Add a test-verify-path task that verifies every test under the paths requested on try, r=taskgraph-reviewers,releng-reviewers,ahal.\n\nIt is a separate task so that a push can still run test-verify on the tests it\nmodifies. Each chunk verifies as many tests as the harness verifies in one\nper-test task, without test-verify's 3-chunk limit. It is never scheduled\noutside of try, but it is in the set of tasks `mach try fuzzy` offers without\n`--full` (which would cap `--rebuild` to 3).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337146\n", "files": ["taskcluster/gecko_taskgraph/test/test_transforms_test.py", "taskcluster/gecko_taskgraph/transforms/test/chunk.py", "taskcluster/kinds/test/misc.yml", "taskcluster/test_configs/test-sets.yml", "testing/mozharness/mozharness/mozilla/testing/per_test_base.py", "testing/mozharness/mozharness/mozilla/testing/verify_tools.py", "testing/mozharness/scripts/desktop_unittest.py", "testing/mozharness/test/test_mozilla_per_test_base.py"], "git_node": "33d340f85e858f792777639a9f7cf9b34497ece5", "git_parents": ["5ba6a496d5d88d64205deece0155632c8f80dea8"], "node": "14c4f11bac40ab4e78369f0377b460615504c01c", "parents": ["a148ca192545c4a5a417f9485921fef3f5fd0009"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084831 - update response card to new layout r=jlewis,fluent-reviewers,bolsson\" for causing bc failures @browser_aitab_tool_ui.js.\n\nThis reverts commit 93f02ea44b459aa3314245dd2012d94d2023e0f0.\n", "files": ["browser/components/aiwindow/ui/components/aitab-tool-ui/aitab-tool-ui.css", "browser/components/aiwindow/ui/components/aitab-tool-ui/aitab-tool-ui.mjs", "browser/locales-preview/aiWindow.ftl"], "git_node": "fc7282b70b35dd34585b4b3eb481b337c9819d87", "git_parents": ["33d340f85e858f792777639a9f7cf9b34497ece5"], "node": "b547f130559edc205edd848b24e4ef37efaa3bac", "parents": ["14c4f11bac40ab4e78369f0377b460615504c01c"], "tags": []}], "date": 1794043511, "git_changesets": ["5440cda849295770a6a3d1237f7b966cc4e57a8c", "707f4262d803178e132d8556e8b95e800f882b46", "808fce9db946930285707d02241f1d146405733f", "33ec6e4fab5d0ff6fda80fdb5d64b53812860026", "00fe0eef4588a184a92d359703720d