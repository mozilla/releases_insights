n/pip_tools/piptools/scripts/sync.py", "third_party/python/pip_tools/piptools/subprocess_utils.py", "third_party/python/pip_tools/piptools/sync.py", "third_party/python/pip_tools/piptools/utils.py", "third_party/python/pip_tools/piptools/writer.py", "third_party/python/pyproject.toml", "third_party/python/pyproject_hooks/pyproject_hooks-1.2.0.dist-info/LICENSE", "third_party/python/pyproject_hooks/pyproject_hooks-1.2.0.dist-info/METADATA", "third_party/python/pyproject_hooks/pyproject_hooks-1.2.0.dist-info/RECORD", "third_party/python/pyproject_hooks/pyproject_hooks-1.2.0.dist-info/WHEEL", "third_party/python/pyproject_hooks/pyproject_hooks/__init__.py", "third_party/python/pyproject_hooks/pyproject_hooks/_impl.py", "third_party/python/pyproject_hooks/pyproject_hooks/_in_process/__init__.py", "third_party/python/pyproject_hooks/pyproject_hooks/_in_process/_in_process.py", "third_party/python/pyproject_hooks/pyproject_hooks/py.typed", "third_party/python/requirements.txt", "third_party/python/uv.lock", "third_party/python/uv.lock.hash"], "git_node": "490094a9185106900f66ea3877aa076e79e08546", "git_parents": ["2d820170df6f0dea6a7d062f81bd3709e6bdde5b"], "node": "06f1e7be6718d6ed0eff7e9f6dfad639f987e3a7", "parents": ["4ddef34b5e946c3d84d584437ac4b094b5bd5dc2"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2085640 - Don't let head CSS/JS loads block fetch(), like XHR. r=necko-reviewers,valentin,jesup\n\nLike for XHR, this also gives fetch() requests the urgency of Unblocked loads.\nService worker fetches for intercepted non-fetch() requests keep their class of service.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336556\n", "files": ["dom/fetch/FetchDriver.cpp", "testing/web-platform/meta/css/css-view-transitions/navigation/mismatched-snapshot-containing-block-size-skips.html.ini", "testing/web-platform/mozilla/tests/fetch/fetchpriority/fetchpriority-urgency.h2.html", "toolkit/components/extensions/test/mochitest/test_ext_webrequest_background_events.html", "toolkit/components/extensions/test/xpcshell/test_ext_csp_upgrade_requests.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_modifyHeaders.js", "tools/profiler/tests/browser/browser_test_marker_network_serviceworker_synthetized_response.js"], "git_node": "df183623acfb006faa9cb864691cf4be2b13e6fb", "git_parents": ["490094a9185106900f66ea3877aa076e79e08546"], "node": "883a62586747bbde31327d6c3e817fc7a0bd6fae", "parents": ["06f1e7be6718d6ed0eff7e9f6dfad639f987e3a7"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes ct-logs r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342317\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "994afb283624973e7c49514f69f458382f418a4e", "git_parents": ["df183623acfb006faa9cb864691cf4be2b13e6fb"], "node": "f80a7f1a2fe4a5c7836eeb45c94f79318f9ad68b", "parents": ["883a62586747bbde31327d6c3e817fc7a0bd6fae"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090413: Fix PDF struct tree crash for text inside invalid MathML markup. r=accessibility-platform-reviewers,morgan\n\n\u003cmtext\u003e is a MathML text integration point, so invalid markup like a nested \u003cmtext\u003e gets parsed as HTML content rather than MathML, and that HTML element never gets its own Accessible.\nTherefore, GetAccId's previous DOM-based check for the case that the parent is MathML returned the TextLeafAccessible's own id instead of its MathML container's id.\nThat id was never registered in the struct tree, since BuildStructSubtree maps such text leaves to their container and relies on GetAccId doing the same remap.\n\nGetAccId now checks the Accessibility tree parent instead of the DOM parent, which doesn't skip over intervening nodes that didn't get an Accessible.\nBuildStructSubtree's matching check also needed to be changed to check whether the immediate parent Accessible is itself MathML, rather than checking for any MathML ancestor, since an HTML element that does get its own Accessible (e.g. a link) can sit between a MathML container and its text without being MathML itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341684\n", "files": ["accessible/pdf/PdfStructTreeBuilder.cpp", "accessible/tests/browser/pdfOutput/browser_structTree.js"], "git_node": "41b5d249e2850c332c9fcf71c928fc50582d31d9", "git_parents": ["994afb283624973e7c49514f69f458382f418a4e"], "node": "01c62ffb66c35c14d463e5c21eb16829af160929", "parents": ["f80a7f1a2fe4a5c7836eeb45c94f79318f9ad68b"], "tags": []}, {"author": "Glenn Watson \u003cgit@intuitionlibrary.com\u003e", "branch": "default", "desc": "Bug 2090433 - Map border segment geometry into its task with the task's own stretch. r=gfx-reviewers,nical\n\nThe corner geometry was scaled by the nominal raster scale, but the task is\nsized by rounding the box at that scale and then stretched onto the box. When\nthe box isn't a whole number of texels (a power-of-2 scale under an animated\ntransform, or MAX_BORDER_RESOLUTION clamping), the arc's clip centre could fall\ninside the task, and the shader fills the strip beyond it solid, drawing lines\nthrough elliptical borders.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340774\n", "files": ["gfx/wr/webrender/src/border.rs", "gfx/wr/wrench/reftests/border/border-corner-raster-scale-mismatch.yaml", "gfx/wr/wrench/reftests/border/border-shape-inset.png", "gfx/wr/wrench/reftests/border/reftest.list"], "git_node": "7534aea0c376abc83362c17c907406ddfffb215b", "git_parents": ["41b5d249e2850c332c9fcf71c928fc50582d31d9"], "node": "78a0002970b0c49b458d1e0bac4bcc0d66587b28", "parents": ["01c62ffb66c35c14d463e5c21eb16829af160929"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083834 - UI updates for smart window settings and gated option for auto model - r=pdahiya,fluent-reviewers,settings-reviewers,hjones,flod,cdipersio\" for causing failures on browser_aiFeatures_smart_window_model_selection.\n\nThis reverts commit c7d1798877ceb4a0f59accbd81ffb53801cd39a7.\n", "files": ["browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/content/firstrun.js", "browser/components/aiwindow/ui/test/xpcshell/test_ChatModelChoice.js", "browser/components/preferences/config/aiFeatures.mjs", "browser/components/preferences/preferences.js", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window_model_selection.js", "browser/locales/en-US/browser/aiFeatures.ftl"], "git_node": "f925082090f38dfa41a46857c93654375b817f51", "git_parents": ["7534aea0c376abc83362c17c907406ddfffb215b"], "node": "b407b9817fd935b31720da76de68319d997d6de3", "parents": ["78a0002970b0c49b458d1e0bac4bcc0d66587b28"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2091058 - Removed privacy notice infobar for TOS. r=omc-reviewers,mimi,sachung\" for causing bc failures at browser/browser_asrouter_infobar.js\n\nThis reverts commit 9c843e615e867d629188f6dc5314c6eea1e99420.\n", "files": ["browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs"], "git_node": "c5a3f2434562b3b9e46573cdcc9ab642c379a330", "git_parents": ["f925082090f38dfa41a46857c93654375b817f51"], "node": "3ae4833a73faa6dfa9b480755029b267b8b34921", "parents": ["b407b9817fd935b31720da76de68319d997d6de3"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "defau