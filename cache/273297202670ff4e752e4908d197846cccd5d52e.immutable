53fd038f855eff97925d389fedba"], "user": "ffxbld@lando.moz.tools"}, "45798": {"changesets": [{"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Add gtests for parsing CSP url-hash-source expressions; r=tschuster\n\nTest that url-hash-source expressions are parsed and serialized like\nhash-source expressions, with the prefix and the algorithm in lowercase and\nthe hash in base64, that invalid ones are ignored, and that all of them are\nignored without the pref. The serialization matters beyond logging, as\npolicies are sent to other processes as strings and parsed again there.\n\nAlso shorten a policy with a url-hash-source one character at a time, like\nShorteningPolicies, so that the parser sees every truncated form of it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342266\n", "files": ["dom/security/test/gtest/TestCSPParser.cpp"], "git_node": "47c78484ab498c9d3a3dd9ad991ca5058fba2334", "git_parents": ["d7161e35da7704cff60e48ee86fb7747ffcc93c7"], "node": "d059ee1a1fddfb71f47c74815e0d987b0e3aed40", "parents": ["4211a1ce1da294805573e629e591118237a5e55b"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2073337 - Make the bookmarks and history sidebar panels respect browser.tabs.loadUILinkInTab r=mak,fxview-reviewers,sidebar-reviewers,kcochrane,places-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341736\n", "files": ["browser/components/places/PlacesUIUtils.sys.mjs", "browser/components/sidebar/sidebar-bookmarks.mjs", "browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/sidebar-page.mjs", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_places_sidebar.js"], "git_node": "ac0e0bbff7f73008db0c9a889cbe6a9f40bcffb0", "git_parents": ["47c78484ab498c9d3a3dd9ad991ca5058fba2334"], "node": "e017dc0b8b1af6979adee2e9acf5011b1c357c3a",