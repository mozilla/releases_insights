465b34548f2ad98c6ea019d7aed18", "git_parents": ["b2a1e260ea8a5d2062c77f699095f980798c904b"], "node": "453feff3a6537db986bde9e8129807ebd1b4d3da", "parents": ["690cc35fcb5c8cf9d2c65099f7df95d3b100f488"], "tags": []}, {"author": "Glenn Watson \u003cgit@intuitionlibrary.com\u003e", "branch": "default", "desc": "Bug 2092767 - Return empty sampling bounds from SWGL Texture::sample_bounds when the request does not intersect the texture. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343782\n", "files": ["gfx/wr/swgl/src/gl.cc"], "git_node": "10dd0bd18f23be34d107d29a64f9b2cbdc71fae3", "git_parents": ["80e634134f5465b34548f2ad98c6ea019d7aed18"], "node": "b403a0b7d77899bc50cb211be4473995bab2d32d", "parents": ["453feff3a6537db986bde9e8129807ebd1b4d3da"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087121 - Disable macOS 14.7 browsertime and mozperftest/raptor unit tests r=perftest-reviewers,taskgraph-reviewers,mozperftest-reviewers,aglavic,bhearsum\n\nfinal part of moving browsertime off of Intel macs. The full suite has\nbeen running on macOS 15 (apple silicon) since bug 2082532, so this\ndrops the test sets from macOS 14.x and cleans up leftover macOS 14\nreferences in the config files.\n\nAlso removes the 14.7 mozperftest and raptor unit tests.\n\nunity-webgl has no macOS 15 replacement yet (bug 2087634)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342714\n", "files": ["python/mozperftest/mozperftest/perfdocs/hardware.yml", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/browsertime/desktop.yml", "taskcluster/kinds/source-test/python.yml", "taskcluster/test_configs/test-platforms.yml", "testing/perfdocs/generated/performance-infrastructure.md", "testing/perfdocs/generated/raptor.md"], "git_node": "4bdf023e9787611a5a9faea66fed112393b8116a", "git_parents": ["10dd0bd18f23be34d107d29a64f9b2cbdc71fae3"], "node": "4d9a52fccf94b87a5bc6969ccd49584505e30cf5", "parents": ["b403a0b7d77899bc50cb211be4473995bab2d32d"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087121 - Remove macOS 14.7 exclusions from the perf try selector r=perftest-reviewers,aglavic\n\nNo perf tasks run on macosx1470 anymore, so the !1470 filters in the\nperf selector queries are dead. Drop them and update the tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342726\n", "files": ["tools/tryselect/selectors/perfselector/classification.py", "tools/tryselect/test/test_perf.py"], "git_node": "8a132389e0c20ee7e611dd7c10f31eaa8ed2918c", "git_parents": ["4bdf023e9787611a5a9faea66fed112393b8116a"], "node": "84fd0510effdfd784bcbe8d6e88a0ce0a75f9e3e", "parents": ["4d9a52fccf94b87a5bc6969ccd49584505e30cf5"], "tags": []}, {"author": "Glenn Watson \u003cgit@intuitionlibrary.com\u003e", "branch": "default", "desc": "Bug 2093770 - Reject AddPipelineIdForCompositable for any pipeline id already registered with the AsyncImagePipelineManager. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343784\n", "files": ["gfx/layers/wr/AsyncImagePipelineManager.h", "gfx/layers/wr/WebRenderBridgeParent.cpp"], "git_node": "ef965d77df412d24ebbafc340587b961e7b68f17", "git_parents": ["8a132389e0c20ee7e611dd7c10f31eaa8ed2918c"], "node": "0d347e89569bff7b37fcf8e824dab7085777839f", "parents": ["84fd0510effdfd784bcbe8d6e88a0ce0a75f9e3e"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069243 - Move Container Storage Layer into A-S - part 4 - ContextualIdentityService r=timhuang\" for causing failures at browser_UserContextManager.js.\n\nThis reverts commit 377a282046065a2251af8dcb76a93d3ef151a838.\n\nRevert \"Bug 2069243 - Move Container Storage Layer into A-S - part 3 - Add migration tests r=timhuang\"\n\nThis reverts commit 96b7a91d820a86c4c29fc6cb10c0cc2d0eecf60c.\n\nRevert \"Bug 2069243 - Move Container Storage Layer into A-S - part 2 - mach uniffi generate r=bdk\"\n\nThis reverts commit 4e556616af439923a2efd1e6daa2fc006262e194.\n\nRevert \"Bug 2069243 - Move Container Storage Layer into A-S - part 1 - Enable UniFFI-JS for fxcontainers on Android, r=bdk\"\n\nThis reverts commit 15570f1f5c902494a20b2ebb2097ea75f0530453.\n", "files": ["Cargo.lock", "docs/rust-components/developing-rust-components/uniffi.md", "dom/chrome-webidl/moz.build", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/components/contextualidentity/tests/unit/test_basic.js", "toolkit/components/contextualidentity/tests/unit/test_containersStore.js", "toolkit/components/contextualidentity/tests/unit/test_corruptedFile.js", "toolkit/components/contextualidentity/tests/unit/test_migratedFile.js", "toolkit/components/contextualidentity/tests/unit/test_siteAssociations.js", "toolkit/components/contextualidentity/tests/unit/xpcshell.toml", "toolkit/components/extensions/test/xpcshell/test_ext_contextual_identities.js", "toolkit/components/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/components/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/components/lib.rs", "toolkit/components/uniffi-bindgen-gecko-js/components/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/config.toml", "toolkit/components/uniffi-bindgen-gecko-js/src/lib.rs", "toolkit/components/uniffi-bindgen-gecko-js/src/pipeline/namespaces.rs", "toolkit/components/uniffi-bindgen-gecko-js/src/pipeline/nodes.rs", "toolkit/components/uniffi-bindgen-gecko-js/src/pipeline/root.rs", "toolkit/components/uniffi-bindgen-gecko-js/src/templates/cpp/FfiDefinitions.cpp", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs"], "git_node": "6b31a19cdf0dd4c9e4c26011d3aae9b8139624e7", "git_parents": ["ef965d77df412d24ebbafc340587b961e7b6