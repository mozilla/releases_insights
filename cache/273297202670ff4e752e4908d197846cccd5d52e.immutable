ff", "2a78e4dcf90dd92b60e034f6add62a3785cfe20f", "a5efebdf431c92d214e7a1671d38b9281b1c1b1f", "f4842943bf5d30eac05856d46c16c7f53caf841d", "d3663fe2dc270baeff213c2d09f7266726d0f689", "ef0976d45595a385961c1eb985e66943921c4be8", "8ce703ea23b09c3fbaa281cb28a1fff48c839511", "7beed9761e94bd469ebc3bfd6af1a5c8bcc723b8", "72d1731f888320dd7adb222fa68a37c2f80bd679", "d9bd6be9a67efb1c2667ef91a89856f35eb7cf5e"], "user": "imoraru@mozilla.com"}, "45733": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2039813 - Update builders to clang 23. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339392\n", "files": ["build/moz.configure/compile-checks.configure", "taskcluster/kinds/toolchain/clang-tidy.yml", "taskcluster/kinds/toolchain/clang.yml", "taskcluster/kinds/toolchain/llvm-symbolizer.yml", "taskcluster/kinds/toolchain/sysroot.yml", "tools/clang-tidy/config.yaml"], "git_node": "5a539f1eeedc65e380b04be3a798567840c7759a", "git_parents": ["d9bd6be9a67efb1c2667ef91a89856f35eb7cf5e"], "node": "cf77524a41f343a2369b96cb66031789e1831c5e", "parents": ["e3f5b185b198689444fa9c533726980c8ab8ce3d"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2053035 - Update builders to rustc 1.99. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339393\n", "files": ["build/build-rust/Zprofile.patch", "build/build-rust/rust-vendor-std.patch", "docs/writing-rust-code/update-policy.md", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/rust.yml", "taskcluster/scripts/misc/repack_rust.py"], "git_node": "c3394d4e35d3c415ea424ee44145228408c640b2", "git_parents": ["5a539f1eeedc65e380b04be3a798567840c7759a"], "node": "ccda191f91b8fec879e774d5ec23d8509b1c1f18", "parents": ["cf77524a41f343a2369b96cb66031789e1831c5e"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086233 - Tablet PDF tools can draw over tab strip bar when bottom toolbar is also enabled r=android-reviewers,pollymce\n\nWhen on a tablet, the tools anchor to the top. Usually the top is the awesomebar or nothing, but it is possible to have a bottom awesomebar and top tab strip.\n\nThis patch ensures tab strip is listed as a possible top item to anchor onto.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339636\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfOverlayBehavior.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfOverlayBehaviorTest.kt"], "git_node": "8fb29eb1d8d4617b966edaf945c856514a968140", "git_parents": ["c3394d4e35d3c415ea424ee44145228408c640b2"], "node": "e0316c2ee1604429708eb26870affbef154da2df", "parents": ["ccda191f91b8fec879e774d5ec23d8509b1c1f18"], "tags": []}, {"author": "George Matsumura \u003cgorg@gorgnet.net\u003e", "branch": "default", "desc": "Bug 2086914 - Replace -d16 flag with +d32 flag for compiling for ARMv7. r=glandium,firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337844\n", "files": ["build/moz.configure/rust.configure"], "git_node": "67a1039749c235af08b4288367ac0aa2ae8cfdd1", "git_parents": ["8fb29eb1d8d4617b966edaf945c856514a968140"], "node": "84abb27ae9b86a9785ab46f85ef7db3fbef31062", "parents": ["e0316c2ee1604429708eb26870affbef154da2df"], "tags": []}, {"author": "Gela \u003cgmalekpour@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085431 - Allow credit card CVV capture on Android without the desktop Rust storage pref r=geckoview-reviewers,credential-management-reviewers,dimi,tcampbell,mtigley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336426\n", "files": ["mobile/shared/modules/geckoview/test/xpcshell/test_FormAutofillCVVPrefs.js", "mobile/shared/modules/geckoview/test/xpcshell/xpcshell.toml", "modules/libpref/init/all.js", "toolkit/components/formautofill/FormAutofill.sys.mjs"], "git_node": "f49494a56ecb2a4f068e4148d80e6051970c3476", "git_parents": ["67a1039749c235af08b4288367ac0aa2ae8cfdd1"], "node": "1eb4aa698af3f6812e6857da9cebe96444f6e543", "parents": ["84abb27ae9b86a9785ab46f85ef7db3fbef31062"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089084 - Keep app link lookups with and without the app store fallback from sharing a cached result. r=android-reviewers,tthibaud\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339706\n", "files": ["mobile/android/android-components/components/feature/app-links/src/main/java/mozilla/components/feature/app/links/AppLinksUseCases.kt", "mobile/android/android-components/components/feature/app-links/src/test/java/mozilla/components/feature/app/links/AppLinksUseCasesTest.kt"], "git_node": "88c517164a3229bdc08866fe0c9df9ea5e925214", "git_parents": ["f49494a56ecb2a4f068e4148d80e6051970c3476"], "node": "477b1022ed1935f5c8f832f56cb153b38154cce5", "parents": ["1eb4aa698af3f6812e6857da9cebe96444f6e543"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1796283 - Correct the skip-if for browser_aaa_eventTelemetry_run_first.js to target macOS 15 aarch64 opt. a=test-only\n", "files": ["browser/components/aboutlogins/tests/browser/browser.toml"], "git_node": "b10a84a6b8849f7e887783f5a59e4ee11c46cec0", "git_parents": ["88c517164a3229bdc08866fe0c9df9ea5e925214"], "node": "1c5cded268eb80d21a4e7f27d494226654e9189b", "parents": ["477b1022ed1935f5c8f832f56cb153b38154cce5"], "tags": []}, {"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Bug 2069681 - Mark WebAuthn requests with intermediate cross-origin ancestors as cross-origin r=jschanck\n\nPreviously, requests would only be marked as cross-origin in the client data\nif the origin and top-level origin were different.  This missed intermediate\nancestors in a chain like `A -\u003e B -\u003e A`, and which would appear in the\nclient data as a same-origin request from `A`, ie:\n\n  crossOrigin: false, origin: A, topOrigin: unset\n\nThis change makes the client data for these requests correctly report\nthemselves as being a cross-origin request:\n\n  crossOrigin: true, origin: A, topOrigin: A\n\nThis change should still treat a chain of `A -\u003e A -\u003e A` as same-origin, and not\nrequire additional permissions.\n\nThis does not change the rules by which these requests may be made.  This\nonly changes how it is reported in the client data.\n\nA client data with `crossOrigin && origin == topOrigin` is a potentially\nconfusing state for an RP, as WebAuthn does not list all intermediate\norigins of a frame chain.  However, an RP can limit framing with a CSP.\n\nWhile we're here, verify `MakeCredential` response client data, and verify\n`GetAssertion` response client data a little more closely.\n\n`test_cross_origin_iframe_nested_cross_origin_allow` fails without the\nchanges to `WebAuthnTransactionParent.cpp`, and passes with it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334404\n", "files": ["dom/webauthn/WebAuthnTransactionParent.cpp", "dom/webauthn/tests/test_webauthn_crossorigin_featurepolicy.html"], "git_node": "bf0ecbb864426d6b9f4df6ba868b680bfab2977f", "git_parents": ["b10a84a6b8849f7e887783f5a59e4ee11c46cec0"], "node": "52490e86dae3c641b27483e73e80fda86eae35a9", "parents": ["1c5cded268eb80d21a4e7f27d494226654e9189b"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088664 - Part 1: Use 50 as the auto cue position for start and end alignment. r=media-playback-reviewers,padenot\n\nThe WebVTT spec defines the auto cue position from the cue text alignment\nalone: 0 for left, 100 for right, and 50 for everything else [1]. We used the\ncomputed position alignment instead, so start and end alignment moved the cue\nbox to the edge of the video.\n\nWith the auto position of 50, an align:start cue box covers the right half of\nthe video, as the spec says. The reference of bidi/start_alignment.html\ncovered the whole width, so it now starts at 50%, as in the upstream\nfix [2], and the reftest passes.\n\n[1] https://w3c.github.io/webvtt/#cue-computed-position\n[2] https://github.com/web-platform-tests/wpt/pull/64078\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339733\n", "files": ["dom/media/webvtt/TextTrackCue.cpp", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/start_alignment-ref.html"], "git_node": "c2a5c5c8b5810a14541b7b8e3d21d721fd2537bf", "git_parents": ["bf0ecbb864426d6b9f4df6ba868b680bfab2977f"], "node": "5d457bde3ee87a39cb48ba357a179de68b906f38", "parents": ["52490e86dae3c641b27483e73e80fda86eae35a9"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088664 - Part 2: Test the auto cue position for start and end alignment. r=media-playback-reviewers,padenot\n\nCheck the computed position of every cue with an auto position. The spec gives\nan auto position of 50 for start and end alignment, and 0 or 100 only for left\nand right alignment [1].\n\n[1] https://w3c.github.io/webvtt/#cue-computed-position\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339734\n", "files": ["dom/media/webvtt/test/mochitest/test_webvtt_positionalign.html"], "git_node": "28b1c11820b07c9e44704d9d97a0e5ea1fce2f03", "git_parents": ["c2a5c5c8b5810a14541b7b8e3d21d721fd2537bf"], "node": "7c751cfd84ad670dc4a3c5858cc78277c44bb778", "parents": ["5d457bde3ee87a39cb48ba357a179de68b906f38"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-skr/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/feature/contextmenu/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/readerview/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/sitepermissions/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-fa/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-iw/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-nb-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/focus-android/app/src/main/res/values-fy-rNL/strings.xml"], "git_node": "12b116f1d2b3155fc21222c05f7c57f5f2b9bdf8", "git_parents": ["28b1c11820b07c9e44704d9d97a0e5ea1fce2f03"], "node": "c080fe6b59e0daced3fbcee7417ed525da8135cc", "parents": ["7c751cfd84ad670dc4a3c5858cc78277c44bb778"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2087963 - Refactor TextureData ownership in TextureClient and TextureChild using UniquePtr r=gfx-reviewers,bradwerth\n\nUse UniquePtr\u003cTextureData\u003e to make TextureData ownership explicit in TextureClient, TextureChild, and TextureDeallocParams.\n\nTransfer ownership using move semantics while preserving the existing deallocation behavior and IPC lifecycle. Add release assertions to detect unexpected ownership retention during destruction.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338651\n", "files": ["gfx/layers/client/TextureClient.cpp", "gfx/layers/client/TextureClient.h"], "git_node": "ba9494553a3c5ed89d143909f4038e1689318e49", "git_parents": ["12b116f1d2b3155fc21222c05f7c57f5f2b9bdf8"], "node": "c510ed8f79348107089a964ae98411ec929518b6", "parents": ["c080fe6b59e0daced3fbcee7417ed525da8135cc"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089043 - Don't swizzle single-plane dmabuf surfaces. r=gfx-reviewers,ahale\n\nThe surface format of single-plane DMABuf surfaces is currently an unreliable\nway to determine whether to do a BGRA swizzle. For now, avoid doing a swizzle\non such surfaces.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340202\n", "files": ["gfx/gl/GLBlitHelper.cpp"], "git_node": "8be23b6b3f898b933f10f03294a600de382d2a5e", "git_parents": ["ba9494553a3c5ed89d143909f4038e1689318e49"], "node": "12d0651f11be3802837225e1b780a5df2afc44da", "parents": ["c510ed8f79348107089a964ae98411ec929518b6"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2087958 - Part 1: Add the Wrexham widget state to the AppStore r=android-reviewers,skhan\n\n- Add SportsWidgetState with the feature flag, visibility, match cards, error state and debug tool visibility\n- Add SportsWidgetAction and SportsWidgetReducer to update the state\n- Initialize the state from the Wrexham widget secret setting and homepage setting\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339756\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppStoreReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/sports/SportsWidgetReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/sports/SportsWidgetState.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/appstate/sports/SportsWidgetReducerTest.kt"], "git_node": "73af9212dca586f9516bd9f80b64ddc513da66bc", "git_parents": ["8be23b6b3f898b933f10f03294a600de382d2a5e"], "node": "b7cfe0a5d4a9001a7b4faca964592eeda51e6c16", "parents": ["12d0651f11be3802837225e1b780a5df2afc44da"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2087958 - Part 2: Update the Wrexham widget state when its settings change r=android-reviewers,skhan\n\n- Dispatch the state changes when the homepage setting or the secret setting is toggled\n- Add tests for the homepage setting dispatch\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339757\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/HomeSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/HomeSettingsFragmentTest.kt"], "git_node": "301006d6d93d233fac6bdb911e1e83bc733e7e6b", "git_parents": ["73af9212dca586f9516bd9f80b64ddc513da66bc"], "node": "2d67898daf79e443c38a946133f7662de942124b", "parents": ["b7cfe0a5d4a9001a7b4faca964592eeda51e6c16"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2087958 - Part 3: Show the Wrexham widget on the homepage r=android-reviewers,skhan\n\n- Add the SportsWidget with the SportsWidgetHeader above a SportsCardPager of match cards\n- Collapse the pager to a single error card when there is an error and no live match\n- Open the pager on the live or suspended match, else the next scheduled or delayed match, else the most recent finished match\n- Show the widget below the privacy report card when it is enabled, visible and has data to display\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339759\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/ui/SportsWidget.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/store/HomepageState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Homepage.kt", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/sports/ui/SportsWidgetPagesTest.kt"], "git_node": "d1a795f7a84873ebf31cb0f68a6bc428a4e8b42e", "git_parents": ["301006d6d93d233fac6bdb911e1e83bc733e7e6b"], "node": "c881f63727675431add870be91f0d065581da4a8", "parents": ["2d67898daf79e443c38a946133f7662de942124b"], "tags": []}, {"author": "Gela \u003cgmalekpour@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089057 - Save and autofill the credit card security code (CVV) on Android r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340208\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/autofill/GeckoAutocompleteStorageDelegate.kt", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/ext/CreditCard.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/ext/CreditCardTest.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/prompt/GeckoPromptDelegateTest.kt", "mobile/android/android-components/components/concept/engine/src/test/java/mozilla/components/concept/engine/prompt/PromptRequestTest.kt", "mobile/android/android-components/components/concept/storage/src/main/java/mozilla/components/concept/storage/CreditCardsAddressesStorage.kt", "mobile/android/android-components/components/concept/storage/src/test/java/mozilla/components/concept/storage/CreditCardEntryTest.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/PromptFeatureTest.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/creditcard/CreditCardItemViewHolderTest.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/creditcard/CreditCardPickerTest.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/creditcard/CreditCardSaveDialogFragmentTest.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/creditcard/CreditCardSelectBarTest.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/creditcard/CreditCardsAdapterTest.kt", "mobile/android/android-components/components/service/sync-autofill/src/main/java/mozilla/components/service/sync/autofill/GeckoCreditCardsAddressesStorageDelegate.kt", "mobile/android/android-components/components/service/sync-autofill/src/test/java/mozilla/components/service/sync/autofill/AutofillCreditCardsAddressesStorageTest.kt", "mobile/android/android-components/components/service/sync-autofill/src/test/java/mozilla/components/service/sync/autofill/DefaultCreditCardValidationDelegateTest.kt", "mobile/android/android-components/components/service/sync-autofill/src/test/java/mozilla/components/service/sync/autofill/GeckoCreditCardsAddressesStorageDelegateTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/addresses/FakeCreditCardsAddressesStorage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/creditcards/ui/CreditCardEditorMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/autofill/ui/AutofillSettingsReducerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/creditcards/CreditCardItemViewHolderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/creditcards/CreditCardsAdapterTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/creditcards/DefaultCreditCardsManagementControllerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/creditcards/ui/CreditCardEditorStoreTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/creditcards/ui/FakeCreditCardsStorage.kt"], "git_node": "deae065ce90dabb04782aa6b26889a27612ac145", "git_parents": ["d1a795f7a84873ebf31cb0f68a6bc428a4e8b42e"], "node": "4e43a5324fb2a915cc8ec1275c39dec8896f0dd0", "parents": ["c881f63727675431add870be91f0d065581da4a8"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087868 - Add the missing subtest expectation to reentrancy-on-serialize.html.ini. r=aryx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340125\n", "files": ["testing/web-platform/meta/navigation-api/updateCurrentEntry-method/reentrancy-on-serialize.html.ini"], "git_node": "d823d63f349b1b294899a6410d03a74ebef6a39f", "git_parents": ["deae065ce90dabb04782aa6b26889a27612ac145"], "node": "61e459f3b0d5bb8786743cbe825d929192c4cd4f", "parents": ["4e43a5324fb2a915cc8ec1275c39dec8896f0dd0"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088688 - Use ValidateFontDescriptor in WebRenderBridgeParent. r=gfx-reviewers,ahale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340224\n", "files": ["gfx/2d/ScaledFontFontconfig.cpp", "gfx/2d/UnscaledFontFreeType.h", "gfx/layers/wr/WebRenderBridgeParent.cpp"], "git_node": "f006bca5294300be6446fd85c7a8fd290e509375", "git_parents": ["d823d63f349b1b294899a6410d03a74ebef6a39f"], "node": "dbf20fa6bdbea634d2b00a36e394afed279a8fda", "parents": ["61e459f3b0d5bb8786743cbe825d929192c4cd4f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085860 - Check the mfbt includes with `diskarzhan.lint_headers` r=linter-reviewers,sergesanspaille,sylvestre\n\n`check_mfbt_headers` searched each file once per header in\n`mfbt/api.yml`, then once per identifier of each included header.\n`lint_headers` finds the includes of a file in one scan, returns early\nwhen none is an mfbt header, and checks each one against a single set of\nthe words of the file. A word in another `mozilla/` include path, such as\n`Range` in `mozilla/dom/Range.h`, no longer counts as a use. A whole tree\n`mach lint -l includes` on Windows went from 8.2 to 6.2 seconds, with the\nsame results on the tree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337770\n", "files": ["tools/lint/includes/__init__.py", "tools/lint/test/files/includes/incorrect_assert_with_maybe.h", "tools/lint/test/files/includes/incorrect_range_other_include.h", "tools/lint/test/test_includes.py"], "git_node": "d7df08cc48e4cd4fa8d2783ee1c02fd8ac750492", "git_parents": ["f006bca5294300be6446fd85c7a8fd290e509375"], "node": "b66c4b9b63e2f272065b6a1ac8fca6bdd3536b3a", "parents": ["dbf20fa6bdbea634d2b00a36e394afed279a8fda"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083545 - Trim paths in Cargo host builds so Rust caches hit across checkouts r=firefox-build-system-reviewers,glandium\n\n`Cargo.toml` cannot set `trim-paths` while Cargo 1.95 is supported, so\nconfigure exports it for `build-override` when Cargo is 1.102 or newer.\nSome 1.101 nightlies predate the stabilization of `trim-paths`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336923\n", "files": ["build/moz.configure/rust.configure", "python/mozbuild/mozbuild/rust_commands.py"], "git_node": "19aaf1cc973e907e44e52af57e72e4c85b6000b4", "git_parents": ["d7df08cc48e4cd4fa8d2783ee1c02fd8ac750492"], "node": "40d0663fcf3f6480f5ec765a59560338bcb49b4f", "parents": ["b66c4b9b63e2f272065b6a1ac8fca6bdd3536b3a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084224 - Print the watchman command that matches the shell on Windows r=sylvestre\n\n`more` reads a file in both cmd and PowerShell, so one line replaces the\n`cmd /d /c` wrapper. cmd's `more` reads a forward slash as a switch prefix,\nso it needs to print the native path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336267\n", "files": ["tools/tryselect/docs/tasks.md", "tools/tryselect/tasks.py", "tools/tryselect/test/test_tasks.py"], "git_node": "d0e25834830a3bc982cec35a8dc0820f0cd2dede", "git_parents": ["19aaf1cc973e907e44e52af57e72e4c85b6000b4"], "node": "d7f5c267c4cea5625e8e3d097b2c7184300d14c9", "parents": ["40d0663fcf3f6480f5ec765a59560338bcb49b4f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088762 - Part 1 - Make mach wpt-metadata-merge work with Python 3 r=jgraham\n\n`Differences` defined `__nonzero__`, which Python 3 ignores, so tests\ndeleted from the current metadata came back whenever the new metadata\nleft them unchanged. `test_metamerge.py` would have caught this, but it\nhas never run in CI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339402\n", "files": ["testing/web-platform/metamerge.py"], "git_node": "cdb7923e5ca981c4ba4f82beb8291c0a0a5331d6", "git_parents": ["d0e25834830a3bc982cec35a8dc0820f0cd2dede"], "node": "eb4ba842365060d25e57a77ca43b0553df77e36e", "parents": ["d7f5c267c4cea5625e8e3d097b2c7184300d14c9"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088762 - Part 2 - Run the wpt python unit tests without a build r=taskgraph-reviewers,jcristau\n\nThe wpt Python unit tests were registered in\n`testing/web-platform/moz.build`, which is only read when a build\nenables tests. The `source-test` tasks run `mach python-test` without a\nbuild, so these tests never ran. `testing/moz.build` is always read, so\nthey are registered there now. The mozbase tasks also run when the\nPython files in `testing/web-platform` change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339403\n", "files": ["taskcluster/kinds/source-test/python.yml", "testing/moz.build", "testing/web-platform/moz.build"], "git_node": "9527531600de07124a8049d9d2f5d17023373fc7", "git_parents": ["cdb7923e5ca981c4ba4f82beb8291c0a0a5331d6"], "node": "53fe831c07292d9ba82c572fc179eed3afefced1", "parents": ["eb4ba842365060d25e57a77ca43b0553df77e36e"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2088688 - Use ValidateFontDescriptor in WebRenderBridgeParent. r=gfx-reviewers,ahale\" for causing leak sanitizer failures\n\nThis reverts commit f006bca5294300be6446fd85c7a8fd290e509375.\n", "files": ["gfx/2d/ScaledFontFontconfig.cpp", "gfx/2d/UnscaledFontFreeType.h", "gfx/layers/wr/WebRenderBridgeParent.cpp"], "git_node": "0170d60b04c21138366fdf4089a92130de68b718", "git_parents": ["9527531600de07124a8049d9d2f5d17023373fc7"], "node": "745e67344c265d2e7aa27cb0d00c3d01a1f48010", "parents": ["53fe831c07292d9ba82c572fc179eed3afefced1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039813 - Keep the versioned LLVM dylibs in the macOS clang-tidy package. r=bustage\n", "files": ["build/build-clang/build-clang.py"], "git_node": "cd9d5f93df9e358ae5df5034bbaa9166c05a5330", "git_parents": ["0170d60b04c21138366fdf4089a92130de68b718"], "node": "1591c559e47bf7d799aa45e8658d713c97b2b46f", "parents": ["745e67344c265d2e7aa27cb0d00c3d01a1f48010"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2088762 - Part 2 - Run the wpt python unit tests without a build r=taskgraph-reviewers,jcristau\" for causing SM failures @ testing/web-platform/python.toml\n\nThis reverts commit 9527531600de07124a8049d9d2f5d17023373fc7.\n\nRevert \"Bug 2088762 - Part 1 - Make mach wpt-metadata-merge work with Python 3 r=jgraham\"\n\nThis reverts commit cdb7923e5ca981c4ba4f82beb8291c0a0a5331d6.\n", "files": ["taskcluster/kinds/source-test/python.yml", "testing/moz.build", "testing/web-platform/metamerge.py", "testing/web-platform/moz.build"], "git_node": "2abcc74250efca93f13b08d0f616e275edfc3fcd", "git_parents": ["cd9d5f93df9e358ae5df5034bbaa9166c05a5330"], "node": "3b94b6cc3d089596e1ffe71f010ef593134da5fa", "parents": ["1591c559e47bf7d799aa45e8658d713c97b2b46f"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2087822. Apply timeline-scope on a pseudo-element to the pseudo-element itself. r=layout-scroll-driven-animation-reviewers,firefox-style-system-reviewers,boris\n\nA `timeline-scope` on ::before or ::after was either ignored, because generated\ncontent only goes through animation processing when its style specifies\nanimations or timelines or its originating element already has animation data,\nor, when it was processed, recorded against the originating element, where it\nlimited the names across that element's whole subtree and overwrote the scope\nthe originating element declared itself. The spec applies the property to the\npseudo-element, which has no descendants beyond its own generated content.\n\nMake Servo_ComputedValues_NeedsAnimationTraversal() also report\n`timeline-scope`, so that the scope is registered when the pseudo-element is\ncreated rather than only once it animates, and, since ElementAnimationData\nalready keeps data per pseudo, store and look the scope up with the pseudo\nrequest and walk the lookup from the pseudo-element rather than its originating\nelement.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340077\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/style/GeckoBindings.cpp", "layout/style/TimelineManager.cpp", "layout/style/TimelineManager.h", "layout/style/nsAnimationManager.cpp", "servo/ports/geckolib/glue.rs", "testing/web-platform/tests/scroll-animations/css/timeline-scope-on-pseudo.html"], "git_node": "64698ae1e7b3467c839e1d36672bfd20221961c8", "git_parents": ["2abcc74250efca93f13b08d0f616e275edfc3fcd"], "node": "68c258d2b040b26522cd02336656652e4b523524", "parents": ["3b94b6cc3d089596e1ffe71f010ef593134da5fa"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2080132 - Part 1: Limit the encoding header length. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335039\n", "files": ["js/loader/LoadedScript.cpp"], "git_node": "a796852485ce972e11d659e568b7dbfe536be3f4", "git_parents": ["64698ae1e7b3467c839e1d36672bfd20221961c8"], "node": "2c73d50c0968f85417666cbf67d53ff10c3f060c", "parents": ["68c258d2b040b26522cd02336656652e4b523524"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2080132 - Part 2: Do not decode serialized stencil if the request is cancelled. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335040\n", "files": ["dom/script/ScriptLoadHandler.cpp"], "git_node": "f6cb5e54c6651ed0d58c5afa13e50587eb04abd2", "git_parents": ["a796852485ce972e11d659e568b7dbfe536be3f4"], "node": "d2de3cef1128bc64b3b441796ae1f7bea83ee217", "parents": ["2c73d50c0968f85417666cbf67d53ff10c3f060c"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2080132 - Part 3: Discard truncated serialized stencil. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335041\n", "files": ["dom/script/ScriptLoadHandler.cpp"], "git_node": "c4e7275af3e0198089c966ad8034573d71ec6ba2", "git_parents": ["f6cb5e54c6651ed0d58c5afa13e50587eb04abd2"], "node": "48190ce92d111ee63b7f85db388c51b3ce924988", "parents": ["d2de3cef1128bc64b3b441796ae1f7bea83ee217"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2084491 - Don't resolve GeckoResult twice. r=geckoview-reviewers,ohall\n\nAccording to the crash report, `GeckoResult.complete` is called twice.\nThis might be Android's framework calls `onActionItemClicked` after\n`onDestroyActionMode` is called\n\nSo we should not resolve the result twice.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336977\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/geckoview/BasicSelectionActionDelegate.java"], "git_node": "642786f3d7fe48f91ffd0b02586d657401005557", "git_parents": ["c4e7275af3e0198089c966ad8034573d71ec6ba2"], "node": "6bed683833c1cb4ba81982ff6ae72485f873cf22", "parents": ["48190ce92d111ee63b7f85db388c51b3ce924988"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088936 - Fix the sourceWindowId type and the sourceClosedId description in ClosedTabStateData. r=sfoster,sessionstore-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339532\n", "files": ["browser/components/sessionstore/RecentlyClosedTabsAndWindowsMenuUtils.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/TabState.sys.mjs"], "git_node": "26d7dcaa287146d86b0b2870617b622fbe937c2e", "git_parents": ["642786f3d7fe48f91ffd0b02586d657401005557"], "node": "e845859356ed649f55e122c7c860df229569c8c3", "parents": ["6bed683833c1cb4ba81982ff6ae72485f873cf22"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089888 - Stop holding ca-certificates at a fixed version in the Ubuntu 22.04 images. r=glandium\n\nThe 22.04 images are not built from a snapshot, so they already get a current ca-certificates from\njammy-updates, and holding the older package broke installing ca-certificates-java, which depends on the newer\none.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340222\n", "files": ["taskcluster/docker/debian-raw/Dockerfile"], "git_node": "e7044269f40a257128d79e03ee96bd7d4f66fb76", "git_parents": ["26d7dcaa287146d86b0b2870617b622fbe937c2e"], "node": "d27a3a75efd275ab25f0da5e6a3d60d6f2495fe9", "parents": ["e845859356ed649f55e122c7c860df229569c8c3"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2083589. Only copy the MSIX DLLs to the mochitest utility path once. r=ahal\n\nhttps://searchfox.org/firefox-main/rev/c0ad8e7c1d3d33cf3405f7019994471ac8baf4e7/testing/mochitest/runtests.py#2424\n\nWhen testing an MSIX install we copy every DLL from the install directory\ninto tests/bin so certutil can use them. fillCertificateDB runs for every\nmanifest, so we overwrite the same copies over and over, and intermittently\nthis fails because one of them is still locked:\n\n    PermissionError: [Errno 13] Permission denied: 'C:\\Users\\task_179218580166259\\build\\tests\\bin\\xul.dll'\n\nIt's not clear what holds the lock, but the DLLs don't change during a run,\nso there is no reason to copy them more than once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335056\n", "files": ["testing/mochitest/runtests.py"], "git_node": "bc6692d2a3a858b655fe67de0069009adb424539", "git_parents": ["e7044269f40a257128d79e03ee96bd7d4f66fb76"], "node": "0b76739039569e1983daa119b5ba19a179a192b9", "parents": ["d27a3a75efd275ab25f0da5e6a3d60d6f2495fe9"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2089757. Use the scrolled frame of a positioned listbox select as the abspos containing block when inserting content. r=layout-reviewers,jwatt\n\nhttps://searchfox.org/firefox-main/rev/935e9f7e39fcb9d738d3ac064905dcf4cc0c9cfc/layout/base/nsCSSFrameConstructor.cpp#5364\n\nGetAbsoluteContainingBlock redirects scroll containers to their scrolled frame,\nbut it checks IsScrollContainerFrame, which is false for nsListControlFrame. So\nfor an abspos element inserted into a positioned listbox select we skip the\nselect and use the document element's containing block. Initial frame\nconstruction makes the scrolled frame the containing block, so the result\ndepended on whether the element was there from the start.\n\nSince bug 2056610 we render arbitrary content in listboxes, so this is\nreachable. With a fixed pos select, the abspos element's saved clip chain is\nrelative to the root scroll frame while its placeholder is inside the select,\nand building its display items asserts in CreateClipChainIntersection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340227\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "testing/web-platform/tests/html/semantics/forms/the-select-element/select-listbox-abspos-child-dynamic-insertion-ref.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/select-listbox-abspos-child-dynamic-insertion.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/select-listbox-fixed-abspos-child-dynamic-insertion-crash.html"], "git_node": "9c2d7565bffe88a9ac30246fc48e18e48ec325fd", "git_parents": ["bc6692d2a3a858b655fe67de0069009adb424539"], "node": "992daa580ee6aa7e987ade0254cfa18761c10403", "parents": ["0b76739039569e1983daa119b5ba19a179a192b9"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089874 - Establish a consistent sign convention for the delta parameters of sendNativeTouchpadPan. r=hiro\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340214\n", "files": ["dom/interfaces/base/nsIDOMWindowUtils.idl", "gfx/layers/apz/test/mochitest/apz_test_native_event_utils.js", "widget/gtk/nsWindow.cpp"], "git_node": "f0eca31ba01d4df06bc200e3d11e25b38533c87d", "git_parents": ["9c2d7565bffe88a9ac30246fc48e18e48ec325fd"], "node": "9af52b7788801d3af27f06d7891696ab390097f5", "parents": ["992daa580ee6aa7e987ade0254cfa18761c10403"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089874 - Introduce a DefaultNativePanHandler and use it on all platforms other than Mac. r=hiro\n\nIt cannot currently be used on Mac because Mac uses a different\nfunction to send the event (sendNativeMouseScrollEvent rather\nthan sendNativeTouchpadPan).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340228\n", "files": ["gfx/layers/apz/test/mochitest/apz_test_native_event_utils.js"], "git_node": "0eec3f7889dff9f203316a9734189a811e4b7cbf", "git_parents": ["f0eca31ba01d4df06bc200e3d11e25b38533c87d"], "node": "bd1def3adb099eb3c9f308269232e6216610f4c8", "parents": ["9af52b7788801d3af27f06d7891696ab390097f5"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2089913 - Use a pin instead of a hold mark.\n\nThe hold mark doesn't properly handle the case where there's an even\nnewer version of the package.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340258\n", "files": ["taskcluster/docker/debian-raw/Dockerfile"], "git_node": "1208b78e731a206a0b19fef7e9a4bb4e7f579e6f", "git_parents": ["0eec3f7889dff9f2033