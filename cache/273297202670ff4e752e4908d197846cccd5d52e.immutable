/components/aiwindow/ui/modules/AITabUtils.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowTabStatesManager.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowToolbarButtons.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/AgentCommands.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/ChatMarkdownParser.mjs", "browser/components/aiwindow/ui/modules/ClientErrorTelemetry.mjs", "browser/components/aiwindow/ui/modules/ModelIcons.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillConstants.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillSources.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillTelemetry.sys.mjs", "browser/components/aiwindow/ui/modules/TrustedInternalURLs.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_interaction.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_model.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button_panel.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_telemetry.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/aiwindow/ui/test/browser/head_aiwindow_group_tabs_button.js", "browser/components/aiwindow/ui/test/browser/head_monitor_suggest.js", "browser/components/aiwindow/ui/test/xpcshell/test_A2UI.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_open_organize_tabs_panel.js"], "git_node": "615217b20e60e956769e7876514f920c339e9a76", "git_parents": ["5dc300a265ef272227761c0c8a8e9abf147d427c"], "node": "d14c370a5ab960841b56b4d164ba963360981313", "parents": ["1ba84e30630659ac5a19c6c1a3912c76627a510e"], "tags": []}], "date": 1795079789, "git_changesets": ["615217b20e60e956769e7876514f920c339e9a76"], "user": "smolnar@mozilla.com"}, "45832": {"changesets": [{"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Remove the string argument of CSP allows(); r=tschuster\n\nAfter allowsByNonce() and allowsByHash(), allows() is only called for keywords,\nwith an empty string. Remove that argument.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342816\n", "files": ["dom/security/OffThreadCSPContext.cpp", "dom/security/nsCSPContext.cpp", "dom/security/nsCSPUtils.cpp", "dom/security/nsCSPUtils.h"], "git_node": "a2f09ce7cf9183780c7f9c6af2872124e0ea6753", "git_parents": ["5dc300a265ef272227761c0c8a8e9abf147d427c"], "node": "0401a44708a5ff635c0e30c06f6c36d2b355c815", "parents": ["1ba84e30630659ac5a19c6c1a3912c76627a510e"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093910 - [devtools] Exclude frames from chrome://remote/content/marionette/ in devtools dump-scopes r=devtools-reviewers,nchevobbe\n\nSince Bug 2077159, on ccov test functions are nested in another function which changes the stack we record during this test.\nThose are harness frames, so skipping them sounds fair.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344092\n", "files": ["devtools/shared/test-helpers/dump-scope.sys.mjs"], "git_node": "37964b715ef6d7181cbb1c13550041854d2b469f", "git_parents": ["a2f09ce7cf9183780c7f9c6af2872124e0ea6753"], "node": "f7f695405b2da57bc07540fcae212814fc0f707f", "parents": ["0401a44708a5ff635c0e30c06f6c36d2b355c815"], "tags": []}, {"author": "Claude \u003cnoreply@anthropic.com\u003e", "branch": "default", "desc": "Bug 2094798: Associate external memory with each WebGPU device, to encourage GC. r=webgpu-reviewers,aleiserson\n\nPreparation for bug 1870899, poll from a thread:\n\nA device's GPU-side resources are freed only when its id is dropped,\nwhich waits for its `GPUDevice` to be garbage collected, even if content\nhas already called `destroy()`. With polling no longer tied to a 100ms\ntimer, `device.lost` resolves promptly after `destroy()`, so tests that\ncreate and destroy many devices run much faster. On Windows,\n`webgpu:api,validation,capability_checks,limits,maxInterStageShaderVariables:createRenderPipeline,at_over:*`\nthen fails: partway through, `requestDevice` starts reporting \"Not\nenough memory left\", and soon does so for every remaining subcase. It\nseems that destroyed devices accumulate faster than garbage collection\nfrees them.\n\nFollowing the precedent of `CommandEncoder` (bug 1963926), overload\n`BindingJSObjectMallocBytes` for `Device` to associate 32 MiB with each\n`GPUDevice` wrapper, roughly the size of the shader-visible descriptor\nheap that wgpu-hal's D3D12 backend allocates for every device. This makes\nthe JS engine schedule garbage collection sooner when many devices are\ncreated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344063\n", "files": ["dom/webgpu/Device.h", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/operation/render_pipeline/sample_mask/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/capability_checks/limits/maxComputeWorkgroupStorageSize/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/capability_checks/limits/maxStorageBuffersPerShaderStage/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/image_copy/layout_related/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/state/device_lost/destroy/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureGather/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureGatherCompare/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSample/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleBias/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleCompareLevel/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleGrad/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/shader/execution/expression/call/builtin/textureSampleLevel/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/dedicated.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/shared.https.html.ini"], "git_node": "8881e293ed8514d30bbd813f91231c9e4983b119", "git_parents": ["37964b715ef6d7181cbb1c13550041854d2b469f"], "node": "e77fd83604f8a0fa336f096c73bd17c2065ab106", "parents": ["f7f695405b2da57bc07540fcae212814fc0f707f"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2089022 - ModemManagerImeiProvider should verify results during introspection r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343938\n", "files": ["dom/system/linux/ModemManagerImeiProvider.cpp"], "git_node": "452d2d77d32ceea356c2d33ce55b7b0535a1e7c9", "git_parents": ["8881e293ed8514d30bbd813f91231c9e4983b119"], "node": "00a455cd25c0b6613780bab8f28f88c44e03a95e", "parents": ["e77fd83604f8a0fa336f096c73bd17c2065ab106"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2089022 - ModemManagerImeiProvider risks leaking pending promise in edge cases r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343939\n", "files": ["dom/system/linux/ModemManagerImeiProvider.cpp"], "git_node": "1546fb6c2a45cd043a6d94f813b2b38af09b9afe", "git_parents": ["452d2d77d32ceea356c2d33ce55b7b0535a1e7c9"], "node": "a743f79b101c33732634171d7f76c749eb35da6c", "parents": ["00a455cd25c0b6613780bab8f28f88c44e03a95e"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2091258 - Part 1: Add GlobalMerinoSportsDependencyProvider for the Merino sports refresh work r=android-reviewers,npoon\n\n- Add GlobalMerinoSportsDependencyProvider to hold lazy references to the provider and storage used by the scheduled work\n- Read the provider and storage from it in the refresh matches use case\n- Make MerinoSportsUpdater only schedule and cancel the work so the dependencies outlive a stopped refresh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342934\n", "files": ["mobile/android/android-components/components/service/merino-sports/src/main/java/mozilla/components/service/merino/sports/GlobalMerinoSportsDependencyProvider.kt", "mobile/android/android-components/components/service/merino-sports/src/main/java/mozilla/components/service/merino/sports/MerinoSportsUpdater.kt", "mobile/android/android-components/components/service/merino-sports/src/main/java/mozilla/components/service/merino/sports/MerinoSportsUseCases.kt", "mobile/android/android-components/components/service/merino-sports/src/test/java/mozilla/components/service/merino/sports/GlobalMerinoSportsDependencyProviderTest.kt", "mobile/android/android-components/components/service/merino-sports/src/test/java/mozilla/components/service/merino/sports/MerinoSportsUpdaterTest.kt", "mobile/android/android-components/components/service/merino-sports/src/test/java/mozilla/components/service/merino/sports/MerinoSportsUpdaterWorkerTest.kt", "mobile/android/android-components/components/service/merino-sports/src/test/java/mozilla/components/service/merino/sports/MerinoSportsUseCasesTest.kt"], "git_node": "ec50796db5c673d6bad116100ebff465db007308", "git_parents": ["1546fb6c2a45cd043a6d94f813b2b38af09b9afe"], "node": "bb48f4584f2824382352610af24a11982efff7e6", "parents": ["a743f79b101c33732634171d7f76c749eb35da6c"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2091258 - Part 2: Initialize GlobalMerinoSportsDependencyProvider on app start r=android-reviewers,android-build-system-reviewers,npoon\n\n- Add the service-merino-sports dependency to Fenix\n- Add the Merino sports provider and matches storage to Core\n- Initialize GlobalMerinoSportsDependencyProvider in FenixApplication so the scheduled refresh can run after the process is killed\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342935\n", "files": ["mobile/android/fenix/.buildconfig.yml", "mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Sports.kt"], "git_node": "dbbdb1694bdcb1f958bd33f18172a00489ceeee8", "git_parents": ["ec50796db5c673d6bad116100ebff465db007308"], "node": "a9d150093c2680e03daf98206193a9f06c52dd28", "parents": ["bb48f4584f2824382352610af24a11982efff7e6"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2089362 - Part 1: Align the Wrexham widget data types with the Merino match fields r=android-reviewers,android-l10n-reviewers,parker,npoon\n\n- Rename the team key to name, replacing the separate long name, and the team globalTeamId to id\n- Remove the unused team drawable and eliminated fields\n- Replace the unused match updated timestamp with updatedAt\n- Add a Canceled match status with its own badge label\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340834\n", "files": ["mobile/android/android-components/components/service/merino-sports/src/main/java/mozilla/components/service/merino/sports/MerinoMatches.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/SportCardData.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/fake/FakeSportsPreview.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/ui/MatchCard.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/ui/MatchCardHeader.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/ui/MatchStatusBadge.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/ui/Scoreboard.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/ui/SportsWidget.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/ui/TeamSlot.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/sports/ui/SportsWidgetPagesTest.kt"], "git_node": "36038dc08b70b3d70e11390e14db992c5b9d6faa", "git_parents": ["dbbdb1694bdcb1f958bd33f18172a00489ceeee8"], "node": "1c63dc4f80719ccfd739498d7bf078d8a4176c0b", "parents": ["a9d150093c2680e03daf98206193a9f06c52dd28"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 1b73ba93315563df0dd0ceb36b887f10a8b9d259\naf -\u003e 1b73ba