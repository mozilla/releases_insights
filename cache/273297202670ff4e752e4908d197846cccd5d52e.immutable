62/test/staging/decorators/class-expr-escaped-accessor.js", "testing/web-platform/tests/third_party/test262/test/staging/decorators/class-expr-escaped-static-accessor.js", "testing/web-platform/tests/third_party/test262/vendored.toml"], "git_node": "b3fe5e9443ef090001d45b1d810126bc51c15f43", "git_parents": ["3eb247edc789bfc4136fd5f9d1a5c2c99c0e2c77"], "node": "008a4c9501d1736be00221b814dfed38e20f06a7", "parents": ["f781116812cbaeb9b6aee09a8343403307f2f06b"], "tags": []}, {"author": "Eldar Pulatov \u003cepulatov.dev@gmail.com\u003e", "branch": "default", "desc": "Bug 2091928 [wpt PR 64545] - [style] Revert \"Remove unused RuleSetFlag\", a=testonly\n\nAutomatic update from web-platform-tests\n[style] Revert \"Remove unused RuleSetFlag\"\n\nThis reverts commit fd68a40ff06ab39fc5b96f99a2c26a53de4395ea. Original\nCL: https://crrev.com/c/5153352\n\nLayer-order changes request kFullRecalcRules through kRuleSetFlagsAll.\nRemoving the flag and its handler left computed styles stale when layer\ndeclarations changed the winning rules in unchanged sheets.\n\nRestore the flag in an unused bit to preserve the current numbering. Add\nregression tests and document why the all-flags value requests subtree\nstyle recalc.\n\nBug: 570832596\nChange-Id: Idb846018d04c9b7fdd705b114d0988843aff6594\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8564519\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Eldar Pulatov \u003cepulatov.dev@gmail.com\u003e\nReviewed-by: Daniil Sakhapov \u003csakhapov@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1732761}\n\n--\n\nwpt-commits: 7223e1439daab92f6ef1ecd0908febf238032eca\nwpt-pr: 64545\n", "files": ["testing/web-platform/tests/css/css-cascade/layer-order-invalidation-shadow-dom.html"], "git_node": "0f1b131a231e40b773b792bcca82535f5374e17e", "git_parents": ["b3fe5e9443ef090001d45b1d810126bc51c15f43"], "node": "64c491407243c08e17d7b6e11751431866a2a755", "parents": ["008a4c9501d1736be00221b814dfed38e20f06a7"], "tags": []}, {"author": "Michael Zaporozhets \u003cmichael.zaporozhets@shopify.com\u003e", "branch": "default", "desc": "Bug 2091932 [wpt PR 64323] - Add test for FontFaceSet.check() with a failed font face, a=testonly\n\nAutomatic update from web-platform-tests\nAdd test for FontFaceSet.check() with a failed font face (#64323)\n\n* Add test for FontFaceSet.check() with a failed font face\n\ncheck() should return false once the only matching font face has\npermanently failed to load (status \"error\"), per\nhttps://drafts.csswg.org/css-font-loading/#font-face-set-check: check()\nmay only report true when every matching face has status \"loaded\".\n\nChromium and Firefox already return false in this case. WebKit\ncurrently returns true, tracked at\nhttps://bugs.webkit.org/show_bug.cgi?id=329279 with a fix up for\nreview at https://github.com/WebKit/WebKit/pull/78670.\n\n* Update metadata in HTML file\n--\n\nwpt-commits: a5e778fb02a2778df613867ad5f662db00ea0815\nwpt-pr: 64323\n", "files": ["testing/web-platform/tests/css/css-font-loading/fontfaceset-check-error-status.html"], "git_node": "8b2e584519221d46cfa59ed9c472cbaa7e3d3372", "git_parents": ["0f1b131a231e40b773b792bcca82535f5374e17e"], "node": "52a2e94c1e85bf9a513712d2c61d850ba356156c", "parents": ["64c491407243c08e17d7b6e11751431866a2a755"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2091935 [wpt PR 64191] - Collapse equal font-style descriptor bounds, a=testonly\n\nAutomatic update from web-platform-tests\nCollapse equal font-style descriptor bounds (#64191)\n\nCSS Fonts 4 requires equal lower and upper bounds to serialize as a single value. Apply this to the 20deg fixture, matching the existing 10deg fixture and the font-weight and font-stretch range tests.\n\nhttps://drafts.csswg.org/css-fonts-4/#serializing-at-rules\n\nCo-authored-by: codex \u003ccodex@openai.com\u003e\n--\n\nwpt-commits: dc1da1767cc865c0f696c4ff4efe40167b5bdc28\nwpt-pr: 64191\n", "files": ["testing/web-platform/tests/css/css-fonts/variations/at-font-face-descriptors.html"], "git_node": "bf17b7e52049d7a4af0ecff562f13b947660bda1", "git_parents": ["8b2e584519221d46cfa59ed9c472cbaa7e3d3372"], "node": "a5b27ab546329ce869176b2cc145229123a4a8ea", "parents": ["52a2e94c1e85bf9a513712d2c61d850ba356156c"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2091937 [wpt PR 64192] - Reject extra rules in a font-feature-values fixture, a=testonly\n\nAutomatic update from web-platform-tests\nReject extra rules in a font-feature-values fixture (#64192)\n\nThe closing brace after `@blah` ends the outer `@font-feature-values` rule. The remaining `@styleset` rule and closing brace are top-level trailing input, so `insertRule()` must throw `SyntaxError`: parsing a single rule requires EOF after that rule. Mark this fixture invalid instead of expecting recovery inside a single `@font-feature-values` rule.\n\nhttps://drafts.csswg.org/css-syntax-3/#parse-rule\nhttps://drafts.csswg.org/cssom/#dom-cssstylesheet-insertrule\n\nCo-authored-by: codex \u003ccodex@openai.com\u003e\n--\n\nwpt-commits: 6190f6e0925c9addd2a44375aa5275003d026170\nwpt-pr: 64192\n", "files": ["testing/web-platform/tests/css/css-fonts/test_font_feature_values_parsing.html"], "git_node": "3b3e7b0919c96d3466261e7a50a1b5efa9d2c9ec", "git_parents": ["bf17b7e52049d7a4af0ecff562f13b947660bda1"], "node": "8f7765a57eec2a93af81397dbdb88b36d76f97f5", "parents": ["a5b27ab546329ce869176b2cc145229123a4a8ea"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091937 [wpt PR 64192] - Update wpt metadata, a=testonly\n\nwpt-pr: 64192\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-fonts/test_font_feature_values_parsing.html.ini"], "git_node": "05385a5584f9f8403495b9b673eaea28022ab3ae", "git_parents": ["3b3e7b0919c96d3466261e7a50a1b5efa9d2c9ec"], "node": "f3d1c8052c969574778a13a99ff35ead6a24a54a", "parents": ["8f7765a57eec2a93af81397dbdb88b36d76f97f5"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2091949 [wpt PR 64193] - Allow implementation limits for huge font-stretch, a=testonly\n\nAutomatic update from web-platform-tests\nAllow implementation limits for huge font-stretch (#64193)\n\nKeep the syntax-support assertion for 1e9%, but omit its exact computed-value assertion. CSS Values allows implementation-specific numeric limits: Chromium and WebKit clamp this value to 8191.75%, and Firefox clamps it to 1000%. The old expectation also used scientific notation, contrary to CSSOM number serialization. Ordinary percentages retain their exact computed-value checks.\n\nhttps://drafts.csswg.org/css-values-4/#numeric-types\nhttps://drafts.csswg.org/cssom/#serialize-a-css-component-value\n\nCo-authored-by: codex \u003ccodex@openai.com\u003e\n--\n\nwpt-commits: 1c8b8f54d2adf5ecb5594d685b9b28f7c4dba324\nwpt-pr: 64193\n", "files": ["testing/web-platform/tests/css/css-fonts/variations/font-stretch.html"], "git_node": "fda66bc8657e51fa82c7409a0e4ee9f241dfd901", "git_parents": ["05385a5584f9f8403495b9b673eaea28022ab3ae"], "node": "b34c3d28f797e6e582bda451bc9bc1878dccc616", "parents": ["f3d1c8052c969574778a13a99ff35ead6a24a54a"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2091952 [wpt PR 64245] - Test font feature value serialization and map order, a=testonly\n\nAutomatic update from web-platform-tests\nTest font feature value serialization and map order (#64245)\n\nAssert exact serialization under the algorithm proposed in https://github.com/w3c/csswg-drafts/issues/14658, including fixed block order, first-occurrence name order, whitespace, empty rules, and the `font-display` descriptor. Cover merged blocks, duplicate and escaped names, invalid declarations, omitted empty blocks, and the placement of `@historical-forms`.\n\nCheck that map iteration exposes parsed names in first-occurrence order with their final valid values. Updating an entry preserves its position, while deletion followed by reinsertion appends it.\n\nCorrect two existing duplicate-name fixtures to expect one declaration per name with its last value, retaining the first name position. These corrections overlap https://github.com/web-platform-tests/wpt/pull/6647.\n\nThese tests should land with or after the corresponding CSS Fonts specification change.\n\nCo-authored-by: codex \u003ccodex@openai.com\u003e\n--\n\nwpt-commits: f0cbd2cedb2e8c916fa0489a945c2a361e085a37\nwpt-pr: 64245\n", "files": ["testing/web-platform/tests/css/css-fonts/font-feature-values-map-order.html", "testing/web-platform/tests/css/css-fonts/font-feature-values-serialization-order.html", "testing/web-platform/tests/css/css-fonts/test_font_feature_values_parsing.html"], "git_node": "f2173d1e4b72155941dedf264138183fab916542", "git_parents": ["fda66bc8657e51fa82c7409a0e4ee9f241dfd901"], "node": "1f1a15799931cfb360d7feb698b94ef83917a98c", "parents": ["b34c3d28f797e6e582bda451bc9bc1878dccc616"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091952 [wpt PR 64245] - Update wpt metadata, a=testonly\n\nwpt-pr: 64245\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-fonts/font-feature-values-map-order.html.ini", "testing/web-platform/meta/css/css-fonts/font-feature-values-serialization-order.html.ini", "testing/web-platform/meta/css/css-fonts/test_font_feature_values_parsing.html.ini"], "git_node": "869415e53dfe0d782a336546638a13807265bc95", "git_parents": ["f2173d1e4b72155941dedf264138183fab916542"], "node": "26d03cef73608cc8a37d58f2ed32fed7c99b9711", "parents": ["1f1a15799931cfb360d7feb698b94ef83917a98c"], "tags": []}, {"author": "Sean Patterson \u003csean_patterson@apple.com\u003e", "branch": "default", "desc": "Bug 2091959 [wpt PR 64552] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=311552, a=testonly\n\nAutomatic update from web-platform-tests\n[SVG2] Remove use-script, no-change and reset-size from dominant-baseline\n\nSVG 2 no longer supports the use-script, no-change and reset-size values of\ndominant-baseline [1], and they are absent from the css-inline-3 grammar that\nnow defines the property [2].\n\nAll three were already close to no-ops in WebKit: use-script mapped to\nalphabetic behind a FIXME, while no-change and reset-size deferred to the\nparent element's dominant baseline, which resolves to alphabetic for\nhorizontal text. Removing them lets the values fall back to auto, which maps\nto alphabetic in horizontal writing modes and central in vertical ones, so\nthere is no rendering change for the cases these values previously covered.\n\nsvg/custom/dominant-baseline-modes.svg and svg/custom/alignment-baseline-modes.svg\ncontinue to specify the three values, which now fall back to auto; their\nresults are unchanged for the reason above.\n\nNote that WebKit still spells the two edge baselines with their SVG 1.1 names,\ntext-before-edge and text-after-edge. css-inline-3 renames those to text-top\nand text-bottom and keeps the SVG spellings only as legacy aliases [3], and\nWebKit does not yet accept the css-inline-3 names. That gap is orthogonal to\nthis patch, which only removes values; it is tracked separately in\nwebkit.org/b/321612.\n\n[1] https://w3c.github.io/svgwg/svg2-draft/text.html#DominantBaselineProperty\n[2] https://drafts.csswg.org/css-inline-3/#propdef-dominant-baseline\n[3] https://drafts.csswg.org/css-inline/#alignment-baseline-svg-legacy\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=311552\nWebKit-Canonical-Link: https://commits.webkit.org/319256@main\n\n--\n\nwpt-commits: 8d5216bbbf9cf27c6c7a9447383c725231d091f1\nwpt-pr: 64552\n", "files": ["testing/web-platform/tests/svg/text/dominant-baseline.historical.html"], "git_node": "d8cda2011bc19cbd054298cf3651380c36ddbb7e", "git_parents": ["869415e53dfe0d782a336546638a13807265bc95"], "node": "7676c3886f749610c18ad4d1d830b97aeefa593b", "parents": ["26d03cef73608cc8a37d58f2ed32fed7c99b9711"], "tags": []}, {"author": "Yoav Weiss \u003cyoav.weiss@shopify.com\u003e", "branch": "default", "desc": "Bug 2091964 [wpt PR 64553] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=316291, a=testonly\n\nAutomatic update from web-platform-tests\nSet timeOrigin to align with spec, even when BCG switches take place.\n\nCurrently the timeOrigin is set when the final process starts the navigation request load.\nBut in the case of a BCG switch, that load ends up resuming/reusing a load that was already\nstarted in the previous process.\nThis PR pipes the relevant information over, so that the `timeOrigin` will be properly set\nin these cases.\n\nThis is fine from a w3c/navigation-timing#160 perspective, because as\nagainst this by obfuscating more than just the redirect data for cross-origin redirects.\n\nTest progression.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=316291\nWebKit-Canonical-Link: https://commits.webkit.org/318057@main\n\n--\n\nwpt-commits: 1a665f25105a7b944a425314fe0e1b946678e050\nwpt-pr: 64553\n", "files": ["testing/web-platform/tests/navigation-timing/response-start-after-coop-bcg-switch-no-tao.tentative.https.html"], "git_node": "08b84c506b3c2071c38a3ea8148f159a222f0dca", "git_parents": ["d8cda2011bc19cbd054298cf3651380c36ddbb7e"], "node": "0b5ded079e80756d298592c59f7c088b1d3d7432", "parents": ["7676c3886f749610c18ad4d1d830b97aeefa593b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091964 [wpt PR 64553] - Update wpt metadata, a=testonly\n\nwpt-pr: 64553\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/navigation-timing/response-start-after-coop-bcg-switch-no-tao.tentative.https.html.ini"], "git_node": "d71500ebb17f8d401c870769dbc85955ea361b61", "git_parents": ["08b84c506b3c2071c38a3ea8148f159a222f0dca"], "node": "ccfd86d79f75cdf8abcf5acd7ab960c32cc0f3ed", "parents": ["0b5ded079e80756d298592c59f7c088b1d3d7432"], "tags": []}, {"author": "Claudio Saavedra \u003ccsaavedra@igalia.com\u003e", "branch": "default", "desc": "Bug 2091971 [wpt PR 64556] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=312156, a=testonly\n\nAutomatic update from web-platform-tests\n[WPE][ARM64] REGRESSION(310865@main): 2d.strokeStyle.gradient/pattern tests not fuzzy enough\n\nIncrease fuzziness tolerance in these two tests so that they don't fail in arm64 WPE.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=312156\nWebKit-Canonical-Link: https://commits.webkit.org/311162@main\n\n--\n\nwpt-commits: 075a154be14c686f1b465de327e560420dd1aabf\nwpt-pr: 64556\n", "files": ["testing/web-platform/tests/html/canvas/element/fill-and-stroke-styles/2d.strokeStyle.gradient.arc.html", "testing/web-platform/tests/html/canvas/element/fill-and-stroke-styles/2d.strokeStyle.pattern.arc.html"], "git_node": "2d0fdf5021bc93831d17b39027bcb9ce3dc6e61b", "git_parents": ["d71500ebb17f8d401c870769dbc85955ea361b61"], "node": "8fb2b378b0d70f9719da9433a1d88d47b5683176", "parents": ["ccfd86d79f75cdf8abcf5acd7ab960c32cc0f3ed"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2092282 [wpt PR 64551] - [XSLT] Fix crash for xsl:import/xsl:include without href, a=testonly\n\nAutomatic update from web-platform-tests\n[XSLT] Fix crash for xsl:import/xsl:include without href\n\nXSLStyleSheet::LoadChildSheets() passed the result of xsltGetNsProp()\nfor the href attribute directly to String::FromUtf8(). When the\nattribute is missing, xsltGetNsProp() returns null, and converting that\nnull pointer to std::string_view trips a libc++ hardening assertion,\ncrashing the renderer.\n\nThis CL skips loading a child sheet when href is absent. libxslt still\nreports the missing attribute when it compiles the stylesheet.\n\nFixed: 566820671\nChange-Id: I93a86c611cb8b2fd3d4f20da644b19e2eaebdc01\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8693277\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1732853}\n\n--\n\nwpt-commits: 8d886230c83f40aa587ac3ff6a61602268fa3169\nwpt-pr: 64551\n", "files": ["testing/web-platform/tests/xml/xslt/import-include-no-href-crash.html"], "git_node": "5414061d89decffde5b87977dca4fe6191d13fdb", "git_parents": ["2d0fdf5021bc93831d17b39027bcb9ce3dc6e61b"], "node": "a512276cf386e37f2c9f81e1210c6382cec1196b", "parents": ["8fb2b378b0d70f9719da9433a1d88d47b5683176"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092282 [wpt PR 64551] - Update wpt metadata, a=testonly\n\nwpt-pr: 64551\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/xml/xslt/import-include-no-href-crash.html.ini"], "git_node": "3c22700b8dd15ff7b35263ae817ecbd40701a0ab", "git_parents": ["5414061d89decffde5b87977dca4fe6191d13fdb"], "node": "12a0650c7c6c5691745fa3ae41d0a14e2b2991e9", "parents": ["a512276cf386e37f2c9f81e1210c6382cec1196b"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2092291 [wpt PR 64557] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=192980, a=testonly\n\nAutomatic update from web-platform-tests\nKeep the outside list marker at the list item and position it after layout\n\nAn outside list marker is currently reparented into whichever descendant holds\nthe list item's first line box, so an overflow, clip or transform on that\ndescendant makes the marker disappear or get clipped.\n\nKeep the marker as the list item's first child instead, take it out of in-flow layout, and position it\nafter layout against the line it aligns with. Gated behind ListMarkerPositionedPostLayoutEnabled.\n\nThe line still has to make room for the marker, so line layout is handed its\nlayout bounds and grows the root inline box's layout bounds by them, which is\nwhat a real marker inline level box would have contributed.\n\nRenderListItem positions the marker once its in-flow content is laid out, since only then is every box between the line and\nthe list item in its final position, and adds the marker's overflow at that point.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=192980\nWebKit-Canonical-Link: https://commits.webkit.org/318561@main\n\n--\n\nwpt-commits: 10b8c579618fe950e487ca13898e4c5d23a32d3f\nwpt-pr: 64557\n", "files": ["testing/web-platform/tests/css/css-lists/li-with-overflow-hidden-change-list-style-position-001.html", "testing/web-platform/tests/css/css-lists/outside-marker-after-empty-writing-mode-root-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-after-empty-writing-mode-root.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-becomes-boundary-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-becomes-boundary.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-changed-by-float-style-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-changed-by-float-style.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-changed-by-inline-content-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-changed-by-inline-content.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-changed-by-inserted-block-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-changed-by-inserted-block.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-changed-by-inserted-text-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-changed-by-inserted-text.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-changed-in-nested-block-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-changed-in-nested-block.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-moves-deeper-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-moves-deeper.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-removed-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-container-removed.html", "testing/web-platform/tests/css/css-lists/outside-marker-from-inside-position-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-from-inside-position.html", "testing/web-platform/tests/css/css-lists/outside-marker-list-item-becomes-multicol-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-list-item-becomes-multicol.html", "testing/web-platform/tests/css/css-lists/outside-marker-multicol-destroyed-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-multicol-destroyed.html", "testing/web-platform/tests/css/css-lists/outside-marker-nested-shared-container-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-nested-shared-container.html", "testing/web-platform/tests/css/css-lists/outside-marker-rtl-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-rtl.html", "testing/web-platform/tests/css/css-lists/outside-marker-skips-out-of-flow-first-child-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-skips-out-of-flow-first-child.html", "testing/web-platform/tests/css/css-lists/outside-marker-with-hr-content-ref.html", "testing/web-platform/tests/css/css-lists/outside-marker-with-hr-content.html", "testing/web-platform/tests/css/css-multicol/multicol-list-item-006.html"], "git_node": "aa5b618ce1fbd3e723052640f9cf01b8a8d0d49c", "git_parents": ["3c22700b8dd15ff7b35263ae817ecbd40701a0ab"], "node": "430daa9920c1bd3bff0437d9052497b4c2445962", "parents": ["12a0650c7c6c5691745fa3ae41d0a14e2b2991e9"], "tags": []}, {"author": "Fran\u00e7ois Beaufort \u003cbeaufort.francois@gmail.com\u003e", "branch": "default", "desc": "Bug 2083399 [wpt PR 63800] - [WebMCP] Add outputSchema to ModelContextTool and RegisteredTool, a=testonly\n\nAutomatic update from web-platform-tests\n[WebMCP] Add outputSchema to ModelContextTool and RegisteredTool\n\nThis adds an optional outputSchema dictionary member to\nModelContextTool and RegisteredTool to define the expected structure\nof tool execution return values. Upon registration, outputSchema is\nserialized with the tool schema serialization algorithm, throwing\na TypeError on serialization failure before checking abort signals.\ngetTools() exposes outputSchema as a parsed JSON Schema object, or\nundefined when omitted.\n\nSpec PR: https://github.com/webmachinelearning/webmcp/pull/254\n\nBug: 489045948\nBug: 565876481\nChange-Id: I5e333c74c834cd6bc29253609e4e3d74edb09d08\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8398367\nReviewed-by: Khushal Sagar \u003ckhushalsagar@chromium.org\u003e\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nCommit-Queue: Fr \u003cbeaufort.francois@gmail.com\u003e\nCr-Commit-Position: refs/heads/main@{#1732837}\n\n--\n\nwpt-commits: 9bde5b3372c351a82884e2cc06b1a9e7e3c26185\nwpt-pr: 63800\n", "files": ["testing/web-platform/tests/webmcp/imperative/exposedTo-cross-origin-child.https.html", "testing/web-platform/tests/webmcp/imperative/exposedTo-defaults-same-origin.https.html", "testing/web-platform/tests/webmcp/imperative/exposedTo-multiple-children.https.html", "testing/web-platform/tests/webmcp/imperative/getTools-imperative-schema.https.html", "testing/web-platform/tests/webmcp/imperative/register_tool_invalid_json_schema.https.html", "testing/web-platform/tests/webmcp/imperative/register_tool_with_schema.https.html", "testing/web-platform/tests/webmcp/imperative/resources/helpers.js"], "git_node": "d04f3c35dab4e036f3b4ba8026ac5244be771a52", "git_parents": ["aa5b618ce1fbd3e723052640f9cf01b8a8d0d49c"], "node": "8961dac95ecd4a6ba1d4c5cb0d0b442bf6dc96a5", "parents": ["430daa9920c1bd3bff0437d9052497b4c2445962"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083399 [wpt PR 63800] - Update wpt metadata, a=testonly\n\nwpt-pr: 63800\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/imperative/getTools-imperative-schema.https.html.ini", "testing/web-platform/meta/webmcp/imperative/register_tool_invalid_json_schema.https.html.ini", "testing/web-platform/meta/webmcp/imperative/register_tool_with_schema.https.html.ini"], "git_node": "610eb55efa04088f52ec1a6b8892bea602fd8df3", "git_parents": ["d04f3c35dab4e036f3b4ba8026ac5244be771a52"], "node": "18574f1718f432b51f18b69e78f84fe04aa21be7", "parents": ["8961dac95ecd4a6ba1d4c5cb0d0b442bf6dc96a5"], "tags": []}, {"author": "Aakash \u003caaka3h@gmail.com\u003e", "branch": "default", "desc": "Bug 2092409 [wpt PR 64555] - Fix CSSOM gap serialization with mixed initial values, a=testonly\n\nAutomatic update from web-platform-tests\nFix CSSOM gap serialization with mixed initial values\n\nDo not combine a mixed initial gap longhand and a length into an invalid\nshorthand. Preserve both longhand declarations so cssText round-trips\nwithout losing layout.\n\nAdd WPT coverage for both mixed orders, importance, live style rules,\nand valid gap shorthand and alias controls.\n\nBug: 578577128\nChange-Id: I666b1318b2809751b87a2709c64db055b74eab16\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8668481\nReviewed-by: Helmut Januschka \u003chelmut@januschka.com\u003e\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1732877}\n\n--\n\nwpt-commits: 6ca6374f30bf13f656d0af9921b43a6174002dcb\nwpt-pr: 64555\n", "files": ["testing/web-platform/tests/css/css-align/gaps/gap-serialization-cssom.html"], "git_node": "1698eb1e01bac236e5cb479299eea780c7a51abd", "git_parents": ["610eb55efa04088f52ec1a6b8892bea602fd8df3"], "node": "738393ff0b4b67aad154281d8b2f93a24bd9b9f2", "parents": ["18574f1718f432b51f18b69e78f84fe04aa21be7"], "tags": []}, {"author": "Mustaq Ahmed \u003cmustaq@google.com\u003e", "branch": "default", "desc": "Bug 2092410 [wpt PR 64558] - Deflake and fix keypress-not-fired-for-modifier-shortcuts.html, a=testonly\n\nAutomatic update from web-platform-tests\nDeflake and fix keypress-not-fired-for-modifier-shortcuts.html\n\n- Added a sentinel keypress to fix the test end condition. A wrong\n  end condition caused follow-up keyup events from one promise_test to\n  leak into another, making the test flaky on multiple platforms.\n\n- Corrected the shortcut key to test: exactly one of Control-V and\n  Meta-V is a platform-specific shortcut. The test tried both but didn't\n  fail because of the problem above.\n\nFixed: 575528279\nChange-Id: Icd27b3808faaec74a7f0018746a2702dd28a367c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8695895\nCommit-Queue: Mustaq Ahmed \u003cmustaq@chromium.org\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1732939}\n\n--\n\nwpt-commits: 904dd53bc671483077568d0f4a9e685db3574417\nwpt-pr: 64558\n", "files": ["testing/web-platform/tests/uievents/keyboard/keypress-not-fired-for-modifier-shortcuts.html"], "git_node": "4b240a64df7feead786defc051d233a4bafc0818", "git_parents": ["1698eb1e01bac236e5cb479299eea780c7a51abd"], "node": "27e3c84ae2bdae734765e10db73c225c37c41b73", "parents": ["738393ff0b4b67aad154281d8b2f93a24bd9b9f2"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2092412 [wpt PR 64559] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=304555, a=testonly\n\nAutomatic update from web-platform-tests\nNamed Style Container Queries on :host fail for Slotted Elements (#64559)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nWhen a slotted shadow host (e.g. \u003cchild-element\u003e inside \u003cparent-element\u003e) has an\n@container rule with a :host selector in its own shadow tree, the rule is matched with\nScopeOrdinal::Shadow. selectContainer() only used the assigned slot as the originating\nelement for ScopeOrdinal::Element, so for Shadow scope the lookup fell back to\nelement.shadowHost(), which is null for a slotted light DOM child. A container-name\ndefined by the slot host's own :host rule (also ScopeOrdinal::Shadow) was therefore\nnever allowed, and the query found no container.\n\nTreat ScopeOrdinal::Shadow the same as ScopeOrdinal::Element when the element is\nassigned to a slot, so names from the slot's host are resolved against the slot's tree.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=304555\nWebKit-Canonical-Link: https://commits.webkit.org/325470@main\n--\n\nwpt-commits: 36465ec0ca72d79ecb1ec2b16f4a3cb69751df4c\nwpt-pr: 64559\n", "files": ["testing/web-platform/tests/css/css-conditional/container-queries/container-name-host-slotted-tree-scoped.html"], "git_node": "78b1f29726b0efbb99e5e00288a6724c62ae5fa9", "git_parents": ["4b240a64df7feead786defc051d233a4bafc0818"], "node": "5d9ec91755773170ba990421bad6492b0be0a281", "parents": ["27e3c84ae2bdae734765e10db73c225c37c41b73"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2092414 [wpt PR 64560] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=285130, a=testonly\n\nAutomatic update from web-platform-tests\ninsertRule does not work for inserting @scope styles (#64560)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nAn @scope rule without a prelude finds its scoping root through\nStyleRuleScope::m_styleSheetOwner, a weak pointer to the owning\nStyleSheetContents. That pointer was stale in two cases:\n\n- CSSStyleSheet::insertRule() parses the rule against m_contents before\n  RuleMutationScope runs willMutateRules(). Inline \u003cstyle\u003e sheets are\n  cached and shared, so the first mutation clones the contents, and the\n  new rule's owner pointed at the old, client-less contents. No scoping\n  root was found and the rule never matched. CSSGroupingRule::insertRule()\n  and CSSStyleRule::insertRule() had the same ordering problem.\n- StyleRuleScope's copy constructor is defaulted, so the copies made by\n  the StyleSheetContents copy constructor kept pointing at the original\n  contents.\n\nAdd StyleSheetContents::adoptScopeRules(), which recursively re-points\n@scope rules (including ones nested in style and grouping rules) at the\ngiven contents. Call it from the copy constructor, wrapperInsertRule(),\nand the nested insertRule() paths.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=285130\nWebKit-Canonical-Link: https://commits.webkit.org/325468@main\n--\n\nwpt-commits: 7ee5884127dd26b3c3f49186211748d024416b72\nwpt-pr: 64560\n", "files": ["testing/web-platform/tests/css/css-cascade/scope-insert-rule.html"], "git_node": "f2d3d780286a930595617aa1e9e735f5a93d2deb", "git_parents": ["78b1f29726b0efbb99e5e00288a6724c62ae5fa9"], "node": "2ce0ae35b5c6d3482232f813a94dfc1840d48058", "parents": ["5d9ec91755773170ba990421bad6492b0be0a281"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2092416 [wpt PR 64561] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327922, a=testonly\n\nAutomatic update from web-platform-tests\nForgiving selector list recovery splits on commas inside blocks of an invalid selector (#64561)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nWhen a selector in a forgiving selector list (:is(), :where()) is invalid,\nconsumeForgivingSelectorList() skips ahead to the next comma one token at a time.\nCSSParserTokenRange is flat, so a comma nested inside a (...) or [...] block was\ntreated as a top-level separator, and the tokens after it were parsed as a\nseparate selector. For example, :is(:unknown-pseudo(1, .b, .c)) matched\nelements with class \"b\", because \".b\" was followed by a comma and parsed as a\nvalid selector.\n\nhttps://drafts.csswg.org/selectors-4/#typedef-forgiving-selector-list says:\n\n    \"Syntactically, \u003cforgiving-selector-list\u003e is equivalent to \u003cany-value\u003e?.\n    It is then parsed as a forgiving selector list to obtain its actual value.\n\n    To parse as a forgiving selector list given an input input:\n    1. Parse a list of \u003ccomplex-real-selector\u003es from input, and let selector\n       list be the result.\n    2. Remove all failure items from selector list, and all items that are\n       invalid selectors, then return a \u003cselector-list\u003e representing the\n       remaining items in selector list.\"\n\nThe argument is parsed as component values, so a (...) or [...] block is a\nsingle component value and a comma inside it does not separate list items.\nThe whole :unknown-pseudo(1, .b, .c) is therefore one invalid item, which is\nremoved, and :is() matches nothing. Skip whole component values (blocks\nincluded) while recovering.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327922\nWebKit-Canonical-Link: https://commits.webkit.org/325466@main\n--\n\nwpt-commits: 989e98803d60cd52a9404509e4a67365a3002d91\nwpt-pr: 64561\n", "files": ["testing/web-platform/tests/css/selectors/forgiving-selector-list-comma-in-block.html"], "git_node": "81cc90f875c0fcbc0680304e354e9605dfdd0954", "git_parents": ["f2d3d780286a930595617aa1e9e735f5a93d2deb"], "node": "c139ab890430351438d382a79cc760a8f77faa50", "parents": ["2ce0ae35b5c6d3482232f813a94dfc1840d48058"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092416 [wpt PR 64561] - Update wpt metadata, a=testonly\n\nwpt-pr: 64561\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/selectors/invalidation/crashtests/has-pseudoclass-only-crash.html.ini"], "git_node": "3d03da4a3de40ea33a35da052652fe2eed85754f", "git_parents": ["81cc90f875c0fcbc0680304e354e9605dfdd0954"], "node": "87c404df669cd03151bdf3d26bf124dea034ea81", "parents": ["c139ab890430351438d382a79cc760a8f77faa50"], "tags": []}, {"author": "Camillia Smith Barnes \u003ccammie@chromium.org\u003e", "branch": "default", "desc": "Bug 2092418 [wpt PR 64562] - Shared Storage: Remove fenced frame reporting and attestations, a=testonly\n\nAutomatic update from web-platform-tests\nShared Storage: Remove fenced frame reporting and attestations\n\nRemove unused Shared Storage fenced frame reporting support and\nPrivacy Sandbox attestations enum values:\n* Remove FencedFrameReporter::CreateForSharedStorage. Because\n  FencedFrameReporter::CreateForFledge and its tests were already\n  removed when Protected Audience was disconnected from the build\n  (https://crrev.com/c/8092390), CreateForSharedStorage was the last\n  remaining FencedFrameReporter factory method. Delete\n  fenced_frame_reporter_unittest.cc (whose remaining tests all called\n  CreateForSharedStorage) and the ReportingMetadataSuccess test in\n  fenced_frame_url_mapping_unittest.cc (since FencedFrameReporter can\n  no longer be instantiated).\n* Remove kSharedStorageSelectUrl from ReportingDestination in mojom,\n  blink::FencedFrame, and mojom traits.\n* Remove kSharedStorage from\n  privacy_sandbox::PrivacySandboxAttestationsGatedAPI, reserve\n  SHARED_STORAGE in privacy_sandbox_attestations.proto, and remove\n  content::PrivacySandboxInvokingAPI entirely.\n* Remove the invoking_api parameter from\n  PrivacySandboxSettings::IsEventReportingDestinationAttested,\n  ContentBrowserClient::IsPrivacySandboxReportingDestinationAttested,\n  and FencedFrameReporter.\n* Update stale comments in FencedFrameReporter, fenced frame mojom,\n  and WPT helpers.\n\nBug: 462465887\nChange-Id: I4d09d4d055d4d18081738142362b435e3ceeb08f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8635309\nReviewed-by: Dmitry Gozman \u003cdgozman@chromium.org\u003e\nReviewed-by: Ken Buchanan \u003ckenrb@chromium.org\u003e\nReviewed-by: Kevin Graney \u003ckmg@google.com\u003e\nCommit-Queue: Cammie Smith Barnes \u003ccammie@chromium.org\u003e\nReviewed-by: Xiaochen Zhou \u003cxiaochenzh@chromium.org\u003e\nAuto-Submit: Cammie Smith Barnes \u003ccammie@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1733013}\n\n--\n\nwpt-commits: ba6b377e806d88828428a631de4a7451ed085a9c\nwpt-pr: 64562\n", "files": ["testing/web-platform/tests/fenced-frame/README.md", "testing/web-platform/tests/fenced-frame/resources/utils.js"], "git_node": "0d77d74d997a0b775b8a991fd9cb803a1ec8ef5c", "git_parents": ["3d03da4a3de40ea33a35da052652fe2eed85754f"], "node": "f880c795676e78ca04959163337859e9dcc6c46f", "parents": ["87c404df669cd03151bdf3d26bf124dea034ea81"], "tags": []}, {"author": "Morten Stenshorne \u003cmstensho@chromium.org\u003e", "branch": "default", "desc": "Bug 2092419 [wpt PR 64399] - [FragmentedOofInCb] Resume fragmented OOFs in legend in fieldset., a=testonly\n\nAutomatic update from web-platform-tests\n[FragmentedOofInCb] Resume fragmented OOFs in legend in fieldset.\n\nThe fieldset anonymous child wrapper box usually becomes the containing\nblock for any OOFs inside, and no additional work is required for that\nto work. Add a test for it anyway.\n\nHowever, if there's an OOF inside the rendered legend, and the fieldset\nis the containing block for such OOFs, the fieldset layout algorithm\nitself needs to take care of this. Also add a test for this.\n\nBug: 40267498\nChange-Id: If90969552fcd563976176463818178ac34784e8f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8691971\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCommit-Queue: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1732650}\n\n--\n\nwpt-commits: 8d66a1df5c6e9279d5925bc4071ef95f65224ae2\nwpt-pr: 64399\n", "files": ["testing/web-platform/tests/css/css-break/fieldset-008.html", "testing/web-platform/tests/css/css-break/fieldset-009.html"], "git_node": "2d3b1134a9854956db5c45b63b05c713bb9cad5e", "git_parents": ["0d77d74d997a0b775b8a991fd9cb803a1ec8ef5c"], "node": "ee9280fdc3c2e36bfa53888306c6f5c3a3369ce4", "parents": ["f880c795676e78ca04959163337859e9dcc6c46f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092419 [wpt PR 64399] - Update wpt metadata, a=testonly\n\nwpt-pr: 64399\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-break/fieldset-009.html.ini"], "git_node": "13eb25c1f21b2cec6913e261c1a4e866da929a3a", "git_parents": ["2d3b1134a9854956db5c45b63b05c713bb9cad5e"], "node": "bcbe30be69afe737c6422e2ce605d8fbe1356a35", "parents": ["ee9280fdc3c2e36bfa53888306c6f5c3a3369ce4"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2092421 [wpt PR 64567] - [WPT] Fix missing and incorrect end tags, a=testonly\n\nAutomatic update from web-platform-tests\n[WPT] Fix missing and incorrect end tags\n\nCorrect mismatched and missing end tags in WPTs and their support and\nreference files. Fix unintended nesting of custom elements and remove\ninvalid end tags for void elements.\n\nBug: 542686202\nChange-Id: I05e5a756b41d53a4f7e93fdafee488dad2278d3a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8220629\nCommit-Queue: Andres Regalado Rosas \u003candresrega@microsoft.com\u003e\nReviewed-by: Andres Regalado Rosas \u003candresrega@microsoft.com\u003e\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1733052}\n\n--\n\nwpt-commits: 0d90fced9c8898bfdc0f75724918fff2e3a1daf5\nwpt-pr: 64567\n", "files": ["testing/web-platform/tests/content-dpr/content-dpr-various-elements-ref.html", "testing/web-platform/tests/content-dpr/content-dpr-various-elements.html", "testing/web-platform/tests/custom-elements/form-associated/fieldset-elements.html", "testing/web-platform/tests/mathml/relations/css-styling/displaystyle-011-ref.html", "testing/web-platform/tests/shadow-dom/focus-navigation/focus-navigation-web-component-radio.html", "testing/web-platform/tests/svg/animations/attribute-value-unaffected-by-animation-002.html", "testing/web-platform/tests/wai-aria/role/role_none_conflict_resolution.html"], "git_node": "3f5d68e5902f92598a699e7ba1f5b3381613f8a8", "git_parents": ["13eb25c1f21b2cec6913e261c1a4e866da929a3a"], "node": "f7dcb6e26803f01562411c5f60aca807f3226493", "parents": ["bcbe30be69afe737c6422e2ce605d8fbe1356a35"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2092423 [wpt PR 64348] - [css-anchor-position] Relayout anchor-positioned elements on scroll end, a=testonly\n\nAutomatic update from web-platform-tests\n[css-anchor-position] Relayout anchor-positioned elements on scroll end\n\nPer the CSSWG resolution in w3c/csswg-drafts#14112, once a scroll\noperation has stopped, the UA must ensure the layout of\nanchor-positioned elements is consistent with a full relayout at that\npoint (while continuing to slide them on the compositor during active\nscrolling).\n\nWhen a scroll finishes (emitting scrollend), notify active\nAnchorPositionScrollData instances whose adjustment containers include\nthe scrolled element. On the next snapshot update, invalidate their\nlayout (which also clears the remembered scroll offsets), so the element\nis relaid out at the current scroll position.\n\nAlso:\n- Filter layout scroll offsets per-axis in\n  AnchorEvaluatorImpl::CalculateAnchorRectWithScrollOffset() using\n  ShouldUseScrollAdjustmentFor(). Scroll is only compensated per axis\n  for anchors sharing the default anchor's scroll container in that\n  axis, so without this, a relayout on scroll end would start applying\n  scroll offsets that are not compensated for (breaking\n  anchor-scroll-single-axis-{mixed,default}-anchor.html).\n- Use PixelSnappedScrollOffset() in\n  AnchorPositionScrollData::ComputeAdjustmentContainersData() to match\n  compositor and paint property rounding of half-pixel scroll offsets.\n- Update WPTs (including anchor-scroll-011.html and\n  anchor-scroll-012.html) to reflect relayout on scroll end.\n\nBug: 543008837\nTest: blink_unittests --gtest_filter=AnchorPositionScrollDataTest.*\nTest: external/wpt/css/css-anchor-position/position-area-scrolling-008.html\nChange-Id: I123ee8913368fd3489cb938d6315d52436fd45bf\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8646229\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1733054}\n\n--\n\nwpt-commits: 57833de5e8ce19705f834134a0e7340946dac2eb\nwpt-pr: 64348\n", "files": ["testing/web-platform/tests/css/css-anchor-position/anchor-scroll-011.html", "testing/web-platform/tests/css/css-anchor-position/anchor-scroll-012.html", "testing/web-platform/tests/css/css-anchor-position/anchor-scroll-position-try-015-ref.html", "testing/web-platform/tests/css/css-anchor-position/anchor-scroll-position-try-015.tentative.html", "testing/web-platform/tests/css/css-anchor-position/position-area-scrolling-002.tentative.html", "testing/web-platform/tests/css/css-anchor-position/position-area-scrolling-005.html", "testing/web-platform/tests/css/css-anchor-position/position-area-scrolling-008.html"], "git_node": "f7a8c0a4de559bb6db8e9ce264a057e7935b25fd", "git_parents": ["3f5d68e5902f92598a699e7ba1f5b3381613f8a8"], "node": "3f325a71076170ece8e9c0b40ebb80c259f04076", "parents": ["f7dcb6e26803f01562411c5f60aca807f3226493"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092423 [wpt PR 64348] - Update wpt metadata, a=testonly\n\nwpt-pr: 64348\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-anchor-position/anchor-scroll-011.html.ini", "testing/web-platform/meta/css/css-anchor-position/anchor-scroll-012.html.ini", "testing/web-platform/meta/css/css-anchor-position/anchor-scroll-position-try-015.tentative.html.ini", "testing/web-platform/meta/css/css-anchor-position/position-area-scrolling-002.tentative.html.ini", "testing/web-platform/meta/css/css-anchor-position/position-area-scrolling-005.html.ini", "testing/web-platform/meta/css/css-anchor-position/position-area-scrolling-008.html.ini"], "git_node": "3f47a922bfd0e0dc374861b3e9da17b3da5ae479", "git_parents": ["f7a8c0a4de559bb6db8e9ce264a057e7935b25fd"], "node": "e1cdccf982be1d7c0d369c4b616f664fd365ef74", "parents": ["3f325a71076170ece8e9c0b40ebb80c259f04076"], "tags": []}, {"author": "Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e", "branch": "default", "desc": "Bug 2092427 [wpt PR 64518] - [grid-lanes] Store per-fragment lane state in break tokens, a=testonly\n\nAutomatic update from web-platform-tests\n[grid-lanes] Store per-fragment lane state in break tokens\n\nMove lane fragmentation state into `GridLaneData` carried by break\ntokens. Shallow-copy lanes when resuming layout, preserving shared items\nand placement data without modifying earlier tokens.\n\nCalculate item expansion from the original block size and the child\u2019s\nconsumed size, and track margin consumption through child break tokens.\n\nAdd unit tests verifying shared placement data and independent\nfragmentation state across fragments, and WPTs covering spanner\nexpansion.\n\nBug: 343257585\nChange-Id: I0f54da6461e95d17bbd6a5130cf5ec12c7e08648\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8640352\nCommit-Queue: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1733058}\n\n--\n\nwpt-commits: 90efb49687daf5673f7d70038769f84622df7468\nwpt-pr: 64518\n", "files": ["testing/web-platform/tests/css/css-break/grid/grid-lanes/column-early-breaks-016-ref.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-early-breaks-016.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-early-breaks-017-ref.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-early-breaks-017.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-early-breaks-018-ref.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-early-breaks-018.html"], "git_node": "ca7b5386890dc31116c7dd541c4b4581ab84f180", "git_parents": ["3f47a922bfd0e0dc374861b3e9da17b3da5ae479"], "node": "b82c41df23b79a0009008852024932245899d989", "parents": ["e1cdccf982be1d7c0d369c4b616f664fd365ef74"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092427 [wpt PR 64518] - Update wpt metadata, a=testonly\n\nwpt-pr: 64518\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-break/grid/grid-lanes/column-early-breaks-016.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-early-breaks-017.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-early-breaks-018.html.ini"], "git_node": "e00d196366372b89adfde61fc32351c5bda36160", "git_parents": ["ca7b5386890dc31116c7dd541c4b4581ab84f180"], "node": "f44f948273899fc6e42788b165136f4bf2007421", "parents": ["b82c41df23b79a0009008852024932245899d989"], "tags": []}, {"author": "Fredrik S\u00f6derquist \u003cfs@opera.com\u003e", "branch": "default", "desc": "Bug 2092429 [wpt PR 64566] - Add missing step_func()s in switch_reentrant_removal.html, a=testonly\n\nAutomatic update from web-platform-tests\nAdd missing step_func()s in switch_reentrant_removal.html\n\nIf an assertion fails (like it does in Blink currently), the exception\nwill cause a harness error and a timeout. Wrap the event listeners in\nstep_func() to avoid this. Use a step_func_done() to eliminate the\nexplicit t.done().\n\nBug: 579016294\nChange-Id: I04cf160f73b16cceea986d8c7ff8511818ae95e0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8706012\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nAuto-Submit: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1733072}\n\n--\n\nwpt-commits: a834cbae7a0a6b1c48e6b5e1747148bf98e4b573\nwpt-pr: 64566\n", "files": ["testing/web-platform/tests/svg/struct/scripted/switch_reentrant_removal.html"], "git_node": "59d98a65cfd736751b5a6d40cb3f816d97141309", "git_parents": ["e00d196366372b89adfde61fc32351c5bda36160"], "node": "925ddaeb96ba18f982a4984606b5a5be5a574860", "parents": ["f44f948273899fc6e42788b165136f4bf2007421"], "tags": []}, {"author": "Ravjit Uppal \u003cravjit@chromium.org\u003e", "branch": "default", "desc": "Bug 2092436 [wpt PR 64574] - [CE] Reset inherited SVG marker properties in AdjustStyle(), a=testonly\n\nAutomatic update from web-platform-tests\n[CE] Reset inherited SVG marker properties in AdjustStyle()\n\nSVG marker properties (marker-start, marker-mid, marker-end) are\ninherited CSS properties by default. If an ancestor sets these\nproperties pointing to an arbitrary \u003cmarker\u003e element, the internal SVG\npaths of the permission element's icon can inherit them and render\nattacker-controlled spoofed icon.\n\nExplicitly reset MarkerStartResource, MarkerMidResource, and\nMarkerEndResource to nullptr in\nHTMLCapabilityElementBase::AdjustStyle().\n\nBug: 563013992\nChange-Id: I8271eb953a43990b24e6b5c34eefa97f6fc49551\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8692128\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nAuto-Submit: Ravjit Uppal \u003cravjit@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1733193}\n\n--\n\nwpt-commits: 733d595fcb985a5c04001fb6d85e6734471845fb\nwpt-pr: 64574\n", "files": ["testing/web-platform/tests/html/semantics/permission-element/camera/icon-svg-marker-on-parent-reftest-ref.html", "testing/web-platform/tests/html/semantics/permission-element/camera/icon-svg-marker-on-parent-reftest.html"], "git_node": "ea7e2802993be98851bfb6864fe7dc1c0d710f09", "git_parents": ["59d98a65cfd736751b5a6d40cb3f816d97141309"], "node": "47e43aba5c898edaa102dafc398eb036823f45d2", "parents": ["925ddaeb96ba18f982a4984606b5a5be5a574860"], "tags": []}, {"author": "Ravjit Uppal \u003cravjit@chromium.org\u003e", "branch": "default", "desc": "Bug 2092441 [wpt PR 64575] - [CE] Disallow multi-keyword list-item and ruby display values, a=testonly\n\nAutomatic update from web-platform-tests\n[CE] Disallow multi-keyword list-item and ruby display values\n\nMulti-keyword CSS Display Level 3 values ('inline list-item', 'flow-root\nlist-item', 'inline flow-root list-item', and 'block ruby') were missing\nfrom kInvalidDisplayStyles in HTMLCapabilityElementBase, allowing list\nmarker generation or ruby layout on capability elements.\n\nAdd these display values to kInvalidDisplayStyles and explicitly block\n::marker pseudo-element generation in CanGeneratePseudoElement().\n\nBug: 560157161\nChange-Id: I642316688322eddf4ee3d43da1e9edfcbb600668\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8688762\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nAuto-Submit: Ravjit Uppal \u003cravjit@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1733199}\n\n--\n\nwpt-commits: df39e531624c11b85f29ce67bd71d18436e66f96\nwpt-pr: 64575\n", "files": ["testing/web-platform/tests/html/semantics/permission-element/display-values.tentative.html", "testing/web-platform/tests/html/semantics/permission-element/geolocation-element/display-values.tentative.html", "testing/web-platform/tests/html/semantics/permission-element/geo