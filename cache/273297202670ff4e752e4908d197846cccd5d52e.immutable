la,credential-management-reviewers,sessionstore-reviewers,omc-reviewers,thecount,joschmidt,sfoster,yazan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339978\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/ASRouterNewTabHook.sys.mjs", "browser/components/backup/resources/MiscDataBackupResource.sys.mjs", "browser/components/mozcachedohttp/actors/MozCachedOHTTPParent.sys.mjs", "browser/components/newtab/AboutHomeStartupCache.sys.mjs", "browser/components/sessionstore/TabStateCache.sys.mjs", "browser/extensions/formautofill/content/editDialog.mjs", "browser/extensions/formautofill/content/manageDialog.mjs", "dom/console/ConsoleAPIStorage.sys.mjs", "dom/fs/test/xpcshell/head.js", "toolkit/components/passwordmgr/test/unit/test_BreachAlertStore.js"], "git_node": "eb96c50d2adb4e72084e1e2b843e044859cd207e", "git_parents": ["1a6ef5b097798bec3a251f5871aa524e68f81118"], "node": "f0d217076477c0b4e1b339f579b0b9da6d25798b", "parents": ["2e60725a2654264babd53004c8e2b7495309ea8b"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Resolve `storage` on the system global so OPFS does not need a window; asuth! r=nordzilla,frontend-codestyle-reviewers,asuth,smaug\n\nThis commit is patterned off of Bug 1910969. This change is required for\nthe ModelHub to not rely owning a Window object. There is a lifetime\nmismatch for the inference process outliving a file handle handed out\nby an arbitrary window.\n\nThe next commit fixes the lifetime mismatch in the Gecko AI Runtime.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339615\n", "files": ["js/xpconnect/src/Sandbox.cpp", "js/xpconnect/src/XPCJSRuntime.cpp", "js/xpconnect/src/XPCRuntimeService.cpp", "js/xpconnect/src/xpcprivate.h", "js/xpconnect/tests/unit/test_storage.js", "tools/@types/lib.gecko.tweaks.d.ts", "tools/lint/eslint/eslint-plugin-mozilla/lib/environments/privileged.mjs"], "git_node": "1a4e7709ae5480bd3105daffa87d7254ee24dcbc", "git_parents": ["eb96c50d2adb4e72084e1e2b843e044859cd207e"], "node": "e60673ed68cc00007817c12369755ae82744c083", "parents": ["f0d217076477c0b4e1b339f579b0b9da6d25798b"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Make OPFS use the system global's `storage` instead of a window's r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339616\n", "files": ["toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_opfs_private_window.js"], "git_node": "d93b4011d1f1baf068451775bbd91b6552ffa163", "git_parents": ["1a4e7709ae5480bd3105daffa87d7254ee24dcbc"], "node": "705085b60726613c79d7673256f8b753b659774d", "parents": ["e60673ed68cc00007817c12369755ae82744c083"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042157 - Add an index on moz_icons_to_pages(icon_id). r=places-reviewers,daisuke\n\nDeleting an icon checks its relations through the foreign key, and without\nan index each check scanned the whole table.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302338\n", "files": ["toolkit/components/places/Database.cpp", "toolkit/components/places/Database.h", "toolkit/components/places/nsINavHistoryService.idl", "toolkit/components/places/nsPlacesIndexes.h", "toolkit/components/places/tests/migration/places_v89.sqlite", "toolkit/components/places/tests/migration/test_current_from_v88.js", "toolkit/components/places/tests/migration/xpcshell.toml"], "git_node": "34ec04d4fa9d1c8ab9b5e7c4c2ac9980d3309f4f", "git_parents": ["d93b4011d1f1baf068451775bbd91b6552ffa163"], "node": "3bcc702cdba0dc26a5b297677859d4bc28c65b86", "parents": ["705085b60726613c79d7673256f8b753b659774d"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042157 - Only check the removed pages' icons when removing history. r=places-reviewers,daisuke\n\nInstead of scanning all the icons, only check those related to the removed\npages and the root icons of the removed origins. Icons left orphan when a\npage changes or expires its icons are now removed right away.\nRoot icons are now also kept while the www. variant of their host has pages,\nsince they're used for both.\nRoot icons are only kept by origins that have pages. Origins are currently\nremoved with their last page, but bug 2087500 will keep some origins\nwithout pages to store visit partitions, and we want to be sure this won't\nbreak when that work lands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302339\n", "files": ["toolkit/components/places/Database.cpp", "toolkit/components/places/FaviconHelpers.cpp", "toolkit/components/places/History.sys.mjs", "toolkit/components/places/PlacesDBUtils.sys.mjs", "toolkit/components/places/nsPlacesTables.h", "toolkit/components/places/tests/favicons/test_remove_orphan_icons.js", "toolkit/components/places/tests/favicons/xpcshell.toml", "toolkit/components/places/tests/maintenance/test_preventive_maintenance.js"], "git_node": "daec459afc8fa03dd9fd6ef9e738edccef6e9a44", "git_parents": ["34ec04d4fa9d1c8ab9b5e7c4c2ac9980d3309f4f"], "node": "b17fde009f0e271a0d755a9397ca2d80a2fae912", "parents": ["3bcc702cdba0dc26a5b297677859d4bc28c65b86"], "tags": []}], "date": 1795061457, "git_changesets": ["4273e42920401d086e167b34e78d2d2a9065f378", "2789e20a1c14362f60d00e85ca41b97f620e71cb", "afd2a66a1d41c62b49d0c68be330168aedcbe50b", "26bb1513ba399938a3ce34f99da4976359e8b48b", "46814069449d389a8a35f2a9f43f9c633f052121", "bc49d8e79cc2dcb08bf2906c50b432c2da87a437", "f2f4ae8c6e8528b9d1a5d4f47d0722a0c73be20f", "277550281ec2fcc152319936f767743007e0caaf", "1438185c91414f65e2505ab500cb2fa65d050967", "caed5c532d4d3315a4cccbe3a37f3cf11898db33", "5a32626a2efb30b9224ca505ed078dd782268cf3", "04d86d4ddc06a6493ee8c64ea9