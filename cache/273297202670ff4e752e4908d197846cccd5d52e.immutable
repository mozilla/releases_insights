ers,translations-reviewers,gregtatum,rpl\" for causing failures at browser_translations_about_settings_main_page_offer_checkbox.js.\n\nThis reverts commit 4dbebf0f857661c3003505afefe3d4af8e280597.\n", "files": ["browser/base/content/test/browser-performance/browser_startup_content.js", "browser/components/translations/content/selectTranslationsPanel.js", "dom/security/nsContentSecurityUtils.cpp", "toolkit/components/extensions/ExtensionContent.sys.mjs", "toolkit/components/extensions/parent/ext-i18n.js", "toolkit/components/reader/ReaderMode.sys.mjs", "toolkit/components/translations/LanguageDetector.sys.mjs", "toolkit/components/translations/actors/AboutTranslationsChild.sys.mjs", "toolkit/components/translations/actors/TranslationsParent.sys.mjs", "toolkit/components/translations/moz.build", "toolkit/components/translations/tests/unit/test_cld2.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "fbd000f86de77545413a30ae95c7c3834bf40208", "git_parents": ["299b184c1b2c500f6a8b9f5cbfaecc1de9f1ebf5"], "node": "567dbd8563464ab8589a320f09698deb4d7781e4", "parents": ["ef0f5b16d4700ab5a65b1b713fae542404b1031d"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090445: Use fallible allocation in BlobMemoryReporter::CollectReports. r=mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343481\n", "files": ["dom/file/BlobMemoryReporter.cpp"], "git_node": "f1c47d0a63001fe82d0fff98f1853a0744c40e7f", "git_parents": ["fbd000f86de77545413a30ae95c7c3834bf40208"], "node": "e4af1766271aa78782bada4ab4461787f5e7b8c5", "parents": ["567dbd8563464ab8589a320f09698deb4d7781e4"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093714 - Cache API: catch potential errors and Resolve if transaction fails to Start in CachePutAllAction. r=dom-storage-reviewers,dom-worker-reviewers,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343478\n", "files": ["dom/cache/Manager.cpp", "dom/cache/test/xpcshell/head.js", "dom/cache/test/xpcshell/test_put_transaction_failure.js", "dom/cache/test/xpcshell/xpcshell.toml"], "git_node": "581f83f4248fb8901c832ae768d808b29c9ab50c", "git_parents": ["f1c47d0a63001fe82d0fff98f1853a0744c40e7f"], "node": "8cd12bde68c3e877294ed215003e38ebfb5d4cb7", "parents": ["e4af1766271aa78782bada4ab4461787f5e7b8c5"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092310 - Wait for the bookmark to be saved before erasing bookmarks in browser_star_hsts.js, r=places-reviewers,Standard8.\n\nThe edit bookmark panel only saves a new bookmark when it hides, which happened when the cleanup function removed the tab, after it had erased all bookmarks. The bookmark left behind kept the star starred on a second run of the test. The test now hides the panel itself and checks that the secure URL was bookmarked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342367\n", "files": ["browser/base/content/test/browser-general/browser_star_hsts.js"], "git_node": "1a66761ebfc1fb7c577d22ac11a1ae1d1a1ff2be", "git_parents": ["581f83f4248fb8901c832ae768d808b29c9ab50c"], "node": "a48df639a9ad5a3acdc50219f031edeaff98138d", "parents": ["8cd12bde68c3e877294ed215003e38ebfb5d4cb7"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092272 - Fire dragend at the dragged split view in `browser_bookmark_drag_splitview.js`, r=places-reviewers,Standard8.\n\nThe test's drag never fires dragend, which leaves the tab strip in its\ndrag-and-drop mode. When the test runs again in the same browser, the tab\nstrip's stale drag check ends the new drag session at its first mousedown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342338\n", "files": ["browser/components/places/tests/browser/browser_bookmark_drag_splitview.js"], "git_node": "b819d558dbcb651c12c54c487b2d5eb26bdd4e1d", "git_parents": ["1a66761ebfc1fb7c577d22ac11a1ae1d1a1ff2be"], "node": "c8ef3372dd976f72a115e93609ea3247a858c0fa", "parents": ["a48df639a9ad5a3acdc50219f031edeaff98138d"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2091455 - Allow specifying LOAD_FLAGS_BYPASS_CLASSIFIER to reload, r=smaug\n\nThis patch adds a carve-out to allow specifying the\nLOAD_FLAGS_BYPASS_CLASSIFIER flag when calling `reload` on a\nBrowsingContext or nsDocShell. This is then used by BlockedSiteParent\ninstead of the manual load call.\n\nHistorically `reload` has not supported any load flags other than those\nwhich customize the LOAD_TYPE. Because of that, this extra flag was\nadded as an explicit carve-out. We may want/need to use a better\nmechanism in the future if we end up wanting to add more flags to\n`reload` in this way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341516\n", "files": ["browser/actors/BlockedSiteParent.sys.mjs", "docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h"], "git_node": "fed0b3f8e9be4bafe83b26f4791c7d77f2b7c608", "git_parents": ["b819d558dbcb651c12c54c487b2d5eb26bdd4e1d"], "node": "888cd0c0120e58b43ad05c98a8f16b16576a2b96", "parents": ["c8ef3372dd976f72a115e93609ea3247a858c0fa"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "0491adad582ec85b8a4c34fc4ac42d79844d37c3", "git_parents": ["fed0b3f8e9be4bafe83b26f4791c7d77f2b7c608", "889724fd195b636bc6685a867c2bc1d34573293e"], "node": "c066c3fc8dd67aecb6b8411c4f64bac8bb01e38b", "parents": ["888cd0c0120e58b43ad05c98a8f16b16576a2b96", "4573d3ddb8650054ba1fac5db798a5809f4c96da"], "tags": []}, {"author": "Jatin Mannepalli \u003cmjatin2007@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1991212 - Make Vector ranges robust across storage reallocation. r=mfbt-reviewers,sergesanspaille,emilio\n\nRepresent ranges with an owner, current index, and captured endpoint so storage growth cannot leave stale interior pointers. Add focused coverage for growth, exhaustion, shrink, clear, refill, copied cursors, const access, and copy ordering.\n\nTradeoff: each range remains bound to its live originating `Vector` and the endpoint originally captured when it is obtained from that `Vector`. Growth does not extend that endpoint. The range stays memory-safe across backing-storage reallocation, but it does not follow storage moved or swapped to another `Vector`; after shrink or clear, `empty()` and `remain()` may still report against the captured endpoint while dereferencing an index no longer below the current length crashes at `Vector`'s release bounds check, and refill may expose replacement elements at retained indices. This does not protect previously returned element references, extend the owner's lifetime, or support arbitrary reentrant or concurrent mutation. In the reported x86-64 layout, each range grows from the original 16-byte pointer pair to a 24-byte owner/index/end representation, with element access through the owner and current-length release bounds check. In a focused Clang 22 `-O2` microkernel, a pure scan hoisted storage and length and vectorized without a per-iteration bounds branch; across an opaque call, the loop reloaded the current length and storage and kept the release-bounds branch. A matched Linux shippable Speedometer 3 comparison reported 16.15 for the base and 16.20 for this patch (+0.32%; higher is better), with no detected regression.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339288\n", "files": ["mfbt/ArrayIterator.h", "mfbt/Vector.h", "mfbt/moz.build", "mfbt/tests/TestVector.cpp", "mfbt/tests/gtest/TestVectorRanges.cpp", "mfbt/tests/gtest/moz.build", "xpcom/ds/ArrayIterator.h", "xpcom/ds/moz.build"], "git_node": "299218f2fb8bc07feb793516fcf460a78c4edda4", "git_parents": ["0491adad582ec85b8a4c34fc4ac42d79844d37c3"], "node": "4e78ca6845b03cb6765554ede3143ffc19c2c917", "parents": ["c066c3fc8dd67aecb6b8411c4f64bac8bb01e38b"], "tags": []}, {"author": "Bryan Johns \u003cbjohns@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092727 - Switched LLMaJ inference from role system to user r=pdahiya\n\nQwen3.8 Flash Next will not work if a message stream is sent is only a system message and no user message.\nLLMaJ, as originally written used only the system message.\nTo patch this gap, we switch the role of the inference mode from \"system\" to \"user\".\n\nVerified solution by:\n - Reproducing MLPA error using system-prompt-only vs user-prompt-only messages\n - Ran batch telemetry after the role switch: all jobs completed fine.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342804\n", "files": ["browser/components/aiwindow/models/TelemetryUtils.sys.mjs"], "git_node": "358d67eb784cb9ac9de4812d26635e429a158980", "git_parents": ["299218f2fb8bc07feb793516fcf460a78c4edda4"], "node": "27ccc8e620dbe3c9ff6e2fef2917427faae17b4e", "parents": ["4e78ca6845b03cb6765554ede3143ffc19c2c917"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add a characterization for OPFS behavior for model downloading; r=nordzilla,ai-platform-reviewers\n\nThis is a test to show the current behavior of OPFS with a private browsing\nwindow, when you get a somewhat spurious error when a Private Browsing\nwindow just happens to be on top. This sets the stage for the following\nfix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328143\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_opfs_private_window.js"], "git_node": "35bef685d3ef7101c3123cba7dea2c55e7eb4163", "git_parents": ["358d67eb784cb9ac9de4812d26635e429a158980"], "node": "2b2116d4a750ab582efe1ec9570d7f6e8b330ddb", "parents": ["27ccc8e620dbe3c9ff6e2fef2917427faae17b4e"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Remove incorrect isPrivateBrowsing call and test; r=nordzilla,ai-platform-reviewers\n\nThis code uses the most recent browsing window, and doesn't work correctly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328144\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/content/Utils.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_privatebrowsing.js"], "git_node": "fdd7204cfb9f7f6092aaddce9edee3eb82028673", "git_parents": ["35bef685d3ef7101c3123cba7dea2c55e7eb4163"], "node": "b83bc36ff1dbd28aa582c490f8aa81c810c832c3", "parents": ["2b2116d4a750ab582efe1ec9570d7f6e8b330ddb"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Re-work OPFS.sys.mjs to pass TypeScript and remove dead code; r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328145\n", "files": ["toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/content/Utils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_cache.js"], "git_node": "82294b12678985966cb7f7b954ddabdd7a5837d3", "git_parents": ["fdd7204cfb9f7f6092aaddce9edee3eb82028673"], "node": "feedf68248d5d75679928f7fab022d294d978f0f", "parents": ["b83bc36ff1dbd28aa582c490f8aa81c810c832c3"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Remove OPFS usage in workers; r=nordzilla,ai-platform-reviewers\n\nThe inference process workers reached OPFS through their own global, which\nmeant two code paths for the same storage and a copy of the file lookup in\neach pipeline. The parent already reads the file when it resolves a model, so\nhave it send the blob rather than a path, and let the worker build the\nResponse it needs from that.\n\nImporting OPFS into a worker also failed outright, since its XPCOMUtils\nimport needs a privileged global: browser_ml_native_backend_error.js and\nbrowser_ml_smollm2_chat.js both died with \"Cu is not defined\" before this.\n\nWith nothing loading OPFS outside the parent, the worker plumbing goes too.\nOPFS.toResponse had no other caller, and the module no longer needs the\nIN_WORKER branch or the globalThis.navigator fallback.\n\nThe OPFS tests still cover toResponse and are fixed up later in the series.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328146\n", "files": ["toolkit/components/ml/actors/MLEngineChild.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/MLEngine.worker.mjs", "toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/content/backends/LlamaCppPipeline.mjs", "toolkit/components/ml/content/backends/StaticEmbeddingsPipeline.mjs", "toolkit/components/ml/tests/browser/browser_ml_opfs.js"], "git_node": "0307562b9d24982e354a2def94683b8fdaa851fe", "git_parents": ["82294b12678985966cb7f7b954ddabdd7a5837d3"], "node": "59990aa6fe6c46b975a3b7c188ba4701cb265f49", "parents": ["feedf68248d5d75679928f7fab022d294d978f0f"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add type checking to ModelHub.sys.mjs r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339596\n", "files": ["toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/ml.d.ts"], "git_node": "9b2172d5b80d71b08ab0a0bafa4fa81cdbc34268", "git_parents": ["0307562b9d24982e354a2def94683b8fdaa851fe"], "node": "cc38e4c61ef4637e1a6e074733b842df96b9dc1d", "parents": ["59990aa6fe6c46b975a3b7c188ba4701cb265f49"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add a mock model hub r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339597\n", "files": ["toolkit/components/ml/tests/MLTestUtils.sys.mjs"], "git_node": "ab13ded18b81d5c56f8a0a2e5676f8e583e72832", "git_parents": ["9b2172d5b80d71b08ab0a0bafa4fa81cdbc34268"], "node": "dc555196194c26f1e17257190c3148b17f9b9361", "parents": ["cc38e4c61ef4637e1a6e074733b842df96b9dc1d"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for downloading and caching model files r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339598\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_download.js"], "git_node": "10e477c70fc2b7352a4a76b61b4c3596b1b7adde", "git_parents": ["ab13ded18b81d5c56f8a0a2e5676f8e583e72832"], "node": "ccb5b7d565816a1cddcd6f4e97839605619f31d4", "parents": ["dc555196194c26f1e17257190c3148b17f9b9361"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for engine downloads through the model hub r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339599\n", "files": ["toolkit/components/ml/tests/MLTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_engine_e2e.js", "toolkit/components/ml/tests/browser/ml_model_hub_echo_stub.worker.mjs"], "git_node": "fc51f10f239a11393fdd9da9db7d5ee0e163bdf2", "git_parents": ["10e477c70fc2b7352a4a76b61b4c3596b1b7adde"], "node": "24ece3a12fe559966c21e7e8e4f166de6835a10a", "parents": ["ccb5b7d565816a1cddcd6f4e97839605619f31d4"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for failed and retried downloads r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339600\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_download_failures.js"], "git_node": "c51ff8d659f7aaa9ae556fb564f9ada3f53efec6", "git_parents": ["fc51f10f239a11393fdd9da9db7d5ee0e163bdf2"], "node": "03f1c26b8fa853be106327383d0a41d654b46d30", "parents": ["24ece3a12fe559966c21e7e8e4f166de6835a10a"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for ETag revalidation r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339601\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_etag.js"], "git_node": "3eca3fe64897a0c43bbea4324af8bf58aad5607f", "git_parents": ["c51ff8d659f7aaa9ae556fb564f9ada3f53efec6"], "node": "bff6e0df80bacfc1716de92853e5ecb2f8c5467b", "parents": ["03f1c26b8fa853be106327383d0a41d654b46d30"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for deleting models r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339602\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_delete.js"], "git_node": "c6ee6e3155908bb56db69fb31a108230e3d7f099", "git_parents": ["3eca3fe64897a0c43bbea4324af8bf58aad5607f"], "node": "bf405cf9badec704d0c05c52cbc1f119d76f0156", "parents": ["bff6e0df80bacfc1716de92853e5ecb2f8c5467b"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for the model hub denylist and listing r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339603\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_denylist.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_list.js"], "git_node": "13522acf270ff83a79d344f499fd0fd644161302", "git_parents": ["c6ee6e3155908bb56db69fb31a108230e3d7f099"], "node": "ef5cf32683008a4044df1d159f5769a2b85d4b5d", "parents": ["bf405cf9badec704d0c05c52cbc1f119d76f0156"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Restore MOZ_ALLOW_EXTERNAL_ML_HUB after the tests that set it r=nordzilla,ai-platform-reviewers\n\nbrowser_ml_engine_e2e.js and browser_ml_telemetry.js set the variable and never\nput it back. It is process-wide and makes ModelHub's constructor leave\nallowDenyList null, so every ModelHub built after those files ran skipped the\nallow/deny list entirely. browser_ml_model_hub_denylist.js runs later in\nbrowser.toml and so failed every one of its assertions in a full suite run\nwhile passing on its own.\n\nbrowser_ml_cache.js already restored it; the other two now do the same, and the\ndenylist test asserts the variable is unset so a future leak fails where it can\nbe diagnosed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339604\n", "files": ["toolkit/components/ml/tests/browser/browser_ml_engine_e2e.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_denylist.js", "toolkit/components/ml/tests/browser/browser_ml_telemetry.js"], "git_node": "74b088ce3195f5cedc3c386947cb35e18f0b8bf9", "git_parents": ["13522acf270ff83a79d344f499fd0fd644161302"], "node": "926cd031d6ad4a798997f57afe48b45b0e569c22", "parents": ["ef5cf32683008a4044df1d159f5769a2b85d4b5d"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Delete browser_ml_cache.js now that the model hub tests cover it r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339605\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_cache.js", "toolkit/components/ml/tests/browser/shared-head.js"], "git_node": "0b4386e2b9ae8edde1b15bf776acd9c02c33574b", "git_parents": ["74b088ce3195f5cedc3c386947cb35e18f0b8bf9"], "node": "c2f8781483b09bdb412297a13ff2a03e0c6e6f61", "parents": ["926cd031d6ad4a798997f57afe48b45b0e569c22"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Remove unused getModelFileAsResponse r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339606\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs"], "git_node": "bf46acad8a28980ffdfcadab0f3e5a641be6cbb3", "git_parents": ["0b4386e2b9ae8edde1b15bf776acd9c02c33574b"], "node": "983846904ba4318634d8d77f4b44c2e954e3d0d1", "parents": ["c2f8781483b09bdb412297a13ff2a03e0c6e6f61"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Fix denied models not being purged from the cache r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339607\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_model_hub_denylist.js"], "git_node": "f1685cabc5c51de14ee9dd4d22901d427c8cc2e6", "git_parents": ["bf46acad8a28980ffdfcadab0f3e5a641be6cbb3"], "node": "b0e6328af057239ea18ca3d502e8f917e3598611", "parents": ["983846904ba4318634d8d77f4b44c2e954e3d0d1"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Fix fileExists treating a pending headers lookup as present r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339608\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_model_hub_download_failures.js"], "git_node": "a2d537c73a0f4a4495bbface3bf597b5aac097a2", "git_parents": ["f1685cabc5c51de14ee9dd4d22901d427c8cc2e6"], "node": "0cadc004d0429602b7b91652c09483c09432e836", "parents": ["b0e6328af057239ea18ca3d502e8f917e3598611"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Fix a failed download leaving a zero-length OPFS entry behind r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339609\n", "files": ["toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_model_hub_download_failures.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_etag.js"], "git_node": "002a869e445f56ea2f03ff6854bae1cf63062472", "git_parents": ["a2d537c73a0f4a4495bbface3bf597b5aac097a2"], "node": "e9f469cf1d171a6a715dbb25b110df559d09d35b", "parents": ["0cadc004d0429602b7b91652c09483c09432e836"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Fix listFiles reporting the wrong engines for each file r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339610\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_model_hub_list.js"], "git_node": "d19e20c19918a21769c34d8244b16200ef5d1ec3", "git_parents": ["002a869e445f56ea2f03ff6854bae1cf63062472"], "node": "97fdb0ea9a1241dd29be9123bb9dfd492d47b0d9", "parents": ["e9f469cf1d171a6a715dbb25b110df559d09d35b"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Fix listModels reporting only one of several tasks sharing a model r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339611\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_model_hub_delete.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_list.js"], "git_node": "31a4e0dd107b6316d380e3d0af6d6a7a4e40f039", "git_parents": ["d19e20c19918a21769c34d8244b16200ef5d1ec3"], "node": "0638a050ec4b0bfa7b24e396efa485734b8ba279", "parents": ["97fdb0ea9a1241dd29be9123bb9dfd492d47b0d9"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Fix simultaneous reads downloading the same model file twice r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339612\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/content/Utils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_model_hub_download.js"], "git_node": "7a23b4b9c2ad17a2f7bbf2be7edae5afe5ff3ca8", "git_parents": ["31a4e0dd107b6316d380e3d0af6d6a7a4e40f039"], "node": "9b0e73ffca779c831dae1b3b58d59a32ce8e5d5e", "parents": ["0638a050ec4b0bfa7b24e396efa485734b8ba279"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Fix deleted models leaving empty directories behind r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339613\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_model_hub_delete.js"], "git_node": "bbf35838702e6492f4ac6fbc7d140e44c4f48055", "git_parents": ["7a23b4b9c2ad17a2f7bbf2be7edae5afe5ff3ca8"], "node": "15fe9c8749ba91e6c7405b9f8b2544ccfddf6e7e", "parents": ["9b0e73ffca779c831dae1b3b58d59a32ce8e5d5e"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Repair stale entries from previous correctness bugs r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339614\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_migration.js"], "git_node": "c855859a101b840a822028a61f7c3503a4ffed2f", "git_parents": ["bbf35838702e6492f4ac6fbc7d140e44c4f48055"], "node": "6b73d3bad51184d15434ee0a9100399a331eb83a", "parents": ["15fe9c8749ba91e6c7405b9f8b2544ccfddf6e7e"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add tests for parseUrl, getOwnerIcon, legacy migrations, and per-call hub overrides r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342358\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_model_hub_denylist.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_migration.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_owner_icon.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_url_parsing.js"], "git_node": "e6b27eb782e14349051985d0fbfa54d3afb953a5", "git_parents": ["c855859a101b840a822028a61f7c3503a4ffed2f"], "node": "f362871be838a91f43083f7bc18e3ef7edc9d91e", "parents": ["6b73d3bad51184d15434ee0a9100399a331eb83a"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Rename locally bound \"storage\" variables to fix the \"no-shadow\" lint error introduced by making \"storage\" a global; r=nordzilla,credential-management-reviewers,sessionstore-reviewers,omc-reviewers,thecount,joschmidt,sfoster,yazan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339978\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/ASRouterNewTabHook.sys.mjs", "browser/components/backup/resources/MiscDataBackupResource.sys.mjs", "browser/components/mozcachedohttp/actors/MozCachedOHTTPParent.sys.mjs", "browser/components/newtab/AboutHomeStartupCache.sys.mjs", "browser/components/sessionstore/TabStateCache.sys.mjs", "browser/extensions/formautofill/content/editDialog.mjs", "browser/extensions/formautofill/content/manageDialog.mjs", "dom/console/ConsoleAPIStorage.sys.mjs", "dom/fs/test/xpcshell/head.js", "toolkit/components/passwordmgr/test/unit/test_BreachAlertStore.js"], "git_node": "67933e25c815c9606176d599a7f79ae3852845d4", "git_parents": ["e6b27eb782e14349051985d0fbfa54d3afb953a5"], "node": "d7efe51abf82ee301f09962cb7e44afa5cb4753e", "parents": ["f362871be838a91f43083f7bc18e3ef7edc9d91e"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Resolve `storage` on the system global so OPFS does not need a window; asuth! r=nordzilla,frontend-codestyle-reviewers,asuth,smaug\n\nThis commit is patterned off of Bug 1910969. This change is required for\nthe ModelHub to not rely owning a Window object. There is a lifetime\nmismatch for the inference process outliving a file handle handed out\nby an arbitrary window.\n\nThe next commit fixes the lifetime mismatch in the Gecko AI Runtime.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339615\n", "files": ["js/xpconnect/src/Sandbox.cpp", "js/xpconnect/src/XPCJSRuntime.cpp", "js/xpconnect/src/XPCRuntimeService.cpp", "js/xpconnect/src/xpcprivate.h", "js/xpconnect/tests/unit/test_storage.js", "tools/@types/lib.gecko.tweaks.d.ts", "tools/lint/eslint/eslint-plugin-mozilla/lib/environments/privileged.mjs"], "git_node": "308c1c85315ca85ead71257fd8aeadc19dd36d0d", "git_parents": ["67933e25c815c9606176d599a7f79ae3852845d4"], "node": "46f6dba66390ab35ab6f9b42eb096f95be382982", "parents": ["d7efe51abf82ee301f09962cb7e44afa5cb4753e"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Make OPFS use the system global's `storage` instead of a window's r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339616\n", "files": ["toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_opfs_private_window.js"], "git_node": "a728f4cf7165f48a860ae8dec97012b4716fedfd", "git_parents": ["308c1c85315ca85ead71257fd8aeadc19dd36d0d"], "node": "33511054a87fa2c5a58fc16ed5a07171c18c472b", "parents": ["46f6dba66390ab35ab6f9b42eb096f95be382982"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049954: Enable canonicalize-NaN-at-uses pass by default r=jandem\n\nThis has gone through several rounds of LLM audit without finding any issues. I had Claude take one final pass just before submitting; its only suggestion was to add the missing parenthesis in the `addStringOption` help text.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343294\n", "files": ["js/src/jit-test/tests/canonical-nan/constant-evaluation-nan.js", "js/src/jit-test/tests/canonical-nan/div-exact-reciprocal.js", "js/src/jit-test/tests/canonical-nan/math-binary.js", "js/src/jit-test/tests/canonical-nan/math-fround.js", "js/src/jit-test/tests/canonical-nan/math-hypot.js", "js/src/jit-test/tests/canonical-nan/math-minmax.js", "js/src/jit-test/tests/canonical-nan/math-sign.js", "js/src/jit-test/tests/canonical-nan/math-unary.js", "js/src/jit-test/tests/canonical-nan/multiple-uses-in-single-block-with-constant-at-start.js", "js/src/jit-test/tests/canonical-nan/multiple-uses-in-single-block-with-use-at-start.js", "js/src/jit-test/tests/canonical-nan/nan-payload.js", "js/src/jit-test/tests/canonical-nan/phi.js", "js/src/jit-test/tests/canonical-nan/recover.js", "js/src/jit-test/tests/canonical-nan/scalar-replacement.js", "js/src/jit/JitOptions.cpp", "js/src/shell/js.cpp"], "git_node": "09e850454c3e97123c3fef7addcfed3cb0403da2", "git_parents": ["a728f4cf7165f48a860ae8dec97012b4716fedfd"], "node": "fbb34e578483c0e83b8bcff2ceffefdab837013a", "parents": ["33511054a87fa2c5a58fc16ed5a07171c18c472b"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085058 - Tell the Android layer when Guardian rejects an auth token r=ip-protection-reviewers,geckoview-reviewers,jonalmeida,apopov\n\nA Guardian 401 means the token itself was refused. Desktop already drops the FxA\ntoken in that case, but Android had no way to hear about it, so the stale token\nstayed cached in appservices and every later request re-presented it.\n\nAdd IPProtectionController.AuthProvider.onTokenRejected, dispatched from\nIPPAndroidAuthProvider as GeckoView:IPProtection:TokenRejected and awaited by\nGuardianClient, so the token is gone by the time the call to guardian resolves\nso we can retry with a new one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316981\n", "files": ["mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/IPProtectionControllerTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/IPProtectionController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "toolkit/components/ipprotection/GuardianTypes.sys.mjs", "toolkit/components/ipprotection/fxa/GuardianClient.sys.mjs", "toolkit/components/ipprotection/fxa/IPPAndroidAuthProvider.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_GuardianClient.js"], "git_node": "0106404b6fb0bf4405af82a472584b7fde8ef947", "git_parents": ["09e850454c3e97123c3fef7addcfed3cb0403da2"], "node": "cd7116d644e4413c5d8b6ef93520c28dc6d91817", "parents": ["fbb34e578483c0e83b8bcff2ceffefdab837013a"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082990 - Part 1: Abandon a utility process launch that does not complete in time. r=ipc-reviewers,nika\n\nUtilityProcessHost's launch promise only settled once the child reported\nthat its init completed, or once the channel closed. A launch that stalled\nin between was never detected, and everything waiting on that process\nwaited until shutdown. Abandon the launch after\ndom.ipc.utilityProcess.startup_timeout_ms: reject the launch promise, then\nreport it to the listener as an unexpected shutdown, which shuts the host\ndown. A child that has not connected yet has no channel to be asked to shut\ndown over, so it is terminated once its host goes away. The timer is\ncancelled once the launch promise settles.\n\nThe 10 s default leaves room for slow machines: process launches reach about\n5 s at the 99.9th percentile (bug 1994984), and this timeout also covers the\nchild's init.\n\nLaunch failures are now an expected outcome, so the asserts claiming they\ncan't happen in StartPKCS11Module, CreateWinFileDialogActor and\nUtilityProcessTest are removed.\n\nBased on padenot's D323643.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337292\n", "files": ["ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessHost.h", "ipc/glue/UtilityProcessManager.cpp", "ipc/glue/test/utility_process_xpcom/UtilityProcessTest.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "f058fdc2abaf03ec658c0d2332dc7342422b604a", "git_parents": ["0106404b6fb0bf4405af82a472584b7fde8ef947"], "node": "350e1ba2894db9b0b1f4d6764bae6aea10b841c5", "parents": ["cd7116d644e4413c5d8b6ef93520c28dc6d91817"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082990 - Part 2: Test abandoned utility process launches and launch timeouts. r=ipc-reviewers,nika\n\nAn abandoned launch must reject, leave no process behind, and let the next\nlaunch succeed. Cover this with one timeout that normally fires before the\nchild connects, and one that normally fires after. A testing pref makes the\nchild skip SendInitCompleted(), so a launch stays connected but never\ncompletes, however its timeout is scheduled.\n\nA launch that completes must also outlive its own timeout, and a launch that\nis shut down before its timeout fires must leave the next launch's process\nalone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337293\n", "files": ["ipc/glue/UtilityProcessChild.cpp", "ipc/glue/test/browser/browser.toml", "ipc/glue/test/browser/browser_utility_launch_timeout.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "118a6e050fd79996d923c331d9e408942ac7dd3c", "git_parents": ["f058fdc2abaf03ec658c0d2332dc7342422b604a"], "node": "39c841bc2af0344896bdf1fb87b74cd753c8864b", "parents": ["350e1ba2894db9b0b1f4d6764bae6aea10b841c5"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082990 - Part 3: Tell unbound utility actors when their launch fails. r=ipc-reviewers,win-reviewers,ai-platform-reviewers,gstoll,valentinp,nika\n\nA launch failure was only reported to whoever held the StartUtility()\npromise, so an actor waiting to be bound had no way to know it never would\nbe. UtilityProcessManager now calls BindToUtilityProcess(nullptr) on an\nactor that is still unbound when the launch fails, so every primary utility\nactor learns about it the same way.\n\nNo actor acts on the notification yet. HWInferenceParent starts to in\nbug 2069379, whose test covers this path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337296\n", "files": ["dom/ipc/JSOracleParent.cpp", "dom/system/windows/WindowsUtilsParent.h", "ipc/docs/utility_process.md", "ipc/glue/UtilityMediaServiceChild.cpp", "ipc/glue/UtilityProcessManager.cpp", "ipc/glue/UtilityProcessManager.h", "security/manager/ssl/PKCS11ModuleParent.cpp", "toolkit/components/ml/ipc/HWInferenceParent.cpp", "toolkit/components/ml/ipc/HWInferenceParent.h", "widget/windows/filedialog/WinFileDialogParent.cpp"], "git_node": "955a88d7c96de6ec6a57c59d1113b250e7c65c09", "git_parents": ["118a6e050fd79996d923c331d9e408942ac7dd3c"], "node": "f29e7bd9f2e449dd5d70126d95db52a159e6b4bf", "parents": ["39c841bc2af0344896bdf1fb87b74cd753c8864b"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069379 - Part 1: Fix SpeechRecognition.start() hanging when the HWInference process does not come up. r=ai-platform-reviewers,valentinp\n\nstart() waits on HWInferenceParent::mReadyPromise, which was only resolved\nby BindToUtilityProcess and only rejected by ActorDestroy. Neither ran on an\nactor whose launch failed, so start() fired neither \"start\" nor \"error\".\nReject the promise when the launch failure is reported.\n\nA failed launch now also counts against the restart budget, as a crash does,\nso a process that never comes up is not relaunched on every start(). A\nlaunch that every consumer let go of was cancelled, and is not counted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337297\n", "files": ["toolkit/components/ml/ipc/HWInferenceParent.cpp", "toolkit/components/ml/ipc/HWInferenceProcess.cpp", "toolkit/components/ml/ipc/HWInferenceProcess.h"], "git_node": "aac4e21e8e93d483d659da397e30b794073461aa", "git_parents": ["955a88d7c96de6ec6a57c59d1113b250e7c65c09"], "node": "1a6da54ec09ace36fb21510b931196668ff20f3d", "parents": ["f29e7bd9f2e449dd5d70126d95db52a159e6b4bf"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069379 - Part 2: Test that SpeechRecognition.start() fails, then recovers, after an abandoned HWInference launch. r=padenot,ai-platform-reviewers,media-webspeech-reviewers,valentinp\n\nAlso test that an abandoned launch spends the restart budget, even when the\nnext acquire comes before the failure is reported, and that a launch every\nconsumer let go of does not.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337298\n", "files": ["dom/media/webspeech/recognition/test/browser_speech_recognition_process_lifetime.js", "toolkit/components/ml/tests/gtest/TestHWInferenceProcess.cpp"], "git_node": "3355e8e3ef576859d9794745e8f9ddfc6f710007", "git_parents": ["aac4e21e8e93d483d659da397e30b794073461aa"], "node": "caa5bc1ee11aedf75e412669ed3c499bbf529e07", "parents": ["1a6da54ec09ace36fb21510b931196668ff20f3d"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071888 - Add nsIUrlClassifierRealTimeKeyService that fetches the OHTTP key config for the SafeBrowsing V5 real-time mode. r=dimi\n\nThis patch implements nsIUrlClassifierRealTimeKeyService to fetch the\nOHTTP key config from the safebrowsing-v5-rt-key Remote Settings\ncollection. The service loads the record on the first getKeyConfig()\ncall, retries on later calls until a key is loaded, and keeps it up to\ndate on sync. When a sync changes the key config, the service notifies\nthe \"safebrowsing-realtime-key-changed\" topic so consumers that cache\nthe key can fetch it again. getKeyConfig() resolves to null if the\nrecord is missing, or if its key_id doesn't match the first byte of the\ndecoded key config.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339185\n", "files": ["toolkit/components/url-classifier/UrlClassifierRealTimeKeyService.sys.mjs", "toolkit/components/url-classifier/components.conf", "toolkit/components/url-classifier/moz.build", "toolkit/components/url-classifier/nsIUrlClassifierRealTimeKeyService.idl", "toolkit/components/url-classifier/tests/unit/test_realtime_key_service.js", "toolkit/components/url-classifier/tests/unit/xpcshell.toml"], "git_node": "b10b454246088cd65aaac1731ed43631f7c84b80", "git_parents": ["3355e8e3ef576859d9794745e8f9ddfc6f710007"], "node": "787bb291890a21c2bc24160dc113c8f0588da473", "parents": ["caa5bc1ee11aedf75e412669ed3c499bbf529e07"], "tags": []}, {"author": "Heitor Neiva \u003chneiva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093780 - Increase partner repack runtime limit r=releng-reviewers,bhearsum,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343346\n", "files": ["taskcluster/kinds/release-partner-repack/kind.yml"], "git_node": "d389b9c2bd18c0828d7818a40ab2a2c6219ad04d", "git_parents": ["b10b454246088cd65aaac1731ed43631f7c84b80"], "node": "66921b52952aa0e07fa86eed597c4b30b626b8b0", "parents": ["787bb291890a21c2bc24160dc113c8f0588da473"], "tags": []}, {"author": "Heitor Neiva \u003chneiva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093780 - Use gzip level 3 for macOS partner repacks r=releng-reviewers,jcristau\n\n`gzip -3` looks like a good tradeoff: roughly half the compression time for ~5% larger files (about 5~10mb per tarball)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343649\n", "files": ["python/mozrelease/mozrelease/partner_repack.py"], "git_node": "8c1fe5cd50ccc35bc5c998a3e57d01db2ebc2131", "git_parents": ["d389b9c2bd18c0828d7818a40ab2a2c6219ad04d"], "node": "e1f0acabf3ff04100cf5737224ea03ff695f8b74", "parents": ["66921b52952aa0e07fa86eed597c4b30b626b8b0"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 1: Prepare GtkCompositorWidget to handle process endpoints. r=gfx-reviewers,ahale\n\nThis lays the groundwork for the Wayland compositor to be created on the\ngpu process, but does not actually do so. The parent process still sends an\nempty NativeLayerRemote endpoint.\n\nGtkCompositorWidget is also the base of the GPU process\nCompositorWidgetParent, so the PlatformCompositorWidgetDelegate role moves to\nInProcessGtkCompositorWidget.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256673\n", "files": ["gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorBridgeParent.h", "widget/gtk/CompositorWidgetChild.cpp", "widget/gtk/CompositorWidgetChild.h", "widget/gtk/CompositorWidgetParent.cpp", "widget/gtk/GtkCompositorWidget.cpp", "widget/gtk/GtkCompositorWidget.h", "widget/gtk/InProcessGtkCompositorWidget.h", "widget/gtk/PlatformWidgetTypes.ipdlh", "widget/gtk/nsWindow.cpp"], "git_node": "14b2e769dbec64b254d3f9f3b309965a2f3e3949", "git_parents": ["8c1fe5cd50ccc35bc5c998a3e57d01db2ebc2131"], "node": "922eb01ae362dc6fb040fc66119251392684327b", "parents": ["e1f0acabf3ff04100cf5737224ea03ff695f8b74"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 2: Hoist CreateLayerForSurfacePresentation into NativeLayerRoot. r=gfx-reviewers,ahale\n\nThis is being done in anticipation of using the surface presentation\napproach in NativeLayerRootWayland, which is the next part of\nthis patch series.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287219\n", "files": ["gfx/layers/NativeLayer.h", "gfx/layers/NativeLayerCA.h", "gfx/layers/NativeLayerCA.mm", "gfx/layers/NativeLayerRootRemoteMacParent.mm", "gfx/tests/gtest/TestNativeLayerCA.mm"], "git_node": "4d7f953738bc7f9b487aabb23cc3957c3466b26e", "git_parents": ["14b2e769dbec64b254d3f9f3b309965a2f3e3949"], "node": "d47d8bf34c81c008bae00fd3b0bb79e567974de4", "parents": ["922eb01ae362dc6fb040fc66119251392684327b"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 3: Create NativeLayerWaylandPresentation for surface presentation. r=gfx-reviewers,ahale\n\nNativeLayerWaylandPresentation lives in the parent process and receives\nsurfaces from the gpu process. The parent process may have no GL context,\nso DMABufSurface::FenceWait() now waits for the fence on the CPU in that\ncase. NativeLayerWayland::SetDisplayRect() lets the presented layer take\nthe display rect from the gpu process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D287249\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/NativeLayerWayland.h", "widget/gtk/DMABufSurface.cpp"], "git_node": "575ff12a1066909a677c5293d3bc0e9ae67e5544", "git_parents": ["4d7f953738bc7f9b487aabb23cc3957c3466b26e"], "node": "6f91288c3b4dcf2f6eb24b3ad5c16a7003fc7d02", "parents": ["d47d8bf34c81c008bae00fd3b0bb79e567974de4"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 4: Add a SurfaceTransferWayland struct to NativeLayerRemote protocol. r=gfx-reviewers,ahale\n\nThis makes the protocol generalizable to other platforms, in this case\nWayland.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325982\n", "files": ["gfx/layers/ipc/PNativeLayerRemote.ipdl"], "git_node": "c9c7300adf329e75526f7c4f03e3324eeaefe7b6", "git_parents": ["575ff12a1066909a677c5293d3bc0e9ae67e5544"], "node": "92719d1ee6f84e2de2cb96ce8f653a4ac9d3b715", "parents": ["6f91288c3b4dcf2f6eb24b3ad5c16a7003fc7d02"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 5: Create NativeLayerRemoteWayland for use in the gpu process. r=gfx-reviewers,ahale\n\nThe NativeLayerRemoteWayland class is used for all types of NativeLayers\non the gpu process. There are 3 cases:\n\n1) Tiles, like would normally be NativeLayerWaylandRender on the parent\nprocess. This uses a constructor that takes a SurfacePoolHandleWayland,\nwhich it uses to create the NativeLayerWaylandSurfaceHandler.\n2) Color, which has no mSurfaceHandler.\n3) External Surfaces (video) which has no mSurfaceHandler. The\nimplementation of ::AttachExternalImage is completed in Part 10.\n\nFor the first case, tiles, the surface global ref count increment in\n::FlushDirtyLayerInfoToCommandQueue is balanced by a decrement in\n::HandleChangedSurface in Part 8.\n\nMuch of the remaining implementation of the NativeLayer methods is\nhandled similarly to NativeLayerWaylandRender.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317223\n", "files": ["gfx/layers/NativeLayer.h", "gfx/layers/NativeLayerRemoteWayland.cpp", "gfx/layers/NativeLayerRemoteWayland.h", "gfx/layers/NativeLayerWaylandSurfaceHandler.h", "gfx/layers/moz.build"], "git_node": "e9a23ffcccb002f2a0989b359001f10dd46a7626", "git_parents": ["c9c7300adf329e75526f7c4f03e3324eeaefe7b6"], "node": "d5aef18f7003d92ddef24ca968dc044ef02d64e0", "parents": ["92719d1ee6f84e2de2cb96ce8f653a4ac9d3b715"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 6: Define the NativeLayerRootRemoteWayland parent and child to send layers from gpu to parent. r=gfx-reviewers,ahale\n\nThe actors/peers are not actually created yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314799\n", "files": ["gfx/layers/NativeLayerRootRemoteWaylandChild.cpp", "gfx/layers/NativeLayerRootRemoteWaylandChild.h", "gfx/layers/NativeLayerRootRemoteWaylandParent.cpp", "gfx/layers/NativeLayerRootRemoteWaylandParent.h", "gfx/layers/moz.build"], "git_node": "29dae6cf99d74112ffb4587541f965b983a5b353", "git_parents": ["e9a23ffcccb002f2a0989b359001f10dd46a7626"], "node": "4103af70ffa2dcea94005ab9e5970c73e3dcac57", "parents": ["d5aef18f7003d92ddef24ca968dc044ef02d64e0"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 7: Create the NativeLayerRemote peers. r=gfx-reviewers,ahale\n\nThis is modeled after the approach on macOS, and mostly works the same.\nOne difference is that the \"real\" NativeLayerRootWayland is held in the\nnsWindow as a member, in addition to being passed as a param to the\nNativeLayerRootRemoteWaylandParent constructor. This is because the real\nroot has a ::Shutdown method that must be called on the main thread, and\nthe remote parent has to be closed on the compositor thread, and it's\neasier to sequence those calls from the nsWindow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315756\n", "files": ["widget/gtk/GtkCompositorWidget.cpp", "widget/gtk/GtkCompositorWidget.h", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h"], "git_node": "a2d160cd52495da596bf964b8de241140c112020", "git_parents": ["29dae6cf99d74112ffb4587541f965b983a5b353"], "node": "014b5490e00b245ee7f140b4c68ab728c4461289", "parents": ["4103af70ffa2dcea94005ab9e5970c73e3dcac57"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 8: Present surfaces from the GPU process in NativeLayerRootRemoteWaylandParent. r=gfx-reviewers,ahale\n\nThe parent process imports each DMABuf surface and attaches it to its\nNativeLayerWaylandPresentation. Importing releases the reference the GPU\nprocess took while the surface was in flight; the imported surface keeps\nits own reference until the Wayland compositor releases the buffer, which\nis how the GPU process knows the buffer can be reused.\n\nExternal image layers are presented the same way, since they are also\nrendered in the GPU process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332601\n", "files": ["gfx/layers/NativeLayerRootRemoteWaylandParent.cpp"], "git_node": "3ed42ddda238c46d0d891b15d920bfdb6aec57ec", "git_parents": ["a2d160cd52495da596bf964b8de241140c112020"], "node": "34878f98c93d736c5d780edca0c585881cdec529", "parents": ["014b5490e00b245ee7f140b4c68ab728c4461289"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 9: Prevent the GPU process from connecting to the Wayland display. r=gfx-reviewers,ahale\n\nThis is similar to how the RDD process is handled on Wayland. The GPU\nprocess renders into DMABuf surfaces which the parent process presents,\nso it doesn't need a display connection. Without a GDK display, EGL uses\nthe DRM device or surfaceless platform. Those platforms have no window\nsurfaces, so this change ensures that WebRender doesn't ask for one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334368\n", "files": ["gfx/gl/GLContextProviderEGL.cpp", "gfx/ipc/GPUParent.cpp"], "git_node": "50126b79e86d6278e8605bf2e7754efb1da7d5ee", "git_parents": ["3ed42ddda238c46d0d891b15d920bfdb6aec57ec"], "node": "5cc631cbb9979a95a91f94676cbf99077c995c71", "parents": ["34878f98c93d736c5d780edca0c585881cdec529"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 10: Make NativeLayerRemoteWayland handle external images. r=gfx-reviewers,ahale\n\nExternal images, such as video frames, are sent to the parent process as\nDMABuf surfaces same as the rendered layers. SHM surfaces are uploaded to\nDMABuf surfaces in the GPU process.\n\nThis does not handle HLG to PQ conversion for compositors that lack HLG\nsupport. Doing this correctly will be the focus of a follow-up Bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334369\n", "files": ["gfx/layers/NativeLayerRemoteWayland.cpp", "gfx/layers/NativeLayerRemoteWayland.h"], "git_node": "054629418c331fc70e11b527ef9cb90e683ad6e0", "git_parents": ["50126b79e86d6278e8605bf2e7754efb1da7d5ee"], "node": "ea7cc4114016f15f495e0aa85b5fe414869f2418", "parents": ["5cc631cbb9979a95a91f94676cbf99077c995c71"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 11: Allow GPU process on Wayland. r=gfx-reviewers,ahale\n\nThe only purpose of the overridden ::InitPlatformGPUProcessPrefs() was\nto disable the gpu process on Wayland. We don't need that anymore, so we\nremove the entire override.\n\nSince the gpu process only works when the native compositor is in use,\nthere are two cleanups:\n1) The gfxInfo blocklist changes. When the Wayland gpu process is\nrequested, blocklist entries for the native compositor are ignored.\n2) Later, in the check in gfxPlatformGtk, if the native compositor is\nnot available, the gpu process is disabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334370\n", "files": ["gfx/thebes/gfxPlatformGtk.cpp", "gfx/thebes/gfxPlatformGtk.h", "widget/gtk/GfxInfo.cpp"], "git_node": "44d954cf200feb54331605a85a8169945a9d9741", "git_parents": ["054629418c331fc70e11b527ef9cb90e683ad6e0"], "node": "a2d422d90582fd5ac1a371479fd250274cf4c2bd", "parents": ["ea7cc4114016f15f495e0aa85b5fe414869f2418"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 12: Allow CompositorWidgetVsyncObserver to be notified on the main thread on Wayland. r=ahale\n\nOn Wayland, each window has its own WaylandVsyncSource that is driven by\nframe callbacks and emulated vsync timers on the GTK main loop, so vsync\nnotifications arrive on the parent process main thread. Relax the\nassertion on Wayland to make this work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335846\n", "files": ["gfx/ipc/CompositorWidgetVsyncObserver.cpp"], "git_node": "398f79ae4dffcc5db3c743d6fae06912c506ef26", "git_parents": ["44d954cf200feb54331605a85a8169945a9d9741"], "node": "f292136c988eac9ac41f6b2fd374752f4393b310", "parents": ["a2d422d90582fd5ac1a371479fd250274cf4c2bd"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 13: Render software WebRender layers into mappable DMABuf surfaces in the GPU process. r=gtk-reviewers,stransky,gfx-reviewers,ahale\n\nWidgets that don't support acceleration, such as small popups, use\nsoftware WebRender with the native compositor. In the GPU process their\nlayers were backed by SHM surfaces, which require a Wayland display to\ncreate and which the parent process can't present.\n\nThis allocates linear GBM DMABuf surfaces for these layers instead, and\nadds DMABufSurfaceRGBA::Lock() so SWGL can render into them through a\nCPU mapping. The surface is unmapped when the DrawTarget is destroyed.\n\nnsWindow::WidgetTypeSupportsNativeCompositing() now returns true for every\nwidget when compositing happens in the GPU process, so small popups and drag\npopups use the native compositor instead of falling back to a window surface\nthe GPU process can't create.\n\nThis approach may be slow on discrete GPUs, which might be improved by\nswitching to udmabuf.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335847\n", "files": ["gfx/layers/NativeLayerWaylandSurfaceHandler.cpp", "gfx/layers/SurfacePoolWayland.cpp", "widget/gtk/DMABufSurface.cpp", "widget/gtk/DMABufSurface.h", "widget/gtk/WaylandBuffer.cpp", "widget/gtk/WaylandBuffer.h", "widget/gtk/nsWindow.cpp"], "git_node": "dc97529f480272228eabb6012c67a9e00859b012", "git_parents": ["398f79ae4dffcc5db3c743d6fae06912c506ef26"], "node": "077b553c44baf9ac4be80077166490a1b461dfdf", "parents": ["f292136c988eac9ac41f6b2fd374752f4393b310"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732951 Part 14: Fixup NativeLayerRootWayland vsync callback in ::Shutdown(). r=gfx-reviewers,ahale\n\nShutdown() cleared the map, unmap, commit and DMABuf callbacks but left the\nVSync state handler registered, and child layers could still deliver frame\ncallbacks. This clears the remaining handlers on ::Shutdown() and makes\nVSyncCallbackHandler() bail out when the root surface is gone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343205\n", "files": ["gfx/layers/NativeLayerWayland.cpp"], "git_node": "413fd3d35b03c0649fdfc84dfa7c6d5e744c22be", "git_parents": ["dc97529f480272228eabb6012c67a9e00859b012"], "node": "a9fb1194a75a5a9ab8f27fdf4d7a7feff59b6a54", "parents": ["077b553c44baf9ac4be80077166490a1b461dfdf"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090117 - Only let first-line re-parenting change first-line-allowed properties. r=firefox-style-system-reviewers,layout-reviewers,jwatt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343518\n", "files": ["servo/components/style/properties/cascade.rs", "servo/components/style/properties/properties.mako.rs"], "git_node": "dd74255b5b4005f7f1fb2010a94a4496797fabd0", "git_parents": ["413fd3d35b03c0649fdfc84dfa7c6d5e744c22be"], "node": "c6b9b0c4f2df2aaf3a6d61013f6a15d0ffda2fb4", "parents": ["a9fb1194a75a5a9ab8f27fdf4d7a7feff59b6a54"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080313 - Move POTD and framed widgets off TemporaryMerinoClientShim. r=mconley\n\nBoth feeds now use `NewTabMerinoWrapper`, a `MerinoClient` subclass that provides `fetchPictureOfTheDay` and `fetchFramedWidgets` until those methods move into `MerinoClient`. Nothing else uses the shim, so it\u2019s removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339637\n", "files": ["browser/extensions/newtab/lib/NewTabMerinoWrapper.sys.mjs", "browser/extensions/newtab/lib/TemporaryMerinoClientShim.sys.mjs", "browser/extensions/newtab/lib/Widgets/FramedWidgetsFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/PictureOfTheDayFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_FramedWidgetsFeed.js", "browser/extensions/newtab/test/xpcshell/test_PictureOfTheDayFeed.js", "browser/extensions/newtab/test/xpcshell/test_WeatherFeed.js"], "git_node": "7007c87f4d0c31b87dd40243dc74d22b6ecd454f", "git_parents": ["dd74255b5b4005f7f1fb2010a94a4496797fabd0"], "node": "7a45191ac619c62e106ae68530d3859aecb1d403", "parents": ["c6b9b0c4f2df2aaf3a6d61013f6a15d0ffda2fb4"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2089358 - Update the audio configuration check in decoder creation. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339792\n", "files": ["dom/media/platforms/PDMFactory.cpp"], "git_node": "5483aee701e02cab0d2abd9dfbcaab3cbc119b20", "git_parents": ["7007c87f4d0c31b87dd40243dc74d22b6ecd454f"], "node": "7aef4f2ac81225d127d0684f6007a98f676bfcb3", "parents": ["7a45191ac619c62e106ae68530d3859aecb1d403"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2089358 - Add a gtest for decoder creation with audio configurations. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339793\n", "files": ["dom/media/gtest/TestMediaDataDecoder.cpp"], "git_node": "79c51587f352fb592931bde830d88350a3453571", "git_parents": ["5483aee701e02cab0d2abd9dfbcaab3cbc119b20"], "node": "7ff4234c5150f848601903fb773c6cdc23105199", "parents": ["7aef4f2ac81225d127d0684f6007a98f676bfcb3"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093884 - Rebuild the text run when an empty text frame takes the bidi levels of the next text. r=emilio\n\nWith text-wrap: balance, an empty text frame can take the text of the next\nparagraph. Bug 1558431 made this frame copy the bidi levels of the frame that\ngives it the text. But the two frames can share one text run, and that text run\nwas built with the old levels of the empty frame. Gecko then drew the text with\nthe old direction.\n\nFor example, a balanced block with unicode-bidi: plaintext and\nwhite-space: pre-line holds a span with \"Hello!\", a newline and the Hebrew word\n\"shalom\" with \"!\". The Hebrew line started at the correct edge, but its letters\nwere drawn in left-to-right order.\n\nNow, when the copied embedding level is different from the old one, Gecko\nclears the text runs of both frames, so that it builds them again with the new\nlevel. Text runs depend only on the embedding level, so a change of the base\nlevel alone does not clear them.\n\nWebVTT needs this fix, because bug 2060917 gives each cue box\ntext-wrap: balance and unicode-bidi: plaintext [1].\n\nThe new test has two cases. The case with the right-to-left paragraph second\nfails without this fix and passes with it. The opposite order is correct\nwithout the fix, and it checks that the fix does not change that direction.\n\n[1] https://w3c.github.io/webvtt/#applying-css-properties\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342858\n", "files": ["layout/generic/nsTextFrame.cpp", "testing/web-platform/tests/css/css-text/white-space/reference/text-wrap-balance-bidi-002-ref.html", "testing/web-platform/tests/css/css-text/white-space/text-wrap-balance-bidi-002.html"], "git_node": "1bcf617a8ba788d466c00ec1dfd25ab5c6ad96c9", "git_parents": ["79c51587f352fb592931bde830d88350a3453571"], "node": "c1b2e7d4090cbe48621296604ee396a9d88ff1c5", "parents": ["7ff4234c5150f848601903fb773c6cdc23105199"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1991212 - Make Vector ranges robust across storage reallocation. r=mfbt-reviewers,sergesanspaille,emilio\" for causing Gtest failures.\n\nThis reverts commit 299218f2fb8bc07feb793516fcf460a78c4edda4.\n", "files": ["mfbt/ArrayIterator.h", "mfbt/Vector.h", "mfbt/moz.build", "mfbt/tests/TestVector.cpp", "mfbt/tests/gtest/TestVectorRanges.cpp", "mfbt/tests/gtest/moz.build", "xpcom/ds/ArrayIterator.h", "xpcom/ds/moz.build"], "git_node": "f6fbf3a4af12df5002a055fad63beba25c6d1c18", "git_parents": ["1bcf617a8ba788d466c00ec1dfd25ab5c6ad96c9"], "node": "ffc0fee741b9f0fc84fe2b6d642195ca1443be52", "parents": ["c1b2e7d4090cbe48621296604ee396a9d88ff1c5"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2090117 - Only let first-line re-parenting change first-line-allowed properties. r=firefox-style-system-reviewers,layout-reviewers,jwatt\" for causing failures at 1231692-1.html.\n\nThis reverts commit dd74255b5b4005f7f1fb2010a94a4496797fabd0.\n", "files": ["servo/components/style/properties/cascade.rs", "servo/components/style/properties/properties.mako.rs"], "git_node": "cac2c0cf44beecb92c93119bd79e2408636f76d7", "git_parents": ["f6fbf3a4af12df5002a055fad63beba25c6d1c18"], "node": "8dc8a7e0642289c9782651295b5586e008cbc6c4", "parents": ["ffc0fee741b9f0fc84fe2b6d642195ca1443be52"], "tags": []}], "date": 1794955520, "git_changesets": ["9b6696ac6617e0b8f8df46a0b33fca7380fcb34e", "915e26f407365a00bf980a64ee4db37c40050bb6", "ae6d0a7fd9797c2c0186a7a1e2d5d0a497109d6d", "a0cde524c5d6c7ada9e09e6da05759c4aaaf8682", "f505d8a9809137a372d5debcae9ffeed4482bc49", "1fd39f1db9e26899e36bc2627d80478f0df4a814", "1c225b674f518f8cca0df7e1e2734d040636292b", "ebdfd8156ae3aa4705d822f0ac44d12a3da85bfc", "2f021d9e5fd3427348fda149f0f00a2c87f06b21", "34a70cd2cd3c4d0839d8ae521feab873988d886b", "8cc938ff101fbec297580b4a8394e2b5043cf346", "9c958ce493f6e0f5b9e81855962621249259928d", "ef0883bd4412a51e21fd2098ffdfa9d232d9fcac", "f7490971b183d7a9489ca0ca36f52e1164fd5d86", "1538a572fb5209052b1382fcb8d8b3b0f2d79bc0", "ea71900566b5d3e6fe6d7fe8b5746fa0f592d4d1", "2494e9b6cc28af9eaa661a22bad001f6a8897af4", "3d4b3b32dba0b8a97500d7316fb8a1e09ce09ed7", "67dbfe8946644e2d35a1ad727318fe083d4fed0b", "cd00b41dfb122470dac189758965d708a80eb731", "74e95614ebd83a28a1f871384f4ea74e970ec23c", "c90d460af5b93a0872c136ade9ec40b66accb6d9", "4dbebf0f857661c3003505afefe3d4af8e280597", "1f83e2106231ba2da104060530898a3859396489", "c25c92398dcbbc71dadecd3279f9e6e515716e89", "67da08eaab623fd157812cfd57ae7d5c2660456c", "00ab44958dee9548c5f2dedca9637129bde8ee6f", "550dd2008e6c50fc33d276e8a68fe227ee2036ba", "ce4e3ee159eb0ccfd1ea168ab527d92a4c507069", "299b184c1b2c500f6a8b9f5cbfaecc1de9f1ebf5", "fbd000f86de77545413a30ae95c7c3834bf40208", "f1c47d0a63001fe82d0fff98f1853a0744c40e7f", "581f83f4248fb8901c832ae768d808b29c9ab50c", "1a66761ebfc1fb7c577d22ac11a1ae1d1a1ff2be", "b819d558dbcb651c12c54c487b2d5eb26bdd4e1d", "fed0b3f8e9be4bafe83b26f4791c7d77f2b7c6