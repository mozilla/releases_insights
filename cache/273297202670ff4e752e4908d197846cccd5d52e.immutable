"01249a883eca58454c51a853fd628d6eb2eff08b"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2092915 - Implement CSS random-item() substitution function. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342944\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "servo/components/style/custom_properties.rs", "servo/components/style/parser.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/substitution/mod.rs", "servo/components/style/substitution/random_item.rs", "servo/components/style/values/mod.rs", "servo/components/style/values/specified/calc.rs", "servo/components/style/values/specified/mod.rs", "servo/components/style/values/specified/random.rs", "testing/web-platform/meta/css/__dir__.ini", "testing/web-platform/meta/css/css-values/random-in-container-query.tentative.html.ini", "testing/web-platform/meta/css/css-values/random-item-computed.html.ini", "testing/web-platform/meta/css/css-values/random-item-in-container-query.tentative.html.ini", "testing/web-platform/meta/css/css-values/random-item-in-keyframe.html.ini", "testing/web-platform/meta/css/css-values/random-item-nested.html.ini", "testing/web-platform/meta/css/css-values/random-item-serialize.html.ini", "testing/web-platform/meta/css/css-values/random-item-unresolvable-argument.html.ini", "testing/web-platform/meta/css/css-values/random-item-valid.html.ini", "testing/web-platform/meta/css/css-variables/variable-reference-name-substitution.html.ini", "testing/web-platform/tests/css/css-values/random-item-nested.html"], "git_node": "2b0ad18ca032a411ffe9f599d49f47aefa243373", "git_parents": ["ccb0d7ceefadd63886879ffd05c62d7920808afd"], "node": "96e436b082ce926d6c6cfefcdbcd8ba2612f7dcb", "parents": ["cf421117c7c6330a29aaca4afbfc6421ca3831dd"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033465 - Remove low value tp6 and tp6m sites. r=perftest-reviewers,sparky\n\nPhase 3 of the tp6 trim (bug 2033465 comment 4). Removes five pageload sites:\n\nRemoved from desktop tp6:\n- imgur\n\nRemoved from mobile tp6m:\n- cnn\n- google\n- microsoft-support\n- youtube-watch\n\nIn the last ~5 years of perf alerts, none of these was the only tp6 site\nto catch a regression that was then fixed, backed out for performance, or\naccepted with a stated cause. Where they alerted on a real regression,\nanother tp6 site alerted too.\n\nThe mobile recordings are all from 2021, cnn and youtube-watch replay a\nconsent wall, and google was recorded signed-in on an old device. The\nsearch results page type should be covered by the\ngoogle-search-restaurants test.\n\nDesktop goes from 19 to 18 sites, mobile from 23 to 19.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337983\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "taskcluster/kinds/browsertime/mobile.yml", "testing/perfdocs/generated/raptor-metrics.md", "testing/perfdocs/generated/raptor.md", "testing/performance/pageload_sites.json", "testing/raptor/browsertime/pageload_sites.json", "testing/raptor/raptor/perfdocs/config.yml", "testing/raptor/raptor/tests/tp6/desktop/browsertime-tp6.toml", "testing/raptor/raptor/tests/tp6/mobile/browsertime-tp6m.toml", "testing/raptor/raptor/tooltool-manifests/playback/mitm11-windows-firefox-imgur.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm6-android-fenix-cnn.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm6-android-fenix-microsoft-support.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm6-android-fenix-youtube-watch.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm6-g5-fenix-google.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm8-linux-firefox-imgur.manifest", "tools/tryselect/try_presets.yml"], "git_node": "b714f08f78103b4a9c76a7fb3ba723ab0a6acbb1", "git_parents": ["2b0ad18ca03