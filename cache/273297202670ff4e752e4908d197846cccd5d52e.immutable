3bec394a7a906a71353a36dbe14", "parents": ["88cd78f6be04f9950d97cce05e90aae3c5d4aaae"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Remove the dead JS standalone `check-%` forward from root `Makefile.in` r=firefox-build-system-reviewers,sylvestre\n\n`js/src/Makefile.in` defines no `check-*` target to forward to.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339815\n", "files": ["Makefile.in"], "git_node": "373654163c9d0c34a1eee3fee67c9681afbe7438", "git_parents": ["bbe8c6975a1488666e71f5f2c817264600efdd5c"], "node": "0d45caf1254962f9e1715c025b5167f9ac328176", "parents": ["66326173491213bec394a7a906a71353a36dbe14"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Remove the redundant `package-name.mk` include from root `Makefile.in` r=firefox-build-system-reviewers,sylvestre\n\n`moz-automation.mk` includes it earlier, so the second include does nothing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339816\n", "files": ["Makefile.in"], "git_node": "b1e1defe3f29e0f4a195f0165f36b15543d24ecd", "git_parents": ["373654163c9d0c34a1eee3fee67c9681afbe7438"], "node": "f9008aabf127f7af5f0b521d8afff477362c54ba", "parents": ["0d45caf1254962f9e1715c025b5167f9ac328176"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Remove the dead `EXPAND_LIBS_GEN` and `webidl_base` assignments r=firefox-build-system-reviewers,sylvestre\n\nNothing reads either variable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339817\n", "files": ["build/clang-plugin/tests/Makefile.in", "dom/bindings/Makefile.in"], "git_node": "ac75c4c5198d7a2dfcc4f4490b75e99d76fe9476", "git_parents": ["b1e1defe3f29e0f4a195f0165f36b15543d24ecd"], "node": "b8413aaa2684aa56c080c0bb037246da06fc17ba", "parents": ["f9008aabf127f7af5f0b521d8afff477362c54ba"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Remove the ineffective `COMPILE_PDB_FLAG` and the unused `CODFILE` from `rules.mk` r=firefox-build-system-reviewers,sylvestre\n\nclang-cl ignores `-Fd`, and nothing reads `CODFILE`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339818\n", "files": ["config/makefiles/debugmake.mk", "config/rules.mk"], "git_node": "4ab3906bbac2c20895cb707e28ca26fc0f7a04cf", "git_parents": ["ac75c4c5198d7a2dfcc4f4490b75e99d76fe9476"], "node": "47cab2898459567c990ebf883b816235ccb5dafe", "parents": ["b8413aaa2684aa56c080c0bb037246da06fc17ba"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Remove the mingw gcc shared library command from `toolchain.configure` r=firefox-build-system-reviewers,sylvestre\n\nConfigure rejects mingw gcc, so the branch never runs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339819\n", "files": ["build/moz.configure/toolchain.configure"], "git_node": "33b8175de96e7182aba209b610338e79b982f655", "git_parents": ["4ab3906bbac2c20895cb707e28ca26fc0f7a04cf"], "node": "4a6ee858cb3c810259486d7434e64ef811a6b2d8", "parents": ["47cab2898459567c990ebf883b816235ccb5dafe"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Remove the `config/export` prerequisite of `stdc++compat` and the clang plugin from `recurse.mk` r=firefox-build-system-reviewers,sylvestre\n\n`config/export` builds the system wrappers in the export tier. `stdc++compat`\nand the clang plugin build in the compile tier, which only starts once the\nexport tier has finished.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339820\n", "files": ["config/recurse.mk"], "git_node": "f013dd2ffa55ef39043a85c240bd7f066acc8bcb", "git_parents": ["33b8175de96e7182aba209b610338e79b982f655"], "node": "3003839b3d7f9979a21005e22a4a40288171879c", "parents": ["4a6ee858cb3c810259486d7434e64ef811a6b2d8"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Remove the stale `.cargo/config` cleanup from `recurse.mk` r=firefox-build-system-reviewers,sylvestre\n\n`.cargo/config` was renamed to `.cargo/config.toml` in bug 1888321, and every\nclobber since removes the objdir `.cargo` directory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339821\n", "files": ["config/recurse.mk"], "git_node": "e6bec3a72a8b28911f11edc8e194abdeaf18de2d", "git_parents": ["f013dd2ffa55ef39043a85c240bd7f066acc8bcb"], "node": "4e5d380b3d3bd1563e14271a7701cdc1aea2cfe9", "parents": ["3003839b3d7f9979a21005e22a4a40288171879c"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064944 Part 1: Make SurfacePoolWayland accept a nullable WaylandSurfaceLock. r=gfx-reviewers,ahale\n\nThis introduces an alternate method of buffer usage tracking, which is\nusable across processes. The alternate method uses DMABuf global ref\ncounting. Passing a null WaylandSurfaceLock indicates that this\nalternative method should be used. SurfacePoolWayland is changed to take\nnullable locks, and callsites are updated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337786\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/SurfacePoolWayland.cpp", "gfx/layers/SurfacePoolWayland.h"], "git_node": "66567a6d9dc06646c7eb8551e383b16059b10b0d", "git_parents": ["e6bec3a72a8b28911f11edc8e194abdeaf18de2d"], "node": "471f471e7966a1ecba67c518d0582d2a4efacfe9", "parents": ["4e5d380b3d3bd1563e14271a7701cdc1aea2cfe9"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064944 Part 2: Refactor NativeLayerWayland into a helper class for surface management. r=gfx-reviewers,ahale\n\nThe helper takes a nullable WaylandSurfaceLock, as SurfacePoolWayland\ndoes. A null lock is used to indicate that the buffers are presented by\nanother process, so their usage is tracked with the DMABuf global\nreference counter instead of Wayland buffer release events.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319968\n", "files": ["gfx/layers/NativeLayerWaylandSurfaceHandler.cpp", "gfx/layers/NativeLayerWaylandSurfaceHandler.h", "gfx/layers/moz.build"], "git_node": "f3eec537be51ce0c447ec80e3cd3247b8c509db8", "git_parents": ["66567a6d9dc06646c7eb8551e383b16059b10b0d"], "node": "045639145fe863b32325440c9fc50a281230fe75", "parents": ["471f471e7966a1ecba67c518d0582d2a4efacfe9"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064944 Part 3: Make NativeLayerWaylandRender use the surface helper class. r=gfx-reviewers,ahale\n\nThis completes the refactor of NativeLayerWayland. The surface helper\nclass will (in another Bug) be used in a subclass of NativeLayer that\nlives on the gpu process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319973\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/NativeLayerWayland.h"], "git_node": "9956d1d907b0394f50225d476b33122935b6f98f", "git_parents": ["f3eec537be51ce0c447ec80e3cd3247b8c509db8"], "node": "3425e5e6ce2d016e0e155447379b9c8ef73d022a", "parents": ["045639145fe863b32325440c9fc50a281230fe75"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089270 - Remove local harfbuzz patches no longer relevant. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339884\n", "files": ["gfx/harfbuzz/bug-2082025.patch", "gfx/harfbuzz/hb-scalar-cache-quantization.patch", "gfx/harfbuzz/moz.yaml", "gfx/harfbuzz/stch-advance-cache.patch"], "git_node": "349412434f738dc2dfc04250265d73afcc59d6ef", "git_parents": ["9956d1d907b0394f50225d476b33