d569f8fa363aac8deb51ec8551", "parents": ["a90e4ff86b07113d4092229a7001bc8f9b8f57d1"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083147 - Remove the Nova pref check from megalist.css. r=mtigley,credential-management-reviewers\n\nThis is cleanup for after browser.nova.enabled is locked to true (tentatively Firefox 161). It should not land before the lock, so users who had turned Nova off do not get a mix of Proton and Nova artwork.\n\nhttps://mozilla-hub.atlassian.net/browse/FIDEFE-9638\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337990\n", "files": ["toolkit/components/satchel/megalist/content/megalist.css"], "git_node": "fd377c715e03d585e07d546291b13c16a873bfb8", "git_parents": ["6451bdf589799711b03f80d95396726178925963"], "node": "fcb26ccb90f7a0e9b51cf441de182f76e3ae7cfa", "parents": ["ffc77713591af5d569f8fa363aac8deb51ec8551"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083509 - Remove the Nova pref check from formfill-anchor.svg. r=mtigley,credential-management-reviewers\n\nThis is cleanup for after browser.nova.enabled is locked to true (tentatively Firefox 161). It should not land before the lock, so users who had turned Nova off do not get a mix of Proton and Nova artwork.\n\nhttps://mozilla-hub.atlassian.net/browse/FIDEFE-9638\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337991\n", "files": ["browser/extensions/formautofill/content/formfill-anchor.svg"], "git_node": "067b8ce4ecd93d8444c2e5f6642ffdfa3b83cf84", "git_parents": ["fd377c715e03d585e07d546291b13c16a873bfb8"], "node": "4410808a04aad513fcb7cf9e078fa6f9cd075ce5", "parents": ["fcb26ccb90f7a0e9b51cf441de182f76e3ae7cfa"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083510 - Remove the Nova pref check from icon-credit-card-generic.svg. r=mtigley,credential-management-reviewers\n\nThis is cleanup for after browser.nova.enabled is locked to true (tentatively Firefox 161). It should not land before the lock, so users who had turned Nova off do not get a mix of Proton and Nova artwork.\n\nhttps://mozilla-hub.atlassian.net/browse/FIDEFE-9638\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337992\n", "files": ["browser/extensions/formautofill/content/icon-credit-card-generic.svg"], "git_node": "83d452ba82c59e3904ea083aa8022b21436538e6", "git_parents": ["067b8ce4ecd93d8444c2e5f6642ffdfa3b83cf84"], "node": "b7a095af2c2aa79f6b03141d949bf3d836fd1dd2", "parents": ["4410808a04aad513fcb7cf9e078fa6f9cd075ce5"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093423 - Show \"saved\" instead of \"\u2022\u2022\u2022\" for cards with a saved security code in settings. r=mtigley,fluent-reviewers,credential-management-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343678\n", "files": ["browser/extensions/formautofill/content/manageDialog.mjs", "browser/extensions/formautofill/test/browser/creditCard/browser_manageCreditCardsDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_paymentsList_cvv.js", "browser/locales/en-US/browser/preferences/preferences.ftl", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/locales/en-US/toolkit/payments/payments.ftl"], "git_node": "f460a4fbc99b4d76be6769f9d5282b2fe471509a", "git_parents": ["83d452ba82c59e3904ea083aa8022b21436538e6"], "node": "2aa051b9b0602625713d1fe52fd2fb856e2916b4", "parents": ["b7a095af2c2aa79f6b03141d949bf3d836fd1dd2"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087059 - Reuse a recent autocomplete delete reauthentication for 5 minutes in the same tab. r=mtigley,credential-management-reviewers\n\n`AutocompleteRemoveRecord` tracks the last authorized delete per record\ntype (`password`, `payment`) and tab, so a delete within 5 minutes of\nit skips the primary password / OS auth prompt, like about:logins. Each\nauthorized delete renews the window; a `TabSelect` clears it.\n\n`LoginManagerParent` passes `authExpirationTime()` to `requestReauth()`\ninstead of `null`, which always prompted.\n\n`FormAutofillParent` skips `verifyUserOSAuth()` and its\n`promptShownOsReauth` event while the window is valid.\n\nThe confirmation dialog still shows on every delete.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343717\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_secondary_action.js", "toolkit/components/formautofill/FormAutofillParent.sys.mjs", "toolkit/components/passwordmgr/LoginManagerParent.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_secondary_actions.js", "toolkit/components/satchel/AutocompleteRemoveRecord.sys.mjs"], "git_node": "52745e1535fc2c6d6fb6609d86c9a84b2f94eae3", "git_parents": ["f460a4fbc99b4d76be6769f9d5282b2fe471509a"], "node": "0fa5b6fabc2623b8ad7883a9ef2252969d11456b", "parents": ["2aa051b9b0602625713d1fe52fd2fb856e2916b4"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2092403. Add images to the PGO training corpus. r=firefox-build-system-reviewers,gfx-reviewers,sergesanspaille,aosmond,ahochheiden\n\nThe PGO training corpus decodes very few images, a handful of small PNGs and JPEGs mostly from Speedometer, so most image decoding code is profiled as cold. This adds a page that decodes a mix of common image types using images that are already in the tree: baseline and progressive JPEG, RGBA and palette PNG, static and animated GIF, lossy, lossless and animated WebP, still and animated AVIF, and lossy, lossless, recompressed and animated JPEG XL. Each image is decoded through an img displayed smaller than its size and through createImageBitmap. It adds about 1-2 seconds to profile generation.\n\nprofileserver.py copies the images into a temporary directory served at /images, so profile generation fails if one of them is moved or removed instead of silently training on less. The profile generation sparse checkout now includes them.\n\nWith a similar set of images, on an Apple Silicon Mac this made WebP decoding about 7-8% faster, AVIF about 2% faster and lossy JPEG XL about 3% faster. JPEG, PNG and GIF didn't change much. Lossless JPEG XL got about 4% slower on screenshot-like images. This looks like how PGO compiles jxl-rs's lossless decoding rather than the training content (I couldn't find a training mix that avoids it).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342443\n", "files": ["build/pgo/image_decoding.html", "build/pgo/index.html", "build/pgo/profileserver.py", "build/sparse-profiles/profile-generate"], "git_node": "718b8b442b1d1a5e48c60488ef252bacd4f2f4dd", "git_parents": ["52745e1535fc2c6d6fb6609d86c9a84b2f94eae3"], "node": "e619b459d5671b14bd4a3cadc3aea9b0ed905c63", "parents": ["0fa5b6fabc2623b8ad7883a9ef2252969d11456b"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071283 - Fix for signed out promo card in app menu ?nsharpley r=nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343265\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/test/browser-sync/browser_sync.js"], "git_node": "26990aaf2e7836781ee6e037caa39091da7ef145", "git_parents": ["718b8b442b1d1a5e48c60488ef252bacd4f2f4dd"], "node": "3f258defca9553538705d05a259e3a049f9f3e64", "parents": ["e619b459d5671b14bd4a3cadc3aea9b0ed905c63"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092741 - Resume mochitests after a session ends early with the tests that did not start, also when retrying failures, r=ahal.\n\nResuming skipped as many tests as had already started, so with --repeat it\ncould drop the rest of the manifest. The retry of failed tests had no resume\nat all: when a retried test ended the session, the failed tests after it were\nneither rerun nor reported. With --restart-after-failure, every failed test is\nnow retried, instead of stopping at the first one that fails again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341598\n", "files": ["testing/mochitest/runtests.py", "testing/mochitest/tests/python/files/browser_before_quit.js", "testing/mochitest/tests/python/files/browser_quit.js", "testing/mochitest/tests/python/files/test_before_quit.html", "testing/mochitest/tests/python/files/test_quit.html", "testing/mochitest/tests/python/test_mochitest_integration.py"], "git_node": "2a577d12204363dfad3d98b326c1048e80cfab0c", "git_parents": ["26990aaf2e7836781ee6e037caa39091da7ef145"], "node": "b3da2d7d9f187bb8098565e96c60493c13a3d3bb", "parents": ["3f258defca9553538705d05a259e3a049f9f3e64"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2093423 - Show \"saved\" instead of \"\u2022\u2022\u2022\" for cards with a saved security code in settings. r=mtigley,fluent-reviewers,credential-management-reviewers,bolsson\" for causing bc failures @browser_creditCard_primaryPassword.js.\n\nThis reverts commit f460a4fbc99b4d76be6769f9d5282b2fe471509a.\n", "files": ["browser/extensions/formautofill/content/manageDialog.mjs", "browser/extensions/formautofill/test/browser/creditCard/browser_manageCreditCardsDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_paymentsList_cvv.js", "browser/locales/en-US/browser/preferences/preferences.ftl", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/locales/en-US/toolkit/payments/payments.ftl"], "git_node": "eb61e2b56b03ccf9319e09240411e974cb3aebac", "git_parents": ["2a577d12204363dfad3d98b326c1048e80cfab0c"], "node": "c72e6e157bd4d228126afa46f7e0a52614d593c5", "parents": ["b3da2d7d9f187bb8098565e96c60493c13a3d3bb"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047966 - Ensure bookmarks can be dragged into folder shortcuts in the new bookmarks panel r=sidebar-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343691\n", "files": ["browser/components/sidebar/sidebar-bookmark-list.mjs", "browser/components/sidebar/sidebar-bookmarks.mjs", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar_drag_and_drop.js", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar_smart_bookmarks.js"], "git_node": "8b90d74866b334b2e0b1a9730a492ec42c57aa0e", "git_parents": ["eb61e2b56b03ccf9319e09240411e974cb3aebac"], "node": "63a3f96d3ab401c45017bcc6cef4a78428e0ae8a", "parents": ["c72e6e157bd4d228126afa46f7e0a52614d593c5"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083719 - Fix onboarding cards being shown when an unrecognised disqualifier condition should make them invalid. r=corentin\n\n\u2026isqualifier condition should make them invalid.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/455\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/onboarding/view/OnboardingMapperTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingMapper.kt"], "git_node": "a48ec7d01f114254de9982022ec04c0da4d561a6", "git_parents": ["8b90d74866b334b2e0b1a9730a492ec42c57aa0e"], "node": "10851a93ef4559fdeab6207b5fe4ed8bd67efa17", "parents": ["63a3f96d3ab401c45017bcc6cef4a78428e0ae8a"], "tags": []}], "date": 1795028030, "git_changesets": ["6d292f8b1de613fcaf6842400535b0938fd1054b", "6451bdf589799711b03f80d95396726178925963", "fd377c715e03d585e07d546291b13c16a873bfb8", "067b8ce4ecd93d8444c2e5f6642ffdfa3b83cf84", "83d452ba82c59e3904ea083aa8022b21436538e6", "f460a4fbc99b4d76be6769f9d5282b2fe471509a", "52745e1535fc2c6d6fb6609d86c9a84b2f94eae3", "718b8b442b1d1a5e48c60488ef252bacd4f2f4dd", "26990aaf2e7836781ee6e037caa39091da7ef145", "2a577d12204363dfad3d98b326c1048e80cfab0c", "eb61e2b56b03ccf9319e09240411e974cb3aebac", "8b90d74866b334b2e0b1a9730a492ec42c57aa0e", "a48ec7d01f114254de9982022ec04c0da4d561a6"], "user": "ctuns@mozilla.com"}, "45825": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053926 - Vendor the jni_zero Java annotations used by libwebrtc. r=webrtc-reviewers,geckoview-reviewers,mjf,tcampbell,android-build-system-reviewers\n\nUpstream libwebrtc Android Java now uses org.jni_zero annotations. Vendor just\nthose from Chromium with a moz.yaml so updatebot keeps them current.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331216\n", "files": ["mobile/android/geckoview/build.gradle", "third_party/jni_zero/LICENSE", "third_party/jni_zero/java/src/org/jni_zero/CalledByNative.java", "third_party/jni_zero/java/src/org/jni_zero/NativeMethods.java", "third_party/jni_zero/java/src/org/jni_zero/UsedReflectively.java", "third_party/jni_zero/moz.yaml"], "git_node": "2fe4fc61f30df5500491f38174150200d521ef26", "git_parents": ["a48ec7d01f114254de9982022ec04c0da4d561a6"], "node": "99cc7223c46937a29955bac5d245612ed42060b6", "parents": ["10851a93ef4559fdeab6207b5fe4ed8bd67efa17"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053926 - Vendor UsedReflectively.java with libwebrtc. r=webrtc-reviewers,mjf\n\nUpstream CalledByNative.java is annotated with it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331217\n", "files": ["dom/media/webrtc/third_party_build/vendor-libwebrtc.py"], "git_node": "3475e91821f9f114bdd727d9f33469249a16a027", "git_parents": ["2fe4fc61f30df5500491f38174150200d521ef26"], "node": "255cf2e3813f56a19f0d070787066fd2a1fb125c", "parents": ["99cc7223c46937a29955bac5d245612ed42060b6"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053926 - Add a generator for jni_zero's FooJni classes. r=geckoview-reviewers,nalexander\n\nUpstream libwebrtc Java calls FooJni.get() for its @NativeMethods interfaces.\nThis generates those classes, optionally with @WrapForJNI natives, so we can\nimplement natives through our own JNI bindings instead of jni_zero's.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331218\n", "files": ["mobile/android/gen_jni_zero_natives.py"], "git_node": "47258fc4f23acec560425b96838f2622c089a205", "git_parents": ["3475e91821f9f114bdd727d9f33469249a16a027"], "node": "979a3dbf654916d5faa77e91ea988faa1caeb5f2", "parents": ["255cf2e3813f56a19f0d070787066fd2a1fb125c"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053926 - Build upstream libwebrtc jni_zero Java sources for Android. r=webrtc-reviewers,geckoview-reviewers,mjf,nalexander,ahochheiden\n\nDrops the patch-stack reverts of upstream 0b0f9f61eb and 42b425a487, generates\nFooJni for each @NativeMethods class, and registers JniCommon's natives, the\nonly ones we use, through WrapForJNI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331219\n", "files": ["dom/media/systemservices/android_video_capture/video_capture_android.cc", "mobile/android/moz.build", "third_party/libwebrtc/moz-patch-stack/s0140.patch", "third_party/libwebrtc/moz-patch-stack/s0141.patch", "widget/android/moz.build"], "git_node": "7a0de2a674cae63401e274da26f799aff9d5e831", "git_parents": ["47258fc4f23acec560425b96838f2622c089a205"], "node": "aef413151c83630c8744ef4c3e2a5cbc15b0e6b5", "parents": ["979a3dbf654916d5faa77e91ea988faa1caeb5f2"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053926 - Vendor libwebrtc without the reverts of 0b0f9f61eb and 42b425a487. r=webrtc-reviewers,mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331220\n", "files": ["third_party/libwebrtc/examples/androidnativeapi/BUILD.gn", "third_party/libwebrtc/examples/androidvoip/BUILD.gn", "third_party/libwebrtc/rtc_base/java/src/org/webrtc/Logging.java", "third_party/libwebrtc/rtc_tools/network_tester/BUILD.gn", "third_party/libwebrtc/sdk/android/api/org/webrtc/AudioTrack.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/BuiltinAudioDecoderFactoryFactory.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/BuiltinAudioEncoderFactoryFactory.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/CallSessionFileRotatingLogSink.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/DataChannel.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/Dav1dDecoder.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/DtmfSender.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/Environment.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/JavaI420Buffer.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/LibaomAv1Encoder.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/LibvpxVp8Decoder.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/LibvpxVp8Encoder.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/LibvpxVp9Decoder.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/LibvpxVp9Encoder.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/MediaSource.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/MediaStreamTrack.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/Metrics.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/SoftwareVideoDecoderFactory.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/SoftwareVideoEncoderFactory.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/TimestampAligner.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/TurnCustomizer.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/VideoDecoderFallback.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/VideoEncoderFallback.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/VideoTrack.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/YuvHelper.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/audio/JavaAudioDeviceModule.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/CalledByNative.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/EglBase10Impl.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/H264Utils.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/Histogram.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/JniCommon.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/NV12Buffer.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/NV21Buffer.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/NativeAndroidVideoTrackSource.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/UsedReflectively.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/VideoDecoderWrapper.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/VideoEncoderWrapper.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/audio/WebRtcAudioRecord.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/audio/WebRtcAudioTrack.java", "third_party/libwebrtc/webrtc.gni"], "git_node": "c22eae1675a13aacbc6d8e8d0fcaf78e8fa52ad5", "git_parents": ["7a0de2a674cae63401e274da26f799aff9d5e831"], "node": "c235a3a81ab62089576503d9c3bdd9f99e21bd3c", "parents": ["aef413151c83630c8744ef4c3e2a5cbc15b0e6b5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2088446 - Use type-segregated slabs for the frame and display list arenas. r=layout-reviewers,dshin\n\nThis refactors the process-global pres arenas to achieve the following\ngoals:\n\n * No unbounded memory growth: Pages can be decommitted now, while still\n   reserved so that they don't get reused by other types. Note that we\n   still keep slab metadata around, but those are much smaller\n   allocations.\n\n * Better memory locality: Superblocks store a bunch of slabs, which are\n   close together, but can be used for different types each. Each slab\n   is only used for a single type over its lifetime, but this achieves\n   better memory locality between objects of the same type (before that\n   we relied on the allocation order).\n\nThe design is similar to LibPAS IsoHeaps. This is a decent speedometer\nimprovement and addresses some of the microbenchmark regressions that\nwe've seen from making the nsPresArenas process-global.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339496\n", "files": ["layout/base/PresShell.cpp", "layout/base/moz.build", "layout/base/nsPresArena.cpp", "layout/base/nsPresArena.h"], "git_node": "0dfef4f35d1b71e132805d807abb1879a2ebe919", "git_parents": ["c22eae1675a13aacbc6d8e8d0fcaf78e8fa52ad5"], "node": "b4f606906f67c71d43960690aba3e050f27a4c7a", "parents": ["c235a3a81ab62089576503d9c3bdd9f99e21bd3c"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Hash content once per algorithm for CSP hash sources; r=tschuster\n\nnsCSPDirective::allows() hashed the content again for each hash source, in\nnsCSPHashSrc::allows(). Match hash sources in nsCSPDirective::allowsByHash()\ninstead, like allowsByNonce() does for nonces, computing each digest once, when\nfirst needed, and call it through nsCSPPolicy::allowsByHash() from\nGetAllowsInline().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342530\n", "files": ["dom/security/nsCSPContext.cpp", "dom/security/nsCSPUtils.cpp", "dom/security/nsCSPUtils.h"], "git_node": "5964b761f29594908e6508eb9cf55e3d3c9739c0", "git_parents": ["0dfef4f35d1b71e132805d807abb1879a2ebe919"], "node": "321e1117aef755b880bdde9cd66aec0261f81f66", "parents": ["b4f606906f67c71d43960690aba3e050f27a4c7a"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2053926 - Vendor libwebrtc without the reverts of 0b0f9f61eb and 42b425a487. r=webrtc-reviewers,mjf\" for causing linting failures.\n\nThis reverts commit c22eae1675a13aacbc6d8e8d0fcaf78e8fa52ad5.\n\nRevert \"Bug 2053926 - Build upstream libwebrtc jni_zero Java sources for Android. r=webrtc-reviewers,geckoview-reviewers,mjf,nalexander,ahochheiden\"\n\nThis reverts commit 7a0de2a674cae63401e274da26f799aff9d5e831.\n\nRevert \"Bug 2053926 - Add a generator for jni_zero's FooJni classes. r=geckoview-reviewers,nalexander\"\n\nThis reverts commit 47258fc4f23acec560425b96838f2622c089a205.\n\nRevert \"Bug 2053926 - Vendor UsedReflectively.java with libwebrtc. r=webrtc-reviewers,mjf\"\n\nThis reverts commit 3475e91821f9f114bdd727d9f33469249a16a027.\n\nRevert \"Bug 2053926 - Vendor the jni_zero Java annotations used by libwebrtc. r=webrtc-reviewers,geckoview-reviewers,mjf,tcampbell,android-build-system-reviewers\"\n\nThis reverts commit 2fe4fc61f30df5500491f38174150200d521ef26.\n", "files": ["dom/media/systemservices/android_video_capture/video_capture_android.cc", "dom/media/webrtc/third_party_build/vendor-libwebrtc.py", "mobile/android/geckoview/build.gradle", "mobile/android/gen_jni_zero_natives.py", "mobile/android/moz.build", "third_party/jni_zero/LICENSE", "third_party/jni_zero/java/src/org/jni_zero/CalledByNative.java", "third_party/jni_zero/java/src/org/jni_zero/NativeMethods.java", "third_party/jni_zero/java/src/org/jni_zero/UsedReflectively.java", "third_party/jni_zero/moz.yaml", "third_party/libwebrtc/examples/androidnativeapi/BUILD.gn", "third_party/libwebrtc/examples/androidvoip/BUILD.gn", "third_party/libwebrtc/moz-patch-stack/s0140.patch", "third_party/libwebrtc/moz-patch-stack/s0141.patch", "third_party/libwebrtc/rtc_base/java/src/org/webrtc/Logging.java", "third_party/libwebrtc/rtc_tools/network_tester/BUILD.gn", "third_party/libwebrtc/sdk/android/api/org/webrtc/AudioTrack.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/BuiltinAudioDecoderFactoryFactory.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/BuiltinAudioEncoderFactoryFactory.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/CallSessionFileRotatingLogSink.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/DataChannel.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/Dav1dDecoder.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/DtmfSender.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/Environment.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/JavaI420Buffer.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/LibaomAv1Encoder.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/LibvpxVp8Decoder.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/LibvpxVp8Encoder.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/LibvpxVp9Decoder.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/LibvpxVp9Encoder.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/MediaSource.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/MediaStreamTrack.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/Metrics.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/SoftwareVideoDecoderFactory.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/SoftwareVideoEncoderFactory.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/TimestampAligner.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/TurnCustomizer.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/VideoDecoderFallback.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/VideoEncoderFallback.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/VideoTrack.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/YuvHelper.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/audio/JavaAudioDeviceModule.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/CalledByNative.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/EglBase10Impl.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/H264Utils.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/Histogram.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/JniCommon.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/NV12Buffer.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/NV21Buffer.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/NativeAndroidVideoTrackSource.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/UsedReflectively.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/VideoDecoderWrapper.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/VideoEncoderWrapper.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/audio/WebRtcAudioRecord.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/audio/WebRtcAudioTrack.java", "third_party/libwebrtc/webrtc.gni", "widget/android/moz.build"], "git_node": "666b50fe9b3e8dd3184f5df6017b083bdf1e074f", "git_parents": ["5964b761f29594908e6508eb9cf55e3d3c9739c0"], "node": "730039633fe48e576c7c3d0153b6e1376383df20", "parents": ["321e1117aef755b880bdde9cd66aec0261f81f66"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2094183. Use a sort to find duplicate ICO dir entry sizes instead of comparing every pair. r=gfx-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343954\n", "files": ["image/decoders/nsICODecoder.cpp"], "git_node": "55bc3d2ff5eb3c01b2cb79e4a9124240bc8a110e", "git_parents": ["666b50fe9b3e8dd3184f5df6017b083bdf1e074f"], "node": "40e0d59a0ad4beb93f26b495e80db25e8b84e119", "parents": ["730039633fe48e576c7c3d0153b6e1376383df20"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2089536 - Check VideoFrame buffer size against coded size r=media-playback-reviewers,azebrowski\n\nThe VideoFrame(data, init) constructor computed the required buffer size from the visible rect, so a buffer that does not cover the coded frame was accepted. Compute the layout over the coded rect, drop the redundant tight-packing check, and add a WPT asserting that an undersized buffer with an explicit layout throws TypeError. Refs w3c/webcodecs#516.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339924\n", "files": ["dom/media/webcodecs/VideoFrame.cpp", "testing/web-platform/tests/webcodecs/videoFrame-construction.any.js"], "git_node": "3bc8c21c2e2eb228629e989a7cfcce135b3283f0", "git_parents": ["55bc3d2ff5eb3c01b2cb79e4a9124240bc8a110e"], "node": "823b243e9ee1f2124308ed48fb699fab73766528", "parents": ["40e0d59a0ad4beb93f26b495e80db25e8b84e119"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2094054 - Part 1: Remove the antialiasing padding from DirectWrite glyph bounds, which never ran. r=jfkthame\n\ngfxDWriteFont::GetGlyphBounds only inflated the bounds when the rect passed\nin by the caller was non-empty, and its only caller, gfxFont::SetupGlyphExtents,\nalways passes an empty one. Enabling the padding would move most glyphs from\nthe contained-width array to the tight extents table, which made\nEditor-TipTap in Speedometer 3 about 11% slower on Windows, so remove it\ninstead. No change in behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343484\n", "files": ["gfx/thebes/gfxDWriteFonts.cpp"], "git_node": "9459fe0cd49610da32a222429fd3ca991198a4e8", "git_parents": ["3bc8c21c2e2eb228629e989a7cfcce135b3283f0"], "node": "6ed9c33947cd752dad4590971094c8b149f2f191", "parents": ["823b243e9ee1f2124308ed48fb699fab73766528"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2094054 - Part 2: Stop using a font entry that DirectWrite can't read, and its fonts. r=jfkthame\n\nWhen DirectWrite raises an exception while measuring a glyph, the font was\nmarked invalid and the font entry's character map was wiped, so that font\nselection would skip it. Neither lasted, because both recorded the failure on\nsomething other than what failed, the font file, which the entry stands for:\n- The wipe assigned a new map to gfxFontEntry::mCharacterMap directly: without\n  taking the entry's lock, without holding a reference to the new map and\n  without releasing the old one, so the old map leaked and the entry's\n  destructor later released a map with no reference. With the shared font\n  list, HasCharacter then put the shared character map back through\n  TrySetShmemCharacterMap, and fontlist::Family::SearchAllFontsForChar tests\n  the face's shared character map without asking the entry at all.\n- mIsValid only invalidated the one font instance, and gfxFont::InitMetrics set\n  it back to true when the exception happened while the font was being\n  initialized. The entry's fonts at other sizes, copies made by\n  CopyWithAntialiasOption and the new fonts FindOrMakeFont kept making all\n  stayed valid, and each one raised the same exception again.\n\nLeave the character maps and mIsValid alone, and record instead that the entry\nis unusable. The places that already decide whether an entry or a font can be\nused consult it:\n- gfxFontEntry::HasCharacter, so none of the places that (re)install a\n  character map need a guard, and nothing races with HasCharacter switching\n  from the local map to the shared one.\n- gfxFontEntry::FindOrMakeFont, through which an entry's fonts are looked up\n  and made.\n- gfxFont::Valid, so that every font of the entry, including the one being\n  initialized, is invalid, and gfxFont::HasCharacter, GetUVSGlyph and\n  gfxFontGroup::GetFirstValidFont, which go by it.\n- gfxFont::InitMetrics, so that a new font for the entry isn't initialized from\n  the unreadable file.\n\nfontlist::Family::SearchAllFontsForChar skips unusable entries, as the shared\ncharacter map it tests is shared with other processes. CopyWithAntialiasOption\nno longer leaks the copy when it isn't valid, which can now happen.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343487\n", "files": ["gfx/thebes/SharedFontList.cpp", "gfx/thebes/gfxDWriteFonts.cpp", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxTextRun.cpp"], "git_node": "3a9f31444f21808a9cdf43298bf08da36abfb1c7", "git_parents": ["9459fe0cd49610da32a222429fd3ca991198a4e8"], "node": "0648743f10f5e7dfb3b918989927150ce4f0d042", "parents": ["6ed9c33947cd752dad4590971094c8b149f2f191"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2094054 - Part 3: Share the handling of exceptions DirectWrite raises while measuring glyphs. r=jfkthame\n\ngfxDWriteFont::MeasureGlyphWidth and GetGlyphBounds handled an exception from\nDirectWrite with the same code. Move it to a helper. No change in behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343488\n", "files": ["gfx/thebes/gfxDWriteFonts.cpp", "gfx/thebes/gfxDWriteFonts.h"], "git_node": "446d43ccf8ffa247646b7701729a8076a32b17df", "git_parents": ["3a9f31444f21808a9cdf43298bf08da36abfb1c7"], "node": "80de2545c26b8b30cca015722467075ac1b39561", "parents": ["0648743f10f5e7dfb3b918989927150ce4f0d042"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2094054 - Part 4: Stop calling into a DirectWrite font face after it raised an exception. r=jfkthame\n\nOnce DirectWrite has raised an exception while measuring a glyph, the font\nentry is marked unusable, but the fonts already made for it can still be asked\nfor glyph widths and bounds, e.g. by text runs that use them. Each of those calls\nwent into the font face again, faulting and logging another critical error.\n\nCheck the entry before using the font face. The entry is what has to be\nchecked: the font file is shared by all of its fonts, including copies made by\nCopyWithAntialiasOption and fonts at other sizes, so a flag on the font that\nfaulted would leave the others calling in. mIsValid can't be used either, as it\nis also false while the font's metrics are being initialized, which measures\nglyphs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343483\n", "files": ["gfx/thebes/gfxDWriteFonts.cpp"], "git_node": "2a7ddea144aa307a49cb17f85a7557bb19033c64", "git_parents": ["446d43ccf8ffa247646b7701729a8076a32b17df"], "node": "fb27ad7900ef41155fd8b2e79f7174ce1b1b6dde", "parents": ["80de2545c26b8b30cca015722467075ac1b39561"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089887 - Resolve the nimbus-fml archive through Gradle dependency resolution. r=android-build-system-reviewers,ahochheiden\n\nThe Nimbus Gradle plugin declares archive.mozilla.org and the Taskcluster index as ivy repositories, scoped to\nnimbus-fml alone, and resolves the archive as a dependency, so Gradle's cache, retries and --offline handling\nreplace the task's own download, checksum, cache and pruning code. An artifact transform extracts the binary\nfor the host platform in place of the assembleNimbusTools task.\n\nThe android-gradle-dependencies enumeration pass resolves the archive, so after.sh packages it from the Gradle\ncache, and automation points NIMBUS_FML_REPOSITORY, which replaces NIMBUS_FML_CACHE_DIR, at it as a local\nrepository with the archive.mozilla.org layout. The toolchain task unsets it, so the archive always lands in\nthe Gradle cache that after.sh packages from. The sidecar .sha256 check goes away; it came from the same\nserver as the archive.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340219\n", "files": ["mobile/android/config/mozconfigs/android-arm-gradle-dependencies/base", "mobile/android/config/mozconfigs/common", "mobile/android/gradle/plugins/nimbus-gradle-plugin/README.md", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusAssembleToolsTask.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusFmlBinaryTransform.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusGradlePlugin.kt", "mobile/android/moz.configure", "taskcluster/kinds/source-test/python-android.yml", "taskcluster/scripts/misc/android-gradle-dependencies.sh", "taskcluster/scripts/misc/android-gradle-dependencies/after.sh"], "git_node": "16014be93687ae63f09edbd5292e88bd22a16b8a", "git_parents": ["2a7ddea144aa307a49cb17f85a7557bb19033c64"], "node": "1b7503ab35bf9cbfbe156aa108447c942744ee5d", "parents": ["fb27ad7900ef41155fd8b2e79f7174ce1b1b6dde"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089887 - Simplify the Nimbus Gradle plugin. r=android-build-system-reviewers,ahochheiden\n\nMerge NimbusTask and NimbusFmlCommandTask into NimbusFeaturesTask, their only user, read the\napplication-services version without a ValueSource, pass NIMBUS_FML to the task directly, drop the cacheDir\nand repoFiles extension options that no build sets, hook com.android.base once instead of the application and\nlibrary plugins separately, and drop the task's info logging, which duplicates the command line Gradle logs at\n--info.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340220\n", "files": ["mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusFeaturesTask.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusFmlCommandTask.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusGradlePlugin.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusTask.kt"], "git_node": "dd3ac914b171443124a3a96f3cf63ac096e3251c", "git_parents": ["16014be93687ae63f09edbd5292e88bd22a16b8a"], "node": "bff017fccb743fcddfdf1b38d723c54a9d0edfa5", "parents": ["1b7503ab35bf9cbfbe156aa108447c942744ee5d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089887 - Fix Nimbus Gradle plugin edge cases. r=android-build-system-reviewers,android-reviewers,ahochheiden,mcarare\n\nRead autoPublish.application-services.dir from local.properties in the plugin instead of through a\nnimbus.applicationServicesDir setting that every build file applying the plugin had to copy, and focus didn't.\nWhen the property is set, the features task builds nimbus-fml from a checkout Gradle doesn't track, so the\ntask no longer records its state, rather than coming up to date or from the build cache after the checkout\nchanges. The task empties its output directory before generating, since Gradle only removes the previous\noutputs of a task whose state it records.\n\nPlatform detection fails on a host the archive has no binary for, naming its os.name and os.arch, instead of\nlooking for an \"unknown\" platform. Windows always uses the x86_64 binary, which Windows on Arm runs under\nemulation, since the archive has no aarch64 Windows build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340221\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/build.gradle", "mobile/android/android-components/components/feature/fxsuggest/build.gradle", "mobile/android/android-components/components/service/nimbus/build.gradle", "mobile/android/fenix/app/build.gradle", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusFeaturesTask.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusFmlBinaryTransform.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusGradlePlugin.kt"], "git_node": "2a32a4bcfcd2098c55fab7b32d304499374fdc7a", "git_parents": ["dd3ac914b171443124a3a96f3cf63ac096e3251c"], "node": "5592ce369905957b9607d695efac7269d6cd3a11", "parents": ["bff017fccb743fcddfdf1b38d723c54a9d0edfa5"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2090157 - Repair the SEI NAL unit in pixel_aspect_ratio.mp4, and run its tests on macOS again. r=media-playback-reviewers,alwu\n\nThe x264 SEI at the start of the first sample is missing its NAL unit header\nbyte, so it reads as an IDR slice with nal_ref_idc 0. FFmpeg skips it, but\nVideoToolbox rejects the whole sample with kVTVideoDecoderBadDataErr, so the\nfile could not play on macOS (bug 1909908). Replace it with a filler data NAL\nunit of the same size, which leaves the rest of the file unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340407\n", "files": ["dom/media/test/mochitest.toml", "dom/media/test/mochitest_media_recorder.toml", "dom/media/test/pixel_aspect_ratio.mp4"], "git_node": "f89708ea8db8a2eebd8cbf0c1bb0b33460448607", "git_parents": ["2a32a4bcfcd2098c55fab7b32d304499374fdc7a"], "node": "431ccb4f029ce722ed5205661a185dfad1ef71c2", "parents": ["5592ce369905957b9607d695efac7269d6cd3a11"], "tags": []}, {"author": "Charlie Humphreys \u003cchumphreys@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046761: Add metrics index file for Fenix r=janerik,android-reviewers,android-build-system-reviewers,nalexander,geckoview-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339619\n", "files": ["mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/glean_index.yaml", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/GleanIndex.kt"], "git_node": "b26cd5d304e8f1c1d462b2a07358207a01f75ead", "git_parents": ["f89708ea8db8a2eebd8cbf0c1bb0b33460448607"], "node": "d4deb346c4a3460b0a31cb97924ea24265f467c1", "parents": ["431ccb4f029ce722ed5205661a185dfad1ef71c2"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2085773 - Use branding logo for This Firefox. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340509\n", "files": ["devtools/client/aboutdebugging/src/actions/runtimes.js"], "git_node": "2dce442b0b403d8cbe45a68e3169197a6cb0db08", "git_parents": ["b26cd5d304e8f1c1d462b2a07358207a01f75ead"], "node": "b8700c366983fbeddbe4ad620f4981c3fd643c33", "parents": ["d4deb346c4a3460b0a31cb97924ea24265f467c1"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2029440 - Add crashtest for TextTrackManager UAF via resizecaption reentry. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292500\n", "files": ["dom/media/webvtt/test/crashtests/2029440.html", "dom/media/webvtt/test/crashtests/crashtests.list"], "git_node": "01de21fa659ace7bd438eae0a9268b84bd3a2d5d", "git_parents": ["2dce442b0b403d8cbe45a68e3169197a6cb0db08"], "node": "660fc8e073128800480bc96de3a892d803fbd3ed", "parents": ["b8700c366983fbeddbe4ad620f4981c3fd643c33"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086075 - Manage BroadcastReceiver registration lifecycle in RecordingDevicesMiddleware. r=android-reviewers,pollymce\n\nRecordingDevicesMiddleware registered a new NotificationDismissedReceiver on every notification update and never unregistered it. Receivers accumulated until Android threw \"Too many receivers\" (limit of 1000 per process).\n\nMade NotificationDismissedReceiver a standalone class that owns its registration state, with synchronized, idempotent register() and unregister() methods. A failed registration is logged instead of crashing, at the cost of losing the dismissal reminder.\nThe middleware now creates a single instance, registers it only once the notification has actually been posted, and unregisters it when the notification is hidden.\nThe receiver's callback uses the store held by the middleware instead of a lambda passed through updateNotification and showNotification, and runs the reminder under the store lock so it is serialized with middleware invocations.\nA pending permission grant or a late dismissal after recording ends no longer leaves a notification or receiver behind.\nAdded unit tests covering receiver unregistration when the notification is hidden or recording ends, no registration when the notification is never shown, no duplicate registrations, the dismissed-then-reminder flow, a failing receiver registration, and concurrent register/unregister calls on the receiver.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337504\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/middleware/NotificationDismissedReceiver.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/middleware/RecordingDevicesMiddleware.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/middleware/NotificationDismissedReceiverTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/middleware/RecordingDevicesMiddlewareTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/DefaultComponents.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/Components.kt"], "git_node": "5d9b9d22f18bf6a95c3923a65f0f2ec3e3b83751", "git_parents": ["01de21fa659ace7bd438eae0a9268b84bd3a2d5d"], "node": "0530385cb895000c6137f1b733e4c49642cb68d1", "parents": ["660fc8e073128800480bc96de3a892d803fbd3ed"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088358 - Screen reader does not announce subpage name or heading in about:settings - r=reusable-components-reviewers,ip-protection-reviewers,settings-reviewers,desktop-theme-reviewers,hjones,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342323\n", "files": ["browser/components/preferences/tests/browser_setting_pane_sub_pane.js", "browser/components/preferences/widgets/setting-pane/setting-pane.mjs"], "git_node": "c0d9095c8ad3483b90a8da6c54ab904224e767df", "git_parents": ["5d9b9d22f18bf6a95c3923a65f0f2ec3e3b83751"], "node": "465cf347c33d3f068e3d60339f8569965357e1a4", "parents": ["0530385cb895000c6137f1b733e4c49642cb68d1"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083714 - Part 1: Set the eyedropper \"drawn\" attribute on the container element; r=devtools-reviewers,nchevobbe\n\nThe \"drawn\" attribute only lets DevTools tests know when the eyedropper has\ndrawn the screenshot of the page. It has no effect on the eyedropper itself.\n\nSetting it on the container element, rather than on the root element,\nkeeps this DevTools-only test hook out of the magnifier, so that the next\npatch can move the magnifier out to be shared without having to carry it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339286\n", "files": ["devtools/client/inspector/test/highlighter/browser_inspector_highlighter-eyedropper-clipboard.js", "devtools/client/inspector/test/highlighter/browser_inspector_highlighter-eyedropper-scroll.js", "devtools/server/actors/highlighters/eye-dropper.js"], "git_node": "69a205e087c3bc76ac8e61e334f3271ae208fbac", "git_parents": ["c0d9095c8ad3483b90a8da6c54ab904224e767df"], "node": "e61d3dc71122e79744437b68fd5b0534c8a7869f", "parents": ["465cf347c33d3f068e3d60339f8569965357e1a4"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083714 - Part 2: Move the DevTools eyedropper magnifier to toolkit; r=desktop-theme-reviewers,devtools-reviewers,emilio,nchevobbe,frontend-codestyle-reviewers,mossop\n\nSo that it can be shared with others. The behavior of the DevTools eyedropper\nis kept as is, except for its scrolling state handling:\n- The \"scrolling\" attribute of the eye-dropper-root element is renamed to\n  \"disabled\".\n- The magnifier is disabled until it is drawn with the new screenshot, rather\n  than until scrolling ends, as its screenshot is outdated until then.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339068\n", "files": [".stylelintrc.js", "devtools/client/inspector/test/highlighter/browser_inspector_highlighter-eyedropper-scroll.js", "devtools/server/actors/highlighters/css/highlighters.css", "devtools/server/actors/highlighters/eye-dropper.js", "toolkit/modules/EyeDropperMagnifier.sys.mjs", "toolkit/modules/moz.build", "toolkit/themes/moz.build", "toolkit/themes/shared/eyedropper-common.css"], "git_node": "eb1ba7bbc9069339b1297c039269aabc4a58111d", "git_parents": ["69a205e087c3bc76ac8e61e334f3271ae208fbac"], "node": "4e35d0ae13c73035ebf767cd134ca9304d246ec3", "parents": ["e61d3dc71122e79744437b68fd5b0534c8a7869f"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083714 - Part 3: Support pickers not shown in a XUL panel in InputPickerParentCommon; r=emilio\n\nThis is for the eyedropper, which has no panel. Pickers now report through\ncallbacks rather than events dispatched on the panel.\n\nThis should not change the existing behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335385\n", "files": ["toolkit/actors/InputPickerParentCommon.sys.mjs", "toolkit/modules/InputPickerPanelCommon.sys.mjs"], "git_node": "1a65827e5f8e12cdc93f83c63f8196d21a8cb7c7", "git_parents": ["eb1ba7bbc9069339b1297c039269aabc4a58111d"], "node": "10bb4f29752078467cfd6fc70d839e584d3335c1", "parents": ["4e35d0ae13c73035ebf767cd134ca9304d246ec3"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083714 - Part 4: Add initial implementation for eyedropper proposal; r=emilio,desktop-theme-reviewers,webidl,smaug,reusable-components-reviewers,mkennedy\n\nOpening the picker of an \u003cinput type=color eyedropper\u003e, behind the\ndom.input.color_eyedropper.enabled pref, shows an eyedropper over the page,\nusing the magnifier shared with the DevTools eyedropper, and the page is\ncaptured and sampled in the parent process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335140\n", "files": [".stylelintrc.js", "dom/html/HTMLInputElement.cpp", "dom/html/HTMLInputElement.h", "dom/html/test/forms/mochitest.toml", "dom/html/test/forms/test_input_color_eyedropper.html", "dom/webidl/HTMLInputElement.webidl", "modules/libpref/init/StaticPrefList.yaml", "toolkit/actors/ColorPickerChild.sys.mjs", "toolkit/actors/EyeDropperChild.sys.mjs", "toolkit/actors/EyeDropperParent.sys.mjs", "toolkit/actors/moz.build", "toolkit/modules/ActorManagerParent.sys.mjs", "toolkit/modules/EyeDropper.sys.mjs", "toolkit/modules/EyeDropperMagnifier.sys.mjs", "toolkit/modules/moz.build", "toolkit/modules/tests/browser/browser.toml", "toolkit/modules/tests/browser/browser_EyeDropper.js", "toolkit/modules/tests/browser/browser_EyeDropper_cancel.js", "toolkit/modules/tests/browser/head_EyeDropper.js", "toolkit/themes/shared/desktop-jar.inc.mn", "toolkit/themes/shared/eyedropper.css", "xpcom/ds/StaticAtoms.py"], "git_node": "7b75dbb72e3ef1901ba45baf4ddfafe69e239355", "git_parents": ["1a65827e5f8e12cdc93f83c63f8196d21a8cb7c7"], "node": "53fb7de339aaa841ebd717ff0ee4628e528a0c57", "parents": ["10bb4f29752078467cfd6fc70d839e584d3335c1"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047964 - Add context menus to bookmark folder shortcuts r=sidebar-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343723\n", "files": ["browser/components/sidebar/sidebar-bookmark-list.mjs", "browser/components/sidebar/sidebar-bookmarks.mjs", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar_smart_bookmarks.js"], "git_node": "07cfcf439bdbe95b32692da7422ef19c05f3542c", "git_parents": ["7b75dbb72e3ef1901ba45baf4ddfafe69e239355"], "node": "183d37e2694bfaa2d49dbdb66db721b216312a46", "parents": ["53fb7de339aaa841ebd717ff0ee4628e528a0c57"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2088446 - Paper over windows asan crashes on process exit.\n", "files": ["layout/base/nsPresArena.cpp"], "git_node": "1234d3e44a9f8d085c779806ef4e1d04dd046afe", "git_parents": ["07cfcf439bdbe95b32692da7422ef19c05f3542c"], "node": "0e2affa9b0c3ef4bf7d2d08d91120e29b27b4082", "parents": ["183d37e2694bfaa2d49dbdb66db721b216312a46"], "tags": []}, {"author": "Ben Chatterton \u003cbchatterton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088293: Create a home for DTE UI test migration, r=ashaw,taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339742\n", "files": ["python/mach/mach/command_util.py", "python/sites/dte-ui-test.txt", "taskcluster/docs/kinds.md", "taskcluster/kinds/dte-ui-test/kind.yml", "testing/dte-ui-test/mach_commands.py", "testing/dte-ui-test/tests/conftest.py", "testing/dte-ui-test/tests/test_bookmark_website_via_star_button.py"], "git_node": "5c4305b03b44ee15290eb584a537828b74311042", "git_parents": ["1234d3e44a9f8d085c779806ef4e1d04dd046afe"], "node": "9a1cf98fd559a08be2a2b94f91ef1faca3ab5d0f", "parents": ["0e2affa9b0c3ef4bf7d2d08d91120e29b27b4082"], "tags": []}, {"author": "Krist Baliev \u003ckbaliev@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083512 - Remove the Nova pref check from icon-capture-email-fields.svg. r=mtigley,desktop-theme-reviewers,mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343065\n", "files": ["browser/themes/shared/formautofill/icon-capture-email-fields.svg"], "git_node": "54c3da237ec6743b99afcd6a96cf7b6e41e2025a", "git_parents": ["5c4305b03b44ee15290eb584a537828b74311042"], "node": "2423ef7ecfff909cb858f0b7f73c6cdfd5f757e1", "parents": ["9a1cf98fd559a08be2a2b94f91ef1faca3ab5d0f"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088492 - Show the text selection menu below the end of the selection. r=gcardieri\n\nFor background on the Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nTo manually experiment with this feature, here is [[ https://searchux.netlify.app/highlight-to-search/ | the UX prototype ]].\n\nWith the feature gate on, the menu opens where it does for a selection dragged straight through the text, just below the end of the selection, or above it when there is no room below. A selection made backwards, by double click, or ending outside the page no longer opens the menu over the text or at the pointer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343583\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/genai/GenAIChild.sys.mjs", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/components/genai/tests/browser/head.js"], "git_node": "78d0c68ce83592b5ca18f06df579c62941b40415", "git_parents": ["54c3da237ec6743b99afcd6a96cf7b6e41e2025a"], "node": "feafd45ef4508868c68fdb25940a643e18b333f6", "parents": ["2423ef7ecfff909cb858f0b7f73c6cdfd5f757e1"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2024340 - Mark the learn_more_link tip description as markup in browser_glean_telemetry_engagement_tips.js, r=urlbar-reviewers,mak.\n\nWithout parseMarkup, once the description string is in the view's l10n cache, it is applied with textContent, which removes the learn-more link, so the test fails when it runs a second time in the same browser. The failing task then skipped unregistering its tip provider, which broke browser_glean_telemetry_engagement_type.js (\"found the menu button at result index 0\"); the provider is now unregistered even when the task fails.\n\nAlso build the expected help URL from app.support.baseURL rather than hardcoding port 8888, here and in browser_tip_richSuggestion.js, so the tests don't hang when the test server falls back to another port.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342144\n", "files": ["browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_engagement_tips.js", "browser/components/urlbar/tests/browser-tips/browser_tip_richSuggestion.js"], "git_node": "2f54069bf1a047c5ee8baa4acedadecb8b5fc097", "git_parents": ["78d0c68ce83592b5ca18f06df579c62941b40415"], "node": "198157d6ef1c79819fe85770e8933e9ff85dc0d7", "parents": ["feafd45ef4508868c68fdb25940a643e18b333f6"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2088446 - Add a valgrind suppression.\n", "files": ["build/valgrind/x86_64-pc-linux-gnu.sup"], "git_node": "228efbe9cb730b52fa68d4db925cf66f5e8ba48d", "git_parents": ["2f54069bf1a047c5ee8baa4acedadecb8b5fc097"], "node": "4735884d36b877c4b158334aa022cb8e193a0a40", "parents": ["198157d6ef1c79819fe85770e8933e9ff85dc0d7"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094623 - Explain in the bug-filing skill how to link related bugs, and name the other fields a bug often needs. r=ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343950\n", "files": [".agents/skills/bug-filing/SKILL.md", ".claude/skills/bug-filing/SKILL.md"], "git_node": "5b23e94ad2db00cf61e73527ef4e6cf1c6e29bf3", "git_parents": ["228efbe9cb730b52fa68d4db925cf66f5e8ba48d"], "node": "7abdeaeed11cb7d0b6c8d985992a51d3da8d14c2", "parents": ["4735884d36b877c4b158334aa022cb8e193a0a40"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085937 - Select the partner code per search access point for search-config-v3 in Focus r=android-reviewers,skhan\n\nBug 2075348 made each engine carry its URLs per search access point. This passes the access point a Focus search starts from, so it uses that access point's partner code:\n\n- `widget` for the search widget: voice searches, and searches typed on the home\n  screen the widget opened.\n- `context` for searches of text selected in another app (ACTION_PROCESS_TEXT).\n- `default` everywhere else.\n\nThe home screen keeps the access point it was opened with, because the widget only opens it and the search is typed afterwards. Opening Focus from the launcher resets it to `default`, while returning through Recents keeps it.\n\nSearch telemetry is unchanged, since Focus does not report telemetry suffixes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341110\n", "files": ["mobile/android/focus-android/app/src/main/java/org/mozilla/focus/Components.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/activity/MainActivity.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/activity/TextActionActivity.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/BaseFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/UrlInputFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/searchwidget/ExternalIntentNavigation.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/state/AppAction.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/state/AppReducer.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/state/AppState.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/utils/SearchUtils.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/cfr/CfrMiddlewareTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/MenuMiddlewareTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/browser/BrowserMenuTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/navigation/NavigatorTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/searchwidget/ExternalIntentNavigationTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/shortcut/HomeScreenTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/state/AppReducerTest.kt"], "git_node": "75c4c2d2d4b447b08eb0afd0600168dd9a41662b", "git_parents": ["5b23e94ad2db00cf61e73527ef4e6cf1c6e29bf3"], "node": "cdc61f214a73a44af130bbd78573d48a6349b9a3", "parents": ["7abdeaeed11cb7d0b6c8d985992a51d3da8d14c2"], "tags": []}, {"author": "Adriaan \u003cadriaanjacquet@gmail.com\u003e", "branch": "default", "desc": "Bug 2081651 - Update the ffmpeg58 version.h headers to FFmpeg 4.4.1. r=media-playback-reviewers,azebrowski\n\nThis also enables thread_safe_callbacks for libavcodec 58.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333609\n", "files": ["dom/media/platforms/ffmpeg/ffmpeg58/include/libavcodec/version.h", "dom/media/platforms/ffmpeg/ffmpeg58/include/libavutil/version.h"], "git_node": "0b12b2b2917568ac72dea4874e133bdf5bcf6dec", "git_parents": ["75c4c2d2d4b447b08eb0afd0600168dd9a41662b"], "node": "ed9b2083e5a51a58d5ba557af9f3a676b7add6a9", "parents": ["cdc61f214a73a44af130bbd78573d48a6349b9a3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090117 - Only let first-line re-parenting change first-line-allowed properties. r=firefox-style-system-reviewers,layout-reviewers,jwatt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343518\n", "files": ["layout/generic/crashtests/crashtests.list", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/properties.mako.rs"], "git_node": "f05287060858982da60db05ed2c54cc5280657a2", "git_parents": ["0b12b2b2917568ac72dea4874e133bdf5bcf6dec"], "node": "7df4d2ba3adb4b75fd1d44bc1ed5e82b64df6613", "parents": ["ed9b2083e5a51a58d5ba557af9f3a676b7add6a9"], "tags": []}, {"author": "Seva Alipov \u003csalipov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093338: Improve performance for line-clamp containers with no block descendants. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343748\n", "files": ["layout/generic/BlockReflowState.h", "layout/generic/nsBlockFrame.cpp", "layout/generic/nsBlockFrame.h"], "git_node": "f470a1a9960485bdce48f574711c1257d3657a6f", "git_parents": ["f05287060858982da60db05ed2c54cc5280657a2"], "node": "d7df4c537ee2136d22828d8ee5329765e15c6053", "parents": ["7df4d2ba3adb4b75fd1d44bc1ed5e82b64df6613"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1893684 - Introduce sectionheader and sectionfooter aria roles. r=accessibility-platform-reviewers,morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338831\n", "files": ["accessible/base/ARIAMap.cpp", "accessible/base/RoleMap.inc", "accessible/html/HTMLElementAccessibles.cpp", "accessible/interfaces/nsIAccessibleRole.idl", "accessible/mac/mozAccessible.mm", "accessible/tests/browser/mac/browser_roles_elements.js", "accessible/tests/browser/role/browser_computedARIARole.js", "accessible/tests/browser/role/browser_roles_generic.js", "accessible/tests/browser/windows/uia/browser_generalProps.js", "accessible/tests/mochitest/elm/test_HTMLSpec.html", "accessible/tests/mochitest/role.js", "accessible/tests/mochitest/role/test_general.html", "accessible/windows/uia/uiaRawElmProvider.cpp", "accessible/windows/uia/uiaRawElmProvider.h", "dom/locales/en-US/chrome/accessibility/mac/accessible.properties", "dom/locales/en-US/chrome/accessibility/win/accessible.properties", "testing/web-platform/meta/core-aam/aamtests/role/sectionfooter.py.ini", "testing/web-platform/meta/core-aam/aamtests/role/sectionheader.py.ini", "testing/web-platform/meta/dom/nodes/moveBefore/role-updates-after-move.html.ini", "testing/web-platform/meta/html-aam/roles-contextual.tentative.html.ini", "testing/web-platform/meta/wai-aria/role/contextual-roles.tentative.html.ini", "testing/web-platform/meta/wai-aria/role/roles.tentative.html.ini", "xpcom/ds/StaticAtoms.py"], "git_node": "c356b554bd261d8d6f0bfb76b871143395a57811", "git_parents": ["f470a1a9960485bdce48f574711c1257d3657a6f"], "node": "81627bfb00c16ef8ed01437bf08cd8f1098e927d", "parents": ["d7df4c537ee2136d22828d8ee5329765e15c6053"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1732312 - Conditionally expose aria-brailleroledescription aria-roledescription. r=accessibility-platform-reviewers,morgan\n\nAccording to spec, if those attributes have empty strings, or are\ndefined on accessibles with no explicit or implicit role then they\nshould not be exposed as an attribute.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339332\n", "files": ["accessible/base/ARIAMap.cpp", "accessible/base/ARIAMap.h", "accessible/base/AccAttributes.cpp", "accessible/base/AccAttributes.h", "accessible/basetypes/Accessible.cpp", "accessible/basetypes/Accessible.h", "accessible/generic/LocalAccessible.cpp", "accessible/ipc/RemoteAccessible.cpp", "accessible/tests/browser/e10s/bro