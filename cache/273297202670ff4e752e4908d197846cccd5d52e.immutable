ntermittently failing as we get closer to enabling it.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338390\n", "files": ["testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-appearance-button-after-text.html.ini"], "git_node": "7ed2273f32fddb37f3cf6cca432cc0155ff5b609", "git_parents": ["de1c8fefaba512e85e28ccf02db6054634c92672"], "node": "c2d59f993c7b2cbb1485111d2364b6e87cd92cb6", "parents": ["36de121cd1aaaba10bf9b3c19777da439a1b9923"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074725 - Register the panel-list's shown listener before synthesizing the mousedown in browser_panel_item_click_on_mouseup.js. r=reusable-components-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328440\n", "files": ["toolkit/content/tests/widgets/browser_panel_item_click_on_mouseup.js"], "git_node": "56c0df029bb72a9c853aea0cf3ee6a9a5e3ec323", "git_parents": ["7ed2273f32fddb37f3cf6cca432cc0155ff5b609"], "node": "787bd520844794c7c9ac6f9227667b46d5878aa7", "parents": ["c2d59f993c7b2cbb1485111d2364b6e87cd92cb6"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes ct-logs r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340106\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "3989f85febcb0b092df414e5a048e4cc0383e56e", "git_parents": ["56c0df029bb72a9c853aea0cf3ee6a9a5e3ec323"], "node": "9ff5c05400cf8fb36b46254c30bf180f152166cb", "parents": ["787bd520844794c7c9ac6f9227667b46d5878aa7"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2077970 - Account for descendant max-height in containers with line-clamp: auto. r=AlaskanEmily\" for causing wr failures on line-clamp-auto-045.html.\n\nThis reverts commit f1eaab02175f0fe67bac15e989603c1454c107d0.\n", "files": ["layout/generic/nsBlockFrame.cpp", "layout/generic/nsBlockFrame.h", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-039.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-043.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-044.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-045.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-063.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-023.html.ini"], "git_node": "042f92bac4d6602471d01f55753095577d163706", "git_parents": ["3989f85febcb0b092df414e5a048e4cc0383e56e"], "node": "c8052fbf748227a3d7d24bbe6125e8df54d1d95b", "parents": ["9ff5c05400cf8fb36b46254c30bf180f152166cb"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050939 - Remove invisible select subtree. r=accessibility-platform-reviewers,Jamie,devtools-reviewers,morgan,ochameau\" for causing dt failures on browser_accessibility_keyboard_audit.js.\n\nThis reverts commit de1c8fefaba512e85e28ccf02db6054634c92672.\n", "files": ["accessible/base/HTMLMarkupMap.inc", "accessible/base/nsAccessibilityService.cpp", "accessible/base/nsCoreUtils.cpp", "accessible/generic/DocAccessible.cpp", "accessible/generic/LocalAccessible.cpp", "accessible/html/HTMLSelectAccessible.cpp", "accessible/tests/browser/e10s/browser_caching_value.js", "accessible/tests/browser/e10s/browser_obj_group.js", "accessible/tests/browser/e10s/browser_treeupdate_optgroup.js", "accessible/tests/browser/e10s/doc_language.html", "accessible/tests/browser/mac/browser_popupbutton.js", "accessible/tests/browser/name_and_description/browser_name_markup.js", "accessible/tests/browser/selectable/browser_test_select.js", "accessible/tests/browser/states/browser.toml", "accessible/tests/browser/states/browser_test_select_visibility.js", "accessible/tests/browser/tree/browser_select.js", "accessible/tests/mochitest/attributes/test_obj_group.html", "accessible/tests/mochitest/elm/test_HTMLSpec.html", "accessible/tests/mochitest/events/test_coalescence.html", "accessible/tests/mochitest/events/test_focus_selects.html", "accessible/tests/mochitest/events/test_selection.html", "accessible/tests/mochitest/name/markuprules.xml", "accessible/tests/mochitest/relations/test_general.html", "accessible/tests/mochitest/states/test_selects.html", "accessible/tests/mochitest/tree/test_select.html", "accessible/tests/mochitest/treeupdate/test_optgroup.html", "accessible/tests/mochitest/treeupdate/test_select.html"], "git_node": "bb585f8c589bfae0c2831b7a7b30755155f7ba0e", "git_parents": ["042f92bac4d6602471d01f55753095577d163706"], "node": "fda2128cc6cfaa406bfa7887f9d0d19d47d9d195", "parents": ["c8052fbf748227a3d7d24bbe6125e8df54d1d95b"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089483 - Use std::has_single_bit for the power-of-two check of the x64/x86 multiply-by-constant codegen (Coverity CID 1678757) r=iain,sergesanspaille\n\nIn the x64 MulI64 codegen, `(1 \u003c\u003c shift) == constant` did a 32-bit shift\non a 64-bit constant, which is undefined for shift \u003e= 32, so constants\nfrom 2^31 to 2^62 never took the shlq fast path. Use std::has_single_bit,\nas the x86 MulI64 codegen already does, and use it in the x86-shared MulI\npath too for consistency.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339857\n", "files": ["js/src/jit-test/tests/wasm/binop-x64-ion-codegen.js", "js/src/jit/x64/CodeGenerator-x64.cpp", "js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp"], "git_node": "589176d3de39b1f1e4f005020bb56e572f7802a4", "git_parents": ["bb585f8c589bfae0c2831b7a7b30755155f7ba0e"], "node": "9e8872d06e1567fb5216591b1a1213129ebcefe5", "parents": ["fda2128cc6cfaa406bfa7887f9d0d19d47d9d195"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2084070 - Convert the bug references in a single pass in bzlink r=firefox-source-docs-reviewers,ahal DONTBUILD\n\nThe transform rescanned the whole document after each text node holding more\nthan one reference, used the deprecated traverse(), and failed on a quote\nseparator that its regular expression accepted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335883\n", "files": ["docs/_addons/bzlink.py"], "git_node": "e946c1c9858bacc74919a8e0d8ff9b0df81dc7e4", "git_parents": ["589176d3de39b1f1e4f005020bb56e572f7802a4"], "node": "8cec7ac432b31cc9110145a291c9c7267baa4117", "parents": ["9e8872d06e1567fb5216591b1a1213129ebcefe5"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084958 - Update the \"account card\" on the global Settings screen when there is no authenticated account r=android-reviewers,android-l10n-reviewers,parker,tthibaud\" for causing fenix-debug failures\n\nThis reverts commit dad5f0c681918eb9ca90dd155c1cdcdbdb4bfeb6.\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/AccountUiView.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/SignInPromoPreference.kt", "mobile/android/fenix/app/src/main/res/drawable/kit_sign_in_promo.xml", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/preferences.xml"], "git_node": "fd272ecaa1f07feedfbeb8d6bf2522e5894d43f8", "git_parents": ["e946c1c9858bacc74919a8e0d8ff9b0df81dc7e4"], "node": "5939f8f1cf2e93f09afb4f49e455ca221589d71a", "parents": ["8cec7ac432b31cc9110145a291c9c7267baa4117"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088587 - Stop forcing media.wmf.force.allow-p010-format on in Nightly. r=ahale\n\nThe pref only overrides FEATURE_DX_P010 and FEATURE_DX_P016 blocklist entries, so P010 is still used on\nhardware that isn't blocklisted while keeping the blocklist effective on every channel.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340151\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "db42b95124c921828fc04cb5f8cc60e50cd65bd3", "git_parents": ["fd272ecaa1f07feedfbeb8d6bf2522e5894d43f8"], "node": "99e65c19fe8fa93c0f922e6cbde17533f1640597", "parents": ["5939f8f1cf2e93f09afb4f49e455ca221589d71a"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089525 - Link to the commit access level 1 steps from the Try section of the contribution quick reference r=marco DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339912\n", "files": ["docs/contributing/contribution_quickref.md"], "git_node": "ce856c730c059bc48304449813dd7c0a2cd756c3", "git_parents": ["db42b95124c921828fc04cb5f8cc60e50cd65bd3"], "node": "4184d241e9e3e9f9c91a96c3f910bb74c0ce931f", "parents": ["99e65c19fe8fa93c0f922e6cbde17533f1640597"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2088904 - coverity: model NSS reference-taking functions and Atomic exchange r=sergesanspaille DONTBUILD\n\nCERT_DupCertificate, PK11_ReferenceSlot and SECMOD_ReferenceModule take a\nnew reference and return the same pointer, which Coverity reports as one\nobject owned by two smart pointers. Return an unknown pointer instead.\n\nA pointer stored with mozilla::Atomic::exchange or compareExchange is\nowned by the atomic, so mark it as escaping to stop the leak reports on\nthe lazily created caches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339514\n", "files": ["tools/coverity/model_file.cpp"], "git_node": "679e264e8d56053937ba3c9d92386f46c92881b8", "git_parents": ["ce856c730c059bc48304449813dd7c0a2cd756c3"], "node": "405e2c0ef354742ad657aae1fe4a6505c0f967b0", "parents": ["4184d241e9e3e9f9c91a96c3f910bb74c0ce931f"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070691 - Part 1: Add an error state to moz-widget r=fchasen,fluent-reviewers,bolsson\n\n`moz-widget` has gained an error state, since it owns the frame. Hosts\ncall `reportError()` and `reportReady()`, and the widget fires\n`widget-error` and `widget-ready`. `reportError()` takes an optional\nreason, which `widget-error` passes on as `detail.reason`. Clearing\n`error` directly fires `widget-ready` too.\n\nThe `error` slot is drawn over the widget content, a frame or the\ndefault slot, and the content goes inert rather than being replaced, so\nthe widget can recover. An iframe that fails to load is an error. One\nthat loads is ready only with the `ready-on-load` attribute, since a\nweb page reports for itself and its `load` also fires on a network\nerror page.\n\nA page that can't be reached still shows the network error page, which\nthis patch leaves as it is.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336987\n", "files": ["browser/components/widgets/content/moz-widget.css", "browser/components/widgets/content/moz-widget.mjs", "browser/components/widgets/content/moz-widget.stories.md", "browser/components/widgets/content/moz-widget.stories.mjs", "browser/components/widgets/tests/chrome/test_moz_widget.html"], "git_node": "ad0cb34a4dd26763d283e33858bbc7a827ad8759", "git_parents": ["679e264e8d56053937ba3c9d92386f46c92881b8"], "node": "406a38df7f5f183aeafb887e19f1ed85ebf778f8", "parents": ["405e2c0ef354742ad657aae1fe4a6505c0f967b0"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070691 - Part 2: Show an error message in New Tab widgets r=fchasen,fluent-reviewers,bolsson\n\nA New Tab widget that fails now shows a message in place of its\ncontent. `MozWidgetCard` listens for the `widget-error` and\n`widget-ready` events from `moz-widget`, and draws `WidgetError` in the\n`error` slot while the widget is in the error state. A widget in\n`WIDGET_REGISTRY` can set `errorL10nId` for wording of its own.\n\n`WidgetError` records `widgets_error` once the message is on screen, so\na preloaded tab the user never saw records nothing. The `error_type` is\nthe reason the widget reported, or `load_error` when the card noticed\nthe failure itself. The widget name goes inside the `role=\"alert\"`, and\nis visually hidden when a header already shows it.\n\n`MozWidgetCard` takes a `readyOnLoad` prop, true by default for\nextension pages, and sets the `ready-on-load` attribute from it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339858\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/MozWidgetCard.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetError.jsx", "browser/extensions/newtab/content-src/components/Widgets/_Widgets.scss", "browser/extensions/newtab/test/jest/content-src/components/Widgets/FramedWidgetCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/MozWidgetCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetError.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "7de86395f1425e9a9c10c0a6f053dcf7a9f65bc0", "git_parents": ["ad0cb34a4dd26763d283e33858bbc7a827ad8759"], "node": "8a57dbfb1507f53934db20b6d1b7717e52588877", "parents": ["406a38df7f5f183aeafb887e19f1ed85ebf778f8"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070691 - Part 3: Handle widget messages in FramedWidgetCard r=mconley,fchasen\n\nA hosted widget page reports its state with `postMessage`, following\nthe protocol in `docs/host-integration.md` of `mozilla/framed-widgets`.\n`FramedWidgetCard` listens on the `\u003ctelemetryName\u003e_widget` channel and\naccepts only messages from the window of its frame and the origin of\nits document.\n\nA `widget_error` with `terminal: true` and a reason that matches the\nprotocol's token rule calls `reportError(reason)` on `moz-widget`, so\nthe reason reaches `widgets_error` as `error_type`. Other errors are\nignored for now. A `widget_ready` calls `reportReady()`, unless the\ncard is already in the error state, since a widget sends `widget_ready`\nwhen its page loads even after an early crash.\n\nThe card passes `readyOnLoad={false}`, because the page reports for\nitself. `reportError()` and `reportReady()` don't exist before Firefox\n161, so the optional calls do nothing there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339859\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/FramedWidgetCard.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/FramedWidgetCard.test.jsx"], "git_node": "a411bbd3e5bb7e3e49f75a2f54f3d3156cdfa721", "git_parents": ["7de86395f1425e9a9c10c0a6f053dcf7a9f65bc0"], "node": "d5efa95513fbf780db43cd842ccb1eb214e135e6", "parents": ["8a57dbfb1507f53934db20b6d1b7717e52588877"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070700 - Add widget ready and error telemetry events r=fchasen\n\n`widgets_ready` has been added alongside `widgets_impression` and\n`widgets_error`, recorded on the `widget-ready` event from bug 2070691.\nLike the other two, it waits until the user has seen the card, and it\nrecords the size and `widget_location` of the impression. A ready from\na previous document, or one followed by a failure, isn't counted.\n`useWidgetTelemetry` has its `onImpression` callback back for this,\nafter bug 2079330 removed it, and calls it with the impression payload.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336988\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/content-src/components/Widgets/FramedWidgetCard.jsx", "browser/extensions/newtab/content-src/components/Widgets/MozWidgetCard.jsx", "browser/extensions/newtab/content-src/components/Widgets/useWidgetTelemetry.jsx", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/FramedWidgetCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/MozWidgetCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/useWidgetTelemetry.test.jsx", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "a13f4a698b55534a02740a99598f58aa9d1240a3", "git_parents": ["a411bbd3e5bb7e3e49f75a2f54f3d3156cdfa721"], "node": "a1806ad7b6a42b8c0d93511aef5fd269bdc4daa4", "parents": ["d5efa95513fbf780db43cd842ccb1eb214e135e6"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089166 - Release the config when CreateDecoderAgent fails. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340064\n", "files": ["dom/media/webcodecs/DecoderTemplate.cpp", "dom/media/webcodecs/DecoderTemplate.h"], "git_node": "140f6d21a7e2c1cb63482cfb9d4b833fcee092ed", "git_parents": ["a13f4a698b55534a02740a99598f58aa9d1240a3"], "node": "44f4cce26e045200b3726521d44270993f379b3d", "parents": ["a1806ad7b6a42b8c0d93511aef5fd269bdc4daa4"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089166 - Add crashtest. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340065\n", "files": ["dom/media/webcodecs/crashtests/2089166.html", "dom/media/webcodecs/crashtests/crashtests.list"], "git_node": "8f552385876ff954e7b43f1361523fbe2b152eaa", "git_parents": ["140f6d21a7e2c1cb63482cfb9d4b833fcee092ed"], "node": "017618aa3463318e7f3a78bf15310cf10fffa9c0", "parents": ["44f4cce26e045200b3726521d44270993f379b3d"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084942: Add aitab favicon to the Places component r=omarg\n\nI think hackbot's approach in Bugzilla doesn't consider that we use favicons in different places in smart window and we would need to add the resolver in multiple files, and potentially, we could miss in future implementations.\nFor this reason, I decided to go with an approach that adds the favicon in the Places component.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339241\n", "files": ["browser/components/aiwindow/ui/actors/AITabParent.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aitab_page.js"], "git_node": "51f69dd02ed7abb238e8a4f6f03fe708fe6641da", "git_parents": ["8f552385876ff954e7b43f1361523fbe2b152eaa"], "node": "f190ede4b1c22a9206223a7771ad3fe5ceb1bb57", "parents": ["017618aa3463318e7f3a78bf15310cf10fffa9c0"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089165 - Remove Legacy Telemetry scalars widget.ime_name_on_windows{,_inserted_crlf} r=chutten\n\nRemove the Legacy Telemetry scalars widget.ime_name_on_windows and widget.ime_name_on_windows_inserted_crlf from Scalars.yaml, and drop the matching telemetry_mirror properties from the Glean metrics in widget/windows/metrics.yaml.\n\nThe Glean metrics widget.ime_name_on_windows and widget.ime_name_on_windows_inserted_crlf, and the code that records them in TSFStaticSink.cpp and TSFTextStore.cpp, stay as they are. No tests referenced the Legacy scalars.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339777\n", "files": ["toolkit/components/telemetry/Scalars.yaml", "widget/windows/metrics.yaml"], "git_node": "e7ec064862df02d13acf03a477f71582f29e0b66", "git_parents": ["51f69dd02ed7abb238e8a4f6f03fe708fe6641da"], "node": "e6e5d0c9b643e3310cba9b74744647f43531c99c", "parents": ["f190ede4b1c22a9206223a7771ad3fe5ceb1bb57"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089734 - Remove the unchecked cast suppressions from the in-tree Gradle plugins. r=android-build-system-reviewers,ahochheiden\n\nRead the mozconfig as Map\u003c*, *\u003e, have the nimbus plugin read it once, and read the memoized FML binary\nprovider back through a checked cast.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340143\n", "files": ["mobile/android/android-components/plugins/config/settings.gradle.kts", "mobile/android/android-components/plugins/dependencies/settings.gradle.kts", "mobile/android/android-components/plugins/publicsuffixlist/settings.gradle.kts", "mobile/android/fenix/plugins/apksize/settings.gradle.kts", "mobile/android/gradle/plugins/android-test-keep-rules/settings.gradle.kts", "mobile/android/gradle/plugins/apilint/apilint/src/main/kotlin/org/mozilla/apilint/ApiLintPluginExtension.kt", "mobile/android/gradle/plugins/apilint/settings.gradle.kts", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/BuildConfig.kt", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/MachTasksPlugin.kt", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/SettingsPlugin.kt", "mobile/android/gradle/plugins/conventions/src/test/java/org/mozilla/conventions/BuildMetricsServiceTest.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/settings.gradle.kts", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusGradlePlugin.kt"], "git_node": "ad6120294b826f9e72a3d75cbd3af09717811430", "git_parents": ["e7ec064862df02d13acf03a477f71582f29e0b66"], "node": "4150d0297fc495535c21ba26e77a78fc38129909", "parents": ["e6e5d0c9b643e3310cba9b74744647f43531c99c"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041489: Remove sidebar browser from smartwindow-init logic and refactor window switcher test r=jlewis\n\nThe browser leaking issue in the window switcher test was fixed in https://phabricator.services.mozilla.com/D337547\nHowever, the changes made in this patch also improve the smartwindow init method with the goal of avoiding new leaks by making sure the sidebar browser won't have its url redirected.\n\nAlso refactor **browser_aiwindow_switcher**.js:\n- Use describe/it with beforeEach/afterEach. Each test opens its own window instead of toggling the main test window.\n- Drop prefs already set by the manifest and head.js\n- Stop calling flushPrefEnv, which also popped the head.js setup prefs.\n- Fix the AI control asserts, which passed when the button was missing.\n- Remove tests and asserts already covered elsewhere in the file.\n- Move the smartbar toggle button test to `browser_smartwindow_classic_mode_switch.js`, since it tests the chat page content after switching and not the switcher button.\n- Add ui.prefersReducedMotion = 1 as (similar to other SW tests) this avoids an issue that also causes failure in chaos mode, the tab throbber changes its infinite animation for a static loading.svg.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338880\n", "files": ["browser/components/aiwindow/ui/content/smartwindow-init.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_switcher.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_classic_mode_switch.js"], "git_node": "e76d28d6aca7871eb4763f5022e957a6274be4cf", "git_parents": ["ad6120294b826f9e72a3d75cbd3af09717811430"], "node": "b1a29b154262a90105a6468353f15b607973a46f", "parents": ["4150d0297fc495535c21ba26e77a78fc38129909"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089684 - Remove SSH-based push instructions from the try and commit access docs r=marco DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340060\n", "files": ["docs/contributing/levelling-up.md", "tools/tryselect/docs/index.md", "tools/tryselect/lando.py"], "git_node": "78ba7aeb2bfa74d690eb0b7d1d13385ae641a8ff", "git_parents": ["e76d28d6aca7871eb4763f5022e957a6274be4cf"], "node": "5472bf1338ace94f109455737b63cd527012cceb", "parents": ["b1a29b154262a90105a6468353f15b607973a46f"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 1 - Clean up ref count checking. r=smaug\n\nA few places in the cycle collector take advantage of \"int as bool\" when\nchecking if the refcount is zero, which I find confusing. This patch adds\na new predicate on nsPurpleBufferEntry that return true if the ref count is\nzero.\n\nIt also uses early return in a few places.\n\nFor SnowWhiteKiller, it adds a new predicate to SnowWhiteObject that checks if\nit is still okay to kill the object. It hoists this check out of MaybeKillObject,\nturning it into KillObject. The check was redundant in the budgeted case. This\nwill be relevant in the final patch that modifies KillObject further.\n\nThis also consolidates the mBudget check because it should not matter if we\nadd swo to mObjects before or after we remove the entry from the purple buffer.\n\nThis patch should not change any actual behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337231\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "2a78e4dcf90dd92b60e034f6add62a3785cfe20f", "git_parents": ["78ba7aeb2bfa74d690eb0b7d1d13385ae641a8ff"], "node": "014a40033fed8eb5f064acc4853d941697e69013", "parents": ["5472bf1338ace94f109455737b63cd527012cceb"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 2 - Make the CC resilient against zero refcount objects. r=smaug\n\nThe cycle collector currently assumes that the SnowWhiteKiller has successfully\neliminated all objects with a refcount of 0 from the purple buffer. The method\nPtrInfo::IsGrayJS() relies on there being no refcounted objects with a refcount\nof 0, because it uses that to represent gray JS objects.\n\nA later patch will loosen the reentrance guards, so we will no longer be sure\nthat SnowWhiteKiller actually finished at the start of the current CC slice, so\nthe CC needs to be able to deal with objects with a refcount of 0 existing.\nThese objects can't be part of a cycle, so the CC only needs to ensure that they\nare kept out of the CC graph.\n\nThis requires some changes\n* Skip any refcount 0 objects we see in the purple buffer while getting roots,\n  instead of asserting.\n* SelectPointers might not clear snow white objects, so update the assert.\n* If an object was added to the graph and then its refcount dropped to 0\n  before we called DescribeRefCountedNode on the object, treat it like it\n  has a large valid refcount. Only release assert if the refcount is 0 if we're\n  not freeing snow white objects. Make the upper bound release assert a little\n  stricter. Delay logging until we've set the fake refcount.\n* An object could be in the purple buffer with a refcount of 0 in ScanRoots\n  if the refcount dropped to 0 after DescribeRefCountedNode. In that case,\n  it is fine to be cautious and treat it as being alive. To accommodate this\n  we only need to relax an assertion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337232\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "a5efebdf431c92d214e7a1671d38b9281b1c1b1f", "git_parents": ["2a78e4dcf90dd92b60e034f6add62a3785cfe20f"], "node": "4e23e4afd82035abaf7b44fb617298caa4413e56", "parents": ["014a40033fed8eb5f064acc4853d941697e69013"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 3 - Add a helper class for whiteNodes in CollectWhite. r=smaug\n\nThis is done to make the next step cleaner and should not change any\nbehavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337233\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "f4842943bf5d30eac05856d46c16c7f53caf841d", "git_parents": ["a5efebdf431c92d214e7a1671d38b9281b1c1b1f"], "node": "649770b2e78f7ec54daec531b53a170d5bb197c2", "parents": ["4e23e4afd82035abaf7b44fb617298caa4413e56"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 4 - Clear the graph early to simplify the condition of when it is safe to GC. r=smaug\n\nUnlink() in CollectWhite() can end up running arbitrary JS, which can GC,\nwhich can cause the JS pointers in the CC to become stale. This isn't a safety\nproblem because we don't use the JS pointers after the Root() loop and we have\na strong reference to any C++ objects being held in a WhiteNode.\n\nHowever, it is hard to describe the specific condition of when it is safe to GC.\nThis patch makes that condition easier to specify: it is safe to GC if and only\nif the CC graph is empty. It does this by clearing the graph after the Root() loop.\n\nTo allow this, the patch changes it so that we store the data needed for Unlink\nand Unroot within WhiteNode, rather than the graph. The drawback is that it will\ntake twice as much memory to store the WhiteNodes, although the segments will\nstill have the same size. On the upside, we avoid some pointer chasing, and we\nreduce the amount of memory being used before we run Unlink which might help.\n\nPotentially this increases the max pause time in an incremental CC, because we\nwill no longer clear the graph in a separate slice, but I don't think it takes\nvery long to clear the graph so I don't think it matters.\n\nThe patch moves the mParticipant assertion to the WhiteNode ctor. Before this\npatch, WhiteNode contained a reference to the CC graph, so if something was\nremoved from the CC graph, then mPInfo-\u003emParticipant could change, and the\nassertions in Unlink() and Unroot() might catch something. Now, the mParticipant\ndata is stored directly within WhiteNode, so it can't be changed if an object\ndies. However, we've already called Root() so it shouldn't be a problem.\n\nNow that the safety condition is clean, change FinishAnyCurrentCollection to use\na release assert when confirming there are no remaining dead pointers in the graph.\nThis requires building the three IsEmpty methods in non-debug builds.\n\nThis also moves the ClearWhiteJSWeakRefTargets call inside AutoAssertNoGC, because\nif it could run the GC, we would fail to finish the CC because mActivelyCollecting\nis true.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337234\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "d3663fe2dc270baeff213c2d09f7266726d0f689", "git_parents": ["f4842943bf5d30eac05856d46c16c7f53caf841d"], "node": "91ad27571b806e2a23fd9226be6eafb80b635565", "parents": ["649770b2e78f7ec54daec531b53a170d5bb197c2"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 5 - Make an append-only version of VisitEntries for PurpleScanBlackVisitor. r=smaug\n\nA later patch will allow the CC to finish a cycle collection when mFreeingSnowWhite\nis true. FreeSnowWhiteWithBudget runs destructors while iterating over the\npurple buffer, which can make us need to finish the CC. ScanIncrementalRoots is\npart of the critical path of finishing a cycle collection, and iterates over the\npurple buffer using PurpleScanBlackVisitor. It is okay to append to the purple\nbuffer while somebody further up the stack is iterating over it, but not to\nmodify or remove existing entries.\n\nFortunately, PurpleScanBlackVisitor only needs to add entries, so in this patch\nI add a new version of VisitEntries that does not allow modifying or removing\nexisting purple buffer entries. We lose out on compaction, but it isn't going to\nbe useful when we're not removing entries.\n\nAlso, give \"ar\" a better name in preparation for the next patch which will add\na second AutoRestore value to these methods. I added a little RAII helper class\nto deal with the shared nursery cleanup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337235\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "ef0976d45595a385961c1eb985e66943921c4be8", "git_parents": ["d3663fe2dc270baeff213c2d09f7266726d0f689"], "node": "f6ea31b0cf65d08c2a8cf6ebc733b56d82801a64", "parents": ["91ad27571b806e2a23fd9226be6eafb80b635565"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 6 - Dynamically prevent iterator invalidation in the purple buffer. r=smaug\n\nWhile a function is iterating over the purple buffer using VisitEntries,\nit is okay to add more entries to the purple buffer, but not to remove\nor modify existing entries. Enforce this by tracking when we're iterating\nover the purple buffer with a new data member, and use release asserts\nto enforce that invalidation isn't happening.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337236\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "8ce703ea23b09c3fbaa281cb28a1fff48c839511", "git_parents": ["ef0976d45595a385961c1eb985e66943921c4be8"], "node": "0023ac03e5f0c07c25dddd2fe9e331327dbab9ac", "parents": ["f6ea31b0cf65d08c2a8cf6ebc733b56d82801a64"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 7 - Add CCReason::GC_WAITING_NOW. r=smaug\n\nGC_WAITING is used in PrepareForGarbageCollection to indicate that we need to\nfinish up the CC immediately so that it is safe to GC, but in the CC/GC\nscheduler it is used more to mean that we want to GC eventually, so we should\nhurry it up with the CC.\n\nThis patch splits up the two uses by adding a new reason GC_WAITING_NOW\nfor PrepareForGarbageCollection. This will be used in the next patch.\n\nI also simplified things a little and always use GC_WAITING_NOW in\nFinishAnyCurrentCollection. Otherwise, it gets a little weird to\nhave nsCycleCollector_finishAnyCurrentCollection not actually\nfinish the current CC in some conditions after the next patch. It is only used\nin testing so I think that's fine.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337237\n", "files": ["xpcom/base/nsCycleCollectionParticipant.h", "xpcom/base/nsCycleCollector.cpp"], "git_node": "7beed9761e94bd469ebc3bfd6af1a5c8bcc723b8", "git_parents": ["8ce703ea23b09c3fbaa281cb28a1fff48c839511"], "node": "576e936a90b825c94e4737031a367325b8ad9ea2", "parents": ["0023ac03e5f0c07c25dddd2fe9e331327dbab9ac"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 8 - Allow reentrance in Collect during FreeSnowWhite. r=smaug\n\nIf the GC is trying to finish the CC, we need to advance the CC enough that\nthe graph is empty, even if we're in the middle of FreeSnowWhite. We'll still\ntry to finish the CC if we can, for instance if it was in CleanupPhase when\nwe GCed, because we'll collect things sooner if the CC is fully done before\nthe GC runs.\n\nThis patch weakens the reentrance guard, and doesn't set mActivelyCollecting\nto true until we're done with FreeSnowWhite. FreeSnowWhite itself also\nguards against mFreeingSnowWhite so we won't reenter there.\n\nAlso, move collectedAny closer to where it is used.\n\nThe SnowWhiteKiller::Visit() change is tricky. In the unbudgeted version of the\nSWK, snow white objects are removed from the purple buffer before any destructors\nare run. If a destructor of a snow white object runs JS, we can end up finishing\na CC while they are in this state. We need to ensure that the CC does not decide\nthese snow white objects need to be unlinked, so we want them to be treated as\nincremental roots. As they aren't in the purple buffer, we instead remove them\nfrom the CC graph (as though they had died) which will mark them as incremental\nroots. If the snow white objects are not yet in the graph, and get resurrected,\nthey will end up back in the purple buffer, and thus will be treated as\nincremental roots. The behavior does not change for a budgeted SWK, which was\nalready removing objects from the graph immediately before destroying them.\n\nI added a comment about FinalizeDeferredThings reentrance causing\nEndCycleCollectionCallback weirdness. This is pre-existing.\n\nWhile I'm touching this code anyways, I adjusted the !IsIncrementalGCInProgress() assertion\nin Collect(). This could happen if you are using test functions to trigger a budgeted CC\nslice that starts an IGC inside from the unlink method, hits the budget before\nCleanupAfterCollection can run, then runs another slice via the testing function.\nBeginCollection will finish the IGC before looking at JS and CleanupPhase doesn't look at\nit, so this is fine. This is pre-existing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337238\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "72d1731f888320dd7adb222fa68a37c2f80bd679", "git_parents": ["7beed9761e94bd469ebc3bfd6af1a5c8bcc723b8"], "node": "1d5aaf9223f17675ff09a6d7001985807286bcac", "parents": ["576e936a90b825c94e4737031a367325b8ad9ea2"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 9 - Fix potential ForgetSkippable reentrance issues. r=smaug\n\nThis patch fixes a few pre-existing issues with ForgetSkippable.\n\nIn theory, PrepareForForgetSkippable might be able to start a new CC in\nForgetSkippable, so to be safe, recheck that we're idle after we call it.\n\nForgetSkippable should set mFreeingSnowWhite.\n\nPrevent underflow when reporting stats about how many purple objects were removed.\nThis can probably only happen in the early return case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337239\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "d9bd6be9a67efb1c2667ef91a89856f35eb7cf5e", "git_parents": ["72d1731f888320dd7adb222fa68a37c2f80bd679"], "node": "e3f5b185b198689444fa9c533726980c8ab8ce3d", "parents": ["1d5aaf9223f17675ff09a6d7001985807286bcac"], "tags": []}], "date": 1793940082, "git_changesets": ["9332ac41783dd33f8aa5c213ed757ef23e6e497a", "76fa334f55814b1806d253f69dd549e40113778c", "2460dd726fbef33ca8a8dc76facf88f8517400b1", "5bd03dd809029e6e4913b53d0829d601359f5eb1", "94fa84ed6d891cf5dcb0f4b4c3f3e46d319c6fd3", "0aa6447d878d50a29368f555a1f7f2fa57c3196d", "04f0a323b95172c8a1b5acb23164782cbd53b25c", "c9a53467d3fe17fcbf0cb4d26afc7b3ad3510cb9", "f54628b51586614bb4c0064ba82596990cfedbce", "ac5bdf02a5580397cfc3e126048e3a4537547fc4", "d9bfb5b3fc1f8fe9e24815c6838d8c93f62936e0", "be0906c4f1745639c1f4e7ab9ae62d579ab4bf7b", "9d5bc66c73f7ce85d57abe1bd60d47ec35845c68", "758f5ada6e975fca57da2796bbdcd206f2cf01c6", "4dd4ea65d06e8c80b3a1ef70bd243371070a5c23", "62d660b689d8caf5e5c487bf6f69d868ba3db557", "dc797cdb140d118d6d1d28c6806942ae450245a8", "3a65eb8815ac968bbf8deb87bce7a98dfff5978e", "17f4c80abfce96723741ed8e2c912931753c8e50", "8d00d07e6ac71b5f8be1af36789f6b652cf10de2", "fb96402fb7c2ded393c7a7132ce8c57ef86ea99d", "1aab9933ec3d9e65a2c4797734db95aebfcfb14b", "48f96f3b5287576901242b1d5e37305828ce6dc8", "8b351005be9bde666545806034a4a7d479477f39", "58ee7e215166a0e0265d2877921e63d0ca73bb87", "da64cf8ee7b0a8e72881e01aa23b01af1826d0e5", "eadaea71914a3974a8342645df34be5031bc8541", "cab11b8883498064d9c304388d81ee7b79b4f1aa", "009dd4e1a8e6294d8878a75217cfc06c214a8a2f", "d3c4f3f3bf4c8512326c549b6f4ac9d1b789b3ed", "21aaff13a65f71a2b4754315556e51d1333acca5", "fb105582ffa80c3bbd774f909e8dbaf59aa37294", "b2850a6df28f94aac8552c988c42a05a49cc9660", "1920fd3badea65f09c02345b5dee614cb4ce8f99", "9906cd6e2aafb7d428e336fdd6047461d72ca03e", "0e7807a13aec44ff63e8a4c3ae2578fc49b6b843", "628f9255db5d8c49b2113694293dc953deba98d4", "7d2bddcd34c3efb3c8971539664439755fdf3a47", "2851a3b2bd2d89f02b3f26b7e708436b6ba65bfa", "9bb8c7cef7902788a9a0c0aceec8b64a8ef1a201", "73fc13dc29424d1226cbca6d2acc5ad61f74b438", "28b1be3ef8852c7e5d8dad153b942cced185de18", "e95ce609b602b1467d7b7c69e0f19aa28f2e74f7", "090d94712d684d0415dbb896352289901bc61391", "aa9d985f754436b95d33c77e7d796f5d9e578e7b", "413fd42c0e91e4feb4dd931f48df7f315147500d", "b9dc7de79066839aedb8f1b4bbee5035a4fa11d4", "bbe28ea7cfbc0742d8ef99f6db37334d1352d734", "2f8d679a401e4c101aa935ce3ba944d9e512ce17", "d9f6b354672f09d40fd6196ae71145cbd793d7c3", "d1c78497a617a7682f3da6e8319e5890142e8044", "50c50e80cef13281308ff7eb937053e7d0a594fd", "6835dbc3f5dfddeca90a0ca50af88aa1b99710f2", "b7ef70363ef7dd6984d66e1bf1af404e0d093913", "106b4550dbe7b5c7839822dda769aa72cf509a50", "3522debd7109ebfb6083b110614b6f0a7aa7d307", "aaf013f568780e81b0b5b93093c73e9d2ed5cc43", "540e458abe6e484a3993dca49b251600b56831f7", "30a46df6ee8cd020b1363766841df88a4475be53", "3115506424d7f280594725f2fa49f2ab50165cd6", "37cca691cedef019fc0714c25d18c25bff69eaf5", "e207747691c6be0fcff3e1e4695bc6c393010927", "964df8d9e8b4b673e5bf47609c8b1b8f3d01db74", "7df6d05df090eed0915882eb45ed57f97cead3df", "80596e67b24919db05