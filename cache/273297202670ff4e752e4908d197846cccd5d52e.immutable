55956431c", "1af0c8d3cbb92c70a84847b2ec16ce306fdaacbb", "7d1c05e5b9e950a72d6951578092919213c96532", "da99aefb1ba6d5537b39506881092921bae60f76", "40da43c4050a6afd70e769df6830618b447988ff", "73602dfc2d0970c189362ccc505f0c2a9999bc16", "145735c0d0f99ce70e5159db330fa8558ac9b5cb", "f35e967e822dcf3deea7b82a618032a7d26070fd", "722206359759697780a3e840345923c185b2c8cd", "eeb1a3fb3603dcd4c3e7c77d27faf823ba261788"], "user": "abutkovits@mozilla.com"}, "45757": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090042 - Move the desktop-theme skills' token, contrast and pixel-diff scripts into toolkit/themes/tools. r=desktop-theme-reviewers,tgiles\n\nA move with only the import paths fixed. The dashed names take underscores so the mach command in the next patch can import them; screen-grab.py moves too, since probelib.run_steps() runs it from its own directory.\n\nThe skills cite the old paths until the last patch of this bug points them at `./mach theme`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340510\n", "files": [".agents/skills/desktop-theme-colors/scripts/contrast.py", ".agents/skills/desktop-theme-colors/scripts/pair-walk.py", ".agents/skills/desktop-theme-probing/scripts/firefox-probe.py", ".agents/skills/desktop-theme-probing/scripts/marker-probe.py", ".agents/skills/desktop-theme-probing/scripts/probelib.py", ".agents/skills/desktop-theme-probing/scripts/screen-grab.py", ".agents/skills/desktop-theme-screenshots/scripts/pixel-diff.py", ".agents/skills/desktop-theme-tokens/scripts/token-resolve.py", ".claude/skills/desktop-theme-colors/scripts/contrast.py", ".claude/skills/desktop-theme-colors/scripts/pair-walk.py", ".claude/skills/desktop-theme-probing/scripts/firefox-probe.py", ".claude/skills/desktop-theme-probing/scripts/marker-probe.py", ".claude/skills/desktop-theme-probing/scripts/probelib.py", ".claude/skills/desktop-theme-probing/scripts/screen-grab.py", ".claude/skills/desktop-theme-screenshots/scripts/pixel-diff.py", ".claude/skills/desktop-theme-tokens/scripts/token-resolve.py", "toolkit/themes/tools/contrast.py", "toolkit/themes/tools/pair_walk.py", "toolkit/themes/tools/pixel_diff.py", "toolkit/themes/tools/probelib.py", "toolkit/themes/tools/screen-grab.py", "toolkit/themes/tools/token_resolve.py"], "git_node": "d06b063e93e5d967a3d9d9192627c25a4cece2b7", "git_parents": ["eeb1a3fb3603dcd4c3e7c77d27faf823ba261788"], "node": "26b922d5507b211747f27a865a3fd04de47bf44b", "parents": ["1d98215fc30512abebeba96985b2a286d1711377"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2070357 - Refactor ThemeManager.currentTheme to represent the Theme instead of BrowsingMode r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324667\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/ThemeManager.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/theme/ThemeManagerTest.kt"], "git_node": "1b59e104b01e55f183b4094ae42ef6d76f29e263", "git_parents": ["d06b063e93e5d967a3d9d9192627c25a4cece2b7"], "node": "6afb635bda428af0a65b65ebfc74aac529013eb2", "parents": ["26b922d5507b211747f27a865a3fd04de47bf44b"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2067278 - Show the OLED theme in XML UI surfaces r=android-reviewers,007\n\n- Add `OledThemeBase` and `OledTheme`, overriding only the tokens that differ from dark.\n- Set `fenixWordmarkText` explicitly, since values-night overrides it on `NormalTheme` rather than on this style's parent.\n- Drop the `UnusedResources` suppressions for the OLED color tokens.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332105\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/ThemeManager.kt", "mobile/android/fenix/app/src/main/res/values-v27/styles.xml", "mobile/android/fenix/app/src/main/res/values/colors.xml", "mobile/android/fenix/app/src/main/res/values/styles.xml"], "git_node": "37d3e04208a2ee910a8d702df57f828e7720a898", "git_parents": ["1b59e104b01e55f183b4094ae42ef6d76f29e263"], "node": "7624da0f79d6522c5dc39858d579f6e80bed684a", "parents": ["6afb635bda428af0a65b65ebfc74aac529013eb2"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2067279 - Show the OLED theme in Compose UI surfaces r=android-reviewers,007,android-tabs-reviewers,npoon\n\n- Add ThemeProvider.provideNonPrivateTheme() for surfaces that ignore private browsing mode.\n- isOledThemeApplied is needed because the Dark and Darkest RadioButtonPreference both pass MODE_NIGHT_YES, so setNewTheme()'s early return skipped activity.recreate() between them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332106\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/ui/FenixOverlay.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/CustomizationFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/share/ShareFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/theme/TabManagerThemeProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/ThemeProvider.kt"], "git_node": "d3fdb2fa778b551cd44dc226cace5c247d193d51", "git_parents": ["37d3e04208a2ee910a8d702df57f828e7720a898"], "node": "9c750b6205a60bf39660a7ceaa9dfe634cea2686", "parents": ["7624da0f79d6522c5dc39858d579f6e80bed684a"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2040648 - [wptrunner] Pass the adb binary and device serial to wdspec tests on Android. r=jgraham\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338009\n", "files": ["testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox_android.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/base.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/executormarionette.py"], "git_node": "493860168875d5a67360ab7a40422cfbc71744b2", "git_parents": ["d3fdb2fa778b551cd44dc226cace5c247d193d51"], "node": "852f51f7868058f0c68fa59fb47d8f7dc7f0698d", "parents": ["9c750b6205a60bf39660a7ceaa9dfe634cea2686"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2040648 - [wdspec] Check the Firefox PID on the device instead of the host in `mozilla/tests/webdriver/harness/shutdown.py` on Android. r=webdriver-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301295\n", "files": ["testing/web-platform/mozilla/tests/webdriver/harness/shutdown.py", "testing/web-platform/mozilla/tests/webdriver/support/fixtures.py"], "git_node": "062b51ff03d2824656f33a6ce1ddcafa65553d63", "git_parents": ["493860168875d5a67360ab7a40422cfbc71744b2"], "node": "31a6ec110f24ccb5af5ea2c46151bb369fa17ab9", "parents": ["852f51f7868058f0c68fa59fb47d8f7dc7f0698d"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085197: Return null for missing MAR items. r=yjuglaret,application-update-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338608\n", "files": ["modules/libmar/src/mar_read.c", "modules/libmar/tests/TestMARFindItem.cpp", "modules/libmar/tests/moz.build", "testing/cppunittest.toml"], "git_node": "00374b918da7693993ad6334cc7f939d6bc5eb2d", "git_parents": ["062b51ff03d2824656f33a6ce1ddcafa65553d63"], "node": "cbd6ffdab8b0781ef9a2378f5d529c4b25ccc6d5", "parents": ["31a6ec110f24ccb5af5ea2c46151bb369fa17ab9"], "tags": []}, {"author": "Landry Breuil \u003clandry@openbsd.org\u003e", "branch": "default", "desc": "Bug 2057158 - Consider BSDs as Linux-like in ANGLE build system r=gfx-reviewers,bradwerth\n\nPatch ANGLE to ensure Linux system utils files are built on BSD, using\nthe correct pthread setname function. Avoids undefined symbol errors\nat startup on OpenBSD.\n\nWe previously attempted to fix this by building only\nsystem_utils_posix.cpp, but it appears system_utils_linux.cpp is\nrequired as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340736\n", "files": ["gfx/angle/patches/0019-Build-system_utils_posix.cpp-on-BSD.patch", "gfx/angle/patches/0019-Consider-BSD-as-linux-and-use-the-right-function-to-.patch", "third_party/angle/angle_common_gn/moz.build", "third_party/angle/angle_program_version_id_gn/ANGLEShaderProgramVersion.h-da9ca5d47e7c27c1.rsp.in", "third_party/angle/angle_program_version_id_gn/moz.build", "third_party/angle/src/common/system_utils_linux.cpp", "third_party/angle/src/libGLESv2.gni"], "git_node": "9975cdede18c2a36099a1a63dd10cf7ff467d29e", "git_parents": ["00374b918da7693993ad6334cc7f939d6bc5eb2d"], "node": "2948a5f92663b263fa9b479564ffcd05e8288490", "parents": ["cbd6ffdab8b0781ef9a2378f5d529c4b25ccc6d5"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091049 - Hide wallpaper categories with no offered wallpapers. r=Dre\n\nA category whose wallpapers are all gated out by visibility groups (or set\n`visible: false`) no longer shows an empty tile in the Customize panel. The\ncustom wallpaper (\"Your images\") tile always shows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341050\n", "files": ["browser/extensions/newtab/content-src/components/WallpaperCategories/WallpaperCategories.jsx", "browser/extensions/newtab/test/jest/content-src/components/WallpaperCategories/WallpaperCategories.test.jsx"], "git_node": "c3eb2b660a18b684a59ba1aff34981e5494b1884", "git_parents": ["9975cdede18c2a36099a1a63dd10cf7ff467d29e"], "node": "fda071cf77145a0c448b173c33a36cfa6d71a786", "parents": ["2948a5f92663b263fa9b479564ffcd05e8288490"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091052 - Allow setting wallpaper category order and count by pref. r=Dre\n\nAdds `newtabWallpapers.categoryOrder`, a comma-separated category order where\nunlisted categories follow the listed ones, and `newtabWallpapers.maxCategories`,\nthe number of category tiles shown in the Nova layout (default 6, \"Your images\"\nincluded and always kept). Both can be overridden through\n`trainhopConfig.wallpapers`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341051\n", "files": ["browser/extensions/newtab/content-src/components/WallpaperCategories/WallpaperCategories.jsx", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/WallpaperCategories/WallpaperCategories.test.jsx"], "git_node": "ba23064b49f631061db123a31c5e55d37bfb0f61", "git_parents": ["c3eb2b660a18b684a59ba1aff34981e5494b1884"], "node": "b2032db7a21ffdbcd61b672be56ca99492cb3734", "parents": ["fda071cf77145a0c448b173c33a36cfa6d71a786"], "tags": []}, {"author": "Nikolai Nyegaard \u003cnikolai@nyegaard.io\u003e", "branch": "default", "desc": "Bug 2085322 - Do not force session resume after an XSMP logout unless the session manager restarted us. r=sfoster,sessionstore-reviewers,firefox-desktop-core-reviewers ,gtk-reviewers,Gijs,stransky\n\nAt logout an XSMP session manager (ksmserver on KDE Plasma) sends\nSaveYourself. The \"session-save\" handler in BrowserGlue set\nbrowser.sessionstore.resume_session_once unconditionally, so the next\nmanual start restored the session regardless of browser.startup.page.\n\nMirror the Windows -os-restarted mechanism: also set\nbrowser.sessionstore.resuming_after_os_restart, and set gRestartedByOS\nwhen Firefox is started with --sm-client-id. SessionStartup then clears\nresume_session_once on a manual start and keeps it when the session\nmanager restarted Firefox itself.\n\nAdd a Linux-only marionette test that fakes the SaveYourself path and\nchecks both kinds of restart.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338539\n", "files": ["browser/components/BrowserGlue.sys.mjs", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_restore_windows_after_session_manager_logout.py", "toolkit/xre/nsAppRunner.cpp"], "git_node": "8c6412b4920289f4641e9c4fe61786214d3c2fc3", "git_parents": ["ba23064b49f631061db123a31c5e55d37bfb0f61"], "node": "78cca5e1ac614271a8488c09c25e307af07480f9", "parents": ["b2032db7a21ffdbcd61b672be56ca99492cb3734"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2012815 - Declare a tab's splitViewId in session.schema.json. r=sfoster,sessionstore-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339516\n", "files": ["browser/components/sessionstore/session.schema.json"], "git_node": "c6e801f3bae428c0e21f11922bfa4d8a4583dae2", "git_parents": ["8c6412b4920289f4641e9c4fe61786214d3c2fc3"], "node": "eb663b52bdf445bf0f719210acb163aa8b047a5d", "parents": ["78cca5e1ac614271a8488c09c25e307af07480f9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1991409 - Declare the session state properties Firefox writes in session.schema.json, and reject undeclared ones. r=sfoster,sessionstore-reviewers\n\nThe schema moves to draft 2020-12 for `unevaluatedProperties`: draft-07's `additionalProperties: false` beside an `allOf` ignores the properties the `allOf` declares, so every closed window failed validation.\n\n`required` now lists only what every write has. Closed windows, closed tabs and tabs that haven't restored yet are written back as they were loaded, and the session history reader treats an entry's `title` and `hasUserInteraction` as optional.\n\nPrivate, taskbar tab and mini windows are never written, so `isPrivate`, `isTaskbarTab` and `isMiniWindow` stay undeclared.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339517\n", "files": ["browser/components/sessionstore/session.schema.json"], "git_node": "db2f0d5a158e7fa6fe3379a467e8667058d9a268", "git_parents": ["c6e801f3bae428c0e21f11922bfa4d8a4583dae2"], "node": "4c1987303556dd0a808c4abfa2e803e20f7696d9", "parents": ["eb663b52bdf445bf0f719210acb163aa8b047a5d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088825 - Validate session state against session.schema.json on each write when browser.sessionstore.debug.validate_state is set. r=sfoster,sessionstore-reviewers\n\nSessionStore.validateState stops warning about an invalid state: SessionSaver reports it, and test_session_schema.js, its other caller, logs the errors itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339518\n", "files": ["browser/components/sessionstore/SessionSaver.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs", "testing/mochitest/browser-test.js"], "git_node": "1292554319f0f49be5a8a158ebea3ddd315fe73f", "git_parents": ["db2f0d5a158e7fa6fe3379a467e8667058d9a268"], "node": "4c3dc0e1acf02c9060e9470b2e45242f6487ab00", "parents": ["4c1987303556dd0a808c4abfa2e803e20f7696d9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088825 - Validate written session state in the session store browser tests. r=sfoster,sessionstore-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339519\n", "files": ["browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_394759_purge.js", "browser/components/sessionstore/test/browser_formdata_format.js", "browser/components/sessionstore/test/browser_oldformat.toml", "browser/components/sessionstore/test/browser_startup_telemetry.toml"], "git_node": "c589ddcdc8a2500ca71302626260812d6665ce8f", "git_parents": ["1292554319f0f49be5a8a158ebea3ddd315fe73f"], "node": "957d83d6aef791a6ca06d34aa21676a557284673", "parents": ["4c3dc0e1acf02c9060e9470b2e45242f6487ab00"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088825 - Document why most session state properties are optional. r=sfoster,sessionstore-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339520\n", "files": ["browser/components/sessionstore/types/sessionstore.ts"], "git_node": "7ea1944c5888b254435fd11928dc93b647ee90e5", "git_parents": ["c589ddcdc8a2500ca71302626260812d6665ce8f"], "node": "22a673eb66845c9f36a5ab4f8bc32ecf8e15503a", "parents": ["957d83d6aef791a6ca06d34aa21676a557284673"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071352 - Keep the picked VPN location when switching to it fails. r=android-reviewers,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339737\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/reducer/LocationReducer.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/reducer/IPProtectionReducerTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/store/IPProtectionTelemetryMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/store/IPProtectionTelemetryMiddlewareTest.kt"], "git_node": "6d11f67ccfa39665b76161ffc29be4cff34377bf", "git_parents": ["7ea1944c5888b254435fd11928dc93b647ee90e5"], "node": "5f10ccd7f18fa05538d010