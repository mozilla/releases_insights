ngs.sys.mjs", "toolkit/components/search/SearchSuggestionController.sys.mjs", "toolkit/components/search/SearchUtils.sys.mjs", "toolkit/components/translations/TranslationsFeature.sys.mjs", "toolkit/components/translations/TranslationsTelemetry.sys.mjs", "toolkit/components/translations/TranslationsUtils.mjs", "toolkit/components/translations/actors/AboutTranslationsChild.sys.mjs", "toolkit/components/translations/actors/TranslationsChild.sys.mjs", "toolkit/components/translations/actors/TranslationsEngineChild.sys.mjs", "toolkit/components/translations/actors/TranslationsParent.sys.mjs", "toolkit/components/translations/content/translations-document.sys.mjs", "toolkit/modules/AppServicesTracing.sys.mjs", "toolkit/modules/E10SUtils.sys.mjs", "toolkit/modules/OSKeyStore.sys.mjs", "toolkit/modules/PrefUtils.sys.mjs", "toolkit/modules/Region.sys.mjs", "toolkit/modules/ScheduledTask.sys.mjs", "toolkit/modules/Sqlite.sys.mjs", "toolkit/mozapps/defaultagent/DefaultAgentScheduler.sys.mjs", "toolkit/mozapps/downloads/HelperAppDlg.sys.mjs", "toolkit/mozapps/extensions/AddonManager.sys.mjs", "toolkit/mozapps/pushnotificationhelper/PushNotificationHelperRegistry.sys.mjs", "toolkit/mozapps/pushnotificationhelper/WindowsPushNotificationHelper.sys.mjs", "xpcom/tests/unit/test_logFilePrefReset.js"], "git_node": "d6e6e4211833ada92e1c6ae177e7217c797d0071", "git_parents": ["efde83ede50161759a030e995a131a0d6d6db072"], "node": "074a8827c5e2e27e7b7c1667d9275973ccac26c8", "parents": ["ded4ad521c44362f381501aad25ef3706a2112ab"], "tags": []}, {"author": "yazan \u003cyalmacki@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089207 - Only activate CTAParagraph links on keyup when the key was pressed on them. r=omc-reviewers,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339992\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/asrouter/content-src/components/CTAParagraph.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/tests/unit/content-src/components/CTAParagraph.test.jsx"], "git_node": "db03c52ade9360c0dd6ece311ebc6775dcbd84ed", "git_parents": ["d6e6e4211833ada92e1c6ae177e7217c797d0071"], "node": "7ee275b654774f5f936928242795ecbff96b6b6d", "parents": ["074a8827c5e2e27e7b7c1667d9275973ccac26c8"], "tags": []}, {"author": "lottiehope \u003clottie_hope@hotmail.co.uk\u003e", "branch": "default", "desc": "Bug 2082516 - Add a certificate details model to the Trust Panel state. r=android-reviewers,twhite\n\nExposes the subject and issuer fields of the website's certificate so the\ncertificate details sub-page can display them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339621\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/store/CertificateDetails.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/store/TrustPanelState.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/CertificateDetailsTest.kt"], "git_node": "09a764fa691d9fe167f6011d6eac81f27c1928ee", "git_parents": ["db03c52ade9360c0dd6ece311ebc6775dcbd84ed"], "node": "bcb9a12bf522d1a67859febebe177c24ce3233b1", "parents": ["7ee275b654774f5f936928242795ecbff96b6b6d"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049031 - Cleanup all code related to the old \"Privacy\" pane in about:preferences r=settings-reviewers,fluent-reviewers,desktop-theme-reviewers,credential-management-reviewers,reusable-components-reviewers,hjones,timhuang,flod,dimi\n\nprivacy.js used to import permissions-data.mjs and passwords-autofill.mjs on\npage load. privacy.mjs depends on preferences and settings they register, so\nit now imports them itself.\n\nSince permissions-data.mjs now loads with its pane, notificationSettingsEntry\ncan render before its async getControlConfig() resolves. Its static l10nId is\nnow the message without a $count argument.\n\nThe FIPS alert in passwords-autofill.mjs read its strings from elements that\nonly existed in privacy.inc.xhtml; it now formats them through Fluent. The\nprivacy-pane-loaded handler in FormAutofillParent only served the legacy pane.\n\nThe legacy setting groups were removed, and their redesigned replacements lost the 2 suffix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338502\n", "files": ["browser/base/content/test/browser-general/browser_storagePressure_notification.js", "browser/components/preferences/config/passwords-autofill.mjs", "browser/components/preferences/config/permissions-data.mjs", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/findInPage.js", "browser/components/preferences/jar.mn", "browser/components/preferences/main.js", "browser/components/preferences/preferences.js", "browser/components/preferences/preferences.xhtml", "browser/components/preferences/privacy.inc.xhtml", "browser/components/preferences/privacy.js", "browser/components/preferences/tests/credentials/browser_primaryPassword.js", "browser/components/preferences/tests/head-common.js", "browser/components/preferences/tests/privacy/browser_privacy_gpc.js", "browser/components/preferences/tests/privacy/browser_privacy_history_search_l10n_ids.js", "browser/components/preferences/tests/searchResults/browser_search_subdialogs_within_preferences_site_data.js", "browser/components/storybook/docs/README.reusable-widgets.stories.md", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/preferences/preferences.css", "browser/themes/shared/preferences/privacy.css", "browser/tools/mozscreenshots/mozscreenshots/extension/configurations/Preferences.sys.mjs", "stylelint-rollouts.config.js", "toolkit/components/formautofill/FormAutofillParent.sys.mjs", "toolkit/content/widgets/moz-toggle/README.stories.md", "tools/lint/rejected-words.yml"], "git_node": "533878e865752e0548f124b15ce6d7f898678eb2", "git_parents": ["09a764fa691d9fe167f6011d6eac81f27c1928ee"], "node": "eee252af7d7346c4abd87ae65d4bbfae8659f297", "parents": ["bcb9a12bf522d1a67859febebe177c24ce3233b1"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049030 - Cleanup all code related to the old \"Search\" pane in about:preferences r=settings-reviewers,fluent-reviewers,desktop-theme-reviewers,hjones,scunnane,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338503\n", "files": ["browser/components/preferences/config/search.mjs", "browser/components/preferences/jar.mn", "browser/components/preferences/preferences.js", "browser/components/preferences/preferences.xhtml", "browser/components/preferences/search.inc.xhtml", "browser/components/preferences/search.js", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/preferences/preferences.css", "browser/themes/shared/preferences/search.css", "stylelint-rollouts.config.js"], "git_node": "41bac014df92c9c46b74756509f367529453b3d0", "git_parents": ["533878e865752e0548f124b15ce6d7f898678eb2"], "node": "7a908e4aeaa556f6ea685ab1db645909e913fbee", "parents": ["eee252af7d7346c4abd87ae65d4bbfae8659f297"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088569 - Remove the EARLY_BETA_OR_EARLIER branch from browser_bookmarks_checkDefaultBookmarks.js. r=places-reviewers,jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339990\n", "files": ["browser/components/places/tests/browser/browser_bookmarks_checkDefaultBookmarks.js"], "git_node": "4527eec9dd8175322b0f88ecf33ac813ad7f6331", "git_parents": ["41bac014df92c9c46b74756509f367529453b3d0"], "node": "e085c250e3b50018b092f5c277cec73eadce7566", "parents": ["7a908e4aeaa556f6ea685ab1db645909e913fbee"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "2a0ce05bf86f4370d3d831f0758c87998ee1295e", "git_parents": ["4527eec9dd8175322b0f88ecf33ac813ad7f6331", "590340cc7617111fc64ab5d0d1e55083d3b3c16b"], "node": "e8f895d0970ce8c4a1ceda262b9af5e0d94ea565", "parents": ["e085c250e3b50018b092f5c277cec73eadce7566", "81824ca77575493755c1071191c1033c92b0f082"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1998954 - Use new push/replace path for frames. r=dom-core-reviewers,farre\" for causing debug mochitest failures at Navigation.cpp\n\nThis reverts commit c4659d8f38239dc73fe73f09b96de3e1dd614130.\n", "files": ["dom/base/nsFrameLoader.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/navigation-api/__dir__.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-to-srcdoc.html.ini", "testing/web-platform/meta/navigation-api/navigation-history-entry/entries-after-blank-navigation.html.ini", "testing/web-platform/meta/navigation-api/navigation-history-entry/entries-after-blob-navigation.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/traverseTo-navigates-multiple-iframes.html.ini"], "git_node": "02a35ee86dd8616a8b446c0628b16630aa36359c", "git_parents": ["2a0ce05bf86f4370d3d831f0758c87998ee1295e"], "node": "cbd3498b19220caabb50d5cc1442d00638af9e24", "parents": ["e8f895d0970ce8c4a1ceda262b9af5e0d94ea565"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089041 - Clamp the omni.ja readahead length to the archive size in nsZipArchive::BuildFileList (Coverity CID 1704713) r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339630\n", "files": ["modules/libjar/nsZipArchive.cpp"], "git_node": "15c0dd066388859d5173bb9496f1d6c6342f8a29", "git_parents": ["02a35ee86dd8616a8b446c0628b16630aa36359c"], "node": "07743f2679b76265fdb5c30b47c7af96527aaf09", "parents": ["cbd3498b19220caabb50d5cc1442d00638af9e24"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088399 - Record typed_through when no saved logins remain in the dropdown. r=mtigley,credential-management-reviewers\n\nOn login username fields, the \"Manage Passwords\" footer keeps the dropdown\nopen after typing filters out every login. A later close was recorded as\n\"dismissed\". Track when no saved records remain, and report \"typed_through\"\nunless an explicit close reason is set.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339301\n", "files": ["toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_secondary_actions.js", "toolkit/components/satchel/metrics.yaml"], "git_node": "2c79d702253da0ebef71aeeb394a4d4b4e427d09", "git_parents": ["15c0dd066388859d5173bb9496f1d6c6342f8a29"], "node": "7bf93319361f2672469a8d84fec700a0a84113a3", "parents": ["07743f2679b76265fdb5c30b47c7af96527aaf09"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1999512 - Stop closing KsecDD in windows content process sandbox. r=handyman,sandbox-reviewers\n\nWe no longer load the DLLs that open KsecDD ourselves. It is possible that other\ninjected DLLs might, but closing in those cases might cause issues.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338303\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp"], "git_node": "2fb28dd8d91dfc91c8a8234e627e1bda119f43ab", "git_parents": ["2c79d702253da0ebef71aeeb394a4d4b4e427d09"], "node": "fba01e345acee188d9058004bd8a99ce7451d603", "parents": ["7bf93319361f2672469a8d84fec700a0a84113a3"], "tags": []}, {"author": "lottiehope \u003clottie_hope@hotmail.co.uk\u003e", "branch": "default", "desc": "Bug 2082516 - Keep the Trust Panel security info up to date while open. r=android-reviewers,twhite\n\nThe panel is dismissed when its tab navigates to a different host, since the\nrest of its state describes the previous host. QWAC results are tied to the\ncertificate they were requested for, so a late result can't apply to a newer\ncertificate, and the QWAC status is requested again when the certificate changes.\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339089\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/SecurityInfoBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/TrustPanelFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/middleware/TrustPanelMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/middleware/TrustPanelTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/store/TrustPanelAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/store/TrustPanelStore.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/SecurityInfoBindingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/TrustPanelMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/TrustPanelStoreTest.kt"], "git_node": "b1176f2b0be7a5ff9675f80d762707f61e37e3df", "git_parents": ["2fb28dd8d91dfc91c8a8234e627e1bda119f43ab"], "node": "8043e9ba2524eb322b72ebb7a5f0c5e86670ff98", "parents": ["fba01e345acee188d9058004bd8a99ce7451d603"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067871 - Add persistent dismiss and snooze behavior for Smart Window resume cards r=pdahiya,fluent-reviewers,bolsson\n\nPermanently dismiss resume cards with the X and persist \u201cSnooze until tomorrow\u201d for 24 hours through the Journey store.\n\nDelay the loading skeleton briefly to avoid flashing it for fast journey lookups.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339367\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/components/smartwindow-resume-section/smartwindow-resume-section.mjs", "browser/components/aiwindow/ui/modules/ResumeActivity.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_resume_card.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "f2c3375aba65d66ec499d2ab83feaf1f25d9258b", "git_parents": ["b1176f2b0be7a5ff9675f80d762707f61e37e3df"], "node": "3376e021200cd4b2c44162a962e334aa4fd56b1c", "parents": ["8043e9ba2524eb322b72ebb7a5f0c5e86670ff98"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089513 - Notify the listener when the essential domain fallback redirect fails, r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339921\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h", "netwerk/test/unit/test_essential_domain_fallback_redirect_fail.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "0e0221a364b4ebc31f8f72572135badf3275d43d", "git_parents": ["f2c3375aba65d66ec499d2ab83feaf1f25d9258b"], "node": "9db2257faac2ed8b21de1db1ddec894297a35c56", "parents": ["3376e021200cd4b2c44162a962e334aa4fd56b1c"], "tags": []}, {"author": "Sam Johnson \u003csam@scj.me\u003e", "branch": "default", "desc": "Bug 2084520 - Use correct border radius for compact density in extension popups. r=extension-reviewers,rpl\n\nExtension content does not have access to design tokens or chrome, so we must check the browser.uidensity pref to set the correct border-radius value. Unfortunately this doesn't handle automatic compact mode, but is an improvement over the current state.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337152\n", "files": ["browser/components/extensions/extension-popup-panel.css", "browser/components/extensions/test/browser/browser_ext_popup_corners.js"], "git_node": "18043b8f42119af24b7735acd346cd71ba73c422", "git_parents": ["0e0221a364b4ebc31f8f72572135badf3275d43d"], "node": "7bcf6ec9c7dad631a2533dc6641e76a4ec1aa8e8", "parents": ["9db2257faac2ed8b21de1db1ddec894297a35c56"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089088 - Fail KSP tasks when Room generates no database implementation. r=android-reviewers,android-build-system-reviewers,tthibaud,mcarare\n\nKSP can finish successfully without emitting any Room output (google/ksp#3286 under parallel in-process runs),\nwhich otherwise only shows up at runtime as a crash saying the _Impl class does not exist. The expected\ndatabases come from each module's exported Room schema directories rather than from parsing sources, so any\nmodule that exports schemas is covered; today those are all in android-components. The check lives in the\nconventions ProjectPlugin so it also applies to builds rooted at android-components, as the build-components\ntasks are.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339711\n", "files": ["mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt", "mobile/android/gradle/plugins/conventions/src/test/java/org/mozilla/conventions/RoomImplementationCheckTest.kt"], "git_node": "4d3434bb9a8c8e7279b4e33ef72c849d63b1f7b6", "git_parents": ["18043b8f42119af24b7735acd346cd71ba73c422"], "node": "a68e1f9477bb2dca7d2a2c645898c27cd8768c71", "parents": ["7bcf6ec9c7dad631a2533dc6641e76a4ec1aa8e8"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088304 - Use the URLClassifier's top-window fallback for worker requests in ContentClassifierRequest. r=bvandersloot\n\nThis patch moves the worker fallback in\nUrlClassifierCommon::CreatePairwiseEntityListURI into a new\nGetTopWindowURIWithFallback helper and uses it when building a\nContentClassifierRequest. Worker requests have no top window, so the\nclassifier passed an empty source to the engine and $domain= options were\nignored. For example, ttvnw.net loaded by a worker on twitch.tv was\nblocked despite its ~twitch.tv exclusion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339251\n", "files": ["netwerk/url-classifier/UrlClassifierCommon.cpp", "netwerk/url-classifier/UrlClassifierCommon.h", "toolkit/components/content-classifier/content_classifier_engine/ContentClassifierEngine.cpp", "toolkit/components/content-classifier/test/browser/browser.toml", "toolkit/components/content-classifier/test/browser/browser_content_classifier_worker.js"], "git_node": "3a9788c1a5f11fa72491ff25864c8ce71c70837e", "git_parents": ["4d3434bb9a8c8e7279b4e33ef72c849d63b1f7b6"], "node": "c0fbcbe2f715a1674376d754cbd6979cc3446bd6", "parents": ["a68e1f9477bb2dca7d2a2c645898c27cd8768c71"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965500 - Remove WebRender's dependency on crossbeam-channel. r=jrmuizel\n\nThe standard channel implementation is now based on crossbeam's, and we\ndon't use crossbeam-specific features anymore, so we can simply use the\nstandard one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248633\n", "files": ["Cargo.lock", "gfx/wr/Cargo.lock", "gfx/wr/webrender/src/render_api.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender_api/Cargo.toml", "gfx/wr/webrender_api/src/channel.rs", "gfx/wr/webrender_api/src/font.rs", "gfx/wr/webrender_api/src/lib.rs", "gfx/wr/wr_glyph_rasterizer/src/rasterizer.rs"], "git_node": "ac785d1b7768c5d9d59ad003be3073d73bc4a040", "git_parents": ["3a9788c1a5f11fa72491ff25864c8ce71c70837e"], "node": "936661d7bdc6dbe7478faa74c6366c9ad657e04d", "parents": ["c0fbcbe2f715a1674376d754cbd6979cc3446bd6"], "tags": []}, {"author": "Osmond Arnesto \u003coarnesto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005078 - Replace button.footer with moz-button in browser/base/content/ r=places-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326797\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-places.js", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/components/privatebrowsing/ResetPBMPanel.sys.mjs"], "git_node": "e3a79ab92465e49e1058b2de8359865e24082686", "git_parents": ["ac785d1b7768c5d9d59ad003be3073d73bc4a040"], "node": "2ae1c628a1236bd9b7805914ef748d73002934c1", "parents": ["936661d7bdc6dbe7478faa74c6366c9ad657e04d"], "tags": []}, {"author": "Osmond Arnesto \u003coarnesto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005078 - Replace button.footer with moz-button in browser/components/customizableui/ r=desktop-theme-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326812\n", "files": ["browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/customizableui/content/customizeMode.inc.xhtml", "browser/themes/shared/customizableui/customizeMode.css"], "git_node": "a35301b6717cf9a78900f37018809591dc6a9f0a", "git_parents": ["e3a79ab92465e49e1058b2de8359865e24082686"], "node": "7a28769bc11a7d7d2bb71a18c653d6fbbfc3690d", "parents": ["2ae1c628a1236bd9b7805914ef748d73002934c1"], "tags": []}, {"author": "Osmond Arnesto \u003coarnesto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005078 - Replace button.footer with moz-button in browser/components/downloads/ r=akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.c