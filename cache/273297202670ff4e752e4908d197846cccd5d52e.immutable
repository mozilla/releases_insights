.js", "browser/base/content/test/browser-popups/browser_popup_blocker.js", "browser/components/asrouter/modules/InfoBar.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_infobar.js", "browser/components/nimbus/Heartbeat.sys.mjs", "browser/components/urlbar/tests/browser-search/browser_searchSingleWordNotification.js", "browser/modules/test/browser/browser_ProcessHangNotifications.js", "browser/modules/test/browser/browser_ReducedProtectionNotification.js", "dom/media/doctor/test/browser/browser_decoderDoctor.js", "toolkit/components/url-classifier/tests/mochitest/test_reporturl.html", "toolkit/content/tests/chrome/test_notificationbox.xhtml", "toolkit/content/widgets/notificationbox.js", "uriloader/exthandler/tests/mochitest/browser_ftp_protocol_handlers.js", "uriloader/exthandler/tests/mochitest/browser_web_protocol_handlers.js"], "git_node": "27ff3068f6069c553344d03747523d7420811b65", "git_parents": ["d19513b12b2b842aaadc5a3e1a79ca9d76592685"], "node": "aa7f931f24e2f51ae76606d6ac62cf386f6b1a94", "parents": ["4da1dc7ec0f8830b9ad8720c5dce8558f7060962"], "tags": []}, {"author": "Osmond Arnesto \u003coarnesto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005078 - Remove unused .footer-button CSS r=desktop-theme-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328712\n", "files": ["browser/themes/shared/downloads/downloads.inc.css", "browser/themes/shared/translations/panel.css"], "git_node": "d13b1ab8a543f1a9c551c8e69433f5317be94f86", "git_parents": ["27ff3068f6069c553344d03747523d7420811b65"], "node": "009b8d0f92ca4c69df7ef27b71ccc14aaac30171", "parents": ["aa7f931f24e2f51ae76606d6ac62cf386f6b1a94"], "tags": []}, {"author": "Benjamin VanderSloot \u003cbvandersloot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084004 - Consolidate FedCM enablement checks in WebIdentityParent. r=emz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340496\n", "files": ["dom/credentialmanagement/identity/WebIdentityParent.cpp"], "git_node": "3d102ba7c44c23d65b0a9b4f13b72f2c30f881aa", "git_parents": ["d13b1ab8a543f1a9c551c8e69433f5317be94f86"], "node": "360222b024699af3c4c618246b5ebdc872daf67a", "parents": ["009b8d0f92ca4c69df7ef27b71ccc14aaac30171"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1624878 - Keep cached intermediates attachments until they are imported. r=jschanck\n\nIntermediatePreloads called attachments.deleteAll() after every run, deleting\nevery cached attachment of the collection (~1,900 after a bundle import) in one\nIndexedDB transaction that the profile-before-change blocker has to wait for.\n\nOnly delete the attachments of the records handled in the run, and the whole\ncache once nothing is left waiting, so the remaining intermediates are imported\nfrom the cached bundle instead of being downloaded one by one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341258\n", "files": ["security/manager/ssl/RemoteSecuritySettings.sys.mjs", "security/manager/ssl/tests/unit/test_intermediate_preloads.js"], "git_node": "b4a977d317817389097e0fdcd5be441455a3a823", "git_parents": ["3d102ba7c44c23d65b0a9b4f13b72f2c30f881aa"], "node": "2efbc959ca8008ade63fbe7e0af11599e8660fdb", "parents": ["360222b024699af3c4c618246b5ebdc872daf67a"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1624878 - Delete Remote Settings attachments in chunks and stop at shutdown. r=remote-settings-reviewers,leplatrem\n\nDeleting many attachments at once was a single IndexedDB transaction, which the\n\"RemoteSettingsClient - finish IDB access.\" shutdown blocker had to wait for.\nDelete them in transactions of 50 instead, and stop between transactions once\napp shutdown has started, so shutdown waits for at most one of them. Bulk\ndeletes requested after quit-application are now refused rather than run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341259\n", "files": ["services/settings/Database.sys.mjs", "services/settings/RemoteSettingsClient.sys.mjs", "services/settings/test/unit/test_shutdown_handling.js"], "git_node": "b100228694be4520ef39901a634383d48031187f", "git_parents": ["b4a977d317817389097e0fdcd5be441455a3a823"], "node": "96490658337973521fd65136fc1689e745d40b71", "parents": ["2efbc959ca8008ade63fbe7e0af11599e8660fdb"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2089775. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341345\n", "files": ["dom/xslt/xslt/txMozillaXMLOutput.cpp"], "git_node": "2fc928d24fc48ca4b6d3e7980b3d38269851b490", "git_parents": ["b100228694be4520ef39901a634383d48031187f"], "node": "e3eae678a36b71a033dbb93776521079430bbec7", "parents": ["96490658337973521fd65136fc1689e745d40b71"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2090289. r=smaug\n\nUsing the fix provided in the report.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341348\n", "files": ["dom/xml/nsXMLContentSink.cpp", "dom/xslt/xslt/txMozillaTextOutput.cpp"], "git_node": "eb7130b13dc76bea55c4160888096ecb6c1638af", "git_parents": ["2fc928d24fc48ca4b6d3e7980b3d38269851b490"], "node": "21976baa403ce0bf02d57554d5a6b45bda75b213", "parents": ["e3eae678a36b71a033dbb93776521079430bbec7"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089477 - Apply END_STREAM after the whole HTTP/2 header block is received, r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341347\n", "files": ["netwerk/protocol/http/Http2Session.cpp", "netwerk/protocol/http/Http2Session.h", "netwerk/test/unit/test_h2_continuation_end_stream.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "80fd34050d756b8ef2d1be95614c10cb93281434", "git_parents": ["eb7130b13dc76bea55c4160888096ecb6c1638af"], "node": "afe3c615f685e99acd3ae5cc04f93b607e1ad7c6", "parents": ["21976baa403ce0bf02d57554d5a6b45bda75b213"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2088645 - HidePopover if re-opened during attribute change r=dom-core-reviewers,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341461\n", "files": ["dom/html/nsGenericHTMLElement.cpp"], "git_node": "b9eee9efd9205c1c3af5e40431d04a6635aa7852", "git_parents": ["80fd34050d756b8ef2d1be95614c10cb93281434"], "node": "61fed7ae8f866b173e086efb7bdb9465c3fa3b1a", "parents": ["afe3c615f685e99acd3ae5cc04f93b607e1ad7c6"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2061216 - Update the audio configuration support check in WebCodecs. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339326\n", "files": ["dom/media/webcodecs/AudioDecoder.cpp"], "git_node": "a0b92c96173cda22296691ce50dc15c66aadc88f", "git_parents": ["b9eee9efd9205c1c3af5e40431d04a6635aa7852"], "node": "06d281cc395c15b369859ccb18acbd05a0972569", "parents": ["61fed7ae8f866b173e086efb7bdb9465c3fa3b1a"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2061216 - Update configuration checks in the AudioToolbox audio decoder. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339327\n", "files": ["dom/media/platforms/apple/AppleATDecoder.cpp"], "git_node": "152587f28bfab5add89392b96cebc4d9f366188c", "git_parents": ["a0b92c96173cda22296691ce50dc15c66aadc88f"], "node": "16f6b62d7bd73b15a3ceffab0cfa423930d368e8", "parents": ["06d281cc395c15b369859ccb18acbd05a0972569"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2084409 - Drop the scene builder's raster space stack r=gfx-reviewers,nical\n\nIts only reader was add_text, and text runs are interned at push time now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340768\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_item.rs"], "git_node": "fad396ecd4ab0d7845e3696c9783aca2013d4abc", "git_parents": ["152587f28bfab5add89392b96cebc4d9f366188c"], "node": "4e2c37ed14a574ac183d252a2c1ccf2190bd9ea6", "parents": ["16f6b62d7bd73b15a3ceffab0cfa423930d368e8"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2084410 - Remove the gradient stops marker from the display list r=gfx-reviewers,nical\n\nStops travel inside the interned gradient since bug 2084405, so\nSetGradientStops and its plumbing have no users.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340769\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/wrshell/src/wrench.rs"], "git_node": "6171dc5bebfafbdca1c48d7ca96da09a3fb99ca6", "git_parents": ["fad396ecd4ab0d7845e3696c9783aca2013d4abc"], "node": "f6124a40704e5e7d77bdd166950bb053f59e98a5", "parents": ["4e2c37ed14a574ac183d252a2c1ccf2190bd9ea6"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2091260 - Remove hard-coded Smart Window from strings, expose about:addons notice for localization. r=extension-reviewers,gcardieri,rpl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341236\n", "files": ["browser/locales-preview/aiWindow.ftl", "toolkit/locales-preview/smartWindow-aboutAddons.ftl", "toolkit/locales/en-US/toolkit/about/aboutAddons.ftl", "toolkit/locales/jar.mn", "toolkit/mozapps/extensions/content/aboutaddons.html"], "git_node": "d2003aaade094135b8e443dcfdd4842203e90385", "git_parents": ["6171dc5bebfafbdca1c48d7ca96da09a3fb99ca6"], "node": "6573ddcc4c33e5787d3ac2703ce3188a4dae1ff7", "parents": ["f6124a40704e5e7d77bdd166950bb053f59e98a5"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091198 - Update irregexp to f8e74b163471aba777cfe6b5e570465c8f8c238f r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341202\n", "files": ["js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-compiler.cc", "js/src/irregexp/imported/regexp-compiler.h", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h", "js/src/irregexp/moz.yaml"], "git_node": "71f4264116dbbefc73055cdada0505b0839016be", "git_parents": ["d2003aaade094135b8e443dcfdd4842203e90385"], "node": "53980e13c1bd7647f0f4ea642891de31e1e6833a", "parents": ["6573ddcc4c33e5787d3ac2703ce3188a4dae1ff7"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091198 - Apply mozilla patches for irregexp r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341203\n", "files": ["js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h"], "git_node": "12b00ff6f7b7dddaf93430b3055236518a5c3a74", "git_parents": ["71f4264116dbbefc73055cdada0505b0839016be"], "node": "861425d6ff7d89390c7c7b0f654b06cf5b48e121", "parents": ["53980e13c1bd7647f0f4ea642891de31e1e6833a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move `OUTOPTION` and `HOST_OUTOPTION` from `rules.mk` to `moz.configure` r=firefox-build-system-reviewers,sergesanspaille\n\n`moz.configure` sets them as `CC_OUTOPTION` and `HOST_CC_OUTOPTION`. A\nWindows to Windows cross build with a host compiler other than clang-cl now\nfails at configure time instead of when Make reads `rules.mk`. Host compiles\non a Windows host building for another OS now pass `-Fo` to clang-cl instead\nof `-o `.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340108\n", "files": ["build/moz.configure/toolchain.configure", "config/rules.mk", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": "eb94d08b5a719516f69641cbd2de9172e9c7e65e", "git_parents": ["12b00ff6f7b7dddaf93430b3055236518a5c3a74"], "node": "aed7f954daf2552c8e1ff1b991294a2424062e93", "parents": ["861425d6ff7d89390c7c7b0f654b06cf5b48e121"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the shared library SONAME from `MKSHLIB` to `SharedLibrary.dso_link_flags` r=firefox-build-system-reviewers,sergesanspaille\n\nThe elfhack test libraries no longer get a SONAME. Their checks read the\ndynamic section and load them by path, so none of them needs one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340113\n", "files": ["build/moz.configure/toolchain.configure", "build/unix/elfhack/Makefile.in", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "256dd7d95f373cb469d2acac5b8baa4483d6b1b3", "git_parents": ["eb94d08b5a719516f69641cbd2de9172e9c7e65e"], "node": "caf4a4e8ff1d6f548c11328894dbeb6407b71b36", "parents": ["aed7f954daf2552c8e1ff1b991294a2424062e93"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the clang plugin `CC` and `CXX` rewrite from `static-checking-config.mk` to `toolchain.configure` r=firefox-build-system-reviewers,sergesanspaille\n\nEvery reader of `CC` and `CXX` now gets the command that runs, including the\ncompile database and the `USE_INTEGRATED_CLANGCL_AS` assembler.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340114\n", "files": ["build/moz.configure/rust.configure", "build/moz.configure/toolchain.configure", "config/static-checking-config.mk", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": "4fb72badeea4bb5792f59a1b78292ca8e13209f5", "git_parents": ["256dd7d95f373cb469d2acac5b8baa4483d6b1b3"], "node": "33dfb5c939028325d162f6f81fc782588e47ba29", "parents": ["caf4a4e8ff1d6f548c11328894dbeb6407b71b36"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the clang plugin `WASM_CXX` rewrite from `static-checking-config.mk` to `toolkit/moz.configure` r=firefox-build-system-reviewers,sergesanspaille\n\nThe wasm archive link keeps clang++ through the new `WASM_CXX_LINK`.\n`clang_plugin_enabled` wraps the option because a `@depends` in the wasm\n`only_when` block cannot depend on an option declared with a different `when`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340115\n", "files": ["build/moz.configure/toolchain.configure", "config/config.mk", "config/rules.mk", "config/static-checking-config.mk", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py", "python/mozbuild/mozbuild/test/configure/test_toolkit_moz_configure.py", "toolkit/moz.configure"], "git_node": "fc01f0df0a753e29051f2971da30c6ac2da14dc9", "git_parents": ["4fb72badeea4bb5792f59a1b78292ca8e13209f5"], "node": "43dd4200e27e59e4e2c80ffa0b78145de510b41a", "parents": ["33dfb5c939028325d162f6f81fc782588e47ba29"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Fix the Rust test library search path comment in `common.py` r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340116\n", "files": ["python/mozbuild/mozbuild/backend/common.py"], "git_node": "d6cfa5120e9342f1ed78ff1332af6d307ff8ad16", "git_parents": ["fc01f0df0a753e29051f2971da30c6ac2da14dc9"], "node": "4260e19a23d4607d41888cc4fc411132187a323d", "parents": ["43dd4200e27e59e4e2c80ffa0b78145de510b41a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the shared library PDB path from `MKSHLIB` to `SharedLibrary.dso_link_flags` r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341088\n", "files": ["build/moz.configure/toolchain.configure", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "7e8807e3eec0ca0d3f8a15c15435ed62e6f690d8", "git_parents": ["d6cfa5120e9342f1ed78ff1332af6d307ff8ad16"], "node": "7ccb3f16c983c82ecdab2bbc5a3235a8ad44ea09", "parents": ["4260e19a23d4607d41888cc4fc411132187a323d"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the shared library link command from `toolchain.configure` to `rules.mk` r=firefox-build-system-reviewers,sylvestre\n\nConfigure no longer writes Make syntax into `MKSHLIB` and `MKCSHLIB`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341097\n", "files": ["build/moz.configure/toolchain.configure", "config/makefiles/debugmake.mk", "config/rules.mk"], "git_node": "630eef3664f59775777be02bce39b22be2e04ac8", "git_parents": ["7e8807e3eec0ca0d3f8a15c15435ed62e6f690d8"], "node": "3ecce90b1e1398b1b8dec42a1e115e2b65a28c12", "parents": ["7ccb3f16c983c82ecdab2bbc5a3235a8ad44ea09"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Skip simple programs in the profile generate pass before writing their linkage r=firefox-build-system-reviewers,sylvestre\n\nThe profile generate pass does not build simple programs, so the backend now\nskips everything it wrote for them in that pass: the `_OBJS` and link rules,\nthe libraries, the build order edges, the test support install and the `syms`\ntraversal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341099\n", "files": ["python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "b68ee02b890af9cad9c3ec37ad8ed8cdbe28d996", "git_parents": ["630eef3664f59775777be02bce39b22be2e04ac8"], "node": "68680780440ba54c53b4c74f96e26f7ba731250c", "parents": ["3ecce90b1e1398b1b8dec42a1e115e2b65a28c12"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 1844400: Rename enable-ic-frame-pointers to enable-stub-frame-pointers r=perftest-reviewers,sparky,spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336910\n", "files": ["docs/performance/jit_profiling_with_samply.md", "js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/BaselineCacheIRCompiler.h", "js/src/jit/JitOptions.cpp", "js/src/jit/JitOptions.h", "js/src/shell/js.cpp", "taskcluster/gecko_taskgraph/transforms/test/raptor.py", "testing/raptor/raptor/perf_profile.py", "testing/raptor/raptor/samply_profile.py"], "git_node": "1b497a6ea1762014aeeb52c1005387701c2f5c64", "git_parents": ["b68ee02b890af9cad9c3ec37ad8ed8cdbe28d996"], "node": "1ca7d36f7c4fe58e02d2b6c1f4c9cea7150da55b", "parents": ["68680780440ba54c53b4c74f96e26f7ba731250c"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 1844400: Support frame pointers in generic call trampoline r=spidermonkey-reviewers,jandem\n\nThis makes the generic call trampoline about 5-10% slower in a microbenchmark, so we don't want to do it by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336911\n", "files": ["js/src/jit-test/tests/ion/call-generic-stub-frame-pointers.js", "js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.h"], "git_node": "d841607f5db5eddf32e6dea26940d53baf0deafb", "git_parents": ["1b497a6ea1762014aeeb52c1005387701c2f5c64"], "node": "e5e902f33a00db92cfca2b026178ec657e7cb2a3", "parents": ["1ca7d36f7c4fe58e02d2b6c1f4c9cea7150da55b"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084754: Support stub frames in the megamorphic load stub r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337317\n", "files": ["js/src/jit/CodeGenerator.cpp"], "git_node": "6b01a02c24db387d37610dc7aea9b7443f7aee30", "git_parents": ["d841607f5db5eddf32e6dea26940d53baf0deafb"], "node": "920cb48f8995f851c42bbbfc349a32bb8d599ae8", "parents": ["e5e902f33a00db92cfca2b026178ec657e7cb2a3"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes mobile-merino-manifest ct-logs r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341552\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "netwerk/dns/effective_tld_names.dat", "securi