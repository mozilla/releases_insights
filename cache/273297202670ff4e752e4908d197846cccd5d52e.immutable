2c7fb5c429b50bfbac9d6c20cf9c2c2436bf", "parents": ["d07b42c884754640c4317f5aa1c311d504ad2f95"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2094934 - Prune old synced tabs records when legacy clients disable engine r=markh,sync-reviewers\" for causing failures on test_remote_tabs.\n\nThis reverts commit d63667c96f630d22640974b2d751127eee88b057.\n", "files": ["services/sync/modules/SyncedTabs.sys.mjs", "services/sync/modules/engines/tabs.sys.mjs", "services/sync/tests/unit/test_syncedtabs.js", "services/sync/tests/unit/test_tab_engine.js"], "git_node": "b844fbf1858f44d0ec9c1f4be331fdc1d067ae16", "git_parents": ["d7e43f86ba71b7947cc9d86e20c5ef1e6dca7055"], "node": "541eacbc365adcc179a98d8ebf9b3d41a550108a", "parents": ["6cf22c7fb5c429b50bfbac9d6c20cf9c2c2436bf"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2094608 - Tell agents to report an outdated tool instead of working around it. r=ai4dev-reviewers,suhaib DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343933\n", "files": ["AGENTS.md"], "git_node": "9a353dbb32bb4d37fa11478ee35038c9560e46e6", "git_parents": ["b844fbf1858f44d0ec9c1f4be331fdc1d067ae16"], "node": "a3034e558ec353fca03525fc6e5a503363298e9e", "parents": ["541eacbc365adcc179a98d8ebf9b3d41a550108a"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 2059560 - Suppress the ButtonStyleXmlDetector inline of usages. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344237\n", "files": ["mobile/android/android-components/components/feature/addons/lint-baseline.xml", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_footer_section_item.xml", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_fragment_dialog_addon_installed.xml", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_fragment_dialog_addon_permissions.xml", "mobile/android/android-components/components/feature/downloads/lint-baseline.xml", "mobile/android/android-components/components/feature/downloads/src/main/res/layout/mozac_download_cancel.xml", "mobile/android/android-components/components/feature/downloads/src/main/res/layout/mozac_downloads_prompt.xml", "mobile/android/android-components/components/feature/prompts/lint-baseline.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/layout/mozac_feature_prompt_save_credit_card_prompt.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/layout/mozac_feature_prompt_save_login_prompt.xml", "mobile/android/android-components/components/feature/sitepermissions/lint-baseline.xml", "mobile/android/android-components/components/feature/sitepermissions/src/main/res/layout/mozac_site_permissions_prompt.xml", "mobile/android/focus-android/app/lint-baseline.xml", "mobile/android/focus-android/app/src/main/res/layout/fragment_exceptions_domains.xml", "mobile/android/focus-android/app/src/main/res/layout/fragment_search_suggestions.xml"], "git_node": "8ead7bab73337e0af24d8b5d69b477b56faf1bd5", "git_parents": ["9a353dbb32bb4d37fa11478ee35038c9560e46e6"], "node": "186515d12f2bc64dd0812ec9237f338d65bfc9a5", "parents": ["a3034e558ec353fca03525fc6e5a503363298e9e"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2093722 - Use a dedicated NodeHTTP2Server for the Alt-Svc tests in test_freshconnection_origin_attributes.js and test_altsvc.js. r=necko-reviewers,jesup\n\nOn Android the adb reverse for the shared moz-http2 port can go missing\nmid-run. Each NodeHTTP2Server sets up its own forwarding, so the tests no\nlonger depend on it. The /altsvc-test path is removed from moz-http2.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344052\n", "files": ["netwerk/test/unit/test_altsvc.js", "netwerk/test/unit/test_freshconnection_origin_attributes.js", "testing/xpcshell/moz-http2/moz-http2.js"], "git_node": "4a6b72f871477210f55e6ebae27779a4f12d232f", "git_parents": ["8ead7bab73337e0af24d8b5d69b477b56faf1bd5"], "node": "22771c5a23733e9dc3bd5897d1af3af46b766f7d", "parents": ["186515d12f2bc64dd0812ec9237f338d65bfc9a5"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094261 part 1 - Merge the two SetLengthProperty overloads. r=iain\n\nOne took `uint32_t` and the other `uint64_t`. Keeping just the `uint64_t` version\ndoesn't affect performance and simplifies the next patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343838\n", "files": ["js/src/builtin/Array.cpp", "js/src/builtin/Array.h"], "git_node": "48b7f82a4e8453a91500900df8477495f3b2f454", "git_parents": ["4a6b72f871477210f55e6ebae27779a4f12d232f"], "node": "16f54530ed82152dc742d7e6218f5e638eb403d3", "parents": ["22771c5a23733e9dc3bd5897d1af3af46b766f7d"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094261 part 2 - Factor out CanFastTrimDenseElementsForNewLength and TrimDenseElementsForNewLength helpers. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343839\n", "files": ["js/src/builtin/Array.cpp"], "git_node": "bf1a33dd36e76a042a869b1ac3f771786007555d", "git_parents": ["48b7f82a4e8453a91500900df8477495f3b2f454"], "node": "728c6f3dcadda61daf880b7526b34de27a0065fd", "parents": ["16f54530ed82152dc742d7e6218f5e638eb403d3"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094261 part 3 - Add a fast path for setting array length. r=iain\n\n`js::ArraySetLength` is relatively slow because it uses property descriptors and\nhas to handle all spec edge cases.\n\nOn micro-benchmarks this fast path improves `splice` up to 30% and setting\n`.length` up to 60%. The fast path handles all array cases we see on JetStream.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343840\n", "files": ["js/src/builtin/Array.cpp", "js/src/jit-test/tests/arrays/set-length-fast-path.js", "js/src/jit/VMFunctions.cpp"], "git_node": "7be4dddee22ea0e2d093178c82454b821bebb89f", "git_parents": ["bf1a33dd36e76a042a869b1ac3f771786007555d"], "node": "e85287c2b28677c841e578f03c2434de84184655", "parents": ["728c6f3dcadda61daf880b7526b34de27a0065fd"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094261 part 4 - Remove unnecessary arguments from ArrayLengthGetter, ArrayLengthSetter and ArraySetLength. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343841\n", "files": ["js/src/builtin/Array.cpp", "js/src/builtin/Array.h", "js/src/jit/VMFunctions.cpp", "js/src/vm/NativeObject.cpp", "js/src/vm/NativeObject.h"], "git_node": "e01450be07995211f37d124ca862550e97e2d4d4", "git_parents": ["7be4dddee22ea0e2d093178c82454b821bebb89f"], "node": "6e53e5f2ecbd87f2a330233954982521ff19449b", "parents": ["e85287c2b28677c841e578f03c2434de84184655"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2092063 - Part 1: Don't keep hidden scrollbars up to date. r=layout-reviewers,emilio\n\nPushing the position, maximum position and page increment into a hidden\nscrollbar dirties its slider, and toggling its enabled state restyles it, even\nthough none of that is observable. So e.g. every showModal() of a dialog with\nnothing to scroll needed another style and layout flush.\n\nShowing a scrollbar always goes through LayoutScrollbars(), whose reflow\ncallback brings it up to date, so hidden scrollbars can just be skipped.\nScrollbarCurPosChanged() now ignores their stale position, which would\notherwise scroll that axis back to it.\n\nscrollbar-gutter-reflow-counts-001.html measured each case right after the\nother with the same geometry, so the reference run reshowed a scrollbar that\nstill had the values it needed, and skipped the slider reflow the\nscrollbar-gutter run had to pay. It now rebuilds the scroll container between\nmeasurements, as the writing-mode cases already did.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343894\n", "files": ["layout/generic/ScrollContainerFrame.cpp", "layout/generic/ScrollContainerFrame.h", "testing/web-platform/mozilla/tests/css/css-overflow/scrollbar-gutter-reflow-counts-001.html"], "git_node": "d0da298f4305b25c6c13ab4ea7872f5922662f5d", "git_parents": ["e01450be07995211f37d124ca862550e97e2d4d4"], "node": "38b686bdd520d59aee610e3458c740a368a1d7fc", "parents": ["6e53e5f2ecbd87f2a330233954982521ff19449b"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2092063 - Part 2: Treat hidden scrollbar parts like content-visibility: hidden content. r=layout-reviewers,emilio\n\nHidden scrollbars, and the scroll corner unless both scrollbars are shown (it\ncan't take up any space otherwise), used to be reflowed with an empty rect every\ntime the scrollbars were laid out.\n\nLike content hidden by content-visibility, they're now neither reflowed nor\npainted, and keep their dirty bits until they're shown, which reflows them. They\njust get their empty rect, without the overflow left over from when they were\nlast shown. IsScrollbarPartShown() is the one place that decides what's shown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336563\n", "files": ["layout/generic/ScrollContainerFrame.cpp", "layout/generic/ScrollContainerFrame.h"], "git_node": "95a6289da59846306001aa0723fe0a71fea64068", "git_parents": ["d0da298f4305b25c6c13ab4ea7872f5922662f5d"], "node": "847a0609ffbcc39ff7e5cbb441c2d6846fe01bc5", "parents": ["38b686bdd520d59aee610e3458c740a368a1d7fc"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the depfile path from the configured `_DEPEND_CFLAGS` to `config.mk` r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340111\n", "files": ["build/moz.configure/toolchain.configure", "config/config.mk", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": "5a7d2fb51af9dd4357ce23f16997de9bfa391655", "git_parents": ["95a6289da59846306001aa0723fe0a71fea64068"], "node": "c2c33133d1975a1a2d76fb328f48a839cc03df7f", "parents": ["847a0609ffbcc39ff7e5cbb441c2d6846fe01bc5"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the archive output path from `AR_FLAGS` to the `rules.mk` archive recipe r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340110\n", "files": ["build/moz.configure/toolchain.configure", "config/rules.mk", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": "140dc8e2ed2b53a6a6f9ee5e05215f5721ff5373", "git_parents": ["5a7d2fb51af9dd4357ce23f16997de9bfa391655"], "node": "b5f07aa674e0ea708a5e916e700fd1e2a6d40fba", "parents": ["c2c33133d1975a1a2d76fb328f48a839cc03df7f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the clang plugin ordering from `recurse.mk` to a `compiler_plugin` declaration in `build/clang-plugin/moz.build` r=firefox-build-system-reviewers,sergesanspaille\n\nA host shared library can be declared a compiler plugin, and the backend\norders the compiles of every directory with flags in the `COMPILER_PLUGIN`\ncategory after it. That category and the `COMPILER_PLUGIN_FLAGS` configure\nvalue replace `CLANG_PLUGIN` and `CLANG_PLUGIN_FLAGS`, so the frontend and the\nbackend no longer name the clang plugin. The plugin tests wait for the plugin\nlike any other consumer, and the rest of the tree no longer waits for the\ntests. Directories that clear `COMPILER_PLUGIN` no longer wait for the plugin.\n\ncomm-central needs the same rename in `third_party/rnpdefs.mozbuild`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341087\n", "files": ["build/clang-plugin/moz.build", "build/moz.configure/clang_plugin.configure", "build/templates.mozbuild", "build/unix/elfhack/inject/moz.build", "build/unix/stdc++compat/moz.build", "config/recurse.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/consumer/consumer.cpp", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/consumer/moz.build", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/moz.build", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/plugin/moz.build", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/plugin/plugin.cpp", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/plugin/tests/moz.build", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/plugin/tests/test.cpp", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/program/moz.build", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/program/prog.cpp", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/unchecked/moz.build", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/unchecked/unchecked.cpp", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/wasm/a.c", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/wasm/gen.py", "python/mozbuild/mozbuild/test/backend/data/clang-plugin/wasm/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/frontend/data/compiler-plugin-no-library/moz.build", "python/mozbuild/mozbuild/test/frontend/test_emitter.py"], "git_node": "43f5fcbcbb31f26feec1b9de48cc2a14dd6d8aa1", "git_parents": ["140dc8e2ed2b53a6a6f9ee5e05215f5721ff5373"], "node": "53a3c64101a4a7ac5e1b0fc84a1bacc9f806e7c6", "parents": ["b5f07aa674e0ea708a5e916e700fd1e2a6d40fba"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the program PDB path from `rules.mk` to the backend r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341089\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "ac36eb609638953b64b37720d1468df911209569", "git_parents": ["43f5fcbcbb31f26feec1b9de48cc2a14dd6d8aa1"], "node": "06f7be60c48df8b967a566562714aff5412a9703", "parents": ["53a3c64101a4a7ac5e1b0fc84a1bacc9f806e7c6"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the host PDB path from `rules.mk` to the backend r=firefox-build-system-reviewers,sergesanspaille\n\nHost programs linked by clang-cl keep `-PDB:` without `-DEBUG`, so they only\nwrite a PDB when `HOST_LDFLAGS` from the environment enables debug info.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341090\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "993c6ac488f8213e8426ae4b0758d94c6541e4bc", "git_parents": ["ac36eb609638953b64b37720d1468df911209569"], "node": "007986da4c4672ce72a20cf9c3355ada976d93c3", "parents": ["06f7be60c48df8b967a566562714aff5412a9703"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the `MacOSBundle` spec from `RecursiveMakeBackend` to `CommonBackend` r=firefox-build-system-reviewers,sylvestre\n\n`CommonBackend` writes each bundle's assembly spec and lists every spec in\n`macos-bundles.json`, with whether the bundle stages `dist/bin`.\n`RecursiveMakeBackend` writes only the rules that run\n`assemble_macos_bundle`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341101\n", "files": ["python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "7d86c5347bf98973f21c0b5ba92a3b31036c2c78", "git_parents": ["993c6ac488f8213e8426ae4b0758d94c6541e4bc"], "node": "b22f60044bb92dbdbbeca9e809d38e973b561643", "parents": ["007986da4c4672ce72a20cf9c3355ada976d93c3"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094580 - Fix use of JitScript::hasBaselineScript from profiler thread r=spidermonkey-reviewers,iain\n\nThis isn't safe to call from the profiler thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344035\n", "files": ["js/src/jit/JSJitFrameIter.cpp"], "git_node": "78ddbfede423286527d80c9e8dec34f8c1aaa428", "git_parents": ["7d86c5347bf98973f21c0b5ba92a3b31036c2c78"], "node": "bbce236164ff1c7773414558c9e7cccfb5ca83c9", "parents": ["b22f60044bb92dbdbbeca9e809d38e973b561643"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069243 - Move Container Storage Layer into A-S - part 3 - Add migration tests r=timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329039\n", "files": ["toolkit/components/contextualidentity/tests/unit/test_migratedFile.js"], "git_node": "9dedd78c054e56dbead1f29820fea8dfe567e2bc", "git_parents": ["78ddbfede423286527d80c9e8dec34f8c1aaa428"], "node": "aec06ee2607de74020d740a48dcd3bf68a2f2c3e", "parents": ["bbce236164ff1c7773414558c9e7cccfb5ca83c9"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069243 - Move Container Storage Layer into A-S - part 4 - ContextualIdentityService r=timhuang,webdriver-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329040\n", "files": ["remote/shared/UserContextManager.sys.mjs", "remote/shared/test/browser/browser_UserContextManager.js", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/components/contextualidentity/tests/unit/test_basic.js", "toolkit/components/contextualidentity/tests/unit/test_containersStore.js", "toolkit/components/contextualidentity/tests/unit/test_corruptedFile.js", "toolkit/components/contextualidentity/tests/unit/test_migratedFile.js", "toolkit/components/contextualidentity/tests/unit/test_siteAssociations.js", "toolkit/components/contextualidentity/tests/unit/xpcshell.toml", "toolkit/components/extensions/test/xpcshell/test_ext_contextual_identities.js"], "git_node": "12042e42dd6c9753b094029bd66700ca9ffc953c", "git_parents": ["9dedd78c054e56dbead1f29820fea8dfe567e2bc"], "node": "bc8174c449518d71bf245bc9674a416a5056bb07", "parents": ["aec06ee2607de74020d740a48dcd3bf68a2f2c3e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2093688 - Ignore hang monitor layer requests superseded by a newer RenderLayers message, r=farre.\n\nSetRenderLayers sends each request on PBrowser and, to interrupt JS, on\nPProcessHangMonitor; the two channels are not ordered with each other. A\nlate hang monitor copy of an older request could hide a preloaded\nabout:newtab the parent believed rendered, so switching to it hung.\n\nBug 1848357 removed the epochs that ordered the two channels. Tag both copies\nagain with a BrowserParent epoch; BrowserChild skips older requests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343259\n", "files": ["dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/PBrowser.ipdl", "dom/ipc/PProcessHangMonitor.ipdl", "dom/ipc/ProcessHangMonitor.cpp"], "git_node": "131d630c16d3dec8da7ece0a01594eae54acdcf5", "git_parents": ["12042e42dd6c9753b094029bd66700ca9ffc953c"], "node": "d1c6c07d5b474a49f188305ac41fc5a0f1c40108", "parents": ["bc8174c449518d71bf245bc9674a416a5056bb07"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080009 - [wdspec] Use non-window dependend width for the input to avoid size differences because of the potential window resizing. r=webdriver-reviewers,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343944\n", "files": ["testing/web-platform/mozilla/tests/webdriver/support/chrome-assets/chrome/style.css"], "git_node": "11baa7321bc0799585e499df9316c1279a3ef8bf", "git_parents": ["131d630c16d3dec8da7ece0a01594eae54acdcf5"], "node": "60e978c266eb887e534bcc1e00b2bcfcd268de52", "parents": ["d1c6c07d5b474a49f188305ac41fc5a0f1c40108"], "tags": []}, {"author": "Mitar \u003cmitar.git@tnode.com\u003e", "branch": "default", "desc": "Bug 2090734 - [Wayland] Do not activate windows restored at startup r=stransky,gtk-reviewers\n\nAt startup, XREMain hands the activation token Firefox was launched with\nback to GTK through DESKTOP_STARTUP_ID, and GTK 3 activates the first\ntoplevel it maps with it. While session restore runs at startup, that is a\nrestored window, which the compositor places on its own workspace. The\nother restored windows request activation in NativeShow(), and session\nrestore focuses the windows it restores, to stack them. Since bug 2033842,\nFirefox makes such a request with a token without serial and surface when\nnone of its windows has the focus. No event of the user is behind any of\nthese requests, so mutter activates none of these windows, marks them as\ndemanding attention instead, and GNOME Shell shows a notification for each\nof them.\n\nThe token is now removed from GTK at startup and given to nsGTKToolkit,\nwhose token nsWindow already uses for a launch passed to a running Firefox.\nA toplevel created while session restore runs is marked with\nmWaitingToFocusRestore, together with mWaitingToSessionRestore, until\nsession restore finishes. A window shown before then is a restored one,\nshown by MoveToWorkspace(), and NativeShow() and SetFocus() skip all focus\nhandling for it, so the token stays with nsGTKToolkit. When session restore\nfinishes, the token is used by a window opened for the launch, which is\nshown then, or else by the window whose focus request\nSessionRestoreFinished() replays. A token which no window used, because\nevery window was restored, is dropped then, so that a window opened later\ntransfers the focus to itself as usual.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340739\n", "files": ["toolkit/xre/nsAppRunner.cpp", "widget/gtk/nsAppShell.cpp", "widget/gtk/nsAppShell.h", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/gtk/nsWindowWaylandGtk.cpp"], "git_node": "30ef407069f4bffab01b27f48e4dffbbba4267c2", "git_parents": ["11baa7321bc0799585e499df9316c1279a3ef8bf"], "node": "8ed4b1eccf727009e6dfcaa3a6501a7f227a7023", "parents": ["60e978c266eb887e534bcc1e00b2bcfcd268de52"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088366 - Stop using `find` in install-firefox.sh r=jlorenzo,browser-installer-reviewers,spohl\n\nEvery Firefox tarball extracts to a `firefox` directory. `find | head -1`\ncould return the `gpg` directory that signature verification creates\nbeside `firefox`, and install that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344183\n", "files": ["browser/installer/linux/script/install-firefox-test-unit.sh", "browser/installer/linux/script/install-firefox.sh", "taskcluster/kinds/linux-install-test/integration.yml"], "git_node": "50cb9662a20a47743f137ce2f51ee9f846cb356e", "git_parents": ["30ef407069f4bffab01b27f48e4dffbbba4267c2"], "node": "8fc28706307b2eace34f9b564cd7b98f46f29f5f", "parents": ["8ed4b1eccf727009e6dfcaa3a6501a7f227a7023"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2093187 - Use infallible allocation as fallback when nsNodeInfoManager::Allocate has no arena from doc group. r=dom-core-reviewers,farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344002\n", "files": ["dom/base/nsNodeInfoManager.cpp"], "git_node": "585016935bd4992fe7b09f3a0dbc922cc1e1f663", "git_parents": ["50cb9662a20a47743f137ce2f51ee9f846cb356e"], "node": "aa66dc42dea8df5b613d3c0a7642ac8ed222259e", "parents": ["8fc28706307b2eace34f9b564cd7b98f46f29f5f"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2094349 - Speed up mod with single-digit divisor r=mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344021\n", "files": ["js/src/vm/BigIntType.cpp", "js/src/vm/BigIntType.h"], "git_node": "ac6ed6b8092a4cf25b0488ec1e2f1e8c0c39a927", "git_parents": ["585016935bd4992fe7b09f3a0dbc922cc1e1f663"], "node": "20d34e283b441a268c862f3ead8bb5f76ad79f3a", "parents": ["aa66dc42dea8df5b613d3c0a7642ac8ed222259e"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2094737 - Speed up BigInt division by a single digit r=mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344022\n", "files": ["js/src/vm/BigIntType.cpp", "js/src/vm/BigIntType.h"], "git_node": "a24f351ec26a0e89311d8f399b2e5b26ba07af9c", "git_parents": ["ac6ed6b8092a4cf25b0488ec1e2f1e8c0c39a927"], "node": "aabab6fecb45f121a9eaa15ce6e86baa26ef178b", "parents": ["20d34e283b441a268c862f3ead8bb5f76ad79f3a"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2094349, 2094737: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/src/vm/BigIntType.cpp"], "git_node": "a9eb3183321a62ff0b8f240939a6c220296b7245", "git_parents": ["a24f351ec26a0e89311d8f399b2e5b26ba07af9c"], "node": "34ac0c46ae52fd6a14549d7bc2fde4f5ad98037e", "parents": ["aabab6fecb45f121a9eaa15ce6e86baa26ef178b"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2089153. Port test_video_low_power_telemetry.html to Glean. r=chutten,media-playback-reviewers,padenot\n\nThe test read the Legacy GFX_MACOS_VIDEO_LOW_POWER histogram, which is being\nremoved. Read the gfx.macos_video_low_power labeled counter instead.\n\nThe test is still disabled (bug 1970241). With it re-enabled locally on macOS\nthe Glean version records the same counts as the Legacy version.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343495\n", "files": ["dom/media/test/test_video_low_power_telemetry.html"], "git_node": "1ccb823a8569149001f36910c0016aae898a888d", "git_parents": ["a9eb3183321a62ff0b8f240939a6c220296b7245"], "node": "9fdefb3d602341d703c3af2436f8625a423817f7", "parents": ["34ac0c46ae52fd6a14549d7bc2fde4f5ad98037e"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2089153. Remove Legacy Telemetry instrumentation from Graphics. r=chutten,gfx-reviewers,bradwerth\n\nThese probes have been mirrored to Glean for over a year. The Glean metrics\nstay; only the Legacy definitions and the telemetry_mirror fields go.\n\nAlso drop the \"generated to correspond to the Legacy Telemetry\" notes from\ngfx/metrics.yaml, including the ones left behind by earlier removals, and\nupdate comments that referred to the Legacy probe names.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343496\n", "file