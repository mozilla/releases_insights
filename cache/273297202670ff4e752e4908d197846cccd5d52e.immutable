orm/meta/html/document-isolation-policy/shared-workers.tentative.https.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/track/track-element/track-cue-rendering-line-doesnt-fit.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/track/track-element/track-cue-rendering-transformed-video.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/track/track-element/track-webvtt-non-snap-to-lines.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/selectedcontent.html.ini", "testing/web-platform/meta/intersection-observer/scroll-margin-not-contained.html.ini", "testing/web-platform/meta/long-animation-frame/loaf-script-detached-window.html.ini", "testing/web-platform/meta/media-source/mediasource-correct-frames-after-reappend.html.ini", "testing/web-platform/meta/mozilla-sync", "testing/web-platform/meta/navigation-api/navigation-methods/traverseTo-and-forward-in-cross-site-iframe.html.ini", "testing/web-platform/meta/navigation-timing/redirect-tao.html.ini", "testing/web-platform/meta/resource-timing/delivery-type.tentative.any.js.ini", "testing/web-platform/meta/scheduler/post-task-delay.any.js.ini", "testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-audiocontext-interface/audiocontext-getoutputtimestamp-cross-realm.html.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-audiocontext-interface/context-time-monotonic-on-setsinkid.https.html.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-mediastreamaudiosourcenode-interface/mediastreamaudiosourcenode-from-context-with-different-rate.https.html.ini", "testing/web-platform/meta/webtransport/datagrams.https.any.js.ini"], "git_node": "c9f78ce61241b6037fb2db35f6412f7abd401157", "git_parents": ["1978a11fd2e7c6ca411bef94efab217113b44f8a"], "node": "95fd6723fcd67d1e69ac1ea8436a76bc04612505", "parents": ["819a435f6a7cb64b4267d5c968a8ec287ace60d9"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093773 - update wpt metadata for traverseTo-and-forward-in-cross-site-iframe.html.\n", "files": ["testing/web-platform/meta/navigation-api/navigation-methods/traverseTo-and-forward-in-cross-site-iframe.html.ini"], "git_node": "370732c0a84565314ecce088e328b8d2c9f49262", "git_parents": ["c9f78ce61241b6037fb2db35f6412f7abd401157"], "node": "971437d5c2c734c17c1373417fa5ae5107176a97", "parents": ["95fd6723fcd67d1e69ac1ea8436a76bc04612505"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091403 - Make linux-install-test fetch install-firefox.sh from source-artifact instead of cloning gecko r=taskgraph-reviewers,ahal,releng-reviewers\n\nThe `linux-install-test` kind is now split, like `kinds/test`:\n- `kind.yml` as the entry point\n- `integration.yml` contains the integration tests where install-firefox.sh is executed on a variety of distros.\n- `unit.yml` for the shell unit tests\n\nThe integration tests fetch install-firefox.sh from `source-artifact-linux64` instead of cloning gecko.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341413\n", "files": ["taskcluster/gecko_taskgraph/transforms/linux_install_test.py", "taskcluster/kinds/linux-install-test/integration.yml", "taskcluster/kinds/linux-install-test/kind.yml", "taskcluster/kinds/linux-install-test/unit.yml"], "git_node": "05afad732623afe129150aee076ec7763df267d2", "git_parents": ["370732c0a84565314ecce088e328b8d2c9f49262"], "node": "f222f916f199675373ef96cfde831a40c1fc31d1", "parents": ["971437d5c2c734c17c1373417fa5ae5107176a97"], "tags": []}, {"author": "Dave Vandyke \u003ckzar@kzar.co.uk\u003e", "branch": "default", "desc": "Bug 2087790 - Delete listener proxies after removal r=robwu\n\nWhen browser extensions add listeners for certain events (for example\n`browser.storage.onChanged`) a listener proxy is created in the parent process\nto listen for the events and pass them on to the extension listeners. It turned\nout the listener proxies weren't being deleted when the corresponding extension\nlisteners were removed, which resulted in a memory leak.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343714\n", "files": ["toolkit/components/extensions/ExtensionParent.sys.mjs", "toolkit/components/extensions/test/mochitest/test_ext_listener_proxies.html"], "git_node": "74dabdf5dcad3f408f8150df3ba5c0e3ba2224af", "git_parents": ["05afad732623afe129150aee076ec7763df267d2"], "node": "fb0d446960fe1d26c9b23d281f1e7e097dbeff6d", "parents": ["f222f916f199675373ef96cfde831a40c1fc31d1"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1870751 - Reset the about:protections entrypoint once the report has recorded it, r=timhuang.\n\nThe entrypoint from the URL was kept for the rest of the session, so every later direct load of about:protections was reported with the last entrypoint seen instead of 'direct'.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342376\n", "files": ["browser/actors/AboutProtectionsParent.sys.mjs", "browser/components/protections/test/browser/browser_protections_telemetry.js"], "git_node": "ff6bb9c227649a120cd8e79eebfffa241243f501", "git_parents": ["74dabdf5dcad3f408f8150df3ba5c0e3ba2224af"], "node": "aebb5ab15fd6ac440623c2f6774eda8dcf6ac980", "parents": ["fb0d446960fe1d26c9b23d281f1e7e097dbeff6d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080266 - Resize native gtk menu to content dynamically. r=stransky,gtk-reviewers\n\nThe issue is that once the menu has been shown, gtk3 pins the window\nsize.\n\nIf the model mutates after show, it'd cause the menu to be shown at the\nwrong size, unless explicitly resized.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343451\n", "files": ["widget/gtk/NativeMenuGtk.cpp", "widget/gtk/NativeMenuGtk.h"], "git_node": "db59422f59838eb9cf2718a0b4b0f438a20e3248", "git_parents": ["ff6bb9c227649a120cd8e79eebfffa241243f501"], "node": "72cc50f7e417d956eed1a2c35eb29618149c9855", "parents": ["aebb5ab15fd6ac440623c2f6774eda8dcf6ac980"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083046 - Part 1: Test Smart Window auto-model chat telemetry r=jlewis\n\nChoice events already report \"auto\" and request events the routed model, so no new extra is needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341448\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_auto_model_telemetry.js", "browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "c705abb4d9ab1e6dc5503b1ab60c8b5a3782ff4b", "git_parents": ["db59422f59838eb9cf2718a0b4b0f438a20e3248"], "node": "e2af23171629cd73e30d87033a5e854a71fd9767", "parents": ["72cc50f7e417d956eed1a2c35eb29618149c9855"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083836 - Offer auto-model in the smartbar inline picker r=fluent-reviewers,cdipersio,bolsson,echa\n\nWhen browser.smartwindow.firstrun.singlePageWithAutoModel is enabled the inline model picker lists the auto-model option.\n\nTest steps:\n1. With a Smart Window open, set browser.smartwindow.firstrun.singlePageWithAutoModel to true: Auto appears first in the smartbar picker, marked Recommended.\n2. Pick Auto in a sidebar tab, then set the pref to false: the tab falls back to the default model and Auto leaves the list.\n3. Repeat in a full page Smart Window.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341449\n", "files": ["browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/components/input-model-select/input-model-select.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartbar_model_select.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartbar_model_select_auto.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/locales/en-US/browser/aiWindow.ftl"], "git_node": "7ceea0a4e135ae9b5596cd86c89c50e737de5b04", "git_parents": ["c705abb4d9ab1e6dc5503b1ab60c8b5a3782ff4b"], "node": "723d959313a452dc80f870ad6cccd590e0510e24", "parents": ["e2af23171629cd73e30d87033a5e854a71fd9767"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083046 - Part 2: Report the inline model choice in Smart Window chat telemetry r=jlewis\n\nSubmit, response and client error events reported the global model choice. A tab that picked another model in the inline picker was reported with the default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341767\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_auto_model_telemetry.js", "browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "0573be5f6b4bd4f831632ded03bf8d2375ff3b25", "git_parents": ["7ceea0a4e135ae9b5596cd86c89c50e737de5b04"], "node": "b4ce9184d033beaf81ee6046c80edd8ee378e931", "parents": ["723d959313a452dc80f870ad6cccd590e0510e24"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083045 - Show the model in the Smart Window action log r=fluent-reviewers,mshillabeer,bolsson,czhou,ai-security-reviewers\n\nWhen the auto model is chosen the action log shows the model that has been selected for a response.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341768\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/openAIEngine.sys.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_action_log_model.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartbar_model_select_auto.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/locales/en-US/browser/aiWindowContent.ftl"], "git_node": "28005f4e787f1f7a0644c295db3c651d749a654e", "git_parents": ["0573be5f6b4bd4f831632ded03bf8d2375ff3b25"], "node": "d907d35d26e9f978282b84ec189cfbcc3325e5a3", "parents": ["b4ce9184d033beaf81ee6046c80edd8ee378e931"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083045 - Always show the action log for the Auto model r=fluent-reviewers,czhou,flod\n\nReplies generated with the auto model selected always show the action log.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342595\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_aichat_content_loader_suppression.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_action_log_model.js", "browser/locales/en-US/browser/aiWindowContent.ftl"], "git_node": "a3a18a4952bde6418f83005dad234202028f6958", "git_parents": ["28005f4e787f1f7a0644c295db3c651d749a654e"], "node": "f5374de1840a1e3c03c91cb2d6d14c852d7951a4", "parents": ["d907d35d26e9f978282b84ec189cfbcc3325e5a3"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094489 - Update android nightly application-services version bump to c4fc72fa6d9033bb825ac68e61129fbdf0202141 r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343830\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "f47ce3258cab739f10eab307def86381afb61791", "git_parents": ["a3a18a4952bde6418f83005dad234202028f6958"], "node": "62651a7b350b714291e78d4b8b20eb335e1f404b", "parents": ["f5374de1840a1e3c03c91cb2d6d14c852d7951a4"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081573 - Make \u003cobject\u003e get ancestorOrigins list r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343500\n", "files": ["netwerk/ipc/DocumentLoadListener.cpp", "testing/web-platform/meta/html/browsers/history/the-location-interface/location-ancestor-origins-referrerpolicy-unsupported-elements.html.ini", "testing/web-platform/tests/html/browsers/history/the-location-interface/location-ancestor-origins-object.sub.html", "testing/web-platform/tests/html/browsers/history/the-location-interface/resources/location-ancestor-origins-object-helper.html"], "git_node": "c956d468490e9c9ec3365701db0f15aa636a4fe7", "git_parents": ["f47ce3258cab739f10eab307def86381afb61791"], "node": "744d97f83459863ecaf4ac7ae6c6a1894caf6975", "parents": ["62651a7b350b714291e78d4b8b20eb335e1f404b"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2093141 - Use moz-src for toolkit/components/contentrelevancy r=urlbar-reviewers,mbeier\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342989\n", "files": ["browser/components/BrowserComponents.manifest", "browser/components/urlbar/UrlbarProviderQuickSuggest.sys.mjs", "browse