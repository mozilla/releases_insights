tests/css/filter-effects/css-backdrop-filters-animation-blur-ref.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-blur.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-brightness-ref.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-brightness.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-combined-ref.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-combined.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-contrast-ref.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-contrast.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-drop-shadow-ref.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-drop-shadow.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-grayscale-ref.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-grayscale.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-hue-rotate-ref.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-hue-rotate.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-invert-ref.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-invert.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-opacity-ref.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-opacity.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-saturate-ref.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-saturate.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-sepia-ref.html", "testing/web-platform/tests/css/filter-effects/css-backdrop-filters-animation-sepia.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-blur-ref.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-blur.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-brightness-ref.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-brightness.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-combined-001-ref.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-combined-001.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-contrast-ref.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-contrast.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-drop-shadow-ref.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-drop-shadow.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-grayscale-ref.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-grayscale.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-hue-rotate-ref.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-hue-rotate.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-invert-ref.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-invert.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-opacity-ref.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-opacity.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-saturate-ref.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-saturate.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-sepia-ref.html", "testing/web-platform/tests/css/filter-effects/css-filters-animation-sepia.html"], "git_node": "6f98b253db145d7692fdc379451065d1a596e92f", "git_parents": ["c936de4b285c364b3805ea53f5a8cb60cf504721"], "node": "7ee888c8553e43baab1031311ba00b847334b6e4", "parents": ["111401e113b8a05db4f29858f89fcd2b818f08c0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085499 [wpt PR 64066] - Update wpt metadata, a=testonly\n\nwpt-pr: 64066\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/filter-effects/animation/css-backdrop-filters-animation-displacement.html.ini"], "git_node": "dc8c553d6b6631d63079141e94562d6f8c4cd976", "git_parents": ["6f98b253db145d7692fdc379451065d1a596e92f"], "node": "9abfe0b6f2539b996a0531bbaeecb40bb1ac2d99", "parents": ["7ee888c8553e43baab1031311ba00b847334b6e4"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2085500 [wpt PR 64009] - [html-in-canvas] Fix nested drawable under filter, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Fix nested drawable under filter\n\nThis patch sets `CanvasDrawableState::content_effect` to the drawable's\nparent effect [1] (`current_effect`) instead of\n`canvas_fragment.ContentsEffect()`. This fixes a mistake where we\nmissed some updates when adding support for drawable descendants.\nUpdateElementCanvasTransform (should be refactored to split out the\neffect update) runs prior to UpdateEffect and updates the\n`context_.current_effect` to the nearest drawable's effect. This effect\ncan be used directly for the canvas drawable state, rather than using\nthe canvas's effect. This change fixes an issue later in the pipeline\nwhen the wrong effect was used for the drawable's recording.\n\n[1] https://source.chromium.org/chromium/chromium/src/+/main:third_party/blink/renderer/core/paint/object_paint_properties.h;drc=3798f301b5516b1757d199eb5b64f10238ef21b1;l=151\n\nBug: 562108899\nChange-Id: I3c52e5b627ed67135b18a341d9bd71a249127076\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8613228\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724302}\n\n--\n\nwpt-commits: 91c843b8c992d45fc38e8a34b395331261de2cdf\nwpt-pr: 64009\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/nested-drawable-filter-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/nested-drawable-filter.tentative.html"], "git_node": "127ea8c7dc37cc7917534b5eb32460418dd4e8da", "git_parents": ["dc8c553d6b6631d63079141e94562d6f8c4cd976"], "node": "53e83630510e2c70a9695e1600fbd6974903b53c", "parents": ["9abfe0b6f2539b996a0531bbaeecb40bb1ac2d99"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2085501 [wpt PR 64010] - [html-in-canvas] Fix nested canvas drawable in filter, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Fix nested canvas drawable in filter\n\nThis patch updates `UpdateElementCanvasTransform()` to walk past\nnon-drawable effects when falling back to `canvas_contents.Effect()` for\na nested `content=drawable` canvas inside a drawable subtree.\n\nWhen a nested `content=drawable` canvas was inside a filtered drawable\nancestor (or was itself a filtered drawable), its\n`canvas_contents.Effect()` was the filter effect node\n(`IsInDrawableCanvasSubtree() && !HasCanvasDrawableState()`). Top-level\ndrawables in the nested canvas fell back to `canvas_contents.Effect()`\nbecause `UpdateForChildren()` on the nested canvas reset\n`current_effect` to `Root()`. Parenting inner drawables to the filter\neffect prevented `PaintArtifactCompositor` from decompositing the filter\ninto the enclosing drawable's effect and triggered a `CHECK` failure.\nWalking `effect` up while `IsInDrawableCanvasSubtree() &&\n!HasCanvasDrawableState()` ensures inner drawables are parented to the\nenclosing drawable's effect node.\n\nFixed: 562108899, 575053148\nChange-Id: I190b3cfb47d1ed9839f1ec79d0271f5f12e6efdb\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8613587\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724305}\n\n--\n\nwpt-commits: fe2bd4102f16a87887e276ebf64b1f13f430b122\nwpt-pr: 64010\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/nested-canvas-filter-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/nested-canvas-filter.tentative.html"], "git_node": "a9f17dab81c2bb4bf33c5d54e39a603d5a89efc5", "git_parents": ["127ea8c7dc37cc7917534b5eb32460418dd4e8da"], "node": "c963a14de235e097ecadbda225298393d9051869", "parents": ["53e83630510e2c70a9695e1600fbd6974903b53c"], "tags": []}, {"author": "mark a. foltz \u003cmfoltz@chromium.org\u003e", "branch": "default", "desc": "Bug 2085226 [wpt PR 63967] - [MediaCapabilities] Enforce mime type restrictions in IsValidMimeType(), a=testonly\n\nAutomatic update from web-platform-tests\n[MediaCapabilities] Enforce mime type restrictions in IsValidMimeType()\n\nPer the W3C Media Capabilities specification, a valid media MIME type\nmust either imply a single codec without parameters, or specify a single\ncodec in the codecs parameter, and application/* MIME types must match\nthe audio or video configuration type.\n\nSpec: https://w3c.github.io/media-capabilities/#check-mime-type-validity\n\nUpdate IsValidMimeType() accordingly, add unit tests, and delete\nobsolete WPT expectation files.\n\nBug: 383375915\nChange-Id: I4a25c5b359e569c113b387b68727d0e31b7df4a7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8614859\nCommit-Queue: Mark Foltz \u003cmfoltz@chromium.org\u003e\nReviewed-by: Dale Curtis \u003cdalecurtis@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724363}\n\n--\n\nwpt-commits: 5967b6b946ca5d487a75a1f2b231252e5adff207\nwpt-pr: 63967\n", "files": ["testing/web-platform/tests/media-capabilities/decodingInfo.any.js", "testing/web-platform/tests/media-capabilities/encodingInfo.any.js"], "git_node": "eb9b3abf612de458ca497e858dfdfd3ebad3eb19", "git_parents": ["a9f17dab81c2bb4bf33c5d54e39a603d5a89efc5"], "node": "30a7501014c4f8f2717e285fa91c44bff5634315", "parents": ["c963a14de235e097ecadbda225298393d9051869"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085226 [wpt PR 63967] - Update wpt metadata, a=testonly\n\nwpt-pr: 63967\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/media-capabilities/decodingInfo.any.js.ini"], "git_node": "2be7c2039181f68066fddf9c4eb28f7dbc69ad1a", "git_parents": ["eb9b3abf612de458ca497e858dfdfd3ebad3eb19"], "node": "4e5d6c3d5d277f8fa8e36a700ebabae18eff71d0", "parents": ["30a7501014c4f8f2717e285fa91c44bff5634315"], "tags": []}, {"author": "Khushal Sagar \u003ckhushalsagar@chromium.org\u003e", "branch": "default", "desc": "Bug 2085502 [wpt PR 64012] - WebMCP: Fix ModelContextUserData lifetime for replacement navigations, a=testonly\n\nAutomatic update from web-platform-tests\nWebMCP: Fix ModelContextUserData lifetime for replacement navigations\n\nThe result of a javascript: URL, of an XSLT transform, or of discarding a\nframe replaces the renderer's Document without a navigation that commits\nin the browser. This means that DocumentUserData tied to the old\nDocument persist even after the Document in the renderer has changed.\nThis lifetime mismatch is likely an issue for all uses of\nDocumentUserData, including ModelContextUserData used by WebMCP: when\nthe new Document used document.modelContext, its ModelContextHost bind\nfound the old Document's ModelContextUserData and the browser killed the\nrenderer with RFHI_WEBMCP_DUPLICATE_BIND.\n\nThis change adds an IPC for the renderer to notify the browser when a\nreplacement navigation commits in the renderer. The notification is used\nto reset ModelContextUserData. A separate CL should look into resetting\nall DocumentUserData for these navigations (crbug.com/576419973).\n\nThe new Document binds ModelContextHost through the frame's\nBrowserInterfaceBroker, which isn't ordered with this IPC, so the bind\ncan still race it (crbug.com/576011705). The same race exists for the\nfirst commit after the initial empty Document when its window is reused.\n\nBug: 555173199\nChange-Id: I5713c6d09cbb84d4c5fabe19c01a3430bdce093a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8595641\nCommit-Queue: Khushal Sagar \u003ckhushalsagar@chromium.org\u003e\nReviewed-by: Dave Tapuska \u003cdtapuska@chromium.org\u003e\nReviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\nAuto-Submit: Khushal Sagar \u003ckhushalsagar@chromium.org\u003e\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724372}\n\n--\n\nwpt-commits: 5b8ed9e1bd7bf088c7a102cdf4c858ba76c7eb13\nwpt-pr: 64012\n", "files": ["testing/web-platform/tests/webmcp/imperative/javascript-url-document-replacement.https.html"], "git_node": "014133b01c0a42b5a4503c22c347895a0f03edc4", "git_parents": ["2be7c2039181f68066fddf9c4eb28f7dbc69ad1a"], "node": "fe334501584221b1f146ee5e4ca203920e354ee7", "parents": ["4e5d6c3d5d277f8fa8e36a700ebabae18eff71d0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085502 [wpt PR 64012] - Update wpt metadata, a=testonly\n\nwpt-pr: 64012\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/imperative/javascript-url-document-replacement.https.html.ini"], "git_node": "2c42673021d1190c6c474fbaf54ab3c344b4ea1e", "git_parents": ["014133b01c0a42b5a4503c22c347895a0f03edc4"], "node": "51ee08f8a3a26f77a6ac078a4c78bf558c83fbcc", "parents": ["fe334501584221b1f146ee5e4ca203920e354ee7"], "tags": []}, {"author": "Mahesh Kannan \u003ckmaheshb@google.com\u003e", "branch": "default", "desc": "Bug 2079933 [wpt PR 63380] - [WebAudio] Add WPT coverage for AudioWorklet constructor error events, a=testonly\n\nAutomatic update from web-platform-tests\n[WebAudio] Add WPT coverage for AudioWorklet constructor error events\n\nThis is Part 1 of a 2-part CL addressing crbug.com/571193570.\n\nCurrently, when AudioWorkletGlobalScope::CreateProcessor() fails on the\nworklet thread, construction exceptions collapse into a generic error\nwith empty filename and zeroed line and column numbers on the\ndispatched onprocessorerror ErrorEvent.\n\nExpand WPT coverage in audioworkletnode-onerror.https.html to assert\nthat an exception thrown from the processor constructor populates the\nErrorEvent filename, lineno, and colno attributes (matching the\nprocess-error subtest), and check in the trunk failure baseline to be\nresolved in Part 2.\n\nTAG=agy\nCONV=5fd7d722-b855-42c2-bc3a-7adc223653a6\n\nBug: 571193570\nTest: audioworkletnode-onerror.https.html\nChange-Id: Iedc243feafac53ca5bdb28253c48916d0a5cc30f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8516000\nReviewed-by: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nCommit-Queue: Mahesh Kannan \u003ckmaheshb@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1724380}\n\n--\n\nwpt-commits: 7dfd5aacb296834c3fc33143e0bec9d93b6f7c5b\nwpt-pr: 63380\n", "files": ["testing/web-platform/tests/webaudio/the-audio-api/the-audioworklet-interface/audioworkletnode-onerror.https.html"], "git_node": "4febb78bd7784f5c4eb69dcd2d3a57464a4d0a6e", "git_parents": ["2c42673021d1190c6c474fbaf54ab3c344b4ea1e"], "node": "893441f0edc79e5d1b25990d594147dc081916c0", "parents": ["51ee08f8a3a26f77a6ac078a4c78bf558c83fbcc"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079933 [wpt PR 63380] - Update wpt metadata, a=testonly\n\nwpt-pr: 63380\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webaudio/the-audio-api/the-audioworklet-interface/audioworkletnode-onerror.https.html.ini"], "git_node": "b7c39350498a1c3f7c4af9c37b702669e7983349", "git_parents": ["4febb78bd7784f5c4eb69dcd2d3a57464a4d0a6e"], "node": "2891f102e580877b7d2424418fd8274177931f04", "parents": ["893441f0edc79e5d1b25990d594147dc081916c0"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2085504 [wpt PR 64016] - Make singleton Persistents in css/ thread local, a=testonly\n\nAutomatic update from web-platform-tests\nMake singleton Persistents in css/ thread local\n\nCSS parsing can happen on multiple threads. One example is canvas\ncontext parsing, which is limited to a certain set of values for which\nwe have previously avoided general property parsing by not allowing\nunparsed values. However, for the typed OM API CSSUnparsedValue, we can\nparse arbitrary property values in if(supports()) like this:\n\nCSSUnparsedValue(['if(supports(animation: a): 1px)']).toString();\n\nIn some cases we rely on static singletons which are sometimes allocated\non the oilpan heap, which can not be safely constructed or accessed\ncross thread.\n\nIntroduce ThreadSpecific singletons for these.\n\nBug: 575201475, 575201060\nChange-Id: I7a9e53999afd4b093f3ff0fcea88d0f9766536ca\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8608808\nReviewed-by: Michael Lippautz \u003cmlippautz@chromium.org\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724494}\n\n--\n\nwpt-commits: 01057c55baf879985729d7937ec8a6bbfe1dbf91\nwpt-pr: 64016\n", "files": ["testing/web-platform/tests/css/css-typed-om/crashtests/chrome-575201060.html", "testing/web-platform/tests/css/css-typed-om/crashtests/chrome-575201060.js", "testing/web-platform/tests/css/css-typed-om/crashtests/chrome-575201475.html", "testing/web-platform/tests/css/css-typed-om/crashtests/chrome-575201475.js"], "git_node": "6257ec7b47c4a64ebf637ecda202f4a0d58a943c", "git_parents": ["b7c39350498a1c3f7c4af9c37b702669e7983349"], "node": "46b75e4a0e85f0353c2932efb36ede6482270de0", "parents": ["2891f102e580877b7d2424418fd8274177931f04"], "tags": []}, {"author": "Rubens Rafael \u003crubens.rafael@gitstart.dev\u003e", "branch": "default", "desc": "Bug 2085505 [wpt PR 64034] - ChromeDriver: Reject mismatched element and shadow root references, a=testonly\n\nAutomatic update from web-platform-tests\nChromeDriver: Reject mismatched element and shadow root references\n\nChromeDriver resolved WebDriver element and shadow-root IDs without\nverifying that the supplied reference key matched the resulting node\ntype. A shadow root could therefore reach commands that require an\nelement, while a shadow-root command could receive an element or generic\nDocumentFragment.\n\nValidate reference types in the shared call_function.js deserializer\nbefore checking node reachability. Preserve the native ShadowRoot\nconstructor during DevTools setup so page changes to the global\nconstructor do not affect serialization or deserialization. Continue to\naccept Document nodes for internal script arguments.\n\nAdd unit and integration coverage for mismatched references, error\nprecedence, replaced constructors, and BiDi DocumentFragment shared IDs.\nUpdate Linux and Android WPT baselines for the shared deserializer.\n\nOverview doc: https://docs.google.com/document/d/1hH_O87bKywuQQV2_m4CzmgTcI7BmLXJojCxTTSTInR0/edit?tab=t.0\n\nBug: 557266143\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nInclude-Ci-Only-Tests: chromium.android:android-16-x64-rel|android_webdriver_wpt_tests\nCq-Include-Trybots: luci.chromium.try\u200b:linux-blink-rel,android-15-chrome-blink-rel,android-16-x64-rel,linux-surface-embed-rel\nInclude-Ci-Only-Tests: chromium.fyi:linux-surface-embed-rel|surface_embed_chrome_wpt_tests\nChange-Id: I71cbd34635f1ad12ac6831eefed08bd83fab65e9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8359688\nReviewed-by: Maksim Sadym \u003csadym@chromium.org\u003e\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nReviewed-by: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724718}\n\n--\n\nwpt-commits: 1c155366d5b206715a9b47fdd38b70ddc951f44d\nwpt-pr: 64034\n", "files": ["testing/web-platform/tests/webdriver/tests/interop/shared_id_node.py"], "git_node": "caf7b3f0c8fa88e619a0017c176537a973242288", "git_parents": ["6257ec7b47c4a64ebf637ecda202f4a0d58a943c"], "node": "b22dd0720dde25c5dd11692f4f4c444cfad27bbf", "parents": ["46b75e4a0e85f0353c2932efb36ede6482270de0"], "tags": []}, {"author": "Eriko Kurimoto \u003celkurin@chromium.org\u003e", "branch": "default", "desc": "Bug 2085506 [wpt PR 64067] - [CacheStorage] Persist has_range_requested on cached responses, a=testonly\n\nAutomatic update from web-platform-tests\n[CacheStorage] Persist has_range_requested on cached responses\n\nPreviously, CacheStorageCache::PutDidCreateEntry did not persist\nFetchAPIResponse::has_range_requested in proto::CacheResponse, and\nCreateResponse checked whether the response headers contained a Range\nheader (which is a request header and never present on responses). As a\nresult, cached responses returned by CacheStorage always had\nhas_range_requested reset to false.\n\nWhen an opaque 206 Partial Content or 416 Range Not Satisfiable\nresponse was stored in CacheStorage and later returned by a Service\nWorker, ResourceLoader::DidReceiveResponseInternal skipped the check\nthat rejects opaque range responses for non-range requests.\n\nPersist has_range_requested in proto::CacheResponse, and ensure\nCreateResponse also treats opaque 206 and 416 responses as\nrange-requested even if the stored proto field is unset or false.\n\nBug: 568894475\nChange-Id: I9c4d1f2a3e8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8618165\nCommit-Queue: Eriko Kurimoto \u003celkurin@chromium.org\u003e\nReviewed-by: Mingyu Lei \u003cleimy@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724757}\n\n--\n\nwpt-commits: 21e755a6143b95889f2414f4149f64f2fe0540c4\nwpt-pr: 64067\n", "files": ["testing/web-platform/tests/fetch/range/resources/range-sw.js", "testing/web-platform/tests/fetch/range/sw-416.https.window.js", "testing/web-platform/tests/fetch/range/sw.https.window.js"], "git_node": "a6df5dbfca3e321e03021739dbe07215f3c1c3d7", "git_parents": ["caf7b3f0c8fa88e619a0017c176537a973242288"], "node": "00c33b3742932f8a6a544bb09d819a2e8443d037", "parents": ["b22dd0720dde25c5dd11692f4f4c444cfad27bbf"], "tags": []}, {"author": "Alison Maher \u003calmaher@microsoft.com\u003e", "branch": "default", "desc": "Bug 2085507 [wpt PR 64014] - [Flex] Record column item expansion at block end, a=testonly\n\nAutomatic update from web-platform-tests\n[Flex] Record column item expansion at block end\n\nWhen a column flex item expands as a result of fragmentation, the\nexpansion is added to the line's item offset adjustment so that later\nitems in the column are pushed down. Previously, the expansion was only\nrecorded once the item had no outgoing break token. If the item reached\nits block end but its content overflowed into the next fragmentainer, it\nstill had a break token, so later items in the column that were laid out\nin the same fragmentainer did not account for the expansion and\noverlapped the item.\n\nThis change records the expansion as soon as the item reaches its block\nend. When the item later resumes at its block end to lay out its\noverflow, the expansion is skipped, since it was already recorded in an\nearlier fragmentainer.\n\nThere is no bug number associated with this, but I found this issue when\nimplementing similar functionality in grid lanes.\n\nChange-Id: I93730a6e3c1189dcb2e11ba02b98aeae58700a35\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8621447\nCommit-Queue: Alison Maher \u003calmaher@microsoft.com\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724792}\n\n--\n\nwpt-commits: e2e61bdb6cce141364e584a0202717ef87ee4078\nwpt-pr: 64014\n", "files": ["testing/web-platform/tests/css/css-break/flexbox/single-line-column-flex-fragmentation-072.html"], "git_node": "01b15d95071c4374e0130521d65943bed7421320", "git_parents": ["a6df5dbfca3e321e03021739dbe07215f3c1c3d7"], "node": "4576717d418dc633046aec0e31437beb2920ba60", "parents": ["00c33b3742932f8a6a544bb09d819a2e8443d037"], "tags": []}, {"author": "Javier Contreras \u003cjaviercon@microsoft.com\u003e", "branch": "default", "desc": "Bug 2085510 [wpt PR 64068] - [masonry] Use per-segment rule visibility in grid-lanes, a=testonly\n\nAutomatic update from web-platform-tests\n[masonry] Use per-segment rule visibility in grid-lanes\n\nBefore this change, `rule-visibility-items` in grid-lanes treated each\nlane as a whole. A lane with any item made every segment next to it\noccupied. The CSSWG resolved that rule visibility applies per segment in\ngrid-lanes too, so a segment next to empty space in a lane must be\ntreated as empty.\n\nThis change defines empty space through track openings. An opening is\nthe free space in a lane below an item. An opening is empty when no item\ncould align into it: there is no item above it, or the item above it has\nzero available alignment space. A spec clarification for this definition\nis pending, there is an open issue at\nhttps://github.com/w3c/csswg-drafts/issues/14489#issuecomment-6132526774.\n\n`GridLanesRunningPositions` already tracks openings and the item above\neach one, but only for dense packing and stacking-axis alignment. It now\nalso tracks them when the container has gap decorations. The empty\nopenings are then stored per lane in the gap geometry, and paint checks\neach rule segment against them.\n\nUpdate the WPT references that the new definition changes, add tests for\nunequal lanes, reversal, dense packing, and alignment, and remove\nfailure expectations for tests that now pass\n\nBug: 343257585\nChange-Id: I1d7aa0e45b8bf50127c98d90b14bb8246dbb8200\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8592813\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1724804}\n\n--\n\nwpt-commits: faa7b9da1eac7897ab52b69f0e4c2886413e6728\nwpt-pr: 64068\n", "files": ["testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-008-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-008.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-009-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-009.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-010-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-010.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-011-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-011.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-012-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-012.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-002-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-002.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-005-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-008-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-008.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-010.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-011-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-011.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-012-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-012.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-013-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-013.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-014-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-014.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-015-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-015.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-016-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-016.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-017-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-017.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-around-008-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-around-008.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-004-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-004.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-005-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-008-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-008.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-010.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-011-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-011.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-012-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-012.html"], "git_node": "444c53618bd2fef74233e0bd4a79ac82c5a5a799", "git_parents": ["01b15d95071c4374e0130521d65943bed7421320"], "node": "3ce505aa0a87fb2f83ee82ec5e25e1a346eb55d7", "parents": ["4576717d418dc633046aec0e31437beb2920ba60"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085510 [wpt PR 64068] - Update wpt metadata, a=testonly\n\nwpt-pr: 64068\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-008.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-009.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-010.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-011.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-012.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-011.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-012.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-013.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-014.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-015.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-016.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-between-017.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-around-008.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-011.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-012.html.ini"], "git_node": "3389ad3953d90ce4e05865d888b48da39036c9d0", "git_parents": ["444c53618bd2fef74233e0bd4a79ac82c5a5a799"], "node": "83daa861821df61be00544d177897ac0e550ce02", "parents": ["3ce505aa0a87fb2f83ee82ec5e25e1a346eb55d7"], "tags": []}, {"author": "Ravjit Uppal \u003cravjit@chromium.org\u003e", "branch": "default", "desc": "Bug 2085511 [wpt PR 64049] - [CE] Fix setConstraints() silently discarding track constraints, a=testonly\n\nAutomatic update from web-platform-tests\n[CE] Fix setConstraints() silently discarding track constraints\n\nPreviously, UserMediaRequestProviderImpl::StartRequest passed\nstatic_cast\u003cconst MediaTrackConstraints*\u003e(constraints-\u003eaudio()) to\nV8UnionBooleanOrMediaTrackConstraints. Because the generated union class\nonly has constructors for (bool) and non-const (MediaTrackConstraints*),\nthe const-qualified pointer could not bind to the MediaTrackConstraints*\nconstructor. Instead, C++ overload resolution implicitly converted the\nnon-null const pointer to bool(true), calling the (bool) constructor and\nsilently discarding all track constraints.\n\nThis CL stores the sanitized MediaTrackConstraints* directly on\nMediaCaptureElementConstraints (eliminating the upcast to\nMediaTrackConstraintSet* and subsequent static_cast downcast in\nStartRequest) and updates WPTs and unit tests to verify that track\nconstraints are preserved and applied.\n\nBug: 575970640\nChange-Id: I39cd2fb1b35eb1573f5682312a10886374b5829a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8618251\nCommit-Queue: Ravjit Uppal \u003cravjit@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724951}\n\n--\n\nwpt-commits: 2578d35d989f00155c36d61bcfebd43709f89e77\nwpt-pr: 64049\n", "files": ["testing/web-platform/tests/html/semantics/permission-element/camera/camera-set-constraints.https.html", "testing/web-platform/tests/html/semantics/permission-element/microphone/microphone-set-constraints.https.html", "testing/web-platform/tests/html/semantics/permission-element/usermedia/usermedia-set-constraints-sanitization.https.html"], "git_node": "9e444458400b48d463b6cd90f02f3eafa3978201", "git_parents": ["3389ad3953d90ce4e05865d888b48da39036c9d0"], "node": "c7d419da4b6b558a167b44ab0afee3f2edcda1c6", "parents": ["83daa861821df61be00544d177897ac0e550ce02"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085511 [wpt PR 64049] - Update wpt metadata, a=testonly\n\nwpt-pr: 64049\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/permission-element/microphone/microphone-set-constraints.https.html.ini"], "git_node": "510f6fda746aacb9530e2922244ba5c77f2adf09", "git_parents": ["9e444458400b48d463b6cd90f02f3eafa3978201"], "node": "5f0e28334c273bf5c3f6b7f5a52ec778c70e19c2", "parents": ["c7d419da4b6b558a167b44ab0afee3f2edcda1c6"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2085512 [wpt PR 64069] - vt: Resolve capture before invoking early DOM callback, a=testonly\n\nAutomatic update from web-platform-tests\nvt: Resolve capture before invoking early DOM callback\n\nWhen running the DOM change callback after commit (before Viz capture\nrects arrive), ViewTransitionStyleTracker remained in\nState::kOldSnapshotFrozen with target_element references still pointing\nto the old DOM elements. For element-scoped view transitions, main-frame\nrendering is not paused during the callback or while waiting for capture\nrects. If the callback removed a named descendant and a main-frame\nlifecycle update ran before capture rects arrived,\nRunPostPrePaintStepsForElement() checked the removed old target_element\nand aborted the transition with kPostPrePaintFailed.\n\nCall CaptureResolved() before invoking the DOM callback when the old\nsnapshot is frozen so references to old DOM elements are cleared before\nscript mutates the DOM, skip live element geometry checks in\nRunPostPrePaintStepsForElement() while in State::kOldSnapshotFrozen, and\npreserve is_document_element on ElementData so\nSetCaptureRectsFromCompositor() still skips the root element after\ntarget_element is cleared.\n\nBug: 576097103\nChange-Id: Idc6679b21b8fb52c1165eebaa6a892463ddf5c66\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8632175\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724944}\n\n--\n\nwpt-commits: fcfb4c04abe179d49865cafb9b9858fdb321f6aa\nwpt-pr: 64069\n", "files": ["testing/web-platform/tests/css/css-view-transitions/scoped/remove-child-in-callback.html"], "git_node": "82eedb4cbab85ae2d76b51021d254c50c998cf70", "git_parents": ["510f6fda746aacb9530e2922244ba5c77f2adf09"], "node": "1088ee8d75edbbccc001005d5564a7ffa1c82885", "parents": ["5f0e28334c273bf5c3f6b7f5a52ec778c70e19c2"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085512 [wpt PR 64069] - Update wpt metadata, a=testonly\n\nwpt-pr: 64069\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-view-transitions/scoped/remove-child-in-callback.html.ini"], "git_node": "41f2b4360bb14450c3c5179f1a5d49d4a1cfd0be", "git_parents": ["82eedb4cbab85ae2d76b51021d254c50c998cf70"], "node": "abbbb1e85d4f0d204763d2f3c9999d68bcee46f5", "parents": ["1088ee8d75edbbccc001005d5564a7ffa1c82885"], "tags": []}, {"author": "Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e", "branch": "default", "desc": "Bug 2085513 [wpt PR 64071] - [grid] Preserve sizing constraints when computing subgrid block sizes, a=testonly\n\nAutomatic update from web-platform-tests\n[grid] Preserve sizing constraints when computing subgrid block sizes\n\nSubgrid intrinsic block-size computation unconditionally used\nkMaxContent, even when called during normal layout. This caused\ndescendant measurements to be treated as intrinsic sizing, unnecessarily\nentering DisableLayoutSideEffectsScope .\n\nWhen a container query invalidated descendant layout during those\nmeasurements, the disabled side effects prevented layout-dirty flags\nfrom being cleared. Subsequent measurements could not reuse the results,\nrepeatedly laying out the same subtree. With nested grids, this produced\nexponential work.\n\nPass the caller\u2019s SizingConstraint through the subgrid block-size\ncomputation instead. Block-axis track sizing already treats the sizing\nconstraints equivalently, so this preserves sizing behavior while\nallowing normal layout to update and reuse cached results. Actual\nintrinsic-sizing passes retain their existing safeguards.\n\nFixed: 575916165\nChange-Id: I0bfb915d4bed6788fc5fdd3dc284c9d058bf9b98\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8623555\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCommit-Queue: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1725172}\n\n--\n\nwpt-commits: ab209eeecc95915675cde8d26ede4b2d803b4055\nwpt-pr: 64071\n", "files": ["testing/web-platform/tests/css/css-grid/subgrid/nested-grid-subgrid-resize.html"], "git_node": "875da428ca8ed49e00ed5cca0305fa918191e119", "git_parents": ["41f2b4360bb14450c3c5179f1a5d49d4a1cfd0be"], "node": "5d1a6499cbc65c881cfbde3208dd6068ae34f9f0", "parents": ["abbbb1e85d4f0d204763d2f3c9999d68bcee46f5"], "tags": []}, {"author": "Ravjit Uppal \u003cravjit@chromium.org\u003e", "branch": "default", "desc": "Bug 2085514 [wpt PR 64002] - [CE] Allow solid microphone icon via fill-rule, a=testonly\n\nAutomatic update from web-platform-tests\n[CE] Allow solid microphone icon via fill-rule\n\nPreviously, the microphone permission icon used a counter-clockwise\ninner subpath to carve out the hollow center of the microphone capsule,\nwhich rendered as hollow under both nonzero and evenodd fill rules, and\nfill-rule was filtered out on ::permission-icon.\n\nTo allow rendering a solid microphone icon without bundling multiple SVG\nresources, reverse the inner capsule subpath in\npermission_icon_microphone.svg to clockwise, set fill-rule: evenodd as\nthe default on ::permission-icon in the UA stylesheet so the icon\nremains hollow by default, and allowlist fill-rule on ::permission-icon\nso setting fill-rule: nonzero fills the inner capsule solid.\n\nChange-Id: I202f533de1acb1c28294c6bc03ccba1162e7a1ed\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8619829\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nAuto-Submit: Ravjit Uppal \u003cravjit@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1725213}\n\n--\n\nwpt-commits: 4ad13e12b40c27ca7471aa3d3205c22f763bbbc8\nwpt-pr: 64002\n", "files": ["testing/web-platform/tests/html/semantics/permission-element/camera/icon-css-property-fill-rule-reftest-ref.html", "testing/web-platform/tests/html/semantics/permission-element/camera/icon-css-property-fill-rule-reftest.html", "testing/web-platform/tests/html/semantics/permission-element/geolocation-element/icon-css-property-fill-rule-reftest.html", "testing/web-platform/tests/html/semantics/permission-element/geolocation-element/icon-restricted-css-no-effect-reftest.html", "testing/web-platform/tests/html/semantics/permission-element/install/icon-css-property-fill-rule-reftest-ref.html", "testing/web-platform/tests/html/semantics/permission-element/install/icon-css-property-fill-rule-reftest.html", "testing/web-platform/tests/html/semantics/permission-element/microphone/icon-css-property-fill-rule-reftest-ref.html", "testing/web-platform/tests/html/semantics/permission-element/microphone/icon-css-property-fill-rule-reftest.html", "testing/web-platform/tests/html/semantics/permission-element/permission-icon/icon-restricted-css-no-effect-reftest.html", "testing/web-platform/tests/html/semantics/permission-element/usermedia/icon-css-property-fill-rule-reftest-ref.html", "testing/web-platform/tests/html/semantics/permission-element/usermedia/icon-css-property-fill-rule-reftest.html"], "git_node": "9d8bfadb4055a6fc1ea128be887569a586504112", "git_parents": ["875da428ca8ed49e00ed5cca0305fa918191e119"], "node": "9b63a0e3be09e16968fe9161cc9957680ac67c7c", "parents": ["5d1a6499cbc65c881cfbde3208dd6068ae34f9f0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085514 [wpt PR 64002] - Update wpt metadata, a=testonly\n\nwpt-pr: 64002\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/permission-element/microphone/icon-css-property-fill-rule-reftest.html.ini"], "git_node": "d848ef4f4f67c6f3665807fe7019f506afe1611d", "git_parents": ["9d8bfadb4055a6fc1ea128be887569a586504112"], "node": "b7e14743ba61fca484dee28b54d3d49d3a63925f", "parents": ["9b63a0e3be09e16968fe9161cc9957680ac67c7c"], "tags": []}, {"author": "Javier Contreras \u003cjaviercon@microsoft.com\u003e", "branch": "default", "desc": "Bug 2085515 [wpt PR 64072] - [masonry] Add missing test case for behavior that is currently incorrect, a=testonly\n\nAutomatic update from web-platform-tests\n[masonry] Add missing test case for behavior that is currently incorrect\n\nThis CL adds a WPT as failing for a scenario where there is a spanner\nthat ends up being the only thing in adjacent lanes. We would expect\nthere to be a rule above and a rule below, yet this does not happen.\n\nImplementation will follow once the ongoing spec discussions settle on a\nbehavior for this.\n\nBug: 343257585\nChange-Id: I0b062e580845a45f6b259d9a5450f20f74080f17\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8632900\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1725228}\n\n--\n\nwpt-commits: 790353ebdfdaa6972fe13b56ffea7cb6f0c71872\nwpt-pr: 64072\n", "files": ["testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-spanner-after-empty-lanes-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-spanner-after-empty-lanes.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-spanner-after-empty-lanes-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-spanner-after-empty-lanes.html"], "git_node": "4233785c161614d44f86efa242a07c3e0da6fd53", "git_parents": ["d848ef4f4f67c6f3665807fe7019f506afe1611d"], "node": "07726c894cac8186c9b9452bf0271db6374abffe", "parents": ["b7e14743ba61fca484dee28b54d3d49d3a63925f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085515 [wpt PR 64072] - Update wpt metadata, a=testonly\n\nwpt-pr: 64072\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-spanner-after-empty-lanes.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-spanner-after-empty-lanes.html.ini"], "git_node": "a56af26921de0f9a9bd0956c658399cc64727a87", "git_parents": ["4233785c161614d44f86efa242a07c3e0da6fd53"], "node": "ba936393a5051cfb221c82cdd7b9417f65b4dd79", "parents": ["07726c894cac8186c9b9452bf0271db6374abffe"], "tags": []}, {"author": "David Baron \u003cdbaron@chromium.org\u003e", "branch": "default", "desc": "Bug 2085518 [wpt PR 63991] - Don't send a cross-origin relatedTarget on a PointerEvent boundary event, and add more general defense-in-depth for relatedTarget., a=testonly\n\nAutomatic update from web-platform-tests\nDon't send a cross-origin relatedTarget on a PointerEvent boundary event, and add more general defense-in-depth for relatedTarget.\n\nThis prevents exposing a Node from another origin as the relatedTarget\non pointerout, pointerover, pointerleave, and pointerenter events.\n\nThe relatedTarget is instead null, except that when the two documents\nhave an inner/outer relationship in the frame hierarchy, the events in\nthe outer document use the frame owner element (e.g., iframe) in that\ndocument that contains the inner document as the relatedTarget.\n\nSame-origin cross-document boundary events retain the existing behavior\nof exposing the related target Node across documents, which is tested in\na tentative WPT.  It's possible that we should also change this\nbehavior, though, depending on how other engines behave.\n\nThis also includes a second defense-in-depth change to check\nrelatedTarget for all event types (MouseEvent, PointerEvent, and\nFocusEvent) that report it to script (not just this particular\ndispatching path) and set it to null if it is a cross-origin node.\n\nBoth of these behavior changes are guarded by the\n`ClearCrossOriginRelatedTarget` runtime-enabled feature (status:\nstable).\n\nAs a followup (to roll out via the normal release branch and not be\nmerged to older branches) I intend to change the cross-origin check to\nbe just a cross-document check, which will match the behavior of other\nbrowser engines.  This two-stage change will reduce the compatibility\nrisk of the change that needs merging.\n\nFixed: 572556403\nBug: 574379564, 574843953\nForce-WPT-Export: true\nChange-Id: I123aff9643f43fd2de45dae1586f4d2cb2d635a9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8611718\nReviewed-by: Mustaq Ahmed \u003cmustaq@chromium.org\u003e\nCommit-Queue: David Baron \u003cdbaron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1725257}\n\n--\n\nwpt-commits: 6cc1923c1e84a9a3f776914aae124fe8d21839e4\nwpt-pr: 63991\n", "files": ["testing/web-platform/tests/pointerevents/pointerevent_boundary_events_cross_document_same_origin.tentative.html", "testing/web-platform/tests/pointerevents/pointerevent_boundary_events_cross_origin.html", "testing/web-platform/tests/pointerevents/resources/pointerevent_boundary_events_cross_origin_child.html"], "git_node": "d05984397ba5ad0cd512dab8cb8c8fb51c659b5e", "git_parents": ["a56af26921de0f9a9bd0956c658399cc64727a87"], "node": "581592326ea4d17cd94fb0debac6d29fb1ce1520", "parents": ["ba936393a5051cfb221c82cdd7b9417f65b4dd79"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085518 [wpt PR 63991] - Update wpt metadata, a=testonly\n\nwpt-pr: 63991\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/pointerevents/pointerevent_boundary_events_cross_document_same_origin.tentative.html.ini", "testing/web-platform/meta/pointerevents/pointerevent_boundary_events_in_capturing.html.ini"], "git_node": "0b73c430be56a6a7d3553d7fb3b514898cb0bdcc", "git_parents": ["d05984397ba5ad0cd512dab8cb8c8fb51c659b5e"], "node": "2786f3d82b6dfff93e6c89152893d3e9419d19c8", "parents": ["581592326ea4d17cd94fb0debac6d29fb1ce1520"], "tags": []}, {"author": "indura-perera-codimite \u003cindura.perera@codimite.com\u003e", "branch": "default", "desc": "Bug 2085519 [wpt PR 64021] - Skip inline-style CSP checks for DOMParser-created documents, a=testonly\n\nAutomatic update from web-platform-tests\nSkip inline-style CSP checks for DOMParser-created documents\n\nDOMParser.parseFromString() creates a Document with no browsing\ncontext \u2014 it's never rendered or shown to the user. But style=\"\"\nattributes and \u003cstyle\u003e elements parsed into it were still checked\nagainst the calling page's CSP, so a page with a strict style-src\npolicy got a misleading \"Refused to apply inline style\" warning for\ncontent nobody ever sees.\n\nThis skips that check for DOMParser documents, using the existing\n(and previously unused) Document::IsDOMParserDocument() flag \u2014 the\nsame idea Chromium already applies to inline event handlers, which\nskip their CSP check when there's no browsing context.\n\nFixed: 40731171\nChange-Id: Ice3fdb454992679ea77236a3fd55666235a53821\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8465902\nReviewed-by: Mike West \u003cmkwst@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724859}\n\n--\n\nwpt-commits: fc50deede0c32c6ffaabc3686eb3c3c699e5f1f5\nwpt-pr: 64021\n", "files": ["testing/web-platform/tests/content-security-policy/generic/domparser-document-suppresses-csp-warning-for-inline-style.tentative.html"], "git_node": "655e2089d2c71250a9d7dd2ccce9d6b6628c97b1", "git_parents": ["0b73c430be56a6a7d3553d7fb3b514898cb0bdcc"], "node": "24fe67f73f430f97630ee30218edecc7bd6dc67e", "parents": ["2786f3d82b6dfff93e6c89152893d3e9419d19c8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085519 [wpt PR 64021] - Update wpt metadata, a=testonly\n\nwpt-pr: 64021\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/content-security-policy/generic/domparser-document-suppresses-csp-warning-for-inline-style.tentative.html.ini"], "git_node": "78bc7e2ac11cdd278fb535fd987a67779214e70d", "git_parents": ["655e2089d2c71250a9d7dd2ccce9d6b6628c97b1"], "node": "8132d32d64a594253770cc401021682695087aa6", "parents": ["24fe67f73f430f97630ee30218edecc7bd6dc67e"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2086674 [wpt PR 64019] - script: Acknowledge that `border` attribute of `\u003ctable\u003e` affects preshints, a=testonly\n\nAutomatic update from web-platform-tests\nscript: Acknowledge that `border` attribute of `\u003ctable\u003e` affects preshints\n\nNow we will correctly update presentational hints when the value of that\nattribute changes dynamically.\n\nTesting: Adding a new test\n\nSigned-off-by: Oriol Brufau \u003cobrufau@igalia.com\u003e\n\n--\n\nwpt-commits: 7be1f1e04ad996a8b4e16d70f0a179bf6a945b38\nwpt-pr: 64019\n", "files": ["testing/web-platform/tests/html/rendering/non-replaced-elements/tables/table-attribute-border-dynamic.html"], "git_node": "894291aed8a7d16de042192cc0df916730ef622c", "git_parents": ["78bc7e2ac11cdd278fb535fd987a67779214e70d"], "node": "7bbb3c89ea64dfa38d420b9bbf14093b26101a3a", "parents": ["8132d32d64a594253770cc401021682695087aa6"], "tags": []}, {"author": "Jonathan Lee \u003cjonathan-j-lee@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086679 [wpt PR 64052] - Expect `simulate_gatt_connection_response` failure for Chrome, a=testonly\n\nAutomatic update from web-platform-tests\nExpect `simulate_gatt_connection_response` failure for Chrome (#64052)\n\nIn PR #63287, the `infrastructure/ tests (chrome)` check failed because:\n\n```\nSecurityError: Must be handling a user gesture to show a permission request.\n```\n\nIn Chromium, `LocalFrameHost::UpdateUserActivationState` races with\n`WebBluetoothService::RequestDevice` over separate IPC pipes, causing\ntransient activation checks to intermittently fail when requesting a\ndevice in Web Bluetooth BiDi tests.\n\nMark the subtest as intermittently failing (`[PASS, FAIL]`) for Chrome.\n\nBug: https://crbug.com/575786126\n--\n\nwpt-commits: f4f0df2267e5fde4aae2970ea9916bf082a3d262\nwpt-pr: 64052\n", "files": ["testing/web-platform/tests/infrastructure/metadata/infrastructure/testdriver/bidi/bluetooth/simulate_gatt_connection_response.https.html.ini"], "git_node": "609582f49b3d923deb66b4d445dce792d0f6d3f9", "git_parents": ["894291aed8a7d16de042192cc0df916730ef622c"], "node": "871e885854fb12cb20c1e563414d593e56be45cd", "parents": ["7bbb3c89ea64dfa38d420b9bbf14093b26101a3a"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2086684 [wpt PR 64077] - layout: When style of table grid changes, repair its fragments, a=testonly\n\nAutomatic update from web-platform-tests\nlayout: When style of table grid changes, repair its fragments\n\nWhen the style of a box changes, we need to repair the style of the\nfragments (if we can keep them, e.g. if there is only paint damage).\nThis is handled in `LayoutBoxBase::repair_style()`. However, table\nelements have a table wrapper and a table grid, and only the former owns\na `LayoutBoxBase`. So we weren't updating the fragments of the grid.\n\nTo address this, this patch iterates the children fragments of the\nfragments of the table wrapper, checks if they belong to the table grid\n(could also belong to a table caption), and if so repairs their style.\n\nSigned-off-by: Oriol Brufau \u003cobrufau@igalia.com\u003e\n\n--\n\nwpt-commits: 30c8fa729a746472239a3ef1dc5728a96a0e4f38\nwpt-pr: 64077\n", "files": ["testing/web-platform/tests/css/CSS2/tables/table-background-color-dynamic.html"], "git_node": "5431b3408c03c4185a20eec2ee1af93f130d5f7d", "git_parents": ["609582f49b3d923deb66b4d445dce792d0f6d3f9"], "node": "ade48e10f5e155124721f8afc5dc5b1e00be9fed", "parents": ["871e885854fb12cb20c1e563414d593e56be45cd"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2086690 [wpt PR 64074] - Copy ListedElements before iterating in ConstructEntryList, a=testonly\n\nAutomatic update from web-platform-tests\nCopy ListedElements before iterating in ConstructEntryList\n\nHTMLFormElement::ConstructEntryList and BuildSearchString iterate over\nListedElements() while calling AppendToFormData() on each control. For\n\u003ctextarea\u003e, AppendToFormData() forces a synchronous style and layout\nupdate, which can mutate the DOM and clear listed_elements_ mid-loop.\nCopy ListedElements() before iterating, matching HTMLFormElement::reset\nand the HTML specification.\n\nAlso guard ImageInputType::EnsurePrimaryContent() with InStyleRecalc(),\nmatching ImageInputType::SetUseFallbackContent(), so synchronous cached\nimage completion during layout tree attachment does not mutate the UA\nshadow tree during style recalc.\n\nFixed: 569286605\nChange-Id: Ide74cfb742e8df43258883b11caf219e15d02d76\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8613243\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1725339}\n\n--\n\nwpt-commits: 9237fe22ba88fa602f9e886a23ab21911b26d5f8\nwpt-pr: 64074\n", "files": ["testing/web-platform/tests/html/semantics/forms/form-submission-0/construct-entry-list-disassociate-crash.html"], "git_node": "40901391b30993568bba1d8a7ef1200a20e04971", "git_parents": ["5431b3408c03c4185a20eec2ee1af93f130d5f7d"], "node": "ca12d3febfd8441e930f6b086d3330e22a958136", "parents": ["ade48e10f5e155124721f8afc5dc5b1e00be9fed"], "tags": []}, {"author": "Viktoriya Bryhider \u003cvbryhider@microsoft.com\u003e", "branch": "default", "desc": "Bug 2086694 [wpt PR 64080] - WebTransport: wpt test for send stream and group statistics, a=testonly\n\nAutomatic update from web-platform-tests\nWebTransport: wpt test for send stream and group statistics\n\nAdd coverage for bytesWritten, bytesSent, and bytesAcknowledged on\nbidirectional and unidirectional send streams and their shared send\ngroup, in both window and worker contexts.\n\nCheck that an empty group reports zero counters, group totals equal the\nsum of both streams, and final counters remain available after stream\nclosure.\n\nBug: 487117768\nChange-Id: Ib29a7b03d260a3ac29965bb523795533f7e895b2\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8621446\nReviewed-by: Nidhi Jaju \u003cnidhijaju@chromium.org\u003e\nCommit-Queue: Viktoriya Bryhider \u003cvbryhider@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1725341}\n\n--\n\nwpt-commits: d7fee68ec559105516de617d9eda78c878d9beff\nwpt-pr: 64080\n", "files": ["testing/web-platform/tests/webtransport/send-stream-stats.https.any.js"], "git_node": "63fef3853dcab3408817d51ca4fa53905b77f762", "git_parents": ["40901391b30993568bba1d8a7ef1200a20e04971"], "node": "c44bcbdd9c65a185c0d11816e48d85155ccd02db", "parents": ["ca12d3febfd8441e930f6b086d3330e22a958136"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086694 [wpt PR 64080] - Update wpt metadata, a=testonly\n\nwpt-pr: 64080\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webtransport/send-stream-stats.https.any.js.ini"], "git_node": "3dd6f0c4e626665322150bd4b007219241a82f6d", "git_parents": ["63fef3853dcab3408817d51ca4fa53905b77f762"], "node": "1ac9a4265542c47430b9927ec836fb82339e6d5e", "parents": ["c44bcbdd9c65a185c0d11816e48d85155ccd02db"], "tags": []}, {"author": "Felipe Erias \u003cfelipeerias@igalia.com\u003e", "branch": "default", "desc": "Bug 2086703 [wpt PR 64081] - [svg] Relayout an embedded SVG document's root when its frame is resized, a=testonly\n\nAutomatic update from web-platform-tests\n[svg] Relayout an embedded SVG document's root when its frame is resized\n\nThe root of an SVG document inside \u003cobject\u003e, \u003cembed\u003e, or a\nRemoteFrameOwner takes the size of its frame. These SVG roots are\nidentified by IsEmbeddedThroughFrameContainingSVGDocument() and sized\nin ComputeReplacedSize().\n\nHowever, the SVG root's own height is still used to decide whether its\ncached layout can be reused. When that height is a fixed length, for\nexample height=\"50\", the cached layout will still be reused after the\nheight of the frame changes, and the root will keep its old height\ninstead of adapting to the new size of its frame.\n\nChanges in width are already handled because the width is recomputed\non every resize.\n\nMake SizeMayChange() return true for SVG roots embedded through a\nframe, so that their size is recomputed whenever the frame is resized.\n\nTests:\n  /wpt/svg/coordinate-systems/outer-svg-resize-001e.html\n  /wpt/svg/coordinate-systems/outer-svg-resize-001o.html\n\nBug: 571643055\nChange-Id: I13a438d29d4d01271b7ed0097020ba8a30bba9a4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8547836\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCommit-Queue: Felipe Erias \u003cfelipeerias@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1725342}\n\n--\n\nwpt-commits: d9c2fe571d3ea2cfe1c643f37f8406a12339fa5e\nwpt-pr: 64081\n", "files": ["testing/web-platform/tests/svg/coordinate-systems/outer-svg-resize-001e.html", "testing/web-platform/tests/svg/coordinate-systems/outer-svg-resize-001o.html"], "git_node": "7fb620db8e9b73994855d1c5068efba7cc53bc7b", "git_parents": ["3dd6f0c4e626665322150bd4b007219241a82f6d"], "node": "2abe3cb2c48d5aab705cb3918a408276219c4799", "parents": ["1ac9a4265542c47430b9927ec836fb82339e6d5e"], "tags": []}, {"author": "Noam Rosenthal \u003cnoamr@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2082738 [wpt PR 63728] - Mark unspec'd Long Animation Frame tests as tentative, a=testonly\n\nAutomatic update from web-platform-tests\nMark unspec'd Long Animation Frame tests as tentative (#63728)\n\n- Split ECMAScript `import.then` from `loaf-promise.html` into `loaf-promise-import.tentative.html`.\n- Split `StreamPromise.resolve` from `loaf-stream.html` into `loaf-stream-source-location.tentative.html` (and rename `loaf-stream-source-location.html` to `.tentative.html`).\n- Rename `performance-bind.html`, `conditional-user-timing-basic.html`, `conditional-user-timing-buffer-limit.html`, `conditional-measure-time-resolve.html`, and `loaf-congested-moment-worker.html` to `.tentative.html`.\n--\n\nwpt-commits: 7d604ea1ff2447ded8648c3fba5d6d966463b81e\nwpt-pr: 63728\n", "files": ["testing/web-platform/tests/long-animation-frame/conditional-measure-time-resolve.html", "testing/web-platform/tests/long-animation-frame/conditional-measure-time-resolve.tentative.html", "testing/web-platform/tests/long-animation-frame/conditional-user-timing-basic.html", "testing/web-platform/tests/long-animation-frame/conditional-user-timing-basic.tentative.html", "testing/web-platform/tests/long-animation-frame/conditional-user-timing-buffer-limit.html", "testing/web-platform/tests/long-animation-frame/conditional-user-timing-buffer-limit.tentative.html", "testing/web-platform/tests/long-animation-frame/loaf-congested-moment-worker.html", "testing/web-platform/tests/long-animation-frame/loaf-congested-moment-worker.tentative.html", "testing/web-platform/tests/long-animation-frame/loaf-promise-import.tentative.html", "testing/web-platform/tests/long-animation-frame/loaf-promise.html", "testing/web-platform/tests/long-animation-frame/loaf-stream-source-location.html", "testing/web-platform/tests/long-animation-frame/loaf-stream-source-location.tentative.html", "testing/web-platform/tests/long-animation-frame/performance-bind.html", "testing/web-platform/tests/long-animation-frame/performance-bind.tentative.html"], "git_node": "ac85ea0f0b82d26aa5e39677d56bacd923e43f71", "git_parents": ["7fb620db8e9b73994855d1c5068efba7cc53bc7b"], "node": "667070d0c6c01a6134589a772d32c4eae71e1f1a", "parents": ["2abe3cb2c48d5aab705cb3918a408276219c4799"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082738 [wpt PR 63728] - Update wpt metadata, a=testonly\n\nwpt-pr: 63728\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/long-animation-frame/conditional-measure-time-resolve.html.ini", "testing/web-platform/meta/long-animation-frame/conditional-user-timing-basic.html.ini", "testing/web-platform/meta/long-animation-frame/conditional-user-timing-buffer-limit.html.ini", "testing/web-platform/meta/long-animation-frame/loaf-congested-moment-worker.html.ini", "testing/web-platform/meta/long-animation-frame/loaf-stream-source-location.html.ini", "testing/web-platform/meta/long-animation-frame/performance-bind.html.ini"], "git_node": "e0eb0c84c098e2d32992a7932c4748c1d9e67095", "git_parents": ["ac85ea0f0b82d26aa5e39677d56bacd923e43f71"], "node": "e06f41d192279c0b2e724bdb6c8fb80a4711863f", "parents": ["667070d0c6c01a6134589a772d32c4eae71e1f1a"], "tags": []}, {"author": "Basuke Suzuki \u003cbasuke@apple.com\u003e", "branch": "default", "desc": "Bug 2086724 [wpt PR 63996] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326453, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=326453 (#63996)\n\n* [Navigation API] navigation.traverseTo() from a navigate event can apply before the current traversal's hashchange under Site Isolation\n\nWith UseUIProcessForBackForwardItemLoading, which Site Isolation turns on, a page's history\ntraversals were not ordered against each other, so a navigation.traverseTo() called from the\nnavigate event of a history.back() was applied before that back traversal's hashchange event.\nThis change sends all of a page's traversals through the UI process's\nSessionHistoryTraversalQueue, and the queue now waits until every frame has handled the current\ntraversal before it starts the next one. That matches the HTML spec's session history traversal\nqueue, which applies the traversals of a traversable one after another.\n\nBefore this change, traversals took three paths:\n- A main-frame history.back(), history.forward() or history.go(n) was applied by the UI process\n  at once.\n- The same call from a frame whose top is in another process went through\n  SessionHistoryTraversalQueue.\n- A Navigation API traversal was applied in the web process by NavigationScheduler, after\n  synchronous messages to the UI process for the current back/forward item and, from an iframe,\n  for every item.\n\nNow:\n- A Navigation API traversal sends the frame item identifier of its entry to the UI process\n  (EnqueueHistoryTraversalToItem), instead of those synchronous messages. A back/forward item\n  identifier would not do: for the initial entry of a cross-process iframe, the UI process re-keys\n  the frame item under the parent's current item, and the iframe's process keeps the identifier it\n  generated. When the traversal's turn comes, the queue finds the entry in the page's back/forward\n  list and resolves the target to a delta: the nearest back/forward item, behind and then ahead of\n  the current one, that contains the entry. The web process still uses the same rule for iframes\n  when the preference is off. If the entry has left the list, or a traversal queued earlier has\n  already made it current, nothing moves and the traversal is rejected; the rejection does nothing\n  when the earlier traversal's navigate event has settled the promises. Otherwise the queue applies\n  the delta like any other, so the traversal also has a direction for\n  the stale BackForwardGoToItem check (https://bugs.webkit.org/show_bug.cgi?id=318728). The web\n  process receives an ordinary GoToBackForwardItem, and the navigate event attaches the upcoming\n  traverse method tracker as before. NavigationScheduler::isSameDocumentNavigation() also answers\n  from the entry.\n- A main-frame history.back(), history.forward() or history.go(n) is enqueued too. Every scripted\n  main-frame traversal under Site Isolation now waits for the queue's 0-delay timer, and deltas\n  from different frames that arrive before it fires are coalesced.\n- The queue keeps item traversals and deltas in order and coalesces only adjacent deltas. When\n  coalescing two deltas overflows, both are dropped, instead of canceling the whole queue.\n\nTo tell when a traversal is finished, GoToBackForwardItem now has a reply.\nHistoryController::goToItem takes a completion handler that runs once the history policy decision\nhas been applied, on every path. The web process replies from it with a FrameTraversalResult: the\nframe did not take the traversal, took it (applied it or deferred it for a precommit handler), or\nstarted a load for it. The queue waits for a reply from every frame the traversal was sent to.\nIPC calls the reply handler even when a web process exits, so a crashed frame process does not\nhold the queue. Previously the queue settled only on a main-frame commit, same-document\nnavigation or provisional load failure. None of these happens for a traversal that changes only\na subframe or one canceled by the navigate event, so such a traversal held every later one.\n\nWhen a traversal changes the main frame within its document, the UI process now sends it to the\nother frames only after the main frame replies that it took it, because canceling the navigate\nevent there cancels the traversal for all frames. A Navigation API traversal is answered once\nevery frame has replied. If no frame took it, for example because the main frame canceled it\nbefore it reached the frame that asked for it, the answer rejects the traversal's promises. That\ncan reject a tracker that has already settled, so Navigation::MethodTrackerRegistry::unregister()\nnow removes an upcoming traversal only when it belongs to the tracker being unregistered.\n\nWhen the main frame starts a cross-document load, the queue also waits for that load to commit or\nfail, as before, or to be destroyed, because a delta resolved earlier could see a stale current\nindex (https://bugs.webkit.org/show_bug.cgi?id=317229). This wait accepts any main-frame commit or\nfailure: a navigation whose provisional page is replaced never reports its own identifier again,\nand waiting for it would hold the queue. The wait also ends when a provisional process terminates\nbefore it commits, since that load then reports neither a commit nor a failure. The queue is\ncanceled when the main frame's process terminates.\n\nTraversals that the UI process starts itself, such as goBack() from the API or a swipe, still do\nnot go through the queue, but they take the main-frame-first dispatch above too.\n\nnavigate-history-traversal-during-onnavigate.html failed with Site Isolation enabled, in 188 of\nthe last 200 runs on the mac site-isolation bot, and now passes.\nprecommitHandler-back-and-forth.html now passes with Site Isolation too, so it gets a\nmac-site-isolation result. The four new WPTs, which will be exported, cover a traversal after one\nthat the navigate event canceled, a traversal to an entry that a traversal queued before it made\ncurrent, and traversals from a cross-site iframe, which runs in another process with Site\nIsolation. With Site Isolation, the traversal to the entry made current took an iframe back before\nthis change. The cross-site ones give the iframe user activation with\ntest_driver.bless(), because WebKit blocks a cross-site iframe without user interaction from\nnavigating the top-level traversable. The two new WKBackForwardList API tests call history.back()\nand, in a later task, history.back() or history.forward() from the main frame, and fail without\nthis change: the later traversal resolved its delta against the item the first one was leaving.\nHistoryTraversalAfterProvisionalProcessTerminatesBeforeCommit kills the provisional process of a\nmain-frame traversal before it commits; every later traversal used to wait for it. It checks only\nthat a later traversal applies, because the back/forward list's current item stays on the dropped\nentry, so that traversal fires no navigate event and its promises do not settle.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326453\nWebKit-Canonical-Link: https://commits.webkit.org/324250@main\n\n* Run the setup navigations of traverseTo-and-forward-in-cross-site-iframe.html after load\n\nThe helper navigated to #1 and #2 from its own load event handler. A navigation made before the\nload event completes is converted into a replace navigation, so in Chrome the iframe stayed at\nindex 0 and the test was unstable. The test now waits for its own load event before it creates\nthe iframe, and the helper runs those navigations from a \"setup\" command that the test sends once\nthe iframe has loaded.\n--\n\nwpt-commits: f96817949ed167092bfe25f4742ba192d995fb41\nwpt-pr: 63996\n", "files": ["testing/web-platform/tests/navigation-api/navigate-event/navigation-back-same-document-preventDefault-then-traverseTo.html", "testing/web-platform/tests/navigation-api/navigate-event/navigation-traverseTo-in-cross-site-iframe-same-document-preventDefault.html", "testing/web-platform/tests/navigation-api/navigate-event/resources/navigation-traverseTo-in-cross-site-iframe-helper.html", "testing/web-platform/tests/navigation-api/navigation-methods/resources/traverseTo-and-forward-in-cross-site-iframe-helper.html", "testing/web-platform/tests/navigation-api/navigation-methods/traverseTo-and-forward-in-cross-site-iframe.html", "testing/web-platform/tests/navigation-api/navigation-methods/traverseTo-target-made-current-by-earlier-traversal.html"], "git_node": "b8619a519fc812b41961dae31804f9799fb580bb", "git_parents": ["e0eb0c84c098e2d32992a7932c4748c1d9e67095"], "node": "f1d31932b0993110fa9682c5865310fa588da164", "parents": ["e06f41d192279c0b2e724bdb6c8fb80a4711863f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086724 [wpt PR 63996] - Update wpt metadata, a=testonly\n\nwpt-pr: 63996\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/navigation-api/navigation-methods/traverseTo-and-forward-in-cross-site-iframe.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/traverseTo-target-made-current-by-earlier-traversal.html.ini"], "git_node": "f352be10f309d16a67cc17b267199f421bc3cb72", "git_parents": ["b8619a519fc812b41961dae31804f9799fb580bb"], "node": "c58e48d7bf88ea3d97f4b196b91e46c5443c1da5", "parents": ["f1d31932b0993110fa9682c5865310fa588da164"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2086725 [wpt PR 62451] - text-decoration-skip-spaces: default to start end, a=testonly\n\nAutomatic update from web-platform-tests\ntext-decoration-skip-spaces: default to start end (#62451)\n\nChange the initial value from `none` to `start end` per CSS Text\nDecoration 4. Absorb the new default in unrelated tests.\n\nBug: 40862777\nChange-Id: I9fe2a65dc62f417c85c19f14154d8b7ae1d489a3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8316575\nSLSA-Policy-Verified: SLSA Policy Verification Service \u003cdevtools-gerritcodereview-exitgate@google.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Perry \u003cperryuwang@gmail.com\u003e\nCr-Commit-Position: refs/heads/main@{#1692359}\n\nCo-authored-by: Perry \u003cperryuwang@gmail.com\u003e\n--\n\nwpt-commits: e77c281318e395e2050147a0e1f1040749038ae8\nwpt-pr: 62451\n", "files": ["testing/web-platform/tests/css/css-pseudo/active-selection-021.html", "testing/web-platform/tests/css/css-pseudo/highlight-painting-currentcolor-003b-ref.html", "testing/web-platform/tests/css/css-text-decor/invalidation/reference/selection-pseudo-with-decoration-invalidation-001-ref.html", "testing/web-platform/tests/css/css-text-decor/invalidation/reference/selection-pseudo-with-decoration-invalidation-002-ref.html", "testing/web-platform/tests/css/css-text-decor/reference/text-decoration-inset-011-ref.html", "testing/web-platform/tests/css/css-text-decor/reference/text-decoration-inset-017-ref.html", "testing/web-platform/tests/css/css-text-decor/reference/text-decoration-inset-018-ref.html", "testing/web-platform/tests/css/css-text-decor/reference/text-decoration-inset-019-ref.html", "testing/web-platform/tests/css/css-text-decor/reference/text-decoration-inset-020-ref.html", "testing/web-platform/tests/css/css-text-decor/reference/text-decoration-inset-021-ref.html", "testing/web-platform/tests/css/css-text-decor/reference/text-decoration-inset-022-ref.html", "testing/web-platform/tests/css/css-text-decor/reference/text-decoration-inset-023-ref.html", "testing/web-platform/tests/css/css-text-decor/reference/text-decoration-inset-027-ref.html"], "git_node": "05d6b5705c4c79b9a2106da169914f7ee8989bf4", "git_parents": ["f352be10f309d16a67cc17b267199f421bc3cb72"], "node": "b904391b29edef370fab9f76f521e07936b41abb", "parents": ["c58e48d7bf88ea3d97f4b196b91e46c5443c1da5"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2086730 [wpt PR 62504] - [MathML] Support `referrerPolicy` IDL attribute for MathMLAnchorElement, a=testonly\n\nAutomatic update from web-platform-tests\n[MathML] Support `referrerPolicy` IDL attribute for MathMLAnchorElement (#62504)\n\nThis patch exposes the `referrerPolicy` IDL attribute on\nMathMLAnchorElement.\n\nNote that the C++ side implementation was already implemented in a\nprevious patch.[1]\n\nThis patch also updates referrer-policy spec to generate `mathml-a-tag`\ntest cases and adds an IDL reflection test.\n\n[1] https://chromium-review.googlesource.com/c/chromium/src/+/7940188\n\nBug: 510487697\nChange-Id: I375e66ac472d8677ef7333e45b605946102b97a9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8253141\nReviewed-by: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCommit-Queue: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1693309}\n\nCo-authored-by: tannal \u003cmtan@igalia.com\u003e\n--\n\nwpt-commits: b458296e917b9ffada61686044fc670a74f476ec\nwpt-pr: 62504\n", "files": ["testing/web-platform/tests/common/security-features/resources/common.sub.js", "testing/web-platform/tests/common/security-features/tools/spec.src.json", "testing/web-platform/tests/common/security-features/tools/spec_validator.py", "testing/web-platform/tests/mathml/relations/html5-tree/a-referrerpolicy-getter-setter.html", "testing/web-platform/tests/referrer-policy/gen/iframe-data-inherit.http-rp/no-referrer-when-downgrade/mathml-a-tag.http.html.headers", "testing/web-platform/tests/referrer-policy/gen/iframe-data-inherit.http-rp/no-referrer/mathml-a-tag.http.html.headers", "testing/web-platform/tests/referrer-policy/gen/iframe-data-inherit.http-rp/origin-when-cross-origin/mathml-a-tag.http.html.headers", "testing/web-platform/tests/referrer-policy/gen/iframe-data-inherit.http-rp/origin/mathml-a-tag.http.html.headers", "testing/web-platform/tests/referrer-policy/gen/i