12ffb4587541f965b983a5b353", "a2d160cd52495da596bf964b8de241140c112020", "3ed42ddda238c46d0d891b15d920bfdb6aec57ec", "50126b79e86d6278e8605bf2e7754efb1da7d5ee", "054629418c331fc70e11b527ef9cb90e683ad6e0", "44d954cf200feb54331605a85a8169945a9d9741", "398f79ae4dffcc5db3c743d6fae06912c506ef26", "dc97529f480272228eabb6012c67a9e00859b012", "413fd3d35b03c0649fdfc84dfa7c6d5e744c22be", "dd74255b5b4005f7f1fb2010a94a4496797fabd0", "7007c87f4d0c31b87dd40243dc74d22b6ecd454f", "5483aee701e02cab0d2abd9dfbcaab3cbc119b20", "79c51587f352fb592931bde830d88350a3453571", "1bcf617a8ba788d466c00ec1dfd25ab5c6ad96c9", "f6fbf3a4af12df5002a055fad63beba25c6d1c18", "cac2c0cf44beecb92c93119bd79e2408636f76d7"], "user": "rperta@mozilla.com"}, "45811": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic newtab version bump NO BUG a=release CLOSED TREE DONTBUILD\n", "files": ["browser/extensions/newtab/manifest.json"], "git_node": "7d5d1e5f7a08e693636d192cd2415ae5e0f0ba34", "git_parents": ["cac2c0cf44beecb92c93119bd79e2408636f76d7"], "node": "d8629557d7601832802b4c26210e5c026a5aa88f", "parents": ["8dc8a7e0642289c9782651295b5586e008cbc6c4"], "tags": []}], "date": 1794972797, "git_changesets": ["7d5d1e5f7a08e693636d192cd2415ae5e0f0ba34"], "user": "ffxbld@lando.moz.tools"}, "45812": {"changesets": [{"author": "Tom Schuster \u003cevilpies@gmail.com\u003e", "branch": "default", "desc": "Bug 2093716 - Copy Clean Link: Strip query parameters \"_su_rec\" and \"_su_rec_id\" from all websites. r=manuel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343296\n", "files": ["toolkit/components/antitracking/StripOnShareLists/MPL2/StripOnShare.json"], "git_node": "ba5ea450d784ff949c86d9ea91b647605c607c05", "git_parents": ["cac2c0cf44beecb92c93119bd79e2408636f76d7"], "node": "9f0608837b147322bddb3345b9d5afe001b9540a", "parents": ["8dc8a7e0642289c9782651295b5586e008cbc6c4"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091229 - Replace deprecated APIs in GeckoView with their exact equivalents. r=geckoview-reviewers,crashreporting-reviewers,afranchuk,ohall\n\nEach replacement is what the deprecated API itself does at GeckoView's minimum SDK, so behavior is unchanged:\nHandler(Looper.myLooper()) after Looper.prepare(), DefaultLifecycleObserver, ParcelCompat, PackageInfoCompat,\nView.isAttachedToWindow, VibrationEffect with the IllegalArgumentException the deprecated Vibrator methods\ncaught, the process-bitness ABI list that Build.CPU_ABI is taken from, and the snakeyaml and lint methods the\ndeprecated ones delegate to.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341412\n", "files": ["mobile/android/annotations/src/main/java/org/mozilla/gecko/annotationProcessors/SDKProcessor.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoThread.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/mozglue/GeckoLoader.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/DebugConfig.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/GeckoBackgroundThread.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/HardwareUtils.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/CrashHandler.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/CrashReporter.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoInputConnection.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoResult.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoRuntime.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoView.java", "mobile/android/geckoview/src/test/java/org/mozilla/gecko/GeckoAppShellTest.java", "mobile/android/geckoview/src/test/java/org/mozilla/gecko/util/DebugConfigTest.java"], "git_node": "ad5922c4a04bead1b5a39e95f9711e6d734f4bf9", "git_parents": ["ba5ea450d784ff949c86d9ea91b647605c607c05"], "node": "0d96bb877fa81af4a1542a4c6e90bab8e82871df", "parents": ["9f0608837b147322bddb3345b9d5afe001b9540a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091229 - Remove deprecated GeckoView calls that have no effect. r=geckoview-reviewers,jnicol,m_kato\n\nDisplay.getPixelFormat always returns RGBA_8888, so the screen depth needs no lookup or cache. A new\nMemoryFile already disallows purging, and setWillNotCacheDrawing(false) sets the default value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341414\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/mozglue/SharedMemory.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoRuntimeSettings.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoView.java"], "git_node": "ed53ee0fa55a9a5e4c3fea5cc0ab8bd1710c6a70", "git_parents": ["ad5922c4a04bead1b5a39e95f9711e6d734f4bf9"], "node": "fec9ac06dd14c148d733759175064f58e848c41a", "parents": ["0d96bb877fa81af4a1542a4c6e90bab8e82871df"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091229 - Set the speech synthesis language for voices that have a region or script. r=geckoview-reviewers,ohall\n\nVoice URIs carry Locale.toString(), and new Locale(\"en_US\") turns that into the language \"en_us\", which\nTextToSpeech.setLanguage rejects. Parse it back into a real locale, and pass the speech parameters as a\nBundle.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341415\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/SpeechSynthesisService.java", "mobile/android/geckoview/src/test/java/org/mozilla/gecko/SpeechSynthesisServiceTest.java"], "git_node": "cb34d0d1bb622c0eb72c5b5b53e4f582019ef609", "git_parents": ["ed53ee0fa55a9a5e4c3fea5cc0ab8bd1710c6a70"], "node": "a2ed659f394e5e2a6be85ee2dd13d5b5547d7474", "parents": ["fec9ac06dd14c148d733759175064f58e848c41a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091229 - Use setCommunicationDevice for Bluetooth SCO routing on API 31+. r=geckoview-reviewers,media-playback-reviewers,jolin,ohall\n\nThe communication device is only cleared if GeckoView requested Bluetooth SCO and it is still the active\nroute, as stopBluetoothSco only cancels an SCO request from the same process and leaves other routes alone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341416\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "mobile/android/geckoview/src/test/java/org/mozilla/gecko/GeckoAppShellTest.java"], "git_node": "5055b4fc10a2246f98db5c7ed77a63edfdc19f67", "git_parents": ["cb34d0d1bb622c0eb72c5b5b53e4f582019ef609"], "node": "1b25f4d4edb0241a248bae063f150317e559fd98", "parents": ["a2ed659f394e5e2a6be85ee2dd13d5b5547d7474"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091229 - Use the androidx back and activity result APIs in geckoview_example. r=geckoview-reviewers,android-build-system-reviewers,mcarare,ohall\n\nAlso drop the \"session\" intent extra: GeckoSession is not Parcelable, so nothing can send it. A back press\nwith no current session now falls back to the default handling instead of throwing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341417\n", "files": ["mobile/android/geckoview_example/build.gradle", "mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/BasicGeckoViewPrompt.java", "mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/GeckoViewActivity.java", "mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/SettingsActivity.java"], "git_node": "16d0549b3aefa6a97d122b75ac60f5cd8a1749fc", "git_parents": ["5055b4fc10a2246f98db5c7ed77a63edfdc19f67"], "node": "9c9dbcf973f0f39e35215bbff7ce473536bd8c52", "parents": ["1b25f4d4edb0241a248bae063f150317e559fd98"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091229 - Suppress the remaining deprecated API uses in GeckoView as narrowly as possible. r=geckoview-reviewers,crashreporting-reviewers,ohall\n\nWhat is left has no replacement at GeckoView's minimum SDK, needs a newer API level, or is a platform method\nthat must still be implemented. Legacy branches move into small suppressed helpers, so they can be deleted\nwhen the minimum SDK rises.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341418\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoJavaSampler.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoSensor.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoThread.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/MagnifiableSurfaceView.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/SpeechSynthesisService.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/MemoryController.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/GeckoBundle.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/ThreadUtils.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/CrashHandler.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoDisplay.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoEditable.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "mobile/android/test_runner/src/main/java/org/mozilla/geckoview/test_runner/XpcshellTestRunnerService.java"], "git_node": "80f5157e3420d0609ed7a025e8667da05228af18", "git_parents": ["16d0549b3aefa6a97d122b75ac60f5cd8a1749fc"], "node": "fc24c442af0c29aeabfab3b40d7e4a58f851a56d", "parents": ["9c9dbcf973f0f39e35215bbff7ce473536bd8c52"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2092698 - Remove the unused geckoview-junit command from the test package r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342776\n", "files": ["testing/mochitest/mach_test_package_commands.py", "testing/tools/mach_test_package_initialize.py"], "git_node": "79ec4000542393ba16dd0687aff70e7432f9d453", "git_parents": ["80f5157e3420d0609ed7a025e8667da05228af18"], "node": "4a4ea3e89e43f20a001bd69fad741565cbf49251", "parents": ["fc24c442af0c29aeabfab3b40d7e4a58f851a56d"], "tags": []}, {"author": "Greg Woods \u003cgwoods@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089256 - Fix incorrect license header on test_restore_sidebar.py and test_restore_sidebar_automatic.py, r=sessionstore-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343668\n", "files": ["browser/components/sessionstore/test/marionette/test_restore_sidebar.py", "browser/components/sessionstore/test/marionette/test_restore_sidebar_automatic.py"], "git_node": "0fabfe64c973bfbe6a6dfaa42c73af22884ad9a6", "git_parents": ["79ec4000542393ba16dd0687aff70e7432f9d453"], "node": "a5c84a21a1a5b847add21e095b70e60bf79df702", "parents": ["4a4ea3e89e43f20a001bd69fad741565cbf49251"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2079919 - Remove the no-fission reftest variants on Android and run software WebRender with Fission r=RyanVM,taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333889\n", "files": ["taskcluster/kinds/reftest/kind.yml", "taskcluster/test_configs/variants.yml", "tools/tryselect/try_presets.yml"], "git_node": "c158d2c38c310892041037f129f652c052aec6ac", "git_parents": ["0fabfe64c973bfbe6a6dfaa42c73af22884ad9a6"], "node": "45bc0b2f4662eb84e96216876f5559ec09881563", "parents": ["a5c84a21a1a5b847add21e095b70e60bf79df702"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091837: Restore native menu icons on macOS 27. r=mac-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341983\n", "files": ["widget/cocoa/nsMenuItemX.mm", "widget/cocoa/nsMenuX.mm"], "git_node": "0ac748d4e5b7fa048f165f8abfcb2aefe2b099e8", "git_parents": ["c158d2c38c310892041037f129f652c052aec6ac"], "node": "09cea8a495fedf8a24b9e07265bd428a557c512c", "parents": ["45bc0b2f4662eb84e96216876f5559ec09881563"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2092515 - Add a daily tier 2 Linux64 debug build linked with mold. r=firefox-build-system-reviewers,taskgraph-reviewers,ahochheiden,bhearsum\n\nTo make sure we keep supporting mold.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342545\n", "files": [".cron.yml", "browser/config/mozconfigs/linux64/debug-mold", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/build/linux.yml"], "git_node": "2ae9df4ca28f94d0b5913ab3aedf91a2e401d14a", "git_parents": ["0ac748d4e5b7fa048f165f8abfcb2aefe2b099e8"], "node": "c490f98eabafaff2e2e63243779ac558ebd54eba", "parents": ["09cea8a495fedf8a24b9e07265bd428a557c512c"], "tags": []}, {"author": "Tyler Etchart \u003ctetchart@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094237 - added LLM tool call metadata to calls to help fix it for models like Gemini 3.8 and Gemini 4 argon r=ai-platform-reviewers,again,gregtatum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343638\n", "files": ["browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "toolkit/components/ml/content/backends/OpenAIPipeline.mjs"], "git_node": "c9105d0f3f86036fffc6076deea30ca73f406898", "git_parents": ["2ae9df4ca28f94d0b5913ab3aedf91a2e401d14a"], "node": "d58d3155460d0b19eaef119ef1b0b0eb4ac0dba6", "parents": ["c490f98eabafaff2e2e63243779ac558ebd54eba"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094306 - build NSS with disable_deprecated_seed=1. r=crypto-reviewers,keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343702\n", "files": ["security/moz.build"], "git_node": "6c222978a78dffc8fb982ca62f0d069b27711506", "git_parents": ["c9105d0f3f86036fffc6076deea30ca73f406898"], "node": "af9580c61069b9792a58103e1b02fcf7c91810c2", "parents": ["d58d3155460d0b19eaef119ef1b0b0eb4ac0dba6"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 1869367 - Add Arc browser migrator. r=jhirsch,fluent-reviewers,chutten,bolsson,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337289\n", "files": ["browser/app/profile/firefox.js", "browser/components/migration/ArcMigrationUtils.sys.mjs", "browser/components/migration/ChromeMigrationUtils.sys.mjs", "browser/components/migration/ChromeProfileMigrator.sys.mjs", "browser/components/migration/MigrationUtils.sys.mjs", "browser/components/migration/content/brands/arc.png", "browser/components/migration/jar.mn", "browser/components/migration/metrics.yaml", "browser/components/migration/moz.build", "browser/components/migration/tests/unit/test_Arc_spaces.js", "browser/components/migration/tests/unit/xpcshell.toml", "browser/locales/en-US/browser/migrationWizard.ftl", "toolkit/components/telemetry/Histograms.json"], "git_node": "5c25eab23f51f6b24b66105b926d60d8dea7e76c", "git_parents": ["6c222978a78dffc8fb982ca62f0d069b27711506"], "node": "c689afe36c353a7a0ad91b9d4ad5d43d836d605b", "parents": ["af9580c61069b9792a58103e1b02fcf7c91810c2"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084937 - [WebCrypto] importKey to check for JWK with duplicate key_ops r=crypto-reviewers,jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336137\n", "files": ["dom/crypto/WebCryptoTask.cpp", "testing/web-platform/tests/WebCryptoAPI/import_export/jwk_key_ops_duplicates.https.any.js"], "git_node": "7821005d6b7ab7068116e8e426c946328d3f3155", "git_parents": ["5c25eab23f51f6b24b66105b926d60d8dea7e76c"], "node": "e2f599f15ce333783a20f630409312f10de0c477", "parents": ["c689afe36c353a7a0ad91b9d4ad5d43d836d605b"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080905 - Report the actual date range for imported history. r=jhirsch,migration-reviewers,fluent-reviewers,bolsson,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340196\n", "files": ["browser/components/migration/MigrationUtils.sys.mjs", "browser/components/migration/MigrationWizardParent.sys.mjs", "browser/components/migration/MigratorBase.sys.mjs", "browser/components/migration/tests/unit/test_Chrome_history.js", "browser/components/migration/tests/unit/test_Safari_history.js", "browser/locales/en-US/browser/migrationWizard.ftl"], "git_node": "62df8029554b8095f34c82ad7510bd823cb80073", "git_parents": ["7821005d6b7ab7068116e8e426c946328d3f3155"], "node": "2c37a8df3015d10422f5922685f24b4e2633a987", "parents": ["e2f599f15ce333783a20f630409312f10de0c477"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2084966 - Store PseudoStyleRequest for the subject of ViewTimeline. r=layout-reviewers,layout-scroll-driven-animation-reviewers,dshin\n\nOtherwise, we miss the info of pseudo-elements which require\nthe identifier, e.g. named view-transition pseudo-elements. This makes\nus impossible to get the correct view timeline target especially when\nwe are updating TimelineNameMap.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343705\n", "files": ["dom/animation/ViewTimeline.cpp", "dom/animation/ViewTimeline.h", "testing/web-platform/tests/scroll-animations/crashtests/view-timeline-on-view-transition-pseudo-element-crash.html"], "git_node": "faf143cda942b3485e30c21ca03b6885422027d9", "git_parents": ["62df8029554b8095f34c82ad7510bd823cb80073"], "node": "b10d560e0c3fc64a39f3b9aa78a7c99576405b16", "parents": ["2c37a8df3015d10422f5922685f24b4e2633a987"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081369: Fix aitab_context_tab_limit and aitab_menu_triggers browser tests r=omarg\n\nInitially, `browser_aitab_context_tab_limit.js` was the only test failing test-verify on macOS debug in the chaos mode steps, for two reasons:\n\n1. Timeout threshold. Under debug + chaos mode the file ran for ~341s against the 180s per-file limit. Each it opened a new AI Window through AIWindowTestUtils.openReadyAIWindow (10-14s each under chaos mode) plus 3 to 12 tabs opened one at a time (~3s each), so most of the time went into setup rather than the assertions.\n\n2. Intermittent hang while opening the AI Window. Sometimes aiWindow.html fired DOMContentLoaded but never load, so BrowserTestUtils.openNewBrowserWindow never resolved and the job hit the 740s no-output timeout (same signature as bug\u00a02060705). Opening a window per it meant 11 chances to hit it on every run.\n\nFix:\n- Split the file in two so each one gets its own 180s budget: browser_aitab_context_tab_limit.js keeps the \"more tabs than the limit\" tests, and browser_aitab_context_urls.js has the rest.\n- Add `\"ui.prefersReducedMotion\"` as seems like there was some kind of animation that contributed to the timeout (might be worth exploring more later?)\n\nAfter that fix, `aitab_menu_triggers` also started failing due to threshold and a timeout, so I decided to split it up into two separate files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333682\n", "files": ["browser/components/aiwindow/ui/test/browser/aitab/browser.toml", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_context_tab_limit.js", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_context_urls.js", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_page_group_menu_triggers.js", "browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_tab_menu_triggers.js", "browser/components/aiwindow/ui/test/browser/aitab/head.js", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aitab_menu_triggers.js", "browser/components/aiwindow/ui/test/browser/head_aitab.js"], "git_node": "63f37789d191b43917bad85a80dbc1be3c4d4af3", "git_parents": ["faf143cda942b3485e30c21ca03b6885422027d9"], "node": "26fc3e298d8823dadeb6a44e7101efdcc4b82034", "parents": ["b10d560e0c3fc64a39f3b9aa78a7c99576405b16"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2094051 - Ignore zip and unmaintained chrono/humantime cargo-audit advisories. r=supply-chain-reviewers DONTBUILD\n\nFirefox doesn't enable zip's aes-crypto feature (RUSTSEC-2026-0545) and\ndoesn't use ZipStreamReader or read_zipfile_from_stream\n(RUSTSEC-2026-0548).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343712\n", "files": [".cargo/audit.toml"], "git_node": "2b9f461ea07512ed0827ebdfcb4796c3c6ee0d4b", "git_parents": ["63f37789d191b43917bad85a80dbc1be3c4d4af3"], "node": "7b154522db209a452519e48c2c370d574dc0025e", "parents": ["26fc3e298d8823dadeb6a44e7101efdcc4b82034"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2093068 - Record the timings and profile data of the PGO profile run r=perftest-reviewers,firefox-build-system-reviewers,ahochheiden,kshampur\n\ngenerate-profile tasks only report their total duration, so neither how the\ntime splits between the profile initialization, the training run and the\nprofile merge, nor how long each training item takes, nor what the profile\ncontains, is known outside of each task's logs.\n\nprofileserver.py now, with build/pgo/pgo_metrics.py for what the other PGO\nscripts can share:\n- records each stage (profile initialization, training run, llvm-profdata\n  merge) and each training item as markers in the task's resource usage\n  profile, through mach's resource marker forwarding to run-task's monitor.\n  index.html reports each item's duration, and whether it signalled completion\n  or hit its timeout, to a /pgo-item handler of the profile server.\n- prints PERFHERDER_DATA (build_metrics framework, no alerting) with the stage\n  and item durations, the number of items that timed out, and the profile data:\n  .profraw count and size, merged.profdata size, and the `llvm-profdata show`\n  totals, including the number of functions the training run executed.\n\nOn a current linux64 profile that is 109,599 executed functions out of\n545,454, which is the number to watch when changing the training corpus.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342945\n", "files": ["build/pgo/index.html", "build/pgo/pgo_metrics.py", "build/pgo/profileserver.py"], "git_node": "3701d626d73919fc6419f272330bb000942af092", "git_parents": ["2b9f461ea07512ed0827ebdfcb4796c3c6ee0d4b"], "node": "5142619082c95d2b17d09eb2f1194303067dffe5", "parents": ["7b154522db209a452519e48c2c370d574dc0025e"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes mobile-merino-manifest ct-logs r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343720\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "aa873b682a582a0e0632eb2ce2dbf05c47dcaabe", "git_parents": ["3701d626d73919fc6419f272330bb000942af092"], "node": "fa7940daf574845de8a7b903da8321341d07f6ca", "parents": ["5142619082c95d2b17d09eb2f1194303067dffe5"], "tags": []}, {"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078960 - Switch Server 2022 builder jobs to Server 2025 r=taskgraph-reviewers,ahal\n\nFollow D183540 for the current Gecko kinds. Add the Server 2025 alias\nfamily, preserve Windows toolchain and localization handling, and retain\nthe Server 2022 aliases for rollback and independent consumers.\n\nFull graph generation changes 487 task worker types and nothing else. The\nWindows Updatebot cron job was removed by Bug 2089112, so it is not\nmigrated here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331442\n", "files": ["taskcluster/config.yml", "taskcluster/gecko_taskgraph/test/test_transforms_job.py", "taskcluster/gecko_taskgraph/transforms/l10n.py", "taskcluster/kinds/build/windows.yml", "taskcluster/kinds/condprof/kind.yml", "taskcluster/kinds/generate-profile/kind.yml", "taskcluster/kinds/repackage-msi/kind.yml", "taskcluster/kinds/spidermonkey/kind.yml", "taskcluster/kinds/spidermonkey/windows.yml", "taskcluster/kinds/toolchain/7zz.yml", "taskcluster/kinds/toolchain/clang.yml", "taskcluster/kinds/toolchain/custom-car.yml", "taskcluster/kinds/toolchain/gn.yml", "taskcluster/kinds/toolchain/onnx.yml", "taskcluster/kinds/toolchain/rust.yml", "taskcluster/kinds/toolchain/upx.yml"], "git_node": "0133535