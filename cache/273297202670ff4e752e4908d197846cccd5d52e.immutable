/pdf.renderer.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml", "toolkit/locales/en-US/toolkit/pdfviewer/viewer.ftl"], "git_node": "c60e471ea1f3c55890fca9668b70fd195b161588", "git_parents": ["d4a9923322691e221ec1afac57715016071aa506"], "node": "a2a2a35836f17bf1c884d8cd8271a2bbefdd37a6", "parents": ["58481e58c3d54af0024d152e7efe18e92f2fc31e"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2090741 - Wrap \u003cstdexcept\u003e and \u003cstring_view\u003e in the STL wrappers to fix libc++ 23 builds r=sergesanspaille\n\nWith libc++ 23, \u003cstdexcept\u003e and \u003cstring_view\u003e include \u003c__fwd/string.h\u003e.\nWhen one of them is reached before any wrapped header (fmt/format.h for\n\u003cstdexcept\u003e, SkSLPosition.h for \u003cstring_view\u003e), std::basic_string is first\ndeclared under the #pragma GCC visibility push(hidden) from\nconfig/gcc_hidden.h. Its members are then referenced as hidden symbols and\nlibxul.so fails to link:\n\n  ld.lld: error: undefined hidden symbol: std::__1::basic_string\u003cchar, ...\u003e::append(char const*, unsigned long)\n\nSame problem as bug 2071243 and bug 2089808.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340741\n", "files": ["config/stl-headers.mozbuild"], "git_node": "dfa5f95de11a9e374b5aa706d0d57a3bdef44d92", "git_parents": ["c60e471ea1f3c55890fca9668b70fd195b161588"], "node": "2554cea8658deb9ca017e0c7a160403aa3c2f314", "parents": ["a2a2a35836f17bf1c884d8cd8271a2bbefdd37a6"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2086164 - Implement Crandall reduction for BigInt modulo r=mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337663\n", "files": ["js/src/jit-test/tests/bigint/bigint-mod-crandall.js", "js/src/vm/BigIntType.cpp", "js/src/vm/BigIntType.h"], "git_node": "98d015ab1575f538e771f7e401f6a27401d66417", "git_parents": ["dfa5f95de11a9e374b5aa706d0d57a3bdef44d92"], "node": "c6c156f543fa1eeabf054b0fbe15e8aabec6d170", "parents": ["2554cea8658deb9ca017e0c7a160403aa3c2f314"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090443 - Enable tests that synthesize touchpad pan gestures on Linux. r=hiro\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340565\n", "files": ["gfx/layers/apz/test/mochitest/helper_axis_lock_parent_layer_coords.html", "gfx/layers/apz/test/mochitest/helper_bug1922904.html", "gfx/layers/apz/test/mochitest/helper_bug1934118.html", "gfx/layers/apz/test/mochitest/helper_overscroll_behavior_chain_no_effect.html", "gfx/layers/apz/test/mochitest/helper_pan_end_snap_to_current_position_scrollend.html", "gfx/layers/apz/test/mochitest/mochitest.toml"], "git_node": "bbe64ddd1b11d3c85f771e5c0d6c3143556cffa2", "git_parents": ["98d015ab1575f538e771f7e401f6a27401d66417"], "node": "0dc07f7f432d3aa31a5f146814dc892e4386b045", "parents": ["c6c156f543fa1eeabf054b0fbe15e8aabec6d170"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1928146 - Compute arrowscrollbox's scrolledtostart/scrolledtoend attributes once layout is flushed, r=reusable-components-reviewers,tabbrowser-reviewers,kcochrane,tgiles.\n\nThe rAF callback that computes them reads getBoundsWithoutFlushing before the tick's layout flush, so the bounds can include a frame that hasn't been reflowed yet, such as a collapsed tab group's overflow counter. Its zero-width rect at the scrolled content's origin looks like it is inside the scrollport, leaving scrolledtoend stuck. The fix only covers chrome windows, the only ones with promiseDocumentFlushed.\n\nnsIDOMWindowUtils.needsFlush is no substitute for promiseDocumentFlushed: running throttled animations keep it true.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338037\n", "files": ["toolkit/content/widgets/arrowscrollbox.js"], "git_node": "6e3369e6893b1702348c43bbb23979270179f91c", "git_parents": ["bbe64ddd1b11d3c85f771e5c0d6c3143556cffa2"], "node": "71d22940725e70fdb0562fd59dc5e0f13c9c406a", "parents": ["0dc07f7f432d3aa31a5f146814dc892e4386b045"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1928146 - Keep a tab group marked as animating until the tab strip has handled the overflow from its last frame, r=tabbrowser-reviewers,kcochrane.\n\nExpanding a group could scroll the tab strip to the selected tab, which #animatingGroups is meant to prevent. The completion of one animation cleared the flag set for a later one of the same group, and when the animation's final frame made the strip overflow, arrowscrollbox dispatched overflow one frame after the flag was cleared.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338257\n", "files": ["browser/components/tabbrowser/content/tabs.mjs"], "git_node": "c79dc7cc49ee7d08d03a38fe59797cd4bfbf71b7", "git_parents": ["6e3369e6893b1702348c43bbb23979270179f91c"], "node": "a467fe3ba849391a606f0ffd62b173ca2593db2d", "parents": ["71d22940725e70fdb0562fd59dc5e0f13c9c406a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2087100 - Ignore the real pointer in test_panel_list_submenu_click.html, r=reusable-components-reviewers,tgiles.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338027\n", "files": ["toolkit/content/tests/widgets/test_panel_list_submenu_click.html"], "git_node": "15fbcf6b71d0712ad306d16397758dfc046139c3", "git_parents": ["c79dc7cc49ee7d08d03a38fe59797cd4bfbf71b7"], "node": "50bedddda8f93e9ff8541834fc2641878dbcfb8d", "parents": ["a467fe3ba849391a606f0ffd62b173ca2593db2d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2087100 - Prevent the default of the contextmenu event in test_panel_list_contextmenu.html, r=reusable-components-reviewers,tgiles.\n\nWhen chrome tests run in browser.xhtml (chrome-1proc), the browser's content area context menu otherwise opens along with the panel and stays open, eating the clicks and keys of later panel-list tests in the same browser.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338028\n", "files": ["toolkit/content/tests/widgets/test_panel_list_contextmenu.html"], "git_node": "d3878f7cb87a039d7171c75e2226b68c37fae266", "git_parents": ["15fbcf6b71d0712ad306d16397758dfc046139c3"], "node": "1256e880b1141da8f7dc45f430b0af30119e24e1", "parents": ["50bedddda8f93e9ff8541834fc2641878dbcfb8d"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2073555 - Keep the description written under an @type tag r=firefox-source-docs-reviewers,ahal\n\nA property documented with @type is conventionally written in this tree\nwith the prose under the tag:\n\n    /**\n     * @type {boolean}\n     *   Whether or not the query has been cancelled.\n     */\n\njsdoc reads a doclet's description from the text above its first tag, so\nit discards that prose with a \"@type tag does not permit a description\"\nwarning -- 112 of them -- and the property renders with its type and\nnothing else.\n\nMove the prose above the tag, where jsdoc reads it. Whole lines are\npermuted, so the comment occupies the lines it always did and nothing is\nrenumbered. The type expression is brace-counted rather than assumed to\nbe on one line, and where a description already sits above the tag the\nmoved prose is appended to it, in the same paragraph.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327415\n", "files": ["docs/jsdoc-plugins/keep-type-descriptions.mjs", "docs/jsdoc.json"], "git_node": "2dc2afc32ff0b321f42141c3be8bd7482aeebfc4", "git_parents": ["d3878f7cb87a039d7171c75e2226b68c37fae266"], "node": "378c40274c663bb3af38a3df4f98abcaaaec3fed", "parents": ["1256e880b1141da8f7dc45f430b0af30119e24e1"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2082325 - Lint only the moz.build files a modified moz.yaml covers r=linter-reviewers,sergesanspaille\n\nA moz.yaml was a support file of license-declarations, so touching one, as\nany vendoring update does, relinted every moz.build in the tree. It is only\nread for the moz.build files at or below it, so lint those instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334021\n", "files": ["docs/code-quality/lint/linters/license.md", "tools/lint/license.yml", "tools/lint/license/__init__.py", "tools/lint/test/test_license_declarations.py"], "git_node": "10ad75147571b182bca4973bee20b94775c39234", "git_parents": ["2dc2afc32ff0b321f42141c3be8bd7482aeebfc4"], "node": "8b1cb434c8530173dabcddb87dfd24ccdaac4331", "parents": ["378c40274c663bb3af38a3df4f98abcaaaec3fed"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2088596 - [riscv64] Fix the simulator build on macOS. r=csmantle,spidermonkey-reviewers,jandem\n\nThe generated simulator dispatch passes General results, which are\nintptr_t, to setCallResult, which has int64_t and __int128 overloads. On\nmacOS intptr_t is long and int64_t is long long, so the call is\nambiguous and the riscv64 simulator does not compile. Add a\nsetCallResult(intptr_t) overload on Darwin, as bug 1967367 did for the\nloong64 and mips64 simulators.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339229\n", "files": ["js/src/jit/riscv64/Simulator-riscv64.cpp", "js/src/jit/riscv64/Simulator-riscv64.h"], "git_node": "b620354d5bb0a18307e7d1c6f63339f1c2d01ed2", "git_parents": ["10ad75147571b182bca4973bee20b94775c39234"], "node": "e12d2f331b5cc88aec3dd62f26fd7dc8a0df0d8b", "parents": ["8b1cb434c8530173dabcddb87dfd24ccdaac4331"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085246 - Replace call to malloc_usable_size r=glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337856\n", "files": ["memory/build/BaseAlloc.h", "memory/build/PHC.cpp"], "git_node": "7449a510a035e508f4987369445f78386473bc8f", "git_parents": ["b620354d5bb0a18307e7d1c6f63339f1c2d01ed2"], "node": "b5aefa35979e7287ca3edd675cdae78b07f611e5", "parents": ["e12d2f331b5cc88aec3dd62f26fd7dc8a0df0d8b"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090750 - Update metadata for clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-by-permissions-policy.tentative.https.sub.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340852\n", "files": ["testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-by-permissions-policy.tentative.https.sub.html.ini"], "git_node": "46c8edc36357b8a1124d327d129c7d1a7564a511", "git_parents": ["7449a510a035e508f4987369445f78386473bc8f"], "node": "e2266d4c154b0f21bef8f08dfb1695bffb73f976", "parents": ["b5aefa35979e7287ca3edd675cdae78b07f611e5"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087100 - Prevent the default of the contextmenu event in test_panel_list_contextmenu.html, r=reusable-components-reviewers,tgiles.\" for causing failures on browser_aiwindow_grouped_chips.\n\nThis reverts commit d3878f7cb87a039d7171c75e2226b68c37fae266.\n\nRevert \"Bug 2087100 - Ignore the real pointer in test_panel_list_submenu_click.html, r=reusable-components-reviewers,tgiles.\"\n\nThis reverts commit 15fbcf6b71d0712ad306d16397758dfc046139c3.\n\nRevert \"Bug 1928146 - Keep a tab group marked as animating until the tab strip has handled the overflow from its last frame, r=tabbrowser-reviewers,kcochrane.\"\n\nThis reverts commit c79dc7cc49ee7d08d03a38fe59797cd4bfbf71b7.\n\nRevert \"Bug 1928146 - Compute arrowscrollbox's scrolledtostart/scrolledtoend attributes once layout is flushed, r=reusable-components-reviewers,tabbrowser-reviewers,kcochrane,tgiles.\"\n\nThis reverts commit 6e3369e6893b1702348c43bbb23979270179f91c.\n", "files": ["browser/components/tabbrowser/content/tabs.mjs", "toolkit/content/tests/widgets/test_panel_list_contextmenu.html", "toolkit/content/tests/widgets/test_panel_list_submenu_click.html", "toolkit/content/widgets/arrowscrollbox.js"], "git_node": "9813787bef7f03f3fb40edfd1afad943fcbd3032", "git_parents": ["46c8edc36357b8a1124d327d129c7d1a7564a511"], "node": "3e264932286c938782853c0bc296e396722dea54", "parents": ["e2266d4c154b0f21bef8f08dfb1695bffb73f976"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2090625 - Silence -Wpragma-clang-attribute in zucchini for clang 23 with libc++ r=yjuglaret\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340624\n", "files": ["third_party/zucchini/executable/moz.build", "third_party/zucchini/moz.build", "third_party/zucchini/tests/gtest/moz.build"], "git_node": "c4c72a0c8518884c6ab034691ea6ec9977420fe9", "git_parents": ["9813787bef7f03f3fb40edfd1afad943fcbd3032"], "node": "593b6e99748461eeb27b63527f0676c851f5e07e", "parents": ["3e264932286c938782853c0bc296e396722dea54"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2089890 - [loong64] Allocate stack slot for cycle-breaking at use. r=spidermonkey-reviewers,jandem\n\nThis mirrors the MoveEmitterARM64 pattern.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340225\n", "files": ["js/src/jit-test/tests/wasm/simd/move-cycle.js", "js/src/jit/loong64/MoveEmitter-loong64.cpp", "js/src/jit/loong64/MoveEmitter-loong64.h"], "git_node": "bd2df71d6ed231166b8341d18cea4c92ec22d121", "git_parents": ["c4c72a0c8518884c6ab034691ea6ec9977420fe9"], "node": "506aa51fe83752eb576d2dbc3d5ab9ceeb963ba1", "parents": ["593b6e99748461eeb27b63527f0676c851f5e07e"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081108 - Run upload-symbols on git-backed pushes and clone it with Git r=taskgraph-reviewers,jcristau\n\nDrops `run-on-repo-type: [hg]` and `clone-with: hg` from the upload-symbols\nkind, so its tasks are scheduled on git-backed pushes and clone from Git like\nthe rest of the tree.\n\nThe transform also stops setting GECKO_HEAD_REPOSITORY and GECKO_HEAD_REV\nitself. The job transform sets both for the checkout anyway, and on a Git\nclone of an hg push it points them at the git mirror, so the values written\nhere were overwritten and only confusing.\n\nVerified on hg try push 2066329 (88aa76e03c24): build-linux64/opt-upload-symbols\nand build-win64/opt-upload-symbols were green on run-task-git.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334031\n", "files": ["taskcluster/gecko_taskgraph/transforms/upload_symbols.py", "taskcluster/kinds/upload-symbols/kind.yml"], "git_node": "3f98cf318fb21ea66da9c7d53b2b56f81d34536e", "git_parents": ["bd2df71d6ed231166b8341d18cea4c92ec22d121"], "node": "a0ed7f922370f39bf47c273262992cf4f9a8534f", "parents": ["506aa51fe83752eb576d2dbc3d5ab9ceeb963ba1"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090296 - Update metadata for storage-access-api/requestStorageAccess-service-worker.sub.https.tentative.window.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340857\n", "files": ["testing/web-platform/meta/storage-access-api/requestStorageAccess-service-worker.sub.https.tentative.window.js.ini"], "git_node": "4246f4198cb68d488b1dea8d36eefa8b7278c827", "git_parents": ["3f98cf318fb21ea66da9c7d53b2b56f81d34536e"], "node": "b078f5f7411656e776804a0fddc58b9bf8da5b35", "parents": ["a0ed7f922370f39bf47c273262992cf4f9a8534f"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081125 - Clone the linux-install-test tasks with Git and move the openSUSE image to Leap 16.0, r=taskgraph-reviewers,jcristau\n\nDeletes `clone-with: hg` from the linux-install-test kind, so its tasks use\nthe Git checkout like the rest of the tree. The openSUSE image was the one\nblocker: Leap 15.6 ships Python 3.6 as python3, and the Git flavour of\nrun-task needs 3.8 or newer (it died with a SyntaxError at startup). Leap\n15.6 is also end of life, so the opensuse-leap-raw images, x64 and arm64,\nnow build from opensuse/leap:16.0, whose python3 is 3.13. The image keeps\nthe distro's own python3, nothing overrides it.\n\nThe Leap 16.0 container no longer ships findutils, which the tarball method\nof install-firefox.sh needs, so the openSUSE pre-install step installs it\nnext to curl, wget, tar and xz.\n\nVerified on hg try pushes cloning the git mirror: 2088876 (509ce45317c7)\nrebuilt the four openSUSE images and ran 16 install tests, all green on the\nGit checkout except the two openSUSE tarball tests that lacked find; 2088919\n(b4648b7335eb) reran the six openSUSE tasks, rpm, rpm-release-upgrade and tarball\non x64 and arm64, all green.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336495\n", "files": ["taskcluster/kinds/docker-image/kind.yml", "taskcluster/kinds/linux-install-test/kind.yml"], "git_node": "0a84b74d907f47c006b6866879cec6af15a81322", "git_parents": ["4246f4198cb68d488b1dea8d36eefa8b7278c827"], "node": "3289b0da741d076a8a1f8de77474dd4008da6b57", "parents": ["b078f5f7411656e776804a0fddc58b9bf8da5b35"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048352 - Create push decision tasks for the code review bot's firefox-crb repository, r=ahal,taskgraph-reviewers,releng-reviewers\n\nThe code review bot pushes the patch stacks it analyzes to\nhttps://github.com/mozilla-firefox/firefox-crb. Taskcluster GitHub renders\nthe .taskcluster.yml of the pushed commit, whose repoType switch only\nschedules a push decision task for repositories listed as \"dev\" or \"prod\",\nso a push to firefox-crb produced no decision task at all. List it as\n\"dev\" like staging-firefox, which also turns on --allow-parameter-override\nso the bot's try_task_config.json is honoured, and give the project the\ndecision parameters of try, where the bot runs today.\n\nVerified on firefox-crb with a probe carrying this line: the push of\ndevelopment/code-review/D4242 got a decision task (Ip0PY1VdQe--4h0cpVoJtA),\nthe codereview target set ran and the bot published its verdict on the\nphabricator-dev revision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335076\n", "files": [".taskcluster.yml", "taskcluster/gecko_taskgraph/decision.py"], "git_node": "2deea16cd4f1de019017f576f3426b893a36cc00", "git_parents": ["0a84b74d907f47c006b6866879cec6af15a81322"], "node": "9d679d731589ec5dced3899063ac878a03173d22", "parents": ["3289b0da741d076a8a1f8de77474dd4008da6b57"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090072 - Update the symbol scrapers to pick up Fedora 45 and 46 preview and drop EOL'd versions r=schopin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340373\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "fad4e264f208ac99fa4f1252412a86bc07133303", "git_parents": ["2deea16cd4f1de019017f576f3426b893a36cc00"], "node": "ad4232c8d537571ef22958f3b59ce4ba0e2d1fad", "parents": ["9d679d731589ec5dced3899063ac878a03173d22"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Run the source-test android-gradle-build task from a git checkout, r=taskgraph-reviewers,ahal,hneiva\n\nDeletes the `run-on-repo-type: [hg]` and `clone-with: hg` lines of the\nandroid-gradle-build test, so it schedules on git-backed pushes and clones\nthe Git repository whenever the push has one. The test performs an artifact\nbuild; since bug 2082597 `mach artifact install` handles a shallow Git\nclone, so no full-history override is needed any more.\n\nVerified on an hg try push (2078756): the task clones the git mirror\nwith a shallow checkout and the artifact build succeeds, 44 minutes end\nto end (task dTZGskDMSgmhUWXlzLCkvA).\n\nRebased over the split of the test in two tasks (bug 2086181) and the\nGradle cache (bug 2086834): the same two lines go, and the apps task\ninherits the change through the YAML anchor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332917\n", "files": ["taskcluster/kinds/source-test/python-android.yml"], "git_node": "d9bfcad0dbcf7421e53a5d2263d5f1d9468f5fad", "git_parents": ["fad4e264f208ac99fa4f1252412a86bc07133303"], "node": "cb44a90303297d1c184cbd69e6b8448d1f47a10f", "parents": ["ad4232c8d537571ef22958f3b59ce4ba0e2d1fad"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074022 - Run the android app build kinds on git-backed pushes, r=taskgraph-reviewers,jcristau,geckoview-reviewers,android-reviewers,android-build-system-reviewers,ahochheiden,tcampbell\n\nbuild-apk, build-bundle, build-extensions, build-fat-aar and\nbuild-samples-browser carry `run-on-repo-type: [hg]` and `clone-with: hg`,\nso no Fenix, Focus or GeckoView app build is scheduled on a git-backed push.\nWith the guards gone these tasks are scheduled there and clone from GitHub.\n\nThe gradle files that still assumed a Mercurial source are updated too.\nengine-gecko's try detection reads MOZ_SOURCE_REPO instead of\nGECKO_HEAD_REPOSITORY, as DependenciesPlugin.kt already does: on an hg try\npush whose task clones the git mirror, GECKO_HEAD_REPOSITORY names the mirror\nwhile MOZ_SOURCE_REPO still names the try repository. The POM scm blocks of\ngeckoview and android-components pick `scm:hg` or `scm:git` from the source\nrepository, the same way build/variables.py picks /rev/ or /commit/ for\nMOZ_SOURCE_URL, and their fallback now points at the GitHub repository.\n\nVerified on Sep 21: an 18-task sample was green on both an hg try push\n(lando 94775, push 2043059) and a staging-firefox git push (5aa6b5d75cae),\n86/86 tasks of the git graph completed, and the artifacts matched apart from\nthe repository name in the maven coordinates. Re-applied on current main; the\ngraph still generates on git (build-apk 26, build-bundle 10, build-extensions\n1, build-fat-aar 5, build-samples-browser 2).\n\nLanding waits on a capacity go from ahal, since this adds the app build tasks\nto every git-backed push.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333162\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/build.gradle", "mobile/android/android-components/publish.gradle", "mobile/android/geckoview/build.gradle", "taskcluster/kinds/build-apk/kind.yml", "taskcluster/kinds/build-bundle/kind.yml", "taskcluster/kinds/build-extensions/kind.yml", "taskcluster/kinds/build-fat-aar/kind.yml", "taskcluster/kinds/build-samples-browser/kind.yml"], "git_node": "5520731e30d550e6d06c84a8510eebde39b15c61", "git_parents": ["d9bfcad0dbcf7421e53a5d2263d5f1d9468f5fad"], "node": "ede84f95c5c7927158e51d8df104a5115c32f37c", "parents": ["cb44a90303297d1c184cbd69e6b8448d1f47a10f"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085432 - Check opener's activeness after opening document PiP window. r=farre,dom-core-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339881\n", "files": ["dom/documentpip/DocumentPictureInPicture.cpp", "dom/documentpip/crashtests/2085432.html", "dom/documentpip/crashtests/crashtests.list", "dom/documentpip/moz.build"], "git_node": "9d5d9a5800de38a9225e54af644d28918ed55b61", "git_parents": ["5520731e30d550e6d06c84a8510eebde39b15c61"], "node": "cec689ebddccf340ea99ece0cbb46be028113c7d", "parents": ["ede84f95c5c7927158e51d8df104a5115c32f37c"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2090818. Update web painting section in mots.yaml. r=layout-reviewers,shtrom,jwatt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340807\n", "files": ["mots.yaml"], "git_node": "30db860460f03b78cb9483998859f7e2ef79374f", "git_parents": ["9d5d9a5800de38a9225e54af644d28918ed55b61"], "node": "0ddc492861b5a1f82b0bf6af6041989b5d3c89d6", "parents": ["cec689ebddccf340ea99ece0cbb46be028113c7d"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2082779 - Check that only the reused input is used at start next to a reusing output. r=jandem\n\nWhen a definition reuses an input, the allocator may give the output the\nregister of any other at-start use and then copy the reused input over\nit before the instruction reads that use. Lowering-shared.h documents\nthis rule, but nothing enforced it, and breaking it miscompiles only\nwhen the reused input stays live, as in bug 2082277.\n\nCheck the rule in AllocationIntegrityState::record() for operands in the\noutput's register class. Operands of another class cannot share its\nregister, which lets x64 shifts and lane loads keep a general-purpose\noperand at start next to a SIMD output. Also allow at-start uses of\nan input that another output reuses, such as the other half of an int64\non 32-bit platforms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334543\n", "files": ["js/src/jit/RegisterAllocator.cpp"], "git_node": "c50971df4a829d2eac1c640b3f23fc715e4fd4a1", "git_parents": ["30db860460f03b78cb9483998859f7e2ef79374f"], "node": "591dbba9ca5afeb9e0e1229c863c0ca74aaf9033", "parents": ["0ddc492861b5a1f82b0bf6af6041989b5d3c89d6"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044364 - Wrap secondName in PopupNotifications like name. r=desktop-theme-reviewers,reusable-components-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337112\n", "files": ["browser/base/content/test/browser-popupNotifications/browser.toml", "browser/base/content/test/browser-popupNotifications/browser_popupNotification_long_origin.js", "toolkit/content/widgets/popupnotification.js", "toolkit/themes/shared/popupnotification.css"], "git_node": "49f87393586e888084f6ed0b1b6477001c00444d", "git_parents": ["c50971df4a829d2eac1c640b3f23fc715e4fd4a1"], "node": "7efc27a3b94daaa4abc20cb0cfa5d7a899f489db", "parents": ["591dbba9ca5afeb9e0e1229c863c0ca74aaf9033"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2053035 - Update builders to rustc 1.99. r=firefox-build-system-reviewers,sylvestre\" for causing performance regression seen in Bug 2090871.\n\nThis reverts commit c3394d4e35d3c415ea424ee44145228408c640b2.\n", "files": ["build/build-rust/Zprofile.patch", "build/build-rust/rust-vendor-std.patch", "docs/writing-rust-code/update-policy.md", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/rust.yml", "taskcluster/scripts/misc/repack_rust.py"], "git_node": "d1cc9a90d7642c4c85c38fb0f5a650af60e75720", "git_parents": ["49f87393586e888084f6ed0b1b6477001c00444d"], "node": "a5477bf93a643a43e30ab64fd23872582f971f39", "parents": ["7efc27a3b94daaa4abc20cb0cfa5d7a899f489db"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2090443 - Enable tests that synthesize touchpad pan gestures on Linux. r=hiro\" for causing failures at test_group_scroll_snap.html.\n\nThis reverts commit bbe64ddd1b11d3c85f771e5c0d6c3143556cffa2.\n", "files": ["gfx/layers/apz/test/mochitest/helper_axis_lock_parent_layer_coords.html", "gfx/layers/apz/test/mochitest/helper_bug1922904.html", "gfx/layers/apz/test/mochitest/helper_bug1934118.html", "gfx/layers/apz/test/mochitest/helper_overscroll_behavior_chain_no_effect.html", "gfx/layers/apz/test/mochitest/helper_pan_end_snap_to_current_position_scrollend.html", "gfx/layers/apz/test/mochitest/mochitest.toml"], "git_node": "2d672ac2b8af86ff0c0ffb255bf6d293a9df8140", "git_parents": ["d1cc9a90d7642c4c85c38fb0f5a650af60e75720"], "node": "ccbab261d7519f72da4a0441885ee69117129ca9", "parents": ["a5477bf93a643a43e30ab64fd23872582f971f39"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090760 - Update metadata for intersection-observer/svg-overflow-clip-margin-iframe.sub.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340862\n", "files": ["testing/web-platform/meta/intersection-observer/svg-overflow-clip-margin-iframe.sub.html.ini"], "git_node": "c9953e52c9c097d3b33bb5b69a8c2097b453e7db", "git_parents": ["2d672ac2b8af86ff0c0ffb255bf6d293a9df8140"], "node": "2567adc308dcba43ff438f6743a244d95e24cd4c", "parents": ["ccbab261d7519f72da4a0441885ee69117129ca9"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090864 - Fully resolve font variations when initializing font metrics via skrifa. r=layout-reviewers,jwatt\n\nThis fixes the reftest failure on font-optical-sizing-1.html when fontations is enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340861\n", "files": ["gfx/thebes/gfxFont.cpp"], "git_node": "c2b30dc497788824a8b95815f7b63dfb1ee138a4", "git_parents": ["c9953e52c9c097d3b33bb5b69a8c2097b453e7db"], "node": "fd7230a158b40c70bdf2f4248c09c41e859c9a67", "parents": ["2567adc308dcba43ff438f6743a244d95e24cd4c"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090126 - Notify when updating the image document's alt text. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340868\n", "files": ["dom/html/ImageDocument.cpp"], "git_node": "5998adb4632eb045adf67cac25d8db2af1d8627e", "git_parents": ["c2b30dc497788824a8b95815f7b63dfb1ee138a4"], "node": "9eafb11f4c71bc2c91139bbb0cb658eb25e02ae2", "parents": ["fd7230a158b40c70bdf2f4248c09c41e859c9a67"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090862 - Mark custom element names with a null creator instead of NS_NewCustomElement. r=hsivonen\n\nWindows links with identical code folding, which gives NS_NewCustomElement\nand NS_NewHTMLElement the same address. The parser then treated every\nelement that NS_NewHTMLElement creates as a custom element.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340870\n", "files": ["dom/html/HTMLElement.cpp", "dom/html/nsGenericHTMLElement.h", "parser/html/javasrc/ElementName.java", "parser/html/nsHtml5ElementName.h", "parser/html/nsHtml5TreeOperation.cpp"], "git_node": "2f63d36a5b597d144e7e15b99e882da17ce59996", "git_parents": ["5998adb4632eb045adf67cac25d8db2af1d8627e"], "node": "e3d47685dac0693d6960a0bb28ff69dc3c3c6798", "parents": ["9eafb11f4c71bc2c91139bbb0cb658eb25e02ae2"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2088092 - [riscv64] Part 1: Delegate MacroAssembler::addPtr(ImmWord, Register) to ma_add64. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338985\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64-inl.h"], "git_node": "40da7cd05303764dd909721cd4bd4a653071238c", "git_parents": ["2f63d36a5b597d144e7e15b99e882da17ce59996"], "node": "cba624126e8678c4a98ebc20f6e2a61ef66b91a1", "parents": ["e3d47685dac0693d6960a0bb28ff69dc3c3c6798"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2088092 - [riscv64] Part 2: Delegate MacroAssembler::mulBy3 to ma_mul64. r=spidermonkey-reviewers,jandem\n\nma_mul64 already contains strength reduction cases for RHS=3, with\neither Zba and G sequences.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338986\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64-inl.h"], "git_node": "f85673bf436a4894ffcfc7fd8e7047dcf3e7a943", "git_parents": ["40da7cd05303764dd909721cd4bd4a653071238c"], "node": "ef8df8f06993230232fe48101313cc4535dcb62b", "parents": ["cba624126e8678c4a98ebc20f6e2a61ef66b91a1"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2088095 - [riscv64] Part 1: Reduce strength for common compile-time RHS of ma_mul{32,64}. r=spidermonkey-reviewers,jandem\n\nThis unifies both MASM methods with the following optimizations, with\nlatency in cycles and calculated per [0]. Measurement is done on a\nMilk-V Jupiter (SpacemiT K1, X60 uarch, in-order, 2-wide, 1.6GHz).\n\nma_mul32:\n\n        RHS                     Latency\n                                Zba     No Zba\n        -1                      1       (same)\n        0                       1       (same)\n        1                       1       (same)\n        2                       1       (same)\n        {3,5,9}*2^n, n=0        3       2\n        {3,5,9}*2^n, n\u003e0        3       (same)\n        2^n                     1       (same)\n        2^n - 1, n\u003e=3           2       (same)\n        2^n + 1, n\u003e=4           2       (same)\n        2^n + 2^m, n\u003em          3       (same)\n        (otherwise)             \u003e=4     (same)\n\nma_mul64, only rows that differ are listed out:\n\n        RHS                     Latency\n                                Zba     No Zba\n        ...                     ...     ...\n        {3,5,9}*2^n, n=0        3       (same)\n        ...                     ...     ...\n        (otherwise)             \u003e=6     (same)\n\nAll these expressions are guarded for the positive case. For negative\nRHS that is not -1, we use the fallback path.\n\nThe cases implemented are designed to have roughly the same coverage as\nthe Loong64 counterpart.\n\n[0]: https://gist.github.com/CSharperMantle/c988a2a6f02a0ea7e62e3bc95704f376#file-measurement-mul-spacemit-m1-8c8t-txt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338987\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.cpp"], "git_node": "cfb144f23840220beaca000c697cc5164c2acb1d", "git_parents": ["f85673bf436a4894ffcfc7fd8e7047dcf3e7a943"], "node": "b2f7f132baba9921664496e4195bdce0cf85eb80", "parents": ["ef8df8f06993230232fe48101313cc4535dcb62b"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2088095 - [riscv64] Part 2: Simplify CodeGenerator::visitMulI to take advantage of ma_mul{32,64}. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338988\n", "files": ["js/src/jit-test/tests/wasm/mul-riscv64-ion-codegen.js", "js/src/jit/riscv64/CodeGenerator-riscv64.cpp"], "git_node": "0a9184d468659c07dc6722720cce815ba5b5cbbf", "git_parents": ["cfb144f23840220beaca000c697cc5164c2acb1d"], "node": "ae366a6e2cb915bfceae4fbcb7841a5de6a7de8a", "parents": ["b2f7f132baba9921664496e4195bdce0cf85eb80"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2090688 - [loong64] Part 1: Compare Register with Imm32 without tripping through ma_cmp first. r=spidermonkey-reviewers,jandem\n\nSince ma_b(Register, Register, ...) can handle all conditions that\nma_cmp has, we can simply load the immediate and call it. This is\nequivalent when the immediate is small, and 1-instruction better when\nit's large.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340724\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "5b117abf749055379e24124a47e06b5e8f18a106", "git_parents": ["0a9184d468659c07dc6722720cce815ba5b5cbbf"], "node": "d13547cc4db81d89f54006ad24f5a5501dbf6acd", "parents": ["ae366a6e2cb915bfceae4fbcb7841a5de6a7de8a"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2090688 - [loong64] Part 2: Test the tag of a Value in memory through its upper word. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340725\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "8eefda8ae8465b77ef96d30e42b224011609f1ef", "git_parents": ["5b117abf749055379e24124a47e06b5e8f18a106"], "node": "8d52672d6d5f3dc742ccf0d40cd5d9b296601a3c", "parents": ["d13547cc4db81d89f54006ad24f5a5501dbf6acd"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086676 - Rename the \"SQLite JSM (\u003clabel\u003e)\" log modules to \"Sqlite\". r=mak\n\nMOZ_LOG could not configure these modules: it reads the spaces as\nseparators and does not accept parentheses.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337995\n", "files": ["toolkit/modules/Sqlite.sys.mjs"], "git_node": "8a7ae6c84b16f5617debe67fdd4472489087974f", "git_parents": ["8eefda8ae8465b77ef96d30e42b224011609f1ef"], "node": "1bd5d3a3bd37fa634b77b5b97b54dceb6c1c55f5", "parents": ["8d52672d6d5f3dc742ccf0d40cd5d9b296601a3c"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086676 - Rename the \"Places - \u003cname\u003e\" log modules to \"Places\". r=places-reviewers,mak\n\nMOZ_LOG could not configure the \"Places - \u003cname\u003e\" modules: it reads the\nspaces as separators. The loggers now log to the \"Places\" module, with\ntheir name as prefix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338259\n", "files": ["toolkit/components/places/PlacesUtils.sys.mjs"], "git_node": "4285b32d7266c6a46b994d70e0619c6dc9d0a927", "git_parents": ["8a7ae6c84b16f5617debe67fdd4472489087974f"], "node": "fafc381b2a17d65568f10975a12523cf4f090b21", "parents": ["1bd5d3a3bd37fa634b77b5b97b54dceb6c1c55f5"], "tags": []}, {"author": "Lars Eggert \u003cleggert@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090092 - Raise the ssltunnel listen backlog from 1 to 128 r=necko-reviewers,sunil\n\nssltunnel listened with a backlog of 1, and a single thread accepts the connections. When a test opens many HTTPS connections at once, connects that overflow the queue are reset on macOS. Necko retries them, but a request can run out of attempts (network.http.request.max-attempts) and fail with NS_ERROR_NET_RESET. If that request is a CORS preflight, the fetch CORS tests fail intermittently. On Linux the same overflow does not reset the connection; it delays the connect by about 1s while the SYN is retransmitted.\n\n128 is SOMAXCONN on macOS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340457\n", "files": ["testing/mochitest/ssltunnel/ssltunnel.cpp"], "git_node": "080ad4f20817d9b654af93f2ee17ecfc04035a73", "git_parents": ["4285b32d7266c6a46b994d70e0619c6dc9d0a927"], "node": "b297b8b19528a52c2cac405ba7c790e7bfb090e9", "parents": ["fafc381b2a17d65568f10975a12523cf4f090b21"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2087100 - Prevent the default of the contextmenu event in test_panel_list_contextmenu.html, r=reusable-components-reviewers,tgiles.\n\nWhen chrome tests run in browser.xhtml (chrome-1proc), the browser's content area context menu otherwise opens along with the panel and stays open, eating the clicks and keys of later panel-list tests in the same browser.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338028\n", "files": ["toolkit/content/tests/widgets/test_panel_list_contextmenu.html"], "git_node": "775507a40c92208b15d6c185fa30fe2850ae3193", "git_parents": ["080ad4f20817d9b654af93f2ee17ecfc04035a73"], "node": "61785c39879fa5469ee8591e47de9d0f7cda9429", "parents": ["b297b8b19528a52c2cac405ba7c790e7bfb090e9"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2087100 - Ignore the real pointer in test_panel_list_submenu_click.html, r=reusable-components-reviewers,tgiles.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338027\n", "files": ["toolkit/content/tests/widgets/test_panel_list_submenu_click.html"], "git_node": "83ee943d395ab24022bea89080dcb995d24760cc", "git_parents": ["775507a40c92208b15d6c185fa30fe2850ae3193"], "node": "564feb3bf21a1be87e930bc779d5658728bfafe5", "parents": ["61785c39879fa5469ee8591e47de9d0f7cda9429"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2090823. Reset the per-compound relative selector state between compounds when building :has() invalidation dependencies. r=firefox-style-system-reviewers,emilio\n\nRelativeSelectorDependencyCollector::visit_whole_selector only reset\ncompound_state at the start of each compound, but not\ncompound_state_attributes (which is created once per relative selector).\nCompounds are visited right to left, so once any compound sets added_entry,\nevery compound to its left skips add_non_unique_info, and a compound with\nnothing of its own to key on (such as a class, id or attribute) gets no\ntype_to_selector or any_to_selector entry. Inserting or removing an element\nthat was only matched by such a compound selector (e.g. the div in\n`:has(div + .a)`) would then fail to trigger invalidation.\n(SelectorDependencyCollector already resets both at each compound.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340851\n", "files": ["servo/components/style/invalidation/element/invalidation_map.rs", "testing/web-platform/tests/css/selectors/invalidation/has-non-identifying-compound-insertion.html"], "git_node": "82a62b7f0ccf3234734d834f11547e996635f571", "git_parents": ["83ee943d395ab24022bea89080dcb995d24760cc"], "node": "dfa93444d497bb67c7d903ffeef633a20239918a", "parents": ["564feb3bf21a1be87e930bc779d5658728bfafe5"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2090462 - [loong64] Fold the LSBs of an absolute address into the access. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340580\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "fe02042ab84bcf215322ff85c2eeffa6384b8a7f", "git_parents": ["82a62b7f0ccf3234734d834f11547e996635f571"], "node": "899c09049c31ef67001beb8e16a884d71b274f87", "parents": ["dfa93444d497bb67c7d903ffeef633a20239918a"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2039813 - Update builders to clang 23. r=firefox-build-system-reviewers,sylvestre\" for causing performance regression seen in Bug 2090871.\n\nThis reverts commit 5a539f1eeedc65e380b04be3a798567840c7759a.\n", "files": ["build/moz.configure/compile-checks.configure", "taskcluster/kinds/toolchain/clang-tidy.yml", "taskcluster/kinds/toolchain/clang.yml", "taskcluster/kinds/toolchain/llvm-symbolizer.yml", "taskcluster/kinds/toolchain/sysroot.yml", "tools/clang-tidy/config.yaml"], "git_node": "e83796ab25d36fb77a9f3b1b7e21ae15e5ae5a66", "git_parents": ["fe02042ab84bcf215322ff85c2eeffa6384b8a7f"], "node": "758cab05b9ba9fcb3a8a5cf08080a4678f6c0fd4", "parents": ["899c09049c31ef67001beb8e16a884d71b274f87"], "tags": []}, {"author": "Marcin Kozi\u0144ski \u003cmkozinski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082835 - Add Tech Principles r=android-reviewers,ai4dev-reviewers,gmalekpour,pollymce,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338701\n", "files": [".agents/skills/android/SKILL.md", ".claude/skills/android/SKILL.md", "mobile/android/fenix/docs/Tech-Principles.md", "mobile/android/fenix/docs/index.md"], "git_node": "812ea63b6fc87dd7e9a2c598f72b689027e60415", "git_parents": ["e83796ab25d36fb77a9f3b1b7e21ae15e5ae5a66"], "node": "bb68bb98bf044418b30965079366ee13860a49a9", "parents": ["758cab05b9ba9fcb3a8a5cf08080a4678f6c0fd4"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083685 - Wait for data to be deleted in tests that weren't waiting for it. r=necko-reviewers,dom-worker-reviewers,emz,jesup,edenchuang\n\nThese tests deleted data without waiting for the deletion to complete before\ngoing on. test_third_party_iframes.html also called an undefined resolve\nfunction from the deletion callback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335276\n", "files": ["dom/serviceworkers/test/test_third_party_iframes.html", "netwerk/test/unit/test_cache_jar.js", "toolkit/components/antitracking/bouncetrackingprotection/test/browser/browser_bouncetracking_web_console.js", "toolkit/components/cleardata/tests/browser/browser_auth_tokens.js", "toolkit/components/cleardata/tests/browser/browser_preflight_cache.js"], "git_node": "da66684f7ff489cdc3cd23bf56f7ce7d531717f7", "git_parents": ["812ea63b6fc87dd7e9a2c598f72b689027e60415"], "node": "0dffb6e70485d9976a021d48947cbbbcf1a85fed", "parents": ["bb68bb98bf044418b30965079366ee13860a49a9"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089071 - Don't leave ContentList dirty when PopulateSelf already has enough elements. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340031\n", "files": ["dom/base/ContentList.cpp", "dom/base/ContentList.h", "dom/base/crashtests/2089071.html", "dom/base/crashtests/crashtests.list"], "git_node": "98d3a5e819593ddf28b93401f3f27e53b5bde8d3", "git_parents": ["da66684f7ff489cdc3cd23bf56f7ce7d531717f7"], "node": "f8e731514f9f2d2c8277610e0a99fbf560b72404", "parents": ["0dffb6e70485d9976a021d48947cbbbcf1a85fed"], "tags": []}, {"author": "Patrick Kettner \u003cpatrickkettner@gmail.com\u003e", "branch": "default", "desc": "Bug 2088167 - Declare what async extension API functions resolve with in the schemas. r=robwu\n\nFunctions declared \"async\": true that resolve a value the schema can describe now\ndeclare it as a named callback parameter, so the schemas document it and DEBUG\nbuilds check it. DNSRecord.isTRR becomes a boolean to match nsIDNSRecord.IsTRR().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338912\n", "files": ["browser/components/extensions/schemas/find.json", "browser/components/extensions/schemas/pkcs11.json", "browser/components/extensions/schemas/sessions.json", "browser/components/extensions/schemas/sidebar_action.json", "browser/components/extensions/schemas/tabs.json", "mobile/shared/components/extensions/schemas/tabs.json", "toolkit/components/extensions/schemas/browser_action.json", "toolkit/components/extensions/schemas/captive_portal.json", "toolkit/components/extensions/schemas/contextual_identities.json", "toolkit/components/extensions/schemas/dns.json", "toolkit/components/extensions/schemas/geckoProfiler.json", "toolkit/components/extensions/schemas/network_status.json", "toolkit/components/extensions/schemas/page_action.json", "toolkit/components/extensions/schemas/permissions.json", "toolkit/components/extensions/schemas/telemetry.json", "toolkit/components/extensions/schemas/trial_ml.json", "toolkit/components/extensions/schemas/types.json"], "git_node": "79520199f467c12cd595b2e48fc15e2f6d4f69b9", "git_parents": ["98d3a5e819593ddf28b93401f3f27e53b5bde8d3"], "node": "414dd7367fe396d76c7c5c706667f121115a4354", "parents": ["f8e731514f9f2d2c8277610e0a99fbf560b72404"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090640 - Move the chrome tree owner's progress listener into AppWindow. r=farre\n\nAppWindow already listens to its root docshell, so there's no need for the\nchrome tree owner to do it too. This removes one of the differences between\nthe chrome and content tree owners.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340627\n", "files": ["xpfe/appshell/AppWindow.cpp", "xpfe/appshell/nsChromeTreeOwner.cpp", "xpfe/appshell/nsChromeTreeOwner.h"], "git_node": "de40ca84364e6af8f98de0273039684370d07a18", "git_parents": ["79520199f467c12cd595b2e48fc15e2f6d4f69b9"], "node": "a6ac05f52b9f42bc41a9ba04410c3f93e749727b", "parents": ["414dd7367fe396d76c7c5c706667f121115a4354"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090640 - Only forward chrome document titles to the tree owner. r=farre\n\nThe content tree owner ignored titles, and nsDocShellTreeOwner has no window\nto set them on, so make that explicit in nsDocShell instead. This removes\nanother difference between the chrome and content tree owners.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340628\n", "files": ["docshell/base/nsDocShell.cpp", "xpfe/appshell/nsContentTreeOwner.cpp"], "git_node": "df97c893fd209761f4502b498c9ed6e61d5da15c", "git_parents": ["de40ca84364e6af8f98de0273039684370d07a18"], "node": "b55f4a466623392e14713c957d300ac748a0e31d", "parents": ["a6ac05f52b9f42bc41a9ba04410c3f93e749727b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1928146 - Compute arrowscrollbox's scrolledtostart/scrolledtoend attributes once layout is flushed, r=reusable-components-reviewers,tabbrowser-reviewers,kcochrane,tgiles.\n\nThe rAF callback that computes them reads getBoundsWithoutFlushing before the tick's layout flush, so the bounds can include a frame that hasn't been reflowed yet, such as a collapsed tab group's overflow counter. Its zero-width rect at the scrolled content's origin looks like it is inside the scrollport, leaving scrolledtoend stuck. The fix only covers chrome windows, the only ones with promiseDocumentFlushed.\n\nnsIDOMWindowUtils.needsFlush is no substitute for promiseDocumentFlushed: running throttled animations keep it true.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338037\n", "files": ["toolkit/content/widgets/arrowscrollbox.js"], "git_node": "153b2e8a3712855967d9b4a03654158e43f6c4d5", "git_parents": ["df97c893fd209761f4502b498c9ed6e61d5da15c"], "node": "10239a3100e367392511360e67051193a14420da", "parents": ["b55f4a466623392e14713c957d300ac748a0e31d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1928146 - Keep a tab group marked as animating until the tab strip has handled the overflow from its last frame, r=tabbrowser-reviewers,kcochrane.\n\nExpanding a group could scroll the tab strip to the selected tab, which #animatingGroups is meant to prevent. The completion of one animation cleared the flag set for a later one of the same group, and when the animation's final frame made the strip overflow, arrowscrollbox dispatched overflow one frame after the flag was cleared.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338257\n", "files": ["browser/components/tabbrowser/content/tabs.mjs"], "git_node": "25343b984fad2190bc4a50d2a903e5a92d3d1f97", "git_parents": ["153b2e8a3712855967d9b4a03654158e43f6c4d5"], "node": "5a439406c8f76467d60d275df87a083728a2991d", "parents": ["10239a3100e367392511360e67051193a14420da"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090902. r=webidl,farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340885\n", "files": ["dom/xml/nsXMLContentSink.cpp"], "git_node": "448d1363f87743a77e06f21b80d72317952d8cc7", "git_parents": ["25343b984fad2190bc4a50d2a903e5a92d3d1f97"], "node": "5b9ea80efabdd856015751d0eeb66a72c11aa63f", "parents": ["5a439406c8f76467d60d275df87a083728a2991d"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2088842 - Use moz-src for services/automation r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339469\n", "files": ["browser/base/content/test/browser-static/browser_all_files_referenced.js", "services/automation/moz.build", "testing/condprofile/condprof/scenarii/sync.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "7bf808abad57a5b415d2e2a35e4d994174f080b0", "git_parents": ["448d1363f87743a77e06f21b80d72317952d8cc7"], "node": "985d6c72555ffe3974be90913589d85bc5f33cbe", "parents": ["5b9ea80efabdd856015751d0eeb66a72c11aa63f"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090749 - Make resource://builtin-addons not content-accessible. r=extension-reviewers,robwu\n\nThey don't need to, built-in extensions load their files through\nmoz-extension: URLs, and resource://newtab has its own package.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339317\n", "files": ["browser/extensions/jar.mn"], "git_node": "a3ad741807c81ee14144d9879d2c05738ba3c0f5", "git_parents": ["7bf808abad57a5b415d2e2a35e4d994174f080b0"], "node": "a844f7a059f9ac807a10dfbfe609d6c2b6b369f6", "parents": ["985d6c72555ffe3974be90913589d85bc5f33cbe"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2088842 - Use moz-src for services/automation r=Gijs\" for causing Linting failure.\n\nThis reverts commit 7bf808abad57a5b415d2e2a35e4d994174f080b0.\n", "files": ["browser/base/content/test/browser-static/browser_all_files_referenced.js", "services/automation/moz.build", "testing/condprofile/condprof/scenarii/sync.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "592cac443ee3fb44c5717d42f6ea7e688a6e33af", "git_parents": ["a3ad741807c81ee14144d9879d2c05738ba3c0f5"], "node": "05c3163b2912151bfcfcecd105cc897523f94ebf", "parents": ["a844f7a059f9ac807a10dfbfe609d6c2b6b369f6"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2088842 - Use moz-src for services/automation r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339469\n", "files": ["browser/base/content/test/browser-static/browser_all_files_referenced.js", "services/automation/moz.build", "testing/condprofile/condprof/scenarii/sync.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "b12b73089bca72c167af872e5f42f954f77df188", "git_parents": ["592cac443ee3fb44c5717d42f6ea7e688a6e33af"], "node": "3158acea1be7bf2132efea8254e4988a74868264", "parents": ["05c3163b2912151bfcfcecd105cc897523f94ebf"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090030 - Update WPT expectations for Navigation API Interop 2026. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340341\n", "files": ["testing/web-platform/meta/navigation-api/currententrychange-event/history-back-same-doc.html.ini", "testing/web-platform/meta/navigation-api/currententrychange-event/navigation-back-forward-cross-doc.html.ini", "testing/web-platform/meta/navigation-api/currententrychange-event/navigation-navigate-replace-cross-doc.html.ini", "testing/web-platform/meta/navigation-api/currententrychange-event/navigation-reload-intercept.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/cross-origin-traversal-redirect.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/intercept-cross-document-same-origin.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/intercept-cross-origin.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/intercept-detach-multiple.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/intercept-handler-null-or-undefined.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/intercept-handler-returns-non-promise.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-form-get.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-form-reload.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-form-requestSubmit.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-form.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-navigation-back-same-document-in-iframe.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigatesuccess-cross-document.html.ini", "testing/web-platform/meta/navigation-api/navigation-activation/activation-traverse-then-clobber.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/disambigaute-back.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/navigate-base-url.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/navigate-from-initial-about-blank-src.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/navigate-from-initial-about-blank.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/navigate-intercept-history-state.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/navigate-relative-url-utf8.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/navigate-relative-url.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/navigate-replace-same-document.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/reload-info.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/reload-state-and-info.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/reload-state-undefined.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/return-value/back-204-205-download.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/return-value/back-forward-out-of-bounds.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/return-value/navigate-intercept.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/return-value/navigate-opaque-origin.html.ini", "testing/web-platform/meta/navigation-api/navigation-methods/return-value/traverseTo-detach-cross-document.html.ini", "testing/web-platform/meta/navigation-api/ordering-and-transition/intercept-async.html.ini", "testing/web-platform/meta/navigation-api/ordering-and-transition/transition-finished-mark-as-handled.html.ini", "testing/web-platform/meta/navigation-api/ordering-and-transition/transition-realms-and-identity.html.ini", "testing/web-platform/meta/navigation-api/precommit-handler/precommitHandler-traverse.html.ini", "testing/web-platform/meta/navigation-api/scroll-behavior/after-transition-reject.html.ini"], "git_node": "51732b19feab61b24339b457c2c0434fedaee298", "git_parents": ["b12b73089bca72c167af872e5f42f954f77df188"], "node": "59484e10ba6eb5c0efbd2389b94ed2aff4a88a3d", "parents": ["3158acea1be7bf2132efea8254e4988a74868264"], "tags": []}, {"author": "any1here \u003cany1here@duck.com\u003e", "branch": "default", "desc": "Bug 2013867 - Fix link preview setting UI being hidden entirely instead of only the AI feature UI r=yjamora,mkennedy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D285798\n", "files": ["browser/components/preferences/config/tabs-browsing.mjs", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_visibility.js"], "git_node": "665b73fb3e6439f3982683e034325183460de0db", "git_parents": ["51732b19feab61b24339b457c2c0434fedaee298"], "node": "083be9fedde9df3a162ec86424bbf3dc97906ecf", "parents": ["59484e10ba6eb5c0efbd2389b94ed2aff4a88a3d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090640 - Remove DimensionKind. r=farre,dom-core-reviewers\n\nSince we removed the inner{Width,Height} setters, nothing ever requests inner\ndimensions. This removes another difference between the chrome and content tree\nowners.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340629\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShellTreeOwner.cpp", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/PBrowser.ipdl", "toolkit/components/browser/nsIWebBrowserChrome.idl", "toolkit/components/browser/nsWebBrowser.cpp", "widget/DimensionRequest.cpp", "widget/DimensionRequest.h", "widget/PuppetWidget.cpp", "widget/WidgetMessageUtils.h", "widget/nsIBaseWindow.idl", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/nsAppShellService.cpp", "xpfe/appshell/nsChromeTreeOwner.cpp", "xpfe/appshell/nsContentTreeOwner.cpp"], "git_node": "ef4dca53851e879640d5604f5be1d631c358730f", "git_parents": ["665b73fb3e6439f3982683e034325183460de0db"], "node": "ef147ffb8a8ee6548f7e30c6639089e454457931", "parents": ["083be9fedde9df3a162ec86424bbf3dc97906ecf"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090640 - Remove nsIBaseWindow::GetDimensions. r=farre\n\nNow that it only returns outer dimensions, it's the same as\nGetPositionAndSize().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340630\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShellTreeOwner.cpp", "toolkit/components/browser/nsWebBrowser.cpp", "widget/DimensionRequest.cpp", "widget/nsIBaseWindow.idl", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/nsChromeTreeOwner.cpp", "xpfe/appshell/nsContentTreeOwner.cpp", "xpfe/appshell/nsContentTreeOwner.h"], "git_node": "ae287b9a574ab24039605312f9686bd68f53a771", "git_parents": ["ef4dca53851e879640d5604f5be1d631c358730f"], "node": "aa122baa80b2aba050f271f23053162d68284420", "parents": ["ef147ffb8a8ee6548f7e30c6639089e454457931"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090640 - Use a single tree owner per AppWindow. r=dom-core-reviewers,farre\n\nAfter the previous patches the chrome and content tree owners behave the same\nfor everything the chrome docshell uses, so remove nsChromeTreeOwner.\n\nThere's extra clean-ups to do on top, we could potentially merge\nnsWebBrowser and nsDocShellTreeOwner or what not, they're 1:1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340631\n", "files": ["xpfe/appshell/AppWindow.cpp", "xpfe/appshell/AppWindow.h", "xpfe/appshell/moz.build", "xpfe/appshell/nsChromeTreeOwner.cpp", "xpfe/appshell/nsChromeTreeOwner.h"], "git_node": "65ca7eaf88eb5c58aee1beb692beb2c89c85b6e9", "git_parents": ["ae287b9a574ab24039605312f9686bd68f53a771"], "node": "9260d602b1ea3f81369199ae4afec60139e4b7ad", "parents": ["aa122baa80b2aba050f271f23053162d68284420"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090640 - Remove nsIBaseWindow.title. r=farre,dom-core-reviewers\n\nMake it more clear where the title goes (to the docshell for session\nhistory, and to the appwindow for chrome purposes). This should address\nsome of the concerns in D340628.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340892\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h", "docshell/base/nsDocShellTreeOwner.cpp", "dom/base/Document.cpp", "toolkit/components/aboutwindowsmessages/AboutWindowsMessages.cpp", "toolkit/components/browser/nsWebBrowser.cpp", "widget/nsIBaseWindow.idl", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/nsContentTreeOwner.cpp", "xpfe/appshell/nsIAppWindow.idl"], "git_node": "54457bfbc28678eb6362575fba0c881dfd8d08c4", "git_parents": ["65ca7eaf88eb5c58aee1beb692beb2c89c85b6e9"], "node": "76e042d41d5137b3a34683dac471e1dd2c7f61e9", "parents": ["9260d602b1ea3f81369199ae4afec60139e4b7ad"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2090640: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["docshell/base/nsDocShell.cpp"], "git_node": "2befc03dfe30f501b01f868a480f3f8e02c69e4f", "git_parents": ["54457bfbc28678eb6362575fba0c881dfd8d08c4"], "node": "c14b1c208af8746ad4abff6db10f92c33a9bd577", "parents": ["76e042d41d5137b3a34683dac471e1dd2c7f61e9"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090840 - Update android nightly application-services version bump to c1c8558fa8963440623148a3a991b6f6f59db9bf r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340832\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "18d65c1a9933eb178b7e9a24e661862c8e8f4c26", "git_parents": ["2befc03dfe30f501b01f868a480f3f8e02c69e4f"], "node": "0f67ab659f8cb534e8aa56cc81b27d10d5056de4", "parents": ["c14b1c208af8746ad4abff6db10f92c33a9bd577"], "tags": []}, {"author": "Justin Link \u003cjlink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073111 - Build TimeDuration from an integer without a floating-point round trip. r=mfbt-reviewers,sergesanspaille\n\nTimeDuration stores an integer count of platform ticks, but the only way to\nbuild one from a count of units was FromMilliseconds() and its siblings, which\ntake a double. Passing an integer costs a round trip through floating point,\nchecks against the ends of int64_t and for the infinities, and a call to\nMFBT_API TicksFromMilliseconds() that cannot be inlined, so a constant duration\ncannot be folded either.\n\nThis adds integral overloads of FromSeconds, FromMilliseconds and\nFromMicroseconds, plus a new FromNanoseconds. An identity conversion beats the\nfloating-integral conversion the double overloads need, so an integral argument\npicks these with no call site edited, while a floating-point one behaves as\nbefore.\n\nFrom the platform's tick rate, this patch works out exactly how many ticks make\nup each unit: an exact rational in lowest terms, plus that value as a plain\ninteger where it divides evenly. The rates in current use divide seconds,\nmilliseconds and microseconds, so those need one multiply and an overflow\ncheck; nanoseconds need the rational, as no rate below 1 GHz divides them, and\nso does any unit that a less common rate fails to divide. Microsoft documents\nthat the QueryPerformanceCounter frequency must not be assumed, and its own\nexample value does not divide microseconds, so the rational covers such rates\nexactly rather than approximately.\n\nWhere the tick rate is only known at run time (Windows, macOS) the conversion\nstays out of line in TimeStamp.cpp, behind one entry point per unit so a call\nsite passes nothing but the count. TickScale, the reduction that builds it and\nthe scaling that consumes it are all private to that file, and the backends\nhand over only a rate, so neither the tick rate nor the shape of the data\ndescribing it is part of mozglue's ABI. Where the tick is always a nanosecond\nthe header holds constexpr versions of those entry points instead, each at most\none multiply, so a duration built from a constant folds to a single immediate.\n\nThe reduction is constexpr, so the rates it is tested against - 10 MHz, 1 GHz,\nthe Apple silicon mach timebase, 19.2 MHz, Microsoft's example, and the ACPI PM\ntimer - are checked at compile time rather than by a runtime test.\n\nAn integer call site is smaller than the floating-point one it replaced, and\nthe conversion it calls does less work. Inlining the multiply at every call\nsite is faster still per call, but costs code at each of several hundred, so\nwhere the tick rate is dynamic it stays out of line.\n\nThese factories are kept out of hot paths, so no metric was expected to move,\nthough a try push does show indications of possible modest improvements to some\nbenchmarks on Linux. The other win is exactness - a value that was already an\ninteger no longer passes through double at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334723\n", "files": ["mfbt/MathAlgorithms.h", "mozglue/misc/TimeStamp.cpp", "mozglue/misc/TimeStamp.h", "mozglue/misc/TimeStamp_darwin.cpp", "mozglue/misc/TimeStamp_posix.cpp", "mozglue/misc/TimeStamp_windows.cpp", "xpcom/tests/gtest/TestTimeStamp.cpp"], "git_node": "9f78c802dc240e282107adf4a7519c3130ea8910", "git_parents": ["18d65c1a9933eb178b7e9a24e661862c8e8f4c26"], "node": "d798e485d07add524ef58631b5c5df8fa2541eef", "parents": ["0f67ab659f8cb534e8aa56cc81b27d10d5056de4"], "tags": []}, {"author": "Justin Link \u003cjlink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073111 - Stop laundering integers through double to build a TimeDuration. r=glandium,spidermonkey-reviewers,gfx-reviewers,geckoview-reviewers,win-reviewers,layout-reviewers,device-api-reviewers,media-webspeech-reviewers,mgaudet,dshin,gstoll,bradwerth,pehrsons,m_kato,webmidi-reviewers,gsvelto\n\nNow that the From* factories have integer overloads, a caller holding an\ninteger count of units can pass it directly. Four kinds of site change here:\n\n- Explicit casts to double, written only to satisfy the old signature.\n- Floating-point literals whose value is a whole number of the unit, which\n  chose the double overload purely because of how the literal was spelled.\n  Where that value is zero, TimeDuration::Zero() is used instead, which is\n  constexpr and needs no conversion at all.\n- Literals fractional in their unit but whole in a finer one, respelled in\n  that finer unit.\n- Constants declared double or float despite holding a whole number of units\n  and only ever used as From* arguments. Retyping the constant moves its call\n  sites with it.\n\nOne of those constants was also handed back out as a float by\nMainThreadIdlePeriod::GetLongIdlePeriod(), which kept its callers on the double\npath, so that now returns int32_t. A caller that divides the result is\nrespelled /2.0 to keep the division in floating point.\n\nEvery conversion was checked to produce the same tick count as before on each\ntick rate we support, so only two sites change behaviour: an atomic.wait\ntimeout from the WebAssembly specification and a WebRender display list build\ntime, both of which arrive in nanoseconds and were converted by dividing by\n1000 in floating point, discarding sub-microsecond precision. FromNanoseconds\nconverts both exactly.\n\nDeliberately left alone: durations that are genuinely fractional, with no exact\ninteger unit; the TestTimeStamp cases that exist to exercise the double\noverloads; and test files, which can follow separately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334731\n", "files": ["dom/animation/Animation.cpp", "dom/base/CCGCScheduler.cpp", "dom/base/nsJSEnvironment.cpp", "dom/base/test/gtest/TestScheduler.cpp", "dom/events/EventStateManager.cpp", "dom/media/GraphDriver.cpp", "dom/media/eme/clearkey/ClearKeySessionManager.cpp", "dom/media/encoder/TrackEncoder.cpp", "dom/media/platforms/agnostic/eme/DecryptThroughputLimit.h", "dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/midi/midirMIDIPlatformService.cpp", "gfx/layers/composite/ImageComposite.cpp", "gfx/layers/composite/ImageComposite.h", "gfx/layers/wr/WebRenderLayerManager.cpp", "gfx/thebes/gfxWindowsPlatform.cpp", "gfx/vr/VRManager.cpp", "image/FrameAnimator.cpp", "js/src/builtin/AtomicsObject.cpp", "js/src/gc/GC.cpp", "js/src/gc/LightLock.cpp", "js/src/shell/js.cpp", "js/src/wasm/WasmInstance.cpp", "layout/base/nsRefreshDriver.cpp", "mozglue/misc/TimeStamp.cpp", "security/certverifier/NSSCertDBTrustDomain.cpp", "security/manager/ssl/nsNSSComponent.cpp", "toolkit/components/backgroundhangmonitor/HangDetails.cpp", "tools/performance/PageloadEvent.cpp", "widget/SystemTimeConverter.h", "widget/TouchResampler.cpp", "widget/android/nsWindow.cpp", "widget/windows/WinCompositorWindowThread.cpp", "widget/windows/WinWindowOcclusionTracker.cpp", "xpcom/threads/MainThreadIdlePeriod.cpp", "xpcom/threads/MainThreadIdlePeriod.h", "xpcom/threads/TimerThread.cpp"], "git_node": "b8adaf72c55f5b568fe392e0a23ec369b7c5ac65", "git_parents": ["9f78c802dc240e282107adf4a7519c3130ea8910"], "node": "fa04c3e26f00682ff812da6f8ccbf2b150c4553e", "parents": ["d798e485d07add524ef58631b5c5df8fa2541eef"], "tags": []}, {"author": "Justin Link \u003cjlink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073111 - Stop laundering a TimeDuration through a double and back. r=webidl,media-playback-reviewers,smaug,padenot\n\nThree sites took a TimeDuration apart into a double and rebuilt it, where the\nduration arithmetic expresses the same operation directly.\n\nTimeoutManager::RunTimeout took a quarter of a budget via ToMilliseconds().\noperator/(double) is deleted on BaseTimeDuration, so operator/(int64_t) is the\nintended spelling and it divides the tick count exactly. The divisor has to be\nwritten int64_t(4): a deleted overload still takes part in overload\nresolution, and int-to-int64_t and int-to-double are both Conversion rank, so\na bare 4 is ambiguous.\n\nMediaTimer\u003cTimeStamp\u003e::ArmTimer already held a TimeDuration and passed it\nthrough FromMicroseconds(ToMicroseconds()), a round trip through double that\nrounds twice and then truncates to a whole tick, so it could land a tick\nshort. Handing it over unchanged is exact. The AwakeTimeStamp instantiation\nstill needs a real conversion, as AwakeTimeDuration only exposes its length as\na double.\n\nCCGCScheduler::ComputeMinimumBudgetForRunner scaled a budget by a double\nmultiplier through ToMilliseconds() and floored it at a millisecond.\nMultDouble() and TimeDuration::Max() express that directly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334732\n", "files": ["dom/base/CCGCScheduler.cpp", "dom/base/TimeoutManager.cpp", "dom/media/MediaTimer.cpp"], "git_node": "13c5aa6435c4f8a1cb124812e9b022259d59b33b", "git_parents": ["b8adaf72c55f5b568fe392e0a23ec369b7c5ac65"], "node": "0c9eab908b36674b090b1d5aa3424696449eacf8", "parents": ["fa04c3e26f00682ff812da6f8ccbf2b150c4553e"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071966 - Part 1: Ensure the name when downloading a PDF is consistent r=android-reviewers,mobiletest-reviewers,aaronmt,pollymce\n\nThis change ensures the PDF naming preference is as follows:\n1st choice: Filename - \"filename.pdf\" as named by the server, when available\n2nd choice: Title - \"Title.pdf\" as named by the tab metadata, for a PDF viewer tab, it is the PDF title metadata\n3rd choice: Fallback - \"document.pdf\", when we don't have good information on what to do\n\nBefore this change, \"Title - filename.pdf\" was the preferred name when downloading a PDF.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338830\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/util/PdfDownloadFilename.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineSessionTest.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/util/PdfDownloadFilenameTest.kt", "mobile/android/android-components/components/support/utils/src/main/java/mozilla/components/support/utils/DownloadUtils.kt", "mobile/android/android-components/components/support/utils/src/test/java/mozilla/components/support/utils/DownloadUtilsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/CustomTabsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/PDFViewerTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/PDFViewerTest.kt"], "git_node": "27319fa22a9b2cee3a3ef48a8be8fd2de0247d35", "git_parents": ["13c5aa6435c4f8a1cb124812e9b022259d59b33b"], "node": "dfc2aaf3be02ee9ab258d563c71f1fb46f52ccbd", "parents": ["0c9eab908b36674b090b1d5aa3424696449eacf8"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071966 - Part 2: Keep the filename when sharing a PDF r=android-reviewers,pollymce\n\nThis patch adjusts the share flow to have a \"Content-Disposition\" with the filename provided and to use the new filename for sharing. To prevent naming collisions, a folder with a random ID is made in the media cache directory to contain the file. (Before this patch, the temporary file itself had the random ID.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339242\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineSessionTest.kt", "mobile/android/android-components/components/feature/downloads/src/main/java/mozilla/components/feature/downloads/temporary/TemporaryDownloadFeature.kt", "mobile/android/android-components/components/feature/downloads/src/test/java/mozilla/components/feature/downloads/temporary/ShareResourceFeatureTest.kt"], "git_node": "dc991bb5dcc36388012bacbfff3ea85fb16c7ac0", "git_parents": ["27319fa22a9b2cee3a3ef48a8be8fd2de0247d35"], "node": "4d4ed9fab7b577d287d8aa3727f1d7cbc1adb070", "parents": ["dfc2aaf3be02ee9ab258d563c71f1fb46f52ccbd"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090908 - Classify .air and .metallib files as required_before_compile. r=glandium\n\nThis ensures we do not attempt to run the Metal internal shader\ncompilation file generate actions during artifact builds.\n\nIt also ensures they are generated in the export tier, before the\ngenerated header which consumes them is needed by compilation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318176\n", "files": ["python/mozbuild/mozbuild/frontend/data.py"], "git_node": "e8fdc5018784382dd4167782c589fe7ea130bc6e", "git_parents": ["dc991bb5dcc36388012bacbfff3ea85fb16c7ac0"], "node": "423f5651ec0044707ff6bc558eaef602b19d749a", "parents": ["4d4ed9fab7b577d287d8aa3727f1d7cbc1adb070"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090908 - gn_processor.py: Support generating configs for moz.configure values mapped to GN args. r=glandium\n\nThe new \"moz_config_gn_args\" config key maps moz.configure values to\nboolean GN args. gn_processor.py now generates configs for each\ncombination of these args being enabled and disabled, so the generated\nmoz.build files contain conditions based on the moz.configure values.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336199\n", "files": ["build/gn_processor.py"], "git_node": "5ed640c23b845212d753e0f5cf741f8dfd0fa60b", "git_parents": ["e8fdc5018784382dd4167782c589fe7ea130bc6e"], "node": "e3497aad1ad8337361ebd49bc5b54450d9bbf878", "parents": ["423f5651ec0044707ff6bc558eaef602b19d749a"], "tags": []}, {"author": "Netflate \u003cnetflate@gmail.com\u003e", "branch": "default", "desc": "Bug 2087615 - [Wayland] Align wl_shm pool size to page size and stride to 256 bytes r=stransky,gtk-reviewers\n\nCompositors that support importing wl_shm pools to GPU memory via\nudmabuf (which avoids a copy) need the pool to be a whole number of\npages. For udmabuf to work and show a correct image on all drivers,\nthe stride is also aligned to 256 bytes and stored in\nBufferSurface::mStrides[0], so all code accessing SHM buffer memory\nuses it instead of width * bpp.\n\nSome drivers don't reject a udmabuf import with an unaligned stride\nbut silently show a broken image instead (Bug 2088923).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340639\n", "files": ["gfx/layers/NativeLayerWaylandSurfaceHandler.cpp", "widget/gtk/BufferSurface.h", "widget/gtk/SHMBufSurface.cpp", "widget/gtk/WaylandBuffer.h", "widget/gtk/WindowSurfaceWaylandMultiBuffer.cpp"], "git_node": "066db198eb2edb357d92cc1b8dc5cbfdfcefba18", "git_parents": ["5ed640c23b845212d753e0f5cf741f8dfd0fa60b"], "node": "450792dbae1785ed07d7f3dfb4d69a344fa19cbc", "parents": ["e3497aad1ad8337361ebd49bc5b54450d9bbf878"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077272 - Implement right-click menus for dates and websites in the History sidebar r=sidebar-reviewers,nsharpley,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339275\n", "files": ["browser/base/content/main-popupset.inc.xhtml", "browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/sidebar-page.mjs", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_history_sidebar_card_context_menu.js", "browser/locales/en-US/browser/sidebar.ftl"], "git_node": "36206007ec2c918aea81276ee4e67270be71a0bb", "git_parents": ["066db198eb2edb357d92cc1b8dc5cbfdfcefba18"], "node": "620f80da4a9bf833b817d15d2a9a4424c74ef1ca", "parents": ["450792dbae1785ed07d7f3dfb4d69a344fa19cbc"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090259 - Backport upstream Breakpad fix to include stdlib.h in string_utils.cc. r=gsvelto,crashreporting-reviewers\n\nNewer mingw-w64 headers no longer include stdlib.h from assert.h, which string_utils.cc relied on for mbstowcs\nand wcstombs. This is upstream Breakpad commit c6ec7108ee82ce21f0c0b1d733d4817583b91743.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340777\n", "files": ["toolkit/crashreporter/breakpad-patches/32-stdlib-include.patch", "toolkit/crashreporter/google-breakpad/src/common/windows/string_utils.cc"], "git_node": "c4001fd5dbd108882f089b9b0d5214fc51384d39", "git_parents": ["36206007ec2c918aea81276ee4e67270be71a0bb"], "node": "f1246e049f6b764de393c3fc66208b58772dfe55", "parents": ["620f80da4a9bf833b817d15d2a9a4424c74ef1ca"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090259 - Update mingw to upstream revision ae5227f620699c8d532609ae30dc66432b903dab. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340778\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "169ba25a96e519a29c797a9e89271e7404bce978", "git_parents": ["c4001fd5dbd108882f089b9b0d5214fc51384d39"], "node": "d6e398ce225bc3902fa1a24cc22488c97245b91e", "parents": ["f1246e049f6b764de393c3fc66208b58772dfe55"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090801 - Remove unused OnWifiChanged interface from Fenix. r=android-reviewers,mcarare\n\nIt has had no users since it was added.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340775\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/OnWifiChanged.java"], "git_node": "4a9cf9ae9564d9f3209a04b461670baa0b0c5f0e", "git_parents": ["169ba25a96e519a29c797a9e89271e7404bce978"], "node": "1e02042ab85568418ef190312220ac31ca93bcdb", "parents": ["d6e398ce225bc3902fa1a24cc22488c97245b91e"], "tags": []}], "date": 1794242398, "git_changesets": ["c60e471ea1f3c55890fca9668b70fd195b161588", "dfa5f95de11a9e374b5aa706d0d57a3bdef44d92", "98d015ab1575f538e771f7e401f6a27401d66417", "bbe64ddd1b11d3c85f771e5c0d6c3143556cffa2", "6e3369e6893b1702348c43bbb23979270179f91c", "c79dc7cc49ee7d08d03a38fe59797cd4bfbf71b7", "15fbcf6b71d0712ad306d16397758dfc046139c3", "d3878f7cb87a039d7171c75e2226b68c37fae266", "2dc2afc32ff0b321f42141c3be8bd7482aeebfc4", "10ad75147571b182bca4973bee20b94775c39234", "b620354d5bb0a18307e7d1c6f63339f1c2d01ed2", "7449a510a035e508f4987369445f78386473bc8f", "46c8edc36357b8a1124d327d129c7d1a7564a511", "9813787bef7f03f3fb40edfd1afad943fcbd3032", "c4c72a0c8518884c6ab034691ea6ec9977420fe9", "bd2df71d6ed231166b8341d18cea4c92ec22d121", "3f98cf318fb21ea66da9c7d53b2b56f81d34536e", "4246f4198cb68d488b1dea8d36eefa8b7278c827", "0a84b74d907f47c006b6866879cec6af15a81322", "2deea16cd4f1de019017f576f3426b893a36cc00", "fad4e264f208ac99fa4f1252412a86bc07133303", "d9bfcad0dbcf7421e53a5d2263d5f1d9468f5fad", "5520731e30d550e6d06c84a8510eebde39b15c61", "9d5d9a5800de38a9225e54af644d28918ed55b61", "30db860460f03b78cb9483998859f7e2ef79374f", "c50971df4a829d2eac1c640b3f23fc715e4fd4a1", "49f87393586e888084f6ed0b1b6477001c00444d", "d1cc9a90d7642c4c85c38fb0f5a650af60e75720", "2d672ac2b8af86ff0c0ffb255bf6d293a9df8140", "c9953e52c9c097d3b33bb5b69a8c2097b453e7db", "c2b30dc497788824a8b95815f7b63dfb1ee138a4", "5998adb4632eb045adf67cac25d8db2af1d8627e", "2f63d36a5b597d144e7e15b99e882da17ce59996", "40da7cd05303764dd909721cd4bd4a653071238c", "f85673bf436a4894ffcfc7fd8e7047dcf3e7a943", "cfb144f23840220beaca000c697cc5164c2acb1d", "0a9184d468659c07dc6722720cce815ba5b5cbbf", "5b117abf749055379e24124a47e06b5e8f18a106", "8eefda8ae8465b77ef96d30e42b224011609f1ef", "8a7ae6c84b16f5617debe67fdd4472489087974f", "4285b32d7266c6a46b994d70e0619c6dc9d0a927", "080ad4f20817d9b654af93f2ee17ecfc04035a73", "775507a40c92208b15d6c185fa30fe2850ae3193", "83ee943d395ab24022bea89080dcb995d24760cc", "82a62b7f0ccf3234734d834f11547e996635f571", "fe02042ab84bcf215322ff85c2eeffa6384b8a7f", "e83796ab25d36fb77a9f3b1b7e21ae15e5ae5a66", "812ea63b6fc87dd7e9a2c598f72b689027e60415", "da66684f7ff489cdc3cd23bf56f7ce7d531717f7", "98d3a5e819593ddf28b93401f3f27e53b5bde8d3", "79520199f467c12cd595b2e48fc15e2f6d4f69b9", "de40ca84364e6af8f98de0273039684370d07a18", "df97c893fd209761f4502b498c9ed6e61d5da15c", "153b2e8a3712855967d9b4a03654158e43f6c4d5", "25343b984fad2190bc4a50d2a903e5a92d3d1f97", "448d1363f87743a77e06f21b80d72317952d8cc7", "7bf808abad57a5b415d2e2a35e4d994174f080b0", "a3ad741807c81ee14144d9879d2c05738ba3c0f5", "592cac443ee3fb44c5717d42f6ea7e688a6e33af", "b12b73089bca72c167af872e5f42f954f77df188", "51732b19feab61b24339b457c2c0434fedaee298", "665b73fb3e6439f3982683e034325183460de0db", "ef4dca53851e879640d5604f5be1d631c358730f", "ae287b9a574ab24039605312f9686bd68f53a771", "65ca7eaf88eb5c58aee1beb692beb2c89c85b6e9", "54457bfbc28678eb6362575fba0c881dfd8d08c4", "2befc03dfe30f501b01f868a480f3f8e02c69e4f", "18d65c1a9933eb178b7e9a24e661862c8e8f4c26", "9f78c802dc240e282107adf4a7519c3130ea8910", "b8adaf72c55f5b568fe392e0a23ec369b7c5ac65", "13c5aa6435c4f8a1cb124812e9b022259d59b33b", "27319fa22a9b2cee3a3ef48a8be8fd2de0247d35", "dc991bb5dcc36388012bacbfff3ea85fb16c7ac0", "e8fdc5018784382dd4167782c589fe7ea130bc6e", "5ed640c23b845212d753e0f5cf741f8dfd0fa60b", "066db198eb2edb357d92cc1b8dc5cbfdfcefba18", "36206007ec2c918aea81276ee4e67270be71a0bb", "c4001fd5dbd108882f089b9b0d5214fc51384d39", "169ba25a96e519a29c797a9e89271e7404bce978", "4a9cf9ae9564d9f3209a04b461670baa0b0c5f0e"], "user": "csabou@mozilla.com"}, "45740": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 483832d21588426d471649f0176bd31f4062d926 with FIREFOX_161_0b1_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "54ba67ac87ef15dd0182a49653925245347ce568", "git_parents": ["228a125bc7a9995c1678e07c9271ed93e8aefa39"], "node": "0cb5d9e25f78dd8d82bfe4b72170f63d270e99ff", "parents": ["dbf1e6a2fc179048e18274c3e137526c5d83bc01"], "tags": []}], "date": 1794244305, "git_changesets": ["54ba67ac87ef15dd0182a49653925245347ce568"], "user": "ffxbld@lando.moz.tools"}, "45741": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 483832d21588426d471649f0176bd31f4062d926 with FIREFOX-ANDROID_161_0b1_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "43837475decf937354f3dacc66a32a21cfdeca72", "git_parents": ["54ba67ac87ef15dd0182a49653925245347ce568"], "node": "3e1fb4abe13e66a194c8978fadef13a04e9182a8", "parents": ["0cb5d9e25f78dd8d82bfe4b72170f63d270e99ff"], "tags": []}], "date": 1794244407, "git_changesets": ["43837475decf937354f3dacc66a32a21cfdeca72"], "user": "ffxbld@lando.moz.tools"}, "45742": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 483832d21588426d471649f0176bd31f4062d926 with DEVEDITION_161_0b1_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "943668ce6461bb194e7a5c62aff91354231ec957", "git_parents": ["43837475decf937354f3dacc66a32a21cfdeca72"], "node": "237cb2ff1cd7b0a1797e05d0a9ec2b7ad670919e", "parents": ["3e1fb4abe13e66a194c8978fadef13a04e9182a8"], "tags": []}], "date": 1794244470, "git_changesets": ["943668ce6461bb194e7a5c62aff91354231ec957"], "user": "ffxbld@lando.moz.tools"}, "45743": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 483832d21588426d471649f0176bd31f4062d926 with FIREFOX-ANDROID_161_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9223d69324d64d9cfaec15622c7054afd1b4b02e", "git_parents": ["943668ce6461bb194e7a5c62aff91354231ec957"], "node": "295f61ad7001e6fecb6d8c17134061200e373c6e", "parents": ["237cb2ff1cd7b0a1797e05d0a9ec2b7ad670919e"], "tags": []}], "date": 1794250377, "git_changesets": ["9223d69324d64d9cfaec15622c7054afd1b4b02e"], "user": "ffxbld@lando.moz.tools"}, "45744": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 483832d21588426d471649f0176bd31f4062d926 with FIREFOX_161_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "65e9d250971e0de562319754f96a161576cdf339", "git_parents": ["9223d69324d64d9cfaec15622c7054afd1b4b02e"], "node": "0ad65749232bafd98f028fac214d9b9dcb00b6dd", "parents": ["295f61ad7001e6fecb6d8c17134061200e373c6e"], "tags": []}], "date": 1794257624, "git_changesets": ["65e9d250971e0de562319754f96a161576cdf339"], "user": "ffxbld@lando.moz.tools"}, "45745": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 483832d21588426d471649f0176bd31f4062d926 with DEVEDITION_161_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "d969d8ff7dc7d2aef7ba8b339b6d1d5cb75efce7", "git_parents": ["65e9d250971e0de562319754f96a161576cdf339"], "node": "ce9549362989c7f2a51e3e1e74349d34290d4eae", "parents": ["0ad65749232bafd98f028fac214d9b9dcb00b6dd"], "tags": []}], "date": 1794257681, "git_changesets": ["d969d8ff7dc7d2aef7ba8b339b6d1d5cb75efce7"], "user": "ffxbld@lando.moz.tools"}, "45746": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090803 - Grant the permission through the test application's shadow in ContextTest. r=android-reviewers,mcarare\n\nA standalone ShadowApplication has no real application behind it. Robolectric 4.18's device-aware\ngrantPermissions dereferences that application, so the test fails there with a NullPointerException.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340776\n", "files": ["mobile/android/android-components/components/support/ktx/src/test/java/mozilla/components/support/ktx/android/content/ContextTest.kt"], "git_node": "a86416330dc5326824b8a529e5813d0880d4b082", "git_parents": ["4a9cf9ae9564d9f3209a04b461670baa0b0c5f0e"], "node": "5b268e81d767615af29ee4f45f10be5583ace614", "parents": ["1e02042ab85568418ef190312220ac31ca93bcdb"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086736 - Mark all reusable components as stable in Storybook r=reusable-components-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338322\n", "files": ["toolkit/content/widgets/moz-badge/moz-badge.stories.mjs", "toolkit/content/widgets/moz-box-button/moz-box-button.stories.mjs", "toolkit/content/widgets/moz-box-group/moz-box-group.stories.mjs", "toolkit/content/widgets/moz-box-item/moz-box-item.stories.mjs", "toolkit/content/widgets/moz-box-link/moz-box-link.stories.mjs", "toolkit/content/widgets/moz-breadcrumb-group/moz-breadcrumb-group.stories.mjs", "toolkit/content/widgets/moz-checkbox/moz-checkbox.stories.mjs", "toolkit/content/widgets/moz-fieldset/moz-fieldset.stories.mjs", "toolkit/content/widgets/moz-five-star/moz-five-star.stories.mjs", "toolkit/content/widgets/moz-input-color/moz-input-color.stories.mjs", "toolkit/content/widgets/moz-input-email/moz-input-email.stories.mjs", "toolkit/content/widgets/moz-input-folder/moz-input-folder.stories.mjs", "toolkit/content/widgets/moz-input-number/moz-input-number.stories.mjs", "toolkit/content/widgets/moz-input-password/moz-input-password.stories.mjs", "toolkit/content/widgets/moz-input-search/moz-input-search.stories.mjs", "toolkit/content/widgets/moz-input-tel/moz-input-tel.stories.mjs", "toolkit/content/widgets/moz-input-text/moz-input-text.stories.mjs", "toolkit/content/widgets/moz-input-url/moz-input-url.stories.mjs", "toolkit/content/widgets/moz-page-header/moz-page-header.stories.mjs", "toolkit/content/widgets/moz-page-nav/moz-page-nav.stories.mjs", "toolkit/content/widgets/moz-promo/moz-promo.stories.mjs", "toolkit/content/widgets/moz-radio-group/moz-radio-group.stories.mjs", "toolkit/content/widgets/moz-reorderable-list/moz-reorderable-list.stories.mjs", "toolkit/content/widgets/moz-segmented-control/moz-segmented-control.stories.mjs", "toolkit/content/widgets/moz-select/moz-select.stories.mjs", "toolkit/content/widgets/moz-textarea/moz-textarea.stories.mjs", "toolkit/content/widgets/moz-visual-picker/moz-visual-picker.stories.mjs", "toolkit/content/widgets/theme-picker/theme-picker.stories.mjs"], "git_node": "fc0e2eb9ff551c9b8cf6ebd79ffe569646a28182", "git_parents": ["a86416330dc5326824b8a529e5813d0880d4b082"], "node": "64f95a71b6ea6817e911b173be232438b8cd2183", "parents": ["5b268e81d767615af29ee4f45f10be5583ace614"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090832 - Require OES_EGL_image for EGLImage shared surfaces. r=gfx-reviewers,jnicol\n\nThe EGLImage consumers call glEGLImageTargetTexture2DOES, which is only\nloaded with OES_EGL_image. Stop accepting OES_EGL_image_external alone in\nthe producer check, and bail out in RenderEGLImageTextureHost instead of\ncalling a null function pointer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340864\n", "files": ["gfx/gl/SharedSurfaceEGL.cpp", "gfx/webrender_bindings/RenderEGLImageTextureHost.cpp"], "git_node": "c5a57fdbc5cf5df3ae5d04d82534d75b9503644f", "git_parents": ["fc0e2eb9ff551c9b8cf6ebd79ffe569646a28182"], "node": "b25eb09b91bfbfe0d35fa4ba2e641d3399ab1dc7", "parents": ["64f95a71b6ea6817e911b173be232438b8cd2183"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076422 - Always use the Firefox release logo for Firefox for Mobile on More from Mozilla r=devtools-reviewers,settings-reviewers,nchevobbe,Gijs\n\nUpdates the Firefox for Mobile card in More from Mozilla to use\nthe same logo, even on rebranded builds. Also, moves the existing logo\nfile to a directory that makes it available to use on Settings pages,\nwhich is where More from Mozilla is.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337246\n", "files": ["browser/base/content/logos/firefox.svg", "browser/base/content/test/browser-static/browser_all_files_referenced.js", "browser/base/jar.mn", "browser/components/preferences/config/moreFromMozilla.mjs", "devtools/client/aboutdebugging/src/actions/runtimes.js", "devtools/client/framework/test/node/components/__snapshots__/debug-target-info.test.js.snap", "devtools/client/framework/test/node/components/debug-target-info.test.js", "devtools/client/jar.mn", "devtools/client/themes/images/aboutdebugging-firefox-release.svg"], "git_node": "fc4de2c2f0a925a565efd2a37ec804cfc0612f4f", "git_parents": ["c5a57fdbc5cf5df3ae5d04d82534d75b9503644f"], "node": "5ec350c50c49f02d2dddaa22db68310d4dcb6753", "parents": ["b25eb09b91bfbfe0d35fa4ba2e641d3399ab1dc7"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2090066 - Add linter for ipdl interfaces to use nsIURI instead of URIParams r=ipc-reviewers,mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340383\n", "files": ["dom/ipc/PBrowser.ipdl", "taskcluster/kinds/source-test/mozlint.yml", "tools/lint/ipdl-uriparams.yml", "tools/lint/test/python.toml", "tools/lint/test/test_ipdl_uriparams.py"], "git_node": "0ebb5cfbfe147e5b12a76fecff7bc1bbd6bc6f3c", "git_parents": ["fc4de2c2f0a925a565efd2a37ec804cfc0612f4f"], "node": "03c65edb25044a5d8830593c1480ef4a2387a89b", "parents": ["5ec350c50c49f02d2dddaa22db68310d4dcb6753"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2090066 - Replace the remaining URIParams IPDL fields with nsIURI. r=ipc-reviewers,necko-reviewers,geckoview-reviewers,dom-worker-reviewers,mccr8,asuth,m_kato,kershaw\n\nnsIURI is serialized through the same SerializeURI/DeserializeURI path, so\ncallers no longer need to convert by hand. Since a content process can now\nsend a null URI for fields that were previously non-optional, shared workers\nreject a missing base script URL in the parent and remote workers fail early\non a null script URL.\n\nThe unused GIO channel IPDL structs are removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340384\n", "files": ["dom/serviceworkers/ServiceWorkerPrivate.cpp", "dom/workers/remoteworkers/RemoteWorkerChild.cpp", "dom/workers/remoteworkers/RemoteWorkerTypes.ipdlh", "dom/workers/sharedworkers/SharedWorker.cpp", "dom/workers/sharedworkers/SharedWorkerManager.cpp", "dom/workers/sharedworkers/SharedWorkerService.cpp", "ipc/glue/BackgroundUtils.cpp", "mobile/android/components/geckoview/GeckoViewContentChannelChild.cpp", "mobile/android/components/geckoview/GeckoViewContentChannelParent.cpp", "netwerk/ipc/NeckoChannelParams.ipdlh", "tools/lint/ipdl-uriparams.yml"], "git_node": "e11fb2079d21c1745e99458cdf0cfd39de0b21cc", "git_parents": ["0ebb5cfbfe147e5b12a76fecff7bc1bbd6bc6f3c"], "node": "a24a9f546c79c098d18175f080b8fa6d08b6c6ed", "parents": ["03c65edb25044a5d8830593c1480ef4a2387a89b"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088960 - Bump taskcluster-taskgraph to 24.7.0. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340345\n", "files": ["taskcluster/requirements.in", "taskcluster/requirements.txt"], "git_node": "57e163da10017e8951d4a161f51832930f9d7b6a", "git_parents": ["e11fb2079d21c1745e99458cdf0cfd39de0b21cc"], "node": "dbbd73e3e440fc1b9664fb699e27617eefa4134e", "parents": ["a24a9f546c79c098d18175f080b8fa6d08b6c6ed"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085481 - Serialize the cache-entry check with cancel r=necko-reviewers,valentin\n\nOnCacheEntryCheck can run on the cache I/O thread and write the cached state\n(alt-data type, cached response head, cache input stream) while a cancel's\nAsyncAbort reads it on the main thread.  Set mCanceled under mCacheWaitLock so\nan in-flight check finishes first, and decline any later check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340727\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h"], "git_node": "b357645590ee4167e5d20d05edb2f0136aefa10c", "git_parents": ["57e163da10017e8951d4a161f51832930f9d7b6a"], "node": "4ccf173e9d38f35f5dcefcc74078d179a3ce63ca", "parents": ["dbbd73e3e440fc1b9664fb699e27617eefa4134e"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087263 - Keep the storage access navigation heuristic from granting access across a container switch. r=bvandersloot\n\nA top level load to a site bound to another container is retargeted into a new\ntab in that container. DynamicFpiNavigationHeuristic runs for the response\nbefore the retarget, with the tab the load is leaving: it reads that tab's\nsession history and user activation, but grants under the result principal,\nwhich is in the container the load switched to. With permissions isolated by\ncontainer, interaction in one container could grant storage access in another.\n\nSkip the heuristic when the response runs in another storage partition than the\ntab, comparing all OriginAttributes but the first party domain, so private\nbrowsing and GeckoView session contexts are covered as well. The new tab has no\nhistory the heuristic could grant from.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338131\n", "files": ["toolkit/components/antitracking/heuristics/DynamicFpiNavigationHeuristic.cpp"], "git_node": "8980ab5808d7c4f139471814d2175b22e098c0bc", "git_parents": ["b357645590ee4167e5d20d05edb2f0136aefa10c"], "node": "e3886b3d9d5ea9c6faf02800e38f55f470f30ac7", "parents": ["4ccf173e9d38f35f5dcefcc74078d179a3ce63ca"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087263 - Test that the storage access navigation heuristic grants no access across a container switch. r=bvandersloot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338132\n", "files": ["toolkit/components/antitracking/test/browser/browser.toml", "toolkit/components/antitracking/test/browser/browser_storageAccessNavigationHeuristicContainerSwitch.js"], "git_node": "8c64edfb52b506c59b85322d7a0f2254d5c59bd5", "git_parents": ["8980ab5808d7c4f139471814d2175b22e098c0bc"], "node": "b7cd78524c59c08efb5813f9e78a864b2dfd24f8", "parents": ["e3886b3d9d5ea9c6faf02800e38f55f470f30ac7"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058145 - Make Bounce Tracking Protection follow loads retargeted into another container. r=bvandersloot,baku,necko-reviewers,jesup\n\nA load switched into the container its site is bound to commits in a new tab,\nsplitting one extended navigation across two tabs and containers. Move the\nin-flight record into the new tab, so its destination stays exempt, and record\neach bounce with the OriginAttributes it ran in, so it is classified, exempted\nby user activation and purged in that container. The initial and final site\nexemptions are per container too.\n\nThe new tab is created asynchronously. If the record is continued or classified\nin the tab the load started in meanwhile, because that tab navigates, closes or\nits client bounce timer fires, the tab drops the hops which ran in the container\nthe load switched into, so that the destination is not classified.\n\nNormalizeOriginAttributes strips the partition key in addition to the first\nparty domain, which changes GetStateGlobal and GetOrCreateStateGlobal for\npartitioned OriginAttributes. All callers pass top level OriginAttributes, which\nhave no partition key.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338133\n", "files": ["netwerk/ipc/DocumentLoadListener.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtection.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtectionStorage.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtectionStorage.h", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingRecord.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingRecord.h", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.h"], "git_node": "f419d0381d55303b0384a2911090268dae8d9eaa", "git_parents": ["8c64edfb52b506c59b85322d7a0f2254d5c59bd5"], "node": "02f10e642bf5feb7ce967d84367d77d521f8a028", "parents": ["b7cd78524c59c08efb5813f9e78a864b2dfd24f8"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058145 - Turn the per-site container association expectations of Bounce Tracking Protection into assertions. r=bvandersloot,baku\n\nEnd the extended navigation in the tab the load was retargeted into, which now\nholds the record, and wait for the load to stop in the parent process, where the\nfinal host is set. Also cover the initial site exemption across containers, a\nclient bounce after the switch, and a load switched into a second container.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338134\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/test/browser/browser_bouncetracking_siteContainer.js"], "git_node": "55ee2f3fba50db3b075d49332254c1d92b8bfeec", "git_parents": ["f419d0381d55303b0384a2911090268dae8d9eaa"], "node": "c8209fb181f771386120c27416a8c3cabef8c401", "parents": ["02f10e642bf5feb7ce967d84367d77d521f8a028"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058145 - Keep Bounce Tracking Protection data clearing complete for bounce chains spanning containers. r=bvandersloot,baku\n\nA chain retargeted into another container is recorded in one\nBounceTrackingRecord holding the sites of each container, and that record is\nkept with the bounce tracker candidates and purge log entries of every container\nthe chain classified a site in. Report Broken Site sends it.\n\nClearing a container now drops a tab's in-flight record whole if any of its\nsites ran in that container, and drops the chain records other containers keep\nif they touch it. Clearing a site drops every kept chain record naming the site\nin a cleared container. This also closes a gap which predates containers being\ntaken into account: clearing a site left it in the records of other purge log\nentries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338135\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtection.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtectionStorage.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingRecord.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingRecord.h", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingStateGlobal.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingStateGlobal.h"], "git_node": "5e3300b6dd013964497d7415b692baf8e01b8595", "git_parents": ["55ee2f3fba50db3b075d49332254c1d92b8bfeec"], "node": "257f6f2093fd089f04cbc76ba096dbf0dc2ec2a1", "parents": ["c8209fb181f771386120c27416a8c3cabef8c401"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058145 - Test that Bounce Tracking Protection data clearing drops the bounce chain records naming cleared sites. r=bvandersloot,baku\n\nCover clearing a container while a tab it retargeted a load into holds its\nbounces, clearing a container or a site whose chain records other containers\nkeep, and clearing a site named in the chain records of other purge log entries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338136\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/test/browser/browser.toml", "toolkit/components/antitracking/bouncetrackingprotection/test/browser/browser_bouncetracking_clearing.js", "toolkit/components/antitracking/bouncetrackingprotection/test/browser/browser_bouncetracking_siteContainer.js"], "git_node": "d6b232592ab10d24682a3f409fdcc9308a897ea7", "git_parents": ["5e3300b6dd013964497d7415b692baf8e01b8595"], "node": "10da02e65376e6553e0ab7e17b26dd38508144b3", "parents": ["257f6f2093fd089f04cbc76ba096dbf0dc2ec2a1"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058145 - Document how Bounce Tracking Protection handles extended navigations across containers. r=bvandersloot,baku\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338137\n", "files": ["toolkit/components/antitracking/docs/bounce-tracking-protection/index.md"], "git_node": "c2664e8e24725a503d9227a1b95c17872a946df4", "git_parents": ["d6b232592ab10d24682a3f409fdcc9308a897ea7"], "node": "edd410caa872aad8cc7a5eb15fa53bfeeaf9e04c", "parents": ["10da02e65376e6553e0ab7e17b26dd38508144b3"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086715 - Add a value type for the sites Bounce Tracking Protection keeps state for. r=bvandersloot\n\nBounceTrackingSite holds a schemeless site and the storage partition it ran in,\nwith first party domain and partition key stripped. It is built from a\nprincipal, from a URI and OriginAttributes, or from a persisted site host, and\nhas an explicit null state for documents BTP does not track.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338824\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingSite.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingSite.h", "toolkit/components/antitracking/bouncetrackingprotection/moz.build"], "git_node": "62631cbc68eaa86fd420f20998c7afbbe22353b4", "git_parents": ["c2664e8e24725a503d9227a1b95c17872a946df4"], "node": "cd9e36f5014b3bc4bfd102459f8e51b84830ecc7", "parents": ["edd410caa872aad8cc7a5eb15fa53bfeeaf9e04c"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086715 - Keep Bounce Tracking Protection's per-tab bounce chain record as BounceTrackingSite values. r=bvandersloot\n\nThe initial site, final site and bounce set of BounceTrackingRecord hold\nBounceTrackingSite values instead of a site host and OriginAttributes each,\nand the bounce set is a flat set rather than one set of hosts per partition.\nBounceTrackingState derives every site through BounceTrackingSite, and the\n\"null\" placeholder becomes the null site. The user activation set stays a set\nof hosts for DynamicFpiNavigationHeuristic, and nsIBounceTrackingRecord still\nexposes hosts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338825\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingRecord.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingRecord.h", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.h"], "git_node": "25552b40ab56884a44bc01d76a243f3fb8b26584", "git_parents": ["62631cbc68eaa86fd420f20998c7afbbe22353b4"], "node": "71dc04ca096f7a762d0e76b569feaef2d71a5524", "parents": ["cd9e36f5014b3bc4bfd102459f8e51b84830ecc7"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086715 - Pass BounceTrackingSite through Bounce Tracking Protection's global state and purge log. r=bvandersloot\n\nBounceTrackingStateGlobal takes and hands out BounceTrackingSite values and only\naccepts sites of its own partition. Its maps stay keyed by site host, since the\nstate global already is the partition; SiteFor turns a key back into a site.\nBTPMapEntry and ClearDataCallback hold a site instead of a host and\nOriginAttributes. Site hosts remain at the edges: the database, the\nnsIBounceTrackingProtection methods taking a host, the remote exception list\nand the content blocking allow-list.\n\nClearBySiteHostAndOriginAttributesPattern now rejects an empty host up front,\nlike ClearBySiteHostAndOriginAttributes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338826\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingMapEntry.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingMapEntry.h", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtection.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtection.h", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtectionStorage.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtectionStorage.h", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingStateGlobal.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingStateGlobal.h", "toolkit/components/antitracking/bouncetrackingprotection/ClearDataCallback.cpp", "toolkit/components/antitracking/bouncetrackingprotection/ClearDataCallback.h"], "git_node": "cb85c3c7a10f773f9191d4cf0c783cf6b0bc16e2", "git_parents": ["25552b40ab56884a44bc01d76a243f3fb8b26584"], "node": "64e3f07259f49b6ad60559003e312856ae91b471", "parents": ["71dc04ca096f7a762d0e76b569feaef2d71a5524"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086715 - Test BounceTrackingSite. r=bvandersloot\n\nCover deriving sites from principals and URIs, the null site, partition\nnormalization, equality and hashing, and formatting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338827\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/moz.build", "toolkit/components/antitracking/bouncetrackingprotection/test/gtest/TestBounceTrackingSite.cpp", "toolkit/components/antitracking/bouncetrackingprotection/test/gtest/moz.build"], "git_node": "a9995e9e5b26c30cd3bd05956056c0955343e462", "git_parents": ["cb85c3c7a10f773f9191d4cf0c783cf6b0bc16e2"], "node": "48ed019b17c480bcf86229d853c2dde00a5e76d5", "parents": ["64e3f07259f49b6ad60559003e312856ae91b471"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086715 - Move OriginAttributes normalization and the tracked principal check of Bounce Tracking Protection into BounceTrackingSite. r=bvandersloot\n\nNormalizeOriginAttributes defines the storage partition a BounceTrackingSite\nbelongs to and ShouldTrackPrincipal decides whether a principal has a site at\nall, so both live with the type now. Callers which only needed the check\nbefore deriving the site test for the null site instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338828\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtection.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtection.h", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtectionStorage.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtectionStorage.h", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingRecord.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingSite.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingSite.h", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.h"], "git_node": "143e0ce87be7b732626a55260cc579a2cb01b600", "git_parents": ["a9995e9e5b26c30cd3bd05956056c0955343e462"], "node": "354330219791ff80745c8722bc7bfa40fd962605", "parents": ["48ed019b17c480bcf86229d853c2dde00a5e76d5"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086715 - Update the Bounce Tracking Protection class diagram for BounceTrackingSite. r=bvandersloot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339346\n", "files": ["toolkit/components/antitracking/docs/bounce-tracking-protection/index.md"], "git_node": "53067244914c4a0c12a94e56d4609adb63b4c4b5", "git_parents": ["143e0ce87be7b732626a55260cc579a2cb01b600"], "node": "520bce434140739570d28d9749483e11f5bbdaf9", "parents": ["354330219791ff80745c8722bc7bfa40fd962605"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2090935 - Log the happy-eyeballs state machine id in the glue. r=kershaw,necko-reviewers\n\nThe happy-eyeballs crate logs only the target host, and ids restart at zero\nper state machine, so lines of concurrent state machines for the same host\ncan't be told apart. The glue now logs its own address, which the profiler\nalready uses as the flow id, before every call into the crate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340894\n", "files": ["Cargo.lock", "netwerk/protocol/http/happy_eyeballs_glue/Cargo.toml", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs"], "git_node": "bcc43c8f76a25f5713870facec307650558a727e", "git_parents": ["53067244914c4a0c12a94e56d4609adb63b4c4b5"], "node": "2c239ab48a733e1b474ef51c4d4731f240a71958", "parents": ["520bce434140739570d28d9749483e11f5bbdaf9"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075411 - Reject a seekable streaming upload body that can't be cloned r=necko-reviewers,valentin\n\nA streaming upload body skips NormalizeUploadStream(), as a pipe can't be\nbuffered up front.  A seekable one, such as a Blob's stream, can still be\nrewound by the channel for a redirect or an auth retry, so it must be\ncloneable for nsHttpTransaction to read a clone of it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340636\n", "files": ["netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": "cb5a6bdb4a7ed03fd868de3a30bce2e0c795ff41", "git_parents": ["bcc43c8f76a25f5713870facec307650558a727e"], "node": "6c82abb296bea44e4d9085e138963ca4d04b0c96", "parents": ["2c239ab48a733e1b474ef51c4d4731f240a71958"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965067 - Update the PerfDocs linter documentation. r=perftest-reviewers,afinder,fbilt\n\nPerfDocs now generates the documentation, lives in python/mozperftest since bug 1868773, and runs in CI as the perfdocs-verify task rather than as a mach lint linter. Also add the hardware-docs schema key and the required static-only key in the examples.\n\nAlso drop the dead tools/lint/perfdocs.yml entry from the perfdocs-verify files-changed list, since that file was removed in bug 1868773.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338480\n", "files": ["docs/code-quality/lint/linters/perfdocs.md", "taskcluster/kinds/source-test/mozlint.yml"], "git_node": "e12d745b3fdf0e05b6aaacae3a952c74969082d0", "git_parents": ["cb5a6bdb4a7ed03fd868de3a30bce2e0c795ff41"], "node": "7b0eee82b4bae80af829d05b1f250cf3fa98baf7", "parents": ["6c82abb296bea44e4d9085e138963ca4d04b0c96"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071700 - Update opentelemetry-cpp to v1.30.0 r=ArnaudBienner\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333553\n", "files": ["third_party/opentelemetry-cpp/CHANGELOG.md", "third_party/opentelemetry-cpp/README.md", "third_party/opentelemetry-cpp/api/include/opentelemetry/common/attribute_value.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/common/detail/ascii.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/common/key_value_iterable_view.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/common/kv_properties.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/common/spin_lock_mutex.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/common/string_util.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/context/context_value.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/context/runtime_context.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/nostd/string_view.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/semconv/telemetry_attributes.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/context.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/default_span.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/noop.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/provider.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/span_context.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/span_id.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/span_startoptions.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/trace_flags.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/trace_id.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/trace/trace_state.h", "third_party/opentelemetry-cpp/api/include/opentelemetry/version.h", "third_party/opentelemetry-cpp/exporters/memory/include/opentelemetry/exporters/memory/in_memory_span_data.h", "third_party/opentelemetry-cpp/exporters/memory/include/opentelemetry/exporters/memory/in_memory_span_exporter.h", "third_party/opentelemetry-cpp/exporters/memory/include/opentelemetry/exporters/memory/in_memory_span_exporter_factory.h", "third_party/opentelemetry-cpp/exporters/otlp/include/opentelemetry/exporters/otlp/otlp_populate_attribute_utils.h", "third_party/opentelemetry-cpp/exporters/otlp/include/opentelemetry/exporters/otlp/otlp_recordable_utils.h", "third_party/opentelemetry-cpp/exporters/otlp/src/otlp_populate_attribute_utils.cc", "third_party/opentelemetry-cpp/exporters/otlp/src/otlp_recordable.cc", "third_party/opentelemetry-cpp/exporters/otlp/src/otlp_recordable_utils.cc", "third_party/opentelemetry-cpp/moz.yaml", "third_party/opentelemetry-cpp/patches/remove-environment-span-limits.patch", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/common/attribute_utils.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/common/attributemap_hash.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/common/circular_buffer.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/common/circular_buffer_range.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/common/empty_attributes.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/instrumentationscope/instrumentation_scope.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/instrumentationscope/scope_configurator.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/multi_span_processor.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/sampler.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/simple_processor.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/span_data.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/span_limits.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/span_status.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/tracer.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/tracer_context.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/tracer_provider.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/version/version.h", "third_party/opentelemetry-cpp/sdk/src/common/base64.cc", "third_party/opentelemetry-cpp/sdk/src/common/empty_attributes.cc", "third_party/opentelemetry-cpp/sdk/src/common/env_variables.cc", "third_party/opentelemetry-cpp/sdk/src/common/global_log_handler.cc", "third_party/opentelemetry-cpp/sdk/src/common/random.cc", "third_party/opentelemetry-cpp/sdk/src/common/random.h", "third_party/opentelemetry-cpp/sdk/src/common/wildcard_match.h", "third_party/opentelemetry-cpp/sdk/src/instrumentationscope/instrumentation_scope.cc", "third_party/opentelemetry-cpp/sdk/src/resource/detail/percent_decode.cc", "third_party/opentelemetry-cpp/sdk/src/resource/detail/percent_decode.h", "third_party/opentelemetry-cpp/sdk/src/resource/resource_detector.cc", "third_party/opentelemetry-cpp/sdk/src/trace/random_id_generator.cc", "third_party/opentelemetry-cpp/sdk/src/trace/span.cc", "third_party/opentelemetry-cpp/sdk/src/trace/span.h", "third_party/opentelemetry-cpp/sdk/src/trace/tracer.cc", "third_party/opentelemetry-cpp/sdk/src/trace/tracer_context.cc", "third_party/opentelemetry-cpp/sdk/src/trace/tracer_provider.cc", "third_party/opentelemetry-cpp/sdk/src/trace/tracer_provider_factory.cc", "third_party/opentelemetry-cpp/sdk/src/version/version.cc"], "git_node": "74711587a728a4870cb464f5587fad3f0dae3843", "git_parents": ["e12d745b3fdf0e05b6aaacae3a952c74969082d0"], "node": "74378e7b58a2b8708390e0b052a801f5abc6b5d6", "parents": ["7b0eee82b4bae80af829d05b1f250cf3fa98baf7"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071700 - Apply mozilla patches for opentelemetry-cpp r=ArnaudBienner\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333554\n", "files": ["third_party/opentelemetry-cpp/api/include/opentelemetry/context/context_value.h", "third_party/opentelemetry-cpp/exporters/otlp/include/opentelemetry/exporters/otlp/otlp_recordable_utils.h", "third_party/opentelemetry-cpp/exporters/otlp/src/otlp_recordable_utils.cc", "third_party/opentelemetry-cpp/sdk/src/trace/span_limits.cc"], "git_node": "af624d5db039e949a34ad5283b0bdf1353f5ec9f", "git_parents": ["74711587a728a4870cb464f5587fad3f0dae3843"], "node": "bbbc668ab02bc00ffa91ea4ab98466bffc558548", "parents": ["74378e7b58a2b8708390e0b052a801f5abc6b5d6"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071700 - Adjust opentelemetry-cpp build configs to version 1.30 r=ArnaudBienner\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333774\n", "files": ["third_party/opentelemetry-cpp/sdk/src/instrumentationscope/moz.build", "third_party/opentelemetry-cpp/sdk/src/moz.build", "third_party/opentelemetry-cpp/sdk/src/resource/moz.build", "third_party/opentelemetry-cpp/sdk/src/trace/moz.build"], "git_node": "32b0bcb1ef1c21a9d40532a781269e755f88d739", "git_parents": ["af624d5db039e949a34ad5283b0bdf1353f5ec9f"], "node": "d278b5e852c74f2a24e0f93a3c64307d7479f111", "parents": ["bbbc668ab02bc00ffa91ea4ab98466bffc558548"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079465 - Keep an invalid trailer at the end of cache entry files while their data is being written. r=necko-reviewers,valentin\n\nData writes and truncations put an 8-byte trailer, whose offset word is past\nthe end of any file, after the end of the file; the metadata write truncates it\naway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340568\n", "files": ["netwerk/cache2/CacheFileIOManager.cpp", "netwerk/cache2/CacheFileIOManager.h"], "git_node": "bda6de0d67413f113028e861229556a420497ae3", "git_parents": ["32b0bcb1ef1c21a9d40532a781269e755f88d739"], "node": "26788771be4c90e1b01111bcc8d5547c832063eb", "parents": ["d278b5e852c74f2a24e0f93a3c64307d7479f111"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2090799 - Guard against unlinked shadow hosts when recomputing headingoffset r=dom-core-reviewers,farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340773\n", "files": ["dom/base/FragmentOrElement.cpp", "testing/web-platform/tests/html/semantics/sections/headingoffset-mutations.html"], "git_node": "2afe6de6a5f3fea3c0a08800999c95e5284e0934", "git_parents": ["bda6de0d67413f113028e861229556a420497ae3"], "node": "63bac9f765542259e7d62743b72cae1e568ed31b", "parents": ["26788771be4c90e1b01111bcc8d5547c832063eb"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089570 - Only use USB power meters for power tests on p6 and s24. r=perftest-reviewers,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339993\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/raptor.py"], "git_node": "5a484f7183fe0b436c5288faa4b07c544350a276", "git_parents": ["2afe6de6a5f3fea3c0a08800999c95e5284e0934"], "node": "f3b24fcbcb6718759196ddca2860737cf5c695e0", "parents": ["63bac9f765542259e7d62743b72cae1e568ed31b"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088858 - Use a bugbug-calibrated very low confidence threshold for expanded pushes. r=taskgraph-reviewers,bhearsum\n\nThe raw 0.3 threshold was not mapped to a level, so it ignored the thresholds\nreturned by bugbug for its current models.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339477\n", "files": ["taskcluster/gecko_taskgraph/optimize/bugbug.py", "taskcluster/gecko_taskgraph/test/test_optimize_strategies.py", "taskcluster/gecko_taskgraph/util/bugbug.py"], "git_node": "389e80e7efe579dde38fcf5c0a8f6ebb6c7cdf04", "git_parents": ["5a484f7183fe0b436c5288faa4b07c544350a276"], "node": "05aea347cafed2247ed2f34df7d0ed2fcc9de85f", "parents": ["f3b24fcbcb6718759196ddca2860737cf5c695e0"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088537 - Bind child-written alt-data to the writer's remote type and require a fully loaded origin. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340412\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/HttpChannelParent.cpp", "netwerk/protocol/http/HttpChannelParent.h", "netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": "c0268634ee8714b1d627973b5b0f7f81c509e079", "git_parents": ["389e80e7efe579dde38fcf5c0a8f6ebb6c7cdf04"], "node": "9775f9c958a38de0076f1d2504c8054ad6524045", "parents": ["05aea347cafed2247ed2f34df7d0ed2fcc9de85f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914741 - Suppress the this-escape and serial javac lints in libwebrtc's Android Java. r=webrtc-reviewers,ahochheiden,mjf\n\nGeckoView compiles these sources in the same javac invocation as its own Java, so they get its -Werror, which\njavac can't turn off for individual source paths. Later commits turn on both lints.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340812\n", "files": ["third_party/libwebrtc/sdk/android/api/org/webrtc/GlUtil.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/SurfaceViewRenderer.java"], "git_node": "5ac4a2b2649af6af2f9038f0cfbdf27ea6080313", "git_parents": ["c0268634ee8714b1d627973b5b0f7f81c509e079"], "node": "6d213db7dd1bd51a0d77d53e4c97a003ebe60bfb", "parents": ["9775f9c958a38de0076f1d2504c8054ad6524045"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914741 - Stop suppressing checkstyle javadocmethod in org.mozilla.gecko. r=geckoview-reviewers,ahochheiden,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340813\n", "files": ["mobile/android/geckoview/checkstyle-suppressions.xml", "mobile/android/geckoview/checkstyle.xml", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/Clipboard.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoJavaSampler.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoScreenOrientation.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoThread.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/mozglue/GeckoLoader.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/GeckoProcessManager.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/GeckoServiceChildProcess.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/EventCallback.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/GeckoBundle.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/NetworkUtils.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/XPCOMEventTarget.java", "tools/lint/android-checkstyle.yml"], "git_node": "18f2cd70c96afa4b382f7afdfa89882e22fb780c", "git_parents": ["5ac4a2b2649af6af2f9038f0cfbdf27ea6080313"], "node": "f4b7b38702f57a2ca19ef19b980ee3c9add1396a", "parents": ["6d213db7dd1bd51a0d77d53e4c97a003ebe60bfb"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914741 - Stop disabling the this-escape javac lint. r=geckoview-reviewers,android-build-system-reviewers,ahochheiden,ohall\n\nWebResponse's constructor no longer calls the overridable setReadTimeoutMillis. The other escapes are inherent\nto their class's design and are suppressed on their constructors: GeckoView's constructors configure the View,\nRuntimeSettings.Builder asks the subclass for its settings object, a RuntimeSettings registers with its\nparent, CrashHandler installs itself as the uncaught exception handler, the GeckoResult copy constructor\nchains onto the source result, and GeckoSession hands itself to its helper objects, which only keep the\nreference or use package-private members.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340814\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/geckoview/CrashHandler.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoResult.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoView.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/RuntimeSettings.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/WebResponse.java", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "7f50ac04b7ab68c14ce93c6be5aefca02ab4c447", "git_parents": ["18f2cd70c96afa4b382f7afdfa89882e22fb780c"], "node": "d2a9e8bf22833f9e442cc6d2673ff89c39c538b6", "parents": ["f4b7b38702f57a2ca19ef19b980ee3c9add1396a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914741 - Treat Java warnings as errors in every Android project. r=android-reviewers,geckoview-reviewers,android-build-system-reviewers,ahochheiden,mcarare,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340815\n", "files": ["mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "279271e38c8c89e678c492a1d349475e441828b1", "git_parents": ["7f50ac04b7ab68c14ce93c6be5aefca02ab4c447"], "node": "7b3c3d8a80872e2aee1b5b6da12e7982231656b4", "parents": ["d2a9e8bf22833f9e442cc6d2673ff89c39c538b6"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914741 - Enable the serial javac lint and drop fixable @SuppressWarnings. r=geckoview-reviewers,android-build-system-reviewers,ahochheiden,ohall\n\nSerializable classes get a serialVersionUID, and the two Exception fields of non-serializable types become\ntransient.\n\nSuppressions that hid fixable code go: Class.forName results use asSubclass(Service.class) or Class\u003c?\u003e instead\nof an unchecked cast, the test rule's delegate proxy uses Class.cast, and GeckoLoader's unused getCPUABI is\ndeleted. Suppressions that no longer suppress anything are removed, and geckoview_example's \"DEPRECATION\" key,\nwhich javac ignores, becomes \"deprecation\". The classfile exclusion stays, with the reason it is still needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340816\n", "files": ["mobile/android/annotations/src/main/java/org/mozilla/gecko/annotationProcessors/SDKProcessor.java", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/GeckoResultTest.java", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/TestHarnessException.java", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/util/UiThreadUtils.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/ClientAuthCertificateManager.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/EventDispatcher.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/mozglue/GeckoLoader.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/GeckoProcessManager.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/GeckoServiceChildProcess.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/ServiceAllocator.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/DebugConfig.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/WebAuthnUtils.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/AIFeaturesController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/ExperimentDelegate.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoResult.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoRuntime.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoRuntimeSettings.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/IPProtectionController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/Image.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/PageExtractionController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/PdfViewerController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/TranslationsController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/WebExtension.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/WebRequestError.java", "mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/utils/WindowUtils.java", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "a414801f98d429e6a93115a63372d214988d78d5", "git_parents": ["279271e38c8c89e678c492a1d349475e441828b1"], "node": "e6f75a7c6a5991559709eb8c42658edaa23fdf03", "parents": ["7b3c3d8a80872e2aee1b5b6da12e7982231656b4"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2087390 - Hold the loader observer lock when signalling the end of a DLL load. r=win-reviewers,gstoll\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340854\n", "files": ["browser/app/winlauncher/freestanding/LoaderPrivateAPI.cpp"], "git_node": "8ea3bcf9bf72b23ba9c9554912350d438e25cfeb", "git_parents": ["a414801f98d429e6a93115a63372d214988d78d5"], "node": "88398c1e6897b560c22120f60bc0c9546b67f5b6", "parents": ["e6f75a7c6a5991559709eb8c42658edaa23fdf03"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2072398. Unregister named timelines and their animations when an element is removed. r=layout-scroll-driven-animation-reviewers,firefox-style-system-reviewers,boris\n\nUnbinding an element destroys its timeline and animation collections, but we\ndidn't remove timelines from TimelineManager's name maps or the animations from\nnsAnimationManager's mAnimationsWithNamedTimeline. They were only updated when\nthe element was restyled. As a result, every named timeline lookup kept scanning\nthe stale entries, so rebuilding the same content got slower with each pass, and\nthe entries kept the removed subtrees alive until the pres context went away.\n(Bug 2021326 fixed removal of timeline-scope data.)\n\nThis commit makes TimelineCollection unregister its timelines in its destructor,\nso the manager's own destroy paths no longer do it themselves, and has\nCSSAnimation::CancelFromStyle() drop the animation's named timeline reference\nthrough the code the JS timeline setter already used for that, moved into\nCSSAnimation. The manager is looked up through the owning element so that an\neffect retargeted by script does not matter, and the animation is also dropped\nfrom the deferred update set. This covers the explicit removals in\nnsAnimationManager::DoUpdateAnimations(), which are dropped. Animations attached\nto an unregistered timeline are re-resolved by a later patch in this bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340050\n", "files": ["dom/animation/Animation.cpp", "dom/animation/Animation.h", "dom/animation/CSSAnimation.cpp", "dom/animation/CSSAnimation.h", "layout/style/TimelineCollection.cpp", "layout/style/TimelineCollection.h", "layout/style/TimelineManager.cpp", "layout/style/TimelineManager.h", "layout/style/nsAnimationManager.cpp", "testing/web-platform/tests/scroll-animations/css/animation-timeline-shared-name-removal.html", "testing/web-platform/tests/scroll-animations/css/scroll-timeline-source-removal.html"], "git_node": "23995b0884fdb81b39fb8668f8fd37740575156c", "git_parents": ["8ea3bcf9bf72b23ba9c9554912350d438e25cfeb"], "node": "6e6fcc34a0c9a1ca2a36120f323b03ef867802ea", "parents": ["88398c1e6897b560c22120f60bc0c9546b67f5b6"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2072398. Run sequential tasks from the style traversal driver rather than from SequentialTaskList's Drop. r=emilio\n\nThe tasks ran from SequentialTaskList's Drop, so running them safely relied on\nThreadLocalStyleContext declaring its caches before its task list, and the\ndriver never knew whether a traversal had queued any. Now traverse_dom()\ncollects the tasks from every thread-local context, drops the contexts, and\nruns the tasks itself, so that a later patch can act only after a batch has\nactually run. Dropping a context with unrun tasks is now a debug assertion\nfailure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340395\n", "files": ["servo/components/style/context.rs", "servo/components/style/driver.rs"], "git_node": "d0ba406c3fe241f07493651aac59d96dc0846686", "git_parents": ["23995b0884fdb81b39fb8668f8fd37740575156c"], "node": "6d5840660873e4d495659078d07ec217c6032df6", "parents": ["6e6fcc34a0c9a1ca2a36120f323b03ef867802ea"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2072398. Batch named timeline lookups until the style traversal is done. r=firefox-style-system-reviewers,emilio\n\nGecko_UpdateAnimations() re-resolved every animation referring to a timeline\nname as soon as one element registered a timeline of that name, and every\nanimation with any named timeline as soon as one element's timeline-scope\nchanged. Those calls exist because the update tasks run in breadth-first order,\nnot tree order, so an animation can be created before the element providing its\ntimeline is processed. With N elements sharing one name in one traversal, that\nis N passes over up to N animations, each doing a lookup that scans the N\ntimelines.\n\nInstead, we now record the affected names in nsAnimationManager and resolve them\nfrom a DomTraversal hook that the traversal driver calls once it has run the\ntraversal's sequential tasks, when every element of the traversal has registered\nits timelines. A timeline-scope change now marks only the names it scoped before\nand after the change, or everything for `all`. Names marked outside a traversal,\nby a timeline's element leaving the tree, are flushed at the end of the next\ntraversal that runs an UpdateAnimations task, or from\nUpdateDeferredTimelineChanges() in the next frame, so such animations re-resolve\ninstead of keeping a timeline on a detached element. That covers the FIXME for\nbug 1774060 in TimelineCollection's destructor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340054\n", "files": ["layout/style/GeckoBindings.cpp", "layout/style/GeckoBindings.h", "layout/style/TimelineCollection.cpp", "layout/style/TimelineManager.cpp", "layout/style/TimelineManager.h", "layout/style/TimelineScope.h", "layout/style/nsAnimationManager.cpp", "layout/style/nsAnimationManager.h", "servo/components/style/driver.rs", "servo/components/style/gecko/traversal.rs", "servo/components/style/traversal.rs"], "git_node": "d3caf3e7125c3c45eba2a337590a789cc8aa7d44", "git_parents": ["d0ba406c3fe241f07493651aac59d96dc0846686"], "node": "9ce1a3dac7a4f863508432a8581aeca320211d61", "parents": ["6d5840660873e4d495659078d07ec217c6032df6"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088237 - Add UK gate for Smart Window Monitor r=ngrato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339333\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agentui_command.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button_panel.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_create.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_command_palette.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_chat_browser_tabbable.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_nimbus.js", "browser/components/aiwindow/ui/test/browser/chat/browser_chat_copy_message.js", "browser/components/aiwindow/ui/test/xpcshell/test_MonitorUIUtils.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "f447411e346bfbcd53688f20c5397d089005d7c7", "git_parents": ["d3caf3e7125c3c45eba2a337590a789cc8aa7d44"], "node": "b2db4a80b50d1a8b07c23d6e5885504681a055b7", "parents": ["9ce1a3dac7a4f863508432a8581aeca320211d61"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089819 - Use a worst-case bound and fallible allocation when calling getIntercepts. r=layout-reviewers,jwatt\n\nIn principle this should be more performant, as it means we only make one call\nto getIntercepts, which is where most work happens. The array allocation will\ninitially be oversized, and subsequently truncated to fit the actual number of\nreturned intercepts, but by using fallible allocation we ensure that in an OOM\nsituation it will degrade gracefully (we just bail out of skip-ink processing)\nrather than crashing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340905\n", "files": ["layout/painting/nsCSSRendering.cpp"], "git_node": "dcf0b202952b570b4c209a9ddcb295ac8d86560b", "git_parents": ["f447411e346bfbcd53688f20c5397d089005d7c7"], "node": "b99f12143ac4185c14be78c40451b5570dc6a77e", "parents": ["b2db4a80b50d1a8b07c23d6e5885504681a055b7"], "tags": []}, {"author": "lottiehope \u003clottie_hope@hotmail.co.uk\u003e", "branch": "default", "desc": "Bug 2082512 - Add the issued-to card to the certificate details sub-page. r=android-reviewers,android-l10n-reviewers,parker,tthibaud\n\nShows the organization, locality and country the certificate was issued to, with\nthe country as a localized name. Until the missing-field behaviour is decided,\nabsent fields are hidden, and the card is hidden when all of them are absent.\n\nThe card is placed in the sub-page's issued-to slot once D340061 lands, since that\npatch changes the sub-page's previews.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340287\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/CertificateIssuedTo.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/IssuedTo.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/CertificateIssuedToTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/IssuedToTest.kt"], "git_node": "6aab67cc11c69b6138c4c80a3e8b39f45571e480", "git_parents": ["dcf0b202952b570b4c209a9ddcb295ac8d86560b"], "node": "fa5d0c275a34480e38c81e334c60d31413bd7328", "parents": ["b99f12143ac4185c14be78c40451b5570dc6a77e"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2090958 - Pass Happy Eyeballs timer durations to C++ in microseconds. r=kershaw,necko-reviewers\n\nDuration::as_millis() truncates, so the timer fired before the state machine's\ndeadline and caused a follow-up wakeup. Arm a high resolution timer instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340930\n", "files": ["netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.h", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs"], "git_node": "3eefef857d2404e03aa8354c14212736ce54b509", "git_parents": ["6aab67cc11c69b6138c4c80a3e8b39f45571e480"], "node": "57ca7751cb9ffe65b80d713e3497ce9bc2c44058", "parents": ["fa5d0c275a34480e38c81e334c60d31413bd7328"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085810 - VPN toolbar icon becomes invisible after flipping enabled pref while in the PAUSED state - r=ip-protection-reviewers,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340547\n", "files": ["browser/components/ipprotection/IPProtectionToolbarButton.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_toolbar.js", "browser/components/ipprotection/tests/xpcshell/test_IPProtectionToolbarButton.js"], "git_node": "fa6308f5418c6f8deff1adf8327557eb268df870", "git_parents": ["3eefef857d2404e03aa8354c14212736ce54b509"], "node": "91a5c326332e8ddfa7c58b8c906138385f2ed296", "parents": ["57ca7751cb9ffe65b80d713e3497ce9bc2c44058"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2084328 - Use a 60 s negative DNS cache lifetime on all channels. r=omansfeld,kershaw\n\nBug 2072119 set network.dnsNegativeCacheExpiration to 300 s on Nightly and\n60 s elsewhere. Keep the lifetime short on all channels: a wrong negative\nanswer then sticks for less time, and the grace period handles refresh and\nfallback instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337261\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "981c03179dada644779223c25b48069811e0405c", "git_parents": ["fa6308f5418c6f8deff1adf8327557eb268df870"], "node": "e96e9bbf5cce5faf880fd4eb4b508f0173032bef", "parents": ["91a5c326332e8ddfa7c58b8c906138385f2ed296"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090948 - Disable -Wcpp for every macOS deployment target below 11.0. r=firefox-build-system-reviewers,ArnaudBienner,sergesanspaille\n\nLocal builds target 10.15 on aarch64 too, so keying the flag on x86_64 missed them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340913\n", "files": ["build/moz.configure/bindgen.configure", "build/moz.configure/warnings.configure"], "git_node": "67a38d512b90e9fce1faaf2726423f474ff42540", "git_parents": ["981c03179dada644779223c25b48069811e0405c"], "node": "b8e4b48dc9abad8347b6d69fabb7f33645f1a775", "parents": ["e96e9bbf5cce5faf880fd4eb4b508f0173032bef"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084649 - Track the embedding frameloader in BrowserParent. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340308\n", "files": ["docshell/shistory/nsSHistory.cpp", "dom/base/nsFrameLoader.cpp", "dom/base/nsFrameLoader.h", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "c6451c326ee7e7c2e9f787f769b62d9f2c2d0164", "git_parents": ["67a38d512b90e9fce1faaf2726423f474ff42540"], "node": "44e9f050459a6232d2cae57ac6888481a800ca74", "parents": ["b8e4b48dc9abad8347b6d69fabb7f33645f1a775"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084649 - Track the embedding frameloader in BrowserParent. r=smaug\" for causing build bustages on nsFrameLoader.\n\nThis reverts commit c6451c326ee7e7c2e9f787f769b62d9f2c2d0164.\n", "files": ["docshell/shistory/nsSHistory.cpp", "dom/base/nsFrameLoader.cpp", "dom/base/nsFrameLoader.h", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "36f723411f7a88e34d9ed375dbb52c435a0aab98", "git_parents": ["c6451c326ee7e7c2e9f787f769b62d9f2c2d0164"], "node": "dc1bf1bbad00bfb1bb596cfd9bb78fdcddb0a45c", "parents": ["44e9f050459a6232d2cae57ac6888481a800ca74"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2090287 - Use 64-bit node in 32-bit Windows test tasks. r=taskgraph-reviewers,bhearsum\n\nThe 32-bit Windows test platforms run on 64-bit workers. With a 32-bit node,\nprofiler-edit aborts at startup because V8 cannot reserve the heap requested by\n--max-old-space-size=8192, so profiles from these tasks never get symbolicated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340502\n", "files": ["taskcluster/kinds/mochitest/kind.yml", "taskcluster/kinds/test/misc.yml", "taskcluster/kinds/test/xpcshell.yml"], "git_node": "b44352714890addb83e478806e174efa1cb3ed0b", "git_parents": ["36f723411f7a88e34d9ed375dbb52c435a0aab98"], "node": "46f682adaaafcc7769bd1790d45929535ba37f7e", "parents": ["dc1bf1bbad00bfb1bb596cfd9bb78fdcddb0a45c"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2090287 - Use native ARM64 node for browsertime on Windows aarch64. r=perftest-reviewers,taskgraph-reviewers,kshampur,bhearsum\n\nThis replaces the 32-bit x86 node, which needed emulation and was the last user\nof the win32-node toolchain. No Raptor tasks run on Windows aarch64 at the\nmoment, so this changes no current task.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340503\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/other.py"], "git_node": "4e070cfbe13bf66190ec6979b4e0644ceba1ae9e", "git_parents": ["b44352714890addb83e478806e174efa1cb3ed0b"], "node": "1c00175c9c5718faae696fdf090da29a4fe066b2", "parents": ["46f682adaaafcc7769bd1790d45929535ba37f7e"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2090287 - Remove the 32-bit Windows node toolchain. r=taskgraph-reviewers,bhearsum\n\nNothing fetches win32-node anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340504\n", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/node.yml"], "git_node": "a498b70b38b5c9c5890eca28572f17ce68299ff9", "git_parents": ["4e070cfbe13bf66190ec6979b4e0644ceba1ae9e"], "node": "fc491616e5296b7e96635afe1b95fc9e2af99aa3", "parents": ["1c00175c9c5718faae696fdf090da29a4fe066b2"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089206 - Keep alt-svc mappings when a racing connection attempt fails, r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340348\n", "files": ["netwerk/base/MockNetworkLayer.cpp", "netwerk/base/MockNetworkLayerController.cpp", "netwerk/base/MockNetworkLayerController.h", "netwerk/base/nsIMockNetworkLayerController.idl", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/socket/neqo_glue/src/lib.rs", "netwerk/test/unit/test_http3_proxy_reset_keeps_alt_svc.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "86915956c2ca57c431692aca0e20f63935dabe8c", "git_parents": ["a498b70b38b5c9c5890eca28572f17ce68299ff9"], "node": "e7966face79bab011916fe8d7dece67632e8cffe", "parents": ["fc491616e5296b7e96635afe1b95fc9e2af99aa3"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2084393 - Fix setting primary attribute for activeness change in GeckoView r=geckoview-reviewers,ohall\n\nReactivation doesn't re-register the primary BrowserParent (that only happens on a BrowserParent change), so re-assert the primary attribute to force nsFrameLoader to restore this browser as the window's primary content. Without this, APIs that rely on the primary content browsing context break after the tab is backgrounded and reselected (ScrollCapture and captureFullPage are affected, other potentially affected APIs include SessionFinder, SessionTextInput, SelectionActionDelegate, getPageToScreenMatrix, getPageToSurfaceMatrix, printToPdf, printPageContent, ScrollDelegate).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336281\n", "files": ["mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/background.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-api.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-schema.json", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/BaseSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/SessionLifecycleTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java", "mobile/shared/modules/geckoview/GeckoViewContent.sys.mjs"], "git_node": "132c0062c6d0c015f8cfb5504de171e321f78ea3", "git_parents": ["86915956c2ca57c431692aca0e20f63935dabe8c"], "node": "a7cef8d192781a5a72ddbe37aaaec228a23e2e63", "parents": ["e7966face79bab011916fe8d7dece67632e8cffe"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088555 - Remove the duplicate first contentful paint histogram `performance.time.to_first_contentful_paint`. r=bas\n\nIt duplicates performance.pageload.fcp but also records about: pages and iframes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339671\n", "files": ["dom/base/nsDOMNavigationTiming.cpp", "dom/metrics.yaml"], "git_node": "e4730966b674a42d9ec3c7ae64d39c27ac226507", "git_parents": ["132c0062c6d0c015f8cfb5504de171e321f78ea3"], "node": "81b54dde13c0015a0c013b50e79cc7ddf800d208", "parents": ["a7cef8d192781a5a72ddbe37aaaec228a23e2e63"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090398 - use SSL_GetResumptionTokenInfoWithFlags in SSLTokensCache::Put. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340558\n", "files": ["netwerk/base/SSLTokensCache.cpp"], "git_node": "8503d22a7f9dc8a295df461bce07a716a189e3c0", "git_parents": ["e4730966b674a42d9ec3c7ae64d39c27ac226507"], "node": "5c5c6901d610418906e85eeaffed575e39eb91b2", "parents": ["81b54dde13c0015a0c013b50e79cc7ddf800d208"], "tags": []}, {"author": "Alex Finder \u003cafinder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059736 Add sheriffing documentation for downstream alerts r=perftest-reviewers,sparky\n\nThis patch adds documentation to specify which types of alert summaries can be set as downstream to autoland alert summaries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337579\n", "files": ["testing/perfdocs/generated/perf-sheriffing.md", "testing/performance/perf-sheriffing/perfdocs/index.md"], "git_node": "eb583c4788bf7835934bc017cdd87763fc6abeed", "git_parents": ["8503d22a7f9dc8a295df461bce07a716a189e3c0"], "node": "3ccc5672a0bcf299767e1986be97dbf7c881b948", "parents": ["5c5c6901d610418906e85eeaffed575e39eb91b2"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the symbol dumping targets from `rules.mk` to `Linkable` r=firefox-build-system-reviewers,sergesanspaille,sylvestre\n\nWhich binaries get symbols was a Make expression over `FINAL_TARGET`,\n`MOZBUILD_NON_DEFAULT_TARGETS` and four linkable variables, so every backend had\nto reproduce that expression to match it.\n\nThe final target test is the `dist/bin` directory now, not the `$(DIST)/bin%`\nprefix Make matched, so a sibling such as `dist/binaries` no longer counts. No\ntarget in the tree is affected.\n\nA profile generate build leaves simple programs out, because `rules.mk` does not\nbuild them in that pass.\n\n`MOZ_AUTOMATION_BUILD_SYMBOLS` stays in Make, since it is not a configure\nsubst.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329008\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/test/backend/data/program-paths/dist-bin-sibling/moz.build", "python/mozbuild/mozbuild/test/backend/data/program-paths/dist-bin-simple/moz.build", "python/mozbuild/mozbuild/test/backend/data/program-paths/dist-bin-simple/simple.cpp", "python/mozbuild/mozbuild/test/backend/data/program-paths/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "b057eea0f217c9eae04f9e8631ac0d10e992e3a5", "git_parents": ["eb583c4788bf7835934bc017cdd87763fc6abeed"], "node": "272a14f4c4f2b8670f4c2b1ec103619dd5d7ece3", "parents": ["3ccc5672a0bcf299767e1986be97dbf7c881b948"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the build id choice from root `Makefile.in` to `BuildDriver` r=firefox-build-system-reviewers,sergesanspaille\n\n`BuildDriver` writes `buildid.txt` before handing off to the backend, and\n`buildid.h` is generated from it, so `BuildDriver` instead of a forced Make\nrule decides when the id changes. The id still changes on every full or faster\nlocal build, stays pinned to `MOZ_BUILD_DATE` in CI, and Android still keeps\nthe id it was first given.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329476\n", "files": ["Makefile.in", "build/variables.py", "moz.build", "python/mozbuild/mozbuild/android_version_code.py", "python/mozbuild/mozbuild/controller/building.py", "python/mozbuild/mozbuild/test/controller/test_buildid.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "26b00cdf354ab3f3a9cc2647f8c3d5352e290de9", "git_parents": ["b057eea0f217c9eae04f9e8631ac0d10e992e3a5"], "node": "cff910b2878fb1085cdfd73e3bb88b17928a4bcc", "parents": ["272a14f4c4f2b8670f4c2b1ec103619dd5d7ece3"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the source changeset lookup from root `Makefile.in` to `BuildDriver` r=firefox-build-system-reviewers,sylvestre\n\n`BuildDriver` writes `source-repo.txt` before handing off to the backend, and\n`source-repo.h` is generated from it, so the header only changes when that\nfile does.\n\nLocal builds now get the same `source-repo.h` from git, jj and Mercurial\ncheckouts, with no changeset unless one is configured or the source tree has a\n`sourcestamp.txt`. Only Mercurial used to look one up, which changed the header\non every commit and rebuilt everything that includes it. CI configures the\nchangeset, so its header is unchanged. Android builds no longer keep the\nheader from their first build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329477\n", "files": ["Makefile.in", "build/variables.py", "moz.build", "python/mozbuild/mozbuild/controller/building.py", "python/mozbuild/mozbuild/test/controller/test_source_repo.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "bc25988eef36703acf03b9b10962733b5eaac100", "git_parents": ["26b00cdf354ab3f3a9cc2647f8c3d5352e290de9"], "node": "ad9fb9fcfc1ecc55bc881835cfeb926d924a61c5", "parents": ["cff910b2878fb1085cdfd73e3bb88b17928a4bcc"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the Android test font copies from `testsuite-targets.mk` to `TEST_HARNESS_FILES` r=firefox-build-system-reviewers,geckoview-reviewers,nalexander\n\nThe fonts now install during the build instead of when the test packages are\nmade, and the font directory's `moz.build` is no longer copied into `_tests`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340100\n", "files": ["mobile/android/fonts/moz.build", "testing/testsuite-targets.mk", "toolkit/moz.configure"], "git_node": "28bbba1680eacb7f748be19904a87623cf8fb0f9", "git_parents": ["bc25988eef36703acf03b9b10962733b5eaac100"], "node": "46e53fe24bb4939b3fa4c0a77ea156431437c7f0", "parents": ["ad9fb9fcfc1ecc55bc881835cfeb926d924a61c5"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the profile generate simple program skip and the cppunittest install from `rules.mk` to the backend r=firefox-build-system-reviewers,sergesanspaille\n\nEvery `CppUnitTests` directory is in `TEST_DIRS`, so the `ENABLE_TESTS` check\nhad no effect. `SimpleProgram` objects are only emitted with\n`COMPILE_ENVIRONMENT`, so the `COMPILE_ENVIRONMENT` check had no effect either.\n`SimpleProgram.dump_syms` loses its profile generate case, since the backend no\nlonger reads it in that pass. The profile generate pass also no longer installs\n`MOZ_COPY_PDBS` PDBs for the C++ unit tests, which that pass does not build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340101\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/cpp-unit-tests/TestOne.cpp", "python/mozbuild/mozbuild/test/backend/data/cpp-unit-tests/TestTwo.cpp", "python/mozbuild/mozbuild/test/backend/data/cpp-unit-tests/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "b4746b5932820e17a05400309f2f87493884696d", "git_parents": ["28bbba1680eacb7f748be19904a87623cf8fb0f9"], "node": "6cd37e3360955961326bcb223be6f5f48f05381c", "parents": ["46e53fe24bb4939b3fa4c0a77ea156431437c7f0"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the Cargo edge inputs from `rust.mk` to the backend r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340103\n", "files": ["config/makefiles/rust.mk", "python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/rust_commands.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "720731b98f62c1fb415b2e2d33806b1fb33b8fcf", "git_parents": ["b4746b5932820e17a05400309f2f87493884696d"], "node": "8fd7f09d200cf2e2f79ff9a9c4d42902949a3d79", "parents": ["6cd37e3360955961326bcb223be6f5f48f05381c"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the sandboxed wasm library link flags from `rules.mk` to `ComputedFlags` r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340107\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/test/frontend/test_emitter.py"], "git_node": "1cf0a8664b8848f6119131b4b078598f84806c13", "git_parents": ["720731b98f62c1fb415b2e2d33806b1fb33b8fcf"], "node": "5f67c8d817685959ac7d3976e2e0add149a7eb60", "parents": ["8fd7f09d200cf2e2f79ff9a9c4d42902949a3d79"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the winchecksec run from `rules.mk` to the `dumpsymbols` action r=firefox-build-system-reviewers,sergesanspaille\n\n`dumpsymbols` now parses the arguments `main` receives instead of `sys.argv`,\nso the test can call it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340109\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/action/dumpsymbols.py", "python/mozbuild/mozbuild/test/action/test_dumpsymbols.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "043e143364f73f7287da1156e3e496606a2ed582", "git_parents": ["1cf0a8664b8848f6119131b4b078598f84806c13"], "node": "52acc5e118fe931cb4705e1c6bb8f3c34638a332", "parents": ["5f67c8d817685959ac7d3976e2e0add149a7eb60"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Key the l10n repack staging directory on the locale r=firefox-build-system-reviewers,sylvestre\n\n`l10n_repackage` wipes its staging directory before it unpacks the en-US\npackage. Each locale now gets its own `dist/l10n-stage/\u003clocale\u003e`, so one\nlocale's repack no longer wipes another's.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340117\n", "files": ["build/docs/locales.md", "python/mozbuild/mozbuild/action/l10n_repackage.py", "toolkit/locales/l10n.mk"], "git_node": "f0b4a22760261bd5f31f7733ef10e2e5a5560c1c", "git_parents": ["043e143364f73f7287da1156e3e496606a2ed582"], "node": "6acf94c6108df699b77650ec6fb14c3677551e1e", "parents": ["52acc5e118fe931cb4705e1c6bb8f3c34638a332"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090109 - moveBefore() should still invalidate style. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340955\n", "files": ["layout/base/PresShell.cpp", "layout/style/RestyleManager.cpp", "layout/style/RestyleManager.h", "testing/web-platform/meta/dom/nodes/moveBefore/moveBefore-child-list-selector-invalidation.html.ini"], "git_node": "ab591cde0dce97b088798db3f5b5f72a55407ae9", "git_parents": ["f0b4a22760261bd5f31f7733ef10e2e5a5560c1c"], "node": "12324e6ec170945e3ebdbf310e9b2ac59b01a154", "parents": ["6acf94c6108df699b77650ec6fb14c3677551e1e"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050783: Make the entire List All Tabs panel a drop zone for dragged tabs r=tabbrowser-reviewers,daniellegraham,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325947\n", "files": ["browser/components/tabbrowser/TabsList.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_tab_manager_drag.js"], "git_node": "123ccd575f8d05df3486c8bc17a8422edf59bd7b", "git_parents": ["ab591cde0dce97b088798db3f5b5f72a55407ae9"], "node": "d93fd042a7d03ab4c0b5bfd7826798e10db023e8", "parents": ["12324e6ec170945e3ebdbf310e9b2ac59b01a154"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2069580 - Move the browsing context and progress token into the CheckInstalled callback in SpeechModelResolver::AuthorizeDownload (Coverity CID 1700844) r=media-webspeech-reviewers,pehrsons\n\nNothing reads bc or progressToken after the CheckInstalled() call, so the\ncapture can take them instead of adding a reference to each. The gain is\nsmall: the RefPtr copy costs an AddRef/Release pair and the nsString copy\nonly shares the refcounted buffer.\n\nmodel stays a copy: it is also the first argument of the same CheckInstalled()\ncall and taken by reference, so moving it would leave the call depending on\nunspecified argument evaluation order.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323829\n", "files": ["dom/media/webspeech/recognition/SpeechModelResolver.cpp"], "git_node": "2bf6bf0f4a3a451558fe16e7c182de25e26cf4bd", "git_parents": ["123ccd575f8d05df3486c8bc17a8422edf59bd7b"], "node": "708a062a6751b14d65a0be9958485641db770cb9", "parents": ["d93fd042a7d03ab4c0b5bfd7826798e10db023e8"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2075361 - Add simpleperf profiling to Android resource usage tests. r=perftest-reviewers,taskgraph-reviewers,releng-reviewers,aglavic,bhearsum\n\nThe background and foreground resource usage tests can now be profiled\nwith simpleperf. This works both with the gecko-profile try option and\nwith the \"Create Gecko Profile\" action. For these tests, only simpleperf\nis enabled; the Gecko profiler is not.\n\nFor now, I believe simpleperf profiles are more useful than Gecko profiler\nprofiles for this test. We could do something similar as for the applink\nstartup profiles where the gecko-profile option makes us run the test\nthree times (just gecko profiler, just simpleperf, and both), but part\nof this test is a 10 minute wait and we don't really have time to do that\nmultiple times. So I think sticking with just simpleperf for now is fine.\n\nImplementation:\n\nWhen simpleperf is active, main-background.sh and main-foreground.sh\nre-run themselves through profile_resource_usage.py. This wrapper starts\na system-wide simpleperf recording before the test script runs, so the\nprofile includes browser startup and the test setup steps. The recording\nstops 30 seconds after the test signals the start of its measurement\nperiod, or earlier if the test script exits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332089\n", "files": ["taskcluster/gecko_taskgraph/actions/gecko_profile.py", "taskcluster/gecko_taskgraph/test/test_transforms_perftest.py", "taskcluster/gecko_taskgraph/transforms/perftest.py", "testing/performance/android-resource/main-background.sh", "testing/performance/android-resource/main-foreground.sh", "testing/performance/android-resource/profile_resource_usage.py"], "git_node": "a41109c6e20fe3c7e4a9df4916021fdce6bb72c6", "git_parents": ["2bf6bf0f4a3a451558fe16e7c182de25e26cf4bd"], "node": "40d896c0eeca7657264ae0ab8b8708964968ef2e", "parents": ["708a062a6751b14d65a0be9958485641db770cb9"], "tags": []}, {"author": "Ali Sayed Salehi \u003ca.s.salehi.95@gmail.com\u003e", "branch": "default", "desc": "Bug 2055854 - Part 3: Add risk-aware perf batching strategies to the shadow schedulers. r=taskgraph-reviewers,perftest-reviewers,sparky,bhearsum\n\nOn autoland, nearly all performance tests only run on backstop pushes\n(every 20 pushes or 4 hours). This bug evaluates other cadences, where the\nwhole perf suite runs on selected \"batch\" pushes. Each candidate cadence\nruns as a tier 3 shadow scheduler task on autoland: it computes which tasks\nthe cadence would have scheduled on the push and uploads them for offline\nevaluation, without changing what autoland runs. Earlier parts added\nfixed-size and time-based cadences.\n\nThis patch adds cadences driven by bugbug's perf regression predictor,\nwhich scores how likely each commit is to regress performance:\n\n- perf_rasb batches once the probability that at least one commit since\n  the last batch regressed performance reaches a threshold.\n- perf_rapb does the same, but raises each commit's score the longer it\n  waits, so that low-risk commits are not left untested indefinitely.\n- perf_rasb_la and perf_rapb_la add the scores up instead of combining\n  them as a probability.\n\nThe fixed-size and time-based cadences are reduced to one baseline each,\nsince their parameters can be chosen offline by replaying the pushlog.\nTask names no longer include parameter values, so tuning only edits\n`experimental`. The parameters come from bugbug's perf scheduling\nsimulator, which replays each strategy over autoland's pushes, confirmed\nregressions and risk scores; each strategy is set to match the backstop's\ncost while catching every regression it caught. bugbug now serves risk\nscores calibrated against the culprit rate of past commits, so the\nthresholds are probabilities, and it scores backouts like other commits.\n\nWhether a push batches depends on every push since the last batch, but\nshadow scheduler runs are separate tasks that overlap, and some pushes get\nno run, so a running total passed from one run to the next would lose\npushes. Instead, each run finds the last batch recorded before its push\nand replays the pushes since then, from the pushlog and bugbug's cached\nscores, so every run reaches the same result. The time-based cadence now\nworks the same way, which stops it from batching twice when runs overlap.\n\nA push whose commit message says DONTBUILD gets no tasks at all, so no\nshadow scheduler runs on it and no batch can run on it. The replay reads\nthe head commit's message from the pushlog and never makes such a push a\nbatch: a batch due there waits for the next push. For the same reason the\nfixed-size cadence now counts pushes since the last batch, as the backstop\ndoes, instead of running on multiples of the pushlog id, where a batch\nfalling on a DONTBUILD push would be lost rather than deferred.\n\nThe strategies, their formulas and the current perf cadence are documented\nin taskcluster/docs/optimization/perf-batching.md.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335766\n", "files": ["taskcluster/docs/optimization/index.md", "taskcluster/docs/optimization/perf-batching.md", "taskcluster/gecko_taskgraph/optimize/__init__.py", "taskcluster/gecko_taskgraph/optimize/perf_batching.py", "taskcluster/gecko_taskgraph/test/test_optimize_strategies.py", "taskcluster/gecko_taskgraph/test/test_util_bugbug.py", "taskcluster/gecko_taskgraph/util/bugbug.py", "taskcluster/gecko_taskgraph/util/hg.py", "taskcluster/kinds/source-test/shadow-scheduler.yml"], "git_node": "bf5638f08a418f3a71d39f8efdbbbba7a20cc633", "git_parents": ["a41109c6e20fe3c7e4a9df4916021fdce6bb72c6"], "node": "fd58bbb5112631ce4d27002fc2649a26bbe07bcf", "parents": ["40d896c0eeca7657264ae0ab8b8708964968ef2e"], "tags": []}, {"author": "kyle kennedy \u003ckkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087220 - Add new report reasons for New Tab sponsored stories behind a pref. r=fluent-reviewers,thecount,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339658\n", "files": ["browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/ReportContent/ReportContent.jsx", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/ReportContent.test.jsx", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js", "browser/locales/en-US/browser/newtab/newtab.ftl", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "8d3ce9295679e18394ca60fa19f72e628412aa27", "git_parents": ["bf5638f08a418f3a71d39f8efdbbbba7a20cc633"], "node": "312ccebd3d3f6891a60a6de15d7d96ff3bf5eae6", "parents": ["fd58bbb5112631ce4d27002fc2649a26bbe07bcf"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084393 - Fix setting primary attribute for activeness change in GeckoView r=geckoview-reviewers,ohall\" for causing mochitest plain failures at docshell/test/navigation\n\nThis reverts commit 132c0062c6d0c015f8cfb5504de171e321f78ea3.\n", "files": ["mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/background.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-api.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-schema.json", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/BaseSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/SessionLifecycleTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java", "mobile/shared/modules/geckoview/GeckoViewContent.sys.mjs"], "git_node": "e0e7345aacc1e53f9b9935e36dcf913936a70170", "git_parents": ["8d3ce9295679e18394ca60fa19f72e628412aa27"], "node": "82b83b302abf036c308821ee1f91335c9104b28c", "parents": ["312ccebd3d3f6891a60a6de15d7d96ff3bf5eae6"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2090207 - Fill solid color primitives clipped by a path directly in their destination. r=gfx-reviewers,gw\n\nPath clips otherwise always render the pattern into an intermediate target\nand mask it. For a solid color whose other clips are pixel-aligned rects, the\npath is instead tiled during batching and its tiles are drawn with the new\nps_path_tile shader.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340462\n", "files": ["gfx/wr/webrender/res/path_tile.glsl", "gfx/wr/webrender/res/ps_path_tile.glsl", "gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/command_buffer.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/gpu_types.rs", "gfx/wr/webrender/src/path_tiler.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/profiler.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_api/src/lib.rs", "gfx/wr/webrender_build/src/shader_features.rs", "gfx/wr/wrench/reftests/clip/path-fill-direct-ref.yaml", "gfx/wr/wrench/reftests/clip/path-fill-direct.yaml", "gfx/wr/wrench/reftests/clip/path-firefox-logo.png", "gfx/wr/wrench/reftests/clip/reftest.list", "layout/reftests/bugs/reftest.list"], "git_node": "0e0c428a7199cf56fd14461465c4bc7a0bafb663", "git_parents": ["e0e7345aacc1e53f9b9935e36dcf913936a70170"], "node": "390312025293dea859807de352d56ee971cbe830", "parents": ["82b83b302abf036c308821ee1f91335c9104b28c"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2090207 - Draw the fully covered tiles of opaque path fills in opaque batches. r=gfx-reviewers,bradwerth\n\nThis lets them write depth and occlude what is behind them, and moves most of\nthe pixels of large opaque fills out of the blended alpha pass.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340463\n", "files": ["gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/path_tiler.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/wrench/reftests/clip/path-fill-direct-ref.yaml", "gfx/wr/wrench/reftests/clip/path-fill-direct.yaml"], "git_node": "26cfc9ae60a30fe551fe8f85ea98f76d40b3f0fa", "git_parents": ["0e0c428a7199cf56fd14461465c4bc7a0bafb663"], "node": "5016fe07f5e7f408ef161dc8abee8e6410eac1e6", "parents": ["390312025293dea859807de352d56ee971cbe830"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2090207 - Let the path tiler write directly into the batches. r=gfx-reviewers,bradwerth\n\nThis avoids copying the tiles of each path fill.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340464\n", "files": ["gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/path_tiler.rs", "gfx/wr/webrender/src/profiler.rs", "gfx/wr/webrender/src/render_target.rs"], "git_node": "d4836c3ebda7e13ff21f103119712c90c13af37a", "git_parents": ["26cfc9ae60a30fe551fe8f85ea98f76d40b3f0fa"], "node": "a69ca9944e78272d338b46818dc6923e3bb7a918", "parents": ["5016fe07f5e7f408ef161dc8abee8e6410eac1e6"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085948 - Remove has_ssd and using_webdriver from the pageload event r=denispal\n\nTrim the event size: has_ssd is no longer being looked at, and using_webdriver is not an accurate measure of bot usage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338460\n", "files": ["dom/base/test/browser_page_load_event_telemetry.js", "dom/ipc/ContentParent.cpp", "dom/metrics.yaml", "tools/performance/PageloadEvent.h"], "git_node": "1d36150c05c25b2f3eb0224316d555d0bcc21a89", "git_parents": ["d4836c3ebda7e13ff21f103119712c90c13af37a"], "node": "e7b05ddd0e623f30f540e3f89bbb8b0b36f7f144", "parents": ["a69ca9944e78272d338b46818dc6923e3bb7a918"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 69ffd91ad311c8d8ccb784905e5ec2ae7ce91c72\naf -\u003e 69ffd91ad311c8d8ccb784905e5ec2ae7ce91c72\nan -\u003e 69ffd91ad311c8d8ccb784905e5ec2ae7ce91c72\