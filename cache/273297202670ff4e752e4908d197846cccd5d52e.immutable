 aaaf89142418c41b4ac7a23b469f8e327ad50572\nsq -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nsr -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nsv-SE -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nta -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nte -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nth -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\ntl -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\ntr -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\ntrs -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nuk -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nur -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nuz -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nvi -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nwo -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nxh -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nzam -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nzh-CN -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\nzh-TW -\u003e aaaf89142418c41b4ac7a23b469f8e327ad50572\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "43f247c5c0e4257b169e33078deab737c9176bab", "git_parents": ["e8c1781e6a462e158dce2ad970bef889c0f45c84"], "node": "7c454fd9ac68345358cc09c0b91cfca5c6c65ba6", "parents": ["68a4d79b493617f526949cd6c58ce171c0e5077c"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069243 - Move Container Storage Layer into A-S - part 1 - Add migration tests r=timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329039\n", "files": ["toolkit/components/contextualidentity/tests/unit/test_migratedFile.js"], "git_node": "b31606db70dc42997cbb361efacd3bdc12bd08a7", "git_parents": ["43f247c5c0e4257b169e33078deab737c9176bab"], "node": "c682e175a06c43ebbc077ad3d0c0bc5db83dcdd2", "parents": ["7c454fd9ac68345358cc09c0b91cfca5c6c65ba6"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069243 - Move Container Storage Layer into A-S - part 2 - ContextualIdentityService r=timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329040\n", "files": ["toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/components/contextualidentity/tests/unit/test_basic.js", "toolkit/components/contextualidentity/tests/unit/test_containersStore.js", "toolkit/components/contextualidentity/tests/unit/test_corruptedFile.js", "toolkit/components/contextualidentity/tests/unit/test_migratedFile.js", "toolkit/components/contextualidentity/tests/unit/test_siteAssociations.js", "toolkit/components/contextualidentity/tests/unit/xpcshell.toml", "toolkit/components/extensions/test/xpcshell/test_ext_contextual_identities.js"], "git_node": "fa44e88ca6423c0db57bd6d86869592b7040848c", "git_parents": ["b31606db70dc42997cbb361efacd3bdc12bd08a7"], "node": "65bc5ed734ec8164b32c29e69a2b1f562347d19e", "parents": ["c682e175a06c43ebbc077ad3d0c0bc5db83dcdd2"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2092792 [Wayland] Use mFrontBufferSurface so surface setup instead of mFrontBuffer which is set on commit only r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342881\n", "files": ["gfx/layers/NativeLayerWayland.cpp"], "git_node": "7b75579564edfc9f7743362ad8a48d1fd1c47102", "git_parents": ["fa44e88ca6423c0db57bd6d86869592b7040848c"], "node": "58cfd1f6bcfc087a85c9d3f1fc70d1bcfcd5fce6", "parents": ["65bc5ed734ec8164b32c29e69a2b1f562347d19e"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069243 - Move Container Storage Layer into A-S - part 2 - ContextualIdentityService r=timhuang\" for causing xpc failures.\n\nThis reverts commit fa44e88ca6423c0db57bd6d86869592b7040848c.\n\nRevert \"Bug 2069243 - Move Container Storage Layer into A-S - part 1 - Add migration tests r=timhuang\"\n\nThis reverts commit b31606db70dc42997cbb361efacd3bdc12bd08a7.\n", "files": ["toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/components/contextualidentity/tests/unit/test_basic.js", "toolkit/components/contextualidentity/tests/unit/test_containersStore.js", "toolkit/components/contextualidentity/tests/unit/test_corruptedFile.js", "toolkit/components/contextualidentity/tests/unit/test_migratedFile.js", "toolkit/components/contextualidentity/tests/unit/test_siteAssociations.js", "toolkit/components/contextualidentity/tests/unit/xpcshell.toml", "toolkit/components/extensions/test/xpcshell/test_ext_contextual_identities.js"], "git_node": "e76294fcb123c657a31756e0697caab2124d5b02", "git_parents": ["7b75579564edfc9f7743362ad8a48d1fd1c47102"], "node": "a8e159c7daa9fb5ae58f6aa6b4e9b5e6f3dad73c", "parents": ["58cfd1f6bcfc087a85c9d3f1fc70d1bcfcd5fce6"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2091995. Use the SVG bounding box when scrolling an SVG element into view. r=layout-reviewers,emilio\n\nSVG container frames like \u003cg\u003e don't set mRect, so scrolling one into view\n(including focus()) used an empty rect at the origin of the outer \u003csvg\u003e. If\nthat point wasn't visible we would scroll even though the element itself was\nfully visible. Use the same bounds getBoundingClientRect uses.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342865\n", "files": ["layout/base/PresShell.cpp", "testing/web-platform/tests/css/cssom-view/scrollIntoView-svg-container.html"], "git_node": "1683369cd3504362320ae7ad658655c894312b79", "git_parents": ["e76294fcb123c657a31756e0697caab2124d5b02"], "node": "1fe0d05053de3cbc58da29e53bf8fa726d66051c", "parents": ["a8e159c7daa9fb5ae58f6aa6b4e9b5e6f3dad73c"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "95d6cd46c10d24f253b1aa947a0a7b03dc220914", "git_parents": ["1683369cd3504362320ae7ad658655c894312b79", "cd88835d4643f5cb8462654505f8c88806fb412c"], "node": "6033caee09fbfd69739f9985f8b3d60e6a861a28", "parents": ["1fe0d05053de3cbc58da29e53bf8fa726d66051c", "65d83bf91a0f9b3f601a623da39374931ee4158d"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089912 - Add the \"Custom widgets\" entry to Nightly Labs r=fchasen,fluent-reviewers,bolsson\n\nThe Labs page builds each entry from its recipe's Fluent ids, so this\npatch adds the strings for a \"Custom widgets\" entry in a new \"Homepage\"\ngroup, plus the link in `preferences.xhtml` that loads them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341710\n", "files": ["browser/locales-preview/widgets.ftl"], "git_node": "83b3936aa8e4139bfbfb725df4e849e97f16f35d", "git_parents": ["95d6cd46c10d24f253b1aa947a0a7b03dc220914"], "node": "7079f5c0320146bd7a841613bf4ff20a9d35840d", "parents": ["6033caee09fbfd69739f9985f8b3d60e6a861a28"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Add a csp-next web-platform-tests variant; r=jgraham,taskgraph-reviewers,ahal\n\nAdd a \"csp-next\" wpt variant which runs the content-security-policy tests with\nthe prefs of upcoming CSP features enabled, currently\nsecurity.csp.url-hashes.enabled and security.csp.strict-dynamic-url.enabled.\nEach pref is exposed as its own run info property (\"csp_url_hashes\" and\n\"csp_strict_dynamic_url\"), also used for updating metadata, so that test\nexpectations can be conditioned on the features they depend on.\n\nThe whole content-security-policy directory is tagged, so the tests run both\nwith the prefs disabled, in the default jobs, and enabled, in the variant. This\nway, changes to the existing CSP behavior with the prefs disabled show up\nseparately from the new features. Once the prefs are enabled by default, the\nvariant can be changed to run with them disabled instead, until they're\nremoved.\n\nThe variant runs as tier 2, on Linux only, as the CSP behavior tested doesn't\ndepend on the platform.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337043\n", "files": ["taskcluster/kinds/web-platform-tests/kind.yml", "taskcluster/test_configs/variants.yml", "testing/web-platform/meta/content-security-policy/__dir__.ini", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox.py"], "git_node": "19e526c6488d50aa45f6949a296851b18049e5d6", "git_parents": ["83b3936aa8e4139bfbfb725df4e849e97f16f35d"], "node": "e9f3fdf30480a989fb8efb0e3b258801a278bd2d", "parents": ["7079f5c0320146bd7a841613bf4ff20a9d35840d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2029980 - Add a repeat manifest condition for mochitests running with --repeat, r=ahal,mozbase-reviewers.\n\nIt stays false in --verify mode, which sets --repeat for its own steps. Other\n--repeat users, like --run-until-failure and confirm-failures, skip tests that\ncannot run twice.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341595\n", "files": ["docs/code-quality/lint/linters/test-manifest-toml.md", "testing/mochitest/runtests.py", "testing/mozbase/manifestparser/manifestparser/token.py"], "git_node": "904d99ffe0bde16bce466871da076183d3a9a97c", "git_parents": ["19e526c6488d50aa45f6949a296851b18049e5d6"], "node": "1eb2d83e1e6e9afdd249810f544b2ba5a497e2b1", "parents": ["e9f3fdf30480a989fb8efb0e3b258801a278bd2d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2029980 - Make --repeat run each mochitest again right after itself, r=ahal.\n\nPlain, chrome and a11y tests looped over the whole test list instead, and\nbrowser-chrome ran the first test of each browser session one time short.\nTestRunner.js now reruns each test before moving to the next one, so the code\nrestarting the whole list goes away. Adjacent tests that hand state to each\nother now fail under --repeat. This also affects test-verify, which runs with\n--repeat.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341596\n", "files": ["testing/mochitest/browser-test.js", "testing/mochitest/tests/SimpleTest/TestRunner.js", "testing/mochitest/tests/python/test_mochitest_integration.py"], "git_node": "f451c5aa5608a0dd823b739aeb5fe21a21253f0f", "git_parents": ["904d99ffe0bde16bce466871da076183d3a9a97c"], "node": "95d6332a25894fc21aa90a2d8429873f348bbfef", "parents": ["1eb2d83e1e6e9afdd249810f544b2ba5a497e2b1"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2029980 - Make Harness_sanity's service worker tests pass with --repeat, r=ahal.\n\ntest_sanityRegisteredServiceWorker.html failed when run again right after\nitself: registering over its own leftover registration does not notify\nSpecialPowers, so the end-of-test check saw no worker.\ntest_sanityRegisteredServiceWorker2.html unregisters that leftover worker,\nso it can only pass once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341597\n", "files": ["testing/mochitest/tests/Harness_sanity/mochitest.toml", "testing/mochitest/tests/Harness_sanity/test_sanityRegisteredServiceWorker.html"], "git_node": "cf6db0017f0f6de39847cce59c55501c098232cd", "git_parents": ["f451c5aa5608a0dd823b739aeb5fe21a21253f0f"], "node": "b0508d40c9e683e918b729880641eb72a97b9ebe", "parents": ["95d6332a25894fc21aa90a2d8429873f348bbfef"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2029980 - Align the mochitest default-chunks with the chunk counts dynamic chunking currently picks, r=taskgraph-reviewers,ahal.\n\nJobs without runtime data, such as the new repeat variant or a renamed\nplatform, fall back to default-chunks, which were as low as half the dynamic\ncounts and did not fit in max-run-time. This also lowers a few that were above\nthe dynamic counts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341599\n", "files": ["taskcluster/kinds/mochitest/kind.yml"], "git_node": "9b4a8ff7bbf3e2d24e6fff70ef738ff97766569c", "git_parents": ["cf6db0017f0f6de39847cce59c55501c098232cd"], "node": "ab87ba323c8d92c7a94b02d4dfed82164d01c365", "parents": ["b0508d40c9e683e918b729880641eb72a97b9ebe"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2029980 - Add mochitest repeat tasks that run each test twice in a row, without scheduling them yet, r=taskgraph-reviewers,ahal.\n\nThey catch tests that leave state behind for the next test. mochitest-chrome\nnormally runs with e10s disabled, so its variant is combined with 1proc.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292383\n", "files": ["taskcluster/config.yml", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/test_configs/variants.yml", "tools/tryselect/try_presets.yml"], "git_node": "60cb56c693a06dce725bea19c934e8a7d3af776a", "git_parents": ["9b4a8ff7bbf3e2d24e6fff70ef738ff97766569c"], "node": "06a019b1d08eafa8595353fdd51530436ecb231e", "parents": ["ab87ba323c8d92c7a94b02d4dfed82164d01c365"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2092030 - Clean up dom.closewatcher.enabled flag r=dom-core-reviewers,geckoview-reviewers,webidl,devtools-reviewers,layout-reviewers,emilio,nchevobbe,hsivonen,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342102\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-event-breakpoints.js", "devtools/server/actors/utils/event-breakpoints.js", "docshell/test/browser/browser_closewatcher_integration.js", "dom/base/Document.cpp", "dom/base/Document.h", "dom/html/HTMLDialogElement.cpp", "dom/html/HTMLDialogElement.h", "dom/html/nsGenericHTMLElement.cpp", "dom/webidl/CloseWatcher.webidl", "layout/base/PresShell.cpp", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ContentDelegateTest.kt", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/close-watcher/__dir__.ini", "testing/web-platform/meta/close-watcher/iframes/__dir__.ini", "testing/web-platform/meta/html/dom/idlharness.https.html.ini", "testing/web-platform/meta/html/semantics/interactive-elements/the-dialog-element/dialog-closedby-bounds-clicking.html.ini", "testing/web-platform/meta/html/semantics/interactive-elements/the-dialog-element/dialog-closedby-corner-cases.html.ini", "testing/web-platform/meta/html/semantics/interactive-elements/the-dialog-element/dialog-closedby-show-stacked.html.ini", "testing/web-platform/meta/html/semantics/interactive-elements/the-dialog-element/dialog-closedby-start-open.html.ini", "testing/web-platform/meta/html/semantics/interactive-elements/the-dialog-element/dialog-closedby.html.ini", "testing/web-platform/meta/html/semantics/interactive-elements/the-dialog-element/dialog-focusability.html.ini", "testing/web-platform/meta/html/semantics/interactive-elements/the-dialog-element/dialog-popover-closedby-simple.html.ini", "testing/web-platform/meta/html/semantics/interactive-elements/the-dialog-element/dialog-requestclose-3-crash.html.ini"], "git_node": "d93dc67b4313997ef9020f683e005461a7f6ea05", "git_parents": ["60cb56c693a06dce725bea19c934e8a7d3af776a"], "node": "3c0825e865a15e51ec93dfd9a66f08d8b0b19e60", "parents": ["06a019b1d08eafa8595353fdd51530436ecb231e"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075981 - Test that static clones don't upgrade custom elements on static documents. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330179\n", "files": ["testing/web-platform/tests/custom-elements/registries/reference/scoped-registry-static-clone-print-ref.html", "testing/web-platform/tests/custom-elements/registries/scoped-registry-static-clone-print.html"], "git_node": "2b469e093224a654de66a0f865d8a7f8c81fc48d", "git_parents": ["d93dc67b4313997ef9020f683e005461a7f6ea05"], "node": "1671e53a839f79a1fc30268fa85c6f7698979a15", "parents": ["3c0825e865a15e51ec93dfd9a66f08d8b0b19e60"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090914 - Limit index in read_font_descriptor. r=gfx-reviewers,tnikkel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342886\n", "files": ["gfx/webrender_bindings/src/bindings.rs"], "git_node": "2cfdc05495c9c3f3901bd3cd6a5fda2c58f82087", "git_parents": ["2b469e093224a654de66a0f865d8a7f8c81fc48d"], "node": "9a9f53c546daad8f0252c2caa9604b8acd98aed4", "parents": ["1671e53a839f79a1fc30268fa85c6f7698979a15"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092327 - Reset the autocomplete popup's mousedOverIndex when it hides, r=credential-management-reviewers,reusable-components-reviewers,akulyk,mtigley.\n\nOnly the mousemove/mouseout handlers and onSearchBegin reset it, and form fill\nnever calls onSearchBegin, so a reopened popup still reported the row hovered\nthe last time it was open. This broke browser_popup_mouseover.js when run twice\nin the same browser, the reason for its verify-standalone annotation (bug 1995208).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342378\n", "files": ["toolkit/components/satchel/test/browser/browser.toml", "toolkit/content/widgets/autocomplete-popup.js"], "git_node": "9c8fdce380dfb2cf4dc7eac8350c1d1bbf29faf4", "git_parents": ["2cfdc05495c9c3f3901bd3cd6a5fda2c58f82087"], "node": "c28ac2cd733d19f50e94e9000fc7ed94790f22ab", "parents": ["9a9f53c546daad8f0252c2caa9604b8acd98aed4"], "tags": []}, {"author": "celisej567 \u003ccelisej567@gmail.com\u003e", "branch": "default", "desc": "Bug 2060385 - Reflow orthogonal row-spanning table cells once the rows they span are sized. r=layout-reviewers,jfkthame\n\nThe final reflow of orthogonal cell content, added in bug 1961753, used the\nblock-size of the cell's first row, so cells with rowspan \u003e 1 laid out their\ncontent too short and the rows they span didn't grow to fit it. Do that reflow\nfrom the row group after CalculateRowBSizes instead, and keep the cell's desired\nsize so that it still drives the row sizing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341962\n", "files": ["layout/tables/nsTableRowFrame.cpp", "layout/tables/nsTableRowFrame.h", "layout/tables/nsTableRowGroupFrame.cpp", "layout/tables/nsTableRowGroupFrame.h", "testing/web-platform/tests/css/css-writing-modes/orthogonal-cell-rowspan-001.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-cell-rowspan-002.html", "testing/web-platform/tests/css/css-writing-modes/reference/orthogonal-cell-rowspan-001-ref.html", "testing/web-platform/tests/css/css-writing-modes/reference/orthogonal-cell-rowspan-002-ref.html"], "git_node": "b2be7627fa7412f96edc481fa690dcff3e5ee43f", "git_parents": ["9c8fdce380dfb2cf4dc7eac8350c1d1bbf29faf4"], "node": "ee0382e7b087325c38e41be6b261f417d06affe2", "parents": ["c28ac2cd733d19f50e94e9000fc7ed94790f22ab"], "tags": []}, {"author": "celisej567 \u003ccelisej567@gmail.com\u003e", "branch": "default", "desc": "Bug 2060385 - Add a test for orthogonal row-spanning table cells with collapsed borders. r=jfkthame\n\nThe reference uses the same collapsed-border table with non-orthogonal content,\nso it doesn't depend on how the collapsed borders are split between the cell and\nthe table.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342214\n", "files": ["testing/web-platform/tests/css/css-writing-modes/orthogonal-cell-rowspan-003.html", "testing/web-platform/tests/css/css-writing-modes/reference/orthogonal-cell-rowspan-003-ref.html"], "git_node": "6f13629728c5216ac1df9508b3686fb692c94ea0", "git_parents": ["b2be7627fa7412f96edc481fa690dcff3e5ee43f"], "node": "88b4dd4d70df75a55bf33cec240c75f7e7a5430c", "parents": ["ee0382e7b087325c38e41be6b261f417d06affe2"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092561 - Remove the delayed global frame script added by test_bug549682.xhtml, r=dom-core-reviewers,avandolder.\n\nOtherwise it stays registered for the rest of the session, so when the test runs again the dynamically created browser receives two global-sync messages instead of one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342610\n", "files": ["dom/base/test/chrome/file_bug549682.xhtml"], "git_node": "8808bb980c489f2c77177e95038e660cefbefad9", "git_parents": ["6f13629728c5216ac1df9508b3686fb692c94ea0"], "node": "d958e744ceacba329218f6ade6d096cd90649782", "parents": ["88b4dd4d70df75a55bf33cec240c75f7e7a5430c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1870534 - Collect test_clonewrapper.xhtml's document.domain compartments before it runs again, r=dom-core-reviewers,avandolder.\n\nTwo of the frames set document.domain, which marks their compartments, and the\nthird shares a compartment with one of them. A frame created later in the same\nzone reuses a same-origin compartment while it is alive, and two marked\ncompartments get transparent wrappers between each other, so a second run of the\ntest could clone cross-origin. Remove the frames, wait for their windows to be\ndestroyed, and GC at cleanup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342611\n", "files": ["dom/tests/mochitest/chrome/test_clonewrapper.xhtml"], "git_node": "749a7a37529318ad45b34afe5adea2167b9ddabf", "git_parents": ["8808bb980c489f2c77177e95038e660cefbefad9"], "node": "fd34043cfb53c6981d22bb07e709ccf4dad3ff05", "parents": ["d958e744ceacba329218f6ade6d096cd90649782"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087617: Update devtools tests for eval cache changes r=devtools-reviewers,bomsy\" for causing mochitest failures @test_bug732665.xhtml.\n\nThis reverts commit 0a7c83fc1f68e36c4555186c3cf9e79445125d48.\n\nRevert \"Bug 2087617: Update xpconnect tests for eval cache changes r=mgaudet\"\n\nThis reverts commit d789bb6b7fad9edf56b8a90f7aee6c2a748e347a.\n\nRevert \"Bug 2087617: Limit eval caching for non-syntactic scopes r=mgaudet\"\n\nThis reverts commit 7e42543463dae571b64e588d0843021f9b2d6347.\n\nRevert \"Bug 2087617: Speed up hashing for long eval strings r=mgaudet\"\n\nThis reverts commit 7c62e7813e68540ac838878097deeb43cb94920c.\n\nRevert \"Bug 2087617: Cache indirect and top-level evals r=mgaudet\"\n\nThis reverts commit d6508e8617277aa654966bdcca350833d3cbb564.\n\nRevert \"Bug 2087617: Hoist EvalType into Caches.h as an enum class r=mgaudet\"\n\nThis reverts commit bd95670a0ebb9d59665b4ce781d8abccb14b1897.\n\nRevert \"Bug 2087617: Put eval scripts in the cache immediately r=mgaudet\"\n\nThis reverts commit e7229e8f8b287061eb23cda97eaedd594bc95df8.\n\nRevert \"Bug 2087617: Allow caching evals containing inner objects r=mgaudet\"\n\nThis reverts commit b8db280dd433022964f0cabe100117881a99e61a.\n", "files": ["devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/v1/test-functions.js", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-uncompressed/v1/test-functions.js", "devtools/client/debugger/test/mochitest/integration/browser_dbg-features-tabs.js", "js/src/builtin/Eval.cpp", "js/src/frontend/BytecodeCompiler.cpp", "js/src/frontend/BytecodeCompiler.h", "js/src/jit-test/lib/debuggerNXHelper.js", "js/src/jit-test/tests/basic/eval-cache-hash.js", "js/src/jit-test/tests/basic/eval-cache-indirect.js", "js/src/jit-test/tests/basic/eval-object-identity.js", "js/src/jit-test/tests/basic/eval-reentrant.js", "js/src/jit-test/tests/basic/eval-throws.js", "js/src/jit-test/tests/debug/Script-gc-01.js", "js/src/vm/Caches.h", "js/src/vm/JSScript.h", "js/xpconnect/tests/chrome/test_bug732665.xhtml", "js/xpconnect/tests/chrome/test_bug732665_meta.js"], "git_node": "b80d520f2cc7304c7ac5247be69c4a72f93e60af", "git_parents": ["749a7a37529318ad45b34afe5adea2167b9ddabf"], "node": "870648237e5628befb8cb1c5e4593b65ca893942", "parents": ["fd34043cfb53c6981d22bb07e709ccf4dad3ff05"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 1887284 - Clear the autofill placeholder when entering search mode r=urlbar-reviewers,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342159\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-editing/browser_ime_composition.js"], "git_node": "c9b2735c3171bf1a595fdefac69140b202d70ffc", "git_parents": ["b80d520f2cc7304c7ac5247be69c4a72f93e60af"], "node": "87bf2d5bd9a69fbaf0fa4f7f5a0ace2c1c110172", "parents": ["870648237e5628befb8cb1c5e4593b65ca893942"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2092515 - Add a mold toolchain. r=firefox-build-system-reviewers,taskgraph-reviewers,sergesanspaille,ahochheiden,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342543\n", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/kind.yml", "taskcluster/kinds/toolchain/mold.yml", "taskcluster/scripts/misc/build-mold.sh", "taskcluster/scripts/misc/mold-icf-symtab.patch"], "git_node": "b4deb7a09e3a63a2ef34ad12fadb7a3e6869e6f2", "git_parents": ["c9b2735c3171bf1a595fdefac69140b202d70ffc"], "node": "e8ab249a27b06d07c0ca16f9fbcd3bfda6a39b5a", "parents": ["87bf2d5bd9a69fbaf0fa4f7f5a0ace2c1c110172"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": 