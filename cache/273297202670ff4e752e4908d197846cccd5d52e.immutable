ponents/components/feature/pictureinpicture/src/test/java/mozilla/components/feature/pictureinpicture/PictureInPictureMiddlewareTest.kt", "mobile/android/android-components/components/feature/pictureinpicture/src/test/java/mozilla/components/feature/pictureinpicture/PictureInPictureSessionFeatureTest.kt", "mobile/android/android-components/components/feature/pictureinpicture/src/test/java/mozilla/components/feature/pictureinpicture/PictureInPictureWindowFeatureTest.kt", "mobile/android/android-components/components/feature/pictureinpicture/src/test/resources/robolectric.properties", "mobile/android/fenix/.buildconfig.yml", "mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/src/main/AndroidManifest.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/UseCases.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pictureinpicture/PictureInPictureActivity.kt"], "git_node": "a5cc9d480c68da0e0fcda14963ed2a9bfebba1ba", "git_parents": ["3bd93ef81937de7f3deb87ad7640ff4ce9e62eed"], "node": "176377c53a0fdffc18f7302a6f457ca5a448d913", "parents": ["84813bf09aa63ef3db6e05bce3edc7777a139ccd"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090245 - Return to the tab a video came from on expanding its picture-in-picture window in Fenix. r=android-reviewers,android-build-system-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340485\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/notification/MediaNotification.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/service/AbstractMediaSessionService.kt", "mobile/android/android-components/components/feature/pictureinpicture/build.gradle", "mobile/android/android-components/components/feature/pictureinpicture/src/main/java/mozilla/components/feature/pictureinpicture/AbstractPictureInPictureActivity.kt", "mobile/android/android-components/components/feature/pictureinpicture/src/main/java/mozilla/components/feature/pictureinpicture/PictureInPictureSessionFeature.kt", "mobile/android/android-components/components/feature/pictureinpicture/src/test/java/mozilla/components/feature/pictureinpicture/PictureInPictureSessionFeatureTest.kt", "mobile/android/android-components/components/feature/pictureinpicture/src/test/java/mozilla/components/feature/pictureinpicture/PictureInPictureWindowFeatureTest.kt", "mobile/android/android-components/components/support/utils/src/main/java/mozilla/components/support/utils/SwitchTabIntent.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/listentopage/ListenToPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/intent/OpenSpecificTabIntentProcessor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pictureinpicture/PictureInPictureActivity.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/intent/OpenSpecificTabIntentProcessorTest.kt"], "git_node": "56a72dca7925a958d72d7299a18dc3f54424ec9f", "git_parents": ["a5cc9d480c68da0e0fcda14963ed2a9bfebba1ba"], "node": "dde40773f5e3f102f885129081a24d7033e1535f", "parents": ["176377c53a0fdffc18f7302a6f457ca5a448d913"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090246 - Add a secret setting for the picture-in-picture window in Fenix. r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341199\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "202d89d94556e4976d3a37b20fc9dae7e44beb90", "git_parents": ["56a72dca7925a958d72d7299a18dc3f54424ec9f"], "node": "bc9e86db6f619127db4dd02209510f28e4c42062", "parents": ["dde40773f5e3f102f885129081a24d7033e1535f"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060527 - Add a toolbar button moving the video the current page is playing into a picture-in-picture window. r=android-reviewers,android-l10n-reviewers,parker,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341200\n", "files": ["mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_picture_in_picture_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_picture_in_picture_close_24.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserToolbarStoreBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddlewareTest.kt"], "git_node": "4853f408744169ed9d031b41e75c091d59590eb5", "git_parents": ["202d89d94556e4976d3a37b20fc9dae7e44beb90"], "node": "abbc80fe1fdc91054a0946eae550bbe689a3230e", "parents": ["bc9e86db6f619127db4dd02209510f28e4c42062"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Update the grammar comments of the CSP source expression parser to the Editor's Draft; r=tschuster\n\nThe grammar comments of the nsCSPParser methods which parse source expressions\nstill use the productions and links of CSP 1.1 and 2. Update them to the source\nlist grammar of the Editor's Draft, and note what the parser doesn't support: a\ntrailing \".\" in host-part and some keyword-sources.\n\nComment-only change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341367\n", "files": ["dom/security/nsCSPParser.cpp"], "git_node": "b6946c599caf3acfc9e60bf0668976b2f8893105", "git_parents": ["4853f408744169ed9d031b41e75c091d59590eb5"], "node": "04b6c64c880afb8d7f6500705d20631d43c67bd1", "parents": ["abbc80fe1fdc91054a0946eae550bbe689a3230e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2029980 - Add a repeat manifest condition for mochitests running with --repeat, r=ahal,mozbase-reviewers.\n\nIt stays false in --verify mode, which sets --repeat for its own steps. Other\n--repeat users, like --run-until-failure and confirm-failures, skip tests that\ncannot run twice.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341595\n", "files": ["docs/code-quality/lint/linters/test-manifest-toml.md", "testing/mochitest/runtests.py", "testing/mozbase/manifestparser/manifestparser/token.py"], "git_node": "68dbd9dc0cdd30731ab62984178d5b77ecc1611c", "git_parents": ["b6946c599caf3acfc9e60bf0668976b2f8893105"], "node": "95831d6f7939b000af75045d4d140121a945f2c2", "parents": ["04b6c64c880afb8d7f6500705d20631d43c67bd1"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2029980 - Make --repeat run each mochitest again right after itself, r=ahal.\n\nPlain, chrome and a11y tests looped over the whole test list instead, and\nbrowser-chrome ran the first test of each browser session one time short.\nTestRunner.js now reruns each test before moving to the next one, so the code\nrestarting the whole list goes away. Adjacent tests that hand state to each\nother now fail under --repeat. This also affects test-verify, which runs with\n--repeat.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341596\n", "files": ["testing/mochitest/browser-test.js", "testing/mochitest/tests/SimpleTest/TestRunner.js", "testing/mochitest/tests/python/test_mochitest_integration.py"], "git_node": "c2f94bd0ce8226e011506b26a2334c0b2d586768", "git_parents": ["68dbd9dc0cdd30731ab62984178d5b77ecc1611c"], "node": "316d2397e4c03d1b8d957085ac52a49b09409840", "parents": ["95831d6f7939b000af75045d4d140121a945f2c2"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2029980 - Make Harness_sanity's service worker tests pass with --repeat, r=ahal.\n\ntest_sanityRegisteredServiceWorker.html failed when run again right after\nitself: registering over its own leftover registration does not notify\nSpecialPowers, so the end-of-test check saw no worker.\ntest_sanityRegisteredServiceWorker2.html unregisters that leftover worker,\nso it can only pass once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341597\n", "files": ["testing/mochitest/tests/Harness_sanity/mochitest.toml", "testing/mochitest/tests/Harness_sanity/test_sanityRegisteredServiceWorker.html"], "git_node": "2f626aa6eebdf3c254ce2a3622f7ebc623972534", "git_parents": ["c2f94bd0ce8226e011506b26a2334c0b2d586768"], "node": "0c48e4f16a10cd5ada6afba2771c9dc129930c84", "parents": ["316d2397e4c03d1b8d957085ac52a49b09409840"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2029980 - Align the mochitest default-chunks with the chunk counts dynamic chunking currently picks, r=taskgraph-reviewers,ahal.\n\nJobs without runtime data, such as the new repeat variant or a renamed\nplatform, fall back to default-chunks, which were as low as half the dynamic\ncounts and did not fit in max-run-time. This also lowers a few that were above\nthe dynamic counts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341599\n", "files": ["taskcluster/kinds/mochitest/kind.yml"], "git_node": "8d64d136e947420ea2d6086f4a487120807df1cf", "git_parents": ["2f626aa6eebdf3c254ce2a3622f7ebc623972534"], "node": "875c98e49e44452c8acc70b8f0293a414564d0d2", "parents": ["0c48e4f16a10cd5ada6afba2771c9dc129930c84"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2029980 - Add mochitest repeat tasks that run each test twice in a row, without scheduling them yet, r=taskgraph-reviewers,ahal.\n\nThey catch tests that leave state behind for the next test. mochitest-chrome\nnormally runs with e10s disabled, so its variant is combined with 1proc.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292383\n", "files": ["taskcluster/config.yml", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/test_configs/variants.yml", "tools/tryselect/try_presets.yml"], "git_node": "3154dedd964a5d890c422bda3ef30e1fc6b8d9b0", "git_parents": ["8d64d136e947420ea2d6086f4a487120807df1cf"], "node": "d2183438493283e6d5159406a082ae89189f6b04", "parents": ["875c98e49e44452c8acc70b8f0293a414564d0d2"], "tags": []}, {"author": "Kartikaya Gupta \u003ckgupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092665 - Simplify some code; no functional changes r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342753\n", "files": ["servo/components/style/parallel.rs"], "git_node": "7b01fd43589feb9ef0edf8c8e5f360fecb26627a", "git_parents": ["3154dedd964a5d890c422bda3ef30e1fc6b8d9b0"], "node": "57b20c5001fbf3b204eb796e5834cd1b6202fd94", "parents": ["d2183438493283e6d5159406a082ae89189f6b04"], "tags": []}, {"author": "Kartikaya Gupta \u003ckgupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092665 - fix typo in comment r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342754\n", "files": ["servo/components/style/traversal.rs"], "git_node": "2efe0f6274e74229cc1d21dfc0964606e3cb0a53", "git_parents": ["7b01fd43589feb9ef0edf8c8e5f360fecb26627a"], "node": "67a7006469734b6097aac1b8de7474f83a2e6616", "parents": ["57b20c5001fbf3b204eb796e5834cd1b6202fd94"], "tags": []}, {"author": "Kartikaya Gupta \u003ckgupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092665 - update stale comment r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342755\n", "files": ["servo/components/style/traversal.rs"], "git_node": "56311f8869e21c214a75736850fb6dd7cbf4d0aa", "git_parents": ["2efe0f6274e74229cc1d21dfc0964606e3cb0a53"], "node": "aeb35dc84b73142e3a92e606eed0d528e81e4cbf", "parents": ["67a7006469734b6097aac1b8de7474f83a2e6616"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092691 - Blit fenced MacIOSurfaces only when waiting on the write fence succeeds. r=gfx-reviewers,jnicol\n\nThe negation was lost in bug 2068875, so the blit bailed out whenever\nGpuFence::ServerWait succeeded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342765\n", "files": ["gfx/gl/GLBlitHelper.cpp"], "git_node": "df88730d2078b7b069b383b0a9fe26d42bd070ad", "git_parents": ["56311f8869e21c214a75736850fb6dd7cbf4d0aa"], "node": "fd84ddf5f685e0e3724a6a075406c75b8e9d38fb", "parents": ["aeb35dc84b73142e3a92e606eed0d528e81e4cbf"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2091728 - Remove kStrokeLogicalScale. r=lsalzman\n\nSince some drivers don't apply it properly. This means we don't get\nsubpixel stroke widths but that matches Cairo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342560\n", "files": ["gfx/skia/gdi/SkGDIDocument.cpp"], "git_node": "75405ebe26b7cacddadee89b271010dc743b1c2d", "git_parents": ["df88730d2078b7b069b383b0a9fe26d42bd070ad"], "node": "3bb7da6b25849fcbd5b5137d7bfde68aeb6e161f", "parents": ["fd84ddf5f685e0e3724a6a075406c75b8e9d38fb"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087948 - Fit long translated messages on the Privacy widget. r=ini\n\nSome French, German and Greek text crowded or got cut off in the large Privacy widget. The button now stays on one line, with the count moved up by --space-medium to make room. Long buttons extend left instead of past the card\u2019s edge. At medium size, the message and divider are hidden, and the count and button are centered vertically, matching the blank card in the mockup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341619\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Privacy/_Privacy.scss"], "git_node": "d7655074057fdeeb25108c4bfb4d710006bed168", "git_parents": ["75405ebe26b7cacddadee89b271010dc743b1c2d"], "node": "f95b92da3aa12975ff4fe6c80c5fe1e1b87b1e96", "parents": ["3bb7da6b25849fcbd5b5137d7bfde68aeb6e161f"], "tags": []}, {"author": "Seva Alipov \u003csalipov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069118 Part 1: Fix intermittence in line-clamp-auto-041.html. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342813\n", "files": ["testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-041.html.ini", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-auto-041.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-auto-041-ref.html"], "git_node": "af5f1252970b882d226a65b1a14dc1f0a5866cdb", "git_parents": ["d7655074057fdeeb25108c4bfb4d710006bed168"], "node": "29d9e83317af51dc7ccc3b781433a99207bfb926", "parents": ["f95b92da3aa12975ff4fe6c80c5fe1e1b87b1e96"], "tags": []}, {"author": "Seva Alipov \u003csalipov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069118 Part 2: Clean up web-platform test expectations for line-clamp and mark the fuzzy tests. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342796\n", "files": ["testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-002.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-003.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-004.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-007.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-009.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-010.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-022.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-023.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-024.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-026.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-031.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-034.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-037.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-038.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-bidi-001.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-repaint-001.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-repaint-002.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-repaint-004.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-001.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-004.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-005.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-006.html.ini", "testi