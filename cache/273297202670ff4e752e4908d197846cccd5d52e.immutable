files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "f9e0372e5b6ba24b0b3af3b96648be143b269539", "git_parents": ["618c5cd2da40dd7c14c8ae15e61af26098d02c05"], "node": "d78bbcadac531f2da084205041138af0e97bc80f", "parents": ["235448542a683d94fada5e991179d169f5dafab3"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2091066 - Use the Kit illustration as the Firefox source docs logo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341031\n", "files": ["docs/_static/custom_theme.css", "docs/conf.py"], "git_node": "a370895cb89bcd820e1a73c4b182eaae65c1a405", "git_parents": ["f9e0372e5b6ba24b0b3af3b96648be143b269539"], "node": "22b83a197f78f900e6f88e99ef400b7e954a7279", "parents": ["d78bbcadac531f2da084205041138af0e97bc80f"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2091067 - Add a welcome paragraph to the Firefox source docs front page. r=firefox-source-docs-reviewers,marco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341032\n", "files": ["docs/index.md"], "git_node": "d9833cb92a672f311811003b5e4b45417ee22b15", "git_parents": ["a370895cb89bcd820e1a73c4b182eaae65c1a405"], "node": "90d594709a1a13772f5903193336240282ab81b4", "parents": ["22b83a197f78f900e6f88e99ef400b7e954a7279"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2090808 - Stop firing unnecessary events to show a context menu r=urlbar-reviewers,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341300\n", "files": ["browser/components/urlbar/tests/browser-results/browser_result_menu.js"], "git_node": "6a03dda3b58d7f017dcf75a9c76c1070653ea88b", "git_parents": ["d9833cb92a672f311811003b5e4b45417ee22b15"], "node": "1ce9224190af9ba04bce5abeda204f5dfaf37e14", "parents": ["90d594709a1a13772f5903193336240282ab81b4"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2088759 - Remove the unused icon space from the urlbar result menu items r=desktop-theme-reviewers,reusable-components-reviewers,urlbar-reviewers,tgiles,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339432\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "toolkit/content/tests/widgets/chrome.toml", "toolkit/content/tests/widgets/test_panel_item_no_icon.html", "toolkit/content/widgets/panel-list/README.stories.md", "toolkit/content/widgets/panel-list/panel-item.css"], "git_node": "66b989daef605697d6726b8b2e176a850ccd77a2", "git_parents": ["6a03dda3b58d7f017dcf75a9c76c1070653ea88b"], "node": "7563de92e2976bb5702f3b7f0333c660d9647176", "parents": ["1ce9224190af9ba04bce5abeda204f5dfaf37e14"], "tags": []}, {"author": "Javier Fern\u00e1ndez Garc\u00eda-Boente \u003cjfernandez@igalia.com\u003e", "branch": "default", "desc": "Bug 2061233 - Add Bounce Tracking Protection service worker purge test r=dom-worker-reviewers,edenchuang,emz\n\nAdds a browser-chrome test verifying that a Bounce Tracking Protection\n(BTP) purge removes a bounce tracker's service worker registration and\nCache API storage, while leaving a non-tracker origin (both its\nregistration and its stored bytes) intact.\n\nBTP purges site data via nsIClearDataService with\nCLEAR_STATE_FOR_TRACKER_PURGING, which includes CLEAR_DOM_QUOTA; the\nexisting BTP xpcshell tests cover cookies and IndexedDB but not service\nworkers. The tests seed bounce-tracker candidates deterministically via\nthe nsIBounceTrackingProtection test hooks and force a purge, so they\nneed no navigation dance.\n\nTwo cases are covered:\n- A classified bounce tracker's service worker and Cache are purged,\n  while a non-tracker origin is preserved.\n- An origin that is a bounce-tracker candidate but has received user\n  activation is spared, since recording user activation removes it from\n  the candidate map.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335509\n", "files": ["dom/serviceworkers/test/browser-common.toml", "dom/serviceworkers/test/browser_bounceTrackingProtection_serviceWorkers.js"], "git_node": "a9b7100d9aa98d3900fe1e536f9b3189c72308de", "git_parents": ["66b989daef605697d6726b8b2e176a850ccd77a2"], "node": "472b1074e523a2d89f7303b72592f5d3653255f2", "parents": ["7563de92e2976bb5702f3b7f0333c660d9647176"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068050 - Use --text-color-deemphasized in sign-in promo secondary text r=desktop-theme-reviewers,akulyk,Itiel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341075\n", "files": ["browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "a4c23cc4ea76dab5c4f49717d6b9b1bbee0a9e46", "git_parents": ["a9b7100d9aa98d3900fe1e536f9b3189c72308de"], "node": "d92eccffbab9dbbaf77d5db50ce3b13a5d47bc12", "parents": ["472b1074e523a2d89f7303b72592f5d3653255f2"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087545 - Keep the Windows profiler sampler on the system timer tick with notimerresolutionchange. r=profiler-reviewers,mstange\n\nWith the high-resolution waitable timer, notimerresolutionchange no\nlonger limited sampling to the system timer tick. The power profiler\nused by the raptor Windows power measurements runs with this feature\nand the default 1ms interval, so it now woke up about every\nmillisecond instead of on the tick, keeping the CPU out of deep idle\nstates during the measurement.\n\nWhen the feature is set, don't create the high-resolution timer, so\nthat sampling sleeps on the system tick as before. Also update the\nfeature descriptions to say what the feature now does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338736\n", "files": ["devtools/client/performance-new/shared/utils.js", "mozglue/baseprofiler/core/platform-win32.cpp", "mozglue/baseprofiler/public/BaseProfilerState.h", "tools/profiler/core/platform-win32.cpp", "tools/profiler/public/ProfilerState.h"], "git_node": "56b062d84c3ebebc79c65ab0fbf294741743c4c6", "git_parents": ["a4c23cc4ea76dab5c4f49717d6b9b1bbee0a9e46"], "node": "7a00e8d344721223d11b67dbdedc72d67474153c", "parents": ["d92eccffbab9dbbaf77d5db50ce3b13a5d47bc12"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087545 - Rename the notimerresolutionchange profiler feature to winsystemticksampling. r=profiler-reviewers,extension-reviewers,rpl,mstange,perftest-reviewers,canova,sparky\n\nThe feature now pins the Windows sampler to the system timer tick,\nwhich coarsens the profiler's own timer, so \"no timer resolution\nchange\" no longer describes it.\n\nThe raptor Windows power profiling, the only in-tree user, switches to\nthe new name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338737\n", "files": ["devtools/client/performance-new/shared/utils.js", "mozglue/baseprofiler/core/platform-win32.cpp", "mozglue/baseprofiler/core/platform.cpp", "mozglue/baseprofiler/public/BaseProfilerState.h", "testing/raptor/browsertime/utils/profiling.js", "toolkit/components/extensions/schemas/geckoProfiler.json", "tools/profiler/core/platform-win32.cpp", "tools/profiler/core/platform.cpp", "tools/profiler/public/ProfilerState.h"], "git_node": "db83dc64c0e98758f233be680bd85a169c8d5ceb", "git_parents": ["56b062d84c3ebebc79c65ab0fbf294741743c4c6"], "node": "9875b0aa24c9fc20283f1697a0121791c9793a25", "parents": ["7a00e8d344721223d11b67dbdedc72d67474153c"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091042 - Drive by comment correction r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341000\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "212b7b4e4150c9114e3a3e1c862d7e878805869a", "git_parents": ["db83dc64c0e98758f233be680bd85a169c8d5ceb"], "node": "aa3ed985d7351e1e783f8ed1561ae33586078698", "parents": ["9875b0aa24c9fc20283f1697a0121791c9793a25"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091042 - Name specialized promise reaction state consistently. r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341001\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "2bccd2a9eadb4c42b956f0b89d06913eefb6359e", "git_parents": ["212b7b4e4150c9114e3a3e1c862d7e878805869a"], "node": "dd56e494f1a1ce563abec832da14fdbe63f822e6", "parents": ["aa3ed985d7351e1e783f8ed1561ae33586078698"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091042 - Extract promise settlement from reaction dispatch. r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341002\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "e49a1f03916d9df97c2fbb952d1104be5ed06e0d", "git_parents": ["2bccd2a9eadb4c42b956f0b89d06913eefb6359e"], "node": "ef62ef68f88f8f03cb0292fb8ab6b1601c4660fa", "parents": ["dd56e494f1a1ce563abec832da14fdbe63f822e6"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091042 - Share stack-based promise reaction initialization. r=spidermonkey-reviewers,jonco\n\nInitialize pending and settled reactions on the stack before choosing\ntheir representation. Pending reactions now collect host data and apply\nextraStep before allocating their reaction record.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341003\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "ca565200c4952477c0b63536eb1e6671155b8708", "git_parents": ["e49a1f03916d9df97c2fbb952d1104be5ed06e0d"], "node": "00409eddcd7d68d8386f8c0ca7783c2e5409c2bf", "parents": ["ef62ef68f88f8f03cb0292fb8ab6b1601c4660fa"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091042 - Embed the first reaction in a pending promise. r=spidermonkey-reviewers,jonco\n\nMost pending promises only ever get one reaction, so instead of allocating a\nPromiseReactionRecord for it, store it in two new reserved slots of the\npromise (plus REACTIONS_OR_RESULT_SLOT and the promise flags) when its fields\nfit. At settlement, enqueue it inline if eligible, otherwise inflate it into\na reaction record. Code that needs the reaction list representation (a second\nreaction, the debugger) first moves it into a reaction record.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341004\n", "files": ["js/src/builtin/Promise.cpp", "js/src/builtin/TestingFunctions.cpp", "js/src/jit-test/tests/debug/Object-getPromiseReactions-embedded.js", "js/src/jit-test/tests/promise/pending-reaction-embedded.js", "js/src/vm/PromiseObject.h"], "git_node": "0ba1421206febc5847758636f4113a6a99f1c919", "git_parents": ["ca565200c4952477c0b63536eb1e6671155b8708"], "node": "215c68ded9dcae5c7bee6194ddb2e34cc5d5db86", "parents": ["00409eddcd7d68d8386f8c0ca7783c2e5409c2bf"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2091042: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "cef0d8aa0c3282c8eb4d01848016a24c9fada355", "git_parents": ["0ba1421206febc5847758636f4113a6a99f1c919"], "node": "4e0406852cf019fc803a9599cacc7967d1a8c253", "parents": ["215c68ded9dcae5c7bee6194ddb2e34cc5d5db86"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091371 - Return null instead of 0L from getApplicationInstalledTime when the application install time is unavailable. r=sfamisa\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/441\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/GetApplicationInstalledTime.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/GetApplicationInstalledTimeTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt"], "git_node": "42df48926329d4c295d06492915b13f30647912a", "git_parents": ["cef0d8aa0c3282c8eb4d01848016a24c9fada355"], "node": "46ecbc6d0c9306d52463d3bbd0326c0a2e5f603c", "parents": ["4e0406852cf019fc803a9599cacc7967d1a8c253"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1997669 - Update stale source links in the browsertime docs. r=perftest-reviewers,sparky\n\nSeveral links still pointed at taskcluster/ci and .ini manifests that have\nsince moved or been converted to TOML. Unpin all searchfox links in the file\nso they follow tip instead of going stale again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339653\n", "files": ["testing/perfdocs/generated/browsertime.md", "testing/raptor/raptor/perfdocs/browsertime.md"], "git_node": "694b432d722aa2aa8f84489a8fc0970437b84c82", "git_parents": ["42df48926329d4c295d06492915b13f30647912a"], "node": "dda988155c0c45de83ae6cf6d0d3ffa0f1a896d1", "parents": ["46ecbc6d0c9306d52463d3bbd0326c0a2e5f603c"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085640 - Don't let head CSS/JS loads block fetch(), like XHR. r=necko-reviewers,jesup\" for causing xpc failures @test_ext_dnr_modifyHeaders.js.\n\nThis reverts commit 31e2a396db035adab3d70b464a4b0ea9f4d4583b.\n", "files": ["dom/fetch/FetchDriver.cpp", "testing/web-platform/meta/css/css-view-transitions/navigation/mismatched-snapshot-containing-block-size-skips.html.ini"], "git_node": "5ac761c0408666a0363fed40e6eac23bc9f98766", "git_parents": ["694b432d722aa2aa8f84489a8fc0970437b84c82"], "node": "ccbb3340e682e23b825e8b87cd72e8deaf4d1003", "parents": ["dda988155c0c45de83ae6cf6d0d3ffa0f1a896d1"], "tags": []}, {"author": "Ben Dean-Kawamura \u003cbdk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088525 - vendor app-services a69bdee5ad, r=janerik\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341112\n", "files": ["Cargo.lock", "docs/rust-components/api/js/init_rust_components.md", "docs/rust-components/api/js/interrupt_support.md", "third_party/application-services/.buildconfig-android.yml", "third_party/application-services/build-scripts/component-common.gradle", "third_party/application-services/components/context_id/android/build.gradle", "third_party/application-services/components/context_id/android/proguard-rules.pro", "third_party/application-services/components/context_id/android/src/main/AndroidManifest.xml", "third_party/application-services/components/context_id/uniffi.toml", "third_party/application-services/components/init_rust_components/src/lib.rs", "third_party/application-services/components/nimbus/android/src/main/java/org/mozilla/experiments/nimbus/NimbusHelpers.kt", "third_party/application-services/components/remote_settings/src/client.rs", "third_party/application-services/components/remote_settings/src/error.rs", "third_party/application-services/components/remote_settings/src/service.rs", "third_party/application-services/components/remote_settings/src/telemetry.rs", "third_party/application-services/components/support/interrupt/src/lib.rs", "third_party/application-services/components/support/interrupt/uniffi.toml", "third_party/application-services/docs/building.md", "third_party/application-services/libs/verify-android-ci-environment.sh", "third_party/application-services/megazords/full/Cargo.toml", "third_party/application-services/megazords/full/android/build.gradle", "third_party/application-services/moz.yaml", "third_party/application-services/testing/sync-test/src/logins.rs", "toolkit/components/uniffi-bindgen-gecko-js/android/components/init_rust_components/android/src/main/java/mozilla/appservices/init_rust_components/init_rust_components.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/remotesettings/android/src/main/java/mozilla/appservices/remotesettings/remote_settings.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAdsClient.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAutofill.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustBreachAlerts.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustContextId.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustDbCrypto.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFilterAdult.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFxcontainers.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustInitRustComponents.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustInterruptSupport.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTracing.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/config.toml", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "332fa327c7f91e31ac5e10def9600bfa7df41e1c", "git_parents": ["5ac761c0408666a0363fed40e6eac23bc9f98766"], "node": "4566e83f913f78c797d50f0065f113eaccbb49d9", "parents": ["ccbb3340e682e23b825e8b87cd72e8deaf4d1003"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068014 - Implement the cumulative CORS safelisted value size limit r=necko-reviewers,kershaw\n\nIncluding in XHR\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323668\n", "files": ["dom/fetch/InternalHeaders.cpp", "dom/xhr/XMLHttpRequestMainThread.cpp"], "git_node": "86cfd4868481413aae8c776e43604099df74e19e", "git_parents": ["332fa327c7f91e31ac5e10def9600bfa7df41e1c"], "node": "4c7ad2d523e123443b67b6ac1b8d6c0cb09f7dbb", "parents": ["4566e83f913f78c797d50f0065f113eaccbb49d9"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068014 - Add WPT coverage for the cumulative CORS safelisted value size limit r=necko-reviewers,kershaw\n\nThe entries have to reach fetch() as a sequence. A Headers object is\nconverted through its iterator, which combines duplicate names, so building\none up front would not exercise this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323670\n", "files": ["testing/web-platform/tests/fetch/api/cors/cors-preflight-safelist-value-size.any.js"], "git_node": "fac17ed08caf8ee3c48ced79cf7eb14c9007ac7d", "git_parents": ["86cfd4868481413aae8c776e43604099df74e19e"], "node": "0974fc33d087e68ba9efa4310ed102dc8dbda908", "parents": ["4c7ad2d523e123443b67b6ac1b8d6c0cb09f7dbb"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061626 - Fix incorrect TCPSocket.readyState during connect r=necko-reviewers,valentin\n\nTwo correctness issues:\n- readyState stayed \"closed\" instead of \"connecting\" while the proxy\n  lookup for a new connection was in flight, because ResolveProxy() left\n  mReadyState at its constructor default until the async lookup completed.\n- With useSecureTransport, readyState jumped to \"open\" (and the \"open\"\n  event fired) as soon as the TCP handshake completed, even though the TLS\n  handshake was still in progress. An open TCP session before TLS is\n  established can happen with a misbehaving middlebox or server, so this\n  is the more severe of the two.\n\nSet mReadyState at the start of ResolveProxy(), and for secure sockets\ndefer the transition to \"open\" from STATUS_CONNECTED_TO to\nHandshakeDone(), reported via nsITlsHandshakeCallbackListener.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323727\n", "files": ["dom/network/TCPSocket.cpp", "dom/network/TCPSocket.h", "dom/network/tests/chrome.toml", "dom/network/tests/test_tcpsocket_readystate.html"], "git_node": "6f30a21684708f046b7f81d74750cffb0acc5677", "git_parents": ["fac17ed08caf8ee3c48ced79cf7eb14c9007ac7d"], "node": "2de87883428749137a9d656cd2cb8b5706e08404", "parents": ["0974fc33d087e68ba9efa4310ed102dc8dbda908"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1807814 - Replace dxr.mozilla.org links in the Talos docs with Searchfox links. r=perftest-reviewers,sparky\n\nConvert the dxr.mozilla.org and raw searchfox.org links in the Talos docs to\nthe {searchfox} role with unpinned paths, so they follow tip instead of\ndrifting. Links to the removed xperf.config now point at test.py, and the\ntresize-test.html link points at its current location.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339654\n", "files": ["testing/perfdocs/generated/talos.md", "testing/talos/perfdocs/config.yml", "testing/talos/perfdocs/index.md"], "git_node": "8eaae0b2d2ef592b3e144eb100136f295e3f2063", "git_parents": ["6f30a21684708f046b7f81d74750cffb0acc5677"], "node": "b12ee4a2e8b0488f250a5394fccca123954db776", "parents": ["2de87883428749137a9d656cd2cb8b5706e08404"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2026722 - \"Not Secure\" shown in address bar when starting Firefox with a URL as an argument. r=daleharvey,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341299\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser/browser.toml", "browser/components/urlbar/tests/browser/browser_pendingLoadProxyState.js"], "git_node": "5d45f3e29ea97028031d29a53666028d6305bf93", "git_parents": ["8eaae0b2d2ef592b3e144eb100136f295e3f2063"], "node": "d1c93b38d715dd337b70fecfcf69312586f8b5e5", "parents": ["b12ee4a2e8b0488f250a5394fccca123954db776"], "tags": []}], "date": 1794328467, "git_changesets": ["d266642e7aae9fa7769422c11b1c112d6897ee57", "36d649b8b34b554355816022aa426e68e3eceb55", "bc08cb5e981f90eba183ef79f1160f4a9fee9c86", "ec0da9fee4c4958553f1daa1f67c3806d61743d5", "521a9a00ef5e8d5b91773591a2536df68886bf5e", "88f3f904f443aa089def2e750cd353bf05f98b03", "cd8b1382296cc6a982d98f61c23e3383fe43550b", "be9d4004d24a19c9f2f4a0faa451948f60ff0f4e", "512783c8f57785ac4ff358aae8cf92b24faa6db3", "a67243c903e5c609940691550c8a599b7e9f92f1", "9f49fb07ad173989204f47c5bfaeb797fd275beb", "56e2225f44a740583ba129f0276d015d1c967e7b", "478f8d4e1e218df776f00cec3e3fedea02dfb36d", "f7a53531dd4f25594cb6c776b047977a6f9434dc", "841f57672821e27fb522ddeb0cf550c3c6488964", "d8704ac5d60cc73d3c95e81213dcfb6ebcb73237", "54228742ddc348a020296b6623722de4ac6b4adb", "98927e7fcc6f4c6097f5085a4a37da0b2c2781e7", "2ee16ed9b00fdc3bacc11e9b09fbc7df56628eb2", "637ac5