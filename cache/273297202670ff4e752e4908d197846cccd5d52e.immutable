s/aiwindow/ui/content/assets/loader.svg", "browser/components/aiwindow/ui/content/assets/memories-off.svg", "browser/components/aiwindow/ui/content/assets/memories-on.svg", "browser/components/aiwindow/ui/content/assets/model-choice-0.svg", "browser/components/aiwindow/ui/content/assets/model-choice-auto.svg", "browser/components/aiwindow/ui/content/assets/model-choice-gemini.svg", "browser/components/aiwindow/ui/content/assets/model-choice-mistral.svg", "browser/components/aiwindow/ui/content/assets/model-choice-qwen.svg", "browser/components/aiwindow/ui/content/assets/new-chat.svg", "browser/components/aiwindow/ui/content/assets/set-default-onboarding.svg", "browser/components/aiwindow/ui/content/assets/smart-page-16.svg", "browser/components/aiwindow/ui/content/assets/smart-window-promo-default.svg", "browser/components/aiwindow/ui/content/assets/smart-window.svg", "browser/components/aiwindow/ui/content/assets/stop-generation.svg", "browser/components/aiwindow/ui/content/assets/warning.svg", "browser/components/aiwindow/ui/content/modules/AITabUtils.mjs", "browser/components/aiwindow/ui/content/modules/AgentCommands.mjs", "browser/components/aiwindow/ui/content/modules/ChatMarkdownParser.mjs", "browser/components/aiwindow/ui/content/modules/ClientErrorTelemetry.mjs", "browser/components/aiwindow/ui/content/modules/ModelIcons.mjs", "browser/components/aiwindow/ui/content/modules/SmartFormFillConstants.mjs", "browser/components/aiwindow/ui/content/modules/TrustedInternalURLs.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/A2UI.mjs", "browser/components/aiwindow/ui/modules/A2UI.sys.mjs", "browser/components/aiwindow/ui/modules/AITabUtils.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowTabStatesManager.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowToolbarButtons.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/AgentCommands.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/ChatMarkdownParser.mjs", "browser/components/aiwindow/ui/modules/ClientErrorTelemetry.mjs", "browser/components/aiwindow/ui/modules/ModelIcons.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillConstants.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillSources.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillTelemetry.sys.mjs", "browser/components/aiwindow/ui/modules/TrustedInternalURLs.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_interaction.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_model.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button_panel.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_telemetry.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/aiwindow/ui/test/browser/head_aiwindow_group_tabs_button.js", "browser/components/aiwindow/ui/test/browser/head_monitor_suggest.js", "browser/components/aiwindow/ui/test/xpcshell/test_A2UI.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_open_organize_tabs_panel.js"], "git_node": "ecc9a2b921d5379aa98557d1407fc5ad1149e67b", "git_parents": ["c36ab7d368c390aaa1a74c6234fb2b784d7b0a7a"], "node": "d7b6deab43291d1559fb2833b2e7bce9049cf41b", "parents": ["13bc8f4c26fd5549bdc901dac16815bb8429975e"], "tags": []}, {"author": "aurora \u003caurora@starsinthesky.ca\u003e", "branch": "default", "desc": "Bug 2088833 - Pass the window provided to TaskbarTabsPin.pinTaskbarTab into ShellService.createLinuxDesktopEntry. r=mferreiro,hsohaney\n\nThe original issue was caused when I forgot to update the signature of\ncreateShortcut in bug 2053206, so it would interpret the window as the\nnow-unused aRegistry argument. Since then, this code was moved into a\nLinux-specific subclass where there isn't any argument confusion, so\nit's just a matter of wiring it through.\n\nThis was also a decent opportunity to remove some duplication between the\ntests. (In principle it could even go further, but I think this is OK\nenough.) Plus, these tests didn't pass in any icon; not sure why that\ndoesn't crash, but it really ought to be passed in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343215\n", "files": ["browser/components/taskbartabs/TaskbarTabsPinLinux.sys.mjs", "browser/components/taskbartabs/test/xpcshell/test_taskbarTabs_pinLinux.js"], "git_node": "ed53eda01b9601844d759b91659483b87d6eac37", "git_parents": ["ecc9a2b921d5379aa98557d1407fc5ad1149e67b"], "node": "49bae87783ab4fb4519b1c06215f2c5404703c8d", "parents": ["d7b6deab43291d1559fb2833b2e7bce9049cf41b"], "tags": []}, {"author": "aurora \u003caurora@starsinthesky.ca\u003e", "branch": "default", "desc": "Bug 2088833 - Post: Don't rely on Window.window being the window when calling pinTaskbarTab. r=hsohaney\n\nInterestingly, this was wrong since its inception in bug 2019113 --- I did it\nright in findOrCreateTaskbarTab, and wrong in moveTabIntoTaskbarTab (even in\nthe tests!).\n\nNote that the old code _works_, but only by accident.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343216\n", "files": ["browser/components/taskbartabs/TaskbarTabs.sys.mjs", "browser/components/taskbartabs/test/browser/browser_taskbarTabs_pin.js"], "git_node": "87b0b3f318fc71bc1298231ee920c37330a5b238", "git_parents": ["ed53eda01b9601844d759b91659483b87d6eac37"], "node": "82196a3e35ea86ffb9a98f06dee293ba3fc7a76a", "parents": ["49bae87783ab4fb4519b1c06215f2c5404703c8d"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2094541 - Defer remote texture resource release to the creating thread when recycling is disabled r=gfx-reviewers,bradwerth\n\nReturn false from RecycleTexture() before moving any resources when recycling is disabled. This leaves the resources in their holder so callers can use the existing deferred release path to destroy them on the creating thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343872\n", "files": ["gfx/layers/RemoteTextureMap.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "fe4dfffe3d2d1745539c348c614cac916b688617", "git_parents": ["87b0b3f318fc71bc1298231ee920c37330a5b238"], "node": "316212b1026363b77cb7e278a87c793b3637bb2d", "parents": ["82196a3e35ea86ffb9a98f06dee293ba3fc7a76a"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094429: Skip the macOS 27 titlebar double-click workaround from bug 2066632 on macOS 27.2.1 and later. r=mac-reviewers,bradwerth\n\nThe double zoom no longer reproduces on macOS 27.2.1, and the workaround interferes with double-tapping the titlebar when NSIsTouchNative is enabled. Users on macOS 27.0 still need it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343796\n", "files": ["widget/cocoa/nsCocoaWindow.mm"], "git_node": "5bd727c0e55037c7707945731723670d5c98c9a5", "git_parents": ["fe4dfffe3d2d1745539c348c614cac916b688617"], "node": "c7fe13c3cfde0aedfb2d1e05384dcddbd8ddc130", "parents": ["316212b1026363b77cb7e278a87c793b3637bb2d"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069765 - Add a WPT crashtest. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328020\n", "files": ["testing/web-platform/tests/css/css-position/crashtests/inline-containing-block-multicol-balancing-003.html"], "git_node": "c11e19a1da15f028b369bded86b399506cfa0902", "git_parents": ["5bd727c0e55037c7707945731723670d5c98c9a5"], "node": "e5b37e59f3e4eb27461a01fd3d5e7feb57a09dc1", "parents": ["c7fe13c3cfde0aedfb2d1e05384dcddbd8ddc130"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 1812622: Wait for AppKit to finish launching before handling -foreground on macOS. r=mac-reviewers,bradwerth\n\nWith `-foreground`, `XRE_mainInit` called `SetFrontProcess()` before AppKit had finished launching. Sometimes AppKit then misses the activation: the window server treats Firefox as the frontmost app while `NSApp.isActive` stays NO, so no window becomes key or main and clicks are dropped. Later activation requests can't recover from that because the window server already has Firefox in front. This makes the same call from `applicationDidFinishLaunching` instead. `-[NSApplication activateIgnoringOtherApps:]` at that point was usually refused when Firefox was launched in the background, so it isn't an option.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343826\n", "files": ["toolkit/xre/MacApplicationDelegate.h", "toolkit/xre/MacApplicationDelegate.mm", "toolkit/xre/nsAppRunner.cpp"], "git_node": "e6ab8672077b923ed55304ce214d1d3f9245d84f", "git_parents": ["c11e19a1da15f028b369bded86b399506cfa0902"], "node": "af56077c044a16691ff3b6573bb98b08297973f4", "parents": ["e5b37e59f3e4eb27461a01fd3d5e7feb57a09dc1"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094871 - part 1: move the Smart Form Fill source tabs and flow telemetry out of SmartFormFillParent r=omarg\n\nSmartFormFillSources owns which tabs each form draws from, the tab-selector dialog and page-text extraction; the page-text budget and the number of tabs considered become firefox.js prefs\n\nSmartFormFillTelemetry now tracks each form's flow, field decisions and source-editor use, and implements the controller's RequestObserver callbacks; the controller still only receives callbacks, as asked in D317197, and this is the follow-up D325479 left for later\n\nSmartFormFillParent.sys.mjs drops under 1,500 lines and off the AGENTS.md list, as does ChatStore.sys.mjs after bug 2091433 part 3\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343760\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/AGENTS.md", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillSources.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillTelemetry.sys.mjs", "browser/components/aiwindow/ui/moz.build"], "git_node": "263da87e5a67c01c4a7a2846fec2ce4b22fd4932", "git_parents": ["e6ab8672077b923ed55304ce214d1d3f9245d84f"], "node": "c82849e19d60c08a78f4c3fb6b4810b2ad2a8f09", "parents": ["af56077c044a16691ff3b6573bb98b08297973f4"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094871 - part 2: move the Smart Window toolbar buttons out of AIWindow r=gcardieri\n\nAIWindowToolbarButtons owns the ask button and the switcher, Organize Tabs and monitor CustomizableUI buttons with private members, its own observers and the monitor attention API\n\nthe Organize Tabs and monitor panels take their widget IDs and overflow anchor from it, and the buttons and SpecialMessageActions call AutoTabGrouping and MonitorPanel directly instead of through AIWindowUI\n\nAIWindow.sys.mjs drops under 1,500 lines and off the AGENTS.md list\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343759\n", "files": ["browser/components/aiwindow/AGENTS.md", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowToolbarButtons.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_interaction.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_model.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button_panel.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/aiwindow/ui/test/browser/head_aiwindow_group_tabs_button.js", "browser/components/aiwindow/ui/test/browser/head_monitor_suggest.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_open_organize_tabs_panel.js"], "git_node": "816078ce74712cf1e6cb31f1dc44f537b41c399b", "git_parents": ["263da87e5a67c01c4a7a2846fec2ce4b22fd4932"], "node": "fb7587276fb14cc40091374b3d0798ecc86c7065", "parents": ["c82849e19d60c08a78f4c3fb6b4810b2ad2a8f09"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094871 - part 3: match Smart Window file layout to how files load r=mlucks\n\nui/modules now holds only moz-src modules, and chrome:// modules and assets live under ui/content to mirror their URLs, so one jar.mn wildcard packages them; components stay listed because they are packaged flat\n\nagent-watch-kit.svg from D319607 was never packaged, so it is allowlisted like other Remote Settings message assets\n\nAGENTS.md drops \"where things live\" entries that moz.build and jar.mn already show\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343818\n", "files": ["browser/base/content/test/browser-static/bro