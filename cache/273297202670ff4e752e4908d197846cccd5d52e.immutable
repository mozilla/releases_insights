d8d5c458f76cad514\nzam -\u003e 30202be5dfe15c8d53ed940d8d5c458f76cad514\nzh-CN -\u003e 30202be5dfe15c8d53ed940d8d5c458f76cad514\nzh-TW -\u003e 30202be5dfe15c8d53ed940d8d5c458f76cad514\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "f864aff0abac9287fdbee081e386e30ee163c976", "git_parents": ["3ad52916172f3deae32287aa8d2e3e4c1d0c4a96"], "node": "0cd4dbc6164a808d54d11578c449821cd941975f", "parents": ["9df7fbb9591af645ffda7e77601c7588ffc88909"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Remove unused \u003cinitializer_list\u003e include from TestCSPParser.cpp; r=sheriffs\n", "files": ["dom/security/test/gtest/TestCSPParser.cpp"], "git_node": "205327886ce0bc6549df75789a8bcb4f54af8f16", "git_parents": ["f864aff0abac9287fdbee081e386e30ee163c976"], "node": "e2a32635b706784186a97c6f6a679d91c88d4893", "parents": ["0cd4dbc6164a808d54d11578c449821cd941975f"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2092998 - Hide the Collections UI by default r=android-reviewers,mobiletest-reviewers,skhan\n\n- Keep the Collections UI shown by default in UI tests so the existing Collections tests keep working\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342931\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FeatureSettingsHelper.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FeatureSettingsHelperDelegate.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/HomeActivityTestRule.kt"], "git_node": "5cb722776cba5cf165730c747f27e292ce79efab", "git_parents": ["205327886ce0bc6549df75789a8bcb4f54af8f16"], "node": "491b99fc29165c3f60cd8a6c31ba84653d13e219", "parents": ["e2a32635b706784186a97c6f6a679d91c88d4893"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2080959 - Run reftests and crashtests on GeckoView with isolated content process with tier-2. r=geckoview-reviewers,owlish\n\nI forget turning on isolated process for reftests and crashtests on\nGeckoView when fixing bug 1977950.\n\nAlso, I would like to remove no-fission configuration for isolated\nprocess since we are going to disable nofis on autoland.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333601\n", "files": ["taskcluster/kinds/reftest/kind.yml"], "git_node": "430eee7a81f9770c9c4fe8fc38c46094722537cb", "git_parents": ["5cb722776cba5cf165730c747f27e292ce79efab"], "node": "0074731c1fe9c24180726eab79c45444cf9d43f7", "parents": ["491b99fc29165c3f60cd8a6c31ba84653d13e219"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2085992 - Clear SharedSubResourceCache cache on the tracking protection and URL classifier pref change. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336979\n", "files": ["dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_prefs.js", "dom/base/test/head.js", "dom/script/SharedScriptCache.cpp", "layout/style/SharedSubResourceCache.cpp", "layout/style/SharedSubResourceCache.h"], "git_node": "b9afe13444375e831175efed1da769ec4fe5466a", "git_parents": ["430eee7a81f9770c9c4fe8fc38c46094722537cb"], "node": "4b861d58a4dfb19521920c97443f26dd86a651e6", "parents": ["0074731c1fe9c24180726eab79c45444cf9d43f7"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2092053 - Use Digits kernels for Bigint add/sub/inc/dec r=mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342107\n", "files": ["js/src/vm/BigIntType.cpp", "js/src/vm/BigIntType.h"], "git_node": "c04771db5ee695c46fdecdf31b5017c1adf429ca", "git_parents": ["b9afe13444375e831175efed1da769ec4fe5466a"], "node": "e218fb52e1a49736c9a78f6d2d44bdafedde361a", "parents": ["4b861d58a4dfb19521920c97443f26dd86a651e6"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 2092476 - Use Digits kernels in BigInt and/or/xor/andNot r=mgaudet\n\nNegative operands previously went through several intermediate BigInts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342498\n", "files": ["js/src/vm/BigIntType.cpp", "js/src/vm/BigIntType.h"], "git_node": "9b0b77dadf1d7d14f814bcc1e918d2be45225a95", "git_parents": ["c04771db5ee695c46fdecdf31b5017c1adf429ca"], "node": "da10d4f629bcecf5565bce2789e52c73eb2cb911", "parents": ["e218fb52e1a49736c9a78f6d2d44bdafedde361a"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Keep base64 padding in url-hash WPT helper; r=tschuster\n\nThe CSP url-hash matching compares the policy's base64-value, with '-'/'_'\nnormalized to '+'/'/', against the padded base64 encoding of the URL digest, so\nvalues without '=' padding never match per spec. Encode the hashes with padding\nin the test helper, i.e. don't pass omitPadding to toBase64(), so the tests\ndon't depend on lenient decoding.\n\nChromium ignores padding when parsing hash sources, so these tests keep passing\nthere.\n\nSpec PR: https://github.com/w3c/webappsec-csp/pull/784\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337048\n", "files": ["testing/web-platform/tests/content-security-policy/script-src/tentative/support/util.js"], "git_node": "150804d91b0bab16055597a2236e7c219a49be16", "git_parents": ["9b0b77dadf1d7d14f814bcc1e918d2be45225a95"], "node": "d5374cf6c0e53c4def973f3a56ccea3ec9670974", "parents": ["da10d4f629bcecf5565bce2789e52c73eb2cb911"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092560 - Map the helper app dialog contract ID back to its original factory at the end of test_bug1266815.html, r=masayuki.\n\nUnregistering the mock factory left the contract ID without a factory, so the test threw when run again in the same browser.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342609\n", "files": ["editor/composer/test/test_bug1266815.html"], "git_node": "c162fbaad3763bd5580916aa599ff5ffd2b8945e", "git_parents": ["150804d91b0bab16055597a2236e7c219a49be16"], "node": "25bc0927530b5963e3cd2bbe0de7aaad39b3c6e2", "parents": ["d5374cf6c0e53c4def973f3a56ccea3ec9670974"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092296 - Remove the form history entry browser_privbrowsing_perwindowpb.js adds, r=credential-management-reviewers,mtigley.\n\nThe entry the non-private step saves outlives the test, so a second run finds it during its private-window check. Also remove the verify-standalone skip-if from bug 1995208.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342350\n", "files": ["toolkit/components/satchel/test/browser/browser.toml", "toolkit/components/satchel/test/browser/browser_privbrowsing_perwindowpb.js"], "git_node": "d6cb1088a7f1a97f8f500845ddfacef76360a2ec", "git_parents": ["c162fbaad3763bd5580916aa599ff5ffd2b8945e"], "node": "aa54c70d5e450bc2ff59307d5edf2890e790a8d0", "parents": ["25bc0927530b5963e3cd2bbe0de7aaad39b3c6e2"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1995881 - Reset FirefoxRelay's cached Remote Settings lists when the relay browser tests finish, r=credential-management-reviewers,mtigley.\n\nOtherwise the stale stubbed allow-list makes the signed-out subtest of browser_relay_signup_flow.js see Relay offered on its second run (--repeat, test-verify).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342372\n", "files": ["toolkit/components/passwordmgr/test/browser/browser_relay_utils.js"], "git_node": "697951254bb95c53395005ea93a3c5d80ae33aa2", "git_parents": ["d6cb1088a7f1a97f8f500845ddfacef76360a2ec"], "node": "82176e156380676af5b5a25a0d6a07b755f060d3", "parents": ["aa54c70d5e450bc2ff59307d5edf2890e790a8d0"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2091666 - Remove support for debounced clicks in the menu r=android-reviewers,giorga\n\nNo need for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341833\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/data/MenuItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuListItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuListItemCommon.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuListItemGroup.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/MenuListItemTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/VpnMenuItemProvider.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/VpnMenuItemProviderTest.kt"], "git_node": "8d8d634f987392318ae2d4f18e871adbe27f2f86", "git_parents": ["697951254bb95c53395005ea93a3c5d80ae33aa2"], "node": "9153b162f7e3cdc548ed242e483ce8195692168f", "parents": ["82176e156380676af5b5a25a0d6a07b755f060d3"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2077159 - Explicitly dump code coverage counters at the end of test suites. r=marco,perftest-reviewers,webdriver-reviewers,layout-reviewers,emilio,aglavic,jdescottes\n\nOn Android, the atexit handler isn't called because the remote app is\nkilled. Before exiting the test suites and killing the tests runner, we\nmust explicitely dump the counters.\n\nUnfortunately I didn't find a single location to cover every case.\n\nFor gtests, OnTestProgramEnd now calls __gcov_dump in GTestRunner.cpp.\n\nOtherwise __gcov_dump is called by PerTestCoverageUtils.afterSuite,\nwhich is called:\n- on session close in remote/marionette/driver.sys.mjs for marionette-\n  based tests\n- in DoneTests in layout/tools/reftest/reftest.sys.mjs for reftests\n- Tester_finish in testing/mochitest/browser-test.js for browser\n  mochitests\n- _runNextTest in testing/mochitest/tests/SimpleTest/TestRunner.js with\n  support from SpecialPowers for plain mochitests\n\nThis doesn't cover JUnit, xpcshell tests nor wdspec tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333273\n", "files": ["layout/tools/reftest/reftest.sys.mjs", "remote/marionette/driver.sys.mjs", "testing/gtest/mozilla/GTestRunner.cpp", "testing/mochitest/browser-test.js", "testing/mochitest/tests/SimpleTest/TestRunner.js", "testing/specialpowers/content/SpecialPowersChild.sys.mjs", "testing/specialpowers/content/SpecialPowersParent.sys.mjs", "tools/code-coverage/PerTestCoverageUtils.sys.mjs"], "git_node": "364a2fbff30e49e78266b07201ac1a1571103a2b", "git_parents": ["8d8d634f987392318ae2d4f18e871adbe27f2f86"], "node": "5e0fc4851e11bdf561225dca621e18da44bbcc5e", "parents": ["9153b162f7e3cdc548ed242e483ce8195692168f"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2077159 - Pull Android code coverage results after test runs using adb.py. r=marco\n\nAfter the last few commits, we now have test coverage data written by\ntests on Android devices, but we still need to pull those results from\nthe Android device to the host.\n\nThe core function lives in adb.py and called at the end of the various\ntest frameworks.\n\nThis doesn't cover wdspec tests because they do not use adb.py but a\ncustom ADB client written in Rust.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333274\n", "files": ["layout/tools/reftest/remotereftest.py", "testing/gtest/remotegtests.py", "testing/mochitest/runjunit.py", "testing/mochitest/runtestsremote.py", "testing/mozbase/mozdevice/mozdevice/adb.py", "testing/remotecppunittests.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox_android.py", "testing/xpcshell/remotexpcshelltests.py"], "git_node": "c3fc8e33d06a63e4f350558f799212038b429619", "git_parents": ["364a2fbff30e49e78266b07201ac1a1571103a2b"], "node": "ea07c27856fddb3b0d275173b5808609ca42e116", "parents": ["5e0fc4851e11bdf561225dca621e18da44bbcc5e"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092501 - Remove the dom.security.trusted_types.enabled pref. r=webidl,extension-reviewers,devtools-reviewers,saschanaz,rpl,bomsy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342534\n", "files": ["devtools/shared/tests/objects/AllJavascriptTypes.mjs", "docshell/base/nsDocShell.cpp", "dom/script/ScriptElement.cpp", "dom/security/nsCSPParser.cpp", "dom/security/test/unit/test_get_trusted_types_compliant_string.js", "dom/security/trusted-types/TrustedTypeUtils.cpp", "dom/webidl/TrustedTypes.webidl", "dom/webidl/WindowOrWorkerGlobalScope.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/content-security-policy/__dir__.ini", "testing/web-platform/meta/content-security-policy/script-src/__dir__.ini", "testing/web-platform/meta/html/dom/idlharness.https.html.ini", "testing/web-platform/meta/html/obsolete/requirements-for-implementations/the-marquee-element-0/__dir__.ini", "testing/web-platform/meta/html/semantics/forms/the-input-element/__dir__.ini", "testing/web-platform/meta/trusted-types/__dir__.ini", "toolkit/components/extensions/test/xpcshell/test_ext_contentscript_trustedtypes.js", "toolkit/content/tests/widgets/test_ua_widget_trusted_types.html", "toolkit/content/tests/widgets/test_videocontrols_l10n_trusted_types.html"], "git_node": "2507569f284c0d8eb48a16998f0c9edf45fccf08", "git_parents": ["c3fc8e33d06a63e4f350558f799212038b429619"], "node": "b59eba6d6f7274f1d373f4f55fee6ed52305cd81", "parents": ["ea07c27856fddb3b0d275173b5808609ca42e116"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093161 - Update PDF.js to bb1539a2c9b5b76d070284cca9091717133d8bf1 r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343004\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.renderer.mjs", "toolkit/components/pdfjs/content/build/pdf.sandbox.external.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/cmaps/Adobe-GB1-4.bcmap.br", "toolkit/components/pdfjs/content/web/cmaps/CNS2-H.bcmap.br", "toolkit/components/pdfjs/content/web/cmaps/H.bcmap.br", "toolkit/components/pdfjs/content/web/standard_fonts/unicode.bin", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/content/web/wasm/hellbox_bg.wasm", "toolkit/components/pdfjs/content/web/wasm/hellbox_nowasm_fallback.js.br", "toolkit/components/pdfjs/moz.yaml"], "git_node": "fc1eac5a8433a485e7d623bd92e82de02a9bcd8f", "git_parents": ["2507569f284c0d8eb48a16998f0c9edf45fccf08"], "node": "c4f7f755f40c292ed143333871935e5d8976818b", "parents": ["b59eba6d6f7274f1d373f4f55fee6ed52305cd81"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092518 - Skip sync if the broadcast value is older than the local timestamp r=gbeckley,remote-settings-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342548\n", "files": ["services/settings/remote-settings.sys.mjs", "services/settings/test/unit/test_remote_settings_poll.js"], "git_node": "4046543e5ba85fc64aaf0f22b88a8d3a105e10a8", "git_parents": ["fc1eac5a8433a485e7d623bd92e82de02a9bcd8f"], "node": "3aa6752c3b5d3f60086bccc178295c317b83ccd7", "parents": ["c4f7f755f40c292ed143333871935e5d8976818b"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2086953 - Add a will_retry field to test_status and test_end records. r=jgraham\n\nxpcshell and mochitest flag the test_status records of a run they will retry\nin extra.will_retry, and its test_end only by its \"will retry\" message. Both\nnow set the field on both records, so readers tell the run apart without\nparsing either.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337882\n", "files": ["testing/mochitest/runtests.py", "testing/mozbase/docs/mozlog.md", "testing/mozbase/mozlog/mozlog/structuredlog.py", "testing/mozbase/mozlog/tests/test_structured.py", "testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py", "testing/mozbase/mozsystemmonitor/tests/test_resource_monitor.py", "testing/xpcshell/runxpcshelltests.py"], "git_node": "62aa9f6fa4a53a8cb356f35975b56aa614c676ba", "git_parents": ["4046543e5ba85fc64aaf0f22b88a8d3a105e10a8"], "node": "014d6ced144b4580558c2ae4b3f0f1b9621ac22d", "parents": ["3aa6752c3b5d3f60086bccc178295c317b83ccd7"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2086953 - Drop the test_status records of a run the harness will retry from TestSummaryFormatter output. r=jgraham\n\nUnexpected and known intermittent subtests are kept as before; a subtest of\na run the harness will retry is dropped, its rerun being the result. The\ntest_end of such a run keeps its will_retry field in the artifact.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337881\n", "files": ["testing/mozbase/mozlog/mozlog/formatters/testsummary.py", "testing/mozbase/mozlog/tests/test_testsummary.py"], "git_node": "a4da7f14cd692c7b79f430b8f419b9b122553716", "git_parents": ["62aa9f6fa4a53a8cb356f35975b56aa614c676ba"], "node": "8266109d2f280ee6609f62e4760594391c97a009", "parents": ["014d6ced144b4580558c2ae4b3f0f1b9621ac22d"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2086953 - Add moztest.outcome, classifying the result of a test_status or test_end record. r=jgraham\n\nStatusHandler, SummaryHandler and the formatters all apply the same rule: a\nrecord is unexpected iff it carries `expected` and its status is not in\n`known_intermittent`, and a run fails on its test_end or on any subtest. The\nresource-usage profile re-derives it from the test_end alone, taking a\nweb-platform-test whose subtests failed for a pass and a known intermittent\nfor a failure. This enum states the rule once for such readers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337880\n", "files": ["testing/mozbase/moztest/moztest/outcome.py", "testing/mozbase/moztest/tests/manifest.toml", "testing/mozbase/moztest/tests/test_outcome.py"], "git_node": "15a1a8feb57f4c504bef0e586da24c996c474912", "git_parents": ["a4da7f14cd692c7b79f430b8f419b9b122553716"], "node": "6ad5412ca06ab64fadd6401549accfde5b7eee0a", "parents": ["8266109d2f280ee6609f62e4760594391c97a009"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2086953 - Colour the test markers of the resource-usage profile from moztest's outcome classification. r=ahal,releng-reviewers\n\nA web-platform-test ends OK whenever the harness ran it and its subtests\ndecide, so the marker now takes the worst outcome of the run, keyed on\n(subsuite, test id) because wpt processes interleave, and reports the number\nof unexpected subtests. Known intermittents and expected failures are yellow\nrather than orange, and a run the harness will retry is read from its\nwill_retry field instead of its message.\n\nmoztest is imported lazily: this module is also copied standalone into docker\nimages and onto generic-worker, where no test record arrives.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337883\n", "files": ["testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py", "testing/mozbase/mozsystemmonitor/tests/test_resource_monitor.py"], "git_node": "11f0ccf1568e587c487102f2197f40edeb58b137", "git_parents": ["15a1a8feb57f4c504bef0e586da24c996c474912"], "node": "26a820299a973aba22fbc30113c4a26f7a90e597", "parents": ["6ad5412ca06ab64fadd6401549accfde5b7eee0a"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2090208 - Migrate Safe Browsing, captive portal and keyword fixup notification bar strings from browser.properties to Fluent. r=firefox-desktop-core-reviewers ,fluent-reviewers,reusable-components-reviewers,hjones,webdriver-reviewers,Sasha,bolsson,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340435\n", "files": ["browser/actors/BlockedSiteParent.sys.mjs", "browser/base/content/browser-captivePortal.js", "browser/base/content/browser.js", "browser/locales/en-US/browser/browser.ftl", "browser/locales/en-US/chrome/browser/browser.properties", "python/l10n/fluent_migrations/bug_2090208_notification_bars_properties.py", "testing/firefox-ui/tests/functional/safebrowsing/test_notification.py", "toolkit/content/tests/chrome/test_notificationbox.xhtml", "toolkit/content/widgets/notificationbox.js"], "git_node": "1203c1450b3f9e67f09d5b720ff694bd1d33849c", "git_parents": ["11f0ccf1568e587c487102f2197f40edeb58b137"], "node": "b4668973c532ba91ffe2ecd35554fdc02927ad4a", "parents": ["26a820299a973aba22fbc30113c4a26f7a90e597"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2021173 - Reset the ForceRefreshParent module state at the start of browser_force_refresh.js, r=dom-worker-reviewers,edenchuang.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342135\n", "files": ["dom/serviceworkers/test/ForceRefreshParent.sys.mjs", "dom/serviceworkers/test/browser_force_refresh.js"], "git_node": "dada540ac6b6519568c3e1f21f7e1e34a8700d11", "git_parents": ["1203c1450b3f9e67f09d5b720ff694bd1d33849c"], "node": "be6f05a110bd1335c6e84867edc4014b291daf56", "parents": ["b4668973c532ba91ffe2ecd35554fdc02927ad4a"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2010741 - Update metadata for resize-observer/observer-in-cross-origin-frame.sub.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343053\n", "files": ["testing/web-platform/meta/resize-observer/observer-in-cross-origin-frame.sub.html.ini"], "git_node": "82adb510712ad7d4b34eee1e85d609bb9fe83216", "git_parents": ["dada540ac6b6519568c3e1f21f7e1e34a8700d11"], "node": "73c781e3434504ea9919b7ef62f0fae705b7f2e9", "parents": ["be6f05a110bd1335c6e84867edc4014b291daf56"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090040 - Use nsIPrincipal instead of PrincipalInfo in some PBackground messages. r=ipc-reviewers,dom-storage-reviewers,nika,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340321\n", "files": ["dom/broadcastchannel/BroadcastChannel.cpp", "dom/network/UDPSocketChild.cpp", "dom/storage/StorageActivityService.cpp", "dom/storage/StorageActivityService.h", "ipc/glue/BackgroundChildImpl.cpp", "ipc/glue/BackgroundChildImpl.h", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/BackgroundParentImpl.h", "ipc/glue/PBackground.ipdl"], "git_node": "8989697193aa5c7563710f4438b248390aab4127", "git_parents": ["82adb510712ad7d4b34eee1e85d609bb9fe83216"], "node": "465689f5c292802365c89ca88f4671034cba786d", "parents": ["73c781e3434504ea9919b7ef62f0fae705b7f2e9"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u