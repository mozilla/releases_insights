ting/web-platform/tests/referrer-policy/gen/top.http-rp/same-origin/mathml-a-tag.http.html.headers", "testing/web-platform/tests/referrer-policy/gen/top.http-rp/strict-origin-when-cross-origin/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.http-rp/strict-origin-when-cross-origin/mathml-a-tag.http.html.headers", "testing/web-platform/tests/referrer-policy/gen/top.http-rp/strict-origin/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.http-rp/strict-origin/mathml-a-tag.http.html.headers", "testing/web-platform/tests/referrer-policy/gen/top.http-rp/unsafe-url/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.http-rp/unsafe-url/mathml-a-tag.http.html.headers", "testing/web-platform/tests/referrer-policy/gen/top.http-rp/unset/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.meta/always/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.meta/default/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.meta/never/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.meta/no-referrer-when-downgrade/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.meta/no-referrer/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.meta/origin-when-cross-origin/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.meta/origin-when-crossorigin/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.meta/origin/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.meta/same-origin/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.meta/strict-origin-when-cross-origin/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.meta/strict-origin/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.meta/unsafe-url/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/gen/top.meta/unset/mathml-a-tag.http.html", "testing/web-platform/tests/referrer-policy/spec.src.json"], "git_node": "00351d7b55c2662a51ba33b1fd732612fb54fa18", "git_parents": ["05d6b5705c4c79b9a2106da169914f7ee8989bf4"], "node": "384a34afde60ba99da9aada4e06c8d89edf30bfc", "parents": ["b904391b29edef370fab9f76f521e07936b41abb"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2072068 [wpt PR 62693] - media: Always decode Opus at 48 kHz in OpusAudioDecoder, a=testonly\n\nAutomatic update from web-platform-tests\nmedia: Always decode Opus at 48 kHz in OpusAudioDecoder (#62693)\n\nIn RFC 7845 Section 5.1, Opus audio is always coded and decoded at 48000\nHz by default. FFmpeg's libopusdec unconditionally sets the output\nsample rate to 48000 Hz regardless of the configured sample rate (e.g.,\n44100 Hz from WebCodecs).\n\nPreviously, OpusAudioDecoder passed config.samples_per_second() directly\nto opus_multistream_decoder_create(), which caused initialization to\nfail with OPUS_BAD_ARG when configured with non-Opus rates like 44.1\nkHz.\n\nThis patch normalizes OpusAudioDecoder to always initialize at\nkOpusDefaultSampleRate (48000 Hz) and disables phase inversion when\ntargeting mono output, matching FFmpegAudioDecoder's behavior.\n\nTAG=agy\nCONV=e613eb01-c26a-4600-820a-03e77c3f7c7d\n\nFixed: 547065816\nChange-Id: Ie3ec3e5acf65ce82735b8e7a430cb5abef0b4cd7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8408705\nReviewed-by: Dale Curtis \u003cdalecurtis@chromium.org\u003e\nCommit-Queue: Jordan Bayles \u003cjophba@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1698550}\n\nCo-authored-by: Jordan Bayles \u003cjophba@chromium.org\u003e\n--\n\nwpt-commits: 589ce06df2212292ec026223cd177cd50f24b765\nwpt-pr: 62693\n", "files": ["testing/web-platform/tests/webcodecs/audioDecoder-codec-specific.https.any.js"], "git_node": "77ee04f2939eb9707d083b9a16fb87203a355bd1", "git_parents": ["00351d7b55c2662a51ba33b1fd732612fb54fa18"], "node": "93d34da6b1e7b3bd52edb3fa3b223d33df452e99", "parents": ["384a34afde60ba99da9aada4e06c8d89edf30bfc"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2086746 [wpt PR 62708] - webrtc wpt: add WPT for stats creation, a=testonly\n\nAutomatic update from web-platform-tests\nwebrtc wpt: add WPT for stats creation (#62708)\n\ndiscussed in the W3C WebRTC September interim meeting:\n  https://docs.google.com/presentation/d/11rr8X4aOao1AmvyoDLX8o9CPCmnDHkWGRM3nB4Q_104/edit?slide=id.g3657b20cdb2_3_18#slide=id.g3657b20cdb2_3_18\n\nThe specification does not describe when transport, certificate,\nlocal-candidate, remote-candidate, candidate-pair, media-playout and\ndata-channel stats are created.\n\nFor those the test only asserts that data-channel stats exist right\nafter createDataChannel, and that all stats object references resolve at\nevery stage, which constrains when transport, certificate and candidate\nstats must exist. Browsers differ on candidate-pair and media-playout.\n\nBug: None\nChange-Id: I11484a63512fe0201551152c95c0c71c5b97c840\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7003686\nReviewed-by: Henrik Bostr\u00f6m \u003chbos@chromium.org\u003e\nCommit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\nCr-Commit-Position: refs/heads/main@{#1697977}\n\nCo-authored-by: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n--\n\nwpt-commits: 87ff68daf45be3b6b2851689ead24b8f195efecf\nwpt-pr: 62708\n", "files": ["testing/web-platform/tests/webrtc-stats/stats-creation.html", "testing/web-platform/tests/webrtc-stats/supported-stats.https.html", "testing/web-platform/tests/webrtc/RTCPeerConnection-helper.js"], "git_node": "752958f983b7310cc0e48da6d333e81fd34307ab", "git_parents": ["77ee04f2939eb9707d083b9a16fb87203a355bd1"], "node": "20abc4047ad30a9413eec876d05367966b4044a4", "parents": ["93d34da6b1e7b3bd52edb3fa3b223d33df452e99"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086746 [wpt PR 62708] - Update wpt metadata, a=testonly\n\nwpt-pr: 62708\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webrtc-stats/stats-creation.html.ini", "testing/web-platform/meta/webrtc/RTCDataChannel-close.html.ini"], "git_node": "2f18ecd45c5b0af081ec59ca6e1e73edd24d850f", "git_parents": ["752958f983b7310cc0e48da6d333e81fd34307ab"], "node": "9f76eb4a62df2a3b975ea280eec1bde7821e0721", "parents": ["20abc4047ad30a9413eec876d05367966b4044a4"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2075014 [wpt PR 62906] - [Blink] Resolve CSS Image and Font values per-document, a=testonly\n\nAutomatic update from web-platform-tests\n[Blink] Resolve CSS Image and Font values per-document (#62906)\n\nCSS style resources referenced from a stylesheet were cached directly on\nthe `CSSValue` objects owned by `StyleSheetContents`. Because two\nsame-origin documents that link the same stylesheet share a single\n`StyleSheetContents` instance, a resource already fetched by the first\ndocument was reused by the second document without any fetch of its own.\nThis let the second document display a resource that its own Content\nSecurity Policy would have blocked, defeating per-document CSP\nenforcement.\n\nThis change caches each fetched style resource in a per-ResourceFetcher\nmap keyed on the requesting document's fetcher, rather than in a single\nshared slot. A document whose fetcher has not fetched the resource now\nre-fetches it under its own CSP. The performance and memory impact\nshould usually be minimal due to the re-fetch resolving in the\n`MemoryCache` instead of the network, but that is not guaranteed (e.g.\nif the resource was marked no-store). Same-fetcher lookups still hit the\ncache, so there is no additional fetching within a single document.\n\nA null `ResourceFetcher` route is still supported for contexts that have\nno fetcher (e.g. cross-thread style values).\n\nA route for taking a snapshot (used by `StyleFetchedImage`) is also\nintroduced, with the snapshot being available in all contexts regardless\nof `ResourceFetcher`.\n\nThe new behavior is on-by-default, but gated behind the\n`StyleResourceFetcherIdentityCheck` runtime-enabled feature in case it\nneeds to be stopped.\n\nThis change does not attempt to key based on the CSP or an initial\n`CanRequest` result. That would validate only the starting CSP decision,\nnot the full set of per-document request checks an actual fetch performs\n(e.g. each stage of redirects, or resulting URL differing from requested\nURL).\n\nAuthorship of these WPTs is attributed to Dileep, based on\ncrrev.com/c/7867457\n\nFixed: 504107363\nChange-Id: Icd98ac13320cfc7238a7236c23e83143b7359144\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8410893\nReviewed-by: Yoav Weiss (@Shopify) \u003cyoavweiss@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Hoch Hochkeppel \u003cmhochk@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1703519}\n\nCo-authored-by: Hoch Hochkeppel \u003cmhochk@microsoft.com\u003e\n--\n\nwpt-commits: c787b1eb4a462324ea16236134115a4584808e70\nwpt-pr: 62906\n", "files": ["testing/web-platform/tests/content-security-policy/font-src/shared-stylesheet-font-cache-bypass-strict-first.html", "testing/web-platform/tests/content-security-policy/font-src/shared-stylesheet-font-cache-bypass.html", "testing/web-platform/tests/content-security-policy/font-src/support/shared-stylesheet-font-cache-bypass-permissive.html", "testing/web-platform/tests/content-security-policy/font-src/support/shared-stylesheet-font-cache-bypass-strict.html", "testing/web-platform/tests/content-security-policy/font-src/support/shared-stylesheet-font-cache-bypass.css", "testing/web-platform/tests/content-security-policy/font-src/support/shared-stylesheet-font-cache-bypass.css.headers", "testing/web-platform/tests/content-security-policy/img-src/shared-stylesheet-image-cache-bypass-loaded-ref.html", "testing/web-platform/tests/content-security-policy/img-src/shared-stylesheet-image-cache-bypass-ref.html", "testing/web-platform/tests/content-security-policy/img-src/shared-stylesheet-image-cache-bypass-strict-first.html", "testing/web-platform/tests/content-security-policy/img-src/shared-stylesheet-image-cache-bypass.html", "testing/web-platform/tests/content-security-policy/img-src/shared-stylesheet-image-set-cache-bypass-strict-first.html", "testing/web-platform/tests/content-security-policy/img-src/shared-stylesheet-image-set-cache-bypass.html", "testing/web-platform/tests/content-security-policy/img-src/shared-stylesheet-mask-cache-bypass-loaded-ref.html", "testing/web-platform/tests/content-security-policy/img-src/shared-stylesheet-mask-cache-bypass-ref.html", "testing/web-platform/tests/content-security-policy/img-src/shared-stylesheet-mask-cache-bypass-strict-first.html", "testing/web-platform/tests/content-security-policy/img-src/shared-stylesheet-mask-cache-bypass.html", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-image-cache-bypass-blank.html", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-image-cache-bypass-permissive.html", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-image-cache-bypass-strict.html", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-image-cache-bypass.css", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-image-cache-bypass.css.headers", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-image-set-cache-bypass-permissive.html", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-image-set-cache-bypass-strict.html", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-image-set-cache-bypass.css", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-image-set-cache-bypass.css.headers", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-mask-cache-bypass-blank.html", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-mask-cache-bypass-permissive.html", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-mask-cache-bypass-strict.html", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-mask-cache-bypass.css", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-mask-cache-bypass.css.headers", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-mask-cache-bypass.svg", "testing/web-platform/tests/content-security-policy/img-src/support/shared-stylesheet-mask-cache-bypass.svg.headers"], "git_node": "845ef627775a208cb5a0b942e322a4f24622e7d0", "git_parents": ["2f18ecd45c5b0af081ec59ca6e1e73edd24d850f"], "node": "be99995da7db525508590dee790cf20cdb32a8e4", "parents": ["9f76eb4a62df2a3b975ea280eec1bde7821e0721"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075014 [wpt PR 62906] - Update wpt metadata, a=testonly\n\nwpt-pr: 62906\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/content-security-policy/font-src/shared-stylesheet-font-cache-bypass-strict-first.html.ini", "testing/web-platform/meta/content-security-policy/font-src/shared-stylesheet-font-cache-bypass.html.ini", "testing/web-platform/meta/content-security-policy/img-src/shared-stylesheet-image-cache-bypass.html.ini", "testing/web-platform/meta/content-security-policy/img-src/shared-stylesheet-image-set-cache-bypass-strict-first.html.ini", "testing/web-platform/meta/content-security-policy/img-src/shared-stylesheet-image-set-cache-bypass.html.ini", "testing/web-platform/meta/content-security-policy/img-src/shared-stylesheet-mask-cache-bypass-strict-first.html.ini"], "git_node": "7a3cafd90e707d33db575efde1bb1b8dcb02c46a", "git_parents": ["845ef627775a208cb5a0b942e322a4f24622e7d0"], "node": "10786cc3cb9bdf816a70d401e8bf9723a549d1ce", "parents": ["be99995da7db525508590dee790cf20cdb32a8e4"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089029 - [wpt-sync] Update web-platform-tests to c787b1eb4a462324ea16236134115a4584808e70, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: c787b1eb4a462324ea16236134115a4584808e70\nwpt-type: landing\n", "files": ["testing/web-platform/meta/IndexedDB/keypath.any.js.ini", "testing/web-platform/meta/ai/decision-model/decision-model.tentative.https.window.js.ini", "testing/web-platform/meta/ai/semantic_embedder/semantic-embedder-downloadprogress-abort.tentative.https.window.js.ini", "testing/web-platform/meta/ai/translator/translator.https.window.js.ini", "testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-on-self-origin-by-permissions-policy.tentative.https.sub.html.ini", "testing/web-platform/meta/content-security-policy/font-src/shared-stylesheet-font-cache-bypass-strict-first.html.ini", "testing/web-platform/meta/content-security-policy/img-src/shared-stylesheet-image-set-cache-bypass.html.ini", "testing/web-platform/meta/credential-management/credentialscontainer-frame-basics.https.html.ini", "testing/web-platform/meta/css/css-color/parsing/color-computed-powerless.html.ini", "testing/web-platform/meta/css/css-ui/parsing/caret-color-computed.html.ini", "testing/web-platform/meta/css/css-ui/parsing/caret-color-valid.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/meter-appearance-native-sideways-lr-rtl.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/meter-appearance-native-sideways-lr.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/progress-appearance-native-sideways-lr-rtl.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/progress-appearance-native-sideways-lr.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/progress-appearance-none-sideways-lr-rtl.optional.html.ini", "testing/web-platform/meta/css/css-writing-modes/forms/progress-appearance-none-sideways-lr.optional.html.ini", "testing/web-platform/meta/digital-credentials/get-opaque-origin-combinations.https.html.ini", "testing/web-platform/meta/domparsing/tentative/stream-html-parser-blocking-script.html.ini", "testing/web-platform/meta/encoding/legacy-mb-tchinese/big5/big5-encode-href-errors-han.html.ini", "testing/web-platform/meta/eventsource/format-bom-split.any.js.ini", "testing/web-platform/meta/fetch/range/sw-416.https.window.js.ini", "testing/web-platform/meta/fetch/range/sw.https.window.js.ini", "testing/web-platform/meta/html/browsers/the-window-object/open-close/open-features-tokenization-screenx-screeny.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/security-window/window-security.https.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/self-et-al.window.js.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-open-popup-behavior.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/css-backdrop-filter-with-blend-mode-over-content.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/nested-canvas-filter.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/nested-drawable-filter.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/visited-link/visited-link-dec