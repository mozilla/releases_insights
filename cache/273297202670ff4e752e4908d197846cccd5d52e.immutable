js/android/components/remotesettings/android/src/main/java/mozilla/appservices/remotesettings/remote_settings.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFxcontainers.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "05ea7f18f0d1f44edada3070def61b9644d8b6af", "git_parents": ["b19de992962c4cfedf4cea3c42ae6e57dfd90551"], "node": "25d72fd7bdf00b033e04a4b10b04179bd5919266", "parents": ["49b3b729c3e1b1461ca17196320d20fa21c27b3b"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2076526 - Remove shared preferences from NimbusBuilder et al. r=android-reviewers,jonalmeida,mobiletest-reviewers,aaronmt\n\nThe shared preferences were used to populate override values for\nvariables annotated with `pref-key`. However, that feature has been\nremoved in bug 2053517.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329796\n", "files": ["mobile/android/android-components/components/service/nimbus/src/test/java/mozilla/components/service/nimbus/messaging/NimbusMessagingStorageTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FxNimbusHelper.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/NimbusMessagingHomescreenTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/NimbusMessagingSurveyTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/experiments/NimbusSetup.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/experiments/NimbusSetup.kt"], "git_node": "621cec21ef6c668651e11a0885a71d3698d31ec2", "git_parents": ["05ea7f18f0d1f44edada3070def61b9644d8b6af"], "node": "c34231567b0b75b2532b13ed21ed7587d4f3ea6c", "parents": ["25d72fd7bdf00b033e04a4b10b04179bd5919266"], "tags": []}, {"author": "Ben Dean-Kawamura \u003cbdk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092257 - Remove RustAuthState references, r=beth,android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342318\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/FirefoxAccount.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/FxaAccountManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/FxaAccountManagerTest.kt"], "git_node": "e728be2378387dc232fcd0a1632442283e86158e", "git_parents": ["621cec21ef6c668651e11a0885a71d3698d31ec2"], "node": "48021fbfd3b13f62d9cbf8871117c0ef3a855992", "parents": ["c34231567b0b75b2532b13ed21ed7587d4f3ea6c"], "tags": []}, {"author": "Jon Oliver \u003cjooliver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076489 - Update the Private Browsing about page theme so it passes use-design-tokens r=desktop-theme-reviewers,mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339730\n", "files": ["browser/themes/shared/privatebrowsing/aboutPrivateBrowsing.css", "stylelint-rollouts.config.js"], "git_node": "058da64d81ca5d8ec158a1fab35370a1e5f6a58c", "git_parents": ["e728be2378387dc232fcd0a1632442283e86158e"], "node": "9478cad0f6b1385945d89bae72bac9b993d8e0af", "parents": ["48021fbfd3b13f62d9cbf8871117c0ef3a855992"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2088049 - Add an asan_error mozlog action and an AddressSanitizer report parser in mozleak r=ahal\n\nAn AddressSanitizer report is often the only trace of a crash: when it\ncomes from a child process or from a process that is shutting down there\nis no minidump, hence no crash action, and the task is only red because\nmozharness greps the raw lines. mozleak.ASanErrorParser assembles the\nheader, the stacks and the SUMMARY line of a report out of a process\noutput stream, keeping it open across the lines of other processes that\ninterleave while the stack is symbolized, and emits one asan_error action\nper report. It lives in mozleak rather than next to the UBSan parser in\nmoztest because wptrunner only depends on mozleak.\n\nErrorSummaryFormatter writes the action as a crash of the test that was\nrunning (the one the action names, else the last one started), with an\n\"AddressSanitizer: \u003ckind\u003e [@ \u003cfunction\u003e]\" signature, and fails its group\nunless the run will be retried. TestSummaryFormatter keeps the action\nwith its pid and stacks. The TBPL formatter stays silent so the failure\nsummary keeps showing the original lines only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339052\n", "files": ["testing/mozbase/mozleak/mozleak/__init__.py", "testing/mozbase/mozleak/mozleak/asan.py", "testing/mozbase/mozleak/setup.py", "testing/mozbase/mozleak/tests/manifest.toml", "testing/mozbase/mozleak/tests/test_asan.py", "testing/mozbase/mozlog/mozlog/formatters/errorsummary.py", "testing/mozbase/mozlog/mozlog/formatters/machformatter.py", "testing/mozbase/mozlog/mozlog/formatters/testsummary.py", "testing/mozbase/mozlog/mozlog/structuredlog.py", "testing/mozbase/mozlog/tests/test_errorsummary.py", "testing/mozbase/mozlog/tests/test_formatters.py", "testing/mozbase/mozlog/tests/test_structured.py", "testing/mozbase/mozlog/tests/test_testsummary.py"], "git_node": "21c9c1c5ae419cc0c60577e0b1fd3134f6ba1e00", "git_parents": ["058da64d81ca5d8ec158a1fab35370a1e5f6a58c"], "node": "9e51a7095bc1813398433b0396e58adfc2cfbba6", "parents": ["9478cad0f6b1385945d89bae72bac9b993d8e0af"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2088049 - Record AddressSanitizer reports as ASanError markers in resource usage profiles r=ahal\n\nThe asan_error action becomes an ASanError marker carrying the kind,\nmessage, pid, SUMMARY location and stack, red unless the run will be\nretried. Harnesses that only log the raw lines still get the marker from\na line-based fallback fed with process_output lines, which the action\nsupersedes when both arrive, as for UBSan reports. mozharness and the\nmozlog resource handler forward the action to the monitor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339053\n", "files": ["testing/mozbase/mozlog/mozlog/handlers/resourcehandler.py", "testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py", "testing/mozbase/mozsystemmonitor/tests/test_resource_monitor.py", "testing/mozharness/mozharness/mozilla/structuredlog.py"], "git_node": "3c8681e20cf92a06b429e5db78c7cce5be19c628", "git_parents": ["21c9c1c5ae419cc0c60577e0b1fd3134f6ba1e00"], "node": "c5e06ae3b07c5be31f13f8ee5a65bfead8810e5b", "parents": ["9e51a7095bc1813398433b0396e58adfc2cfbba6"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2088049 - Feed AddressSanitizer reports to the parser from wptrunner, mochitest, xpcshell and reftest r=jgraham\n\nwptrunner creates the parser next to its LSan handler on ASan builds and\nfeeds it every Firefox output line, ahead of the LSan handler which drops\nSUMMARY lines. The running test is not known there, so the error summary\nattributes the report to the last test started, and a report still open\nwhen a test ends, its SUMMARY never having arrived, is named after that\ntest at the crash check rather than after a later one. mochitest and\nxpcshell feed it like the UBSan parser, with the test that is running,\nquietly when a crash is expected or the run will be retried. reftest\nwires no sanitizer parser today, so its output handler gets this one,\nwith the harness's lastTestSeen and manifest, so that a report is blamed\non what a crash would be.\n\nThe xpcshell selftest replays a synthetic report, so it runs on every\nbuild type.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339054\n", "files": ["layout/tools/reftest/output.py", "layout/tools/reftest/remotereftest.py", "layout/tools/reftest/runreftest.py", "testing/mochitest/runtests.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox.py", "testing/xpcshell/runxpcshelltests.py", "testing/xpcshell/selftest.py"], "git_node": "16becd0a257953da2f5d2ff57153c953c7e3c51a", "git_parents": ["3c8681e20cf92a06b429e5db78c7cce5be19c628"], "node": "e030ee8d5a1ef9c95f6d38c66ce158c26a44557b", "parents": ["c5e06ae3b07c5be31f13f8ee5a65bfead8810e5b"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075323 - Let an engine session request, open and exit a picture-in-picture window for its video. r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335438\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineSessionTest.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/EngineSession.kt", "mobile/android/android-components/docs/changelog.md"], "git_node": "dff543818108f5e7ab8e375d01f54071dffb1d0f", "git_parents": ["16becd0a257953da2f5d2ff57153c953c7e3c51a"], "node": "b71988e5bf3919eec36726909e1712a651890455", "parents": ["e030ee8d5a1ef9c95f6d38c66ce158c26a44557b"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075323 - Track picture-in-picture requests and windows in the browser state. r=android-reviewers,jonalmeida,android-build-system-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335439\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/action/BrowserAction.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/engine/EngineObserver.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/engine/middleware/EngineDelegateMiddleware.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/reducer/BrowserStateReducer.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/reducer/PictureInPictureStateReducer.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/BrowserState.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/PictureInPictureWindowState.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/engine/EngineObserverTest.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/engine/middleware/EngineDelegateMiddlewareTest.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/reducer/PictureInPictureStateReducerTest.kt", "mobile/android/android-components/components/feature/pictureinpicture/build.gradle", "mobile/android/android-components/components/feature/pictureinpicture/lint-baseline.xml", "mobile/android/android-components/components/feature/pictureinpicture/src/main/AndroidManifest.xml", "mobile/android/android-components/components/feature/pictureinpicture/src/main/java/mozilla/components/feature/pictureinpicture/PictureInPictureMiddleware.kt", "mobile/android/android-components/components/feature/pictureinpicture/src/main/java/mozilla/components/feature/pictureinpicture/PictureInPictureUseCases.kt", "mobile/android/android-components/components/feature/pictureinpicture/src/test/java/mozilla/components/feature/pictureinpicture/PictureInPictureMiddlewareTest.kt", "mobile/android/android-components/components/feature/pictureinpicture/src/test/java/mozilla/components/feature/pictureinpicture/PictureInPictureUseCasesTest.kt", "mobile/android/android-components/docs/changelog.md", "taskcluster/config.yml"], "git_node": "9c4f00938910dfa565b8cef59c9c4547e8027172", "git_parents": ["dff543818108f5e7ab8e375d01f54071dffb1d0f"], "node": "00165cbbb9a609ca5c5d31ef8804a77aa45afea1", "parents": ["b71988e5bf3919eec36726909e1712a651890455"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075323 - Keep a session active while a picture-in-picture window shows its video. r=android-reviewers,jonalmeida,geckoview-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335440\n", "files": ["mobile/android/andro