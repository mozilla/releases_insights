.html", "testing/web-platform/tests/svg/text/reftests/text-visibility-hidden-tspan-visible.html"], "git_node": "fa63c081ff217680b8615a9bacabf375e3d0a93f", "git_parents": ["e9dcb60d0085c19117b9ac75a6e2df70810cb2ab"], "node": "0d649e3857c0d0dc7a7af1687a0e1c6a6855c6f1", "parents": ["398b74113e23fee237a659c43529b2049b470828"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082384 [wpt PR 63702] - Update wpt metadata, a=testonly\n\nwpt-pr: 63702\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/extensibility/foreignObject/foreign-object-circular-filter-reference-crash.html.ini", "testing/web-platform/meta/svg/render/reftests/visibility-hidden-container-mask-clip.html.ini", "testing/web-platform/meta/svg/text/reftests/text-visibility-hidden-tspan-visible.html.ini"], "git_node": "fd17a2c1cf6f29dc3496ce0e898d56ce2f0a1e01", "git_parents": ["fa63c081ff217680b8615a9bacabf375e3d0a93f"], "node": "4e5b2ca7884b06ed9e15ba030ed8125f5c7c6bfd", "parents": ["0d649e3857c0d0dc7a7af1687a0e1c6a6855c6f1"], "tags": []}, {"author": "Nikolas Zimmermann \u003cnzimmermann@igalia.com\u003e", "branch": "default", "desc": "Bug 2082395 [wpt PR 63703] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326420, a=testonly\n\nAutomatic update from web-platform-tests\nAdd test for hit testing children of transformed SVG groups\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326420\n\n--\n\nwpt-commits: 9dbf2ac0634b3c4205e5b03ddafbd3f926cf208d\nwpt-pr: 63703\n", "files": ["testing/web-platform/tests/svg/interact/scripted/transformed-group-hittest.html"], "git_node": "6fe3c96b9ff22a30e2b26388e4bc169bf1dfb7f7", "git_parents": ["fd17a2c1cf6f29dc3496ce0e898d56ce2f0a1e01"], "node": "3fd587512acd41756ed4355d8a1a086fb09fbbb4", "parents": ["4e5b2ca7884b06ed9e15ba030ed8125f5c7c6bfd"], "tags": []}, {"author": "Shannon Booth \u003cshannon.ml.booth@gmail.com\u003e", "branch": "default", "desc": "Bug 2089422 [wpt PR 64349] - Test a FileReader read started by an abort before loadstart, a=testonly\n\nAutomatic update from web-platform-tests\nTest a FileReader read started by an abort before loadstart\n\nThe existing test only covered aborts after loadstart.\n\n--\n\nwpt-commits: e9fb02faaa5f2cb4bacaed7f241ddeb963d00d58\nwpt-pr: 64349\n", "files": ["testing/web-platform/tests/FileAPI/reading-data-section/FileReader-multiple-reads.any.js"], "git_node": "1797960b53bc18b24084229b4458ca7a28b9f7c1", "git_parents": ["6fe3c96b9ff22a30e2b26388e4bc169bf1dfb7f7"], "node": "37b612c4eeccbf0cbf0346c869254068b0297270", "parents": ["3fd587512acd41756ed4355d8a1a086fb09fbbb4"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089422 [wpt PR 64349] - Update wpt metadata, a=testonly\n\nwpt-pr: 64349\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/FileAPI/reading-data-section/FileReader-multiple-reads.any.js.ini"], "git_node": "3ee20d755054177497a1ce793542b7564ecb1473", "git_parents": ["1797960b53bc18b24084229b4458ca7a28b9f7c1"], "node": "67235c8fad7d1495c3fa71fab3d425fe92d29cd1", "parents": ["37b612c4eeccbf0cbf0346c869254068b0297270"], "tags": []}, {"author": "Shannon Booth \u003c35911232+shannonbooth@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083576 [wpt PR 63855] - Don't require RangeError for stack overflow in SharedWorker-constructor, a=testonly\n\nAutomatic update from web-platform-tests\nDon't require RangeError for stack overflow in SharedWorker-constructor (#63855)\n\nECMA-262 doesn't specify what is thrown when the call stack is\nexhausted, and SpiderMonkey and LibJS throw InternalError rather than\nRangeError. Expect whatever error the engine throws for stack overflow,\nfound by overflowing the stack first, as the wasm core harness does.\n--\n\nwpt-commits: 54ca7adb4b1e695e8132b3584de23a1bb1b6308e\nwpt-pr: 63855\n", "files": ["testing/web-platform/tests/workers/SharedWorker-constructor.html"], "git_node": "3bae195f120fddfb8836624cf78ecbfe4065ab0a", "git_parents": ["3ee20d755054177497a1ce793542b7564ecb1473"], "node": "80e9cef90f38d5b5c79dde2c982365bbca2444e7", "parents": ["67235c8fad7d1495c3fa71fab3d425fe92d29cd1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083576 [wpt PR 63855] - Update wpt metadata, a=testonly\n\nwpt-pr: 63855\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/workers/SharedWorker-constructor.html.ini"], "git_node": "a5261e1c784d673cc627848e0e781a000b1d8086", "git_parents": ["3bae195f120fddfb8836624cf78ecbfe4065ab0a"], "node": "77262da224ad0d36dbdd41329b844f8cc3b72c18", "parents": ["80e9cef90f38d5b5c79dde2c982365bbca2444e7"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2089423 [wpt PR 64448] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=313316, a=testonly\n\nAutomatic update from web-platform-tests\nFloat with margin-start overlaps adjacent float\n\nWhen a float has a non-zero start margin, FloatAvoider::inlineEnd() computes the wrong margin box edge.\n\nInline start's initial value is the border box start. In order to expand it to the margin box\nwe do inlineStart -= marginStart (correct). However when we compute inline end as\n'inlineStart + borderBoxWidth + marginEnd' the start margin is gone now (incorrect).\n\nFor example, a left float with margin-left: 50px and width: 30px should have a\nmargin box spanning 0..80. But inlineEnd() returned 30 instead of 80 because it\nwent from margin-box-left (0) + border-box-width (30) + margin-end (0) = 30,\nmissing the 50px start margin.\n\nThis caused findAvailablePosition to think the float was much narrower than it\nactually is, so it would not push the float below an adjacent float when the\nmargin box did not fit.\n\nThe fix is to use inlineStart() + marginBoxWidth() for floats, which correctly accounts for all margins.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=313316\nWebKit-Canonical-Link: https://commits.webkit.org/312083@main\nCo-Authored-By: Claude Opus 4.6 (1M context) \u003cnoreply@anthropic.com\u003e\n\n--\n\nwpt-commits: 9d139d20954405fcc7bdc2b7d2aa708ab0178760\nwpt-pr: 64448\n", "files": ["testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-001.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-002-ref.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-002.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-003-ref.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-003.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-006-ref.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-006.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-007-ref.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-007.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-008-ref.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-008.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-009-ref.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-009.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-010-ref.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-010.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-011-ref.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-011.html", "testing/web-platform/tests/css/CSS2/floats/float-avoids-float-with-margin-ref.html"], "git_node": "c7e5dc5d7320b0a3f8a46d80a18e0c907e629f88", "git_parents": ["a5261e1c784d673cc627848e0e781a000b1d8086"], "node": "d28d3237d693873d7bee51eafa4ed19858e701c8", "parents": ["77262da224ad0d36dbdd41329b844f8cc3b72c18"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2089425 [wpt PR 64453] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=15602, a=testonly\n\nAutomatic update from web-platform-tests\nTest a floated ::first-letter after inserting text before it\n\nThis test comes from https://commits.webkit.org/310719@main. That change's other test, first-letter-insert-text-before.html, covers the same case as the existing first-letter-insert-text-node-dynamic.html, so it isn't included.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=15602\n\n--\n\nwpt-commits: f752b02621d2767b285810185c0fd8d82bcc6d0b\nwpt-pr: 64453\n", "files": ["testing/web-platform/tests/css/css-pseudo/first-letter-float-insert-text-before-ref.html", "testing/web-platform/tests/css/css-pseudo/first-letter-float-insert-text-before.html"], "git_node": "c3108c9060485dcfa067e8beedba5792a8050e7b", "git_parents": ["c7e5dc5d7320b0a3f8a46d80a18e0c907e629f88"], "node": "26e67e1f5672e7a4be76c7194147d262e371a17a", "parents": ["d28d3237d693873d7bee51eafa4ed19858e701c8"], "tags": []}, {"author": "Luke Warlow \u003clwarlow@igalia.com\u003e", "branch": "default", "desc": "Bug 2089426 [wpt PR 64455] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=315510, a=testonly\n\nAutomatic update from web-platform-tests\nTest CloseWatcher user activation in cross-origin iframes\n\nThese tests come from https://commits.webkit.org/314884@main. Its export, #60153, only had the same-origin variants.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=315510\n\n--\n\nwpt-commits: 63f216f9dc7df984cf24950b14b7619a6311c7ae\nwpt-pr: 64455\n", "files": ["testing/web-platform/tests/close-watcher/iframes/dialog-cross-origin-nn.html", "testing/web-platform/tests/close-watcher/iframes/dialog-cross-origin-ynn.html", "testing/web-platform/tests/close-watcher/iframes/dialog-cross-origin-ynyn.html"], "git_node": "4848676c4b3fa31120cc19569f8f26b0f9e9e363", "git_parents": ["c3108c9060485dcfa067e8beedba5792a8050e7b"], "node": "4187b6d79b199dd6c9417af725eb5cab0b9cca10", "parents": ["26e67e1f5672e7a4be76c7194147d262e371a17a"], "tags": []}, {"author": "Nikolas Zimmermann \u003cnzimmermann@igalia.com\u003e", "branch": "default", "desc": "Bug 2089427 [wpt PR 64454] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324426, a=testonly\n\nAutomatic update from web-platform-tests\nMap the outer svg transform attribute tests to web-features\n\nThis is the part of https://commits.webkit.org/321441@main that its export, #63701, didn't include.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324426\n\n--\n\nwpt-commits: 402ebc6e14466a6d4331d8b2dadc3b3adf482a13\nwpt-pr: 64454\n", "files": ["testing/web-platform/tests/svg/coordinate-systems/WEB_FEATURES.yml"], "git_node": "be234e426a1e710faeb0fe3c98d69616bfe558c8", "git_parents": ["4848676c4b3fa31120cc19569f8f26b0f9e9e363"], "node": "ce2a0858a76898e29b2ff053add66fe9ad675ca4", "parents": ["4187b6d79b199dd6c9417af725eb5cab0b9cca10"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2089428 [wpt PR 64457] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=277228, a=testonly\n\nAutomatic update from web-platform-tests\nfilter on an inline element does not apply to a block-level descendant\n\nThis adds a WPT test for the case where a filter set on an inline\nelement should apply to a block-level descendant, even when the inline\nancestor has no inline children of its own. The CSS `filter` property\nis non-inherited per css-filter-effects-1 \u2014 the descendants are not\n\"inheriting\" the filter; the filter applies to the element together\nwith its painting subtree, which includes the block descendant and its\nown inline grandchild.\n\nThe shape exercised is:\n    \u003ca filter\u003e \u2192 \u003cdiv\u003e \u2192 \u003cspan class=\"box\"\u003e\n\nWith the bug, the inline `\u003ca\u003e` had a zero bounding box (RenderInline\nwith no inline children), so the source image was never built and the\ndescendant never rendered through the filter. It is now fixed in\nWebKit, but no WPT test guarded the regression.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=277228\nWebKit-Canonical-Link: https://commits.webkit.org/315788@main\n\n--\n\nwpt-commits: ffdc36ac1b919543915d00b7eb55321faa3213d5\nwpt-pr: 64457\n", "files": ["testing/web-platform/tests/css/filter-effects/filtered-inline-applies-to-block-ref.html", "testing/web-platform/tests/css/filter-effects/filtered-inline-applies-to-block.html"], "git_node": "2e21b9acc7f7584dd4b7860a86a7c6d162cb3514", "git_parents": ["be234e426a1e710faeb0fe3c98d69616bfe558c8"], "node": "df84feb0c244342e4bd7e7b28f38bc5b91cedfa2", "parents": ["ce2a0858a76898e29b2ff053add66fe9ad675ca4"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2089429 [wpt PR 64456] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325275, a=testonly\n\nAutomatic update from web-platform-tests\nREGRESSION(309544@main): Elements with aspect-ratio don't shrink inside display flex\n\n309544@main made the flex container invalidate and recompute its items' intrinsic widths while measuring them.\nIn a column flex container the item still has the main-axis (height) overriding size from the previous layout,\nand with aspect-ratio that stale height turns into the old width, so the container (and the grid track it sits in) never shrinks.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325275\nWebKit-Canonical-Link: https://commits.webkit.org/321951@main\n\n--\n\nwpt-commits: 133d6b0b7978069d6d5b9a2c33234e9ae80c18be\nwpt-pr: 64456\n", "files": ["testing/web-platform/tests/css/css-sizing/aspect-ratio/flex-aspect-ratio-056-ref.html", "testing/web-platform/tests/css/css-sizing/aspect-ratio/flex-aspect-ratio-056.html"], "git_node": "ee83b41b00eeb3c74491b31f5eb4f11bdb7eb21a", "git_parents": ["2e21b9acc7f7584dd4b7860a86a7c6d162cb3514"], "node": "3b130d6a2c97f6986b2510e82d9a8f292b09b26f", "parents": ["df84feb0c244342e4bd7e7b28f38bc5b91cedfa2"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2089430 [wpt PR 64459] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=315560, a=testonly\n\nAutomatic update from web-platform-tests\nLine break should not appear after U+201D Right Double Quotation Mark\n\n  \u003cdiv style=\"font-family: Monospace; max-inline-size: 2em\"\u003e1 &rdquo;2\u003c/div\u003e\n\nThe text should wrap as \"1\" on the first line and \"&rdquo;2\" on the second.\nInstead it wrapped as \"1 &rdquo;\" on the first line and \"2\" alone on the\nsecond.\n\nBreakablePositions::classify mapped the single curly quotes (U+2018 and\nU+2019) to the kQU line break class but missed the double curly quotes.\nU+201C and U+201D fell through to kWeird and were deferred to ICU.\nCurrent ICU returned a break opportunity right after U+201D\n(predates LB19a which prohibits breaks adjacent to QU when neighbors are not East Asian;\nLB19a was added in ICU 76)\n\nThe fix adds Pi/Pf sub-flags to the QU class and implements LB19/LB19a\ndirectly in the fast path. Curly quotes and the angle quotation marks now\nclassify as kQU|kPi (initial) or kQU|kPf (final). When neither neighbor is\nEast Asian, LB19a forbids the break either side. When one neighbor is East\nAsian, LB19's [QU - Pi] / [QU - Pf] split decides: break before is allowed\nonly for an initial-class QU, break after is allowed only for a\nfinal-class QU. No ICU lookup is needed for QU pairs.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=315560\nWebKit-Canonical-Link: https://commits.webkit.org/314829@main\n\n--\n\nwpt-commits: 578e1faf2b6d4f5394a5e450427cf0a528162341\nwpt-pr: 64459\n", "files": ["testing/web-platform/tests/css/css-text/line-break/line-break-quotation-double-001.html", "testing/web-platform/tests/css/css-text/line-break/line-break-quotation-double-002.html", "testing/web-platform/tests/css/css-text/line-break/line-break-quotation-double-cjk-001.html", "testing/web-platform/tests/css/css-text/line-break/line-break-quotation-double-cjk-002.html", "testing/web-platform/tests/css/css-text/line-break/line-break-quotation-double-cjk-003.html", "testing/web-platform/tests/css/css-text/line-break/reference/line-break-quotation-double-001-ref.html", "testing/web-platform/tests/css/css-text/line-break/reference/line-break-quotation-double-002-ref.html", "testing/web-platform/tests/css/css-text/line-break/reference/line-break-quotation-double-cjk-001-ref.html", "testing/web-platform/tests/css/css-text/line-break/reference/line-break-quotation-double-cjk-002-ref.html", "testing/web-platform/tests/css/css-text/line-break/reference/line-break-quotation-double-cjk-003-ref.html"], "git_node": "70a72a44769c15d8a58ad66ee2cbebe4de857410", "git_parents": ["ee83b41b00eeb3c74491b31f5eb4f11bdb7eb21a"], "node": "f78db92b81b7385fdce1f36c6d2b300d827a1a44", "parents": ["3b130d6a2c97f6986b2510e82d9a8f292b09b26f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089430 [wpt PR 64459] - Update wpt metadata, a=testonly\n\nwpt-pr: 64459\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-text/line-break/line-break-quotation-double-cjk-001.html.ini", "testing/web-platform/meta/css/css-text/line-break/line-break-quotation-double-cjk-002.html.ini"], "git_node": "9e798b51f2571076fc7848f3a926c5d989b4ddbe", "git_parents": ["70a72a44769c15d8a58ad66ee2cbebe4de857410"], "node": "eac040c73981c648f80a4fffc799041fb3e43ec7", "parents": ["f78db92b81b7385fdce1f36c6d2b300d827a1a44"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjean-yves.avenard@apple.com\u003e", "branch": "default", "desc": "Bug 2089431 [wpt PR 64452] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=329352, a=testonly\n\nAutomatic update from web-platform-tests\nREGRESSION(314534@main) readyState doesn't move back to HAVE_METADATA when seeking to unbuffered zone (#64452)\n\nIn 314534@main, MediaPlayerPrivateMediaSourceAVFObjC::updateStateFromReadyState()\nwas made to exit early when still seeking.\nWhile it fixed the order in which the events were fired, it prevented the\nMediaPlayer to call HTMLMediaElement::mediaPlayerReadyStateChanged\nand so readyState didn't change, and more importantly the waiting event wasn't fired.\nIf a site (such as YouTube) was waiting on this event to load content, the\nseek would not complete.\nUnfortunately, that common scenario wasn't covered by any tests.\n\nThe BBC bug fixed by 314534@main was updateStateFromReadyState() calling stall()\nwhile seeking() was still true. The stall() landed on the renderer queue\nafter maybeCompleteSeek() had restored the rate, set it back to 0, and\nnothing restarted playback. The \"This also\ncoalesces the burst of intermediate waiting/canplay/playing events the\nBBC player observed across each rewind.\" was wrong. 314534@main didn't\ncoalesced events, it just blocked them until the seek completed.\n\nWe remove from MediaPlayerPrivateMediaSourceAVFObjC::updateStateFromReadyState\nthe role of resolving the seek promise and have it handle the readyState\ntransition only. It now correctly notifies the HTMLMediaElement that the\nMediaPlayer's readyState got update which in turn will fire the `waiting`\nevent as needed.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329352\nWebKit-Canonical-Link: https://commits.webkit.org/325111@main\n--\n\nwpt-commits: 0127bbf6649d0df4bc4c0d6d697f17661f8bf027\nwpt-pr: 64452\n", "files": ["testing/web-platform/tests/media-source/mediasource-seek-unbuffered-readystate.html"], "git_node": "bf2af47ffdb0ace3d906df2d0fd9bd5ca5058af2", "git_parents": ["9e798b51f2571076fc7848f3a926c5d989b4ddbe"], "node": "a6944d232561f40a43847cc9658844105cad3910", "parents": ["eac040c73981c648f80a4fffc799041fb3e43ec7"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2089432 [wpt PR 64458] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325844, a=testonly\n\nAutomatic update from web-platform-tests\nREGRESSION(291542@main): Layout stops updating inside nested scroll container after its classic scrollbar disappears (-webkit-line-clamp + absolutely positioned descendant)\n\n  \u003cdiv style=\"display: grid; height: 300px\"\u003e\n    \u003cdiv style=\"overflow-y: auto\"\u003e\n      \u003cdiv style=\"height: 100%; overflow-y: auto\"\u003e\n        \u003cdiv style=\"display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 1\"\u003e\n          \u003cspan style=\"display: block; position: relative\"\u003eRow\u003cspan style=\"position: absolute; inset: 0\"\u003e\u003c/span\u003e\u003c/span\u003e\n\nRows added to the inner scroller should be laid out. Instead, once its classic\nscrollbar had come or gone, new rows stayed 0px tall until the window was resized.\n\nThe grid runs the inner scroller's scrollbar relayout after both scrollers have\nfinished layout. In that relayout, line-clamp dirties the absolutely positioned\nbox together with its containing block chain, which leaves the outer scroller\nneeding layout under a clean grid, so every later change stops at it (since\n291542@main this mark is normalChildNeedsLayout; before, it was a simplified\nlayout bit that other changes went past).\n\nThe clamp lays its child out right after dirtying it, and the child lays out its\nout-of-flow boxes, so only dirty the boxes themselves.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325844\nWebKit-Canonical-Link: https://commits.webkit.org/324368@main\n\n--\n\nwpt-commits: 75e0bd8992f75b8860313eaf7b4de6262d287ff5\nwpt-pr: 64458\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/webkit-line-clamp-abspos-scrollbar-change.html"], "git_node": "1a0d623c7284f955f4ca501ab1a6790fdbe1a031", "git_parents": ["bf2af47ffdb0ace3d906df2d0fd9bd5ca5058af2"], "node": "bae6784dc3dbfa9b03dc54e48b00b85c5dca9a56", "parents": ["a6944d232561f40a43847cc9658844105cad3910"], "tags": []}, {"author": "Simon Fraser \u003csimon.fraser@apple.com\u003e", "branch": "default", "desc": "Bug 2089433 [wpt PR 64460] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=312584, a=testonly\n\nAutomatic update from web-platform-tests\nREGRESSION (303819@main): Child with filter:blur() ignores border radius overflow clipping\n\nWhen using the TransparencyLayerContextSwitcher path for filters, we need to be able\nto supply a complex clip for items clipped by border-radius on ancestors; this\nrequires running the code in `applyAncestorClippingForBorderRadius()` after\nsaving the graphics state, before starting the transparency layer, so factor\nthe code to allow this by passing a function to GraphicsContextSwitcher.\n\nThe previous attempt to fix this (312531@main) was reverted for causing rendering\nregressions of youtube buttons and on wayfair.com; this turned out to be a Core Graphics\naccelerated rendering bug (rdar://177036180) which we work around by applying the\nrounded clip in an outer transparency layer. `grayscale-clip-border-radius.html` tests\nthis workaround.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=312584\nWebKit-Canonical-Link: https://commits.webkit.org/313267@main\n\n--\n\nwpt-commits: 458d0f3658d5c5fb08f4cae5e3d1020e45e5d0b3\nwpt-pr: 64460\n", "files": ["testing/web-platform/tests/css/filter-effects/blur-clip-border-radius-ref.html", "testing/web-platform/tests/css/filter-effects/blur-clip-border-radius.html", "testing/web-platform/tests/css/filter-effects/grayscale-clip-border-radius-ref.html", "testing/web-platform/tests/css/filter-effects/grayscale-clip-border-radius.html"], "git_node": "b8a8431da798492920c22bfdd108bd75e5f8935b", "git_parents": ["1a0d623c7284f955f4ca501ab1a6790fdbe1a031"], "node": "cd5d84fa8481a9ca478332ce21bed31e59d81f67", "parents": ["bae6784dc3dbfa9b03dc54e48b00b85c5dca9a56"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2089434 [wpt PR 64465] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=262111, a=testonly\n\nAutomatic update from web-platform-tests\nBroken 'button' layout with display:table on www.weekly10.com\n\nWhen a table is a flex or grid item, the container can stretch it to\nmatch the tallest sibling. The stretched height is a \"border-box\"\nvalue -- it includes the table's border and padding on all sides.\n\nTo figure out how much space the rows get, we need to subtract the\nborder and padding from this stretched height. The code was only\nsubtracting the bottom border+padding, forgetting the top side.\nSo the table ended up too tall by exactly one side of padding\n(or border).\n\nThis includes the lint fixes from https://commits.webkit.org/325383@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=262111\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329678\nWebKit-Canonical-Link: https://commits.webkit.org/311276@main\n\n--\n\nwpt-commits: de24d06c7a6fbecf63ead6cc296dbab69ba46968\nwpt-pr: 64465\n", "files": ["testing/web-platform/tests/css/css-tables/table-stretch-in-flex-and-grid.html"], "git_node": "dc523f6b13e5a634eca3ed7e3c5451fb062f4db6", "git_parents": ["b8a8431da798492920c22bfdd108bd75e5f8935b"], "node": "a1bd48790cd63a92241bf7033adabd2c43a1ff93", "parents": ["cd5d84fa8481a9ca478332ce21bed31e59d81f67"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091092 [wpt PR 64466] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=9774, a=testonly\n\nAutomatic update from web-platform-tests\nElement Position is incorrect with regards to the ancestor box\n\nGiven:\n\n  \u003cdiv style=\"height: 500px\"\u003e\n      \u003cspan style=\"position: relative; top: -5%\"\u003e\u003cimg\u003e\u003c/span\u003e\n      \u003cdiv\u003e\u003c/div\u003e\n  \u003c/div\u003e\n\nThe image should be shifted up by 25px (5% of the 500px container).\nInstead it stays at its normal position -- the percentage is ignored.\n\nThe sibling \u003cdiv\u003e is the trigger. Without it, the span sits directly\ninside the 500px container and the offset works. With the sibling,\nthe render tree wraps the inline content in an anonymous block:\n\n  container (500px)\n      anonymous block (auto height)\n          span (position: relative, top: -5%)\n              img\n      div\n\nrelativePositionOffset() resolves percentage top against the\ncontaining block's height. The containing block for the span is the\nanonymous block, which has auto height. Percentage offsets against\nauto height resolve to 0, so the offset is lost.\n\nAnonymous blocks are a render tree implementation detail -- the\nauthor never created one. The fix skips them when looking up the\ncontaining block for relative position offset resolution, so the\npercentage resolves against the authored container (500px) instead.\n\nThis is a workaround until anonymous block construction is avoided\nentirely (webkit.org/b/307004).\n\nThis includes the lint fixes from https://commits.webkit.org/325383@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=9774\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329678\nWebKit-Canonical-Link: https://commits.webkit.org/311275@main\n\n--\n\nwpt-commits: ce11bbbb83344d1272997600bc3c1bef08b4f0e4\nwpt-pr: 64466\n", "files": ["testing/web-platform/tests/css/CSS2/positioning/relpos-percentage-offset-anonymous-block.html"], "git_node": "e295ab797fbf7cf3924f76e284a4ca196cf8ce9f", "git_parents": ["dc523f6b13e5a634eca3ed7e3c5451fb062f4db6"], "node": "7b8e8bd863dadd7ed9c7ae50fda16bfa5d07d572", "parents": ["a1bd48790cd63a92241bf7033adabd2c43a1ff93"], "tags": []}, {"author": "Taher Ali \u003ctaher_ali@apple.com\u003e", "branch": "default", "desc": "Bug 2089435 [wpt PR 64467] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=300411, a=testonly\n\nAutomatic update from web-platform-tests\nTest border-spacing computed values under SVG zoom\n\nThis test comes from two WebKit changes:\n- [CSS ZOOM] Apply zoom factor to border spacing (https://commits.webkit.org/301214@main). Its export, #55801, didn't include this test.\n- [CSS Zoom] Make `EvaluationTimeZoomEnabled` testable (https://commits.webkit.org/301236@main)\n\nThis includes the lint fixes from https://commits.webkit.org/325383@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=300026\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=300411\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329678\n\n--\n\nwpt-commits: 3e4b6a1e5a6eacca8216582aea72f91ac68a97ba\nwpt-pr: 64467\n", "files": ["testing/web-platform/tests/svg/styling/border-spacing-svg-zoom-computed.html"], "git_node": "5d6f8e715946559c2ce72d0976ed3d38a5b18082", "git_parents": ["e295ab797fbf7cf3924f76e284a4ca196cf8ce9f"], "node": "9d03b3b48e6ea83b32e605e1e72a0eed65dca457", "parents": ["7b8e8bd863dadd7ed9c7ae50fda16bfa5d07d572"], "tags": []}, {"author": "Youenn Fablet \u003cyouenn@apple.com\u003e", "branch": "default", "desc": "Bug 2089436 [wpt PR 64469] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=284099, a=testonly\n\nAutomatic update from web-platform-tests\nMediaStreamTrackProcessor::Source should not enqueue once it is closed\n\nStopping a track will close the readable stream of its MediaStreamTrackProcessor.\nWhen the track is VideoTrackGenerator and gets stopped, it will close synchronously the readable stream of the MediaStreamTrackProcessor observing the VideoTrackGenerator track.\nBut for video frames, we post a task to the worker thread (even though we are already in the worker thread).\nWe can thus enqueue video frames after stopping the readable stream.\n\nTo prevent this, we set m_isCancelled to true in MediaStreamTrackProcessor::Source::close.\nAs a small refactoring, we also move the m_isCancelled to MediaStreamTrackProcessor::tryEnqueueingVideoFrame to return earlier.\nWe add an ASSERT(m_isCancelled) in MediaStreamTrackProcessor::Source::enqueue.\n\nThis includes the lint fixes from https://commits.webkit.org/325383@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=284099\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329678\nWebKit-Canonical-Link: https://commits.webkit.org/287409@main\n\n--\n\nwpt-commits: 7037d03f02cb05f768c796414310f947655b656f\nwpt-pr: 64469\n", "files": ["testing/web-platform/tests/mediacapture-insertable-streams/MediaStreamTrackProcessor-stop.worker.js"], "git_node": "3fb6365a50f45c82b99642f2f908dc25fbfd399d", "git_parents": ["5d6f8e715946559c2ce72d0976ed3d38a5b18082"], "node": "e5352dd88c5f6217e50acc4e6af63a5e4cb715f1", "parents": ["9d03b3b48e6ea83b32e605e1e72a0eed65dca457"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089436 [wpt PR 64469] - Update wpt metadata, a=testonly\n\nwpt-pr: 64469\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/mediacapture-insertable-streams/MediaStreamTrackProcessor-stop.worker.js.ini"], "git_node": "5b0c5cdeb5624a6445071877b907576906c7d5a4", "git_parents": ["3fb6365a50f45c82b99642f2f908dc25fbfd399d"], "node": "c78b1e81b17a72836c138036da361aaa0c67a01b", "parents": ["e5352dd88c5f6217e50acc4e6af63a5e4cb715f1"], "tags": []}, {"author": "Simon Fraser \u003csimon.fraser@apple.com\u003e", "branch": "default", "desc": "Bug 2089437 [wpt PR 64463] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=311456, a=testonly\n\nAutomatic update from web-platform-tests\n[Scroll anchoring] learn.umgc.edu: scrolls to the bottom/top automatically\n\nThis page scrolls uncontrollably because there's a sidebar item whose `top`\nis set from script based on scroll position. This should not act as an anchor,\nbecause changing `top` should suppress anchoring.\n\nHowever, the code was only suppressing anchoring when the `Style::Difference`\nwas `\u003e Layout`, but this is a `LayoutOutOfFlowMovementOnly` because the anchor\nis positioned, so test against the diff types that can result from changes in\nthe suppression properties[1].\n\n[1] https://drafts.csswg.org/css-scroll-anchoring/#suppression-triggers\n\nThis includes the lint fixes from https://commits.webkit.org/325383@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=311456\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329678\nWebKit-Canonical-Link: https://commits.webkit.org/310574@main\n\n--\n\nwpt-commits: e703a88c4501dcf415603ae3c1845a36c767f24b\nwpt-pr: 64463\n", "files": ["testing/web-platform/tests/css/css-scroll-anchoring/suppress-for-top-change.html"], "git_node": "9672bfadc0aa3712e281eb9dd888f1efc292d399", "git_parents": ["5b0c5cdeb5624a6445071877b907576906c7d5a4"], "node": "a7c7eaa1f3066c294048c1820adca2afecfdcca7", "parents": ["c78b1e81b17a72836c138036da361aaa0c67a01b"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2089438 [wpt PR 64464] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=226002, a=testonly\n\nAutomatic update from web-platform-tests\n[Table] Incorrect distributed height when \u003ctd\u003e height is set\n\nWhen a table has a CSS height larger than its content, the extra height\nshould be distributed to rows. This works for rows with auto height, but\nfails for rows with an explicit height (e.g. \u003ctd height=1px\u003e). Instead\nof reaching 100px, the table ends up shorter.\n\nThe problem is in distributeRemainingExtraLogicalHeight, which\ndistributes leftover height proportionally to existing row sizes. It used\nm_rowPos[totalRows] as the total size, but m_rowPos includes\nborder-spacing -- both the initial spacing before the first row and the\nspacing between rows. When computing each row's share, the spacing\nportion absorbs some of the extra height that should go entirely to rows.\n\nFor example, with one row of height 4px and border-spacing 2px:\ntotalRowSize = 6 (includes 2px spacing), row share = 94 * 4/6 = 62.66.\nThe remaining 31px is silently lost.\n\nThe fix adds a rowLogicalHeight() helper that returns the actual row\nheight excluding border-spacing, and uses it for proportional\ndistribution. Row heights are pre-computed into a vector before the\ndistribution loop since the loop modifies m_rowPos (reading\nrowLogicalHeight during the loop would use already-modified values,\nproducing wildly negative weights). When all rows are zero-height,\nit distributes equally instead of doing nothing.\n\nAlso fixed the same spacing-included-in-row-height issue in\ndistributeExtraLogicalHeightToPercentRows.\n\nThis includes the lint fixes from https://commits.webkit.org/325383@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=226002\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329678\nWebKit-Canonical-Link: https://commits.webkit.org/311001@main\n\n--\n\nwpt-commits: de391d4b2418fcf6ae22f1c1e31a5238a0f97aa2\nwpt-pr: 64464\n", "files": ["testing/web-platform/tests/css/css-tables/table-height-distribution-proportional.html", "testing/web-platform/tests/css/css-tables/table-height-distribution-with-border-spacing-ref.html", "testing/web-platform/tests/css/css-tables/table-height-distribution-with-border-spacing.html"], "git_node": "17ab561c459f5dfb61f7e29b6d40d9c27d34795c", "git_parents": ["9672bfadc0aa3712e281eb9dd888f1efc292d399"], "node": "75b00185506b36a8d425cba81191cd69d6f16bc3", "parents": ["a7c7eaa1f3066c294048c1820adca2afecfdcca7"], "tags": []}, {"author": "Simon Fraser \u003csimon.fraser@apple.com\u003e", "branch": "default", "desc": "Bug 2089439 [wpt PR 64472] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=308788, a=testonly\n\nAutomatic update from web-platform-tests\n[Scroll Anchoring] Reddit page becomes blank and jumps to top after clicking \"View more comments\"\n\nOn the reddit page, there's an intermediate state where the wrapper for the comments (`SHREDDIT-COMMENT-TREE`)\nhas its content removed; its only child is a flexbox which has not been laid out yet, so we pick the wrapper\nas the anchor. The wrapper happens to have large overflow into negative top and left, and this overflow\nchanges pre- to post-layout, so anchoring goes haywire.\n\nFix by trimming negative overflow when computing the local anchor rect; we actually just use the anchor's\nborder box, extended in the block direction by layout overflow (since anchoring only affects scrolling on\nthe block progression axis).\n\nAdded two new tests. `negative-layout-overflow-on-anchor.html` tests anchoring with changing negative\noverflow on the anchor. `anchor-used-height-change-does-not-suppress.html` was added to test another scenario\nI investigated while coming up with the fix, which is an anchor whose used height changes; in all browsers\nthis does not suppress anchoring.\n\nThis includes the lint fixes from https://commits.webkit.org/325383@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=308788\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329678\nWebKit-Canonical-Link: https://commits.webkit.org/308352@main\n\n--\n\nwpt-commits: beaf2cb6a056dde76dfabe7e0f7bc5910c7e9dbe\nwpt-pr: 64472\n", "files": ["testing/web-platform/tests/css/css-scroll-anchoring/anchor-used-height-change-does-not-suppress.html", "testing/web-platform/tests/css/css-scroll-anchoring/negative-layout-overflow-on-anchor.html"], "git_node": "0fa87cf14c66b8c3615b376593589af02bfbb214", "git_parents": ["17ab561c459f5dfb61f7e29b6d40d9c27d34795c"], "node": "ba86b5b96fc9449f098369e8b4999c4833918557", "parents": ["75b00185506b36a8d425cba81191cd69d6f16bc3"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2089441 [wpt PR 64471] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=301358, a=testonly\n\nAutomatic update from web-platform-tests\nUnderline appears on top of the line instead of under in horizontal writing mode\n\nIn vertical writing-modes, 'text-underline-position: right' forces the line to be placed on the right side of the text. In horizontal writing-modes, it is a synonym of auto.\n\nThis includes the lint fixes from https://commits.webkit.org/325383@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=301358\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329678\nWebKit-Canonical-Link: https://commits.webkit.org/302051@main\n\n--\n\nwpt-commits: 3a4fb3c07ee65fe2996dfe3c8b9d185965361102\nwpt-pr: 64471\n", "files": ["testing/web-platform/tests/css/css-text-decor/reference/text-underline-position-horizontal2-ref.html", "testing/web-platform/tests/css/css-text-decor/text-underline-position-horizontal2.html"], "git_node": "211148b7c62a375acf902c49afdd8f0cee55ea26", "git_parents": ["0fa87cf14c66b8c3615b376593589af02bfbb214"], "node": "423e8d165e8780e0684cfcfaffd29e68545a7d7d", "parents": ["ba86b5b96fc9449f098369e8b4999c4833918557"], "tags": []}, {"author": "Chris Dumez \u003ccdumez@apple.com\u003e", "branch": "default", "desc": "Bug 2089442 [wpt PR 64470] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=243227, a=testonly\n\nAutomatic update from web-platform-tests\n[EventSource] Stop allowing trailing junk when parsing retry delay\n\nStop allowing trailing junk when parsing retry delay for EventSource:\n- https://html.spec.whatwg.org/multipage/server-sent-events.html#processField\n\nThis aligns our behavior with Blink and Gecko.\n\nThis includes the lint fixes from https://commits.webkit.org/325383@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=243227\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329678\nWebKit-Canonical-Link: https://commits.webkit.org/252885@main\n\n--\n\nwpt-commits: 4f77d3a5b3bcbbfa0ccdc28b36166b1eacab858c\nwpt-pr: 64470\n", "files": ["testing/web-platform/tests/eventsource/format-field-retry-bogus-2.any.js"], "git_node": "b208f15f5265839eac57eb45239d7dd50cdc1591", "git_parents": ["211148b7c62a375acf902c49afdd8f0cee55ea26"], "node": "aed1d10f2af53da3646a75d4a90a00eff3d777e1", "parents": ["423e8d165e8780e0684cfcfaffd29e68545a7d7d"], "tags": []}, {"author": "Simon Fraser \u003csimon.fraser@apple.com\u003e", "branch": "default", "desc": "Bug 2089443 [wpt PR 64468] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=312277, a=testonly\n\nAutomatic update from web-platform-tests\n[Scroll anchoring] Transform changes fail to suppress anchoring sometimes\n\nA transform change results in a `Style::DifferenceResult::Overflow` or `RecompositeLayer`,\nso we need to all `scrollAnchoringSuppressionStyleDidChange()` for this diff type.\n\nThe test needs to change both height of a sibling, and transform on the wrapper,\nbecause the transform change alone never results in anchoring adjustments; this is\nbecause the before-layout transform already has the new state, since RenderLayer\nupdates its transform on style change. But this isn't a problem, since transform\nchanges suppress anchoring anyway.\n\nThis includes the lint fixes from https://commits.webkit.org/325383@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=312277\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329678\nWebKit-Canonical-Link: https://commits.webkit.org/311253@main\n\n--\n\nwpt-commits: daf3c54e731f04b78fec4599985f8a131ef1cd07\nwpt-pr: 64468\n", "files": ["testing/web-platform/tests/css/css-scroll-anchoring/suppress-for-transform-change.html"], "git_node": "e9834afef9be327f604f09797b61145c2020fa89", "git_parents": ["b208f15f5265839eac57eb45239d7dd50cdc1591"], "node": "6c7dc15b0d69364bf42ea2a2415bf966310d20cf", "parents": ["aed1d10f2af53da3646a75d4a90a00eff3d777e1"], "tags": []}, {"author": "Zak Ridouh \u003czakr@apple.com\u003e", "branch": "default", "desc": "Bug 2089444 [wpt PR 64473] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=308576, a=testonly\n\nAutomatic update from web-platform-tests\nRemove `deprecatedIsLeftToRightDirection()` usage from `TextFieldInputType::elementDidBlur()`\n\nFix text input blur scroll for vertical writing modes\n\nThis includes the lint fixes from https://commits.webkit.org/325383@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=308576\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329678\nWebKit-Canonical-Link: https://commits.webkit.org/309776@main\n\n--\n\nwpt-commits: 2e4dc257cfbe254ff8449e291cc231f0989b2d38\nwpt-pr: 64473\n", "files": ["testing/web-platform/tests/css/css-writing-modes/forms/text-input-scroll-on-blur.html"], "git_node": "cbb04f8ab7213df36a615afafea8cdf2dfdafd3a", "git_parents": ["e9834afef9be327f604f09797b61145c2020fa89"], "node": "68e295ae95d733cec887ddae07ffd28167294ae5", "parents": ["6c7dc15b0d69364bf42ea2a2415bf966310d20cf"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089444 [wpt PR 64473] - Update wpt metadata, a=testonly\n\nwpt-pr: 64473\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-writing-modes/forms/text-input-scroll-on-blur.html.ini"], "git_node": "a7d67bdf95927d523ca94e7400e0ad2df1b5d689", "git_parents": ["cbb04f8ab7213df36a615afafea8cdf2dfdafd3a"], "node": "dddf22967d0a95389e596e8fa96d4f9995a2f434", "parents": ["68e295ae95d733cec887ddae07ffd28167294ae5"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2089445 [wpt PR 64476] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321297, a=testonly\n\nAutomatic update from web-platform-tests\nRoot font relative units in canvas ctx.font resolve against the canvas element instead of the root element (#64476)\n\nStyle::resolveLength()'s DirectDataAdaptor took a single FontCascade and returned it from both\nfontCascadeForFontUnits() and fontCascadeForRootFontUnits(), so 'rem' was an alias for 'em'. With\n`html { font-size: 5px }` and a canvas element at 20px, `ctx.font = \"2rem sans-serif\"` produced 40px\nrather than the correct 10px. The sibling CSSToLengthConversionData adaptor already gets this right\nvia conversionData.rootStyle().\n\nGive DirectDataAdaptor a second FontCascade for the root font and return it from\nfontCascadeForRootFontUnits(). That one accessor feeds all five root font relative units, so rex,\nrcap, rch and ric are fixed along with rem. Style::resolveLength() grows a matching required parameter;\ncallers with no separate root font, such as a worker, pass the element's font for both.\n\nAdd Style::rootFontCascadeForRootFontUnits(), which returns the document element's\nexistingComputedStyle()-\u003efontCascade(). It deliberately never resolves style: callers run under\nScriptDisallowedScope and the entry points are responsible for flushing.\n\nRecording the root font also has to be part of the memoization in\nCanvasRenderingContext2D::setFontWithoutUpdatingStyle(). It compared only the canvas element's font\ndescription, which does not observe a root font-size change, so `ctx.font = \"2rem X\"` assigned twice\nacross a root restyle would stay stale.\n\nHTML does not yet say how non-absolute \u003clength\u003e values behave here; that is open in\nhttps://github.com/whatwg/html/issues/10893, where one suggestion is that the root font relative\nunits simply alias the non-root ones. Resolving them against the root element is what they mean in\nCSS and what the CSSToLengthConversionData path already does for the document case, so take that\nfor now. Viewport and container units, and the fully detached OffscreenCanvas case, are left alone.\n\nctx.letterSpacing and ctx.wordSpacing reach the same resolveLength overload and have the same bug,\nbut fixing them needs those setters to update style first, which is a larger change; they pass the\ncontext's font for both for now with a FIXME.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321297\nWebKit-Canonical-Link: https://commits.webkit.org/325391@main\n--\n\nwpt-commits: ccd75f87062ff5c5e2f1740995774597921cecbf\nwpt-pr: 64476\n", "files": ["testing/web-platform/tests/html/canvas/element/2d.text-root-font-relative-units.html"], "git_node": "0d6f5359e594a54d11347b72e535f0d2fea49f3b", "git_parents": ["a7d67bdf95927d523ca94e7400e0ad2df1b5d689"], "node": "10ddf7c17513dd2e8f99dba84f22ea8d4544d182", "parents": ["dddf22967d0a95389e596e8fa96d4f9995a2f434"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089445 [wpt PR 64476] - Update wpt metadata, a=testonly\n\nwpt-pr: 64476\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/2d.text-root-font-relative-units.html.ini"], "git_node": "a49a6cdd4eb00979806b32782d5231695256f80a", "git_parents": ["0d6f5359e594a54d11347b72e535f0d2fea49f3b"], "node": "4f5faffa645a33eb428d1680945006a58c2b380f", "parents": ["10ddf7c17513dd2e8f99dba84f22ea8d4544d182"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2089661 [wpt PR 64477] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=187799, a=testonly\n\nAutomatic update from web-platform-tests\nSVG \u003ca\u003e, \u003cg\u003e and inner \u003csvg\u003e don't render outline (including default :focus ring) (#64477)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromum.\n\nSelfOutline phases (\"SVG outlines are painted during Foreground\") and only\npasses Foreground to its children, so a legacy container never received\nSelfOutline and its outline was never drawn. Shapes and images are unaffected\nbecause they call paintOutline() from their Foreground paint.\n\nPaint the container's outline during the Foreground phase instead, matching\nLegacyRenderSVGShape and LegacyRenderSVGImage. This makes outlines (including\nthe default focus ring on a focused \u003ca\u003e) visible on \u003ca\u003e, \u003cg\u003e and nested \u003csvg\u003e.\n\nNOTE: Layer Based SVG engine does not have this bug.\n\nThanks Karl for testcases.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=187799\nWebKit-Canonical-Link: https://commits.webkit.org/325259@main\n--\n\nwpt-commits: bdcdab01d8998ee249e4b8b7adbedc1d4e61638e\nwpt-pr: 64477\n", "files": ["testing/web-platform/tests/css/css-ui/outline-svg-a-001.html", "testing/web-platform/tests/css/css-ui/outline-svg-container-001-ref.html", "testing/web-platform/tests/css/css-ui/outline-svg-container-auto-001-ref.html", "testing/web-platform/tests/css/css-ui/outline-svg-g-001.html", "testing/web-platform/tests/css/css-ui/outline-svg-g-auto-001.html", "testing/web-platform/tests/css/css-ui/outline-svg-nested-svg-001.html"], "git_node": "bb186e828506de1b75a4337402609bb8761390f9", "git_parents": ["a49a6cdd4eb00979806b32782d5231695256f80a"], "node": "fd41fb418b3f1af908e31861a430fca55d375d0d", "parents": ["4f5faffa645a33eb428d1680945006a58c2b380f"], "tags": []}, {"author": "Joseph Zhao \u003czhaozihan542259545@gmail.com\u003e", "branch": "default", "desc": "Bug 2089693 [wpt PR 64462] - script: Use `encoding_parse_a_url` in `HTMLMediaElement` resource selection, a=testonly\n\nAutomatic update from web-platform-tests\nscript: Use encoding_parse_a_url in HTMLMediaElement resource selection\n\nSigned-off-by: Joseph Zhao \u003czhaozihan542259545@gmail.com\u003e\n\n--\n\nwpt-commits: 9a130f49b8061b8e82e1ddb50c2840d5dd09ad69\nwpt-pr: 64462\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/media-elements/loading-the-media-resource/resource-selection-encoding-parse.html"], "git_node": "60754f0b9653701e4064a69115475007f38ac3b5", "git_parents": ["bb186e828506de1b75a4337402609bb8761390f9"], "node": "5c2a4272c8bae962399dd5ca4d4a084595709844", "parents": ["fd41fb418b3f1af908e31861a430fca55d375d0d"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2089698 [wpt PR 64479] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327945, a=testonly\n\nAutomatic update from web-platform-tests\n[Flex] A multi-line column flex container's max-content width is its widest item, not the sum of its lines\n\nCSS Flexbox 9.9.2: a multi-line column container's max-content width is the sum of the cross sizes of the flex lines it gets under a cross-axis max-content constraint, plus the gaps.\nWe used its widest item, as if the items stayed on a single line.\n\nFlexLayout::maximumContentSizeForMultilineColumn now runs flex steps 9.2 to 9.4 #8 with each item at its max-content width and sums the line cross sizes and gaps.\nIt skips this when the items can't wrap and none is baseline-aligned; percentages resolve against zero, and the cached block sizes stay untouched.\nItems laid out this way are marked for layout, and so is the container, since grid and flex parents can ask a laid-out container again.\nGrid now lays out dirty baseline-aligned items before each track sizing pass, and css3/flexbox multiline tests expect the summed line widths.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327945\nWebKit-Canonical-Link: https://commits.webkit.org/324662@main\n\n--\n\nwpt-commits: b8175818d704f2e4df6d11ef70cbdf94923b64de\nwpt-pr: 64479\n", "files": ["testing/web-platform/tests/css/css-flexbox/intrinsic-size/col-wrap-baseline-001.html", "testing/web-platform/tests/css/css-flexbox/intrinsic-size/col-wrap-calc-size-001.html", "testing/web-platform/tests/css/css-flexbox/intrinsic-size/col-wrap-grid-item-001.html", "testing/web-platform/tests/css/css-flexbox/intrinsic-size/col-wrap-percentage-001.html"], "git_node": "210a2a83b9a31eed1c7679dc021597df1357f67c", "git_parents": ["60754f0b9653701e4064a69115475007f38ac3b5"], "node": "7c73aa20824bb0f762b06711627445a12b36b288", "parents": ["5c2a4272c8bae962399dd5ca4d4a084595709844"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089698 [wpt PR 64479] - Update wpt metadata, a=testonly\n\nwpt-pr: 64479\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-flexbox/intrinsic-size/col-wrap-baseline-001.html.ini", "testing/web-platform/meta/css/css-flexbox/intrinsic-size/col-wrap-calc-size-001.html.ini", "testing/web-platform/meta/css/css-flexbox/intrinsic-size/col-wrap-percentage-001.html.ini"], "git_node": "1a5dedd17f449e8d634ec8bda4aecf36f54c4eef", "git_parents": ["210a2a83b9a31eed1c7679dc021597df1357f67c"], "node": "3dc005d5846b839dba43f7c649ca670900a9ab67", "parents": ["7c73aa20824bb0f762b06711627445a12b36b288"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2089712 [wpt PR 64478] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328596, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] Inline-block with an overflow: hidden block inside an inline box gets the wrong baseline\n\n  \u003cdiv style=\"display: flex; align-items: center; height: 60px\"\u003e\n    \u003cdiv\u003e\u003cdiv style=\"display: inline-block; height: 40px\"\u003e\n      \u003cspan\u003eDetails\u003cdiv style=\"height: 0; overflow: hidden\"\u003eDetails\u003c/div\u003e\u003c/span\u003e\n    \u003c/div\u003e\u003c/div\u003e\n  \u003c/div\u003e\n\nThe inline-block should be vertically centered in the bar. Instead it was\npushed up past the bar's top edge - its baseline came from the line inside the\nclipped block, below the inline-block's bottom edge.\n\nThe clipped block sits inside the \u003cspan\u003e (block-in-inline), so the baseline\nlookup goes through LineLayout::lastLineBaseline, which asked the block for its\nown last line. CSS Align says a block container that is a scroll container has\nits last baseline at its block-end margin edge.\n\nApply that rule in the block-in-inline branch of LineLayout::lastLineBaseline,\nsame as RenderBlock::lastLineBaseline does for block-level children.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328596\nWebKit-Canonical-Link: https://commits.webkit.org/324661@main\n\n--\n\nwpt-commits: 655c8bf3a3622eaa8870ef69fb61723a75b85af6\nwpt-pr: 64478\n", "files": ["testing/web-platform/tests/css/css-align/baseline-rules/overflow-hidden-block-in-inline-baseline-ref.html", "testing/web-platform/tests/css/css-align/baseline-rules/overflow-hidden-block-in-inline-baseline.html"], "git_node": "2f2af66abb2c0f0e9ad173bb34914b8d0869f4fa", "git_parents": ["1a5dedd17f449e8d634ec8bda4aecf36f54c4eef"], "node": "8f513f055fbc10be21674482dc7db15ed5111bd1", "parents": ["3dc005d5846b839dba43f7c649ca670900a9ab67"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091239 [wpt PR 64481] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328483, a=testonly\n\nAutomatic update from web-platform-tests\ncalc-size(auto, size) makes an aspect-ratio box wider than max-content when a child has a percentage height\n\nRenderBox computed intrinsic widths for calc-size() on an auto width, and for an out-of-flow box's aspect-ratio automatic minimum, without IntrinsicLogicalWidthComputationScope.\nSo an aspect-ratio box took its height from its stale width, a child's percentage height resolved, and calc-size(auto, size) differed from max-content.\n\nBoth paths now set the scope, like the min-content and max-content contribution getters do.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328483\nWebKit-Canonical-Link: https://commits.webkit.org/324649@main\n\n--\n\nwpt-commits: 92bdec645a42caefe237403244f5e92ac7b43f05\nwpt-pr: 64481\n", "files": ["testing/web-platform/tests/css/css-values/calc-size/calc-size-aspect-ratio-percentage-height-001.html"], "git_node": "98bf16155fef29822d4b7db8067cae8491867e7e", "git_parents": ["2f2af66abb2c0f0e9ad173bb34914b8d0869f4fa"], "node": "fba52c3753265c7c2fa11d23b61251ad3f560f09", "parents": ["8f513f055fbc10be21674482dc7db15ed5111bd1"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091240 [wpt PR 64482] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328556, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] An orthogonal block level box in an inline box adds its top and bottom margins to its container's width\n\nFinding an orthogonal box's block size lays out its content, which rewrites the box's only BoxGeometry in the box's\nown writing mode. The container's intrinsic width then gets the box's top and bottom margins instead of its left and\nright ones.\n\nPut the geometry the line has for the box back once the render tree is done with it. Layout handles the same overlap\nin BoxGeometryUpdater::updateBoxGeometryAfterIntegrationLayout.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328556\nWebKit-Canonical-Link: https://commits.webkit.org/324652@main\n\n--\n\nwpt-commits: cc0e4e8314ce66c20beaf5bffa23ab5fcee2f84d\nwpt-pr: 64482\n", "files": ["testing/web-platform/tests/css/css-writing-modes/orthogonal-block-in-inline-inline-size-002.html"], "git_node": "c20285f9817020054d95398d33c0d798e6b3ea2b", "git_parents": ["98bf16155fef29822d4b7db8067cae8491867e7e"], "node": "9d36a89b0a9277b319612a16dd140bf770f61df5", "parents": ["fba52c3753265c7c2fa11d23b61251ad3f560f09"], "tags": []}, {"author": "Sam Weinig \u003csam@webkit.org\u003e", "branch": "default", "desc": "Bug 2091243 [wpt PR 64484] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328791, a=testonly\n\nAutomatic update from web-platform-tests\n[Image Redux] An image URL's fragment directive hides the fragment before it\n\nRemoves the fragment directive from a URL before passing the fragment to an SVG image. For example, an image URL\nlike foo.svg#box:~:param(--bg, green) was previously passing \"box:~:param(--bg, green)\" to the SVG element as\nthe target and now just passes \"box\" (the \"param(--bg, green)\" is passed separately as link parameters already).\nNo spec says whether this is the correct behavior, but it really is the only thing that makes sense. I have filed\nhttps://github.com/w3c/csswg-drafts/issues/14656 to track getting the specs updated.\n\nAlso removes CursorImage's override of drawingExtrasForRenderer() which was unnecessary and incomplete. Instead,\nthe default implementation in MultiImage that forwards is used.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328791\nWebKit-Canonical-Link: https://commits.webkit.org/324650@main\n\n--\n\nwpt-commits: 731ba61c731bfac3e868625d6ecb68317d4ff9f6\nwpt-pr: 64484\n", "files": ["testing/web-platform/tests/svg/styling/css-linked-parameters/link-parameters-fragment-identifier-background.html", "testing/web-platform/tests/svg/styling/css-linked-parameters/link-parameters-fragment-identifier-ref.html", "testing/web-platform/tests/svg/styling/css-linked-parameters/link-parameters-fragment-identifier.html", "testing/web-platform/tests/svg/styling/css-linked-parameters/resources/target.svg"], "git_node": "03a27c40532a9cf481a1cf489acd662ff8566fa2", "git_parents": ["c20285f9817020054d95398d33c0d798e6b3ea2b"], "node": "d1241ab8c0c553f5f272b38c169f84247e005340", "parents": ["9d36a89b0a9277b319612a16dd140bf770f61df5"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091243 [wpt PR 64484] - Update wpt metadata, a=testonly\n\nwpt-pr: 64484\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/styling/css-linked-parameters/link-parameters-fragment-identifier-background.html.ini", "testing/web-platform/meta/svg/styling/css-linked-parameters/link-parameters-fragment-identifier.html.ini"], "git_node": "b7879e67b8e3a306ef87eaa58dc4b200d667273a", "git_parents": ["03a27c40532a9cf481a1cf489acd662ff8566fa2"], "node": "23dda3ab7db969a11b3b476dc625719c15595957", "parents": ["d1241ab8c0c553f5f272b38c169f84247e005340"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091244 [wpt PR 64483] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328593, a=testonly\n\nAutomatic update from web-platform-tests\nteams.microsoft.com: `New Meeting` & `Details` text is shifted upward while creating new meeting\n\n  \u003cdiv style=\"display: flex; align-items: center; height: 60px\"\u003e\n    \u003cdiv\u003e\u003cbutton style=\"height: 40px\"\u003eDetails\u003c/button\u003e\u003c/div\u003e\n  \u003c/div\u003e\n  button::after { content: \"Details\"; display: block; height: 0; overflow: hidden }\n\nThe button should be vertically centered in the bar. Instead it was pushed up\npast the bar's top edge - the button's baseline came from the line inside the\nclipped ::after, below the button's bottom edge, so the line box (and the\nflex item) grew taller than the bar.\n\nThe button's baseline comes from RenderBlock::lastLineBaseline on its anonymous\ninner block, which descended into the overflow: hidden child and took the line\ninside it. CSS Align says a block container that is a scroll container has its\nlast baseline at its block-end margin edge (an inline-block \u003cdiv\u003e with the same\ncontent already did this through lastInflowBoxBaseline).\n\nApply that rule to scroll container children in RenderBlock::lastLineBaseline.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328593\nWebKit-Canonical-Link: https://commits.webkit.org/324653@main\n\n--\n\nwpt-commits: a440b89e3667f38770aaab4212d00235a055927f\nwpt-pr: 64483\n", "files": ["testing/web-platform/tests/html/rendering/widgets/button-layout/overflow-hidden-block-child-baseline-ref.html", "testing/web-platform/tests/html/rendering/widgets/button-layout/overflow-hidden-block-child-baseline.html"], "git_node": "2cbf13a52339b8714d2673f66e0f86503332a943", "git_parents": ["b7879e67b8e3a306ef87eaa58dc4b200d667273a"], "node": "825fe19f7ad513542b56cdd785052bb01e50a525", "parents": ["23dda3ab7db969a11b3b476dc625719c15595957"], "tags": []}, {"author": "Taher Ali \u003ctaher_ali@apple.com\u003e", "branch": "default", "desc": "Bug 2091249 [wpt PR 64485] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327450, a=testonly\n\nAutomatic update from web-platform-tests\n[HTML-in-Canvas] Make a canvas with drawable content a stacking context\n\nDrawable elements are stacking contexts, but the canvas containing them was\nnot. Their layers were therefore ordered in the stacking context outside the\ncanvas, so their repaints did not reach the canvas and did not fire the paint\nevent.\n\nIn this PR we give a canvas with drawable content a stacking context.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327450\nWebKit-Canonical-Link: https://commits.webkit.org/323821@main\n\n--\n\nwpt-commits: 8b64f146d963ded3af218aba1fb250712138f59c\nwpt-pr: 64485\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/canvas-content-drawable-stacking-context.tentative-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/canvas-content-drawable-stacking-context.tentative.html"], "git_node": "ec22c945e4c96911410dbad07be4b9d5a783289a", "git_parents": ["2cbf13a52339b8714d2673f66e0f86503332a943"], "node": "5f9dc6c3ef793f4324d9036f97c3f59d17aa903e", "parents": ["825fe19f7ad513542b56cdd785052bb01e50a525"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091250 [wpt PR 64480] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328582, a=testonly\n\nAutomatic update from web-platform-tests\n[Flex] A percentage gap grows a flex container's intrinsic width each time it is computed\n\nA percentage column-gap resolved against the container's width from its last layout, even while that width was being computed.\nSo each recomputation of the max-content width added the previous gap, growing the width.\n\nWhile the container's intrinsic widths are computed, an inline-axis percentage gap now resolves against zero, as css-align-3 8.3 says.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328582\nWebKit-Canonical-Link: https://commits.webkit.org/324665@main\n\n--\n\nwpt-commits: 8b01ea13ebbe0f7fdd56e58b3270472d85160193\nwpt-pr: 64480\n", "files": ["testing/web-platform/tests/css/css-flexbox/intrinsic-size/percentage-gap-001.html"], "git_node": "5ffa6246b4833ccda8bbfcf11c25a92360343e10", "git_parents": ["ec22c945e4c96911410dbad07be4b9d5a783289a"], "node": "c29fb46d3edf76456e87ebffe0b13ba872b1aa5a", "parents": ["5f9dc6c3ef793f4324d9036f97c3f59d17aa903e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091250 [wpt PR 64480] - Update wpt metadata, a=testonly\n\nwpt-pr: 64480\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-flexbox/intrinsic-size/percentage-gap-001.html.ini"], "git_node": "2b59e9ad2fbe51d34e7c19d8eb467f0a923200a5", "git_parents": ["5ffa6246b4833ccda8bbfcf11c25a92360343e10"], "node": "057ce4b82cf1c91ee295cc26a1b46cdc8223884d", "parents": ["c29fb46d3edf76456e87ebffe0b13ba872b1aa5a"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091255 [wpt PR 64487] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321091, a=testonly\n\nAutomatic update from web-platform-tests\n[block-in-inline] Margin after a block level box on a line is lost on relayout\n\nLaying the block level box out is what produces the margin it hands to the lines after it. A partial layout\nthat resumes at a later line never re-runs the block, so the rest of the content runs with an empty margin\nstate and the margin is simply dropped. partialContentTop compounds it: it is derived from the previous\nline's lineBoxLogicalRect().maxY(), which excludes the margin.\n\nBail to a full layout when any line before the damaged one holds a block level box. This is conservative\nbut the alternative is replaying the margin contribution of every preceding block level line without\nlaying those blocks out.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321091\nWebKit-Canonical-Link: https://commits.webkit.org/318660@main\n\n--\n\nwpt-commits: 7451f934649c023cdfcfc3261c03220c625a0884\nwpt-pr: 64487\n", "files": ["testing/web-platform/tests/css/CSS2/normal-flow/block-in-inline-margin-after-relayout-001.html", "testing/web-platform/tests/css/CSS2/normal-flow/block-in-inline-margin-after-relayout-002.html"], "git_node": "5a0a151253da5aeeeb8ed0d74315bf083428933a", "git_parents": ["2b59e9ad2fbe51d34e7c19d8eb467f0a923200a5"], "node": "fe7370865298bcce0b03c9f616bc6d7a0decb9ca", "parents": ["057ce4b82cf1c91ee295cc26a1b46cdc8223884d"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091256 [wpt PR 64488] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321090, a=testonly\n\nAutomatic update from web-platform-tests\n[anon-block-removal] Empty editable container with only an out-of-flow child loses its line\n\nWhen the first child is attached, RenderTreeBuilder::Block::attach seeds the container's childrenInline()\nfrom that child. An out-of-flow child is not in the flow, though, so it says nothing about whether the\ncontainer's children are inline, and letting it answer the question turns childrenInline() off for a\ncontainer that has no in-flow content at all.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321090\nWebKit-Canonical-Link: https://commits.webkit.org/318671@main\n\n--\n\nwpt-commits: 0d8bbf7b880157fcbe8c2e7c7850711ca38cf3d1\nwpt-pr: 64488\n", "files": ["testing/web-platform/tests/editing/other/editing-host-with-only-out-of-flow-child.html"], "git_node": "c3c5b05b7651b3dbb20dcea34cc1589a1f9c2203", "git_parents": ["5a0a151253da5aeeeb8ed0d74315bf083428933a"], "node": "2feec33c4077f7cbc00dabc65d531ac6a185ec4a", "parents": ["fe7370865298bcce0b03c9f616bc6d7a0decb9ca"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2091261 [wpt PR 64489] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=319155, a=testonly\n\nAutomatic update from web-platform-tests\n[WebVTT] A cue wrongly inherits a preceding line as its identifier across a REGION or STYLE block\n\nWebVTTParser::collectWebVTTBlock() buffers a candidate cue-identifier line\nin m_previousLine while collecting a WebVTT block. When the block then turns\nout to be a region or style block, m_previousLine was left untouched, so the\nstray line survived across the block and was later applied as the identifier\nof the next cue that had no identifier of its own.\n\nPer the \"collect a WebVTT block\" algorithm [1], a REGION/STYLE block is only\nrecognized when it is the first line of the block; a line preceding it makes\nthe whole block a no-op, and the following cue's identifier is the (empty)\nbuffer. Clear m_previousLine when a region or style block is started so the\nbuffered line is not carried over.\n\nThis matches Firefox on both cases and Chrome on the region case (Chrome has\na separate bug in the style case).\n\n[1] https://w3c.github.io/webvtt/#collect-a-webvtt-block\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=319155\nWebKit-Canonical-Link: https://commits.webkit.org/317811@main\n\n--\n\nwpt-commits: 37b588fb31b8e45d54a605518d7bc2db83b45b8d\nwpt-pr: 64489\n", "files": ["testing/web-platform/tests/webvtt/parsing/file-parsing/support/ids-across-region-block.test", "testing/web-platform/tests/webvtt/parsing/file-parsing/support/ids-across-style-block.test", "testing/web-platform/tests/webvtt/parsing/file-parsing/tests/ids-across-region-block.html", "testing/web-platform/tests/webvtt/parsing/file-parsing/tests/ids-across-style-block.html", "testing/web-platform/tests/webvtt/parsing/file-parsing/tests/support/ids-across-region-block.vtt", "testing/web-platform/tests/webvtt/parsing/file-parsing/tests/support/ids-across-style-block.vtt"], "git_node": "a38b25ded20893a5d321dbc29795f019bd8be034", "git_parents": ["c3c5b05b7651b3dbb20dcea34cc1589a1f9c2203"], "node": "7b9245a37a1bdb8e8c4f854a3cd4e68dfb022d6e", "parents": ["2feec33c4077f7cbc00dabc65d531ac6a185ec4a"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091268 [wpt PR 64486] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321343, a=testonly\n\nAutomatic update from web-platform-tests\n[anon-block-removal] An outside list marker makes its list item's children inline\n\nAn outside marker takes no part in the list item's in-flow layout, so it must not turn childrenInline() on.\nLetting it puts a list item whose content is a block level box onto the inline path, where the marker takes a\nline of its own and the block starts below it - \u003cul\u003e\u003cli\u003e\u003cdiv\u003etext\u003c/div\u003e\u003c/li\u003e\u003c/ul\u003e is 58 tall instead of 40.\n\nNothing rebuilds anonymous wrappers on this path, so childrenInline() also has to be recomputed when a child\nis detached. A marker changing from inside to outside is destroyed and reattached, and the bit the inside\nmarker turned on would otherwise stay on.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321343\nWebKit-Canonical-Link: https://commits.webkit.org/318891@main\n\n--\n\nwpt-commits: b10f3156f74db9dac5b81c8b867f4dd536c980d8\nwpt-pr: 64486\n", "files": ["testing/web-platform/tests/css/css-lists/outside-marker-with-block-content.html"], "git_node": "8b12403039bd98dd646445d03e0cb658bd24d9b9", "git_parents": ["a38b25ded20893a5d321dbc29795f019bd8be034"], "node": "b99536450963fa135bbba1e0b2f9fc8bbff714fe", "parents": ["7b9245a37a1bdb8e8c4f854a3cd4e68dfb022d6e"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091282 [wpt PR 64490] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=318918, a=testonly\n\nAutomatic update from web-platform-tests\n[css-text-4] Implement the wrap-inside property\n\nAdd the CSS Text Level 4 'wrap-inside' property (auto | avoid), gated behind the\ncssWrapInsideEnabled setting.\n\n'wrap-inside: avoid' suppresses soft wrap opportunities within an inline box: the\nline breaks before the box - keeping it together - rather than inside it, and\nbreaks inside the box only as a last resort when there is no other break\nopportunity on the line. A 'wrap-inside: auto' box nested inside an 'avoid' box\ndoes not re-enable breaking, and breaks between sibling avoid boxes are preferred\nover breaks inside them.\n\nWhether content is inside an avoid box (the box's own value or inherited from an\nancestor avoid box) is precomputed during style resolution as\neffectiveWrapInsideAvoid(), so inline layout reads a flat flag and never walks\nthe box tree. It propagates only through inline boxes, so it does not cross into\na block, inline-block or other independent formatting context child. The break\ndecision is made by InlineContentBreaker: when the\noverflowing content is inside an avoid box and there is an earlier wrap\nopportunity, it asks the line builder to revert to the last wrap opportunity. The\nline builder records all wrap opportunities and, on such a revert, prefers the\nlast one outside any avoid box; when every opportunity is inside an avoid box it\nreverts to the outermost such box - a break in an outer box is used before a\nbreak within an inner one - breaking inside the box only as a last resort when it\nis the only content on the line.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=318918\nWebKit-Canonical-Link: https://commits.webkit.org/317182@main\n\n--\n\nwpt-commits: d779822dcdceeb4e64828407ab610226c400c60d\nwpt-pr: 64490\n", "files": ["testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-auto-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-auto.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-block-child-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-block-child.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-break-all-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-break-all.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-break-before-then-inside-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-break-before-then-inside.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-dynamic-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-dynamic.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-forced-break-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-forced-break.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-inline-block-child-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-inline-block-child.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-inline-flex-child-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-inline-flex-child.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-inline-grid-child-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-inline-grid-child.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-inline-table-child-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-inline-table-child.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-keeps-box-together-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-keeps-box-together.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-last-resort-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-last-resort.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-line-break-anywhere-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-line-break-anywhere.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-nested-auto-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-nested-auto.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-nested-deep-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-nested-deep.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-nested-only-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-nested-only.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-nested-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-nested.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-nowrap-child-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-nowrap-child.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-nowrap-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-nowrap.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-overflow-wrap-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-overflow-wrap.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-removed-dynamic-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-removed-dynamic.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-siblings-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-siblings.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-single-word-ref.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-avoid-single-word.html", "testing/web-platform/tests/css/css-text/wrap-inside/wrap-inside-computed.html"], "git_node": "7fbab984329000a83dd14ecdc43fce248c59f7b2", "git_parents": ["8b12403039bd98dd646445d03e0cb658bd24d9b9"], "node": "bf67b2d872070d70c60ed7735156eca109d31186", "parents": ["b99536450963fa135bbba1e0b2f9fc8bbff714fe"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091282 [wpt PR 64490] - Update wpt metadata, a=testonly\n\nwpt-pr: 64490\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-block-child.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-break-all.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-break-before-then-inside.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-dynamic.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-inline-block-child.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-inline-flex-child.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-inline-grid-child.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-inline-table-child.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-keeps-box-together.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-line-break-anywhere.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-nested-auto.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-nested-deep.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-nested-only.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-nested.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-avoid-siblings.html.ini", "testing/web-platform/meta/css/css-text/wrap-inside/wrap-inside-computed.html.ini"], "git_node": "7fca774c21c4f239b9c02949255dc94697c9ecff", "git_parents": ["7fbab984329000a83dd14ecdc43fce248c59f7b2"], "node": "e12d677a90cce0bf145e9f73e0377befe7a8a804", "parents": ["bf67b2d872070d70c60ed7735156eca109d31186"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091285 [wpt PR 64492] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324201, a=testonly\n\nAutomatic update from web-platform-tests\nA float inside an inline box can be positioned twice when the line it was collected with is discarded\n\n    \u003cdiv style=\"width: 100px\"\u003e\n        XX XX XX XX\n        \u003cspan\u003e\n            \u003cdiv style=\"float: left; width: 200px; height: 20px\"\u003e\u003c/div\u003eX\n            \u003cdiv style=\"display: flow-root\"\u003eX\u003c/div\u003e\n        \u003c/span\u003e\n    \u003c/div\u003e\n\nThe float should sit at the top of the first line below where it fits. Instead it\nwas 20px lower, its own height.\n\nDiscarding line content left the float on the suspended list, so the next line both\nresumed it and met its inline item again. Drop it, and re-key the placed floats tree\nwhen a placed float's rect changes.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324201\nWebKit-Canonical-Link: https://commits.webkit.org/321274@main\n\n--\n\nwpt-commits: a440e084a9ffb0dac3165b3ba3e2ac0dc1714f4a\nwpt-pr: 64492\n", "files": ["testing/web-platform/tests/css/CSS2/floats/float-wider-than-line-inside-inline-with-block-ref.html", "testing/web-platform/tests/css/CSS2/floats/float-wider-than-line-inside-inline-with-block.html"], "git_node": "d2a5c4ca5da0d965ee6ffce448790e9829f5b143", "git_parents": ["7fca774c21c4f239b9c02949255dc94697c9ecff"], "node": "fa429f31d40279f92f03859a7a0add991cf17033", "parents": ["e12d677a90cce0bf145e9f73e0377befe7a8a804"], "tags": []}, {"author": "Roberto Rodriguez \u003croberto_rodriguez2@apple.com\u003e", "branch": "default", "desc": "Bug 2091289 [wpt PR 64493] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=316512, a=testonly\n\nAutomatic update from web-platform-tests\nabout:blank inherits cross-origin policy container due to empty document URL\n\nDocuments created via javascript: URL have an empty internal URL. Document::setURL() would\nnormally normalize this to aboutBlankURL(), but the call is conditionally skipped during\ndocument creation.\n\nWhen one of these documents creates a cross-origin iframe and then navigates it to about:blank,\nthe empty URL passes through NavigationRequester into NavigationAction::isEmpty(), which\nmistakes it for an action that was never set. The fallback in FrameLoader::loadWithDocumentLoader\nincorrectly rebuilds the action from the target frame's cross-origin document rather than the\noriginal initiator (the javascript: URL document). The about:blank then inherits that document's\npolicy container instead of the initiator's, leaking its CSP and referrer via\nSecurityPolicyViolationEvent.\n\nFix by normalizing empty document URLs to aboutBlankURL() in NavigationRequester::from(),\nmatching what Document::setURL() and Document::urlForBindings() already do.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=316512\nWebKit-Canonical-Link: https://commits.webkit.org/319079@main\n\n--\n\nwpt-commits: 562052a8aaaa901112ec2e3a311ba34007decd6f\nwpt-pr: 64493\n", "files": ["testing/web-platform/tests/content-security-policy/inheritance/about-blank-from-javascript-url-inherits-csp-from-initiator.sub.html", "testing/web-platform/tests/content-security-policy/inheritance/support/page-with-csp-marker.html", "testing/web-platform/tests/content-security-policy/inheritance/support/page-with-csp-marker.html.headers"], "git_node": "ad3773fde1d63e28d621b2547a26d5c2f220bd7b", "git_parents": ["d2a5c4ca5da0d965ee6ffce448790e9829f5b143"], "node": "d7515a048cbfa4ad6cc048436b12dc453af03fde", "parents": ["fa429f31d40279f92f03859a7a0add991cf17033"], "tags": []}, {"author": "Roberto Rodriguez \u003croberto_rodriguez2@apple.com\u003e", "branch": "default", "desc": "Bug 2091295 [wpt PR 64491] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322934, a=testonly\n\nAutomatic update from web-platform-tests\nCSP style-src-attr does not block a style attribute parsed in a document with no browsing context\n\nStyledElement::styleAttributeChanged() checks a style attribute against the policy of the\nelement's own document when the attribute is set. A document created by DOMParser,\ncreateHTMLDocument or a template has no browsing context and starts with an empty policy,\nso the check allows the attribute and the parsed style stays on the element. When the\nelement moves into a page whose policy sets style-src-attr to none, nothing checks the\nstyle again and it is applied. CSP Level 3 4.2.3 defines this check, and HTML section\n3.2.6.5 requires that blocked style rules are not applied to the element.\n\nFix by checking the style attribute against the policy of the document returned by\ncontextDocument(). That is the document recorded as the creator of a DOMParser result,\na createHTMLDocument document or template contents, and the element's own document when\nnone is recorded. Add three web-platform tests for the DOMParser, createHTMLDocument\nand template paths.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322934\nWebKit-Canonical-Link: https://commits.webkit.org/322461@main\n\n--\n\nwpt-commits: 19d56d9a722dc41febfdae42fe16bbe035cfc12d\nwpt-pr: 64491\n", "files": ["testing/web-platform/tests/content-security-policy/style-src/style-src-attr-blocked-createhtmldocument-adopt.html", "testing/web-platform/tests/content-security-policy/style-src/style-src-attr-blocked-domparser-adopt.html", "testing/web-platform/tests/content-security-policy/style-src/style-src-attr-blocked-template-move.html"], "git_node": "bb6ec91226848cc3f2d88a22ffba7409b719e0b4", "git_parents": ["ad3773fde1d63e28d621b2547a26d5c2f220bd7b"], "node": "6049ea436a007297b5c0aa2c7fb491c4cab7e2ed", "parents": ["d7515a048cbfa4ad6cc048436b12dc453af03fde"], "tags": []}, {"author": "Brent Fulgham \u003cbfulgham@apple.com\u003e", "branch": "default", "desc": "Bug 2091351 [wpt PR 64496] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326688, a=testonly\n\nAutomatic update from web-platform-tests\nInclude shaped glyph origins in complex text glyph bounds\n\nCombining marks have a zero base advance and shaping moves them through\nthe per-glyph origin. Paint applies that origin in\nComplexTextController::advance, but glyph bounds measurement only used\nthe pen position. Stacked marks were therefore measured as if they sat\non the baseline, the text box reported too little ink overflow, and the\nmarks were not repainted after a preceding link changed.\n\nTherefore subtract the origin's y from each glyph's bounds in\nadjustGlyphsAndAdvances and enclosingGlyphBoundsForTextRun. These bounds\nalso feed canvas measureText's actualBoundingBoxAscent/Descent and the\nline box height for -webkit-line-box-contain: glyphs and initial-letter,\nso those now include the shaped mark offsets too. The origin's x is\nstill not applied (FIXME). The new tests cover each of those consumers\nusing a generated font whose combining marks sit above and below the\nbaseline through a GPOS anchor, since no system font guarantees a mark\nwith a vertical offset.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326688\nWebKit-Canonical-Link: https://commits.webkit.org/323777@main\n\n--\n\nwpt-commits: b9d33e50318c264cde10e4b7f632ab99d0a18fe2\nwpt-pr: 64496\n", "files": ["testing/web-platform/tests/fonts/mark-origin-y-test.ttf", "testing/web-platform/tests/html/canvas/element/text/2d.text.measure.actualBoundingBox.combining-mark-offset.html", "testing/web-platform/tests/html/canvas/tools/generate-mark-origin-y-font.py"], "git_node": "f35f650d62a4893705d94ef904fecd149f439203", "git_parents": ["bb6ec91226848cc3f2d88a22ffba7409b719e0b4"], "node": "73c8cc8b65e2dbf1f3f9dff5003b9c661f7b2b36", "parents": ["6049ea436a007297b5c0aa2c7fb491c4cab7e2ed"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2091406 [wpt PR 64498] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322160, a=testonly\n\nAutomatic update from web-platform-tests\nCanvas 2D hit testing and transform mutations should not require the canvas bitmap\n\nisPointInPath(), isPointInStroke(), drawFocusIfNeeded() and all six CTM\nmutators opened with `if (!effectiveDrawingContext()) return;`. That runs\nbuffer() -\u003e allocateImageBuffer(), so a pure geometry query on a fresh\ncanvas committed width * height * 4 bytes plus an IOSurface. Neither\nhit-testing helper uses the context it fetched: Path::contains() is a CG\npath query, and PathCG::strokeContains() builds its own GraphicsContext\nover the 1x1 scratchContext().\n\nIt is also a correctness bug. validateArea() returns false when the area\nis zero, so a canvas with a zero width or height has no bitmap at all.\nHit tests therefore returned false for points genuinely inside the path,\nand every CTM mutation was silently dropped.\n\nThe spec does not permit this. Per the canvas state [1]: \"The rendering\ncontext's bitmaps are not part of the drawing state, as they depend on\nwhether and how the rendering context is bound to a canvas element.\" The\nsame section lists \"The current transformation matrix.\" as the first\ncomponent of the drawing state. Nor is the CTM merely a painting input:\n\"The current transformation matrix is applied to coordinates when\ncreating the current default path, and when painting text, shapes, and\nPath2D objects\" [2]. Dropping a mutation therefore corrupts the path as\nit is built -- which is what we do, by folding the inverse into m_path --\nso the damage does not depend on there being a bitmap to paint into.\n\nBoth hit-testing algorithms are likewise pure geometry once the\nnon-finite check has run [3][4], over inputs that all exist without a\nbacking store: the current default path, of which \"There is only one\ncurrent default path, it is not part of the drawing state\" [5], the CTM,\nand for isPointInStroke() the line styles of the CanvasPathDrawingStyles\nmixin. Firefox already behaves this way; Chrome matches our old behavior.\n\nDrop the check outright in the two hit-testing helpers, move the fetch to\nthe point of use behind `if (auto* c = effectiveDrawingContext())` in the\nmutators so the state update happens either way, and hoist the cheap\nearly-outs above the fetch in drawFocusIfNeededInternal() so the common\nunfocused case no longer allocates.\n\nReordering cannot let state().transform drift from the context CTM:\nm_hasCreatedImageBuffer is only cleared by didUpdateCanvasSizeProperties()\non a size change, which also resets the state stack and clears the path.\n\n[1] https://html.spec.whatwg.org/multipage/canvas.html#the-canvas-state\n[2] https://html.spec.whatwg.org/multipage/canvas.html#transformations\n[3] https://html.spec.whatwg.org/multipage/canvas.html#dom-context-2d-ispointinpath\n[4] https://html.spec.whatwg.org/multipage/canvas.html#dom-context-2d-ispointinstroke\n[5] https://html.spec.whatwg.org/multipage/canvas.html#current-default-path\n\nThose live under html/canvas/{element,offscreen}/path-objects/ and are\ngenerated by /html/canvas/tools/gentest.py from tools/yaml/path-objects.yaml,\nso the seven new YAML entries emit the HTMLCanvasElement, OffscreenCanvas and\nworker flavor of each. All 21 baselines are a FAIL before this change.\n\nAdd the YAML these tests were generated from to path-objects.yaml. WebKit has the generated files but not the YAML; gentest.py generates the tests from it byte for byte.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322160\nWebKit-Canonical-Link: https://commits.webkit.org/319602@main\n\n--\n\nwpt-commits: dde432551ddb9ef246b2d7ce1384db3c8da55855\nwpt-pr: 64498\n", "files": ["testing/web-platform/tests/html/canvas/element/path-objects/2d.path.isPointInPath.nobitmap.html", "testing/web-platform/tests/html/canvas/element/path-objects/2d.path.isPointInPath.nobitmap.path2d.html", "testing/web-platform/tests/html/canvas/element/path-objects/2d.path.isPointInPath.nobitmap.transform.html", "testing/web-platform/tests/html/canvas/element/path-objects/2d.path.isPointInPath.nobitmap.winding.html", "testing/web-platform/tests/html/canvas/element/path-objects/2d.path.isPointInStroke.nobitmap.html", "testing/web-platform/tests/html/canvas/element/path-objects/2d.path.isPointInStroke.nobitmap.path2d.html", "testing/web-platform/tests/html/canvas/element/path-objects/2d.path.isPointInStroke.nobitmap.transform.html", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInPath.nobitmap.html", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInPath.nobitmap.path2d.html", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInPath.nobitmap.path2d.worker.js", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInPath.nobitmap.transform.html", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInPath.nobitmap.transform.worker.js", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInPath.nobitmap.winding.html", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInPath.nobitmap.winding.worker.js", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInPath.nobitmap.worker.js", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInStroke.nobitmap.html", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInStroke.nobitmap.path2d.html", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInStroke.nobitmap.path2d.worker.js", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInStroke.nobitmap.transform.html", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInStroke.nobitmap.transform.worker.js", "testing/web-platform/tests/html/canvas/offscreen/path-objects/2d.path.isPointInStroke.nobitmap.worker.js", "testing/web-platform/tests/html/canvas/tools/yaml/path-objects.yaml"], "git_node": "39a615ac7c034cf3e80125b8d8d9ad00c920d639", "git_parents": ["f35f650d62a4893705d94ef904fecd149f439203"], "node": "19988f6665ae083d1026e653b050734e7d2f43b4", "parents": ["73c8cc8b65e2dbf1f3f9dff5003b9c661f7b2b36"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091410 [wpt PR 64494] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326861, a=testonly\n\nAutomatic update from web-platform-tests\nSwitch GraphicsContext::drawBidiText from BidiResolver to ubidi\n\nThis is in preparation for removing BidiResolver.\n\ndrawBidiText splits a single TextRun into bidi runs and draws them in visual order.\nIt did this with the legacy line layout's BidiResolver, whose line breaking, render tree and isolate bookkeeping a plain string never needs.\nICU's ubidi (already used by IFC) now resolves the runs instead, so this caller no longer depends on BidiResolver.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326861\nWebKit-Canonical-Link: https://commits.webkit.org/323224@main\n\n--\n\nwpt-commits: f3357fc6a09c870f050e93c6cacbd51d40cc93c9\nwpt-pr: 64494\n", "files": ["testing/web-platform/tests/html/canvas/element/text/fillText-bidi-ltr.html", "testing/web-platform/tests/html/canvas/element/text/fillText-bidi-rtl.html", "testing/web-platform/tests/html/canvas/element/text/reference/fillText-bidi-ltr-ref.html", "testing/web-platform/tests/html/canvas/element/text/reference/fillText-bidi-rtl-ref.html"], "git_node": "06063c02eef9ff77249788f755af16262bc747a3", "git_parents": ["39a615ac7c034cf3e80125b8d8d9ad00c920d639"], "node": "babaca49a511e24def9437e88be030ba39d9b654", "parents": ["19988f6665ae083d1026e653b050734e7d2f43b4"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091420 [wpt PR 64495] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=316235, a=testonly\n\nAutomatic update from web-platform-tests\nCanvas fillText with textAlign=center misplaces complex-shaped text\n\n  \u003ccanvas id=c width=300 height=200\u003e\u003c/canvas\u003e\n  \u003cscript\u003e\n    let ctx = c.getContext(\"2d\");\n    ctx.font = \"152px serif\";\n    ctx.textAlign = \"center\";\n    ctx.fillText(\"\\u0BB5\", 150, 100);\n  \u003c/script\u003e\n\nThe Tamil glyph (U+0BB5) should be centered horizontally on x=150.\nInstead it was left-aligned at x=150 - canvas treated the text as zero\nwidth.\n\nThe canvas shaped-text cache reads result.width from\nFontCascade::layoutComplexText. That function computed the segment width\nas controller.totalAdvance().width() before and after advancing the\nComplexTextController, but totalAdvance() is the full run total - it is\npopulated up front in the controller's constructor and does not change\nacross advance() calls. So the difference was always zero for any run\nthat took the complex shaping path. Pre-cache callers only consumed the\nglyph buffer and ignored result.width, so the defect was latent.\n\nThe fix mirrors layoutSimpleText: use controller.runWidthSoFar() (the\nrunning tally that grows with each advance() call) instead of\ntotalAdvance().width(). The simple path already did this correctly via\nWidthIterator::runWidthSoFar(), which is why Latin text centered\ncorrectly while Tamil/Devanagari/Arabic/emoji did not.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=316235\nWebKit-Canonical-Link: https://commits.webkit.org/314522@main\n\n--\n\nwpt-commits: 771303ba4a7c48fbbb9db457d039e1146866a56a\nwpt-pr: 64495\n", "files": ["testing/web-platform/tests/html/canvas/element/text/2d.text.draw.align.center.complex-shaping.html"], "git_node": "d5a1c95b32a753c7841766c053ed33f0eec098d3", "git_parents": ["06063c02eef9ff77249788f755af16262bc747a3"], "node": "7caf47c2244573a3b28dc3f2b0fb86eb3c739be1", "parents": ["babaca49a511e24def9437e88be030ba39d9b654"], "tags": []}, {"author": "Matt Woodrow \u003cmattwoodrow@apple.com\u003e", "branch": "default", "desc": "Bug 2091435 [wpt PR 64497] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=311780, a=testonly\n\nAutomatic update from web-platform-tests\nInstagram.com: story circle borders are black instead of colorful.\n\nStroked arcs with a gradient fill aren't being rendered correctly.\n\nFall back to strokePath if there's a gradient fill, since that requires special\nhandling outside of CG.  Match strokePath's behaviour for pattern fills, and\nexplicitly apply it.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=311780\nWebKit-Canonical-Link: https://commits.webkit.org/310865@main\n\n--\n\nwpt-commits: 69e2014fe600f214a3207be8a7afe93d2d47d8a1\nwpt-pr: 64497\n", "files": ["testing/web-platform/tests/html/canvas/element/fill-and-stroke-styles/2d.strokeStyle.gradient.arc-ref.html", "testing/web-platform/tests/html/canvas/element/fill-and-stroke-styles/2d.strokeStyle.gradient.arc.html", "testing/web-platform/tests/html/canvas/element/fill-and-stroke-styles/2d.strokeStyle.pattern.arc-ref.html", "testing/web-platform/tests/html/canvas/element/fill-and-stroke-styles/2d.strokeStyle.pattern.arc.html"], "git_node": "83d831f3fb8081531dcebd7a192e096e355cb899", "git_parents": ["d5a1c95b32a753c7841766c053ed33f0eec098d3"], "node": "a7a98c832d22f36791c084ce744b64b00e61a77f", "parents": ["7caf47c2244573a3b28dc3f2b0fb86eb3c739be1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091872 - [wpt-sync] Update web-platform-tests to 69e2014fe600f214a3207be8a7afe93d2d47d8a1, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: 69e2014fe600f214a3207be8a7afe93d2d47d8a1\nwpt-type: landing\n", "files": ["testing/web-platform/meta/accelerometer/Accelerometer.https.html.ini", "testing/web-platform/meta/accelerometer/GravitySensor.https.html.ini", "testing/web-platform/meta/accelerometer/LinearAccelerationSensor.https.html.ini", "testing/web-platform/meta/connection-allowlist/tentative/service-worker-dedicated-worker.https.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/service-worker-shared-worker.https.sub.window.js.ini", "testing/web-platform/meta/content-security-policy/img-src/shared-stylesheet-mask-cache-bypass-strict-first.html.ini", "testing/web-platform/meta/css/css-animations/inherited-animation-opacity.html.ini", "testing/web-platform/meta/css/css-animations/inherited-animation-transform.html.ini", "testing/web-platform/meta/css/css-borders/border-shape/border-shape-animation.html.ini", "testing/web-platform/meta/css/css-break/table/oof-static-pos-percentage-height.html.ini", "testing/web-platform/meta/css/css-color/parsing/color-computed-powerless.html.ini", "testing/web-platform/meta/css/css-grid/layout-algorithm/grid-spanning-items-orthogonal-flows-001.html.ini", "testing/web-platform/meta/css/css-masking/mask-image/backdrop-filter-mask-image-while-loading.html.ini", "testing/web-platform/meta/editing/edit-context/edit-context-paste-handler-changes-active.tentative.html.ini", "testing/web-platform/meta/editing/edit-context/edit-context-paste-html.tentative.html.ini", "testing/web-platform/meta/editing/other/trailing-linebreak-of-inline-editing-host.tentative.html.ini", "testing/web-platform/meta/encrypted-media/drm-keystatuses-multiple-sessions.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-clear-encrypted.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-multisession.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-playduration-keystatus.https.html.ini", "testing/web-platform/meta/gyroscope/Gyroscope.https.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/open-close/open-features-tokenization-noreferrer.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/self-et-al.window.js.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-indexed-access-vs-named-access.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-indexed-properties-delete-no-cache.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-open-noopener.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-open-windowfeatures-values.html.ini", "testing/web-platform/meta/html/canvas/element/fill-and-stroke-styles/2d.strokeStyle.gradient.arc.html.ini", "testing/web-platform/meta/html/canvas/element/fill-and-stroke-styles/2d.strokeStyle.pattern.arc.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/canvas-content-drawable-stacking-context.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/css-object-fit-contain-tall.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/css-object-fit-contain-wide.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/css-object-fit-cover-tall.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/css-object-fit-cover-wide.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/css-object-fit-fill-tall.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/css-object-fit-fill-wide.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/css-object-fit-none-tall.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/css-object-fit-none-wide.tentative.html.ini", "testing/web-platform/meta/html/cross-origin-embedder-policy/credentialless/dedicated-worker.https.window.js.ini", "testing/web-platform/meta/html/semantics/popovers/popover-top-layer-nesting-anchor.tentative.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/modulepreload-referrerpolicy.html.ini", "testing/web-platform/meta/html/webappapis/dynamic-markup-insertion/opening-the-input-stream/url.window.js.ini", "testing/web-platform/meta/html/webappapis/timers/zero-settimeout.any.js.ini", "testing/web-platform/meta/intersection-observer/scroll-margin-4-val.html.ini", "testing/web-platform/meta/intersection-observer/scroll-margin-dynamic.html.ini", "testing/web-platform/meta/intersection-observer/scroll-margin-no-intersect.html.ini", "testing/web-platform/meta/intersection-observer/transformed-iframe-002-cross-origin.html.ini", "testing/web-platform/meta/long-animation-frame/conditional-measure-iframe-time-origin.tentative.html.ini", "testing/web-platform/meta/long-animation-frame/conditional-user-timing-cross-origin-measure.tentative.html.ini", "testing/web-platform/meta/long-animation-frame/conditional-user-timing-cross-origin.tentative.html.ini", "testing/web-platform/meta/long-animation-frame/conditional-user-timing-detached-window.tentative.html.ini", "testing/web-platform/meta/long-animation-frame/conditional-user-timing-same-origin.tentative.html.ini", "testing/web-platform/meta/magnetometer/Magnetometer.https.html.ini", "testing/web-platform/meta/mozilla-sync", "testing/web-platform/meta/orientation-sensor/AbsoluteOrientationSensor.https.html.ini", "testing/web-platform/meta/orientation-sensor/RelativeOrientationSensor.https.html.ini", "testing/web-platform/meta/pointerevents/pointerevent_pointerout_no_pointer_movement.html.ini", "testing/web-platform/meta/push-api/window-pushManager.https.any.js.ini", "testing/web-platform/meta/resource-timing/tentative/initiator-url/promise.html.ini", "testing/web-platform/meta/resource-timing/tentative/initiator-url/request-idle-callback.html.ini", "testing/web-platform/meta/scheduler/post-task-delay.any.js.ini", "testing/web-platform/meta/shape-detection/text-detector-create.https.html.ini", "testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-audioworklet-interface/audioworklet-audioparam-iterable.https.html.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-offlineaudiocontext-interface/offlineaudiocontext-incremental-rendering.html.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-stereopanner-interface/stereopannernode-panning.html.ini", "testing/web-platform/meta/webrtc-extensions/RTCConfiguration-rtpHeaderEncryptionPolicy.html.ini", "testing/web-platform/meta/webrtc/RTCCertificate-postMessage-to-workers.https.html.ini"], "git_node": "e5c8a9f2b7ab02dc33e6105f93ffda2e86e9b34e", "git_parents": ["83d831f3fb8081531dcebd7a192e096e355cb899"], "node": "f13ab599a20a4eb51e82f6246de914ae5cd612cf", "parents": ["a7a98c832d22f36791c084ce744b64b00e61a77f"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2092114 - Update the speedometer-experimental fetch to the latest sp4-exp revision r=perftest-reviewers,aglavic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342171\n", "files": ["taskcluster/kinds/fetch/benchmarks.yml", "testing/perfdocs/generated/raptor.md", "testing/raptor/raptor/tests/benchmarks/speedometer-desktop.toml"], "git_node": "7b9ac0828fc4cc7cb2d9479dd500adb291a9405d", "git_parents": ["e5c8a9f2b7ab02dc33e6105f93ffda2e86e9b34e"], "node": "1b2d7ac11f0d8135c0b573c9c159fe6c15ea1db2", "parents": ["f13ab599a20a4eb51e82f6246de914ae5cd612cf"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092131 - Wait for the parent history length in the cross-origin Navigation API traversal test. r=dom-core-reviewers,jjaschke\n\nThe test first loads a cross-origin document in an iframe, then navigates\nthe iframe back to the parent's origin. Before testing the iframe's\nNavigation API entries and back/forward traversals, it checks that the\nparent's history.length has increased by one. Previously, this check ran\nafter the iframe's load event and a single zero-delay timer, which does\nnot guarantee that the parent's history object has been updated.\n\nHTML processes session history traversal steps on a parallel queue.\nFinalizing a cross-document navigation appends the new entry and applies\nthe push/replace history step. Applying that step updates the navigating\ndocument, but updates other documents whose entries do not change through\nseparately queued tasks on the navigation and traversal task source. The\nparent document is one of those nonchanging documents in this test. The\niframe's load event and the subsequent timer do not synchronize with that\nseparate update, so observing the old parent history length at that point\ndoes not establish that the iframe navigation failed to add an entry.\n\nThis also explains the intermittent result: the parent's update can be\nprocessed either before or after the timer callback. Gecko eventually\nreconciles the content process's history length through\nCanonicalBrowsingContext::HistoryCommitIndexAndLength(), but the test\nmust not assume that reconciliation has completed after one timer turn.\n\nUse testharness's bounded step_wait_func() to wait for the parent's history\nlength to reflect the navigation before exercising the Navigation API.\nThe test still fails if the expected length never arrives, and retains\nthe assertions about the iframe's entries and current entry indices\nbefore and after traversal. Remove the intermittent-failure expectations.\n\nSpec algorithms:\nhttps://html.spec.whatwg.org/#starting-a-new-session-history-traversal-parallel-queue\nhttps://html.spec.whatwg.org/#finalize-a-cross-document-navigation\nhttps://html.spec.whatwg.org/#apply-the-history-step\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342179\n", "files": ["testing/web-platform/meta/navigation-api/navigation-methods/traverseTo-with-cross-origin-in-history.html.ini", "testing/web-platform/tests/navigation-api/navigation-methods/traverseTo-with-cross-origin-in-history.html"], "git_node": "1d61f6c4468e85d03b64f44eb02761cfa408ead7", "git_parents": ["7b9ac0828fc4cc7cb2d9479dd500adb291a9405d"], "node": "e5813c90777c4a2c8674508528e3369f78210092", "parents": ["1b2d7ac11f0d8135c0b573c9c159fe6c15ea1db2"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2091900 - Break the AndroidImageReader reference cycle on decoder shutdown r=gfx-reviewers,lsalzman\n\nAdd AndroidImageReader::Shutdown() to stop image acquisition, wake waiting threads, and release the cached image, breaking the reference cycle between AndroidImageReader and AndroidImageWrapper.\n\nCall it during FFmpeg decoder shutdown, with a fallback in the decoder destructor. Release the cached image outside the reader\u2019s monitor to avoid holding the lock during native image deletion. Images retained by consumers keep the reader and their native images alive until released.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341973\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "gfx/layers/AndroidImageReader.cpp", "gfx/layers/AndroidImageReader.h"], "git_node": "a61c09a72400ecf72dbe9c134257e08998636c95", "git_parents": ["1d61f6c4468e85d03b64f44eb02761cfa408ead7"], "node": "6f7f92f1782e6422e8b3c564d4d3846462b1c4c2", "parents": ["e5813c90777c4a2c8674508528e3369f78210092"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2088349 [Wayland] Track borrowed buffers at NativeLayerWaylandExternal and release unused ones r=emilio,gtk-reviewers\n\nMove wl_buffer holders to NativeLayerWaylandExternal and release unsed ones.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339093\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/NativeLayerWayland.h", "widget/gtk/WaylandBuffer.cpp", "widget/gtk/WaylandBuffer.h", "widget/gtk/WaylandSurface.cpp", "widget/gtk/WaylandSurface.h"], "git_node": "e9ccdf579f350ba4f6b7b436d1f54806a12a492f", "git_parents": ["a61c09a72400ecf72dbe9c134257e08998636c95"], "node": "e01f2d97397d23f7cd67ed85969719646e01e51d", "parents": ["6f7f92f1782e6422e8b3c564d4d3846462b1c4c2"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2088349 [Wayland] Create front buffer right before commit for external surfaces r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340898\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/NativeLayerWayland.h"], "git_node": "323478e2663e709d10cf4153bd20bf19698c1d42", "git_parents": ["e9ccdf579f350ba4f6b7b436d1f54806a12a492f"], "node": "c77276e1ea991cf0fbfe0755e4085dc42402089c", "parents": ["e01f2d97397d23f7cd67ed85969719646e01e51d"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1937351 - Skip test_backgroundtask_shouldprocessupdates.js on Windows until Bug 2092048 is fixed r=intermittent-reviewers,jstutte,aryx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342106\n", "files": ["toolkit/components/backgroundtasks/tests/xpcshell/xpcshell.toml"], "git_node": "8be58212dc3b1185255b3a8d76095f1bfd07dc65", "git_parents": ["323478e2663e709d10cf4153bd20bf19698c1d42"], "node": "5907bfade9efd37129e14d37d6ba49c3736bb264", "parents": ["c77276e1ea991cf0fbfe0755e4085dc42402089c"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078809 - Process reftest leak logs before the profile containing them is removed. r=layout-reviewers,jwatt\n\nrunApp removes the profile, which holds the leak logs, before the caller got\nto process them, so reftest and crashtest runs never checked for leaks. Also\nlet the structured leak messages reach the tbpl formatter instead of failing\non their missing message field, and give them a scope, which the formatter\nneeds to report large leaks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341857\n", "files": ["layout/tools/reftest/output.py", "layout/tools/reftest/remotereftest.py", "layout/tools/reftest/runreftest.py", "layout/tools/reftest/selftest/test_reftest_output.py"], "git_node": "cee9e2a3a470d7a6cda99bfd77d57ebfe189e0d0", "git_parents": ["8be58212dc3b1185255b3a8d76095f1bfd07dc65"], "node": "5e81efb4a007fbac3d45cb760b9f2ed08ef03433", "parents": ["5907bfade9efd37129e14d37d6ba49c3736bb264"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091872 - Remove leftover merge conflict marker from border-shape-animation.html.ini to fix wpt lint failure. a=testonly\n", "files": ["testing/web-platform/meta/css/css-borders/border-shape/border-shape-animation.html.ini"], "git_node": "8608f19eefeb4be0a0e5fcaad7de5e87a99296fb", "git_parents": ["cee9e2a3a470d7a6cda99bfd77d57ebfe189e0d0"], "node": "dfd1368750d8eb28966fa7e0cbe5a9b893beb7bd", "parents": ["5e81efb4a007fbac3d45cb760b9f2ed08ef03433"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2091968 - refactor(thebes): use `GetAdjustedSpacingArray` in `gfxTextRun::GetAdvanceWidth` r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342242\n", "files": ["gfx/thebes/gfxTextRun.cpp"], "git_node": "198002b7dda088d6250d723b8fca2b5d8ac067e4", "git_parents": ["8608f19eefeb4be0a0e5fcaad7de5e87a99296fb"], "node": "feee87adbd576e4ac7fd25e12e30d34293102a5e", "parents": ["dfd1368750d8eb28966fa7e0cbe5a9b893beb7bd"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2090893 - fix(canvas): `OffscreenCanvasDisplayHelper::InvalidateElement`: make `canvasElement` a `RefPtr` r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342202\n", "files": ["dom/canvas/OffscreenCanvasDisplayHelper.cpp"], "git_node": "6272f06d986804668ff88e724e45380f4ecf9807", "git_parents": ["198002b7dda088d6250d723b8fca2b5d8ac067e4"], "node": "2e13248490d300105e7503975acfb60f7233b9b3", "parents": ["feee87adbd576e4ac7fd25e12e30d34293102a5e"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2092028 - Clean up dom.dialog.light-dismiss.enabled flag r=webidl,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342100\n", "files": ["dom/base/Document.cpp", "dom/events/EventStateManager.cpp", "dom/html/HTMLDialogElement.cpp", "dom/html/HTMLDialogElement.h", "dom/webidl/HTMLDialogElement.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/dom/idlharness.https.html.ini", "testing/web-platform/meta/html/semantics/interactive-elements/the-dialog-element/__dir__.ini", "testing/web-platform/meta/html/semantics/interactive-elements/the-dialog-element/dialog-closedby-show-stacked.html.ini"], "git_node": "b64f05fe7ba9658d0b10493e08f9cf8c978714c9", "git_parents": ["6272f06d986804668ff88e724e45380f4ecf9807"], "node": "c289a84e1ff813a902b9a3f4a3d6112764705806", "parents": ["2e13248490d300105e7503975acfb60f7233b9b3"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1935530 - Make browser_bookmarks_toolbar_telemetry.js pass when run twice in the same browser, r=places-reviewers,mak.\n\nRestore the toolbar visibility through the context menu so BrowserUsageTelemetry's remembered state matches, and count keyed scalars relative to their starting values.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342339\n", "files": ["browser/components/places/tests/browser/browser.toml", "browser/components/places/tests/browser/browser_bookmarks_toolbar_telemetry.js"], "git_node": "a72bf45357fbaac26ec18dcbd1c2df57b622c9fe", "git_parents": ["b64f05fe7ba9658d0b10493e08f9cf8c978714c9"], "node": "b6dd36a1c83fda9929b9e4e0fef1a0685a631a4b", "parents": ["c289a84e1ff813a902b9a3f4a3d6112764705806"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092319 - Clear the HTTP cache after browser_test_favicon.js so it passes when run again, r=necko-reviewers,valentin.\n\nThe favicon is loaded from the cache on a second run in the same browser, so its Set-Cookie is never processed and the cookie-rejected notification the test waits for never comes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342370\n", "files": ["netwerk/test/browser/browser.toml", "netwerk/test/browser/browser_test_favicon.js"], "git_node": "e19da15c9d7f4c0fe286dd516ad17f7a6a5b6590", "git_parents": ["a72bf45357fbaac26ec18dcbd1c2df57b622c9fe"], "node": "e5f685d483fe454266a6ba9c2a54d31eb934916d", "parents": ["b6dd36a1c83fda9929b9e4e0fef1a0685a631a4b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092321 - Serve a real JavaScript module from early_hint_asset.sjs in browser_103_assets.js, r=necko-reviewers,valentin.\n\nThe sjs had no module branch, so the module was served without a Content-Type and\nalways failed to load. The import then only reused the hinted modulepreload when it\nstarted before the preload failed, otherwise it fetched the module again, failing\nthe module+reload check. Once the module loads, the module+cached variant can be\nserved from the navigation cache, like scripts already are.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342371\n", "files": ["netwerk/test/browser/browser_103_assets.js", "netwerk/test/browser/early_hint_asset.sjs"], "git_node": "0fa97dbe342c1e3d0dd803dbaed82b5aecd6ecfd", "git_parents": ["e19da15c9d7f4c0fe286dd516ad17f7a6a5b6590"], "node": "590b150a467f92464f38668ffa3d0ee8d392d92b", "parents": ["e5f685d483fe454266a6ba9c2a54d31eb934916d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092322 - Wait for the status panel to show the load's status in browser_necko_l10n.js, r=necko-reviewers,valentin.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342373\n", "files": ["netwerk/test/browser/browser_necko_l10n.js"], "git_node": "54b47c7885bf7442ac54a9739ab18ea6cf68fa82", "git_parents": ["0fa97dbe342c1e3d0dd803dbaed82b5aecd6ecfd"], "node": "475ca9e6ac971b18b65efd5d513c61d272305844", "parents": ["590b150a467f92464f38668ffa3d0ee8d392d92b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092326 - Update the New Tab search bar's placeholder once its engine store has initialized, r=urlbar-reviewers,mak.\n\nUntil the engine store initializes, the New Tab bar's placeholder comes from the pre-saved name, or names no engine if keyword.enabled changes in the meantime. Nothing updated it once the store knew the default engine.\n\nThe placeholder wait now checks the engine name too, since the pre-saved name has the same l10n id as the real one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342377\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-newtab/browser_placeholder.js"], "git_node": "668ef35fc924e0cba0f35e1ec26745c4d735810b", "git_parents": ["54b47c7885bf7442ac54a9739ab18ea6cf68fa82"], "node": "2b492ca8f887237bbca1f87aa7263a09bf95c5fc", "parents": ["475ca9e6ac971b18b65efd5d513c61d272305844"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092324 - Handle the untrusted modules payload rejection in UntrustedModulesPing, r=janerik.\n\nsubmitAndGetUntrustedModulePayload rejects with NS_ERROR_NOT_AVAILABLE when no untrusted module load event was collected, which is the common case. Left unhandled, it fails whichever browser-chrome test is running on Windows when the update timer first fires, about 30s after startup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342375\n", "files": ["toolkit/components/telemetry/pings/UntrustedModulesPing.sys.mjs"], "git_node": "5f0d18483fd62f41a969987543f3f1869ad184d6", "git_parents": ["668ef35fc924e0cba0f35e1ec26745c4d735810b"], "node": "cb47ef269733c2b166918747213cd029019c863c", "parents": ["2b492ca8f887237bbca1f87aa7263a09bf95c5fc"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092492 - Only call ErrorResult::ClearUnionData when the result is a failure. r=dom-core-reviewers,smaug\n\nDestroying or assigning to a successful ErrorResult called out of line into\nSuppressException and ClearUnionData, which have nothing to do in that case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342515\n", "files": ["dom/bindings/BindingUtils.cpp", "dom/bindings/ErrorResult.h"], "git_node": "89971487440b29460e8f3fd9320ff8504ba90277", "git_parents": ["5f0d18483fd62f41a969987543f3f1869ad184d6"], "node": "34460eae57cd0c0503c5f124042cc820b25817b1", "parents": ["cb47ef269733c2b166918747213cd029019c863c"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091872 - Update wpt metadata for unexpected passes after wpt-sync. a=testonly\n", "files": ["testing/web-platform/meta/connection-allowlist/tentative/service-worker-dedicated-worker.https.sub.window.js.ini", "testing/web-platform/meta/speculation-rules/prefetch/document-rules-visibility.https.html.ini"], "git_node": "3f81f81b1a28ba5f35c0cc8db16ff2e569b2a79e", "git_parents": ["89971487440b29460e8f3fd9320ff8504ba90277"], "node": "46f1df4582011ef8bf53fb4975182702ceb0b0dd", "parents": ["34460eae57cd0c0503c5f124042cc820b25817b1"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091872 - Update wpt metadata for unexpected passes after wpt-sync. a=testonly\n", "files": ["testing/web-platform/meta/css/css-borders/border-shape/border-shape-animation.html.ini"], "git_node": "589a166fdd717e92dd8980ce6d521688f50aefa1", "git_parents": ["3f81f81b1a28ba5f35c0cc8db16ff2e569b2a79e"], "node": "4671d8b3d23dc00af7c6fa4519fd6e8bfe1d5fcc", "parents": ["46f1df4582011ef8bf53fb4975182702ceb0b0dd"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091872 - Update wpt metadata a=test-only\n", "files": ["testing/web-platform/meta/webaudio/the-audio-api/the-offlineaudiocontext-interface/offlineaudiocontext-incremental-rendering.html.ini"], "git_node": "ee41d9fe86657eb646efb40dd0d2cf620a217b33", "git_parents": ["589a166fdd717e92dd8980ce6d521688f50aefa1"], "node": "f853ac89809d7900725d841eb2144b0db783d6e4", "parents": ["4671d8b3d23dc00af7c6fa4519fd6e8bfe1d5fcc"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052054 - Remove EARLY_BETA_OR_EARLIER. r=perftest-reviewers,necko-reviewers,mozperftest-reviewers,firefox-build-system-reviewers,spidermonkey-reviewers,linter-reviewers,ahal,ahochheiden,aglavic,valentin,jonco\" for causing Bug 2092484\n\nThis reverts commit 2d34d593da83179cbc9c29ca04b2d79b03dc59be.\n", "files": ["build/moz.configure/init.configure", "build/rust/mozbuild/generate_buildconfig.py", "docs/code-quality/lint/linters/test-manifest-toml.md", "docs/setup/configuring_build_options.md", "js/src/doc/feature_checklist.md", "js/src/frontend/ParseNodeVerify.h", "js/src/tests/jstests.py", "modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/Http2Session.cpp", "python/mozbuild/mozbuild/mozinfo.py", "python/mozbuild/mozbuild/test/configure/test_toolkit_moz_configure.py", "python/mozperftest/mozperftest/tests/data/mozinfo.json", "taskcluster/kinds/source-test/mozlint.yml", "testing/mozbase/manifestparser/manifestparser/token.py", "testing/perfdocs/generated/perf-sheriffing.md", "testing/performance/perf-sheriffing/perfdocs/index.md", "testing/web-platform/meta/wasm/jsapi/memory/constructor.any.js.ini", "toolkit/modules/AppConstants.sys.mjs", "toolkit/modules/moz.build", "tools/@types/subs/AppConstants.sys.d.mts", "tools/lint/rejected-words.yml"], "git_node": "4fc6a2844f741ad5bd08c344638dd686722119ed", "git_parents": ["ee41d9fe86657eb646efb40dd0d2cf620a217b33"], "node": "151418c7d96254890e8ee460b445268a80641fff", "parents": ["f853ac89809d7900725d841eb2144b0db783d6e4"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2090279 - Don't trigger notifications during GC callback r=mccr8\" for causing assertion failures @ nsObserverService.cpp\n\nThis reverts commit c0c9acf51e692551fd8bfb14f4b8624517458e23.\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/nsDocShell.cpp", "dom/base/Document.cpp", "dom/base/nsJSEnvironment.cpp", "dom/events/EventStateManager.cpp", "dom/media/autoplay/GVAutoplayPermissionRequest.cpp", "dom/media/webaudio/AudioNode.cpp", "js/xpconnect/src/XPCJSRuntime.cpp", "toolkit/components/windowwatcher/nsWindowWatcher.cpp", "xpcom/base/CycleCollectedJSRuntime.cpp", "xpcom/base/CycleCollectedJSRuntime.h", "xpcom/base/nsCycleCollector.cpp", "xpcom/base/nsCycleCollector.h", "xpcom/components/nsComponentManager.cpp", "xpcom/ds/nsObserverService.cpp", "xpcom/ds/nsObserverService.h"], "git_node": "c2aa890d13f9234bc8a3b1a36b3539362a245173", "git_parents": ["4fc6a2844f741ad5bd08c344638dd686722119ed"], "node": "8dd04780fb0f844c21b8dcd703b556a1526db601", "parents": ["151418c7d96254890e8ee460b445268a80641fff"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091872 - Update border-shape-animation.html.ini expectations to PASS on all platforms. a=testonly\n", "files": ["testing/web-platform/meta/css/css-borders/border-shape/border-shape-animation.html.ini"], "git_node": "e18cff