/**' -g '!tools/lint/eslint/**' \\\n      -g '!dom/console/tests/**' -g '!toolkit/components/backgroundtasks/tests/BackgroundTask_console.sys.mjs' \\\n      'console\\.createInstance\\(' . \\\n    | xargs sed -i '' \\\n      -e 's/\\(console\\.createInstance({[^}]*[^A-Za-z0-9_.$]\\)prefix:/\\1logModule:/' \\\n      -e '/console\\.createInstance({ *$/,/})/ s/\\([^A-Za-z0-9_.$\"]\\)prefix:/\\1logModule:/'\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337652\n", "files": ["browser/actors/SearchSERPTelemetryChild.sys.mjs", "browser/components/aiwindow/models/AuthProvider.sys.mjs", "browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/ConversationSuggestions.sys.mjs", "browser/components/aiwindow/models/HistoryThumbnails.sys.mjs", "browser/components/aiwindow/models/TelemetryManager.sys.mjs", "browser/components/aiwindow/models/TelemetryUtils.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/agents/MonitorStore.sys.mjs", "browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/models/auth/AuthImplSelector.sys.mjs", "browser/components/aiwindow/models/auth/FxaAuthProviderImpl.sys.mjs", "browser/components/aiwindow/models/auth/FxaSignedInWatcher.sys.mjs", "browser/components/aiwindow/models/memories/MemoriesManager.sys.mjs", "browser/components/aiwindow/models/memories/MemoriesSchedulers.sys.mjs", "browser/components/aiwindow/models/memories/journeys/JourneyManager.sys.mjs", "browser/components/aiwindow/models/memories/journeys/JourneyStore.sys.mjs", "browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/services/MemoryStore.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browse