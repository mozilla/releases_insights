/app/src/main/java/org/mozilla/fenix/components/menu/compose/TranslationMenuItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/header/MozillaAccountMenuItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/header/SubmenuHeader.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuDialogMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuNavigationMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/SessionStateExt.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/IPProtectionMenuState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/MenuAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/MenuState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/MenuStore.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/NavigationEvent.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/CustomTabBrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/Activity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/AboutHomeBindingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/HomeActivityTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuDialogFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuDialogMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuNavigationMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuStoreTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuTelemetryMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/WebExtensionsMenuBindingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/compose/MainMenuTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/CustomTabBrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/toolbar/BrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/config/detekt-baseline.xml"], "git_node": "2d2babc70db1c5c327468b3618457800cbec8a6a", "git_parents": ["31dd11d067fad9a4108775afc3dd41fb25dde137"], "node": "540264f237873c0b64997e22758ccdf9324e81ff", "parents": ["10a8aa6db8dda8dbd6b111d7737929816361c7d8"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2085248 - Deal with one DoDataAvailable overlapping both special buffer boundaries. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342510\n", "files": ["parser/html/nsHtml5StreamParser.cpp", "parser/html/nsHtml5StreamParser.h", "parser/htmlparser/tests/mochitest/browser.toml", "parser/htmlparser/tests/mochitest/browser_file_url_buffer_boundaries.js"], "git_node": "aaad0218b6fcf58666d72fd122e19d956f665919", "git_parents": ["2d2babc70db1c5c327468b3618457800cbec8a6a"], "node": "a80d36f156f7101b2974a470337bae087bf23411", "parents": ["540264f237873c0b64997e22758ccdf9324e81ff"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090279 - Don't trigger notifications during GC callback r=mccr8\n\nThe assertion added in bug 2076890 is failing because we're running script in\nan interrupted realm. The flow is as follows:\n\n 1. Allocation triggers GC\n 2. GC callback causes CC to finish ongoing CC\n 3. CC destroys some white objects\n 4. Destructors trigger notifications\n 5. Notification observers run script\n\nI should probably have realized that this could happen because allocation\ntriggering GC is a normal thing to happen, so any script run during the GC\ncallback will trigger this.\n\nThe patch aims to fix this by deferring notifications that happen during the\ndestruction of cycle collected objects. If there are other routes to running JS\nthen this will not be complete fix.\n\nThe patch adds a second way for notifications to be blocked in addition to\nscript blockers. (It is not possible to use a script blocker here because their\nscope would need to extend beyond the end of the GC.) Then notifications that\ncan be triggered from destructors are migrated to use NotifyWhenScriptSafe.\nWhen called during the GC callback this queues a runnable to trigger the\nnotification later.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341450\n", "files": ["accessible/base/nsAccessibilityService.cpp", "docshell/base/BrowsingContext.cpp", "docshell/base/nsDocShell.cpp", "dom/base/Document.cpp", "dom/base/nsJSEnvironment.cpp", "dom/events/EventStateManager.cpp", "dom/media/autoplay/GVAutoplayPermissionRequest.cpp", "dom/media/webaudio/AudioNode.cpp", "js/xpconnect/src/XPCJSRuntime.cpp", "toolkit/components/windowwatcher/nsWindowWatcher.cpp", "xpcom/base/CycleCollectedJSRuntime.cpp", "xpcom/base/CycleCollectedJSRuntime.h", "xpcom/base/nsCycleCollector.cpp", "xpcom/base/nsCycleCollector.h", "xpcom/components/nsComponentManager.cpp", "xpcom/ds/nsObserverService.cpp", "xpcom/ds/nsObserverService.h"], "git_node": "5b4cc561b247c530f412e5a438b19e0bb08b795f", "git_parents": ["aaad0218b6fcf58666d72fd122e19d956f665919"], "node": "9efe00668200143603ff6caf65c3b89b46eb2c64", "parents": ["a80d36f156f7101b2974a470337bae087bf23411"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086884 - Remove browser_telemetry_activation.js r=firefox-desktop-core-reviewers ,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342551\n", "files": ["browser/components/tests/browser/browser.toml", "browser/components/tests/browser/browser_telemetry_activation.js"], "git_node": "a3460ba767a2a927a3665c46517a23e5d8094469", "git_parents": ["5b4cc561b247c530f412e5a438b19e0bb08b795f"], "node": "df246a129cd78dbe10279ef8fda555cbea80cfb3", "parents": ["9efe00668200143603ff6caf65c3b89b46eb2c64"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086884 - Stop recording Windows Start search activations r=firefox-desktop-core-reviewers ,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342552\n", "files": ["browser/components/BrowserContentHandler.sys.mjs"], "git_node": "186b1a421eb7783e5bf7c37178b602fff1e764c7", "git_parents": ["a3460ba767a2a927a3665c46517a23e5d8094469"], "node": "ece9196334b14ec928b1b3518a8b28d39523a858", "parents": ["df246a129cd78dbe10279ef8fda555cbea80cfb3"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086884 - Remove browser.engagement.windows_start_search_activation_count r=firefox-desktop-core-reviewers ,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342553\n", "files": ["browser/base/content/metrics.yaml", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "765b9fb0e0614cc8179f2a4a0e325917e5dd0c75", "git_parents": ["186b1a421eb7783e5bf7c37178b602fff1e764c7"], "node": "3fcad744aafeca985f649456bf532ffe8993d369", "parents": ["ece9196334b14ec928b1b3518a8b28d39523a858"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088661 - Expose finalization records when they are queued r=spidermonkey-reviewers,sfink\n\nA previous fix exposed the host callback function and incumbent global but\nmissed the held value which could also be gray. The fix is to expose the\nrecord itself, which entrains all of this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340899\n", "files": ["js/src/builtin/FinalizationRegistryObject.cpp", "js/src/gc/FinalizationObservers.cpp"], "git_node": "7243500a62b746b894d11be480e99d9fccc1f3c2", "git_parents": ["765b9fb0e0614cc8179f2a4a0e325917e5dd0c75"], "node": "a5518278fa7c57c5dbe12a2e06b91286da7ed167", "parents": ["3fcad744aafeca985f649456bf532ffe8993d369"], "tags": []}, {"author": "Sarah Clements \u003csclements@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092547 - Update contributor guidelines in firefox source docs r=Gijs,firefox-source-docs-reviewers,marco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338745\n", "files": ["docs/contributing/contribution_quickref.md", "docs/setup/contributing_code.md"], "git_node": "21a88e0f3a1fa6b5fe015e64b40a4d262dcf8a5c", "git_parents": ["7243500a62b746b894d11be480e99d9fccc1f3c2"], "node": "d25ca8609c90de485fee49a66914043dd57d4419", "parents": ["a5518278fa7c57c5dbe12a2e06b91286da7ed167"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2092576 - Mention git instead of Mercurial in the profiler code overview. r=profiler-reviewers,canova DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342684\n", "files": ["tools/profiler/docs/code-overview.md"], "git_node": "c825096c7afd955dae1945410289fd4de4a008e9", "git_parents": ["21a88e0f3a1fa6b5fe015e64b40a4d262dcf8a5c"], "node": "fd5a94e22ac2c092ef6c369d421788072c116687", "parents": ["d25ca8609c90de485fee49a66914043dd57d4419"], "tags": []}, {"author": "Aleix Pol i Gonzalez \u003caleix.pol@codethink.co.uk\u003e", "branch": "default", "desc": "Bug 2093287 - Enable layout.css.background-clip.border-area.enabled by default r=emilio\n\nIt should be safe to enable the feature and track its progress as it deploys.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343064\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "d764144a649e396134ac349d164744ff8b922e49", "git_parents": ["c825096c7afd955dae1945410289fd4de4a008e9"], "node": "7dd5f00372663bc2f79cf8d9fa58249f0eba5c03", "parents": ["fd5a94e22ac2c092ef6c369d421788072c116687"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2088661 - Expose finalization records when they are queued r=spidermonkey-reviewers,sfink\" for causing reftests failures at src/gc/GC.cpp\n\nThis reverts commit 7243500a62b746b894d11be480e99d9fccc1f3c2.\n", "files": ["js/src/builtin/FinalizationRegistryObject.cpp", "js/src/gc/FinalizationObservers.cpp"], "git_node": "478e895f150274cea921ee3f0e88dd6d9ad293d4", "git_parents": ["d764144a649e396134ac349d164744ff8b922e49"], "node": "b42afc9031597a963be194fec1a7903f480159ab", "parents": ["7dd5f00372663bc2f79cf8d9fa58249f0eba5c03"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2091989 - Clear history after browser_switchToTab_closes_newtab.js, r=urlbar-reviewers,Standard8.\n\nThe dummy_page.html visit it leaves behind outranks the switch-to-tab result in browser_switchToTab_fullUrl_repeatedKeydown.js once the test has run twice, so that test opens the history result and times out waiting for the tab switch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342133\n", "files": ["browser/components/urlbar/tests/browser-tabs/browser_switchToTab_closes_newtab.js"], "git_node": "171622d52ef913fdb56351572c91bb5f0527086a", "git_parents": ["478e895f150274cea921ee3f0e88dd6d9ad293d4"], "node": "b99df30411001bfd49422c97656654e16834c28b", "parents": ["b42afc9031597a963be194fec1a7903f480159ab"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092294 - Make browser_aboutthirdparty.js pass when run again in the same session, r=firefox-desktop-core-reviewers ,Gijs.\n\nThe test assumed it was the first load of TestShellEx.dll in the session.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342349\n", "files": ["toolkit/components/aboutthirdparty/tests/browser/browser_aboutthirdparty.js"], "git_node": "444ee6cf408cfe50e5cde6dff21247f7b39b8d08", "git_parents": ["171622d52ef913fdb56351572c91bb5f0527086a"], "node": "e186043bd0beb60f53127ac821d31d54523af407", "parents": ["b99df30411001bfd49422c97656654e16834c28b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092281 - Restore distribution.id and the profile reset time after browser_UITour.js changes them, r=Gijs.\n\nBoth leaked into a second run of the test in the same browser, failing its 'expected distribution value' and 'profileResetWeeksAgo should be null' checks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342343\n", "files": ["browser/components/uitour/test/browser_UITour.js"], "git_node": "26d479770ff771994ec4fb188e563c73d8ccbabb", "git_parents": ["444ee6cf408cfe50e5cde6dff21247f7b39b8d08"], "node": "5c47bc280e86401933670ecdcd14e01764371fc5", "parents": ["e186043bd0beb60f53127ac821d31d54523af407"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092328 - Keep the name of DOMExceptions rejected by a PromiseWorker, r=firefox-desktop-core-reviewers ,Gijs.\n\nThe main thread rebuilds the DOMException with error.name, which the worker\nnever sent, so every such rejection arrived with the name \"Error\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342379\n", "files": ["toolkit/components/promiseworker/tests/xpcshell/data/worker.js", "toolkit/components/promiseworker/tests/xpcshell/data/worker.mjs", "toolkit/components/promiseworker/tests/xpcshell/test_Promise.js", "toolkit/components/promiseworker/tests/xpcshell/test_PromiseESM.js", "toolkit/components/promiseworker/worker/PromiseWorker.template.worker.js"], "git_node": "9e469e33d29fafbc0120ed2cd46cc73691b8b815", "git_parents": ["26d479770ff771994ec4fb188e563c73d8ccbabb"], "node": "206df8b00c5966d7ec18bd60028ea0d9e14ccd76", "parents": ["5c47bc280e86401933670ecdcd14e01764371fc5"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092328 - Ignore the error IOUtils raises for an existing thumbnail when not overwriting, r=firefox-desktop-core-reviewers ,Gijs.\n\n_eatNoOverwriteError checked for TypeMismatchError, but IOUtils rejects\nwith NoModificationAllowedError, so storing an existing thumbnail threw,\nskipping page-thumbnail:create and the redirect-source copy. That made\nbrowser_thumbnails_bg_basic.js time out on its second run, as its first\nleaves the HTTPS-upgraded thumbnail behind.\n\nAlso remove the Windows 11 verify-standalone skip-if from bug 1405428\n(does not pass test-verify): it is the same second-run timeout.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342380\n", "files": ["toolkit/components/thumbnails/PageThumbs.sys.mjs", "toolkit/components/thumbnails/test/browser.toml"], "git_node": "8f6e3e85765285458d7f25498bd666f6bb862797", "git_parents": ["9e469e33d29fafbc0120ed2cd46cc73691b8b815"], "node": "81591d1f60b2e25ec88eec7ac89fcbfafa826ebe", "parents": ["206df8b00c5966d7ec18bd60028ea0d9e14ccd76"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1972348 - Remove CaptivePortalWatcher's pending recheck observer when its window closes, r=firefox-desktop-core-reviewers ,Gijs.\n\nWhen a portal is already detected as a browser window opens, the window waits for a 'captive-portal-check-complete' notification after it gets focus. If it closes first, the observer service keeps the observer, and with it the window, alive until shutdown. browser_captivePortal_certErrorUI.js hits this when it runs twice in a row (its last task leaves the portal locked) and under test-verify, so its debug && verify-standalone skip-if from bug 1995208 goes too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342587\n", "files": ["browser/base/content/browser-captivePortal.js", "browser/base/content/test/browser-captivePortal/browser.toml"], "git_node": "2f89767c9f85e0cd2a78d5525944fda738f2d383", "git_parents": ["8f6e3e85765285458d7f25498bd666f6bb862797"], "node": "983b5270da2448accbe1585de9b83b7f19df149b", "parents": ["81591d1f60b2e25ec88eec7ac89fcbfafa826ebe"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093218 - Update android nightly application-services version bump to c9779968093346a3bcdd10d099be8de28c2b49e9 r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343027\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "bd883f44120da7c65038fef25ad93b41ded133f1", "git_parents": ["2f89767c9f85e0cd2a78d5525944fda738f2d383"], "node": "d3b8c0799202eb74aaf418727af7bebceb5dd61e", "parents": ["983b5270da2448accbe1585de9b83b7f19df149b"], "tags": []}, {"author": "Khaled Hosny \u003ckhaled@aliftype.com\u003e", "branch": "default", "desc": "Bug 2088686 - Pass FontConfig named-instance index to HarfBuzz. r=gfx-reviewers,jfkthame,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340098\n", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp"], "git_node": "b914cdc2e52ef5dd4595147f1658ea94a22c1e56", "git_parents": ["bd883f44120da7c65038fef25ad93b41ded133f1"], "node": "2bb6db3b71df75c52d6d771830ce5d8f6344c410", "parents": ["d3b8c0799202eb74aaf418727af7bebceb5dd61e"], "tags": []}, {"author": "Celeste \"Coelacanthus\" Liu \u003cuwu@coelacanthus.name\u003e", "branch": "default", "desc": "Bug 2093248 - should pass length w/o NUL into AddNativeFontHandle(). r=lsalzman,gfx-reviewers\n\nAddNativeFontHandle() forwards the filename length to a length-based\nstd::string constructor which expect without NUL. Including NUL makes\nit has an extra NUL in content, then the stored path compare unequal\nto Fontconfig's identical filename, triggering fallback that clears\nthe named-instance bits so it use wrongly default one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343047\n", "files": ["gfx/webrender_bindings/src/moz2d_renderer.rs"], "git_node": "490b7afafd1c2e52fedb99b87fe3a550aaad9f7f", "git_parents": ["b914cdc2e52ef5dd4595147f1658ea94a22c1e56"], "node": "011c554143d4b73de08ec2c27bebe159671a6965", "parents": ["2bb6db3b71df75c52d6d771830ce5d8f6344c410"], "tags": []}, {"author": "Jo\u00e3o K Bresser \u003cjoao.bresserpereira@gmail.com\u003e", "branch": "default", "desc": "Bug 2090091 - Expose Use Selection for Find in macOS keyboard customization. r=firefox-desktop-core-reviewers ,fluent-reviewers,flod,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340391\n", "files": ["browser/components/customkeys/CustomKeysParent.sys.mjs", "browser/components/customkeys/tests/browser/browser.toml", "browser/components/customkeys/tests/browser/browser_aboutKeyboard_findSelection.js", "browser/locales/en-US/browser/customkeys.ftl"], "git_node": "aa31aafde8e21920c736a92bc8cf76b616176567", "git_parents": ["490b7afafd1c2e52fedb99b87fe3a550aaad9f7f"], "node": "705c901a16a032e4976866465842cadcae8c8b22", "parents": ["011c554143d4b73de08ec2c27bebe159671a6965"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083276 - Revert the metadata update for encrypted-media/* tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343056\n", "files": ["testing/web-platform/meta/encrypted-media/drm-events.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-keystatuses-multiple-sessions.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-clear-encrypted.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-encrypted-clear-sources.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-encrypted-clear.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-multikey.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-after-src.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-after-update.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-immediately.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-onencrypted.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-two-videos.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-waitingforkey.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-again-after-playback.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-again-after-resetting-src.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-waiting-for-a-key.https.html.ini"], "git_node": "a7a01435081d5d614f5c3e2d76e6f7d585f2c6e0", "git_parents": ["aa31aafde8e21920c736a92bc8cf76b616176567"], "node": "341dab2a6fb5b419f47f621fd6a10a3135eb8f3b", "parents": ["705c901a16a032e4976866465842cadcae8c8b22"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093091 - Part 1. Only cancel the remote texture ready checks of the caller. r=gfx-reviewers,lsalzman\n\nSuppressRemoteTextureReadyCheck dropped every pending ready check waiting\nfor an unregistered owner, including those of other image hosts, which\nwould then never be woken. Cancel only the caller's own checks, and\nrelease them after the call since they may hold the last reference to the\ncaller.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342952\n", "files": ["gfx/layers/RemoteTextureMap.cpp", "gfx/layers/RemoteTextureMap.h", "gfx/layers/wr/WebRenderImageHost.cpp", "gfx/tests/gtest/TestRemoteTextureMap.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp"], "git_node": "af13fcc7d2f0e8bdd7e459a1b1f97f463fe2179b", "git_parents": ["a7a01435081d5d614f5c3e2d76e6f7d585f2c6e0"], "node": "2eda5a850c093f4d0ef4c2da82f92a7772e1c6bc", "parents": ["341dab2a6fb5b419f47f621fd6a10a3135eb8f3b"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093091 - Part 2. Keep WebRenderImageHost's remote texture ready check in sync with its pending textures. r=gfx-reviewers,lsalzman\n\nClearing the pending remote textures did not reset mWaitingReadyCallback,\nso the host could ignore every later texture, and a ready callback for an\nowner that went away was treated as obsolete and left it waiting. Track\nthe pending ready check by generation instead of by owner, cancel it when\nthe pending textures are cleared, and check again on any callback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342953\n", "files": ["gfx/layers/wr/WebRenderImageHost.cpp", "gfx/layers/wr/WebRenderImageHost.h"], "git_node": "5b40e4921d04147a8be21acc0f676836810cd502", "git_parents": ["af13fcc7d2f0e8bdd7e459a1b1f97f463fe2179b"], "node": "a269f04d98bf62c3ea19e500d3dda2d92814dff0", "parents": ["2eda5a850c093f4d0ef4c2da82f92a7772e1c6bc"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093091 - Part 3. Wait for pending async remote textures when taking a compositor snapshot. r=gfx-reviewers,lsalzman\n\nRemote textures presented via ImageBridge are only shown once their ready\ncheck completes, so a snapshot taken in the meantime, such as for a reftest,\ncould miss the latest frame or show nothing at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342954\n", "files": ["gfx/layers/wr/AsyncImagePipelineManager.cpp", "gfx/layers/wr/AsyncImagePipelineManager.h", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderImageHost.cpp", "gfx/layers/wr/WebRenderImageHost.h"], "git_node": "df7c14f5e7f5a903f5900e38660cb545d1a53638", "git_parents": ["5b40e4921d04147a8be21acc0f676836810cd502"], "node": "d82261fb103f2a2e272e8b5db99245ecb73138a8", "parents": ["a269f04d98bf62c3ea19e500d3dda2d92814dff0"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092807 - Disable html/syntax/parsing/custom-element-reparenting-shadow-cycle.html to avoid crashes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343100\n", "files": ["testing/web-platform/meta/html/syntax/parsing/custom-element-reparenting-shadow-cycle.html.ini"], "git_node": "1c7e1aa4dc48157472e77d0e5c5e257048806213", "git_parents": ["df7c14f5e7f5a903f5900e38660cb545d1a53638"], "node": "9d2cad3d5e8d226fde323f1295c5a65ac06fe93e", "parents": ["d82261fb103f2a2e272e8b5db99245ecb73138a8"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2093319 Set XDG_ACTIVATION_TOKEN when we actually have it r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343109\n", "files": ["toolkit/system/gnome/nsGIOService.cpp"], "git_node": "6351f3f3d8293b83a212a3aa776c5751a91fa102", "git_parents": ["1c7e1aa4dc48157472e77d0e5c5e257048806213"], "node": "5422df9f874c6ee316da0b9e46fad6a82046d1a4", "parents": ["9d2cad3d5e8d226fde323f1295c5a65ac06fe93e"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2089209 - Wait for the toolbar to be ready before typing in the Android resource usage tests. r=perftest-reviewers,aglavic\n\nI encountered flakiness while running this test locally on my Pixel 6.\nThis patch made it less flaky.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339726\n", "files": ["testing/performance/android-resource/test-android-resource-usage.sh"], "git_node": "ac570035cdb4cc3ccc66072cf384ca8ebdb48b60", "git_parents": ["6351f3f3d8293b83a212a3aa776c5751a91fa102"], "node": "24a80c2afb019fabf2b9a1c6448ef7c16c2b3cb4", "parents": ["5422df9f874c6ee316da0b9e46fad6a82046d1a4"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092035 - Match nested URIs on their innermost URI in ContentClassifierRequest. r=bvandersloot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342149\n", "files": ["toolkit/components/content-classifier/content_classifier_engine/ContentClassifierEngine.cpp", "toolkit/components/content-classifier/test/browser/browser.toml", "toolkit/components/content-classifier/test/browser/browser_content_classifier_nested_uri.js"], "git_node": "3b7dfae82ebfad6358db3df4ba0adcbe8896682a", "git_parents": ["ac570035cdb4cc3ccc66072cf384ca8ebdb48b60"], "node": "d22423f9743cd0456fbd026c68e5264fdda3f385", "parents": ["24a80c2afb019fabf2b9a1c6448ef7c16c2b3cb4"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092591 - Remove PrincipalInfo usage from PFetch. r=necko-reviewers,jesup\n\nSerializing the principal can no longer fail gracefully and instead hits the\nMOZ_RELEASE_ASSERT in ParamTraits\u003cnsIPrincipal*\u003e::Write. That is fine because\nPrincipalToPrincipalInfo only fails if nsIURI::GetSpec fails, and none of the\nURI implementations a principal can hold fail there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342633\n", "files": ["dom/fetch/Fetch.cpp", "dom/fetch/FetchParent.cpp", "dom/fetch/FetchParent.h", "dom/fetch/FetchService.cpp", "dom/fetch/FetchService.h", "dom/fetch/PFetch.ipdl", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "890b922b4ee36929d1c34154e08bc3916f908223", "git_parents": ["3b7dfae82ebfad6358db3df4ba0adcbe8896682a"], "node": "6a686a75d1bd5db7543ce4c96b0be5cb6533bcb7", "parents": ["d22423f9743cd0456fbd026c68e5264fdda3f385"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1835679 - Show the perfdocs YAML config path in missing description failures. r=mozperftest-reviewers,sparky\n\nThe perfdocs verifier warnings for a missing suite, test or metric\ndescription did not say which file the description belongs in. Each of\nthese messages now names the framework's perfdocs YAML config, relative\nto the source root. This also covers bug 1953825 and bug 2092106.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339663\n", "files": ["python/mozperftest/mozperftest/perfdocs/verifier.py", "python/mozperftest/mozperftest/tests/test_perfdocs.py"], "git_node": "e4e8ac5afca58805e8482be6459b6dda0d8cc4a1", "git_parents": ["890b922b4ee36929d1c34154e08bc3916f908223"], "node": "0421fba218fa2806adac3efd9433eec8f71be280", "parents": ["6a686a75d1bd5db7543ce4c96b0be5cb6533bcb7"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1630032 - Resolve a relative raptor --binary path before mozharness changes directory. r=perftest-reviewers,sparky\n\nmozharness changes the working directory early and then forwards the raw mach arguments to raptor, so a relative --binary path was checked against testing/mozharness/build. Make the path absolute in the mach command and rewrite it in the forwarded arguments.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338455\n", "files": ["testing/raptor/mach_commands.py", "testing/raptor/raptor/cmdline.py", "testing/raptor/test/test_cmdline.py"], "git_node": "f36a626ca0260a46d949f3260deea280705478f1", "git_parents": ["e4e8ac5afca58805e8482be6459b6dda0d8cc4a1"], "node": "39d10fcfa96fe9c0d8fe314596fee0191b1fc677", "parents": ["0421fba218fa2806adac3efd9433eec8f71be280"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2013119 - Reuse dbus menuitems more aggressively. r=stransky,gtk-reviewers\n\nThere are two issues here that prevent submenus from working great:\n\n * The first one is that the about-to-show signal in libdbusmenu\n   is supposed to be sync, but it's not [1].\n * The other one is that some clients don't re-fetch submenus\n   when they're open.\n\nSo we don't have a great way to update our submenus other than\ntrying to reuse the already existing items it seems...\n\n[1]: https://github.com/JetBrains/libdbusmenu/blob/38d7a2ada4b2a08c535491d43a39825868f2b065/libdbusmenu-glib/server.c#L1835-L1839\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342995\n", "files": ["widget/gtk/NativeMenuGtk.cpp"], "git_node": "55653b00d6f9e74e3f3f56608292758e8a477d79", "git_parents": ["f36a626ca0260a46d949f3260deea280705478f1"], "node": "53a45b9fd7aee19d8f260f32af1f0a09984e77d0", "parents": ["39d10fcfa96fe9c0d8fe314596fee0191b1fc677"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2013119 - Remove placeholder items. r=stransky,gtk-reviewers\n\nThe display property is a better fix for this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342996\n", "files": ["widget/gtk/NativeMenuGtk.cpp"], "git_node": "24d67e56e08b614b0e4f0fd47f75047f04050c6c", "git_parents": ["55653b00d6f9e74e3f3f56608292758e8a477d79"], "node": "636a84225f27e5d609bc268b2cbbc2b4bca6edc0", "parents": ["53a45b9fd7aee19d8f260f32af1f0a09984e77d0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2013119 - Fix disabled native menu handling. r=stransky,gtk-reviewers\n\nThis causes some menus to be less weird / not be empty, like\nthe bookmarks toolbar menu by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342997\n", "files": ["widget/gtk/NativeMenuGtk.cpp"], "git_node": "38f0a3059a30be30d8c4a97f8b38498757415e2f", "git_parents": ["24d67e56e08b614b0e4f0fd47f75047f04050c6c"], "node": "f2088db692f0ce2ab84e8bd0e43a76fa5ab36ce7", "parents": ["636a84225f27e5d609bc268b2cbbc2b4bca6edc0"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2092488 - Increase fuzzing on a couple of tier-2 text related tests. r=layout-reviewers,emilio\n\nThe large difference in textpath-selection comes from the fact that the ref is rendered in WR and gets sub-px aa while the test has gray-scale aa.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342687\n", "files": ["layout/reftests/svg/text/reftest.list"], "git_node": "2e04b34dbaea55bccea42c0a58980ba246e5f0b6", "git_parents": ["38f0a3059a30be30d8c4a97f8b38498757415e2f"], "node": "2a2882687d59c1bd68fc273a86b788975a01a80f", "parents": ["f2088db692f0ce2ab84e8bd0e43a76fa5ab36ce7"], "tags": []}, {"author": "Fabio Kaminski \u003cfabio.kaminski@codethink.co.uk\u003e", "branch": "default", "desc": "Bug 2086168 - EXT_texture_norm16 texture filtering support. r=gfx-reviewers,wsmind\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337273\n", "files": ["dom/canvas/WebGLExtensions.cpp", "dom/canvas/test/webgl-conf/checkout/conformance2/extensions/ext-texture-norm16.html"], "git_node": "a69d080f21ab69a41a51de69370cba21269edb39", "git_parents": ["2e04b34dbaea55bccea42c0a58980ba246e5f0b6"], "node": "cdd09f1b3ef6b49012faf80927b6536069d3e753", "parents": ["2a2882687d59c1bd68fc273a86b788975a01a80f"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093302 - Use the PolicyContainer helpers for CheckCSPFrameAncestorPolicy. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343090\n", "files": ["dom/security/PolicyContainer.cpp", "dom/security/PolicyContainer.h", "dom/security/nsContentSecurityUtils.cpp", "dom/workers/loader/NetworkLoadHandler.cpp"], "git_node": "0aa4241ee33e010c9cce61bdb658575e925309e7", "git_parents": ["a69d080f21ab69a41a51de69370cba21269edb39"], "node": "8a04ca2e832c057227135892a70999e201c415db", "parents": ["cdd09f1b3ef6b49012faf80927b6536069d3e753"], "tags": []}, {"author": "Molly Shillabeer \u003cmshillabeer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092677 - Switch conversation starters to new convo-starters service type r=rrando\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342762\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/tests/xpcshell/test_ConversationSuggestions.js"], "git_node": "1caa090e07448b6df7a8689f68709d9e368599c7", "git_parents": ["0aa4241ee33e010c9cce61bdb658575e925309e7"], "node": "77dae795453bad406ee428da01b6536c9f4031fa", "parents": ["8a04ca2e832c057227135892a70999e201c415db"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2091677 - Use a dedicated NodeHTTP2Server in test_altsvc_cache_last-pb-context-exited.js. r=afucks,necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343105\n", "files": ["netwerk/test/unit/test_altsvc_cache_last-pb-context-exited.js"], "git_node": "7398faecf6eb23c4feb62fb847bc420bcafb0068", "git_parents": ["1caa090e07448b6df7a8689f68709d9e368599c7"], "node": "bca4133ac4e33a1af279c721cc27c55e41866938", "parents": ["77dae795453bad406ee428da01b6536c9f4031fa"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2092666 - Make the NTLM test servers echo the signing flags in their type 2 challenge. r=necko-reviewers,kershaw\n\nSince KB5135557 SSPI offers NTLMSSP_NEGOTIATE_SIGN and fails the type 2\nwith SEC_E_UNSUPPORTED_FUNCTION when the server's challenge doesn't\naccept it, so test_ntlm_web_auth.js and\ntest_ntlm_native_server_validation.js never sent a type 3 on Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343094\n", "files": ["netwerk/test/unit/test_ntlm_native_server_validation.js", "netwerk/test/unit/test_ntlm_web_auth.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "d26d299c86e2acc4bb07947e6f69d073720106bc", "git_parents": ["7398faecf6eb23c4feb62fb847bc420bcafb0068"], "node": "24f05e724023ca38fcfb2ad0040704d426028aa4", "parents": ["bca4133ac4e33a1af279c721cc27c55e41866938"], "tags": []}, {"author": "Arne Fucks \u003cafucks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084710 - Handle parsed /etc/hosts entries on main thread. r=valentin,necko-reviewers,jesup\n\nAdditionally unset sTRRServicePtr when destroying TRRService.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342654\n", "files": ["netwerk/dns/TRRService.cpp"], "git_node": "8df170bed996b3223f434ec9af1f992e02ab920c", "git_parents": ["d26d299c86e2acc4bb07947e6f69d073720106bc"], "node": "0ba9bf4f838884a2dbc1654f7c55813015f98f90", "parents": ["24f05e724023ca38fcfb2ad0040704d426028aa4"], "tags": []}, {"author": "Kartikaya Gupta \u003ckgupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089739 - Use faster exponentiation function. r=padenot,media-playback-reviewers\n\nUsing fdlibm_expf instead of fdlibm_powf is apparently somewhat\nfaster and produces a noticable improvement on the speedometer4\nbenchmark. The change does introduce minor floating-point\nrounding changes but I don't expect that to be an issue here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340082\n", "files": ["dom/media/webaudio/WebAudioUtils.h"], "git_node": "cb06cf4cee8f5ac6ac54b48a56764ea6a8a87ce8", "git_parents": ["8df170bed996b3223f434ec9af1f992e02ab920c"], "node": "0c0490d7a7fb35dac66b2c6d875c04d01849518a", "parents": ["0ba9bf4f838884a2dbc1654f7c55813015f98f90"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2090938 - Forward the result principal URI of early hint preloads to the child process. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342523\n", "files": ["netwerk/protocol/http/HttpChannelChild.cpp", "netwerk/protocol/http/HttpChannelParams.ipdlh", "netwerk/protocol/http/HttpChannelParent.cpp"], "git_node": "1b00f58c686d12c0d33755695644abf0577100ed", "git_parents": ["cb06cf4cee8f5ac6ac54b48a56764ea6a8a87ce8"], "node": "a063b596ab2a77b1707578d0bdc1156db8715163", "parents": ["0c0490d7a7fb35dac66b2c6d875c04d01849518a"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2090938 - Use the final URI of redirected early hint preloads in the child process. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342525\n", "files": ["netwerk/protocol/http/HttpChannelChild.cpp", "netwerk/protocol/http/HttpChannelParams.ipdlh", "netwerk/protocol/http/HttpChannelParent.cpp"], "git_node": "668867dcf4b5c766b49aefe87004f4ef49b6efc5", "git_parents": ["1b00f58c686d12c0d33755695644abf0577100ed"], "node": "a4642b44ac453e39f26ce33a2b7ce5d3c9bda69e", "parents": ["a063b596ab2a77b1707578d0bdc1156db8715163"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070364 - Mirror MediaStreamTrack's graph track ended state. r=karlt\n\nMediaStreamTrack's graph listener now only tracks PrincipalHandle changes.\nThe ended state of the track's ForwardedInputTrack is mirrored from the\ngraph instead. Ending still happens from a task queued when the mirror\nchanges, so the \"ended\" event fires after the task that learned of the end,\nas it did with the listener.\n\nCreateForwardedInputTrack() takes the track flags so that the track can\nenable canonicals.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324931\n", "files": ["dom/media/AudioStreamTrack.cpp", "dom/media/MediaStreamTrack.cpp", "dom/media/MediaStreamTrack.h", "dom/media/MediaTrackGraph.cpp", "dom/media/MediaTrackGraph.h"], "git_node": "c92974df140569f943f306255c0a29ee7939ba5b", "git_parents": ["668867dcf4b5c766b49aefe87004f4ef49b6efc5"], "node": "e704c776fad1991177e3a55adf272e5502cec151", "parents": ["a4642b44ac453e39f26ce33a2b7ce5d3c9bda69e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070364 - Add a per-track canonical for the principal handle. r=karlt\n\nIt carries the PrincipalHandle of the most recent data in the track, set\nwhere the graph updates the segment's last principal handle. Consumers can\nmirror it instead of listening for changes on the graph thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324932\n", "files": ["dom/media/MediaTrackGraph.cpp", "dom/media/MediaTrackGraph.h"], "git_node": "1b055a76628510b070fe25d79813323e7967769c", "git_parents": ["c92974df140569f943f306255c0a29ee7939ba5b"], "node": "cc6b842ad2bb4595c1dbe49afe075b494439ee8b", "parents": ["e704c776fad1991177e3a55adf272e5502cec151"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070364 - Give PrincipalHandle a generation id so principal changes are not coalesced. r=karlt,media-playback-reviewers,webrtc-reviewers,bwc\n\nPrincipalHandle was an nsMainThreadPtrHandle, which compares equal for any two\nhandles of the same nsIPrincipal. A principal that changes away and back within\none graph iteration, e.g. A to B to A, leaves the per-track principal handle\nCanonical unchanged, so its mirrors never fire. A MediaStreamTrack mirroring it,\nas the next commit makes it do, would wait for the graph to flush the old\nprincipal out and keep its combined principal indefinitely.\n\nPrincipalHandle is now a struct of that handle and a generation id taken from a\ncounter on construction. Handles are equal if they share the id, so each made\nhandle is a distinct state while copies stay equal.\n\nMediaDecoder::SetOutputTracksPrincipal() keeps the current handle if the\nprincipal is unchanged, rather than announcing a change that did not happen.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337385\n", "files": ["dom/media/CanvasCaptureMediaStream.cpp", "dom/media/MediaDecoder.cpp", "dom/media/MediaManager.cpp", "dom/media/MediaManager.h", "dom/media/PrincipalHandle.h", "dom/media/VideoFrameContainer.cpp", "dom/media/driftcontrol/gtest/TestAudioChunkList.cpp", "dom/media/driftcontrol/gtest/TestAudioDriftCorrection.cpp", "dom/media/driftcontrol/gtest/TestAudioResampler.cpp", "dom/media/gtest/TestAudioDecoderInputTrack.cpp", "dom/media/gtest/TestAudioInputProcessing.cpp", "dom/media/gtest/TestAudioInputSource.cpp", "dom/media/gtest/TestDeviceInputTrack.cpp", "dom/media/gtest/TestPrincipalHandle.cpp", "dom/media/gtest/TestVideoFrameContainer.cpp", "dom/media/gtest/moz.build", "dom/media/webrtc/jsapi/RTCRtpReceiver.cpp", "dom/media/webrtc/transportbridge/MediaPipeline.cpp"], "git_node": "924ba8a847ae6ec53ff03acca7e7b15b42835ef3", "git_parents": ["1b055a76628510b070fe25d79813323e7967769c"], "node": "9b91fbf6d53aaf66bff2322e2342470973e7b5dd", "parents": ["cc6b842ad2bb4595c1dbe49afe075b494439ee8b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070364 - Mirror MediaStreamTrack's graph track principal handle and remove MTGListener. r=karlt\n\nThe PrincipalHandle of the data flowing through a MediaStreamTrack's graph track\nis now mirrored from the graph, like its ended state, which was the last thing\nMTGListener was for. The pending principal is adopted from the watch callback\nexactly as before. A mirror carries the latest value rather than every change,\nso several changes within one graph iteration collapse into one. With the\nPrincipalHandle generation id from the previous commit, a change away from a\nprincipal and back still changes the mirrored value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324933\n", "files": ["dom/media/MediaStreamTrack.cpp", "dom/media/MediaStreamTrack.h"], "git_node": "b441476c26c7be06ecddd1d2263424e0a8abd3fd", "git_parents": ["924ba8a847ae6ec53ff03acca7e7b15b42835ef3"], "node": "745d3d428ecd0d5900c7a001a9c9bb8d0ef39098", "parents": ["9b91fbf6d53aaf66bff2322e2342470973e7b5dd"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070364 - Remove MediaTrackListener::NotifyPrincipalHandleChanged. r=karlt\n\nIts only consumer now mirrors the track's principal handle canonical.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324934\n", "files": ["dom/media/MediaTrackGraph.cpp", "dom/media/MediaTrackListener.h"], "git_node": "bec8778e68934429e31713b96b7918e1bb144bfe", "git_parents": ["b441476c26c7be06ecddd1d2263424e0a8abd3fd"], "node": "eb5c89cf4cbb445d2cb662f6d9d9839b3966e43f", "parents": ["745d3d428ecd0d5900c7a001a9c9bb8d0ef39098"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091782 - add claude skill for retrace. r=padenot\n\nThis will make it easier to get the original stack trace out from a crash report.\n\n\u003cimg width=\"1345\" height=\"896\" alt=\"updated image showing claude session with separate retrace skill\" src=\"https://github.com/user-attachments/assets/f843f614-1808-4924-9d59-06d60284bf4e\" /\u003e\n\nCurrently verified:\n- running the python script locally\n- using the skill locally\n\nNow the obfuscation change has landed in nightly, have also verified\n- decoding a real socorro crash\n- the play console fallback route for getting hold of an `.aab`\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/443\n", "files": [".agents/skills/android-retrace/SKILL.md", ".agents/skills/android-retrace/retrace.py", ".agents/skills/android-retrace/tests/test_retrace.py", ".claude/skills/android-retrace/SKILL.md", ".claude/skills/android-retrace/retrace.py", ".claude/skills/android-retrace/tests/test_retrace.py"], "git_node": "ea7f49d1369fcffa0ddb0b0dc3e99237f1e32a26", "git_parents": ["bec8778e68934429e31713b96b7918e1bb144bfe"], "node": "cb5c9da14a3aee93e9bd0982822729df450ffffa", "parents": ["eb5c89cf4cbb445d2cb662f6d9d9839b3966e43f"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070230 - Update Focus Nightly UI tests to use new arm-nightly-full Flank configuration. r=geckoview-reviewers,android-reviewers,android-build-system-reviewers,RyanVM,pollymce\n\n- Add `arm-nightly-full.yml` Flank configuration for Focus Android.\n\n- Add `proguard-rules-android-test.pro`, `testProguardFiles`, and `android-test-keep-rules` plugin for test APK compilation against minified builds.\n\n- Add `shrinkResources` testBuildType guard in `beta` and `nightly` build types.\n\n- Remove `disable-optimization: true` from `focus-nightly-firebase` and `focus-android-test-nightly` in `build-apk/kind.yml` so Nightly UI tests run against minified builds.\n\n- Update `focus-arm-nightly` task in `ui-test-apk/kind.yml` to use `arm-nightly-full.yml`, fetch `mapping.txt`, set `mapping: true`, and run on `mozilla-central-only`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342183\n", "files": ["mobile/android/focus-android/app/build.gradle", "mobile/android/focus-android/app/proguard-rules-android-test.pro", "mobile/android/focus-android/settings.gradle", "mobile/android/test_infra/flank-configs/focus/arm-nightly-full.yml", "taskcluster/kinds/build-apk/kind.yml", "taskcluster/kinds/ui-test-apk/kind.yml"], "git_node": "ea58a46837b75e8919c88de36289270f63eec97a", "git_parents": ["ea7f49d1369fcffa0ddb0b0dc3e99237f1e32a26"], "node": "0dd4f7238db7b46ef267ec0754d17bc686b72c51", "parents": ["cb5c9da14a3aee93e9bd0982822729df450ffffa"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070230 - Enable obfuscation in Focus. r=android-reviewers,pollymce\n\nRemove -dontobfuscate to enable R8 obfuscation in release builds\n\nAdd -keep,allowshrinking,allowoptimization class org.mozilla.focus.** { *; } to keep Focus class and method names a bit more readable in Sentry stack traces\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342182\n", "files": ["mobile/android/focus-android/app/proguard-rules.pro"], "git_node": "c00bb78d5091906808f51b7f2cc09a1f29259567", "git_parents": ["ea58a46837b75e8919c88de36289270f63eec97a"], "node": "d2670780e6f9527965ddd02092d4f81ab4b7b126", "parents": ["0dd4f7238db7b46ef267ec0754d17bc686b72c51"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2085708 - Part 1: Put the provider name to the successful safebrowsing-update-finished notification data. r=timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342174\n", "files": ["toolkit/components/url-classifier/UrlClassifierListManager.sys.mjs", "toolkit/components/url-classifier/tests/unit/head_urlclassifier.js", "toolkit/components/url-classifier/tests/unit/test_listmanager_v5_update_timing.js"], "git_node": "95b2d7e326112432d1453594488f4afa1e43b8b3", "git_parents": ["c00bb78d5091906808f51b7f2cc09a1f29259567"], "node": "8d4804fd92752aae0e5f1d13bd652f9d272cb939", "parents": ["d2670780e6f9527965ddd02092d4f81ab4b7b126"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2085708 - Part 2: Clear the script cache when the safe browsing table is updated. r=emilio,firefox-style-system-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342175\n", "files": ["dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_safebrowsing.js", "dom/base/test/head.js", "dom/script/SharedScriptCache.h", "layout/style/SharedStyleSheetCache.h", "layout/style/SharedSubResourceCache.cpp", "layout/style/SharedSubResourceCache.h"], "git_node": "e66af42f386121b75c4d2a8ad49ab637268016dc", "git_parents": ["95b2d7e326112432d1453594488f4afa1e43b8b3"], "node": "52704dc3c495ddad5a9d84ec5d1f20ecd2a11a86", "parents": ["8d4804fd92752aae0e5f1d13bd652f9d272cb939"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2085708: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/base/test/head.js"], "git_node": "e7f01821dec9b2b883310e42bdbf04a34771b8f9", "git_parents": ["e66af42f386121b75c4d2a8ad49ab637268016dc"], "node": "703226ca063516bf8f0db81fca3d6b15e02d8080", "parents": ["52704dc3c495ddad5a9d84ec5d1f20ecd2a11a86"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091467 - Move location button and bandwidth outside of VPN status card - r=ip-protection-reviewers,fluent-reviewers,mcleinman,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342359\n", "files": ["browser/components/ipprotection/content/ipprotection-content.css", "browser/components/ipprotection/content/ipprotection-content.mjs", "browser/components/ipprotection/content/ipprotection-status-box.css", "browser/components/ipprotection/content/ipprotection-status-card.css", "browser/components/ipprotection/content/ipprotection-status-card.mjs", "browser/components/ipprotection/jar.mn", "browser/components/ipprotection/tests/browser/browser_IPPProxyManager.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_bandwidth_precision.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_content.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_keyboard_navigation.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_location_selector_telemetry.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_locations_keyboard_navigation.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_panel.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_status_card.js", "browser/locales/en-US/browser/ipProtection.ftl"], "git_node": "72ea1eff4ee7e34b9552b4dbe9a87f1e6a06449c", "git_parents": ["e7f01821dec9b2b883310e42bdbf04a34771b8f9"], "node": "07a1c734b9e18319b656fac1951a43b3045fe136", "parents": ["703226ca063516bf8f0db81fca3d6b15e02d8080"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088115 - Remove VPN from toolbar does not work on a second discovery callout if used before - r=ip-protection-reviewers,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342734\n", "files": ["browser/components/ipprotection/IPPOptOutHelper.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_optout.js"], "git_node": "6c20871fb165e8db6b9826eba80ab8af6b4fcd28", "git_parents": ["72ea1eff4ee7e34b9552b4dbe9a87f1e6a06449c"], "node": "f951d9c725d114a01a226ae8cafd6fcbb2ba243b", "parents": ["07a1c734b9e18319b656fac1951a43b3045fe136"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090040 - Use nsIPrincipal instead of PrincipalInfo in SSCacheCopy. r=dom-storage-reviewers,dom-core-reviewers,asuth,farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341856\n", "files": ["dom/storage/PBackgroundSessionStorageCache.ipdl", "dom/storage/SessionStorageManager.cpp", "dom/storage/StorageIPC.h", "toolkit/components/sessionstore/SessionStoreUtils.cpp"], "git_node": "c9b095966983f1ba3ddd699ba6844bb9ebc26f32", "git_parents": ["6c20871fb165e8db6b9826eba80ab8af6b4fcd28"], "node": "793babed48df7622b13262fa01d48704a9b6485a", "parents": ["f951d9c725d114a01a226ae8cafd6fcbb2ba243b"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2089535 - Remove the size alignment check from VideoFrame.copyTo. r=media-playback-reviewers,alwu\n\nThe WebCodecs spec only requires the coordinates of the copyTo rect to be\nsample-aligned, not its width and height, and Chromium matches that. Drop\nVerifyRectSizeAlignment and its call for the explicit rect.\n\nRound the source width and height up to whole samples when computing the\ncopyTo layout, as Compute Layout and Allocation Size requires, so an odd\nwidth rect copies the chroma columns it covers.\n\nAdd WPT for an odd width rect and for an unaligned x.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339922\n", "files": ["dom/media/webcodecs/VideoFrame.cpp", "testing/web-platform/tests/webcodecs/videoFrame-copyTo.any.js"], "git_node": "7fb4eb04101f6153893983545b32e4201eb349ea", "git_parents": ["c9b095966983f1ba3ddd699ba6844bb9ebc26f32"], "node": "1ec7282c928d7f9354a6de6d2d04981a86e52d12", "parents": ["793babed48df7622b13262fa01d48704a9b6485a"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047860 - Compare the embedder policy when matching Early Hints preloads, r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342519\n", "files": ["netwerk/protocol/http/EarlyHintPreloader.cpp"], "git_node": "dac217d640644ec6b52a8470ce245b940812b2e1", "git_parents": ["7fb4eb04101f6153893983545b32e4201eb349ea"], "node": "fe0b5dd019feeadba707e163e7b718c24aad6bf9", "parents": ["1ec7282c928d7f9354a6de6d2d04981a86e52d12"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070616 - Stop mozperftest test files from cluttering the perfdocs sidebar nav r=perftest-reviewers,mozperftest-reviewers,sparky\n\nthe mozperftest code wrote a heading for each test file. Sphinx showed\n each heading in the sidebar, this filled the sidebar with way too many\n items.\n\n Other frameworks (raptor, talos, awsy) put each test in a dropdown box.\n A dropdown box does not make a heading. So this patch makes mozperftest\n do the same thing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324696\n", "files": ["python/mozperftest/mozperftest/perfdocs/framework_gatherers.py", "testing/perfdocs/generated/mozperftest.md"], "git_node": "5ddeae886d8fc2e13122fdb28c5acc55c2c13bc0", "git_parents": ["dac217d640644ec6b52a8470ce245b940812b2e1"], "node": "d503589fe3d765058be0c1de35bd7eda21ab95df", "parents": ["fe0b5dd019feeadba707e163e7b718c24aad6bf9"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062797 - Tests for bug 2054736. r=jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317972\n", "files": ["dom/quota/test/gtest/TestEncryptedStream.cpp"], "git_node": "08a42f98f4138ab547f7928c4e431f07f7be6ad1", "git_parents": ["5ddeae886d8fc2e13122fdb28c5acc55c2c13bc0"], "node": "50ecdfb1c906688525a31a0c190e8e0135bcf82b", "parents": ["d503589fe3d765058be0c1de35bd7eda21ab95df"], "tags": []}, {"author": "James Graham \u003cjames@hoppipolla.co.uk\u003e", "branch": "default", "desc": "Bug 2092583 - Add --repeat-tests option to mach try fuzzy r=taskgraph-reviewers,bhearsum\n\nThis allows web-platform-tests, mochitests, reftests, crashtests and\nxpcshell tests to be run multiple times without restarting the task\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342640\n", "files": ["taskcluster/gecko_taskgraph/parameters.py", "taskcluster/gecko_taskgraph/test/test_transforms_test.py", "taskcluster/gecko_taskgraph/transforms/test/other.py", "testing/mozharness/scripts/desktop_unittest.py", "tools/tryselect/selectors/fuzzy.py", "tools/tryselect/task_config.py", "tools/tryselect/test/test_fuzzy.py", "tools/tryselect/test/test_task_configs.py"], "git_node": "c319fe2a3c146389a12fe8ca03f191c073824610", "git_parents": ["08a42f98f4138ab547f7928c4e431f07f7be6ad1"], "node": "848b3fd5ba0ca787cb170e5682bea013b0aba9f1", "parents": ["50ecdfb1c906688525a31a0c190e8e0135bcf82b"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2083027 - Be more careful about calling DropJSObjects from Unlink. r=smaug\n\nClean up nsJSArgArray which is gross.\n\nIDBObjectStore, IDBIndex and IDBKeyRange all call drop in their\nunlink, but they also actively track whether the object is currently\nholding and make it hold if it needs to, so that's fine. IDBRequest::SetResult\ncalls HoldJSObjects immediately after every write to mResultVal, so that's\nalso okay.\n\nCustomEvent::mDetail is set to null in Unlink to match the constructor,\nwhich is a change in behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342817\n", "files": ["dom/base/TimeoutHandler.cpp", "dom/base/TimeoutHandler.h", "dom/base/nsJSEnvironment.cpp", "dom/base/nsJSEnvironment.h", "dom/events/CustomEvent.cpp", "dom/payments/PaymentMethodChangeEvent.cpp", "dom/performance/PerformanceMainThread.cpp", "dom/performance/PerformanceMark.cpp", "dom/performance/PerformanceMeasure.cpp"], "git_node": "cbbfa6b48c9237112531964365d21d4fb50d7b2e", "git_parents": ["c319fe2a3c146389a12fe8ca03f191c073824610"], "node": "6979480302774fd2d1fcb4a22ce3f82238d25c77", "parents": ["848b3fd5ba0ca787cb170e5682bea013b0aba9f1"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2083027 - Add CycleCollectorUnlinkTester for testing use-after-unlink. r=smaug,webidl\n\nWith the unlink hardening in this series, objects like CustomEvent no\nlonger make it easy to observe a use-after-unlink. This pref-gated\ninterface records when it has been unlinked, and can crash on use after\nunlink, so it can be used for standalone test cases and regression tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342818\n", "files": ["dom/base/CycleCollectorUnlinkTester.cpp", "dom/base/CycleCollectorUnlinkTester.h", "dom/base/moz.build", "dom/webidl/CycleCollectorUnlinkTester.webidl", "dom/webidl/moz.build", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "f37fa9ba4e92ad0998cca1078581580f11d39de0", "git_parents": ["cbbfa6b48c9237112531964365d21d4fb50d7b2e"], "node": "7f089e9cb3f2ed4548fbc72e94177d00f627015a", "parents": ["6979480302774fd2d1fcb4a22ce3f82238d25c77"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 1859947 - Run Fluent typography checks on whole patterns. r=eemeli\n\nThe TE01-TE05 checks ran on each TextElement, so quotes and apostrophes\naround placeables or HTML tags (e.g. '{ $query }') were not detected.\nRun them on the whole Pattern instead, and allow excluding messages and\nfiles from these checks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340988\n", "files": ["tools/lint/fluent-lint/__init__.py", "tools/lint/fluent-lint/exclusions.yml", "tools/lint/test/files/fluent-lint/quotes-placeables.ftl", "tools/lint/test/files/fluent-lint/tools/lint/fluent-lint/exclusions.yml", "tools/lint/test/files/fluent-lint/typography-excluded-messages.ftl", "tools/lint/test/files/fluent-lint/typography-excluded.ftl", "tools/lint/test/test_fluent_lint.py"], "git_node": "046b922fb964b3f955f83a6935ba709f837b02b0", "git_parents": ["f37fa9ba4e92ad0998cca1078581580f11d39de0"], "node": "d7aab6524b42629fe72bf2e89a6ef4afb1a86850", "parents": ["7f089e9cb3f2ed4548fbc72e94177d00f627015a"], "tags": []}, {"author": "Vincent Tunru \u003cgit@vincenttunru.com\u003e", "branch": "default", "desc": "Bug 2088460 - Add tracker count toggle to trust panel. r=kandres,urlbar-reviewers,fluent-reviewers,desktop-theme-reviewers,hjones,mbeier,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340968\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/base/content/test/browser-trustPanel/browser_trust_panel_icon.js", "browser/base/content/test/browser-trustPanel/browser_trust_panel_telemetry.js", "browser/components/controlcenter/content/trustPanel.inc.xhtml", "browser/components/controlcenter/metrics.yaml", "browser/locales/en-US/browser/browser.ftl", "browser/themes/shared/controlcenter/panel.css"], "git_node": "fd4b0336ac4ade2974cddd785096b22cf7e3bb69", "git_parents": ["046b922fb964b3f955f83a6935ba709f837b02b0"], "node": "48fcd1844b6cdf9f9a670bf353bddca47f4bf566", "parents": ["d7aab6524b42629fe72bf2e89a6ef4afb1a86850"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068536 - Part 1) Add helpers to nsCSPParser for parsing a single source expression r=tschuster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336116\n", "files": ["dom/security/nsCSPParser.cpp", "dom/security/nsCSPParser.h", "dom/security/nsCSPUtils.h"], "git_node": "10f810f3ce08910cb5f3fa1da56a7c0519f4619c", "git_parents": ["fd4b0336ac4ade2974cddd785096b22cf7e3bb69"], "node": "a4c27711cd67ea6211a0fad0ac1b57afa58ff0eb", "parents": ["48fcd1844b6cdf9f9a670bf353bddca47f4bf566"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068536 - Part 2) Using CSPParser for PermissionsPolicy to support source-expression r=tschuster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336117\n", "files": ["dom/security/permissionspolicy/Feature.cpp", "dom/security/permissionspolicy/Feature.h", "dom/security/permissionspolicy/PermissionsPolicy.cpp", "dom/security/permissionspolicy/PermissionsPolicyParser.cpp", "testing/web-platform/meta/permissions-policy/experimental-features/permissions-policy-header-host-wildcard.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/experimental-features/permissions-policy-header-port-wildcard.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/experimental-features/permissions-policy-header-scheme-only.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-allowed-for-malformed-wildcard.https.sub.html.ini", "testing/web-platform/meta/permissions-policy/permissions-policy-header-policy-allowed-for-wildcard.https.sub.html.ini"], "git_node": "a409da4ad84e5a7d425c16055d17a566a1a1e154", "git_parents": ["10f810f3ce08910cb5f3fa1da56a7c0519f4619c"], "node": "cfc44841e75174af5ae413cca11f2f1c592966a6", "parents": ["a4c27711cd67ea6211a0fad0ac1b57afa58ff0eb"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2068536: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/security/permissionspolicy/Feature.cpp"], "git_node": "4f8ea1aff491f6b9293462926d7fee1c9bfe75a8", "git_parents": ["a409da4ad84e5a7d425c16055d17a566a1a1e154"], "node": "aef1e2a4df56b037ecf4499066d695a62f83fd73", "parents": ["cfc44841e75174af5ae413cca11f2f1c592966a6"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070560 - Run perftest tasks on git-backed pushes, r=taskgraph-reviewers,mozperftest-reviewers,bhearsum,sparky,ahal\n\nDeletes the `run-on-repo-type: [hg]` and `clone-with: hg` lines from the\nperftest kind and its android, linux and windows11-24h2 platform files. The\nkind keeps `run-on-projects: []`, so nothing is scheduled on any push by\nthis change: hg try behaviour is unchanged, and on git-backed repositories\nthe tasks become selectable, which they must be once the Mercurial backend\ngoes away. The tasks run with `checkout: false` (they fetch a build and do\nno VCS work themselves), so the clone setting had no effect on them.\n\nVerified on a Git-backed staging-firefox push (5df8b5fe9935): the chain\nthe perftests depend on (build-apk-fenix-nightly-simulation and its\nsigning task) and all 7 a55 fenix startup perftests are green, 81 of the\n82 tasks. The one red task, perfstats, fails on every backend because\nmozperftest downloads the Fenix nightly from an index that no longer\nexists (bug 2085425).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324644\n", "files": ["taskcluster/kinds/perftest/android.yml", "taskcluster/kinds/perftest/kind.yml", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/windows11-24h2.yml"], "git_node": "6d4322ce3c5662022bec7f6512273115fd32e9e7", "git_parents": ["4f8ea1aff491f6b9293462926d7fee1c9bfe75a8"], "node": "aa66542f22d4f9104290f58186a9b8db131c5955", "parents": ["aef1e2a4df56b037ecf4499066d695a62f83fd73"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086293 - Limit the size of the HTTP/2 output queue, r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342508\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/base/MockNetworkLayer.cpp", "netwerk/base/MockNetworkLayerController.cpp", "netwerk/base/MockNetworkLayerController.h", "netwerk/base/nsIMockNetworkLayerController.idl", "netwerk/protocol/http/Http2Session.cpp", "netwerk/protocol/http/Http2Session.h", "netwerk/protocol/http/Http2StreamBase.cpp", "netwerk/protocol/http/Http2StreamBase.h", "netwerk/protocol/http/nsHttp.cpp", "netwerk/test/unit/test_http2_output_queue_limit.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "454e7bf6aa600e81b850946fbba0422779a755de", "git_parents": ["6d4322ce3c5662022bec7f6512273115fd32e9e7"], "node": "ac8fbe931518169262b7c39a8fab493c1b70c83e", "parents": ["aa66542f22d4f9104290f58186a9b8db131c5955"], "tags": []}, {"author": "Alex G \u003cagain@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091558 - [Monitor Agent][Models] Add \"Write it for me\" to the monitor create form r=ai-platform-reviewers,fluent-reviewers,tetchart,yjamora,flod,thasan\n\nThis adds in a button for auto generating the monitor fields for a user when creating a monitor.\n\nCallouts on some implementation choices:\n1. LLM Input Context: I included memories, chat history, when available (we can remove any of these if anyone wants, should be easy to)\n2. Allowed entry points: Only in chat (all of the above context) or in toolbar (page context and memories, no chat), not in about:smartwindowtasks area (0 context there initially)\n3. Various upper limit truncations: Chat last 10 messages and truncated to \u003c= 2000 each, total of 8k charcters. Title output 200 characters, condition 1000 characters, memories 500 characters each. Not sure if these all make sense but I guess can ensure not too large an output or some cost savings.\n4. Model choice: Whatever agent monitor is pinned to.\n5. Service: We reuse calling agent monitor service itself.\n6. Retry: Passes in the last generation to ensure it's actually different in output. (keeps same 0.2 temp setting though)\n7. Failures: Failures retry up to 2 times then show an error message.\n8. Feature table entry: Added entry as agent-monitor-setup (ML engine FEATURES table in toolkit/components/ml/content/EngineProcess.sys.mjs)\n9. French: Slight prompt adjustment was needed to accommodate other languages, but looks good for them in my small testing\n\nOther callouts:\n1. Evals: I did some basic evals but will put them somewhere else, they look okay.\n2. Remote settings PR: An accompanying remote settings PR is with this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341610\n", "files": ["browser/app/profile/firefox.js", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/agents/MonitorSetup.sys.mjs", "browser/components/aiwindow/models/agents/moz.build", "browser/components/aiwindow/models/tests/browser/browser.toml", "browser/components/aiwindow/models/tests/browser/browser_monitor_setup.js", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_build_conversation.js", "browser/components/aiwindow/ui/actors/AgentMonitorItemChild.sys.mjs", "browser/components/aiwindow/ui/actors/AgentMonitorItemParent.sys.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.stories.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/AgentCommands.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item_suggest.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_create.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_suggest_chat.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_suggest_chat_context.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_suggest_panel.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/aiwindow/ui/test/browser/head_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/head_monitor_suggest.js", "browser/locales-preview/aiWindow.ftl", "services/settings/dumps/main/ai-window-prompts.json", "toolkit/components/ml/content/EngineProcess.sys.mjs"], "git_node": "b7aff88740d213331dfecc776a79325b4c49202e", "git_parents": ["454e7bf6aa600e81b850946fbba0422779a755de"], "node": "2130b6ddcc0bcb032960f608a92da1d2dffe90df", "parents": ["ac8fbe931518169262b7c39a8fab493c1b70c83e"], "tags": []}, {"author": "Moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083027 - Add CycleCollectorUnlinkTester for testing use-after-unlink. r=smaug,webidl\" for causing build bustages on CycleCollectorUnlinkTester.h.\n\nThis reverts commit f37fa9ba4e92ad0998cca1078581580f11d39de0.\n\nRevert \"Bug 2083027 - Be more careful about calling DropJSObjects from Unlink. r=smaug\"\n\nThis reverts commit cbbfa6b48c9237112531964365d21d4fb50d7b2e.\n", "files": ["dom/base/CycleCollectorUnlinkTester.cpp", "dom/base/CycleCollectorUnlinkTester.h", "dom/base/TimeoutHandler.cpp", "dom/base/TimeoutHandler.h", "dom/base/moz.build", "dom/base/nsJSEnvironment.cpp", "dom/base/nsJSEnvironment.h", "dom/events/CustomEvent.cpp", "dom/payments/PaymentMethodChangeEvent.cpp", "dom/performance/PerformanceMainThread.cpp", "dom/performance/PerformanceMark.cpp", "dom/performance/PerformanceMeasure.cpp", "dom/webidl/CycleCollectorUnlinkTester.webidl", "dom/webidl/moz.build", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "0158ee34817deaf2bfd6fb278b951913b3cf33cd", "git_parents": ["b7aff88740d213331dfecc776a79325b4c49202e"], "node": "868913d0fe7d3bd36b444bd2569a044c93f4f3d7", "parents": ["2130b6ddcc0bcb032960f608a92da1d2dffe90df"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047860 - Compare the embedder policy when matching Early Hints preloads, r=necko-reviewers,valentin\" for causing failures at coep-early-hints-none-final-require-corp.h2.window.html.\n\nThis reverts commit dac217d640644ec6b52a8470ce245b940812b2e1.\n", "files": ["netwerk/protocol/http/EarlyHintPreloader.cpp"], "git_node": "01b092fe3c5e1da8ae2543b6d72ba5c30bdc3e8c", "git_parents": ["0158ee34817deaf2bfd6fb278b951913b3cf33cd"], "node": "545d7d57137b2c14230712ac78be5f10336f57e5", "parents": ["868913d0fe7d3bd36b444bd2569a044c93f4f3d7"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2086801 - [Linux] Install the SIGTERM handler once the app shell exists r=stransky,gtk-reviewers\" for causing Mn and unit failures @ nsFrameLoaderOwner.cpp\n\nThis reverts commit 2cdc881b9879bee3786c1fcbf53fa44ffa265ca4.\n", "files": ["toolkit/xre/nsAppRunner.cpp", "widget/gtk/nsAppShell.cpp"], "git_node": "a27c5af6ea5c36c13b97bb4d50cb145a461f6da3", "git_parents": ["01b092fe3c5e1da8ae2543b6d72ba5c30bdc3e8c"], "node": "a72837ced86b6ea0b7e8aa30a64a52c9bc23ab12", "parents": ["545d7d57137b2c14230712ac78be5f10336f57e5"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088956 - Show the VPN data limit text in red in the Trust Panel. r=android-reviewers,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342653\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt"], "git_node": "a3292c41d8ebbdf90f4d328fd737b1ef6b2d9e82", "git_parents": ["a27c5af6ea5c36c13b97bb4d50cb145a461f6da3"], "node": "631321a70b0289fa6a42339018070467f146fd19", "parents": ["a72837ced86b6ea0b7e8aa30a64a52c9bc23ab12"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092721 - lighten action toolbar buttons and remove icon r=flozia\n\nremove most custom styles preferring type=toolbar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342801\n", "files": ["browser/components/aiwindow/ui/content/smart-actions-toolbar.css", "browser/components/aiwindow/ui/modules/SmartActionsToolbar.sys.mjs"], "git_node": "83ea4797dbbba5a6d18d22ed651e06807c42ec59", "git_parents": ["a3292c41d8ebbdf90f4d328fd737b1ef6b2d9e82"], "node": "38a89d2515215ed23f7a82470253e0f4d440a668", "parents": ["631321a70b0289fa6a42339018070467f146fd19"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092752 - Make consumers of a root generated file depend on the file, not on its tier r=firefox-build-system-reviewers,sergesanspaille,sylvestre\n\nThe backend recorded a file generated by the root `moz.build` as built by its\ntier, so the `buildid.h` dependency D303695 gave `browser/app`'s `Info.plist`\nbecame `browser/app/pre-compile: export` in `root-deps.mk`. On macOS the export\ntier then ran again during compile and tools, and `./mach build binaries`\nraised `KeyError: 'export'` because that tier was never announced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342867\n", "files": ["python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/data/generated-files-extra-deps-root/consumer/generate-consumer.py", "python/mozbuild/mozbuild/test/backend/data/generated-files-extra-deps-root/consumer/moz.build", "python/mozbuild/mozbuild/test/backend/data/generated-files-extra-deps-root/generate-header.py", "python/mozbuild/mozbuild/test/backend/data/generated-files-extra-deps-root/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "423b8f9ae674e6074bee7465da46c5d32a2667d6", "git_parents": ["83ea4797dbbba5a6d18d22ed651e06807c42ec59"], "node": "2e8c2a0370c5e5272cd57017f4e021b1625aacaf", "parents": ["38a89d2515215ed23f7a82470253e0f4d440a668"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089557 - Set epp to performance for nav-bench on linux r=perftest-reviewers,aglavic\n\nSetting the EPP to performance cut a lot of the sp3 noise on Linux\n(bug 2055283), and jetstream3 now uses it too (bug 2089118). This\napplies the same --power-profile=performance option to nav-bench on\nLinux shippable and nightlyasrelease.\n\nOn nav-bench the gain is smaller than sp3 but consistent, with 19/24\nsubtests showing less noise and none getting noisier.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339989\n", "files": ["taskcluster/kinds/browsertime/desktop.yml"], "git_node": "d8427d8476f89b1fb7020e1a4a5d5233fad9cb01", "git_parents": ["423b8f9ae674e6074bee7465da46c5d32a2667d6"], "node": "0a31a53ab96e4e8d9b4619ce6ce8c31593b8dc57", "parents": ["2e8c2a0370c5e5272cd57017f4e021b1625aacaf"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092518 - Skip sync if the broadcast value is older than the local timestamp r=gbeckley,remote-settings-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342548\n", "files": ["services/settings/remote-settings.sys.mjs", "services/settings/test/unit/test_remote_settings_poll.js"], "git_node": "66cc3bbdbb3c8185c78140009067aec7480ae969", "git_parents": ["d8427d8476f89b1fb7020e1a4a5d5233fad9cb01"], "node": "7c27a803a40e72eeac65d4296d35bcb92a2b6b30", "parents": ["0a31a53ab96e4e8d9b4619ce6ce8c31593b8dc57"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1971657: Do not abort flushAllWindowsAsync in response to a content process crash r=sfoster,sessionstore-reviewers,farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338156\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_shutdown_flush_tab_crash.py"], "git_node": "047d581bc2a45dd7f817cbc730a2f96a6d3f7a94", "git_parents": ["66cc3bbdbb3c8185c78140009067aec7480ae969"], "node": "7ded039520c6ea12fda11c8e4c70c990c290108b", "parents": ["7c27a803a40e72eeac65d4296d35bcb92a2b6b30"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091509 - allow custom prompt instead of existing conversation starters with optional page text r=flozia\n\nintroduce prompt pref that allows optional text, anchors and tabs as well as switching back to conversation starters. this uses json and schema to support search and jump actions\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342411\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/modules/SmartActionsToolbar.sys.mjs", "browser/components/aiwindow/ui/test/browser/smart_actions/browser.toml", "browser/components/aiwindow/ui/test/browser/smart_actions/browser_smart_actions_toolbar_prompt.js", "browser/components/aiwindow/ui/test/browser/smart_actions/head.js", "browser/components/aiwindow/ui/test/browser/smart_actions/test_smart_actions_toolbar_page.html"], "git_node": "f612f4a72980aeb8d7a868d53534ad698b2ee602", "git_parents": ["047d581bc2a45dd7f817cbc730a2f96a6d3f7a94"], "node": "1137460458364499c6788a3f8ac9836a086bb04b", "parents": ["7ded039520c6ea12fda11c8e4c70c990c290108b"], "tags": []}], "date": 1794861759, "git_changesets": ["47c78484ab498c9d3a3dd9ad991ca5058fba2334", "ac0e0bbff7f73008db0c9a889cbe6a9f40bcffb0", "3ad52916172f3deae32287aa8d2e3e4c1d0c4a96", "f864aff0abac9287fdbee081e386e30ee163c976", "205327886ce0bc6549df75789a8bcb4f54af8f16", "5cb722776cba5cf165730c747f27e292ce79efab", "430eee7a81f9770c9c4fe8fc38c46094722537cb", "b9afe13444375e831175efed1da769ec4fe5466a", "c04771db5ee695c46fdecdf31b5017c1adf429ca", "9b0b77dadf1d7d14f814bcc1e918d2be45225a95", "150804d91b0bab16055597a2236e7c219a49be16", "c162fbaad3763bd5580916aa599ff5ffd2b8945e", "d6cb1088a7f1a97f8f500845ddfacef76360a2ec", "697951254bb95c53395005ea93a3c5d80