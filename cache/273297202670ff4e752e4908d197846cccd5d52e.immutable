gs.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-co/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-dsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-fa/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gl/strings.xml", "mobile/android/fenix/app/src/main/res/values-hsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-in/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-iw/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nb-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pa-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-vi/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml"], "git_node": "775ff5bf302e389b353182b0a7509bc2e120981d", "git_parents": ["e938f6a8c5b1455e1f7846f4525a1bf959c0ac70"], "node": "773f356c36b1100d2476767cb9ec6b122124e509", "parents": ["d9c8aa2f11c2f17a568468c1c390ebaa7ffcf1ed"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083870 - Record the Travel widget frame's user events in telemetry r=nina-py\n\nValidate `telemetry`/`user_event` messages from framed widgets and record the ones a widget's registry entry lists in frameUserEvents as widgets_user_event, with widget_source \"iframe\".\n\nRecord the Travel impression once the frame is ready, with the background it shows as widget_variant when frameVariants lists it. Frame events also count as the user interacting with the widget once it is ready.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341625\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/Travel/Travel.jsx", "browser/extensions/newtab/content-src/components/Widgets/useFramedWidgetMessages.jsx", "browser/extensions/newtab/content-src/components/Widgets/useWidgetTelemetry.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Travel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/useFramedWidgetMessages.test.jsx"], "git_node": "3c6878439a18e216678b69e91fe32503a28e9c67", "git_parents": ["775ff5bf302e389b353182b0a7509bc2e120981d"], "node": "f6152152db936871e60ac8fd0570bd79f8e06f3e", "parents": ["773f356c36b1100d2476767cb9ec6b122124e509"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066847 - Record which surface opened the New Tab customize panel r=mconley,settings-reviewers\n\n`newtab.customize_panel_open` has two new extras, `source` for the\nsurface that opened the Customize panel and `subpanel` for the subpanel\nit opened on. We can now split the counts by surface, and by whether\nthe panel showed a subpanel or its main view.\n\nThe Firefox Home links in Settings record `settings`. A widget with a\n\"Manage wallpaper\" menu item records its own telemetry name. Any other\nlink to the panel, such as the What's New Page, records `external_link`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340603\n", "files": ["browser/components/newtab/metrics.yaml", "browser/components/preferences/tests/home/browser_homepage_firefox_home_choose_wallpaper_opens_in_tab.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_choose_wallpaper_opens_in_window.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_manage_topics_opens_in_tab.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_manage_topics_opens_in_window.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_manage_widgets_opens_in_tab.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_manage_widgets_opens_in_window.js", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/content-src/components/ActivationWindowMessage/ActivationWindowMessage.jsx", "browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/FeatureHighlight/WallpaperFeatureHighlight.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/PersonalizedCard/PersonalizedCard.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/PromoCard/PromoCard.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardWebNotifications/CardWebNotifications.jsx", "browser/extensions/newtab/content-src/components/Widgets/FramedWidgetCard.jsx", "browser/extensions/newtab/content-src/components/Widgets/PictureOfTheDay/PictureOfTheDay.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/lib/constants.mjs", "browser/extensions/newtab/content-src/lib/customize-panel-telemetry.mjs", "browser/extensions/newtab/lib/AboutPreferences.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/jest/common/Reducers.test.js", "browser/extensions/newtab/test/jest/content-src/components/ActivationWindowMessage.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/PersonalizedCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/PromoCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/WallpaperFeatureHighlight.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/TopSitesHoverCard/CardWebNotifications/CardWebNotifications.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/FramedWidgetCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/PictureOfTheDay.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/lib/customize-panel-telemetry.test.js", "browser/extensions/newtab/test/jest/lib/AboutPreferences.test.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "dd896d999edaa984ec91545b7a73b34395e71ad1", "git_parents": ["3c6878439a18e216678b69e91fe32503a28e9c67"], "node": "eb112c981b32f19c542a98e942f136dee1d3daeb", "parents": ["f6152152db936871e60ac8fd0570bd79f8e06f3e"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2069376 - Part 1: Show the WebSerial sharing indicator on the tab. r=tabbrowser-reviewers,desktop-theme-reviewers,kcochrane,webserial-reviewers,nika\n\nMake an open serial port pulse the serial icon in place of the favicon\nlike camera sharing does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330161\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/themes/shared/tabbrowser/tabs.css", "dom/webserial/tests/browser/browser.toml", "dom/webserial/tests/browser/browser_webserial_tab_sharing_icon.js"], "git_node": "dda256c08bcd507d612b439d430e083d3ff8b6f7", "git_parents": ["dd896d999edaa984ec91545b7a73b34395e71ad1"], "node": "7a443bec161ef1dd08100b6c8a6bccf807dd3dc4", "parents": ["eb112c981b32f19c542a98e942f136dee1d3daeb"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2069376 - Part 2: Track open serial ports by browserId so the count survives tab tear-off. r=webserial-reviewers,firefox-desktop-core-reviewers ,nika\n\nThis fixes an existing problem where moving a tab to another window lost the\nopen port count and cleared the indicator when only one of several ports was\nclosed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330162\n", "files": ["browser/modules/SerialDeviceSharingHelper.sys.mjs", "dom/webserial/tests/browser/browser_webserial_tab_sharing_icon.js"], "git_node": "6ca3f8339885213ac51f6eb983e992353b64a546", "git_parents": ["dda256c08bcd507d612b439d430e083d3ff8b6f7"], "node": "a773b59709e359ac6d7325903aa8af1e68b29564", "parents": ["7a443bec161ef1dd08100b6c8a6bccf807dd3dc4"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2091684. Wait for loadeddata before tearing down media elements in test_media_selection and test_media_sniffer. r=media-playback-reviewers,aosmond\n\nOn Android, tearing down an element while its decoder is still being\ncreated defers the decoder's shutdown until the creation completes. These\ntests did that for every subtest, so hardware decoders piled up and were\nstill alive when the next tests ran, exhausting the emulator's hardware\ndecoder slots (bug 2081238).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341739\n", "files": ["dom/media/test/test_media_selection.html", "dom/media/test/test_media_sniffer.html"], "git_node": "75409b397d6d9ed3062703e84682d027fc1a5d0f", "git_parents": ["6ca3f8339885213ac51f6eb983e992353b64a546"], "node": "71a5e01d1b1b48489e0ec4cea34d4e26f35d7064", "parents": ["a773b59709e359ac6d7325903aa8af1e68b29564"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2085992 - Clear SharedSubResourceCache cache on the tracking protection and URL classifier pref change. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336979\n", "files": ["dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_prefs.js", "dom/base/test/head.js", "dom/script/SharedScriptCache.cpp", "layout/style/SharedSubResourceCache.h"], "git_node": "01011b5e7c36229f4c04e91583493409870984ae", "git_parents": ["75409b397d6d9ed3062703e84682d027fc1a5d0f"], "node": "e2f55a82fce896cc5f760293591cef75bfbb6e06", "parents": ["71a5e01d1b1b48489e0ec4cea34d4e26f35d7064"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091589 - Mark backdrop-object.html as PASS. r=layout-reviewers,tnikkel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341953\n", "files": ["testing/web-platform/meta/fullscreen/rendering/backdrop-object.html.ini"], "git_node": "a3fe01524f7091432fb25472d6d186d028555874", "git_parents": ["01011b5e7c36229f4c04e91583493409870984ae"], "node": "27ed2834c0b7f767b3494b5894e49cdd3da0ec28", "parents": ["e2f55a82fce896cc5f760293591cef75bfbb6e06"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091882 - Remove unused ReflowConfig::mExpectedISizeLeftOver. r=layout-reviewers,jwatt\n\n`mExpectedISizeLeftOver` is only used in the log.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341955\n", "files": ["layout/generic/nsColumnSetFrame.cpp", "layout/generic/nsColumnSetFrame.h"], "git_node": "dc5aa1fd2c636adea93ad0351a21ea57eb206923", "git_parents": ["a3fe01524f7091432fb25472d6d186d028555874"], "node": "2c0a03296ae6b550973aec7259c34e64057d0a21", "parents": ["27ed2834c0b7f767b3494b5894e49cdd3da0ec28"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2091894 - Handle AndroidImageReader initialization failures safely r=gfx-reviewers,lsalzman\n\nInitialize mAImageReader and mNativeWindow to nullptr so cleanup remains safe if initialization fails. Track successful registration with mRegistered and only unregister registered readers, avoiding an assertion failure when destroying a partially initialized reader.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341964\n", "files": ["gfx/layers/AndroidImageReader.cpp", "gfx/layers/AndroidImageReader.h"], "git_node": "b3940214ff93a3f00edeaaf7df36b0217310eec7", "git_parents": ["dc5aa1fd2c636adea93ad0351a21ea57eb206923"], "node": "974ed024b47a5856d17aaf23d697035b78dcf9eb", "parents": ["2c0a03296ae6b550973aec7259c34e64057d0a21"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2091904 - Wait for the acquire fence before AndroidImageReader readback r=gfx-reviewers,lsalzman\n\nWait for the image\u2019s acquire fence before sampling it in UpdateTexImageWithReadback().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341975\n", "files": ["gfx/layers/AndroidImageReader.cpp"], "git_node": "695cd95c63fac302fd1b3c32d897c90c0237a5f8", "git_parents": ["b3940214ff93a3f00edeaaf7df36b0217310eec7"], "node": "14eb09a71065f7c11d8d16fb9ba1cba7a1610f8b", "parents": ["974ed024b47a5856d17aaf23d697035b78dcf9eb"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": ["third_party/libwebrtc/api/audio/audio_processing_unittest.cc", "third_party/libwebrtc/api/audio_codecs/opus/audio_decoder_opus_unittest.cc", "third_party/libwebrtc/api/peer_connection_interface_unittest.cc", "third_party/libwebrtc/common_audio/allocation_counter.cc", "third_party/libwebrtc/common_audio/allocation_counter.h", "third_party/libwebrtc/common_audio/ring_buffer_unittest.cc", "third_party/libwebrtc/common_video/libyuv/libyuv_unittest.cc", "third_party/libwebrtc/modules/audio_processing/agc2/rnn_vad/vector_math_unittest.cc", "third_party/libwebrtc/modules/congestion_controller/pcc/bitrate_controller_unittest.cc", "third_party/libwebrtc/modules/video_coding/decoder_database_unittest.cc", "third_party/libwebrtc/modules/video_coding/histogram_unittest.cc", "third_party/libwebrtc/modules/video_coding/packet_buffer_unittest.cc", "third_party/libwebrtc/modules/video_coding/utility/reference_buffer_tracker.cc", "third_party/libwebrtc/modules/video_coding/utility/reference_buffer_tracker.h", "third_party/libwebrtc/modules/video_coding/utility/reference_buffer_tracker_unittest.cc", "third_party/libwebrtc/p2p/dtls/dtls_transport_unittest.cc", "third_party/libwebrtc/pc/test/DEPS", "third_party/libwebrtc/pc/test/android_test_initializer.cc", "third_party/libwebrtc/pc/test/android_test_initializer.h", "third_party/libwebrtc/rtc_base/numerics/sequence_number_unwrapper_unittest.cc", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/Empty.java", "third_party/libwebrtc/video/corruption_detection/evaluation/qp_parser_unittest.cc", "third_party/libwebrtc/video/corruption_detection/evaluation/utils_unittest.cc"], "git_node": "e5ef8e6bd92800fa7216abbf022e991be9315d94", "git_parents": ["695cd95c63fac302fd1b3c32d897c90c0237a5f8", "0aa10c6a675f7595961d30d2ad81c240f8ddec43"], "node": "1123497b5777a7c743e8231eb818a52d19f7d352", "parents": ["14eb09a71065f7c11d8d16fb9ba1cba7a1610f8b", "38955a610462a60a0afdedb856562477e83dcdac"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085992 - Clear SharedSubResourceCache cache on the tracking protection and URL classifier pref change. r=emilio\" for causing bc failures @browser_searchModeSwitcher_basic.js.\n\nThis reverts commit 01011b5e7c36229f4c04e91583493409870984ae.\n", "files": ["dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_prefs.js", "dom/base/test/head.js", "dom/script/SharedScriptCache.cpp", "layout/style/SharedSubResourceCache.h"], "git_node": "08f7028726014693ad8356956d27830e65875e26", "git_parents": ["e5ef8e6bd92800fa7216abbf022e991be9315d94"], "node": "42e38817ec711bbbb425c353345f13e2c80c81ab", "parents": ["1123497b5777a7c743e8231eb818a52d19f7d352"], "tags": []}, {"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Bug 2089282 - use a PIN where required when built-in UV is configured r=jschanck\n\n* `bio_enrollment()`: don't try to use built-in UV when using legacy\n  command, mark the user verification requirement as \"required\".\n\n* `credential_management()`: don't try to use built-in UV when using legacy\n  command, mark the user verification requirement as \"required\".\n\n* `configure_authenticator()`: don't try to use built-in UV unless `uvAcfg:\n  true`.\n\n* `get_pin_uv_auth_param`: write docs, rename `supports_uv` to\n  `uv_configured`.\n\n* Tidy up some syntax and remove a few unneeded clones.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339779\n", "files": ["dom/webauthn/authenticator/src/ctap2/mod.rs"], "git_node": "5513b747c66f8c00a07fcb3e3511c5f2072c7982", "git_parents": ["08f7028726014693ad8356956d27830e65875e26"], "node": "9d98142434998338379af9f1d8248fc91c8456a9", "parents": ["42e38817ec711bbbb425c353345f13e2c80c81ab"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2091896 - Avoid holding the AndroidImageReader monitor during native reader destruction r=gfx-reviewers,lsalzman\n\nCopy `mAImageReader` to a local variable and clear `mAImageReader` and `mNativeWindow` while holding `mMonitor`. Then release the monitor before unregistering the listener and deleting the native reader, allowing any in-flight `OnFrameAvailable()` callback to acquire the monitor and finish during teardown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341971\n", "files": ["gfx/layers/AndroidImageReader.cpp"], "git_node": "a034e5f88fcb6f6c82e2d9aa3744f789ad296a9d", "git_parents": ["5513b747c66f8c00a07fcb3e3511c5f2072c7982"], "node": "859a97d290e2a695a237a3c4be3b32891be6ee1d", "parents": ["9d98142434998338379af9f1d8248fc91c8456a9"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091457 - Fix incorrect usage of MOZ_HAS_JSRUST r=hsivonen\n\nIntroduced in 1578339.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341459\n", "files": ["mfbt/TextUtils.h"], "git_node": "4127e4aeb0928391142e2677b0b3b25f3d171a30", "git_parents": ["a034e5f88fcb6f6c82e2d9aa3744f789ad296a9d"], "node": "baf6fd4220d080fc09768c8016d11b9b75c48c9d", "parents": ["859a97d290e2a695a237a3c4be3b32891be6ee1d"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2085683 - Encrypt and enable writable file streams in private browsing. r=jari,dom-storage-reviewers\n\n- Back a writable file stream of a private origin with an\n  EncryptedRandomAccessStream, like sync access handles, and stop rejecting\n  createWritable().\n- Move CreateEncryptedFileRandomAccessStream() into the new\n  FileSystemEncryptedFileStreams.{h,cpp} so both can use it.\n- For keepExistingData, re-encrypt the copy of the main file with\n  CopyEncryptedFile() instead of copying it raw.\n- Create the writable stream actor after the stream, so a failure to create\n  the stream no longer destroys an unclosed actor.\n\nNotes for review:\n- Keys are per FileId. A writable writes to a new temporary FileId, so a raw\n  copy would stay encrypted with the old FileId's key, and reading it with the\n  new key would fail. Reusing the old key for the new FileId would defeat\n  having per-file keys.\n- The encrypted copy is written through quota-tracked streams, so it skips\n  UpdateCachedQuotaUsage(), which would count the copy twice. As a side\n  effect, the copy fails when it exceeds the quota, unlike the raw copy.\n- Moving or renaming an entry doesn't change its FileId, so the key still\n  matches afterwards.\n- The new tests read back with a sync access handle, because getFile() is\n  still rejected in private browsing. They live in a temporary file, to be\n  merged into test_writableFileStream.js once getFile() is supported.\n- test_fileSystemDirectoryHandle*.html are still expected to fail in private\n  browsing, because usage counts the encrypted bytes on disk rather than\n  the bytes written.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337421\n", "files": ["dom/fs/parent/FileSystemAccessHandle.cpp", "dom/fs/parent/FileSystemEncryptedFileStreams.cpp", "dom/fs/parent/FileSystemEncryptedFileStreams.h", "dom/fs/parent/FileSystemManagerParent.cpp", "dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion002.cpp", "dom/fs/parent/moz.build", "dom/fs/test/common/mochitest.toml", "dom/fs/test/common/moz.build", "dom/fs/test/common/test_writableFileStream_for_pbm.js", "dom/fs/test/mochitest/mochitest-private.toml", "dom/fs/test/mochitest/mochitest.toml", "dom/fs/test/mochitest/test_writableFileStream_for_pbm_worker.html", "dom/fs/test/mochitest/worker/mochitest.toml", "dom/fs/test/mochitest/worker/test_writableFileStream_for_pbm_worker.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "d20978279cac05ceac7318cdb6723e92169c24c6", "git_parents": ["4127e4aeb0928391142e2677b0b3b25f3d171a30"], "node": "a5684a908d21aa873219493671ad23148bcf093c", "parents": ["baf6fd4220d080fc09768c8016d11b9b75c48c9d"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2085683 - Expect encrypted usage in quotaTest in private browsing. r=jari,dom-storage-reviewers\n\n- Add Utils.isPrivateBrowsing() to the quota test modules, for the main\n  thread, workers and xpcshell. It checks isInPrivateBrowsing on the same\n  principal getCachedOriginUsage() uses.\n- In quotaTest, expect the usage of an encrypted file in private browsing:\n  no change after write(), because the last block is only written on close,\n  and one 4096-byte block after close().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337422\n", "files": ["dom/fs/test/common/test_fileSystemDirectoryHandle.js", "dom/fs/test/mochitest/mochitest-private.toml", "dom/quota/test/modules/content/Utils.mjs", "dom/quota/test/modules/content/UtilsParent.mjs", "dom/quota/test/modules/content/worker/Utils.js", "dom/quota/test/modules/content/worker/UtilsChild.mjs", "dom/quota/test/modules/system/Utils.sys.mjs", "dom/quota/test/modules/system/UtilsParent.sys.mjs", "dom/quota/test/modules/system/worker/Utils.js", "dom/quota/test/modules/system/worker/UtilsChild.mjs"], "git_node": "a5db01b1e47b321a9911eea39cc0711573239bf3", "git_parents": ["d20978279cac05ceac7318cdb6723e92169c24c6"], "node": "6f82e8a8c6180fddc9e7efb085deffeafb120a66", "parents": ["a5684a908d21aa873219493671ad23148bcf093c"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e ed9efabde1cfe057ae11179d07e7fe9dda1e5