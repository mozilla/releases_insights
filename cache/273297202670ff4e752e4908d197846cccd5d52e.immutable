b9f7f7bee8", "git_parents": ["b06df6076c633f2421b2d6b12631671e0f5b41f2"], "node": "2dc2f3167745b303b6b4ae072cbe9800bbb8f39c", "parents": ["dae3f6581ec772b4bc28ad9b4eb145e718953f77"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090239 - Include .agents/skills in the sphinx-docs sparse profile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340473\n", "files": ["build/sparse-profiles/sphinx-docs"], "git_node": "044e62375303359554d81749862d7e5addc24df1", "git_parents": ["57dabbbe7838acf57d4a669ff8d40fb9f7f7bee8"], "node": "48b2fc510d0ff56cf2dbc61edc12b67793d8060e", "parents": ["2dc2f3167745b303b6b4ae072cbe9800bbb8f39c"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082099 - Only reject cross-site speculation-rules prefetches. r=necko-reviewers,jesup\n\nThe spec separates prefetches by network partition key, so same-site\ncross-origin prefetches share the document's partition and need none of the\ncross-site isolation. Gate on the site instead of the origin, and rename\ndom.speculation_rules.same_origin_only to dom.speculation_rules.same_site_only\naccordingly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331538\n", "files": ["dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/WindowGlobalParent.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/speculation-rules/prefetch/client-hints/redirect.https.sub.html.ini"], "git_node": "71c3d1e70d2b93e9b6d3a81a886955a86a0d8619", "git_parents": ["044e62375303359554d81749862d7e5addc24df1"], "node": "223f5ae01e2c89fc4a54f745298966c98c2d230f", "parents": ["48b2fc510d0ff56cf2dbc61edc12b67793d8060e"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077601 - Serve a prefetch-activated navigation from the record's own cache entry. r=necko-reviewers,valentin\n\nLooking up the navigation URL in the HTTP cache can return a different\nNo-Vary-Search-equivalent entry than the one the prefetch stored. Open the\nentry the prefetch record holds instead, read-only, so the navigation gets the\nrecord's response as the spec requires. Records reached through redirects keep\nthe existing lookup for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331540\n", "files": ["dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/PrefetchRecordParent.h", "netwerk/ipc/DocumentLoadListener.cpp", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h", "testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single.https.html.ini"], "git_node": "d55622ddc1f47627aa975e9f28b0de400a957837", "git_parents": ["71c3d1e70d2b93e9b6d3a81a886955a86a0d8619"], "node": "d5312493f9ce21b0aef7b866f923a805dfed5488", "parents": ["223f5ae01e2c89fc4a54f745298966c98c2d230f"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082095 - Reject non-trustworthy and cross-site redirects of speculation-rules prefetches. r=necko-reviewers,valentin\n\nThe spec rejects a prefetch whose current URL is not potentially trustworthy\non every redirect hop, not only the first one. Cross-site prefetches are also\nnot supported yet (the isolated, uncredentialed partition isn't implemented),\nso while dom.speculation_rules.same_site_only is set, don't follow a redirect\noff the document's site either.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331541\n", "files": ["dom/ipc/PrefetchRecordParent.cpp"], "git_node": "e49c072fcf6e1a46f9dd2fe94787320769bd718f", "git_parents": ["d55622ddc1f47627aa975e9f28b0de400a957837"], "node": "d581e941e11bfd5da921001f7c7b5a3d8d996366", "parents": ["d5312493f9ce21b0aef7b866f923a805dfed5488"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080083 - Use a keepalive fetch to unblock the in-flight prefetch in prefetch-single-with-hint.https.html. r=necko-reviewers,valentin\n\nFirefox cancels the page's in-flight requests when a navigation starts, so the\nplain fetch sent from onbeforeunload never reached the server and the in-flight\nprefetch was never released.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333897\n", "files": ["testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html.ini", "testing/web-platform/tests/speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html"], "git_node": "ca24710d41562ba4143c0d0eb5e637833931c24b", "git_parents": ["e49c072fcf6e1a46f9dd2fe94787320769bd718f"], "node": "79a987bc0211155db21f53ed2a0a420dad93cfec", "parents": ["d581e941e11bfd5da921001f7c7b5a3d8d996366"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2088842 - Use moz-src for services/automation/moz.build r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339469\n", "files": ["services/automation/moz.build", "testing/condprofile/condprof/scenarii/sync.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "9dd88fedcf8e006b25e76085d1b359f166129cc2", "git_parents": ["ca24710d41562ba4143c0d0eb5e637833931c24b"], "node": "7df08f15cb2e773bc59b28d79850362d597e5acc", "parents": ["79a987bc0211155db21f53ed2a0a420dad93cfec"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2034677 - Track L10n prototype cache state per element. r=smaug\n\nThis prevents dom mutations from leaving untranslated prototypes that we\nthen refuse to translate in following startups.\n\nI'll try to get Claude to write a test for this but we have ~0 tests for\nthe prototype cache.\n\nI did confirm the cache keeps working as expected tho.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340379\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/Element.cpp", "dom/base/Element.h", "dom/base/nsINode.h", "dom/base/nsStyledElement.cpp", "dom/l10n/DOMLocalization.cpp", "dom/l10n/DocumentL10n.cpp", "dom/l10n/DocumentL10n.h", "dom/prototype/PrototypeDocumentContentSink.cpp", "dom/svg/SVGElement.cpp", "dom/xul/nsXULElement.cpp", "dom/xul/nsXULElement.h", "dom/xul/nsXULPrototypeDocument.cpp", "dom/xul/nsXULPrototypeDocument.h"], "git_node": "18091cd58446c0daa121e09498f03155f4a4cb82", "git_parents": ["9dd88fedcf8e006b25e76085d1b359f166129cc2"], "node": "1330457e846a731ff932981b36d3321397074201", "parents": ["7df08f15cb2e773bc59b28d79850362d597e5acc"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2034677 - Test. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340380\n", "files": ["dom/l10n/tests/mochitest/chrome.toml", "dom/l10n/tests/mochitest/document_l10n/file_docl10n_proto_cache.xhtml", "dom/l10n/tests/mochitest/document_l10n/test_docl10n_proto_cache.html"], "git_node": "eff04f2c139de0b736e6af34c97997243daa785d", "git_parents": ["18091cd58446c0daa121e09498f03155f4a4cb82"], "node": "67f0d31264346512aa5b75331f35a27d69e30c2e", "parents": ["1330457e846a731ff932981b36d3321397074201"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2089031 - Don't give a null principal to error pages. r=farre,webidl,smaug\n\nWith my patch for bug 2088635, I get a timeout in `browser_aboutCertError.js`\n(checkSandboxedIframe_*). This is because the script would no longer load,\nbecause the principal of the error page is a\nmoz-nullprincipal:....?about:certerror, and the resources are no longer\ncontentaccessible.\n\nDocument already ignored inherited sandbox flags for error pages (we need to so\nthat they can run script, etc). Move the check to DocumentLoadListener.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339623\n", "files": ["docshell/base/nsDocShell.cpp", "dom/base/Document.cpp", "netwerk/ipc/DocumentLoadListener.cpp", "netwerk/ipc/DocumentLoadListener.h"], "git_node": "31d7a94e0f3a65de41239246b8bd5ed3e829e04b", "git_parents": ["eff04f2c139de0b736e6af34c97997243daa785d"], "node": "e1256787ac3c6e12a8cf38f38fea530abe0e30ed", "parents": ["67f0d31264346512aa5b75331f35a27d69e30c2e"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2090441 - Preserve Android hardware buffer acquire fences on import or wait failure r=gfx-reviewers,lsalzman\n\nFollowing Chromium\u2019s approach, pass a duplicate acquire fence FD to EGL while retaining the original. If duplication, import, or waiting fails, restore the original fence so subsequent rendering or readback retries still wait for the producer. Release the retained FD after a successful wait.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340564\n", "files": ["gfx/layers/opengl/TextureHostOGL.cpp", "gfx/webrender_bindings/RenderAndroidHardwareBufferTextureHost.cpp"], "git_node": "674d29bbfb9e362e39532525c39f7d648ee3606b", "git_parents": ["31d7a94e0f3a65de41239246b8bd5ed3e829e04b"], "node": "2505a268dc0e63c65ee4359222dfc0b9a7079f90", "parents": ["e1256787ac3c6e12a8cf38f38fea530abe0e30ed"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2088635 - Trim down contentaccessible files from toolkit/content. r=tschuster,Gijs,devtools-reviewers,omc-reviewers,firefox-style-system-reviewers,layout-reviewers,mviar,jdescottes,jwatt\n\nMake toolkit/content not content-accessible, and move the actual things\nwe need to CONTENT_ACCESSIBLE_FILES.\n\nNote that icons loaded from UA sheets don't need this for example,\nbecause those sheets load with the system principal.\n\nWe add the new IsTrustedUISource to allow loading chrome:// and resource://,\nand include pdf.js and privileged extensions. pdf.js imports moz-message-bar\nfrom chrome://global, about:compat is a privileged extension page that uses\nin-content/common.css.\n\nWe make the PiP text tracks content-accessible because the PiP player document\nhas a null principal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339312\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_configurable_ui.js", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/firefoxview/fxview-tab-row.css", "browser/components/firefoxview/opentabs-tab-row.css", "browser/components/sidebar/sidebar-tab-row.css", "browser/components/urlbar/QuickActionsLoaderDefault.sys.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/CardCarousel/CardCarousel.jsx", "browser/extensions/newtab/content-src/components/Widgets/FocusTimer/FocusTimer.jsx", "browser/themes/shared/tabbrowser/tabs.css", "browser/themes/shared/toolbarbutton-icons.css", "browser/themes/shared/urlbar.css", "caps/nsScriptSecurityManager.cpp", "caps/tests/mochitest/test_bug292789.html", "devtools/client/inspector/shared/test/browser_styleinspector_tooltip-background-image.js", "devtools/client/inspector/shared/test/browser_styleinspector_tooltip-size.js", "devtools/client/inspector/shared/test/doc_content_background_image.html", "dom/base/test/file_bug590812-ref.xhtml", "dom/html/VideoDocument.cpp", "dom/security/nsCSPService.cpp", "dom/security/test/general/browser_resource_module_cors.js", "dom/tests/reftest/prettyprint-space-ref.xhtml", "dom/xml/resources/XMLPrettyPrint.xsl", "dom/xml/resources/jar.mn", "dom/xml/resources/moz.build", "image/test/reftest/ImageDocument.css", "image/test/reftest/encoders-lossless/ImageDocument.css", "image/test/reftest/gif/ImageDocument.css", "layout/base/tests/chrome/printpreview_prettyprint_ref.xhtml", "layout/style/TopLevelImageDocument.css", "toolkit/actors/PictureInPictureChild.sys.mjs", "toolkit/content/jar.mn", "toolkit/content/moz.build", "toolkit/content/widgets/datetimebox.js", "toolkit/content/widgets/marquee.js", "toolkit/content/widgets/videocontrols.js", "toolkit/themes/mobile/global/jar.mn", "toolkit/themes/moz.build", "toolkit/themes/shared/desktop-jar.inc.mn", "toolkit/themes/shared/media/pipToggle.css", "toolkit/themes/shared/media/videocontrols.css", "toolkit/themes/shared/minimal-toolkit.jar.inc.mn", "toolkit/themes/shared/narrate.css", "toolkit/themes/shared/pictureinpicture/player.css"], "git_node": "1f59e5ab2cdf6481b0e316350c8b62bacba5630c", "git_parents": ["674d29bbfb9e362e39532525c39f7d648ee3606b"], "node": "f068170ddc9ff9a3c8eac9cd1ccef0b7c268cab4", "parents": ["2505a268dc0e63c65ee4359222dfc0b9a7079f90"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089501 - Use `std::has_single_bit` for the power-of-two checks in the JIT backends r=iain,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339887\n", "files": ["js/src/jit/arm/CodeGenerator-arm.cpp", "js/src/jit/arm/Lowering-arm.cpp", "js/src/jit/arm64/CodeGenerator-arm64.cpp", "js/src/jit/mips-shared/CodeGenerator-mips-shared.cpp", "js/src/jit/mips-shared/Lowering-mips-shared.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp", "js/src/jit/x86-shared/Lowering-x86-shared.cpp", "js/src/jit/x86/CodeGenerator-x86.cpp", "js/src/jit/x86/Lowering-x86.cpp"], "git_node": "9151c1b5cce42e6c63150df6d88b46788ef28f86", "git_parents": ["1f59e5ab2cdf6481b0e316350c8b62bacba5630c"], "node": "5d11610abdaaead18ee6ea308738822f8ef28de9", "parents": ["f068170ddc9ff9a3c8eac9cd1ccef0b7c268cab4"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089501 - Use `std::countr_zero` for the shift amount after `std::has_single_bit` checks in the JIT r=iain,sergesanspaille\n\nFor a power of two, `std::countr_zero` gives the same result as `FloorLog2` in a single instruction.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339894\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/Lowering.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/arm/Lowering-arm.cpp", "js/src/jit/arm64/Lowering-arm64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/mips-shared/CodeGenerator-mips-shared.cpp", "js/src/jit/riscv64/Lowering-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/x64/CodeGenerator-x64.cpp", "js/src/jit/x64/Lowering-x64.cpp", "js/src/wasm/WasmBCStkMgmt-inl.h"], "git_node": "f0ad7bde44ac31cfb903461868e5340c435bed44", "git_parents": ["9151c1b5cce42e6c63150df6d88b46788ef28f86"], "node": "f01c8e89ab1958ad530cc887c741e2742bdf5336", "parents": ["5d11610abdaaead18ee6ea308738822f8ef28de9"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2088842 - Use moz-src for services/automation/moz.build r=Gijs\" for causing bc failures @ /services/automation/ServicesAutomation.sys.mjs\n\nThis reverts commit 9dd88fedcf8e006b25e76085d1b359f166129cc2.\n", "files": ["services/automation/moz.build", "testing/condprofile/condprof/scenarii/sync.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "5cfa1713f63b08911a856594e69e58981ce8af5f", "git_parents": ["f0ad7bde44ac31cfb903461868e5340c435bed44"], "node": "7a6129aa96058536f0d3d6a90ac58085b1fa72d9", "parents": ["f01c8e89ab1958ad530cc887c741e2742bdf5336"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2089501 - Use `std::countr_zero` for the shift amount after `std::has_single_bit` checks in the JIT r=iain,sergesanspaille\" for causing lint failures\n\nThis reverts commit f0ad7bde44ac31cfb903461868e5340c435bed44.\n\nRevert \"Bug 2089501 - Use `std::has_single_bit` for the power-of-two checks in the JIT backends r=iain,sergesanspaille\"\n\nThis reverts commit 9151c1b5cce42e6c63150df6d88b46788ef28f86.\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/Lowering.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/arm/CodeGenerator-arm.cpp", "js/src/jit/arm/Lowering-arm.cpp", "js/src/jit/arm64/CodeGenerator-arm64.cpp", "js/src/jit/arm64/Lowering-arm64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/mips-shared/CodeGenerator-mips-shared.cpp", "js/src/jit/mips-shared/Lowering-mips-shared.cpp", "js/src/jit/riscv64/Lowering-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/x64/CodeGenerator-x64.cpp", "js/src/jit/x64/Lowering-x64.cpp", "js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp", "js/src/jit/x86-shared/Lowering-x86-shared.cpp", "js/src/jit/x86/CodeGenerator-x86.cpp", "js/src/jit/x86/Lowering-x86.cpp", "js/src/wasm/WasmBCStkMgmt-inl.h"], "git_node": "3da21931076a4c5706fdb6bfeadccea1fee6543d", "git_parents": ["5cfa1713f63b08911a856594e69e58981ce8af5f"], "node": "4243c4e432109353eefb7c3e60ed16c8d98483b3", "parents": ["7a6129aa96058536f0d3d6a90ac58085b1fa72d9"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2045720 - Test large child cookie lists. r=cookie-reviewers,baku\" for causing build bustages\n\nThis reverts commit cdff50191f2c2e892a26a8c50101d538cd3cf681.\n\nRevert \"Bug 2045720 - Use a hash set for unusually large child cookie lists. r=cookie-reviewers,baku\"\n\nThis reverts commit fc6d18fca8555da0ec8aeb8fd73776fb69f35f4c.\n\nRevert \"Bug 2045720 - Encapsulate child cookie list lookups. r=cookie-reviewers,baku\"\n\nThis reverts commit f05bc1a02e6b21f78a8f2144bcbb44094c403cfe.\n", "files": ["netwerk/cookie/CookieServiceChild.cpp", "netwerk/cookie/CookieServiceChild.h", "netwerk/cookie/test/browser/browser.toml", "netwerk/cookie/test/browser/browser_cookie_child_large_list.js"], "git_node": "e95ebc5c287a2a7398b2320b6bd91e38d3af10da", "git_parents": ["3da21931076a4c5706fdb6bfeadccea1fee6543d"], "node": "02b10934c62c9734cd4e743bcf094f7e3f315e8b", "parents": ["4243c4e432109353eefb7c3e60ed16c8d98483b3"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2090459 - [riscv64] Box and unbox objects, strings, symbols and booleans with Zbs bseti. r=csmantle\n\nThe shifted tags of booleans, objects, strings and symbols are a run of\nones down from bit 63, -(1 \u003c\u003c n) for n = 50, 49, 48 and 47, so their\nnegation is the single bit 1 \u003c\u003c n, which ma_li already loads with one\nbseti when Zbs is available, where the tag itself takes li and slli.\nBox a payload by subtracting the negated shifted tag and unbox a Value\nby adding it, instead of oring and xoring the shifted tag in, and leave\nthe choice of instructions to ma_li. Unboxing an object was\n\n  li    t4, -0x1\n  slli  t4, t4, 0x31\n  xor   a0, a0, t4\n\nand becomes\n\n  bseti t4, zero, 0x31\n  add   a0, a0, t4\n\nAdding the negated shifted tag clears the bits above the payload if and\nonly if the tag matches, as xoring the tag in does, so fallibleUnboxPtr's\ncheck is unchanged and a mistyped Value still unboxes to a pointer with\nhigh bits set. The other negated shifted tags, and all of them without\nZbs, take li and slli like the shifted tags, so nothing gets longer.\n\nIn a JetStream 3 run on a SpacemiT K3 this shortens about 608,000 boxes\nand unboxes by an instruction each: 533,000 of objects, 58,000 of\nstrings, 10,000 of symbols and 8,000 of booleans, 270,000 of them in\nBaseline code and 336,000 in Ion code.\n\nFound with riscvlint.\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340578\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64-inl.h", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.h"], "git_node": "d4753b9630807282b3d4a057555a867e47cb0537", "git_parents": ["e95ebc5c287a2a7398b2320b6bd91e38d3af10da"], "node": "f9e42b3175c58d929814d30da56451d509d1cf43", "parents": ["02b10934c62c9734cd4e743bcf094f7e3f315e8b"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2089864 - Don't pretend to use or pass on the return value from logins.delete. r=joschmidt,credential-management-reviewers\n\nIn bug 2089859 we will be removing the return value from `logins.delete` and `delete_many` as they are buggy.\nIn preparation for that, we start pretending those functions return `void`, which will make the final\nremoval a non-breaking change.\n\nThis will touch both desktop's use of this (which isn't strictly necessary,\nbut seems cleaner) and Androids (which is needed even when the result is not used for typing reasons)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340209\n", "files": ["mobile/android/android-components/components/concept/storage/src/main/java/mozilla/components/concept/storage/LoginsStorage.kt", "mobile/android/android-components/components/service/sync-logins/src/main/java/mozilla/components/service/sync/logins/SyncableLoginsStorage.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/logins/LoginsTools.kt", "toolkit/components/passwordmgr/storage-rust.sys.mjs"], "git_node": "810d46a506f23ca7ed96c4b5336f6b4ca29a2551", "git_parents": ["d4753b9630807282b3d4a057555a867e47cb0537"], "node": "d3266ea3d89b00d1355525cebdc8b33b45748681", "parents": ["f9e42b3175c58d929814d30da56451d509d1cf43"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081428 - [devtools] Clarify the rule view link tests for styles with sourcemaps r=devtools-reviewers,nchevobbe\" for causing dt failures @ browser_dbg-reloading.js.js\n\nThis reverts commit d621b8461d9c298b91580da09f81531102deb2d9.\n\nRevert \"Bug 2081428 - [devtools] Enable 'devtools.debugger.features.stylesheets-in-debugger' by default r=devtools-reviewers,jdescottes,nchevobbe\"\n\nThis reverts commit 1ed9f312ef6d83cf09dd1d453734ad614f5354da.\n", "files": ["browser/app/profile/firefox.js", "devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_debug_debugger.js", "devtools/client/framework/test/browser_toolbox_view_source_03.js", "devtools/client/framework/test/head.js", "devtools/client/inspector/computed/test/browser_computed_original-source-link.js", "devtools/client/inspector/computed/test/browser_computed_style-editor-link.js", "devtools/client/inspector/markup/test/browser_markup_links_06.js", "devtools/client/inspector/rules/test/browser_rules_original-source-link.js", "devtools/client/inspector/rules/test/browser_rules_original-source-link2.js", "devtools/client/inspector/rules/test/browser_rules_style-editor-link.js", "devtools/client/inspector/rules/test/head.js", "devtools/client/netmonitor/test/browser_net_open_in_style_editor.js", "devtools/client/webconsole/test/browser/browser_webconsole_location_styleeditor_link.js"], "git_node": "cffcb84c5cc205685623a5ae0a0e16f7ff6671d2", "git_parents": ["810d46a506f23ca7ed96c4b5336f6b4ca29a2551"], "node": "08f2b59998d1cfa91aac6e06c71afddc5a2fda67", "parents": ["d3266ea3d89b00d1355525cebdc8b33b45748681"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084281 - [devtools] Fallback to the style editor for inline style links r=devtools-reviewers,nchevobbe\" for causing dt failures @ browser_dbg-reloading.js.js\n\nThis reverts commit ae9a49c4965db34e39699966b1b50555f04d5921.\n", "files": ["devtools/client/framework/toolbox.js"], "git_node": "2dc9af5a4088a41b13e7039b7a7dfc1018078482", "git_parents": ["cffcb84c5cc205685623a5ae0a0e16f7ff6671d2"], "node": "bc2fa72882bd6bc888bb7476b7b7e805590a3c49", "parents": ["08f2b59998d1cfa91aac6e06c71afddc5a2fda67"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087450 - [devtools] Update the tooltip for style links when the stylesheet in debugger pref is enabled r=devtools-reviewers,nchevobbe\" for causing ESLint failures after the backout of bug 2081428 and bug 2084281\n\nThis reverts commit 47f0c9821d8c89eca0d52ff5c4f365f7fba9235f.\n", "files": ["devtools/client/inspector/rules/test/browser_rules_original-source-link.js", "devtools/client/inspector/rules/test/browser_rules_style-editor-link.js", "devtools/client/inspector/rules/views/rule-editor.js", "devtools/client/shared/components/Frame.js", "devtools/client/shared/components/test/chrome/test_frame_01.html"], "git_node": "c924a6e6b9e9cd3142ac67925abb31f845ff7e78", "git_parents": ["2dc9af5a4088a41b13e7039b7a7dfc1018078482"], "node": "5fa2bcd71c5bf1db1b2d6f7a0b3130222a64885c", "parents": ["bc2fa72882bd6bc888bb7476b7b7e805590a3c49"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089512 - Fix parsing of the legacy aliases. r=emilio,firefox-style-system-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340433\n", "files": ["layout/style/test/property_database.js", "servo/components/style/values/specified/position.rs"], "git_node": "3241cc6274ee5bf0500eb249f7ed0a99e30b1bca", "git_parents": ["c924a6e6b9e9cd3142ac67925abb31f845ff7e78"], "node": "0dca63fe83cd6bd36d934811b71a8ae45f378763", "parents": ["5fa2bcd71c5bf1db1b2d6f7a0b3130222a64885c"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090316 - Simplify clip-path url() bounding box computation. r=longsonr,firefox-svg-reviewers\n\nIn ComputeClipForMaskItem, we really want just the clip-path bounds.\nThis is what SVG frames get by default via the flags, but not what HTML\nframes would get.\n\nIt doesn't matter much because you apply the clip path atop, but it's\nbetter this way because it is simpler, and also because without the same\ncoordinates, the tests from bug 2090202 would be fuzzy even with\nwebrender rendering both.\n\nThe DoNotClipToBBoxOfContentInsideClipPath flag was only used from here,\nso just remove it and don't pass a BBox to the clipPath frame.\n\nWe need to translate to the first continuation's space. This was hidden\nbefore because we were not using the clip bounds...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340529\n", "files": ["layout/generic/nsIFrame.cpp", "layout/svg/ISVGDisplayableFrame.h", "layout/svg/SVGClipPathFrame.cpp", "layout/svg/SVGClipPathFrame.h", "layout/svg/SVGUtils.cpp"], "git_node": "ac7b5e4bc10b65142541a54b0ef23462647f7da1", "git_parents": ["3241cc6274ee5bf0500eb249f7ed0a99e30b1bca"], "node": "2c09e1585f8f8ab92a2f4e88c047ca1e0451b759", "parents": ["0dca63fe83cd6bd36d934811b71a8ae45f378763"], "tags": []}], "date": 1794068631, "git_changesets": ["501e135add4dc6f78b0249c3e3f0bd69b1346b0c", "231465e64156164c3a9faf65361346e662b5c2f5", "234f5efdba8852b325c4dba6ad2c4ac7c48dfa77", "608183c27636bc73902f77d6d385370dfd749224", "8b269775adb167137428f42cabd6e4f9a9626c4e", "a16df6fbb8ec9223326c818594ca595163dc9041", "91ebfd0200f49841c7eabdd1991ab35892dd1356", "300a5bfddcf6d3b45646f9f0896babe77e364385", "bd6147c3e750b768beee71690cefa5c6414f0a98", "d909f502a2323f1616ea009a4da1d885aaf6a532", "83224a7d2fb3837d90a749cb302654506db72f38", "8cea3fea73250957e652967273b1e4f8ed8841d6", "2e0e9761433d40858fa69eb32974072e61eb5d09", "93ae409718911fd08323316f07b8457880e378a8", "133e2d7e93d3e402a5f15d2f8aa576e60f79e154", "d8cb3ed71e1facac6eab3e36e617f08575ac3bf0", "80370bf30089db25