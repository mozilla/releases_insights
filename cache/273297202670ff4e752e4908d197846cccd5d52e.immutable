n/res/drawable-mdpi/team_badge_southampton.webp", "mobile/android/fenix/app/src/main/res/drawable-mdpi/team_badge_stoke_city.webp", "mobile/android/fenix/app/src/main/res/drawable-mdpi/team_badge_swansea_city.webp", "mobile/android/fenix/app/src/main/res/drawable-mdpi/team_badge_watford.webp", "mobile/android/fenix/app/src/main/res/drawable-mdpi/team_badge_west_brom.webp", "mobile/android/fenix/app/src/main/res/drawable-mdpi/team_badge_west_ham.webp", "mobile/android/fenix/app/src/main/res/drawable-mdpi/team_badge_wolves.webp", "mobile/android/fenix/app/src/main/res/drawable-mdpi/team_badge_wrexham.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_birmingham.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_blackburn_rovers.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_bolton.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_bristol_city.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_burnley.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_cardiff.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_charlton.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_derby_county.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_lincoln_city.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_man_united.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_middlesbrough.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_millwall.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_norwich_city.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_portsmouth.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_preston.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_qpr.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_sheffield_united.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_southampton.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_stoke_city.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_swansea_city.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_watford.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_west_brom.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_west_ham.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_wolves.webp", "mobile/android/fenix/app/src/main/res/drawable-xhdpi/team_badge_wrexham.webp"], "git_node": "0896da962216028967283d5903abc7da98d467d3", "git_parents": ["31a7e652a4d8e627fc6b12dea34b87501311a00f"], "node": "c6e67c1554dd7de01a5f6ca079b5b387422f8c75", "parents": ["8d33665043ec28ed55224ec78a327bc0e797c60c"], "tags": []}, {"author": "Ashley Hale \u003cahale@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068592 - call Finish before BlitFramebuffer for some cases on Mali r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340261\n", "files": ["dom/canvas/WebGLFramebuffer.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "10116b10e59aec5741ef55de50662469dc593a23", "git_parents": ["0896da962216028967283d5903abc7da98d467d3"], "node": "38d819f2205447aebbf074ee0b0b35a9f00a077c", "parents": ["c6e67c1554dd7de01a5f6ca079b5b387422f8c75"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076328 - Create FFmpegVideoDecoder platform decoders on the decoder's task queue. r=media-playback-reviewers,azebrowski\n\nFFmpegVideoDecoder set up its hardware decoder in its constructor, so\nRemoteMediaManagerParent created every MediaCodec decoder on its\nMediaSupervisor task queue. Creating a MediaCodec decoder can be slow\non the Android emulator, and it blocked all IPDL of the manager,\nincluding the shutdown of decoders that were no longer needed.\n\nFFmpegDecoderModule::AsyncCreateDecoder now sets up the hardware\ndecoder on the decoder's task queue, and resolves the creation promise\nonce it is done. The GPU process still rejects decoders that could not\nset up hardware decoding, now with the reason the setup failed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342235\n", "files": ["dom/media/platforms/ffmpeg/FFmpegDecoderModule.h", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h"], "git_node": "a910de305c3a02dd3b7c567333968687c6915a06", "git_parents": ["10116b10e59aec5741ef55de50662469dc593a23"], "node": "90c406cc0f99da0db27af5c94df0301ff77e2478", "parents": ["38d819f2205447aebbf074ee0b0b35a9f00a077c"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090592 - Adjust ImageDecoder cleanup during cycle collection. r=media-playback-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341578\n", "files": ["dom/media/webcodecs/ImageDecoder.cpp"], "git_node": "762c656d7b524d872a9fb725e8c8873d896e9b0d", "git_parents": ["a910de305c3a02dd3b7c567333968687c6915a06"], "node": "480983fdb0b83cf199ae2ad80355559bd2b6f63b", "parents": ["90c406cc0f99da0db27af5c94df0301ff77e2478"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019836 - Clamp GC time budgets to at least 2ms. r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338738\n", "files": ["dom/base/CCGCScheduler.cpp", "dom/base/CCGCScheduler.h", "js/public/SliceBudget.h", "js/src/jsapi-tests/testSliceBudget.cpp"], "git_node": "10681612a643c389010ef201dc1fef6d59495e3b", "git_parents": ["762c656d7b524d872a9fb725e8c8873d896e9b0d"], "node": "b08daea0220e11a6dc7a97c6f6fd78066a02b59e", "parents": ["480983fdb0b83cf199ae2ad80355559bd2b6f63b"], "tags": []}, {"author": "Neeco Fabian \u003cneecofabian@gmail.com\u003e", "branch": "default", "desc": "Bug 2087665 - Center icons in refreshed FRO Return to AMO Screen r=emcminn,omc-reviewers\n\n- Show centered add-on icon and brand icon in the center-large RTAMO screen\n- Prefer 128px add-on icon\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341570\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aboutwelcome/modules/AboutWelcomeDefaults.sys.mjs", "browser/components/aboutwelcome/tests/xpcshell/test_AboutWelcomeAttribution.js", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/tests/unit/content-src/components/MultiStageAWProton.test.jsx"], "git_node": "5d1fd00003a8561e135fc2e34cb8aa0544858d37", "git_parents": ["10681612a643c389010ef201dc1fef6d59495e3b"], "node": "b1b00452f97b6dae94cd56ebd118abf05038a7ab", "parents": ["b08daea0220e11a6dc7a97c6f6fd78066a02b59e"], "tags": []}, {"author": "mimi \u003cmjung@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092171 - Prevents SET_PREF from overwriting termsofuse.firstAcceptedDate once it has been set r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342263\n", "files": ["browser/components/asrouter/tests/browser/browser_asrouter_infobar.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_set_prefs.js"], "git_node": "39f0c4cdaae4d05dc74275e1670cec377dbe1d6d", "git_parents": ["5d1fd00003a8561e135fc2e34cb8aa0544858d37"], "node": "614f5267b27ab6a91240cf5b14e7348ab58707b7", "parents": ["b1b00452f97b6dae94cd56ebd118abf05038a7ab"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091325 - Enable gfx.webrender.svg-shapes.gradients. r=layout-reviewers,jwatt\n\nSVG rects, circles and ellipses filled with a linear or radial gradient are drawn as WebRender gradients.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342025\n", "files": ["layout/reftests/image-element/reftest.list", "layout/reftests/text-svgglyphs/reftest.list", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/css/css-transforms/transform-origin/svg-origin-length-cm-003.html.ini", "testing/web-platform/meta/css/css-transforms/transform-origin/svg-origin-length-pt-003.html.ini", "testing/web-platform/meta/svg/pservers/reftests/radialgradient-basic-002.svg.ini"], "git_node": "8da4936e270de53e23fb5addcf1da30d1feaab56", "git_parents": ["39f0c4cdaae4d05dc74275e1670cec377dbe1d6d"], "node": "843be388969fb1600bc8a6ea9599290450cdee3c", "parents": ["614f5267b27ab6a91240cf5b14e7348ab58707b7"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091325 - Enable gfx.webrender.svg-text. r=layout-reviewers,firefox-svg-reviewers,jwatt\n\nSVG text with a plain opaque fill and no stroke is drawn as WebRender text.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342027\n", "files": ["layout/reftests/bugs/reftest.list", "layout/reftests/svg/reftest.list", "layout/reftests/svg/text/reftest.list", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/css/css-pseudo/svg-text-selection-002.html.ini", "testing/web-platform/meta/css/css-text-decor/text-decoration-inset-svg-fragment-001.html.ini", "testing/web-platform/meta/css/css-text-decor/text-decoration-inset-svg-fragment-002.html.ini", "testing/web-platform/meta/svg/text/reftests/opacity.svg.ini", "testing/web-platform/meta/svg/text/reftests/text-bidi-controls-anchors-2.svg.ini", "testing/web-platform/meta/svg/text/reftests/text-font-face-load-image.html.ini", "testing/web-platform/meta/svg/text/reftests/textpath-side-001.svg.ini", "testing/web-platform/meta/svg/text/reftests/textpath-side-003.svg.ini"], "git_node": "410287d28af99945719c27da7bf4fafe166fb304", "git_parents": ["8da4936e270de53e23fb5addcf1da30d1feaab56"], "node": "5ea3f21dc67646a31bb64961fb92b1af793ab0cb", "parents": ["843be388969fb1600bc8a6ea9599290450cdee3c"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083100 - Skip view transitions when the parent process loses its compositor or a tab moves to another window. r=webidl,emilio\n\nBoth paths change the WebRender instance or id namespace, so the snapshot keys\nof an active view transition become stale. BrowserChild::ReinitRendering\nalready skips transitions for the same reason.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341379\n", "files": ["dom/ipc/BrowserChild.cpp", "dom/view-transitions/ViewTransition.cpp", "dom/view-transitions/ViewTransition.h", "gfx/layers/wr/WebRenderLayerManager.cpp", "widget/nsIWidget.cpp"], "git_node": "a9d35f8969d26ac577e87b53ec8683bf6f7ee8e8", "git_parents": ["410287d28af99945719c27da7bf4fafe166fb304"], "node": "5997e7a935e31c0cd37d03e2746a52d5abe3e5f6", "parents": ["5ea3f21dc67646a31bb64961fb92b1af793ab0cb"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091197 - Part 1: Add a composer to the Widget Studio. r=nina-py,fluent-reviewers,flod\n\nAdds a `widget-composer` element to the bottom of the sidebar panel for writing the widget prompt.\n\n- Enter sends a `WidgetComposer:Submit` event with the trimmed prompt.\n- Shift+Enter adds a new line.\n- Escape sends a `WidgetComposer:Dismiss` event.\n- Submit is disabled until the prompt has text.\n- Adds a \"New widget\" button that opens the composer.\n- Focusing the sidebar panel moves focus into the composer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341583\n", "files": ["browser/components/widgets/content/sidebar-widget-studio.css", "browser/components/widgets/content/sidebar-widget-studio.mjs", "browser/components/widgets/content/widget-composer.css", "browser/components/widgets/content/widget-composer.mjs", "browser/components/widgets/jar.mn", "browser/components/widgets/tests/browser/browser_sidebar_widget_studio.js", "browser/components/widgets/tests/chrome/chrome.toml", "browser/components/widgets/tests/chrome/test_widget_composer.html", "browser/locales-preview/widgets.ftl"], "git_node": "d6ec0e4fe7154543371e827bd2290e2192132919", "git_parents": ["a9d35f8969d26ac577e87b53ec8683bf6f7ee8e8"], "node": "9428e4fde2301b12f3eeccb7e06b41f468953264", "parents": ["5997e7a935e31c0cd37d03e2746a52d5abe3e5f6"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091197 - Part 2: Only show the widget composer when authenticated. r=nina-py\n\nAdds a Lit reactive controller to track FxA sign-in status.\n\nThe widget studio subscribes to it with `new AuthenticationController(this)` and reads `authenticated` while rendering. Account changes update that boolean and request an update.\n\n- Observes `UIState.ON_UPDATE` to get changes to the account status.\n- Shows the composer and the \"New widget\" button only when signed in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341584\n", "files": ["browser/components/widgets/AuthenticationController.sys.mjs", "browser/components/widgets/content/sidebar-widget-studio.mjs", "browser/components/widgets/moz.build", "browser/components/widgets/tests/browser/browser_sidebar_widget_studio.js", "browser/components/widgets/tests/browser/head.js"], "git_node": "f1b66af441e209e811618586b7e2cb091e0d222e", "git_parents": ["d6ec0e4fe7154543371e827bd2290e2192132919"], "node": "c20d24be562a030841ce60f58026e83f8aab3a6f", "parents": ["9428e4fde2301b12f3eeccb7e06b41f468953264"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091569 - renderPrompt should single pass substitute placeholders like GenAI.buildChatPrompt r=cdipersio\n\nuse regex replace with callback instead of looping\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341624\n", "files": ["browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/tests/xpcshell/test_Utils.js"], "git_node": "5ea5424d1b47122ff06338227fe8ba07c34882f0", "git_parents": ["f1b66af441e209e811618586b7e2cb091e0d222e"], "node": "131ed04548e19ee47a725f8280a1c84f3d813076", "parents": ["c20d24be562a030841ce60f58026e83f8aab3a6f"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1529398 - Enable WPT tests for RTCConfiguration iceCandidatePoolSize. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328948\n", "files": ["testing/web-platform/meta/webrtc/RTCConfiguration-iceCandidatePoolSize.html.ini", "testing/web-platform/meta/webrtc/RTCPeerConnection-constructor.html.ini"], "git_node": "6e9083bf3a5d1cf647f137f4d7b92d2da915469c", "git_parents": ["5ea5424d1b47122ff06338227fe8ba07c34882f0"], "node": "75dc8be6b34ef0204969324f5accde5297516f9e", "parents": ["131ed04548e19ee47a725f8280a1c84f3d813076"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1529398 - Add iceCandidatePoolSize to RTCConfiguration WebIDL. r=bwc,webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328949\n", "files": ["dom/webidl/RTCConfiguration.webidl", "dom/webidl/RTCStatsReport.webidl"], "git_node": "8644ed32845e7f804c3799f148392a97cd9d6fcc", "git_parents": ["6e9083bf3a5d1cf647f137f4d7b92d2da915469c"], "node": "1da112706fb17cb747acd7c97c5c4daa810e32fd", "parents": ["75dc8be6b34ef0204969324f5accde5297516f9e"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1529398 - fix test_peerConnection_bug825703.html with addition of iceCandidatePoolSize. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328950\n", "files": ["dom/media/webrtc/tests/mochitests/test_peerConnection_bug825703.html"], "git_node": "78119911655eed469a87fb99916f992926e5d943", "git_parents": ["8644ed32845e7f804c3799f148392a97cd9d6fcc"], "node": "7cf33afb18afe5979e2ed73c41eeb9b63709a40c", "parents": ["1da112706fb17cb747acd7c97c5c4daa810e32fd"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1529398 - Implement RTCConfiguration.iceCandidatePoolSize. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328951\n", "files": ["dom/media/PeerConnection.sys.mjs", "dom/media/webrtc/WebrtcGlobal.h", "dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "toolkit/content/aboutwebrtc/aboutWebrtc.mjs"], "git_node": "1db6cbc842c737eb974161e55b832c96a2cb6256", "git_parents": ["78119911655eed469a87fb99916f992926e5d943"], "node": "18606f6bef579153859d7c4090f173158f6e4f42", "parents": ["7cf33afb18afe5979e2ed73c41eeb9b63709a40c"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1529398 - add a wpt for iceCandidatePoolSize gathering. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328952\n", "files": ["testing/web-platform/tests/webrtc/RTCPeerConnection-iceCandidatePoolSize-gathering.https.html"], "git_node": "10c96e5ba973ed2ca02af6cac2568a89b2766d5c", "git_parents": ["1db6cbc842c737eb974161e55b832c96a2cb6256"], "node": "0d98ea09f42e8dd9df5413eee941b52d6f656e65", "parents": ["18606f6bef579153859d7c4090f173158f6e4f42"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1529398 - add a mochitest that iceCandidatePoolSize allocates on the TURN server before setLocalDescription. r=bwc\n\nWhether the pool supplies the candidates a page sees is not observable from\ncontent, but the ICE server can see the allocations it makes. Log successful\nallocations in the test ICE server so the test can wait for one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339710\n", "files": ["dom/media/webrtc/tests/mochitests/mochitest_peerconnection.toml", "dom/media/webrtc/tests/mochitests/test_peerConnection_iceCandidatePoolSize.html", "testing/tools/iceserver/iceserver.py"], "git_node": "b7a8b45ab69767f945574e122083e727b21ecbf1", "git_parents": ["10c96e5ba973ed2ca02af6cac2568a89b2766d5c"], "node": "58d1b35ae62776c54d459413fd8e6e7559efa61b", "parents": ["0d98ea09f42e8dd9df5413eee941b52d6f656e65"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1529398 - add tests to make sure modifying iceCandidatePoolSize fails if setLocalDescription has been called. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328953\n", "files": ["dom/media/webrtc/tests/mochitests/mochitest_peerconnection.toml", "dom/media/webrtc/tests/mochitests/test_peerConnection_iceCandidatePoolSizeChurn.html", "testing/web-platform/tests/webrtc/RTCConfiguration-iceCandidatePoolSize.html"], "git_node": "51425acbeabb076a03cb0a10c48c601d4d076cc1", "git_parents": ["b7a8b45ab69767f945574e122083e727b21ecbf1"], "node": "68235a6cea7e35510e38a76d14ca26acad276aee", "parents": ["58d1b35ae62776c54d459413fd8e6e7559efa61b"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1529398 - close the PeerConnections in RTCConfiguration-iceCandidatePoolSize.html r=bwc\n\nThe file constructed 19 RTCPeerConnections and closed 6. Each one that is\ndropped without close() leaves a window behind, which LeakSanitizer reports as\na leaked global on the asan web-platform-tests-webrtc job: the job is orange for\ntwo of them, and a try push with this file and the gathering test removed, but\nthe pool implementation untouched, comes back with no leaks at all.\n\nThe four tests added to this file for the setLocalDescription check already\nclean up after themselves; these are the upstream ones. The two out-of-range\nconstructor tests are left alone, since the constructor throws and no\nRTCPeerConnection is created.\n\nThis is an upstream test file, so the change wants to go to web-platform-tests\nas well rather than living only in the Gecko copy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328954\n", "files": ["testing/web-platform/tests/webrtc/RTCConfiguration-iceCandidatePoolSize.html"], "git_node": "6ed81a4e46fd57bfc96f2c7848c4ebd4204d9487", "git_parents": ["51425acbeabb076a03cb0a10c48c601d4d076cc1"], "node": "c14826a8dd5068d4e3f97778a7e9fe3cabc04333", "parents": ["68235a6cea7e35510e38a76d14ca26acad276aee"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1529398 - mark host candidates initialized through nr_ice_candidate_mark_done. r=bwc\n\nA host candidate was the one kind of candidate that did not finish through\nnr_ice_candidate_mark_done. nr_ice_candidate_initialize saved its callback\nin ready_cb/ready_cb_arg and scheduled nr_ice_candidate_fire_ready_cb,\nwhich called nr_ice_gather_finished_cb directly, and\nnr_ice_gather_finished_cb then set the host candidate's state to\nINITIALIZED itself. That left done_cb set on every initialized host\ncandidate, unlike every other kind, so code that looks at done_cb to tell\nwhether a candidate has finished got the wrong answer for host candidates.\nThe candidate pool in the next commit relies on done_cb being cleared.\n\nThe host case now schedules a call to nr_ice_candidate_mark_done(cand,\nNR_ICE_CAND_STATE_INITIALIZED) instead, from a lambda that also clears\nready_cb_timer, since nr_ice_candidate_stop_gathering cancels that timer.\nEvery candidate now finishes through nr_ice_candidate_mark_done, which\nclears done_cb and sets the state before calling it, so ready_cb,\nready_cb_arg and nr_ice_candidate_fire_ready_cb are removed, along with the\nhost special case in nr_ice_gather_finished_cb.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342216\n", "files": ["dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_candidate.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_candidate.h", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_ctx.cpp"], "git_node": "f724b5ca75a353841612f105ffb985e9d3f80996", "git_parents": ["6ed81a4e46fd57bfc96f2c7848c4ebd4204d9487"], "node": "51cd129df7a0d0d4e8b53fbfcdffebae1ca08600", "parents": ["c14826a8dd5068d4e3f97778a7e9fe3cabc04333"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1529398 - add a pre-gathered ICE candidate pool to nICEr and NrIceCtx. r=bwc\n\nA pooled entry is a gathered nr_ice_component: sockets, the candidates\nbuilt on them, and the STUN server contexts that answer checks on them.\nnr_ice_ctx_resize_candidate_pool creates a hidden stream whose\ncomponents are the pool.  We use a stream because gathering wants one,\nbut hide it so that it doesn't take part in normal ICE processing.\nnr_ice_media_stream_initialize gives each component of a real stream the\nchance to take a component from the pool, which reparents its sockets\nand candidates, recomputes the candidate priorities for the new\ncomponent id, and points the sockets' STUN server contexts at the taking\ncomponent and its stream's credentials.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333081\n", "files": ["dom/media/webrtc/transport/nricectx.cpp", "dom/media/webrtc/transport/nricectx.h", "dom/media/webrtc/transport/test/ice_unittest.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_candidate.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_component.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_component.h", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_ctx.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_ctx.h", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_media_stream.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_media_stream.h", "dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_socket.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/stun/stun_server_ctx.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/stun/stun_server_ctx.h"], "git_node": "d52228ab80d6c9bdd8c4bb9c03a30756d6093672", "git_parents": ["f724b5ca75a353841612f105ffb985e9d3f80996"], "node": "a0c6f7fc703ee55419dcdf3254fa0f60e72ace41", "parents": ["51cd129df7a0d0d4e8b53fbfcdffebae1ca08600"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1529398 - implement iceCandidatePoolSize gathering. r=bwc\n\nUse the new candidate pool functionality in nICEr.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328955\n", "files": ["dom/media/webrtc/common/IceServerParser.h", "dom/media/webrtc/common/RandomHex.cpp", "dom/media/webrtc/common/RandomHex.h", "dom/media/webrtc/common/moz.build", "dom/media/webrtc/jsapi/MediaTransportHandler.cpp", "dom/media/webrtc/jsapi/MediaTransportHandler.h", "dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.h", "dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/tests/mochitests/test_peerConnection_iceCandidatePoolSize.html", "media/webrtc/signaling/gtest/mediapipeline_unittest.cpp"], "git_node": "496d303126863dafc2c54bb834aae1d6a2bc5b2e", "git_parents": ["d52228ab80d6c9bdd8c4bb9c03a30756d6093672"], "node": "387d9c00f31a03436e6f701350403726499c7321", "parents": ["a0c6f7fc703ee55419dcdf3254fa0f60e72ace41"], "tags": []}, {"author": "Mitchell Plyler \u003cmlplyler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090992 - Break smart shortcuts features into functional sets. r=thecount\n\nSmart shortcuts predicts which URL a user will click based on features of that URL. Currently a single feature set is used for learning, ranking and reporting. This splits it into independently configurable training, ranking and\nreporting sets: training features drive the client-side weight updates, ranking features produce the score shortcuts are sorted by, and reporting features control which scores and weights are sent in telemetry. Features in any set are\ncomputed. This unblocks controlling for positional propensity on the client and measuring candidate features before using them in the ranker.\n\nThe single final score is replaced by training and ranking scores, which are reported in telemetry when listed in the reporting set (included by default and for configs using the legacy features key).\n\nAdding a feature no longer resets the existing learned weights; the new feature is initialized on its own. Changing the initial weight of an existing feature still resets all weights.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340985\n", "files": ["browser/extensions/newtab/lib/SmartShortcutsRanker/RankShortcuts.mjs", "browser/extensions/newtab/lib/SmartShortcutsRanker/RankShortcutsWorkerClass.mjs", "browser/extensions/newtab/test/xpcshell/test_ShortcutRanker.js"], "git_node": "feeed735f7963bd01eb5e22b2889732aee02a88e", "git_parents": ["496d303126863dafc2c54bb834aae1d6a2bc5b2e"], "node": "c0b1fb24735d45cb8e7f8ce887928d2483564220", "parents": ["387d9c00f31a03436e6f701350403726499c7321"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2087835 - Simplify how we deal with the vlink/etc legacy attributes. r=firefox-style-system-reviewers,layout-reviewers,jwatt\n\nRather than introducing pres hint declarations, just map them to the\nsystem colors that we use in the UA sheet. This is a lot simpler.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342177\n", "files": ["layout/style/AttributeStyles.cpp", "layout/style/AttributeStyles.h", "layout/style/GeckoBindings.cpp", "layout/style/GeckoBindings.h", "servo/components/style/dom.rs", "servo/components/style/gecko/wrapper.rs", "servo/components/style/matching.rs", "servo/components/style/rule_collector.rs", "servo/components/style/sharing/mod.rs"], "git_node": "6db3c6d75884d9cbdef40f6d1a7baf0451212707", "git_parents": ["feeed735f7963bd01eb5e22b2889732aee02a88e"], "node": "2e7d339fc6fdf48d8975f85d4fec60ea60eb0e55", "parents": ["c0b1fb24735d45cb8e7f8ce887928d2483564220"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090443 - Enable tests that synthesize touchpad pan gestures on Linux. r=hiro\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340565\n", "files": ["gfx/layers/apz/test/mochitest/helper_axis_lock_parent_layer_coords.html", "gfx/layers/apz/test/mochitest/helper_bug1922904.html", "gfx/layers/apz/test/mochitest/helper_bug1934118.html", "gfx/layers/apz/test/mochitest/helper_overscroll_behavior_chain_no_effect.html", "gfx/layers/apz/test/mochitest/helper_pan_end_snap_to_current_position_scrollend.html", "gfx/layers/apz/test/mochitest/mochitest.toml"], "git_node": "9ffeb18fa1bc9edca98e8c601d3d71df4fd10c22", "git_parents": ["6db3c6d75884d9cbdef40f6d1a7baf0451212707"], "node": "6d4f34fb9b10af62af3a414b3db529b6ff8827d8", "parents": ["2e7d339fc6fdf48d8975f85d4fec60ea60eb0e55"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2088810 - Remove the null check on the remote client in nsRemoteService::SendCommandLine (Coverity CID 1704201) r=mossop\n\nstd::make_unique is infallible, so the check is dead code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339449\n", "files": ["toolkit/components/remote/nsRemoteService.cpp"], "git_node": "d8842bdd7186bbc423abf0e5a12a9871a8933758", "git_parents": ["9ffeb18fa1bc9edca98e8c601d3d71df4fd10c22"], "node": "4703c0c709aaa29ce348ea0a7224098b612e80fc", "parents": ["6d4f34fb9b10af62af3a414b3db529b6ff8827d8"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2088804 - Move the origin metadata into FullOriginMetadata in QuotaManager::EnsureTemporaryOriginIsInitializedInternal (Coverity CID 1703910) r=hsingh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339443\n", "files": ["dom/quota/ActorsParent.cpp"], "git_node": "65fad2d8dcd1e72c015d6bb9f75fa5d1bfde43ca", "git_parents": ["d8842bdd7186bbc423abf0e5a12a9871a8933758"], "node": "d82a4a516d556600cb06ad54eba6f513f85e126a", "parents": ["4703c0c709aaa29ce348ea0a7224098b612e80fc"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089516 - Fall back to a search when no result is a URL in the GNOME Shell launch-all-results handler (Coverity CID 1463489) r=mossop\n\nThe fallback tested childCount, which is never 0 there because of the\nearlier return, instead of whether any URL was added.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339891\n", "files": ["browser/components/shell/nsGNOMEShellDBusHelper.cpp"], "git_node": "fe6fad85f9894968f8ce3bbd572952c847db75f6", "git_parents": ["65fad2d8dcd1e72c015d6bb9f75fa5d1bfde43ca"], "node": "b9844db0bc81b4c26547bf7cad0bd5597b045d2b", "parents": ["d82a4a516d556600cb06ad54eba6f513f85e126a"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044705 - Focus the address bar after opening a new tab from cross-origin iframe fullscreen. r=tabbrowser-reviewers,daleharvey,nsharpley\n\nThe tab switch code selected the urlbar on the first MozDOMFullscreen:Exited event. For a cross-process iframe, that fires before every process has left fullscreen, so the toolbars were still hidden and the focus call did nothing. Wait for the inDOMFullscreen attribute to be removed instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341943\n", "files": ["browser/base/content/test/browser-fullscreen/browser_fullscreen_newtab.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "746a8ee723a616297cca7bdd477b83a3eaf60229", "git_parents": ["fe6fad85f9894968f8ce3bbd572952c847db75f6"], "node": "43d8ee69a9c757dc137e2979801f7e07d72bc5dd", "parents": ["b9844db0bc81b4c26547bf7cad0bd5597b045d2b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092236 - Treat GeckoView Android lint warnings as errors. r=geckoview-reviewers,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342316\n", "files": ["mobile/android/geckoview/build.gradle", "mobile/android/geckoview/lint.xml"], "git_node": "966572e53fd3269c9a5eff6a218b872c5f5e30eb", "git_parents": ["746a8ee723a616297cca7bdd477b83a3eaf60229"], "node": "0494435da698fc70f9bc1aa6f2183701d01ca735", "parents": ["43d8ee69a9c757dc137e2979801f7e07d72bc5dd"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086641 - Update AGP to version 9.5.1. r=android-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337694\n", "files": ["gradle/libs.versions.toml"], "git_node": "786deffd70ae12c74036bd070e4ead015c94e2f8", "git_parents": ["966572e53fd3269c9a5eff6a218b872c5f5e30eb"], "node": "8ed0734bdeb3fe9c05a83f57af0a75da5c300c35", "parents": ["0494435da698fc70f9bc1aa6f2183701d01ca735"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2019836 - Clamp GC time budgets to at least 2ms. r=jonco\" for causing multiple failures at SliceBudget.h\n\nThis reverts commit 10681612a643c389010ef201dc1fef6d59495e3b.\n", "files": ["dom/base/CCGCScheduler.cpp", "dom/base/CCGCScheduler.h", "js/public/SliceBudget.h", "js/src/jsapi-tests/testSliceBudget.cpp"], "git_node": "43c638e345ca1e375a8b3a151b0a6b81a266c7a8", "git_parents": ["786deffd70ae12c74036bd070e4ead015c94e2f8"], "node": "328083cb01e73fd16ef12a897d297294589d0837", "parents": ["8ed0734bdeb3fe9c05a83f57af0a75da5c300c35"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2091211 - Fix active rect handling of view transition captures. r=nical,view-transitions-reviewers\" for causing wr failures at massive-element-left-of-viewport-offscreen-new.html\n\nThis reverts commit 72de6495c46a07ed2e85471d01e6d8c7a1c14c6e.\n", "files": ["layout/generic/nsImageFrame.cpp", "testing/web-platform/meta/css/css-view-transitions/massive-element-left-of-viewport-offscreen-new.html.ini", "testing/web-platform/meta/css/css-view-transitions/massive-element-left-of-viewport-offscreen-old.html.ini", "testing/web-platform/meta/css/css-view-transitions/massive-element-on-top-of-viewport-offscreen-new.html.ini", "testing/web-platform/meta/css/css-view-transitions/massive-element-on-top-of-viewport-offscreen-old.html.ini"], "git_node": "91123c0357680e42d015a7e36895458833e65ac3", "git_parents": ["43c638e345ca1e375a8b3a151b0a6b81a266c7a8"], "node": "bd8c3908a0b7dae50e1bcb8b9dc4b6029ba6680c", "parents": ["328083cb01e73fd16ef12a897d297294589d0837"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2021012 : Enable multiple import maps in Nightly build. r=jonco\" for causing failures at test_inline_module_reject_importMap.html\n\nThis reverts commit 932d54e1748c1abad860e9de97621f2e9efc089c.\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "136631595bb700c0ef3cf554d9ff5fad41df4d6a", "git_parents": ["91123c0357680e42d015a7e36895458833e65ac3"], "node": "4ab8be1c688e37093f2e0f8e16ecb246ff4ee7e8", "parents": ["bd8c3908a0b7dae50e1bcb8b9dc4b6029ba6680c"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2091197 - Part 2: Only show the widget composer when authenticated. r=nina-py\" for causing bc failures at browser/browser_generated_widgets.js\n\nThis reverts commit f1b66af441e209e811618586b7e2cb091e0d222e.\n\nRevert \"Bug 2091197 - Part 1: Add a composer to the Widget Studio. r=nina-py,fluent-reviewers,flod\"\n\nThis reverts commit d6ec0e4fe7154543371e827bd2290e2192132919.\n", "files": ["browser/components/widgets/AuthenticationController.sys.mjs", "browser/components/widgets/content/sidebar-widget-studio.css", "browser/components/widgets/content/sidebar-widget-studio.mjs", "browser/components/widgets/content/widget-composer.css", "browser/components/widgets/content/widget-composer.mjs", "browser/components/widgets/jar.mn", "browser/components/widgets/moz.build", "browser/components/widgets/tests/browser/browser_sidebar_widget_studio.js", "browser/components/widgets/tests/browser/head.js", "browser/components/widgets/tests/chrome/chrome.toml", "browser/components/widgets/tests/chrome/test_widget_composer.html", "browser/locales-preview/widgets.ftl"], "git_node": "35b31af221302a2c3938c515ed2aa3ca779ced6b", "git_parents": ["136631595bb700c0ef3cf554d9ff5fad41df4d6a"], "node": "6116fb0120947185f12ecc603f83352047db12c3", "parents": ["4ab8be1c688e37093f2e0f8e16ecb246ff4ee7e8"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090444: Save sync engine choices upon signing out for PDS clients r=markh,sync-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341027\n", "files": ["services/sync/modules/SyncDisconnect.sys.mjs", "services/sync/modules/service.sys.mjs", "services/sync/tests/unit/test_disconnect_shutdown.js", "services/sync/tests/unit/test_service_sync_updateEnabledEngines.js"], "git_node": "bb720302bab1cba07a712e7730941cf5c9e47b05", "git_parents": ["35b31af221302a2c3938c515ed2aa3ca779ced6b"], "node": "c4885f8d6b0b23e728592aab9d33d661c28ef369", "parents": ["6116fb0120947185f12ecc603f83352047db12c3"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2083834 - UI updates for smart window settings and gated option for auto model - r=pdahiya,fluent-reviewers,settings-reviewers,hjones,flod,cdipersio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340970\n", "files": ["browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/content/firstrun.js", "browser/components/aiwindow/ui/test/xpcshell/test_ChatModelChoice.js", "browser/components/preferences/config/aiFeatures.mjs", "browser/components/preferences/preferences.js", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window_model_selection.js", "browser/locales/en-US/browser/aiFeatures.ftl"], "git_node": "c7d1798877ceb4a0f59accbd81ffb53801cd39a7", "git_parents": ["bb720302bab1cba07a712e7730941cf5c9e47b05"], "node": "f1da3205c56f7e29c264e8a4b49910e4aa71eae7", "parents": ["c4885f8d6b0b23e728592aab9d33d661c28ef369"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092211 - Add tests for bug 2068417 and bug 2072432. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342301\n", "files": ["testing/web-platform/tests/xml/xslt/xslt-reparent-custom-element-crash.xml", "testing/web-platform/tests/xml/xslt/xslt-reparent-custom-element-crash.xsl", "testing/web-platform/tests/xml/xslt/xslt-reparent-root-crash.xml", "testing/web-platform/tests/xml/xslt/xslt-reparent-root-crash.xsl"], "git_node": "4797a62c093b4b2b7ead74ae388811f16da27ca5", "git_parents": ["c7d1798877ceb4a0f59accbd81ffb53801cd39a7"], "node": "d9d61158e8f0fbb60fa23e26e1ccdb02e23b5fa1", "parents": ["f1da3205c56f7e29c264e8a4b49910e4aa71eae7"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2087062 - Wrap long words in Smart Window assistant replies. r=flozia\n\nA long word with no spaces, like a long number, did not wrap in assistant replies. It went past the edge of the chat and added a horizontal scrollbar. User messages already wrap with overflow-wrap: anywhere.\n\nAssistant replies use overflow-wrap: break-word instead, so tables in replies still scroll sideways and their words are not split in the middle.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341989\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.css", "browser/components/aiwindow/ui/test/browser/browser_aichat_content_overflow.js"], "git_node": "9c97531ebd59bde7413162f14c96c1cf2b229f4c", "git_parents": ["4797a62c093b4b2b7ead74ae388811f16da27ca5"], "node": "2701ce846e5d0b4cac2092b492ee7fef3f1719cf", "parents": ["d9d61158e8f0fbb60fa23e26e1ccdb02e23b5fa1"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2059750 - Reset sidebar.visibility before leaving vertical tabs in browser_uidensity_auto_compact.js, r=nsharpley.\n\ntest_collapsed_launcher_width_triggers_compact failed when the test ran a second time in the same browser.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341426\n", "files": ["browser/components/customizableui/test/browser_uidensity_auto_compact.js"], "git_node": "2f6f130bdd236bd201cbc0808e3c1c2d77799c43", "git_parents": ["9c97531ebd59bde7413162f14c96c1cf2b229f4c"], "node": "e1ebd3d8dee72d27664159da384fa870440a0d81", "parents": ["2701ce846e5d0b4cac2092b492ee7fef3f1719cf"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092065 - Clear the client auth decisions remembered by browser_clientAuthRememberService.js, r=keeler.\n\nA later run of the test would otherwise not be asked for a certificate on its\nfirst visits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342138\n", "files": ["security/manager/ssl/tests/mochitest/browser/browser_clientAuthRememberService.js"], "git_node": "a7e32c9ee9b98997ed60e81a7825f72cdb3a11da", "git_parents": ["2f6f130bdd236bd201cbc0808e3c1c2d77799c43"], "node": "e04afe31c1034b16228852d4740beafd3ae47390", "parents": ["e1ebd3d8dee72d27664159da384fa870440a0d81"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092065 - Actually remove the enterprise intermediate added by browser_clientAuth_connection.js, r=keeler.\n\nsecurity.enterprise_roots.enabled defaults to true, so setting it to true\ndid not change it and the intermediate stayed loaded, giving a later run of\nthe test one more client certificate to choose from.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342140\n", "files": ["security/manager/ssl/tests/mochitest/browser/browser_clientAuth_connection.js"], "git_node": "26cc07a62ee7b4b41ecaf9f45a5f2a8e111e30b5", "git_parents": ["a7e32c9ee9b98997ed60e81a7825f72cdb3a11da"], "node": "d558361b704ac0be375ffd82f8fa8b7b4e618edf", "parents": ["e04afe31c1034b16228852d4740beafd3ae47390"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090749 - Make asrouter not contentaccessible. r=omc-reviewers,sachung\n\nNot needed after the previous patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340743\n", "files": ["browser/components/asrouter/jar.mn"], "git_node": "94c907c0ec746b6e5258427a4418c4b429877df2", "git_parents": ["26cc07a62ee7b4b41ecaf9f45a5f2a8e111e30b5"], "node": "63cf7c076a05e704b7439159f3fd261d73a98761", "parents": ["d558361b704ac0be375ffd82f8fa8b7b4e618edf"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1986173: Restore history when typed value fixup fails r=sessionstore-reviewers,nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341542\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser_newtab_userTypedValue.js"], "git_node": "f3fc41f31dbadbb3c65bbf2f4ef75921231866b4", "git_parents": ["94c907c0ec746b6e5258427a4418c4b429877df2"], "node": "7ca197932c1fb339388f4627887854f21c74aeee", "parents": ["63cf7c076a05e704b7439159f3fd261d73a98761"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2092196 - Make log build dependency optional, restrict it to Gecko. r=firefox-style-system-reviewers,emilio\n\nAvoids a `cargo::unused_dependencies` warning for Servo.\n\nImports a modified version of https://github.com/servo/stylo/pull/519\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342267\n", "files": ["servo/components/style/Cargo.toml"], "git_node": "c66dfb523659ffd3330917a6df29fbbdd2b82392", "git_parents": ["f3fc41f31dbadbb3c65bbf2f4ef75921231866b4"], "node": "d938d0021373a29ac26615404c71bafeaf12cfb4", "parents": ["7ca197932c1fb339388f4627887854f21c74aeee"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091549 - Match WebKit's current DOM bindings in browser_function_labels.toml r=perftest-reviewers,aglavic\n\nWebKit's generated bindings have an entry point for each DOM method, getter\nand setter (jsElementPrototypeFunction_setAttribute, jsElement_clientWidth,\nsetJSElement_innerHTML) that calls an implementation with a suffix (...Body,\n...Getter, ...Setter). The WebKit templates matched both the entry point and\nthe setter implementation, labeling each setter call twice (\"set\nElement.innerHTML\" over \"set Element.innerHTMLSetter\"), and did not match\ngetters, which are no longer named getJS..., at all.\n\nAnchor the getter and setter templates on the entry points' signatures. For\nmethods, match the entry point and the ...Body() it calls, since the entry\npoint often tail-calls the body and leaves no frame; a label is not repeated\ninside itself, so matching both still gives one label. Overloaded methods have\nnumbered bodies (CanvasRenderingContext2D's fill1Body), which are matched\nfirst so the label keeps the method's name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341592\n", "files": ["testing/raptor/raptor/browser_function_labels.toml"], "git_node": "1440696264ee22065d10a289261ca4614208c9ad", "git_parents": ["c66dfb523659ffd3330917a6df29fbbdd2b82392"], "node": "08014be21167ba9ce68f6f66a907a7a334c85ed6", "parents": ["d938d0021373a29ac26615404c71bafeaf12cfb4"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091549 - Add an Accessibility label to browser_function_labels.toml r=perftest-reviewers,aglavic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341593\n", "files": ["testing/raptor/raptor/browser_function_labels.toml"], "git_node": "4e85c5283a7ccd7593c8c9733bf6fdccc5021b33", "git_parents": ["1440696264ee22065d10a289261ca4614208c9ad"], "node": "20b4d6befcd74e3dce1e17a49029acaab6603438", "parents": ["08014be21167ba9ce68f6f66a907a7a334c85ed6"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091549 - Label WebKit's destroyRenderTreeIfNeeded as layout object destruction in browser_function_labels.toml r=perftest-reviewers,aglavic\n\nWebKit tears down the renderers of removed DOM nodes in\nWebCore::destroyRenderTreeIfNeeded, which no label matched, so WebKit showed\nno \"Layout object destruction\" at all in Speedometer comparisons.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342237\n", "files": ["testing/raptor/raptor/browser_function_labels.toml"], "git_node": "a463090bc16c8456cb9704ac29075be665f67aeb", "git_parents": ["4e85c5283a7ccd7593c8c9733bf6fdccc5021b33"], "node": "9a211008d5b6125bc9861d9985bbef71fbe8ffb0", "parents": ["20b4d6befcd74e3dce1e17a49029acaab6603438"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091549 - Label WebKit's RenderLayerCompositor::updateCompositingLayers as paint in browser_function_labels.toml r=perftest-reviewers,aglavic\n\nUpdating the compositing layer tree is part of WebKit's rendering update, like\nthe compositing work already labeled \"Paint\" for Blink, but no label matched\nit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342238\n", "files": ["testing/raptor/raptor/browser_function_labels.toml"], "git_node": "421cacbc51f49cdfb603b09294a6df0609a71579", "git_parents": ["a463090bc16c8456cb9704ac29075be665f67aeb"], "node": "7a32e1514a9731a87a7436e6494a79eaf6fbb08f", "parents": ["9a211008d5b6125bc9861d9985bbef71fbe8ffb0"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2091923 - Include the source end in the JIT hints script key. r=iain\n\nThe key was the filename and start offset only, so different scripts that\nshare both get each other's hints. Every top-level script evaluated with the\nsame filename starts at offset 0, so once one of them was Baseline-compiled,\nlarge run-once scripts after it were compiled eagerly too. In the JetStream 3\nshell runner this more than doubled the Baseline code size.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341982\n", "files": ["js/src/jit-test/tests/baseline/baseline-hints-3.js", "js/src/jit/JitHints-inl.h", "js/src/jit/JitHints.h"], "git_node": "32f5ab46c3d78311f84f30554d6cbc49d6f4e150", "git_parents": ["421cacbc51f49cdfb603b09294a6df0609a71579"], "node": "0f28a83e5ac86ab3d45cce1d72b7e67ebc64c3a6", "parents": ["7a32e1514a9731a87a7436e6494a79eaf6fbb08f"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1901003 - Anchor the windows platform query of mach try perf on ^test-windows. r=perftest-reviewers,kshampur\n\nThe 'windows term also matched the linux and macOS talos sessionrestore-many-windows tasks. Desktop test labels start with their platform, so ^test-windows only matches Windows platforms, whatever the version.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341694\n", "files": ["tools/tryselect/selectors/perfselector/classification.py", "tools/tryselect/test/test_perf.py"], "git_node": "46eb030e92d8670f107961444a6cba73550fbf85", "git_parents": ["32f5ab46c3d78311f84f30554d6cbc49d6f4e150"], "node": "b86a6d542964173a571c2e8072e15229483a6dc3", "parents": ["0f28a83e5ac86ab3d45cce1d72b7e67ebc64c3a6"], "tags": []}, {"author": "andyh \u003candhuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091058 - Removed privacy notice infobar for TOS. r=omc-reviewers,mimi,sachung\n\nWe'll be launching a new privacy notice on Dec 15 that should replace this in-tree one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341686\n", "files": ["browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs"], "git_node": "9c843e615e867d629188f6dc5314c6eea1e99420", "git_parents": ["46eb030e92d8670f107961444a6cba73550fbf85"], "node": "5fd41831429e39019d0464ade8c4f81f19e86b81", "parents": ["b86a6d542964173a571c2e8072e15229483a6dc3"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085373: SelectionManager::ProcessTextSelChangeEvent: Fail gracefully instead of crashing if the caret container is defunct. r=accessibility-platform-reviewers,eeejay\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342001\n", "files": ["accessible/base/SelectionManager.cpp"], "git_node": "9e2e1d2f12ab33e569518dcb8d91be55be2d567d", "git_parents": ["9c843e615e867d629188f6dc5314c6eea1e99420"], "node": "5e8fc0d322c923c6361e68430ba217f80cc8fac4", "parents": ["5fd41831429e39019d0464ade8c4f81f19e86b81"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089253: When initialising a DocAccessible, ignore PDocAccessibleChild actors which have already been shut down. r=accessibility-platform-reviewers,eeejay\n\nA DocAccessibleChild remains managed by its WindowGlobalChild until the parent process deletes it.\nThus, if a DocAccessible is recreated multiple times before the parent responds (e.g. when reframing an iframe), a WindowGlobalChild can manage multiple DocAccessibleChild actors, but only one of them should still have a DocAccessible.\nPreviously, we incorrectly asserted that there was only one managed actor.\nIn release builds, we could also have picked an actor which had already been shut down and fail to shut down the live one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341687\n", "files": ["accessible/generic/DocAccessible.cpp", "accessible/tests/browser/e10s/browser.toml", "accessible/tests/browser/e10s/browser_treeupdate_iframe_reframe.js"], "git_node": "299ade55067bde2e8a8f1318297b1d98aa55ef17", "git_parents": ["9e2e1d2f12ab33e569518dcb8d91be55be2d567d"], "node": "cf896fb4f507371e7616eb688916fd0527b07dff", "parents": ["5e8fc0d322c923c6361e68430ba217f80cc8fac4"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091692 - Make file_generate_wrapper.py use cwd relative to topobjdir. r=firefox-build-system-reviewers,sylvestre,sergesanspaille\n\nfile_generate_wrapper.py's `action()` resolves the script's working\ndirectory by joining the provided `target_dir` onto `Path.cwd()`. The\ntarget_dir provided by gn_processor.py is expressed relative to the\ngenerated project's build root, so this is only correct if `Path.cwd()`\nis the top-level objdir.\n\nThat assumption was previously true for all GeneratedFiles emitted by\ngn_processor.py, as they all produced files that land in the \"export\"\ntier and therefore the top-level backend.mk file.\n\nWhen vendoring ANGLE's Vulkan backend, however, we now encounter\nGeneratedFiles that output \".inc\" files, which currently land in the\n\"pre-compile\" tier instead, and therefore a nested target-specific\nbackend.mk. This results in the action being executed with an incorrect\ncwd, resulting in failures.\n\nMake action() instead join the provided `target_dir` to\n`buildconfig.topobjdir`, ensuring the correct working directory is used.\n\nNote that these files do in fact belong in the \"export\" tier, which will\nbe addressed in the following patch, making this moot. But we take this\nopportunity to fix this bug, hopefully saving somebody a headache in the\nfuture.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341759\n", "files": ["python/mozbuild/mozbuild/action/file_generate_wrapper.py"], "git_node": "8152c3f5bf2b15cff3fade741025705d3f2684dc", "git_parents": ["299ade55067bde2e8a8f1318297b1d98aa55ef17"], "node": "fb4102472a3dbb887c1936d38538e34427c8d088", "parents": ["cf896fb4f507371e7616eb688916fd0527b07dff"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091692 - Treat .inc files as required before compile. r=firefox-build-system-reviewers,sergesanspaille\n\nANGLE's Vulkan backend generates several .inc files at build time, which\nwe must ensure are generated before any code which tries to include them\nis compiled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341760\n", "files": ["python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/test/backend/data/xpi-stage-compile-output/staged/moz.build", "python/mozbuild/mozbuild/test/backend/test_xpi_archive.py"], "git_node": "9dcedccaf27e0b6ed850f861c08293eb264e0adf", "git_parents": ["8152c3f5bf2b15cff3fade741025705d3f2684dc"], "node": "bf5d88f905d5601212001418e9494b59db847876", "parents": ["fb4102472a3dbb887c1936d38538e34427c8d088"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091692 - Escape commas when formatting generated file flags. r=firefox-build-system-reviewers,sergesanspaille\n\nVendoring ANGLE's Vulkan backend introduces GeneratedFiles with flags\nsuch as `--extinst=,\u003cpath\u003e`, i.e. containing a literal comma.\n\nWe shell-escape flags before writing them into $(call py_action, ...),\nso each flag reaches the script as a single shell argument. But `$(call\n...)` itself splits on unescaped commas in its own argument list before\nthe shell is ever involved, so a flag containing a comma is mistaken for\na boundary between py_action's own arguments.\n\nFix by escaping commas embedded within flags as `$(comma)`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341761\n", "files": ["config/makefiles/functions.mk", "python/mozbuild/mozbuild/backend/make.py", "python/mozbuild/mozbuild/test/backend/data/generated-files/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "74ed5c8a4fe83b8f6d007f73c572e2736a8fc08f", "git_parents": ["9dcedccaf27e0b6ed850f861c08293eb264e0adf"], "node": "f9e9a5db5303880d2aa8753bab0f53f7b058699f", "parents": ["bf5d88f905d5601212001418e9494b59db847876"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091692 - gn_processor.py: Include subdirs of root gen dir in LOCAL_INCLUDES. r=firefox-build-system-reviewers,sergesanspaille\n\ngn_processor.py has existing logic for ensuring the root `gen_path`\ndirectory is added to LOCAL_INCLUDES when required. However, some\ntargets may require a subdirectory of `gen_path` as an include dir. This\nensures that subdirectories of `gen_path` are also rebased correctly and\nadded to LOCAL_INCLUDES.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341762\n", "files": ["build/gn_processor.py"], "git_node": "60c44e3ce01e05c57e7d2ee396b318d7592dd64c", "git_parents": ["74ed5c8a4fe83b8f6d007f73c572e2736a8fc08f"], "node": "8c1363b20d62d6ff20e3b0ed83031671b1558d66", "parents": ["f9e9a5db5303880d2aa8753bab0f53f7b058699f"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042142 - Only read the last 10 visits of each page in fetchLast10VisitsByGuid. r=fchasen\n\nThe query joined every visit of each page, then filtered them through the\nsubquery selecting the 10 most recent ones, so its cost grew with the page\nhistory. Join on the subquery instead, so only those 10 visits are read,\nthrough the place_id/visit_date index.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302313\n", "files": ["browser/extensions/newtab/lib/SmartShortcutsRanker/RankShortcuts.mjs", "browser/extensions/newtab/test/xpcshell/test_ShortcutRanker.js"], "git_node": "7b7034e703dcc5728d97ab6c3ad8ffefcbc82b27", "git_parents": ["60c44e3ce01e05c57e7d2ee396b318d7592dd64c"], "node": "5d4d6fe53561b055e84123f26573efa92933b8c8", "parents": ["8c1363b20d62d6ff20e3b0ed83031671b1558d66"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042147 - Use GLOB instead of LIKE for guid prefix search in fetchBookmarksByGUIDPrefix. r=places-reviewers,daisuke\n\nLIKE is case-insensitive, so it can't use the guid index, and it would also\nmatch guids differing only in case. GLOB is case-sensitive and lets SQLite\nsearch the guid prefix through the index. Valid guid prefixes contain none\nof the GLOB wildcards.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302319\n", "files": ["toolkit/components/places/Bookmarks.sys.mjs", "toolkit/components/places/tests/bookmarks/test_bookmarks_fetch.js"], "git_node": "8e9284612c0ee765c0a04e160b0940160315c804", "git_parents": ["7b7034e703dcc5728d97ab6c3ad8ffefcbc82b27"], "node": "0f99b33a7155f94b6f1da72a8163c8785020a669", "parents": ["5d4d6fe53561b055e84123f26573efa92933b8c8"], "tags": []}, {"author": "virsworld \u003cvirpatel71@gmail.com\u003e", "branch": "default", "desc": "Bug 2069010 - Use bounded spans for preference callback lists. r=gstoll,firefox-style-system-reviewers,necko-reviewers,tschuster,media-playback-reviewers,layout-reviewers,padenot,dshin,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333982\n", "files": ["caps/nsScriptSecurityManager.cpp", "docshell/shistory/nsSHistory.cpp", "dom/base/nsFocusManager.cpp", "dom/base/nsNameSpaceManager.cpp", "dom/media/CubebUtils.cpp", "dom/media/platforms/PDMFactorySupport.cpp", "dom/security/nsContentSecurityUtils.cpp", "gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatformFontList.cpp", "js/xpconnect/src/XPCJSContext.cpp", "layout/base/nsPresContext.cpp", "layout/style/nsComputedDOMStyle.cpp", "modules/libpref/Preferences.cpp", "modules/libpref/Preferences.h", "modules/libpref/test/gtest/Basics.cpp", "netwerk/base/nsIOService.cpp", "netwerk/base/nsSocketTransportService2.cpp", "netwerk/protocol/http/nsHttpHandler.cpp", "toolkit/components/resistfingerprinting/nsRFPService.cpp"], "git_node": "e92c662118e63cb78d09c6f2ad6b0f101b7a2471", "git_parents": ["8e9284612c0ee765c0a04e160b0940160315c804"], "node": "ed3af81fb85b49ae1dbbc90c69414326cd417874", "parents": ["0f99b33a7155f94b6f1da72a8163c8785020a669"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087657 - Update styles for the Language Switcher to match Nova FRO r=omc-reviewers,jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340543\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "1f28f1bcec9386dc4b0c83d01ff29ec5e8537527", "git_parents": ["e92c662118e63cb78d09c6f2ad6b0f101b7a2471"], "node": "0a1779674be4f00e2f0ea5abcc0629c7b3efde23", "parents": ["ed3af81fb85b49ae1dbbc90c69414326cd417874"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091603 - Upgrade certifi to 2026.10.23 r=firefox-build-system-reviewers,perftest-reviewers,mach-reviewers,glandium,aglavic,sergesanspaille,ahal\n\n`./mach vendor python` also copies the new bundle into the vendored pip.\n\nThe copy in `testing/web-platform/tests` is submitted upstream at\nhttps://github.com/web-platform-tests/wpt/pull/65120\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341677\n", "files": ["taskcluster/docker/funsize-update-generator/requirements.txt", "taskcluster/docker/snap-coreXX-build/snap-tests/requirements.txt", "taskcluster/requirements.txt", "taskcluster/scripts/misc/build-cpython.sh", "testing/config/requirements-android-pgo.txt", "testing/config/requirements-condprofile.txt", "testing/config/requirements-marionette.txt", "testing/config/requirements-mozbase.txt", "testing/config/requirements-raptor.txt", "testing/manifest/test/test_manifest.txt", "testing/mozbase/mozproxy/mozproxy/backends/mitm/mitmproxy_requirements.txt", "testing/raptor/requirements-common.txt", "testing/web-platform/tests/tools/third_party/certifi/PKG-INFO", "testing/web-platform/tests/tools/third_party/certifi/certifi.egg-info/PKG-INFO", "testing/web-platform/tests/tools/third_party/certifi/certifi/__init__.py", "testing/web-platform/tests/tools/third_party/certifi/certifi/cacert.pem", "third_party/python/certifi/certifi-2026.10.19.dist-info/METADATA", "third_party/python/certifi/certifi-2026.10.19.dist-info/RECORD", "third_party/python/certifi/certifi-2026.10.19.dist-info/WHEEL", "third_party/python/certifi/certifi-2026.10.19.dist-info/licenses/LICENSE", "third_party/python/certifi/certifi-2026.10.19.dist-info/top_level.txt", "third_party/python/certifi/certifi-2026.10.23.dist-info/METADATA", "third_party/python/certifi/certifi-2026.10.23.dist-info/RECORD", "