Manager.https.any.js.ini", "testing/web-platform/meta/referrer-policy/gen/iframe.meta/default/mathml-a-tag.http.html.ini", "testing/web-platform/meta/referrer-policy/gen/srcdoc-inherit.meta/default/mathml-a-tag.http.html.ini", "testing/web-platform/meta/referrer-policy/gen/srcdoc.meta/default/mathml-a-tag.http.html.ini", "testing/web-platform/meta/referrer-policy/gen/top.meta/default/mathml-a-tag.http.html.ini", "testing/web-platform/meta/resource-timing/delivery-type.tentative.any.js.ini", "testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html.ini", "testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini", "testing/web-platform/meta/webaudio/idlharness.https.window.js.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-audioworklet-interface/audioworkletprocessor-unconnected-outputs.https.window.js.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/perform.py.ini", "testing/web-platform/meta/webrtc-extensions/RTCConfiguration-alwaysNegotiateDataChannels.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/bidi/u0041_first.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/portrait.tentative.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/bold_object/bold_namespace.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/italic_object/italic_namespace.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/underline_object/underline_namespace.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/default_styles/bold_object_default_font-style.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/default_styles/italic_object_default_font-style.html.ini", "testing/web-platform/meta/xhr/split-byte-order-mark.any.js.ini"], "git_node": "77fc5556b94d943fa70b73a91c7da67780648183", "git_parents": ["7a3cafd90e707d33db575efde1bb1b8dcb02c46a"], "node": "1c521f869569d15d3d647d78ecaa7b0d507c803b", "parents": ["10786cc3cb9bdf816a70d401e8bf9723a549d1ce"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089813 - Name the JSDoc API-reference cases in the documentation skill's description. r=sylvestre,ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340185\n", "files": [".agents/skills/documentation/SKILL.md", ".claude/skills/documentation/SKILL.md"], "git_node": "6884ce63a6db617572aca786f0bfed884e105d73", "git_parents": ["77fc5556b94d943fa70b73a91c7da67780648183"], "node": "a206379476dc2332bfedfb4e03b322d1ce1ae2d3", "parents": ["1c521f869569d15d3d647d78ecaa7b0d507c803b"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082835 - Add Tech Principles r=android-reviewers,ai4dev-reviewers,gmalekpour,pollymce,padenot\" for causing documentation failures in SKILL.md\n\nThis reverts commit 3200a2a1f1b58a5e359410bb41da8ccaeafba295.\n", "files": [".agents/skills/android/SKILL.md", ".claude/skills/android/SKILL.md", "mobile/android/fenix/docs/Tech-Principles.md", "mobile/android/fenix/docs/index.md"], "git_node": "b13de57bf4e9f71cf573e6c691f3882a5087e603", "git_parents": ["6884ce63a6db617572aca786f0bfed884e105d73"], "node": "57cf6d46d90e8e5aee668f29351461a78afc95ff", "parents": ["a206379476dc2332bfedfb4e03b322d1ce1ae2d3"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089029 - Fix metadata for html/semantics/interactive-elements/the-summary-element/interactive-content.html and lint error in testing/web-platform/tests/css/css-color/light-dark-image.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340310\n", "files": ["testing/web-platform/meta/html/semantics/interactive-elements/the-summary-element/interactive-content.html.ini", "testing/web-platform/tests/css/css-color/light-dark-image.html"], "git_node": "c61c8c6c727fcac3a721170ed4032e1d37db1abe", "git_parents": ["b13de57bf4e9f71cf573e6c691f3882a5087e603"], "node": "bf7f14b0ea5f2360a4b8513bad2233284ed347b7", "parents": ["57cf6d46d90e8e5aee668f29351461a78afc95ff"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2090007 - Remove some unneeded handling of attributes in SyncAttributesToWidget(). r=smaug\" for causing failures at test_cli_window_size.py.\n\nThis reverts commit 03f158a84e799d9a7fb0255d6c1928e7f85da088.\n", "files": ["dom/xul/ChromeObserver.cpp", "dom/xul/ChromeObserver.h", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/AppWindow.h"], "git_node": "03a905a98944b3ffd4d7dbb42c28b81db98d0860", "git_parents": ["c61c8c6c727fcac3a721170ed4032e1d37db1abe"], "node": "71cc79e7cd6cf9c9a4080604cc75711bac76548a", "parents": ["bf7f14b0ea5f2360a4b8513bad2233284ed347b7"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2089463 [HDR] Use stable rounding and correct subsurface position in HDR mode r=emilio,gtk-reviewers\n\n- Factor out gUseStableRounding to nsWindowWayland and move static pref init there\n- Use WaylandSurface and subsurface position to calc stable rounding coordinates\n- Add a correction for HDR root surface\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340285\n", "files": ["widget/gtk/GtkCompositorWidget.cpp", "widget/gtk/WaylandSurface.cpp", "widget/gtk/WaylandSurface.h", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/gtk/nsWindowWayland.cpp", "widget/gtk/nsWindowWayland.h"], "git_node": "0484d5cecd6f47586d9452cc3865c444034ba687", "git_parents": ["03a905a98944b3ffd4d7dbb42c28b81db98d0860"], "node": "c9c42910c1ee9d3ca7038b7157dc2815502e1eff", "parents": ["71cc79e7cd6cf9c9a4080604cc75711bac76548a"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2089540 [Wayland] Force commit wl_surface only when it's really moved r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339947\n", "files": ["widget/gtk/MozContainerWayland.cpp", "widget/gtk/WaylandSurface.cpp", "widget/gtk/WaylandSurface.h"], "git_node": "f261df383b31157edf03b8404a921eda4559c2df", "git_parents": ["0484d5cecd6f47586d9452cc3865c444034ba687"], "node": "c615b363eef245e3f8b2d400787a3622963c3474", "parents": ["c9c42910c1ee9d3ca7038b7157dc2815502e1eff"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2088590 - Only use the .jsonl extension for generic content types in the JSON Viewer sniffer r=nchevobbe,devtools-reviewers\n\nSince bug 2055774 every top level .jsonl URL was sent to the JSON Viewer\nwhatever the server declared, so an HTML page served as text/html at such\na URL was rendered as a broken JSON Lines document. The extension is now\nonly trusted for text/plain, application/octet-stream, a missing\nContent-Type header or an empty type. Local files still reach the sniffer\nas text/plain after the unknown-type decoder, so they keep opening in the\nviewer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339466\n", "files": ["devtools/client/jsonview/Sniffer.sys.mjs", "devtools/client/jsonview/test/browser.toml", "devtools/client/jsonview/test/browser_jsonview_jsonl.js", "devtools/client/jsonview/test/jsonl_html_contenttype.jsonl", "devtools/client/jsonview/test/jsonl_html_contenttype.jsonl^headers^"], "git_node": "0d0adefdc60bf32155e1cc4256d77289b126dcf6", "git_parents": ["f261df383b31157edf03b8404a921eda4559c2df"], "node": "0b2f1c78fe40fb7c7f24787512f57f132c8c93d7", "parents": ["c615b363eef245e3f8b2d400787a3622963c3474"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 1965752 - Regenerate Nimbus code when a manifest's included or imported FML file changes r=nalexander\n\nThe `nimbusFeatures` task only declared the top level manifest as an input, but the manifest can load other FML files transitively using `includes` or `import`. Editing one of these dependencies such as `onboarding.fml.yaml` didn't regenerate Nimbus code, so `FxNimbus` stayed stale until the generated file was manually deleted.\n\nThis adds `nimbus.manifestDependencies` property, which is to a new `@InputFiles` property in `NimbusFeaturesTask`. Fenix now lists the imported and included FML files so `FxNimbus` is regenerated when they change.\n\nTwo other approaches were considered:\n- Using a file tree with every `*.fml.yaml`, but it would also get unrelated files that match the pattern.\n- Parsing the manifest's dependencies recursively using a YAML dependency.\n\nListing the files manually is the simplest option, and it gives explicit control over the files that trigger the regeneration.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/431\n", "files": ["mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/messaging-evergreen-messages.fml.yaml", "mobile/android/fenix/app/messaging-fenix.fml.yaml", "mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusFeaturesTask.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusGradlePlugin.kt"], "git_node": "dea285e49297cd335f0b84c9ccd1c4b5ea18686e", "git_parents": ["0d0adefdc60bf32155e1cc4256d77289b126dcf6"], "node": "e1d46ca5fd81b2a03d5cce759a919da1664becd7", "parents": ["0b2f1c78fe40fb7c7f24787512f57f132c8c93d7"], "tags": []}, {"author": "Benjamin Grant \u003cbenjamin@nothingrandom.com\u003e", "branch": "default", "desc": "Bug 2090052 - add async to browser.omnibox.setDefaultSuggestion r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340336\n", "files": ["browser/components/extensions/schemas/omnibox.json"], "git_node": "372b109c6ad12f2935b98c8dd9d602251d68ed77", "git_parents": ["dea285e49297cd335f0b84c9ccd1c4b5ea18686e"], "node": "f1a6019d799a135ee4d3381ae394c569c76288fc", "parents": ["e1d46ca5fd81b2a03d5cce759a919da1664becd7"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089928 - Update android nightly application-services version bump to 904a4543e3f02963ac9d0c19ee66a7713360564c r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340263\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "87f0e01cbe8d14ecd953f8c53af5a087c06e2147", "git_parents": ["372b109c6ad12f2935b98c8dd9d602251d68ed77"], "node": "d84182d10a4ec5f33e491a010b0dd4be3ed9ca3c", "parents": ["f1a6019d799a135ee4d3381ae394c569c76288fc"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2089808 - Wrap \u003cfilesystem\u003e in the STL wrappers to fix libc++ 23 builds r=sergesanspaille\n\nlibc++ dropped `_LIBCPP_EXPORTED_FROM_ABI` from the forward declaration of\nstd::filesystem::path::iterator in __filesystem/path.h, but kept it on the\ndefinition in __filesystem/path_iterator.h. Under the\n`#pragma GCC visibility push(hidden)` that config/gcc_hidden.h force-includes on\nLinux and Android, the declaration picks up hidden visibility, and clang then\nrejects the definition with \"visibility does not match previous declaration\".\nThis is the same issue bug 2071243 fixed for \u003csystem_error\u003e.\n\n\u003cfilesystem\u003e is reached through abseil's absl/hash/internal/hash.h, which\nincludes it whenever __cpp_lib_filesystem is defined. Add it to\nconfig/stl-headers.mozbuild so the wrapper includes it under\n`#pragma GCC visibility push(default)`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340183\n", "files": ["config/stl-headers.mozbuild"], "git_node": "07cb2f29e26dfc758c68edd280ccd56859b9dc8f", "git_parents": ["87f0e01cbe8d14ecd953f8c53af5a087c06e2147"], "node": "17b2123347b927bef62b07f780eedf95dec104ca", "parents": ["d84182d10a4ec5f33e491a010b0dd4be3ed9ca3c"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090032 - Make sure downloads only fire one navigateevent r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340300\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/test/navigation/file_anchor_download_single_navigate_event.sjs", "docshell/test/navigation/mochitest.toml", "docshell/test/navigation/test_anchor_download_single_navigate_event.html"], "git_node": "f14b084b61e7e3e35b475347718bee5d5b2e75d9", "git_parents": ["07cb2f29e26dfc758c68edd280ccd56859b9dc8f"], "node": "d707006d37aee6a43748f9cca594acbebd2b345c", "parents": ["17b2123347b927bef62b07f780eedf95dec104ca"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090033 - Move attach-to-bug.py from desktop-theme-screenshots into the bug-filing skill. r=ai4dev-reviewers,padenot DONTBUILD\n\nThis changes a bug-filing rule: the skill now posts an attachment itself once the user approves the dry run, while filing a bug still only opens the form.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340305\n", "files": [".agents/skills/bug-filing/SKILL.md", ".agents/skills/bug-filing/attach-to-bug.py", ".agents/skills/desktop-theme-screenshots/SKILL.md", ".agents/skills/desktop-theme-screenshots/scripts/attach-to-bug.py", ".claude/skills/bug-filing/SKILL.md", ".claude/skills/bug-filing/attach-to-bug.py", ".claude/skills/desktop-theme-screenshots/SKILL.md", ".claude/skills/desktop-theme-screenshots/scripts/attach-to-bug.py"], "git_node": "ccdeb2fc42fe13d582f4705b00ca977a4165eea3", "git_parents": ["f14b084b61e7e3e35b475347718bee5d5b2e75d9"], "node": "cd4713330479fde1d372bfd80d93db1453ddc966", "parents": ["d707006d37aee6a43748f9cca594acbebd2b345c"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089765 - Raise the tier of Speedometer 3 emulator tests from 3 to 2. r=perftest-reviewers,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340146\n", "files": ["taskcluster/kinds/browsertime/mobile.yml"], "git_node": "55dd7ae1d67856f8b5b719a1a0405107f70f6e29", "git_parents": ["ccdeb2fc42fe13d582f4705b00ca977a4165eea3"], "node": "54e5df94f93b915ae47b3aba3be05ae4c80f4b05", "parents": ["cd4713330479fde1d372bfd80d93db1453ddc966"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2013988. Paint a snapshot of an in-process iframe while its rendering is suppressed for a view transition. r=emilio,layout-reviewers\n\nWhile a view transition in a document runs its update callback, the\ndocument's rendering is suppressed. A top-level document or out-of-process\niframe keeps showing its last frame then, because nothing new is sent to\nWebRender for it. The embedder of an in-process iframe kept painting the\niframe's current, partly updated contents instead.\n\nSo after capturing the old state of a transition in an in-process iframe,\ncapture a snapshot of the whole subdocument, and have nsSubDocumentFrame paint\nthat snapshot instead of the subdocument while its rendering is suppressed for\nthe transition. The snapshot needs a paint of its own. The paint that captures\nthe old state captures the root and the named elements as detached snapshots,\nwhich WebRender leaves out of the content around them, so a snapshot of the\nsubdocument taken in that paint would be missing them, all of the document\nwhen the root is captured. Including them would need WebRender to render the\nsame stacking contexts twice in a frame, once into their own snapshots and\nonce into the subdocument's, which it doesn't support. Drawing the captured\nimages back in place instead isn't the old frame where something overlaps a\nnamed element, and doesn't work when the root isn't captured. The extra paint\nonly happens once, when a transition in an in-process iframe starts.\n\nThe snapshot only covers the part of the iframe that is built when it is taken,\nwhich is what lies inside the display ports of the scroll frames around it (or\nwhat is visible, where there are none), like the last frame a top-level\ndocument or out-of-process iframe holds. The rest of the iframe, or all of it\nif none of it was built, is left empty rather than showing its new contents. So\nan iframe that is scrolled into view past that during the callback is only\npartly drawn.\n\n* * *\nBug 2013988 - review comments: assert in the subdocument capture, ASR comment, transformed iframe test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339533\n", "files": ["dom/view-transitions/ViewTransition.cpp", "dom/view-transitions/ViewTransition.h", "layout/generic/ScrollContainerFrame.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsSubDocumentFrame.cpp", "layout/painting/RetainedDisplayListBuilder.cpp", "layout/painting/nsDisplayItemTypesList.inc", "layout/painting/nsDisplayList.cpp", "layout/painting/nsDisplayList.h", "testing/web-platform/meta/css/css-view-transitions/paint-holding-in-iframe-named-element.html.ini", "testing/web-platform/meta/css/css-view-transitions/paint-holding-in-iframe-no-captured-elements.html.ini", "testing/web-platform/meta/css/css-view-transitions/paint-holding-in-iframe-scrolled-into-view.html.ini", "testing/web-platform/meta/css/css-view-transitions/paint-holding-in-iframe.html.ini", "testing/web-platform/mozilla/meta/css/css-view-transitions/paint-holding-in-iframe-offscreen-at-capture.html.ini", "testing/web-platform/mozilla/tests/css/css-view-transitions/paint-holding-in-iframe-offscreen-at-capture-ref.html", "testing/web-platform/mozilla/tests/css/css-view-transitions/paint-holding-in-iframe-offscreen-at-capture.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-ancestor-opacity-ref.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-ancestor-opacity.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-named-element-ref.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-named-element.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-no-captured-elements.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-overlap-ref.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-overlap.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-scrolled-into-view-ref.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-scrolled-into-view.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-skipped-ref.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-skipped.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-transformed-ref.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-transformed.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-transparent-ref.html", "testing/web-platform/tests/css/css-view-transitions/paint-holding-in-iframe-transparent.html"], "git_node": "87034851d35055d0234da06b1a5b89877817e14e", "git_parents": ["55dd7ae1d67856f8b5b719a1a0405107f70f6e29"], "node": "9cf5daa035cc9a8b6e73217026ab5a9ffd7a85de", "parents": ["54e5df94f93b915ae47b3aba3be05ae4c80f4b05"], "tags": []}, {"author": "Mauro Ferreiro \u003cmferreiro@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088341 - Raise existing Taskbar Tab windows when opening a new window for the same Taskbar Tab. r=hsohaney\n\nWithout this, the existing windows stay hidden behind other applications.\nThis is only done on Windows, because Linux window managers activate only\none window per user interaction. Raising a window briefly focuses it, so\nthat focus is not counted as usage time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339282\n", "files": ["browser/components/taskbartabs/TaskbarTabsWindowManager.sys.mjs", "browser/components/taskbartabs/test/browser/browser_taskbarTabs_telemetry.js", "browser/components/taskbartabs/test/browser/browser_taskbarTabs_windowManager.js"], "git_node": "745aa85237f2244b00ed53a27d41bc924bb127bb", "git_parents": ["87034851d35055d0234da06b1a5b89877817e14e"], "node": "7f51eea082d9bb26f4167493159dee30832aa01d", "parents": ["9cf5daa035cc9a8b6e73217026ab5a9ffd7a85de"], "tags": []}, {"author": "Samuel Ye \u003csamuel_ye@sfu.ca\u003e", "branch": "default", "desc": "Bug 2089977 - Add default value for SessionCacheInfo::mOverridableErrorCategory. r=necko-reviewers,valentin\n\nGave a default member initializer of nsITransportSecurityInfo::OverridableErrorCategory::ERROR_UNSET\nso that test-only PutForTest path does not serialize an uninitialized value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340296\n", "files": ["netwerk/base/SSLTokensCache.h"], "git_node": "154a3d4c8067cb923a018ed997e6755a6d2f5d9c", "git_parents": ["745aa85237f2244b00ed53a27d41bc924bb127bb"], "node": "7f2728babc404998b5d67f7aec66adc091866c8a", "parents": ["7f51eea082d9bb26f4167493159dee30832aa01d"], "tags": []}, {"author": "Samuel Ye \u003csamuel_ye@sfu.ca\u003e", "branch": "default", "desc": "Bug 2089975 - Fix leak when user-dirs.dirs repeats a key. r=xpcom-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340337\n", "files": ["xpcom/io/SpecialSystemDirectory.cpp"], "git_node": "a4b49a99d2dd9b37111132f7cf1f9fac6f3e03a2", "git_parents": ["154a3d4c8067cb923a018ed997e6755a6d2f5d9c"], "node": "6d6e9d1098df912e823dd53750e1e975819011d8", "parents": ["7f2728babc404998b5d67f7aec66adc091866c8a"], "tags": []}, {"author": "lottiehope \u003clottie_hope@hotmail.co.uk\u003e", "branch": "default", "desc": "Bug 2082520 - Only show the QWAC statement and EU trust mark for QWAC sites. r=android-reviewers,tthibaud,cbect\n\nShowing the EU trust mark for a site that isn't a QWAC would be a false claim\nabout its legal status, so the QWAC elements are only shown once a QWAC has been\ndetermined, and never while the QWAC status is pending or after it fails.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340074\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/store/TrustPanelState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/ProtectionPanel.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/TrustPanelStoreTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/WebsiteInfoStateTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/CertificateDetailsPanelTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/ProtectionPanelTest.kt"], "git_node": "db547b61903f9dee2ddb1a86de3beeab88b2c923", "git_parents": ["a4b49a99d2dd9b37111132f7cf1f9fac6f3e03a2"], "node": "fd24fdb5b029c5bbb1bea89a64e989d12e6767f4", "parents": ["6d6e9d1098df912e823dd53750e1e975819011d8"], "tags": []}], "date": 1793985415, "git_changesets": ["5a539f1eeedc65e380b04be3a798567840c7759a", "c3394d4e35d3c415ea424ee44145228408c640b2", "8fb29eb1d8d4617b966edaf945c856514a968140", "67a1039749c235af08b4288367ac0aa2ae8cfdd1", "f49494a56ecb2a4f068e4148d80e60