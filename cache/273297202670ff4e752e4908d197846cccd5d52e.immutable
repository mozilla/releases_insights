"node": "7ba690d5771be8c3824b4126c78f553c10da1852", "parents": ["42e9602cddaea961f39bd283c53d537b0e0dbfae"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089658 - Fix mach ts check hanging when run from outside the source tree. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340055\n", "files": ["tools/ts/mach_commands.py"], "git_node": "eadaea71914a3974a8342645df34be5031bc8541", "git_parents": ["da64cf8ee7b0a8e72881e01aa23b01af1826d0e5"], "node": "51efaa919a3a7b7e43cf643c2e91b69238732de6", "parents": ["7ba690d5771be8c3824b4126c78f553c10da1852"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088821 - Add a page on enabling TypeScript for a component. r=Standard8 DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339576\n", "files": ["docs/code-quality/typescript/enabling.md", "docs/code-quality/typescript/index.md"], "git_node": "cab11b8883498064d9c304388d81ee7b79b4f1aa", "git_parents": ["eadaea71914a3974a8342645df34be5031bc8541"], "node": "b078d27f1787484c325e3fb888ce3079f0671002", "parents": ["51efaa919a3a7b7e43cf643c2e91b69238732de6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088821 - Update the TypeScript linter's tier to 2 in the docs. r=Standard8 DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339577\n", "files": ["docs/code-quality/lint/linters/typescript.md", "docs/code-quality/typescript/index.md"], "git_node": "009dd4e1a8e6294d8878a75217cfc06c214a8a2f", "git_parents": ["cab11b8883498064d9c304388d81ee7b79b4f1aa"], "node": "d9a28a82355b06d91badb0181fdc54476b684ddf", "parents": ["b078d27f1787484c325e3fb888ce3079f0671002"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088821 - Document which projects the TypeScript linter checks. r=Standard8 DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339578\n", "files": ["docs/code-quality/lint/linters/typescript.md"], "git_node": "d3c4f3f3bf4c8512326c549b6f4ac9d1b789b3ed", "git_parents": ["009dd4e1a8e6294d8878a75217cfc06c214a8a2f"], "node": "f20126917442cd133fd19e4f83227755b5979505", "parents": ["d9a28a82355b06d91badb0181fdc54476b684ddf"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088821 - Extend the TypeScript best practices page. r=Standard8 DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339579\n", "files": ["docs/code-quality/typescript/bestPractices.md"], "git_node": "21aaff13a65f71a2b4754315556e51d1333acca5", "git_parents": ["d3c4f3f3bf4c8512326c549b6f4ac9d1b789b3ed"], "node": "17756bcf480fcebb22aff650befe9a96fd9c451a", "parents": ["f20126917442cd133fd19e4f83227755b5979505"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088821 - Say when TypeScript checks a custom element converted to a module. r=Standard8 DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339724\n", "files": ["docs/code-quality/typescript/bestPractices.md"], "git_node": "fb105582ffa80c3bbd774f909e8dbaf59aa37294", "git_parents": ["21aaff13a65f71a2b4754315556e51d1333acca5"], "node": "a78b1139c2307c42bd62288ec534a44bb2efa834", "parents": ["17756bcf480fcebb22aff650befe9a96fd9c451a"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088634 - Don't let a malformed granular override pref prevent the other one from being imported. r=timhuang\n\nFingerprintingWebCompatService imports the baseline and the FPP granular\noverride prefs in one loop. If the first of them failed to parse, or was not\nan array, the loop returned early and the second pref was silently ignored.\nSkip only the malformed pref instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339294\n", "files": ["toolkit/components/resistfingerprinting/FingerprintingWebCompatService.sys.mjs", "toolkit/components/resistfingerprinting/tests/browser/browser_fingerprintingRemoteOverrides.js"], "git_node": "b2850a6df28f94aac8552c988c42a05a49cc9660", "git_parents": ["fb105582ffa80c3bbd774f909e8dbaf59aa37294"], "node": "49e6e7a98c1ddd58d0be2047f70495d2720dbf44", "parents": ["a78b1139c2307c42bd62288ec534a44bb2efa834"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088634 - Ignore whitespace around entries in the fingerprinting protection overrides. r=timhuang\n\nCreateOverridesFromText split the overrides on ',' and required each entry to\nstart with '+' or '-', so a hand-written value such as \"+A, -B\" silently\ndropped every entry after the first. Trim whitespace around each entry and\nskip empty entries. This applies to the global overrides prefs as well as to\ngranular overrides, which share the parser.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339295\n", "files": ["toolkit/components/resistfingerprinting/nsRFPService.cpp", "toolkit/components/resistfingerprinting/tests/xpcshell/test_fpp_overrides_parsing.js", "toolkit/components/resistfingerprinting/tests/xpcshell/xpcshell.toml"], "git_node": "1920fd3badea65f09c02345b5dee614cb4ce8f99", "git_parents": ["b2850a6df28f94aac8552c988c42a05a49cc9660"], "node": "7300500bc90061c63a41f2dc29df9ef29d7756da", "parents": ["49e6e7a98c1ddd58d0be2047f70495d2720dbf44"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088634 - Actually validate granular fingerprinting overrides against their schema. r=timhuang\n\nThe schema was passed to JsonSchema.Validator as a JSON string rather than an\nobject. The validator then sees no constraints, so every entry in the\ngranular overrides prefs was accepted, including malformed ones.\n\nPass the schema as an object. Doing that alone would have rejected valid\nentries, because the domain pattern did not accept the bare '*' wildcard,\nTLDs longer than six characters, or IDN TLDs in punycode form, so fix the\npattern as well. An empty thirdPartyDomain is accepted, since it is treated\nthe same as an absent one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339296\n", "files": ["toolkit/components/resistfingerprinting/FingerprintingWebCompatService.sys.mjs", "toolkit/components/resistfingerprinting/tests/browser/browser_fingerprintingRemoteOverrides.js"], "git_node": "9906cd6e2aafb7d428e336fdd6047461d72ca03e", "git_parents": ["1920fd3badea65f09c02345b5dee614cb4ce8f99"], "node": "fc2b20e1253ee66870294a80e16c336ce6b0af0f", "parents": ["7300500bc90061c63a41f2dc29df9ef29d7756da"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088634 - Recompute granular fingerprinting overrides when the global overrides change. r=timhuang\n\nEach granular override is applied on top of the global set of enabled targets\n(FPP or baseline), which already includes the global overrides pref. That\nresult was computed once, when the granular overrides were imported, so a\nlater change to privacy.fingerprintingProtection.overrides or\nprivacy.baselineFingerprintingProtection.overrides (by the user, or by a Nimbus\nenrollment mid-session) left the granular overrides based on the old global\nset until the next Remote Settings sync or granular pref change.\n\nFingerprintingWebCompatService already retains all the overrides it imported,\nso when either global overrides pref changes, have nsRFPService ask it to send\nthem again after the global sets are updated. nsRFPService drives this, rather\nthan the service observing the prefs itself, so that the global sets are\nguaranteed to be updated first. This adds no new state to nsRFPService.\n\nWhile here, read the overrides out of the JS-implemented\nnsIFingerprintingOverride objects before taking\nsEnabledFingerprintingProtectionsMutex, so we no longer call into JS while\nholding it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339297\n", "files": ["toolkit/components/resistfingerprinting/FingerprintingWebCompatService.sys.mjs", "toolkit/components/resistfingerprinting/nsIFingerprintingWebCompatService.idl", "toolkit/components/resistfingerprinting/nsRFPService.cpp", "toolkit/components/resistfingerprinting/tests/browser/browser_fingerprintingRemoteOverrides.js"], "git_node": "0e7807a13aec44ff63e8a4c3ae2578fc49b6b843", "git_parents": ["9906cd6e2aafb7d428e336fdd6047461d72ca03e"], "node": "8fe6d0eb02ba295cfff46dade4bd320ab9dc1122", "parents": ["fc2b20e1253ee66870294a80e16c336ce6b0af0f"], "tags": []}, {"author": "Goutam Tamvada \u003cgtamvada@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088195 - Remove EV treatment from Amazon roots. r=keeler\n\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=0de903b90fa1e8b89f24d14026c4acc7788db395\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340006\n", "files": ["security/certverifier/ExtendedValidation.cpp"], "git_node": "628f9255db5d8c49b2113694293dc953deba98d4", "git_parents": ["0e7807a13aec44ff63e8a4c3ae2578fc49b6b843"], "node": "c1acfc5e0056ab2711f34f72b698073924a45efa", "parents": ["8fe6d0eb02ba295cfff46dade4bd320ab9dc1122"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089222 - Use full width buttons at smallest card-stack breakpoint r=omc-reviewers,nbarrett,andhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339735\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "7d2bddcd34c3efb3c8971539664439755fdf3a47", "git_parents": ["628f9255d