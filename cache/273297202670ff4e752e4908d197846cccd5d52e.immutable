r_policy_firefoxhome.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_disabled_both_off.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_disabled_tabs_on.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_disabled_windows_on.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home_firefox_logo.js", "browser/components/search/content/contentSearchHandoffUI.css", "toolkit/components/extensions/test/browser/browser_ext_themes_ntp_colors.js", "toolkit/components/extensions/test/browser/browser_ext_themes_ntp_colors_perwindow.js", "toolkit/components/nimbus/test/unit/test_bug2054546.js"], "git_node": "2d75683e18caa194ef4f474ad0461face5ffdcb7", "git_parents": ["f612f4a72980aeb8d7a868d53534ad698b2ee602"], "node": "930dfc8b5811cf7f8fd6936db04b953ddbe23281", "parents": ["1137460458364499c6788a3f8ac9836a086bb04b"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091785 - Part 3: Lock browser.newtabpage.activity-stream.nova.enabled to true r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341879\n", "files": ["browser/app/profile/firefox.js"], "git_node": "54e31fc4a93c7982f7e2bbb770eaaba6f1701ba6", "git_parents": ["2d75683e18caa194ef4f474ad0461face5ffdcb7"], "node": "69d61a33d2a9cfeddc38d850991c58c81f8442d5", "parents": ["930dfc8b5811cf7f8fd6936db04b953ddbe23281"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092557 - Remove the safe-browsing permissions test_reporturl.html grants by ignoring the warning, r=firefox-desktop-core-reviewers ,Gijs.\n\nThe session permission for http://itisaphishingsite.org let a repeated run's load past the classifier, so HTTPS-First upgraded it and the https URL got blocked and reported instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342606\n", "files": ["toolkit/components/url-classifier/tests/mochitest/test_reporturl.html"], "git_node": "ce4a3b1a42370737aa4439bf3573eff4219a5834", "git_parents": ["54e31fc4a93c7982f7e2bbb770eaaba6f1701ba6"], "node": "3f540658b00a88d89efa8f38c0fa2ce7274dd55b", "parents": ["69d61a33d2a9cfeddc38d850991c58c81f8442d5"], "tags": []}, {"author": "Evann-404 \u003cevannperennou99@gmail.com\u003e", "branch": "default", "desc": "Bug 2089978 - Initialize decodingErrors before DecodeSCTs increments it. r=jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342058\n", "files": ["security/certverifier/NSSCertDBTrustDomain.cpp"], "git_node": "ec06bd552b9bbd9035b9a7b85c85fc4251d86082", "git_parents": ["ce4a3b1a42370737aa4439bf3573eff4219a5834"], "node": "1b7b813790d90e6bea996a862d9c79559af69647", "parents": ["3f540658b00a88d89efa8f38c0fa2ce7274dd55b"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092617 - Part 1. Disable VP9 quality scaling when sending several spatial layers. r=webrtc-reviewers,pehrsons\n\nlibwebrtc's quality scaler does not support several spatial layers, and asserts\nin VideoStreamEncoder when it is enabled for them. libwebrtc's own\nWebRtcVideoEngine disables it the same way.\n\nVP9 now also follows VP8 and disables quality scaling for screensharing and\nsimulcast.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342668\n", "files": ["dom/media/webrtc/libwebrtcglue/VideoConduit.cpp"], "git_node": "930cb2f5737a17ca97966b2c3bbea84399a1d681", "git_parents": ["ec06bd552b9bbd9035b9a7b85c85fc4251d86082"], "node": "eea71ec03fc5927913424ed9775269956d7eb93a", "parents": ["1b7b813790d90e6bea996a862d9c79559af69647"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092617 - Part 2. Allow MediaCodec through FFmpeg to decode VP9 in WebRTC on Android. r=media-playback-reviewers,alwu\n\nlibwebrtc concatenates the spatial layers of a VP9 SVC frame without a\nsuperframe index. MediaCodec decodes them and outputs the top layer, but ffvpx\ndecodes only the lowest layer, and ffmpeg's VA-API and Vulkan hwaccels output\ncorrupt frames, so low latency VP9 still does not use those.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342669\n", "files": ["dom/media/platforms/ffmpeg/FFmpegDecoderModule.h"], "git_node": "3faf8ae1759e2321881126318ec1b4199a126e77", "git_parents": ["930cb2f5737a17ca97966b2c3bbea84399a1d681"], "node": "3a1ea34c6fbcecdc8dfd1124290b475ce12efb6e", "parents": ["eea71ec03fc5927913424ed9775269956d7eb93a"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092617 - Part 3. Size Java MediaCodec video frames from the codec's output format. r=media-playback-reviewers,alwu\n\nThe size was taken from the sample's VideoInfo, which for VP9 is read from the\nfirst frame of a keyframe. With spatial layers that is the lowest layer, so the\nhigher layers were labelled with its size.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342670\n", "files": ["dom/media/platforms/android/RemoteDataDecoder.cpp", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/FormatParam.java"], "git_node": "4e84d46e08bf8c3fbd98426be800ad568328e599", "git_parents": ["3faf8ae1759e2321881126318ec1b4199a126e77"], "node": "60290a438337f11f6082feca9144b4c2bd62fa39", "parents": ["3a1ea34c6fbcecdc8dfd1124290b475ce12efb6e"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092617 - Part 4. Add a mochitest for receiving VP9 with spatial layers. r=webrtc-reviewers,pehrsons\n\nIt sends the layer configurations from bug 1832276 and bug 1858904, and checks\nthat the top layer is shown with the size and content that were sent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342672\n", "files": ["dom/media/webrtc/tests/mochitests/mochitest_peerconnection.toml", "dom/media/webrtc/tests/mochitests/test_peerConnection_vp9SpatialLayers.html", "dom/media/webrtc/tests/mochitests/test_peerConnection_vp9SpatialLayersKeyFrame.html"], "git_node": "5e9cd4194e59abd743ad8373253fe24ac87408f7", "git_parents": ["4e84d46e08bf8c3fbd98426be800ad568328e599"], "node": "313af7d8550f7968563f639c4aca07103c347e9c", "parents": ["60290a438337f11f6082feca9144b4c2bd62fa39"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2092617: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/media/platforms/android/RemoteDataDecoder.cpp"], "git_node": "24091d3b38fb6a2a7d6b4ee56f129a0ac8c177f3", "git_parents": ["5e9cd4194e59abd743ad8373253fe24ac87408f7"], "node": "338288b831bf98b2735b6a6d55cad9d18fdde509", "parents": ["313af7d8550f7968563f639c4aca07103c347e9c"], "tags": []}, {"author": "yazan \u003cyalmacki@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072317 - Allow infobars to show in private browsing windows. r=omc-reviewers,mimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338381\n", "files": ["browser/components/asrouter/modules/InfoBar.sys.mjs", "browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_infobar.js"], "git_node": "d877986b287ffa9e064b615d68fe4e68fbb65b4b", "git_parents": ["24091d3b38fb6a2a7d6b4ee56f129a0ac8c177f3"], "node": "379a2949dfbb6ffc37d665943e765c03850eb582", "parents": ["338288b831bf98b2735b6a6d55cad9d18fdde509"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 2b7015312861343734bbdf21b286cfb57d593493\naf -\u003e 2b7015312861343734bbdf21b286cfb57d593493\nan -\u003e 2b7015312861343734b