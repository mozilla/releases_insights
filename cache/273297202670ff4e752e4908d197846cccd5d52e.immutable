54deab531b9e99d687bd8\nmr -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nms -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nmy -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nnb-NO -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nne-NP -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nnl -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nnn-NO -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\noc -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\npa-IN -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\npl -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\npt-BR -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\npt-PT -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nrm -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nro -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nru -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nsk -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nsl -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nson -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nsq -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nsr -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nsv-SE -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nta -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nte -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nth -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\ntl -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\ntr -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\ntrs -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nuk -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nur -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nuz -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nvi -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nwo -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nxh -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nzam -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nzh-CN -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\nzh-TW -\u003e f115bfa683f50eb19be54deab531b9e99d687bd8\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "0d4be4251216f9281351520311af17110068d3b5", "git_parents": ["42d2af0902eea6cda694dc25a6c06eed415f7c3e"], "node": "4c9a8ff8f6be95243cd88b4deda7649d08217145", "parents": ["b3e70480a147d8283db35962f1cabdbd241db453"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072920 - Pass the base revision run-task derives to the GitHub decision task r=ahal,taskgraph-reviewers,releng-reviewers\n\nTaskgraph's run-task replaces the base GitHub reports with the merge base\nand exports it as `GECKO_BASE_REV`, so the decision command reads that\nvariable instead of the event value. `GECKO_BASE_REF` lets run-task\ncompare a pull request against its own target, and also fills in the\n`base_ref` parameter.\n\nThe GitHub decision task runs the run-task baked into the `gecko_decision`\nimage, so this takes effect once that image is rebuilt with taskgraph\n24.8.0.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327526\n", "files": [".taskcluster.yml"], "git_node": "0f4bdceca3ecb11131b46456fc8cf3e53a28756f", "git_parents": ["0d4be4251216f9281351520311af17110068d3b5"], "node": "d7dbea5ac7e86126437596144e5cf19e8a5c52ec", "parents": ["4c9a8ff8f6be95243cd88b4deda7649d08217145"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072920 - Run clang-tidy on the files the decision task found changed r=ahal,taskgraph-reviewers\n\nOn a shallow git clone, `--outgoing` lists the whole tree, so clang-tidy\nran into its time limit or reported warnings in files the patch never\ntouched. Git decision tasks now pass the changed files that match the\ntask's `files-changed` patterns through `CHANGED_FILES`. Mercurial\ndecision tasks keep `--outgoing`, which works there.\n\nHeaders join the patterns because the patterns now also pick the files\nto analyze, so pushes that only change headers schedule clang-tidy too.\nA file list too long for one environment variable is dropped, and the\ntask writes an empty result.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327529\n", "files": ["taskcluster/gecko_taskgraph/test/python.toml", "taskcluster/gecko_taskgraph/test/test_transforms_source_test.py", "taskcluster/gecko_taskgraph/transforms/source_test.py", "taskcluster/kinds/source-test/clang.yml"], "git_node": "5338834a56621ee49dea03ab53e8ed0ab24c9f02", "git_parents": ["0f4bdceca3ecb11131b46456fc8cf3e53a28756f"], "node": "1b4d6f6a7bf0ca2ea86f0cf22313377396bc4b8c", "parents": ["d7dbea5ac7e86126437596144e5cf19e8a5c52ec"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Run the clang-tidy source-test tasks from a git checkout, r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341074\n", "files": ["taskcluster/kinds/source-test/clang.yml"], "git_node": "c936583599acc53dd0217cb9c8ab12bf2bea5d14", "git_parents": ["5338834a56621ee49dea03ab53e8ed0ab24c9f02"], "node": "7a7a3836379b3cd6f8716bdf144268a301afab6a", "parents": ["1b4d6f6a7bf0ca2ea86f0cf22313377396bc4b8c"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080905 - Report the actual date range for imported history. r=jhirsch,migration-reviewers,fluent-reviewers,bolsson,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340196\n", "files": ["browser/components/migration/MigrationUtils.sys.mjs", "browser/components/migration/MigrationWizardParent.sys.mjs", "browser/components/migration/MigratorBase.sys.mjs", "browser/components/migration/tests/unit/test_Chrome_history.js", "browser/components/migration/tests/unit/test_Safari_history.js", "browser/locales/en-US/browser/migrationWizard.ftl"], "git_node": "b148caa4468824f004d42fa94459bed0d38cca31", "git_parents": ["c936583599acc53dd0217cb9c8ab12bf2bea5d14"], "node": "51063f56cff9a51e82939f1391f9fed03ee23dce", "parents": ["7a7a3836379b3cd6f8716bdf144268a301afab6a"], "tags": []}, {"author": "Matt Cleinman \u003c9295855+mcleinman@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2088239 - Add confirmation message when user has set Firefox as default r=ip-protection-reviewers,fluent-reviewers,flod,rking\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341639\n", "files": ["browser/app/profile/firefox.js", "browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/content/ipprotection-content.mjs", "browser/components/ipprotection/content/ipprotection-message-bar.mjs", "browser/components/ipprotection/tests/browser/browser.toml", "browser/components/ipprotection/tests/browser/browser_ipprotection_extra_locations_confirmation_message.js", "browser/locales/en-US/browser/ipProtection.ftl", "toolkit/components/ipprotection/docs/Preferences.md"], "git_node": "7d4eed57631dc3d75833097917d011e42a6dc590", "git_parents": ["b148caa4468824f004d42fa94459bed0d38cca31"], "node": "0c8ea3b15cc8efa1a646ca0ebbc60d9ef3dd8832", "parents": ["51063f56cff9a51e82939f1391f9fed03ee23dce"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2092063 - Part 1: Don't keep hidden scrollbars up to date. r=layout-reviewers,emilio\n\nPushing the position, maximum position and page increment into a hidden\nscrollbar dirties its slider, and toggling its enabled state restyles it, even\nthough none of that is observable. So e.g. every showModal() of a dialog with\nnothing to scroll needed another style and layout flush.\n\nShowing a scrollbar always goes through LayoutScrollbars(), whose reflow\ncallback brings it up to date, so hidden scrollbars can just be skipped.\nScrollbarCurPosChanged() now ignores their stale position, which would\notherwise scroll that axis back to it.\n\nscrollbar-gutter-reflow-counts-001.html measured each case right after the\nother with the same geometry, so the reference run reshowed a scrollbar that\nstill had the values it needed, and skipped the slider reflow the\nscrollbar-gutter run had to pay. It now rebuilds the scroll container between\nmeasurements, as the writing-mode cases already did.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343894\n", "files": ["layout/generic/ScrollContainerFrame.cpp", "layout/generic/ScrollContainerFrame.h", "testing/web-platform/mozilla/tests/css/css-overflow/scrollbar-gutter-reflow-counts-001.html"], "git_node": "4bb1140881bbff098544f1f7dd68c3505ecf0a6d", "git_parents": ["7d4eed57631dc3d75833097917d011e42a6dc590"], "node": "88e26fbcdc0a33aeea03160e4c2858d54ed2fe59", "parents": ["0c8ea3b15cc8efa1a646ca0ebbc60d9ef3dd8832"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2092063 - Part 2: Treat hidden scrollbar parts like content-visibility: hidden content. r=layout-reviewers,emilio\n\nHidden scrollbars, and the scroll corner unless both scrollbars are shown (it\ncan't take up any space otherwise), used to be reflowed with an empty rect every\ntime the scrollbars were laid out.\n\nLike content hidden by content-visibility, they're now neither reflowed nor\npainted, and keep their dirty bits until they're shown, which reflows them. They\njust get their empty rect, without the overflow left over from when they were\nlast shown. IsScrollbarPartShown() is the one place that decides what's shown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336563\n", "files": ["layout/generic/ScrollContainerFrame.cpp", "layout/generic/ScrollContainerFrame.h"], "git_node": "6f3c02233b35fdd00a025d4e83f85ca214cfa200", "git_parents": ["4bb1140881bbff098544f1f7dd68c3505ecf0a6d"], "node": "ef5536b86084514b31a988df8a6d5b444c506900", "parents": ["88e26fbcdc0a33aeea03160e4c2858d54ed2fe59"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092208 - Enable Smart Window single page onboarding and auto model by default r=pdahiya,settings-reviewers,Gijs\n\n- Keep legacy onboarding tests explicitly opted out\n- Update settings tests to find model radios by l10n ID and handle the new display order\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343692\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_firstrun.js", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window_model_selection.js", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window_model_selection_custom.js", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window_model_settings_custom.js", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window_telemetry.js", "browser/components/preferences/tests/aiFeatures/head_smart_window.js"], "git_node": "1dd9f21c14592d274d6f38e4d1f0a34acd547925", "git_parents": ["6f3c02233b35fdd00a025d4e83f85ca214cfa200"], "node": "9ef7680d5a35877ffe9e7f98e71db0dbfe8a5f96", "parents": ["ef5536b86084514b31a988df8a6d5b444c506900"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089475 - Remove the LoginHelper.createLogger call of test_login_autocomplete_result.js. r=credential-management-reviewers,mtigley\n\nThe test called LoginHelper.createLogger for a side effect, not for the\nconsole it returns: createLogger used to register the observer that\nrefreshes the signon.* prefs LoginHelper caches, and the test changes\nsome of them. Bug 1304001 moved that observer to LoginHelper.init(), so\nthe call has done nothing for the test since.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339840\n", "files": ["toolkit/components/passwordmgr/test/unit/test_login_autocomplete_result.js"], "git_node": "b212036ae6af138f297301ddb90966e89f67465c", "git_parents": ["1dd9f21c14592d274d6f38e4d1f0a34acd547925"], "node": "d0d525d10ca35d1497c94b98138609385f7b41cd", "parents": ["9ef7680d5a35877ffe9e7f98e71db0dbfe8a5f96"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2092063 - Part 2: Treat hidden scrollbar parts like content-visibility: hidden content. r=layout-reviewers,emilio\" for causing multiple failures at \\ScrollContainerFrame.cpp\n\nThis reverts commit 6f3c02233b35fdd00a025d4e83f85ca214cfa200.\n\nRevert \"Bug 2092063 - Part 1: Don't keep hidden scrollbars up to date. r=layout-reviewers,emilio\"\n\nThis reverts commit 4bb1140881bbff098544f1f7dd68c3505ecf0a6d.\n", "files": ["layout/generic/ScrollContainerFrame.cpp", "layout/generic/ScrollContainerFrame.h", "testing/web-platform/mozilla/tests/css/css-overflow/scrollbar-gutter-reflow-counts-001.html"], "git_node": "b8fda413ab9bc37d3bd54198208a64041b304772", "git_parents": ["b212036ae6af138f297301ddb90966e89f67465c"], "node": "b71c75512b4936d35951f925eb2a61ef6ee31cdf", "parents": ["d0d525d10ca35d1497c94b98138609385f7b41cd"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093423 - Show \"saved\" instead of \"\u2022\u2022\u2022\" for cards with a saved security code in settings. r=mtigley,fluent-reviewers,credential-management-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343678\n", "files": ["browser/extensions/formautofill/content/manageDialog.mjs", "browser/extensions/formautofill/test/browser/browser_creditCard_primaryPassword.js", "browser/extensions/formautofill/test/browser/creditCard/browser_manageCreditCardsDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_paymentsList_cvv.js", "browser/locales/en-US/browser/preferences/preferences.ftl", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/locales/en-US/toolkit/payments/payments.ftl"], "git_node": "b244bce9588ab5f50e242b1289cbed39ba62e1b2", "git_parents": ["b8fda413ab9bc37d3bd54198208a64041b304772"], "node": "f01fefe9720ddc12c74d2a480035bc68570d57de", "parents": ["b71c75512b4936d35951f925eb2a61ef6ee31cdf"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085889 - Send Sec-Speculation-Tags on speculation-rules prefetch requests. r=necko-reviewers,sunil\n\nThe header is re-evaluated on every redirect and only sent to destinations that\nare same-site with the referring document, as the speculation-tags WPTs expect.\nThe prefetch spec compares with the prefetch record's URL instead, which would\nalso tag cross-site prefetches.\n\nThe cross-site WPTs can't reach their tag checks yet, because cross-site\nprefetches aren't used, so a browser test covers the redirect behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338426\n", "files": ["dom/base/test/browser.toml", "dom/base/test/browser_speculation_tags_redirect.js", "dom/base/test/file_pageload_prefetch_source.html", "dom/base/test/file_speculation_tags_redirect.sjs", "dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/PrefetchRecordParent.h", "testing/web-platform/meta/speculation-rules/speculation-tags/deduped-and-sorted-tags.https.html.ini", "testing/web-platform/meta/speculation-rules/speculation-tags/invalid-tags.https.html.ini", "testing/web-platform/meta/speculation-rules/speculation-tags/no-tags.https.html.ini", "testing/web-platform/meta/speculation-rules/speculation-tags/prefetch-eagerness-pointer-down.https.html.ini", "testing/web-platform/meta/speculation-rules/speculation-tags/prefetch-eagerness-pointer-hover.https.html.ini", "testing/web-platform/meta/speculation-rules/speculation-tags/valid-tags.https.html.ini"], "git_node": "139ac237e57d94a717ee0bac90d394c214b2f29c", "git_parents": ["b244bce9588ab5f50e242b1289cbed39ba62e1b2"], "node": "e7e822b7b2d5f4fbb898a0cba9cc783be563e0d8", "parents": ["f01fefe9720ddc12c74d2a480035bc68570d57de"], "tags": []}, {"author": "Justin Link \u003cjlink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093892 - Use megamorphic cache hits for property keys that JIT code can't atomize inline. r=spidermonkey-reviewers,mgaudet\n\nWhen JIT code can't atomize a property key inline, for example a string built\nby concatenation, it calls GetNativeDataPropertyByValuePure without a cache\nentry. The function then found the entry itself but ignored whether it was\nvalid, and always redid the full lookup and refilled the entry.\n\nShare the cache-hit handling of GetNativeDataPropertyPureWithCacheLookup and\nuse it here too.\n\nMeasured locally with temporary counters on one JetStream 3 run: about 19.6M\nof these lookups found the cache slot already holding a valid, identical entry,\nmostly from WSL's `visitor[\"visit\" + name]` dispatch. The call into C++ and the\nkey's atomization still happen.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343599\n", "files": ["js/src/jit-test/tests/cacheir/megamorphic-getelem-non-atom-key.js", "js/src/jit/VMFunctions.cpp"], "git_node": "eac38adab04aa3f42789ce7a05b3413fac14e39e", "git_parents": ["139ac237e57d94a717ee0bac90d394c214b2f29c"], "node": "ca8ab738e9685f67a32cce96a689251a902d9956", "parents": ["e7e822b7b2d5f4fbb898a0cba9cc783be563e0d8"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2094504 - Remove unused passwordsEncryptionKeyGenerated preference from Fenix Settings r=android-reviewers,Roger\n\n- Orphaned since the 2021 logins API update moved key management into android-components\n- Remove the preference key string and its detekt baseline entry\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343836\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/config/detekt-baseline.xml"], "git_node": "9e84fe160ebada25f30ab7de76bde02fd7ddd049", "git_parents": ["eac38adab04aa3f42789ce7a05b3413fac14e39e"], "node": "703550cd4ca78c907e385c74964461eabae0cbbf", "parents": ["ca8ab738e9685f67a32cce96a689251a902d9956"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2089252 - Test copyExternalImageToTexture from cropped and previously drawn unpremultiplied ImageBitmaps. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339752\n", "files": ["dom/webgpu/tests/mochitest/test_queue_copyExternalImageToTexture_imagebitmap.html"], "git_node": "d7649c761f42eedfd7d0e45e9bfd6826b1d1f300", "git_parents": ["9e84fe160ebada25f30ab7de76bde02fd7ddd049"], "node": "a125df95517783976eaa664301591619d10040e5", "parents": ["703550cd4ca78c907e385c74964461eabae0cbbf"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2089252 - Crop unpremultiplied ImageBitmaps without premultiplying in ImageBitmap::SurfaceFrom. r=gfx-reviewers,bradwerth\n\nPreviously, the surface returned by ImageBitmap::SurfaceFrom() was\npremultiplied whenever the bitmap was cropped or had been drawn before,\neven when the bitmap is unpremultiplied and SFE_ALLOW_NON_PREMULT asks to\nkeep it so. In those cases SurfaceFrom() went through\nPrepareForDrawTarget(), whose result and cache are premultiplied.\n\nThis patch lets SurfaceFrom() return the unpremultiplied image when\nallowed, cropping it with CropAndCopyDataSourceSurface() when needed.\nCropAndCopyDataSourceSurface() now keeps the channel order of its source\ninstead of always labelling the copy BGRA, so RGBA and RGBX sources\nbecome RGBA and XRGB becomes ARGB.\n\nSurfaceFrom() also no longer returns the cached surface only because one\nexists.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339753\n", "files": ["dom/canvas/ImageBitmap.cpp"], "git_node": "0715c0d16a834c625acb447bed59b0c7707256f8", "git_parents": ["d7649c761f42eedfd7d0e45e9bfd6826b1d1f300"], "node": "90711ff4553aad0c2b41325652aa742ef1a0446b", "parents": ["a125df95517783976eaa664301591619d10040e5"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092623 - Advance onboarding only when sync sign in completes r=twhite\n\nSelecting \"Sign in\" on the onboarding sync sign in card opened `TurnOnSyncFragment` and also called scrollToNextPageOrDismiss() immediately. This ran `OnboardingFragment.onFinish` before sign in had completed, but it returned early because `TurnOnSyncFragment` was the current destination. As soon as the account was connected, the sign in `LaunchedEffect` in `OnboardingScreen` called `OnboardingFragment.onFinish` another time, resulting in a delayed navigation to the home screen.\n\nThis patch applies the same handling as bug 2092151. The sign in click no longer advances onboarding. Instead, `TurnOnSyncFragment` reports completion when it closes with an authenticated account and `SyncFlowCompletedEffect` moves to the next page once and consumes the result.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/454\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/TurnOnSyncFragment.kt"], "git_node": "21b577bd7928ba2f33a3ad61b0a402c26b4dd9e6", "git_parents": ["0715c0d16a834c625acb447bed59b0c7707256f8"], "node": "c5f7ef02b2462f5bd943830e2f81a1aacb281be3", "parents": ["90711ff4553aad0c2b41325652aa742ef1a0446b"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2090263 - Don't navigate to settings panes that aren't visible. r=settings-reviewers,hjones\n\ngotoPref now falls back to the default pane when a pane or any of its\nparents has a visible() that returns false. Use this to hide the Smart\nWindow sub-panes when browser.smartwindow.enabled is false.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340494\n", "files": ["browser/components/preferences/config/SettingPaneManager.mjs", "browser/components/preferences/preferences.js", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window.js"], "git_node": "5d3e13543bb0710a7a5ab99cfac85c6306a445b5", "git_parents": ["21b577bd7928ba2f33a3ad61b0a402c26b4dd9e6"], "node": "e2da7a37f798367d03c15745f34fdaad20c7d9f3", "parents": ["c5f7ef02b2462f5bd943830e2f81a1aacb281be3"], "tags": []}], "date": 1795038692, "git_changesets": ["2fe4fc61f30df5500491f38174150200d521ef26", "3475e91821f9f114bdd727d9f33469249a16a027", "47258fc4f23acec560425b96838f2622c089a205", "7a0de2a674cae63401e274da26f799aff9d5e831", "c22eae1675a13aacbc6d8e8d0fcaf78e8fa52ad5", "0dfef4f35d1b71e132805d807abb1879a2ebe919", "5964b761f29594908e6508eb9cf55e3d3c9739c0", "666b50fe9b3e8dd3184f5df6017b083bdf1e074f", "55bc3d2ff5eb3c01b2cb79e4a9124240bc8a110e", "3bc8c21c2e2eb228629e989a7cfcce135b3283f0", "9459fe0cd49610da32a222429fd3ca991198a4e8", "3a9f31444f21808a9cdf43298bf08da36abfb1c7", "446d43ccf8ffa247646b7701729a8076a32b17df", "2a7ddea144aa307a49cb17f85a7557bb19033c64", "16014be93687ae63f09edbd5292e88bd22a16b8a", "dd3ac914b171443124a3a96f3cf63ac096e3251c", "2a32a4bcfcd2098c55fab7b32d304499374fdc7a", "f89708ea8db8a2eebd8cbf0c1bb0b33460448607", "b26cd5d304e8f1c1d462b2a07358207a01f75ead", "2dce442b0b403d8cbe45a68e3169197a6cb0db08", "01de21fa659ace7bd438eae0a9268b84bd3a2d5d", "5d9b9d22f18bf6a95c3923a65f0f2ec3e3b83751", "c0d9095c8ad3483b90a8da6c54ab904224e767df", "69a205e087c3bc76ac8e61e334f3271ae208fbac", "eb1ba7bbc9069339b1297c039269aabc4a58111d", "1a65827e5f8e12cdc93f83c63f8196d21a8cb7c7", "7b75dbb72e3ef1901ba45baf4ddfafe69e239355", "07cfcf439bdbe95b32692da7422ef19c05f3542c", "1234d3e44a9f8d085c779806ef4e1d04dd046afe", "5c4305b03b44ee15290eb584a537828b74311042", "54c3da237ec6743b99afcd6a96cf7b6e41e2025a", "78d0c68ce83592b5ca18f06df579c62941b40415", "2f54069bf1a047c5ee8baa4acedadecb8b5fc097", "228efbe9cb730b52fa68d4db925cf66f5e8ba48d", "5b23e94ad2db00cf61e73527ef4e6cf1c6e29bf3", "75c4c2d2d4b447b08eb0afd0600168dd9a41662b", "0b12b2b2917568ac72dea4874e133bdf5bcf6dec", "f05287060858982da60db05ed2c54cc5280657a2", "f470a1a9960485bdce48f574711c1257d3657a6f", "c356b554bd261d8d6f0bfb76b871143395a57811", "cd0cd7f8d482ad979fb58aa3e39cf92a6bb36e8e", "785550425977bc43b90253d33dfef278c9e95f0f", "c41e3aacceb3ae9289113248f08f4cf8b617e31d", "4c8a5ae20d3ef9e37417d4b5d41d78d0c4f0b75e", "42d2af0902eea6cda694dc25a6c06eed415f7c3e", "0d4be4251216f9281351520311af17110068d3b5", "0f4bdceca3ecb11131b46456fc8cf3e53a28756f", "5338834a56621ee49dea03ab53e8ed0ab24c9f02", "c936583599acc53dd0217cb9c8ab12bf2bea5d14", "b148caa4468824f004d42fa94459bed0d38cca31", "7d4eed57631dc3d75833097917d011e42a6dc590", "4bb1140881bbff098544f1f7dd68c3505ecf0a6d", "6f3c02233b35fdd00a025d4e83f85ca214cfa200", "1dd9f21c14592d274d6f38e4d1f0a34acd547925", "b212036ae6af138f297301ddb90966e89f67465c", "b8fda413ab9bc37d3bd54198208a64041b304772", "b244bce9588ab5f50e242b1289cbed39ba62e1b2", "139ac237e57d94a717ee0bac90d394c214b2f29c", "eac38adab04aa3f42789ce7a05b3413fac14e39e", "9e84fe160ebada25f30ab7de76bde02fd7ddd049", "d7649c761f42eedfd7d0e45e9bfd6826b1d1f300", "0715c0d16a834c625acb447bed59b0c7707256f8", "21b577bd7928ba2f33a3ad61b0a402c26b4dd9e6", "5d3e13543bb0710a7a5ab99cfac85c6306a445b5"], "user": "asilaghi@mozilla.com"}, "45826": {"changesets": [{"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083581 - Also check HTTPS endpoint to confirm locked captive portal r=necko-reviewers,sunil,extension-reviewers,robwu\" at Valentin dev request\n\nThis reverts commit 7750f742b9433767f2ffa57ba81235e11fc9629e.\n", "files": ["modules/libpref/init/all.js", "netwerk/base/CaptivePortalService.cpp", "netwerk/base/nsICaptivePortalService.idl", "netwerk/test/unit/test_captive_portal_service.js", "testing/profiles/unittest-required/user.js", "testing/profiles/xpcshell/user.js", "toolkit/components/captivedetect/CaptiveDetect.sys.mjs", "toolkit/components/captivedetect/nsICaptivePortalDetector.idl", "toolkit/components/captivedetect/test/unit/test_captive_portal_https_check.js", "toolkit/components/captivedetect/test/unit/xpcshell.toml", "toolkit/components/extensions/test/xpcshell/test_ext_captivePortal.js", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "41b747af72d91784f78616056c2f1d6c17c01345", "git_parents": ["5d3e13543bb0710a7a5ab99cfac85c6306a445b5"], "node": "617788d3b48194556f8016cfc668b600843df3a1", "parents": ["e2da7a37f798367d03c15745f34fdaad20c7d9f3"], "tags": []}], "date": 1795038796, "git_changesets": ["41b747af72d91784f78616056c2f1d6c17c01345"], "user": "asilaghi@mozilla.com"}, "45827": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging b00bde68873aedb80bea5c3ff8eba8344b50d3b4 with FIREFOX-ANDROID_161_0_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "e41a45c4536d7c103773784b14987322e7a02036", "git_parents": ["ea21bdce342f525927f19aa93ebd7f856f5d25d8"], "node": "9e23b6bcd7a9866817e1ed4febbd41b02e472335", "parents": ["77dcc3ff80abc45a209d0b9127c8d7b3ce9dd58a"], "tags": []}], "date": 1795039339, "git_changesets": ["e41a45c4536d7c103773784b14987322e7a02036"], "user": "ffxbld@lando.moz.tools"}, "45828": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging b00bde68873aedb80bea5c3ff8eba8344b50d3b4 with FIREFOX_161_0_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "18c5b2f551c08b440e61d5a36e827e798a44378b", "git_parents": ["e41a45c4536d7c103773784b14987322e7a02036"], "node": "1e29f02e5da1f9f55c2896b7fbfb2d7dd1d79c8f", "parents": ["9e23b6bcd7a9866817e1ed4febbd41b02e472335"], "tags": []}], "date": 1795039400, "git_changesets": ["18c5b2f551c08b440e61d5a36e827e798a44378b"], "user": "ffxbld@lando.moz.tools"}, "45829": {"changesets": [{"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2078916 - Remove the no-fission mochitest variants on Android r=RyanVM,taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342775\n", "files": ["taskcluster/kinds/mochitest/kind.yml", "taskcluster/test_configs/variants.yml", "tools/tryselect/try_presets.yml"], "git_node": "4273e42920401d086e167b34e78d2d2a9065f378", "git_parents": ["5d3e13543bb0710a7a5ab99cfac85c6306a445b5"], "node": "53233d7a346f19cfd00cdbf21e4b6bb735c942cb", "parents": ["e2da7a37f798367d03c15745f34fdaad20c7d9f3"], "tags": []}, {"author": "cary \u003ccmurray@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091776 - Add suggestion feature telemetry to Smart Window resume cards. r=echa,cdipersio,pdahiya\n\nRecords each card's rank, memory strength, memory age, last visit age and\nmerged memory count on resume card actions and on a new\nresume_card_impression event, so clicked cards can be compared against\nevery card shown. Also records entrypoint on browser_action_prompt and\nbrowser_action_prompt_response, so resumed chats are identified without\nrelying on open_tabs being resume-only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341858\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/memories/journeys/JourneyManager.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_JourneyManager.js", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/components/smartwindow-resume-section/smartwindow-resume-section.mjs", "browser/components/aiwindow/ui/modules/ToolUI.sys.mjs", "browser/components/aiwindow/ui/modules/ToolUITelemetry.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_resume_card.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/aiwindow/ui/test/xpcshell/test_ToolUI.js"], "git_node": "2789e20a1c14362f60d00e85ca41b97f620e71cb", "git_parents": ["4273e42920401d086e167b34e78d2d2a9065f378"], "node": "18219e0533b554d418895ddb60e1419359791eab", "parents": ["53233d7a346f19cfd00cdbf21e4b6bb735c942cb"], "tags": []}, {"author": "Fahad Fayyaz \u003cffayyaz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089973 - Avoid leaking a copy of the prefixes in HashStore debug logging. r=timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343684\n", "files": ["toolkit/components/url-classifier/HashStore.cpp"], "git_node": "afd2a66a1d41c62b49d0c68be330168aedcbe50b", "git_parents": ["2789e20a1c14362f60d00e85ca41b97f620e71cb"], "node": "568bb563d23af7dfb2dc6765a4d228e19fa52319", "parents": ["18219e0533b554d418895ddb60e1419359791eab"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083581 - Also check HTTPS endpoint to confirm locked captive portal r=necko-reviewers,sunil,extension-reviewers,robwu\" at Valentin dev request\n\nThis reverts commit 7750f742b9433767f2ffa57ba81235e11fc9629e.\n", "files": ["modules/libpref/init/all.js", "netwerk/base/CaptivePortalService.cpp", "netwerk/base/nsICaptivePortalService.idl", "netwerk/test/unit/test_captive_portal_service.js", "testing/profiles/unittest-required/user.js", "testing/profiles/xpcshell/user.js", "toolkit/components/captivedetect/CaptiveDetect.sys.mjs", "toolkit/components/captivedetect/nsICaptivePortalDetector.idl", "toolkit/components/captivedetect/test/unit/test_captive_portal_https_check.js", "toolkit/components/captivedetect/test/unit/xpcshell.toml", "toolkit/components/extensions/test/xpcshell/test_ext_captivePortal.js", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "26bb1513ba399938a3ce34f99da4976359e8b48b", "git_parents": ["afd2a66a1d41c62b49d0c68be330168aedcbe50b"], "node": "648d634a1f84eeb81f3c1ad6487cabbcee2564c3", "parents": ["568bb563d23af7dfb2dc6765a4d228e19fa52319"], "tags": []}, {"author": "Alex G \u003cagain@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094207 - [Monitor Agent][Models] Only add the monitor chat prompt module when monitors are available r=tetchart\n\nModels side of the monitor follow-up chip (frontend side is bug 2093719).\n\nThe chat model should be able to offer a follow-up suggestion that creates a monitor for the page or topic being discussed. The instructions for this live in a new \"monitor\" chat prompt module in Remote Settings.\n\nThat module must only be part of the chat system prompt when monitors are available to the user, so adding region gating here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343615\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_chat_system_prompt.js"], "git_node": "46814069449d389a8a35f2a9f43f9c633f052121", "git_parents": ["26bb1513ba399938a3ce34f99da4976359e8b48b"], "node": "db7732878a3db323ed25726d12416d916c1e2f0e", "parents": ["648d634a1f84eeb81f3c1ad6487cabbcee2564c3"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094666 - update test expectation for paste.https.html.ini because it is passing on macOS. r=Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343968\n", "files": ["testing/web-platform/meta/editing/plaintext-only/paste.https.html.ini"], "git_node": "bc49d8e79cc2dcb08bf2906c50b432c2da87a437", "git_parents": ["46814069449d389a8a35f2a9f43f9c633f052121"], "node": "b3129b44f5d742829023acab20244921cf1f0198", "parents": ["db7732878a3db323ed25726d12416d916c1e2f0e"], "tags": []}, {"author": "yazan \u003cyalmacki@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094371 - Don't regenerate profile backups on cookie removal. r=hsohaney\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343746\n", "files": ["browser/components/backup/BackupService.sys.mjs", "browser/components/backup/metrics.yaml", "browser/components/backup/tests/xpcshell/test_BackupService_regeneration.js"], "git_node": "f2f4ae8c6e8528b9d1a5d4f47d0722a0c73be20f", "git_parents": ["bc49d8e79cc2dcb08bf2906c50b432c2da87a437"], "node": "4257111891f3927dedc6d3c0105479deaeafd37b", "parents": ["b3129b44f5d742829023acab20244921cf1f0198"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094665 - update wpt test expectations for paste-as-plaintext-data.tentative.https.html.ini because it is passing on macOS. r=Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343966\n", "files": ["testing/web-platform/meta/editing/other/paste-as-plaintext-data.tentative.https.html.ini"], "git_node": "277550281ec2fcc152319936f767743007e0caaf", "git_parents": ["f2f4ae8c6e8528b9d1a5d4f47d0722a0c73be20f"], "node": "a8ea2cd3118ec798538e8582bde7fa6d9dd57c6b", "parents": ["4257111891f3927dedc6d3c0105479deaeafd37b"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2094671 - Add --force-update to mach android nimbus-cli r=ahochheiden,geckoview-reviewers,android-build-system-reviewers,ohall\n\n`./mach android nimbus-cli --update` no longer run nimbus-cli after\nupdating.\n\n`./mach android nimbus-cli --force-update` can be used to force a\ndownload of the latest version.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343981\n", "files": ["mobile/android/mach_commands.py", "mobile/android/nimbus_cli.py"], "git_node": "1438185c91414f65e2505ab500cb2fa65d050967", "git_parents": ["277550281ec2fcc152319936f767743007e0caaf"], "node": "e547ff2c321bd717fc524b9c5fd7b2e74b3a0d4a", "parents": ["a8ea2cd3118ec798538e8582bde7fa6d9dd57c6b"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094592 - [devtools] Update MDN compat data for 162 cycle. r=devtools-reviewers,jdescottes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343909\n", "files": ["devtools/shared/compatibility/dataset/css-properties.json"], "git_node": "caed5c532d4d3315a4cccbe3a37f3cf11898db33", "git_parents": ["1438185c91414f65e2505ab500cb2fa65d050967"], "node": "a4aa2e0b9caf96c5aaf1dcf0a221b26a499990de", "parents": ["e547ff2c321bd717fc524b9c5fd7b2e74b3a0d4a"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094591 - [devtools] Update webidl-unsafe-getters-names.js. r=devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343905\n", "files": ["devtools/server/actors/webconsole/webidl-unsafe-getters-names.js"], "git_node": "5a32626a2efb30b9224ca505ed078dd782268cf3", "git_parents": ["caed5c532d4d3315a4cccbe3a37f3cf11898db33"], "node": "6b641524188f7b788ad6a87c31868da68d8f3e89", "parents": ["a4aa2e0b9caf96c5aaf1dcf0a221b26a499990de"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090689 - Add a desktop-theme skill that routes to the theme skills, and list those by name only. r=ai4dev-reviewers,padenot DONTBUILD\n\nIn a trial of fresh Opus sessions, the parent's description loaded a theme skill on as many theme reviews, open theme bugs and screenshot requests as the four subject descriptions did, and on none of the non-theme bugs. It saves about 1,100 bytes of skill descriptions in every session. Harnesses reading `.agents/skills` ignore `skillOverrides` and still list the subject descriptions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343449\n", "files": [".agents/skills/desktop-theme/SKILL.md", ".claude/settings.json", ".claude/skills/desktop-theme/SKILL.md"], "git_node": "04d86d4ddc06a6493ee8c64ea971e189047f23ee", "git_parents": ["5a32626a2efb30b9224ca505ed078dd782268cf3"], "node": "156f334ffc471a113f38660809712674b219d1b2", "parents": ["6b641524188f7b788ad6a87c31868da68d8f3e89"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090689 - Point agents at the desktop-theme skill from browser/themes/ and toolkit/themes/. r=ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343579\n", "files": ["AGENTS.md", "browser/themes/AGENTS.md", "browser/themes/CLAUDE.md", "toolkit/themes/AGENTS.md", "toolkit/themes/CLAUDE.md"], "git_node": "1530f63e34c8f739466b9f12d07f87870bf9b54f", "git_parents": ["04d86d4ddc06a6493ee8c64ea971e189047f23ee"], "node": "a05a4a362761859e448441ff974be2b68a21ea56", "parents": ["156f334ffc471a113f38660809712674b219d1b2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090683 - Prepare the desktop-theme skills for loading into code review. r=ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343520\n", "files": [".agents/skills/desktop-theme-probing/SKILL.md", ".agents/skills/desktop-theme/SKILL.md", ".claude/skills/desktop-theme-probing/SKILL.md", ".claude/skills/desktop-theme/SKILL.md"], "git_node": "747aff7889d72d1f63118c59c78682ffbc6ed43b", "git_parents": ["1530f63e34c8f739466b9f12d07f87870bf9b54f"], "node": "9f20227d58efdf722fc8a81df71d754e6fc2a8e1", "parents": ["a05a4a362761859e448441ff974be2b68a21ea56"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090683 - Load the desktop-theme colors, layout and tokens skills when reviewing theme and design-token files. r=ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343521\n", "files": ["review-context.toml"], "git_node": "8b683ce4593f86887bb8490f8051e9cfe26e17f2", "git_parents": ["747aff7889d72d1f63118c59c78682ffbc6ed43b"], "node": "e4d997a1b5d22270794f4a1318c1fa3019de8a20", "parents": ["9f20227d58efdf722fc8a81df71d754e6fc2a8e1"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094696 - Restore loading animation for RTAMO r=omc-reviewers,jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343998\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "252561af527b05813d3e86faaca3fe02a122399a", "git_parents": ["8b683ce4593f86887bb8490f8051e9cfe26e17f2"], "node": "bf3dbcece019652f3ffdfc97a2c349fb8427bf7a", "parents": ["e4d997a1b5d22270794f4a1318c1fa3019de8a20"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094356 - Send the Travel widget frame an interaction_state action so it can move its hero text clear of the New   badge. r=Dre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343744\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Travel/Travel.jsx", "browser/extensions/newtab/content-src/components/Widgets/useFramedWidgetMessages.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Travel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/useFramedWidgetMessages.test.jsx"], "git_node": "e9b4841cf68f0689b3d8f98eb0473e4a97b3a349", "git_parents": ["252561af527b05813d3e86faaca3fe02a122399a"], "node": "f5a2fb49b8748fd6faeecef2a7039a87aa5b3dab", "parents": ["bf3dbcece019652f3ffdfc97a2c349fb8427bf7a"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094355 - Pass the home region to the Travel widget frame in its URL fragment. r=Dre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343745\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Travel/Travel.jsx", "browser/extensions/newtab/test/browser/browser_framed_widgets.js", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Travel.test.jsx"], "git_node": "34c8b2a104e2093a2903cc593fd80d876dc21820", "git_parents": ["e9b4841cf68f0689b3d8f98eb0473e4a97b3a349"], "node": "fa3b41e72642cefba4770dff515f2b25c14a222d", "parents": ["f5a2fb49b8748fd6faeecef2a7039a87aa5b3dab"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2092555 - Let URLQueryStrippingListService unregister an observer whose registration is still waiting for init, r=manuel.\n\nThe registerAndRunObserver* methods added the observer only after init, so\nan unregister arriving meanwhile deleted nothing and the service never shut\ndown again. This happens when strip_on_share.enabled is toggled quickly.\n\nObservers are now added before init, so they may also get the partial list\nupdates made during init. Unregistering waits for a pending init before\ndeciding to shut down, so a registration arriving in between is kept.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342591\n", "files": ["toolkit/components/antitracking/URLQueryStrippingListService.sys.mjs", "toolkit/components/antitracking/test/browser/browser_urlQueryStrippingListService.js"], "git_node": "2a92d34a2d6c466bc71e19bcc152e046168fd32c", "git_parents": ["34c8b2a104e2093a2903cc593fd80d876dc21820"], "node": "0d0481a086ae29242c978ff01c2ee34cc4f54bef", "parents": ["fa3b41e72642cefba4770dff515f2b25c14a222d"], "tags": []}, {"author": "Greg Woods \u003cgwoods@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067404 - Use the small Sign in button and fix email spacing and truncation in the signed-out account card. r=nsharpley,desktop-theme-reviewers,akulyk\n\nThe Sign in buttons in the account menu's signed-out card and the app menu's\nsigned-out row used the default button size, larger than the spec. The email\nlabel kept its default XUL block margin, doubling the gap above the status\nmessage, which already sets margin-block: 0.\n\nThe app menu row could not shrink below its email's full width, pushing the\nSign in button out of the panel for long addresses. Its label sets its text\nthrough textContent, so XUL's crop attribute does not apply, and the shared\nrule now truncates the email itself. The localized title shown without an\nemail keeps wrapping, as several translations do not fit on one line.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342276\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "91d81f34e0fff7d231f6ce27befb1ef0bd3573c7", "git_parents": ["2a92d34a2d6c466bc71e19bcc152e046168fd32c"], "node": "90c8efb2fb7b8b3b479bc769c3f94eed58c7f3cc", "parents": ["0d0481a086ae29242c978ff01c2ee34cc4f54bef"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2090991 - Run mochitest-devtools-chrome-repeat on autoland and mozilla-central, r=taskgraph-reviewers,ahal.\n\nLike the standalone variant: on backstop pushes, on Linux and Windows only, to\nspare the mac pool.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341600\n", "files": ["taskcluster/kinds/mochitest/kind.yml"], "git_node": "c84ff4d984969dbc8e2e17facb972123499a08bd", "git_parents": ["91d81f34e0fff7d231f6ce27befb1ef0bd3573c7"], "node": "b23bcf6a79e24a10fa0fc6440effd41afc552dd5", "parents": ["90c8efb2fb7b8b3b479bc769c3f94eed58c7f3cc"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092199 - Add uppercase strings to replace automatic casing of displayed text. r=android-reviewers,android-l10n-reviewers,007,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343362\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "f51a75598b920c5c77f35d3b9d04225e1ebccdd0", "git_parents": ["c84ff4d984969dbc8e2e17facb972123499a08bd"], "node": "a7bd03ea126add677eab08dec49a05d476c64368", "parents": ["b23bcf6a79e24a10fa0fc6440effd41afc552dd5"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2038777 - Part 1: Make privilegedabout implicitly COOP, r=mconley,mccr8,tabbrowser-reviewers,dao\n\nCurrently there is largely no reason for a privilegedabout tab to have\nan opener relationship with a non-privilegedabout tab. This patch\nenforces this by breaking opener tabs in a similar manner to if the\nCross-Origin-Opener-Policy header was specified when loading\nprivilegedabout content.\n\nIn addition, this change also blocks framing of privilegedabout content\nby non-privilegedabout documents. It should still be possible to frame\nnon-privilegedabout content sandboxed within a privilegedabout frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300048\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_new_tab_in_privilegedabout_process_pref.js", "browser/components/tabbrowser/test/browser/tabs/browser_privilegedabout_popup_opener.js", "dom/ipc/ProcessIsolation.cpp"], "git_node": "786675946ce75c1a048d6f3014b310aa5f0a9eed", "git_parents": ["f51a75598b920c5c77f35d3b9d04225e1ebccdd0"], "node": "beef3eaa935d798d4708a983cd0b21d04bfb755d", "parents": ["a7bd03ea126add677eab08dec49a05d476c64368"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2038777 - Part 2: Track browserId instead of BC in PromptParent, r=Gijs\n\nAfter this change, we look up the embedder element after the prompt has\nbeen closed again using `browserId`. This continues to handle a\npreviously handled situation (the tab is torn off into a new window, so\nthe browser has been replaced), while also handling a new situation (a\ncross-group navigation occurred, so the BrowsingContext has been\nreplaced).\n\nThis new approach should ensure that DOMModalDialogClosed is fired on\nthe correct element, even if a cross-group navigation occurs while the\ndialog is opened.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343732\n", "files": ["browser/actors/PromptParent.sys.mjs"], "git_node": "f9fb5793814ace843faa8db502808314cebd5db0", "git_parents": ["786675946ce75c1a048d6f3014b310aa5f0a9eed"], "node": "fdd1934ee4ea471aac81e996177d0a52a4d90c46", "parents": ["beef3eaa935d798d4708a983cd0b21d04bfb755d"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090329 - Add telemetry for set to default promo - r=ip-protection-reviewers,settings-reviewers,mconley,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343340\n", "files": ["browser/components/ipprotection/content/ipprotection-locations.mjs", "browser/components/ipprotection/metrics.yaml", "browser/components/ipprotection/tests/browser/browser_ipprotection_location_selector_telemetry.js", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/privacy/browser_privacy_ipprotection.js"], "git_node": "cc46b9483887936ee56df4b9819c45036a8db3ed", "git_parents": ["f9fb5793814ace843faa8db502808314cebd5db0"], "node": "45e6cd78522016fe5cd5ebe14dd2bcec14b8c59c", "parents": ["fdd1934ee4ea471aac81e996177d0a52a4d90c46"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094700 - Bump Python to 3.10 as the minimum version for mozperftest, AWSY and condprofile. r=perftest-reviewers,mozperftest-reviewers,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343991\n", "files": ["python/mozperftest/setup.py", "testing/awsy/setup.py", "testing/condprofile/setup.py"], "git_node": "90c06f25b8713be3909f4e35fe88c9a2176a4d7c", "git_parents": ["cc46b9483887936ee56df4b9819c45036a8db3ed"], "node": "ab4021df862acd8516f06c5265354f84e1a23d5d", "parents": ["45e6cd78522016fe5cd5ebe14dd2bcec14b8c59c"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1966406 - Remove the linter step from mach perftest-test. r=perftest-reviewers,mozperftest-reviewers,kshampur\n\nRemove the linter step and the -s option to skip it.\nIt often fails(per bug) and is unneeded here at least.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343161\n", "files": ["python/mozperftest/mozperftest/mach_commands.py", "python/mozperftest/mozperftest/utils.py", "python/mozperftest/perfdocs/developing.md", "testing/perfdocs/generated/developing.md"], "git_node": "0bc59be72ef933fc73a8d623bc899713a8ffbfc3", "git_parents": ["90c06f25b8713be3909f4e35fe88c9a2176a4d7c"], "node": "4021017a7be95fc53d364ea8e0e722cfc80c127a", "parents": ["ab4021df862acd8516f06c5265354f84e1a23d5d"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094721 Part 1: Install the non-fatal X11 error handler in the GPU process. r=aosmond\n\nGDK's default X error handler aborts on any asynchronous X error. The parent\nand content processes replace it after gtk_init, and this change makes  the\nGPU process replace it as well. This prevents a GPU process crash when a\nharmless BadDrawable is presented to a toplevel the parent has just\ndestroyed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336871\n", "files": ["gfx/ipc/GPUParent.cpp"], "git_node": "40261817d2f420a0dd845acdd0b7a36be4c92e28", "git_parents": ["0bc59be72ef933fc73a8d623bc899713a8ffbfc3"], "node": "62231913bdfd07b8e908140495488d40f10dbbdc", "parents": ["4021017a7be95fc53d364ea8e0e722cfc80c127a"], "tags": []}, {"author": "Bob Hood \u003cbhood@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094721 Part 2: Don't cache SkSurfaceProps in a static. r=aosmond\n\nDrawTargets are created concurrently on WebRender's blob rasterization\nthreads, which raced on lazily initializing and updating the static. The\nprops are cheap to build and their inputs are atomic, so compute them each\ntime.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336872\n", "files": ["gfx/2d/DrawTargetSkia.cpp", "gfx/2d/DrawTargetSkia.h"], "git_node": "3a009fa2bd8b8a099cefd98f511a9d2d46c7635d", "git_parents": ["40261817d2f420a0dd845acdd0b7a36be4c92e28"], "node": "7d685147f602e9420b3c1eb6e9d778553ae33e6c", "parents": ["62231913bdfd07b8e908140495488d40f10dbbdc"], "tags": []}, {"author": "Bob Hood \u003cbhood@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094721 Part 3: Cache the EGL X11 visual. r=aosmond\n\nFindVisual only holds the default EGLDisplay for the duration of the query.\nWithout a compositor in the parent process to keep that display alive, every\nnew window initialized and terminated EGL, reloading the driver each time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336873\n", "files": ["gfx/gl/GLContextProviderEGL.cpp"], "git_node": "4ead3ff9b2a392297e3169ed3df6903228746bec", "git_parents": ["3a009fa2bd8b8a099cefd98f511a9d2d46c7635d"], "node": "e66f06095e1b525296ef6bdb96216e013e51a456", "parents": ["7d685147f602e9420b3c1eb6e9d778553ae33e6c"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2094470 - Let decodingInfo() accept audio/mpeg without a codecs parameter for MediaSource. r=media-playback-reviewers,alwu\n\nMedia Capabilities treats audio/mpeg as a container type, which needs a\ncodecs parameter, but the MPEG audio byte stream format says that the\nparameter must not be used and MediaSource rejects it. So decodingInfo()\ncouldn't report any audio/mpeg type as supported for MediaSource. Treat it\nthere as a type that allows a single codec, which must have no parameters.\nChrome reports audio/mpeg as supported for MediaSource too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343802\n", "files": ["dom/media/mediacapabilities/MediaCapabilitiesValidation.cpp", "dom/media/mediasource/test/test_MP3_TypeSupport.html"], "git_node": "6863842a4f4a7a1555e23b0a41b282a869979b33", "git_parents": ["4ead3ff9b2a392297e3169ed3df6903228746bec"], "node": "e23be319bc06cd2f867f9d7fb595c87470151d65", "parents": ["e66f06095e1b525296ef6bdb96216e013e51a456"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094468 - Update Sentry to version 8.65.0. r=android-reviewers,android-build-system-reviewers,ahochheiden,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343816\n", "files": ["gradle/libs.versions.toml"], "git_node": "e15867e4aece7e820c7d117cc1d5bd89a212e0fb", "git_parents": ["6863842a4f4a7a1555e23b0a41b282a869979b33"], "node": "b766ba4e891cfaf0fb95c7e6ff29ed937616ae4a", "parents": ["e23be319bc06cd2f867f9d7fb595c87470151d65"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094469 - Update Robolectric to version 4.18.1. r=android-reviewers,android-build-system-reviewers,ahochheiden,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343817\n", "files": ["gradle/libs.versions.toml"], "git_node": "90f886940d37b9b07ed420b93188fd25c7919028", "git_parents": ["e15867e4aece7e820c7d117cc1d5bd89a212e0fb"], "node": "e1d4068809ccbeb3706986eb1e2da3b3c7f3982b", "parents": ["b766ba4e891cfaf0fb95c7e6ff29ed937616ae4a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068809 - Update AFL++ toolchain to version 5.03c. r=truber\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323142\n", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/scripts/misc/build-afl.sh"], "git_node": "de3a3f993332d0f2743f58b0ddd7d87406cd4fe7", "git_parents": ["90f886940d37b9b07ed420b93188fd25c7919028"], "node": "6a974bdbefa0e3992030df738727378bc559ccd0", "parents": ["e1d4068809ccbeb3706986eb1e2da3b3c7f3982b"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "ec41f71087664fc50945f9200ddca1b4917868d3", "git_parents": ["de3a3f993332d0f2743f58b0ddd7d87406cd4fe7", "41b747af72d91784f78616056c2f1d6c17c01345"], "node": "ea8b1bf5a45014b144fa9c65f53033c5a611b856", "parents": ["6a974bdbefa0e3992030df738727378bc559ccd0", "617788d3b48194556f8016cfc668b600843df3a1"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092366 - [Smart Window] Update the UITour API to pass the launch Window entry point r=czhou\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343397\n", "files": ["browser/components/uitour/UITour-lib.js", "browser/components/uitour/UITour.sys.mjs", "browser/components/uitour/test/browser_UITour_aiwindow.js"], "git_node": "ff395f80e7cb27e6a6a3cf0808d24fa6d008c04f", "git_parents": ["ec41f71087664fc50945f9200ddca1b4917868d3"], "node": "ad87952d0f2732e6021237389ac23c153477366b", "parents": ["ea8b1bf5a45014b144fa9c65f53033c5a611b856"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088410 - Fix inconsistent device renaming on Android r=android-reviewers,tthibaud\n\nThere were multiple issues causing the device renaming to be inconsistent on Android, and this patch fixes the identified ones by:\n\n1. Adding an optional `ignoreCache` param to the `DeviceConstellation.refreshDevices()` API, so that when we are renaming devices, we can ensure that the latest changes from the server are refreshed.\n2. Build account settings initial state from the constellation's state where available. This is why we were also having a flicker between the \"default name\" of the device, and a user-defined name.\n3. Removing redundant calls to update device name and make sure they all go through the same code path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343179\n", "files": ["mobile/android/android-components/components/concept/sync/src/main/java/mozilla/components/concept/sync/Devices.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/FxaDeviceConstellation.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/FxaDeviceConstellationTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/AccountSettingsFragment.kt"], "git_node": "2a14be406d3edd4fe8eda2ca2e31987d165c344b", "git_parents": ["ff395f80e7cb27e6a6a3cf0808d24fa6d008c04f"], "node": "9f95f429ada63cd02e444a1eca4391ec1f493344", "parents": ["ad87952d0f2732e6021237389ac23c153477366b"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2091489 - Remove the BackgroundParent shutdown timeout, r=ipc-reviewers,mccr8\n\nThis patch rips out most of the logic which is handling the timeout and\nwaiting for PBackground actors to naturally die during shutdown,\nfavoring immediately `Close()`-ing them using `nsITargetShutdownTask`\nwhen possible.\n\nThis is done implicitly by XPCOM thread shutdown, meaning that most of\nthe manual shutdown logic in BackgroundImpl can be removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341502\n", "files": ["ipc/glue/BackgroundImpl.cpp", "ipc/glue/BackgroundStarterParent.h"], "git_node": "e7702f6947c73d346c6b7b0868c5d4727f2abd81", "git_parents": ["2a14be406d3edd4fe8eda2ca2e31987d165c344b"], "node": "de7b80e75818e82768ea58fbdb4e6d8879ed427d", "parents": ["9f95f429ada63cd02e444a1eca4391ec1f493344"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996168 - Use logical properties for spacing/positioning in toolkit/themes r=desktop-theme-reviewers,reusable-components-reviewers,hjones,niklas,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337194\n", "files": ["toolkit/themes/mobile/global/aboutMemory.css", "toolkit/themes/osx/global/global.css", "toolkit/themes/shared/aboutNetError.css", "toolkit/themes/shared/aboutSupport.css", "toolkit/themes/shared/colorpicker-common.css", "toolkit/themes/shared/design-system/storybook/tokens-table.css", "toolkit/themes/shared/in-content/common-shared.css", "toolkit/themes/shared/media/pipToggle.css", "toolkit/themes/shared/media/videocontrols.css", "toolkit/themes/shared/pictureinpicture/player.css"], "git_node": "88cc965bc8900e63c60db92f2b3aba53387d1bd0", "git_parents": ["e7702f6947c73d346c6b7b0868c5d4727f2abd81"], "node": "26ea0efa5bc2c798a3f333bf8d330884b4f3480c", "parents": ["de7b80e75818e82768ea58fbdb4e6d8879ed427d"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996168 - Use logical properties for spacing/positioning in browser/components r=desktop-theme-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337207\n", "files": ["browser/components/enterprisepolicies/content/aboutPolicies.css", "browser/components/nimbus/content/about-studies/about-studies.css", "browser/components/privatebrowsing/content/private-browsing-mask-intro.css", "browser/components/screenshots/overlay/overlay.css", "browser/components/sharing/content/content-sharing-modal.css", "browser/components/webrtc/content/webrtc-preview/webrtc-preview.css"], "git_node": "839696d6b96987cd57704861437987c3b672734b", "git_parents": ["88cc965bc8900e63c60db92f2b3aba53387d1bd0"], "node": "7bcd3de6ecbdb524944f0336260d20a640cc2072", "parents": ["26ea0efa5bc2c798a3f333bf8d330884b4f3480c"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093805 - Update opus to f1afc4222aff7c5456d27581ec618ae64158fbe1 r=kinetik\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343355\n", "files": ["media/libopus/celt/mathops.h", "media/libopus/moz.build", "media/libopus/moz.yaml", "media/libopus/src/repacketizer.c"], "git_node": "4eca46d7857212efde4e799196651d2b993eaf77", "git_parents": ["839696d6b96987cd57704861437987c3b672734b"], "node": "4a41f0697f69ef9ad2fb98aaf11f97c5bdda016d", "parents": ["7bcd3de6ecbdb524944f0336260d20a640cc2072"], "tags": []}, {"author": "Ansh \u003cansinha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089812 - Stop using SecureAbove22Preferences encryption in Fenix r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341513\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/BackgroundServices.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt"], "git_node": "d4fa99dbdafa1b18b2f293bc530841d05f74e265", "git_parents": ["4eca46d7857212efde4e799196651d2b993eaf77"], "node": "5813961698375197d71c6753cd13bc6442e14ee2", "parents": ["4a41f0697f69ef9ad2fb98aaf11f97c5bdda016d"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075337 - Update GeckoView to support flattening argument r=geckoview-reviewers,android-reviewers,owlish\n\nThis patch adds a new argument to GeckoView to request that a saved PDF be flattened.\nThis change is propagate to AC so \"Shared\" PDFs will also be flattened.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344058\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineSessionTest.kt", "mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionPdfFileSaver.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "toolkit/components/pdfjs/content/GeckoViewPdfJsParent.sys.mjs"], "git_node": "582c11cc80f1206c60ffd447a4b2df058751e2b5", "git_parents": ["d4fa99dbdafa1b18b2f293bc530841d05f74e265"], "node": "558aa57238c84801eda54e05bfb46944c694a5fa", "parents": ["5813961698375197d71c6753cd13bc6442e14ee2"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093201 - Unlink dropped pool candidates from their socket. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343344\n", "files": ["dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_component.cpp"], "git_node": "b4245d6c2fc62545b0710822c1e750c08e08f981", "git_parents": ["582c11cc80f1206c60ffd447a4b2df058751e2b5"], "node": "d6242580f4cb7ab2e3b3f76b7cee33ed596c057a", "parents": ["558aa57238c84801eda54e05bfb46944c694a5fa"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091725 - Implement an image fetcher that is aware of download size r=android-reviewers,pollymce,tthibaud\n\nThis image fetcher wraps the client and has the ability to bail when a configured max has been reached.\n\nThis is expected to be an immediate fix, but with proposal to upstream the same logic to the Client in a way other features can benefit from it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342059\n", "files": ["mobile/android/android-components/components/support/images/src/main/java/mozilla/components/support/images/fetcher/ImageFetchException.kt", "mobile/android/android-components/components/support/images/src/main/java/mozilla/components/support/images/fetcher/ImageFetcher.kt", "mobile/android/android-components/components/support/images/src/main/java/mozilla/components/support/images/fetcher/ImageFetcherConfig.kt", "mobile/android/android-components/components/support/images/src/main/java/mozilla/components/support/images/fetcher/ImageTooLargeException.kt", "mobile/android/android-components/components/support/images/src/test/java/mozilla/components/support/images/fetcher/ImageFetcherTest.kt"], "git_node": "9850e80551c7326d6443e1030b7dcc4e29101d1e", "git_parents": ["b4245d6c2fc62545b0710822c1e750c08e08f981"], "node": "522c58838362d4a5afaba4ef3563572ab0cee7c4", "parents": ["d6242580f4cb7ab2e3b3f76b7cee33ed596c057a"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091725 - Fix OOM in ImageLoader composable by using the image fetcher configured with a max size of 1 MiB r=android-reviewers,kaya\n\nThis 1 MiB value was picked by what we use currently in the BrowserIcons feature.\n\nThis patch fixes the OOM. There are future considerations to:\n\n 1. Explore adding telemetry to see how we can choose a more reasonable limit\n 2. Implement a dynamic limit based on the current heap memory available\n\nFor now, I want to keep this work focused on fixing the OOM, or at least, reducing it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342060\n", "files": ["mobile/android/android-components/components/support/images/src/main/java/mozilla/components/support/images/compose/loader/ImageLoader.kt"], "git_node": "868393891da77760401c4786f5032fc570b9bbc6", "git_parents": ["9850e80551c7326d6443e1030b7dcc4e29101d1e"], "node": "f38090a29f13deb5b1eeea62bf4b19f4a11df36e", "parents": ["522c58838362d4a5afaba4ef3563572ab0cee7c4"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091424 - Build the upstream ESR snap on the core24 image r=releng-reviewers,ahal,hneiva\n\nFound in https://phabricator.services.mozilla.com/D341485#11945568. canonical/firefox-snap's `esr` branch now builds 153esr with `base: core24`\n\nWe also make install-snap.sh retry its downloads because of network failures found in https://phabricator.services.mozilla.com/D343951#11946192\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343951\n", "files": ["taskcluster/docker/snap-coreXX-build/install-snap.sh", "taskcluster/docker/snap-coreXX-build/run.sh", "taskcluster/kinds/docker-image/kind.yml", "taskcluster/kinds/snap-upstream-build/kind.yml"], "git_node": "6bdf6f1784e92f31f5f6a500bf4b81b967589008", "git_parents": ["868393891da77760401c4786f5032fc570b9bbc6"], "node": "2321305e90ffa3d29464f5f9738f2492aa0bf377", "parents": ["f38090a29f13deb5b1eeea62bf4b19f4a11df36e"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083998 - Add the ability to open a new url in a mini window. r=mconley,tabbrowser-reviewers,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339330\n", "files": ["browser/base/content/browser-init.js", "browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_open_url.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/modules/URILoadingHelper.sys.mjs"], "git_node": "4b3ae8b88673f00e5a8ddec0653f136487575b85", "git_parents": ["6bdf6f1784e92f31f5f6a500bf4b81b967589008"], "node": "38278396c5490902191b447d5d81571175f794c8", "parents": ["2321305e90ffa3d29464f5f9738f2492aa0bf377"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083998 - Wire open link mini window behavior to the link context menu. r=niklas,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343445\n", "files": ["browser/base/content/