alues-sr/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-th/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-trs/strings.xml", "mobile/android/fenix/app/src/main/res/values-ug/strings.xml", "mobile/android/fenix/app/src/main/res/values-uk/strings.xml", "mobile/android/fenix/app/src/main/res/values-vi/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml"], "git_node": "40325f4759bd3188744e1001e2aae577e77a0509", "git_parents": ["1d4365a6c5323440929d0c9b2d2f2df7860439aa"], "node": "83efd5c67c6c1b5bf72e1f5cfc1737957e26b0c1", "parents": ["1d3aa4bdcdc6dd40d9bd1ee478e49d5a80b98fd2"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2029980 - Add mochitest repeat tasks that run each test twice in a row, without scheduling them yet, r=taskgraph-reviewers,ahal.\" for causing python-firefox-ci failures\n\nThis reverts commit 3154dedd964a5d890c422bda3ef30e1fc6b8d9b0.\n\nRevert \"Bug 2029980 - Align the mochitest default-chunks with the chunk counts dynamic chunking currently picks, r=taskgraph-reviewers,ahal.\"\n\nThis reverts commit 8d64d136e947420ea2d6086f4a487120807df1cf.\n\nRevert \"Bug 2029980 - Make Harness_sanity's service worker tests pass with --repeat, r=ahal.\"\n\nThis reverts commit 2f626aa6eebdf3c254ce2a3622f7ebc623972534.\n\nRevert \"Bug 2029980 - Make --repeat run each mochitest again right after itself, r=ahal.\"\n\nThis reverts commit c2f94bd0ce8226e011506b26a2334c0b2d586768.\n\nRevert \"Bug 2029980 - Add a repeat manifest condition for mochitests running with --repeat, r=ahal,mozbase-reviewers.\"\n\nThis reverts commit 68dbd9dc0cdd30731ab62984178d5b77ecc1611c.\n", "files": ["docs/code-quality/lint/linters/test-manifest-toml.md", "taskcluster/config.yml", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/test_configs/variants.yml", "testing/mochitest/browser-test.js", "testing/mochitest/runtests.py", "testing/mochitest/tests/Harness_sanity/mochitest.toml", "testing/mochitest/tests/Harness_sanity/test_sanityRegisteredServiceWorker.html", "testing/mochitest/tests/SimpleTest/TestRunner.js", "testing/mochitest/tests/python/test_mochitest_integration.py", "testing/mozbase/manifestparser/manifestparser/token.py", "tools/tryselect/try_presets.yml"], "git_node": "59907cc1ef42b6edc7e8c7304413cd8e7436eccf", "git_parents": ["40325f4759bd3188744e1001e2aae577e77a0509"], "node": "e133333ea8796702a7acaeabdc4fce502bc93bcc", "parents": ["83efd5c67c6c1b5bf72e1f5cfc1737957e26b0c1"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087668 - Update Smart Window onboarding screen to match FRO template r=omc-reviewers,jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341544\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_multiselect.js", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "0f8e555d8ff869211a701f54526317cbe1de0e93", "git_parents": ["59907cc1ef42b6edc7e8c7304413cd8e7436eccf"], "node": "e58a31f3f4d2f89bcb28988f8dcedf3bd59ceaec", "parents": ["e133333ea8796702a7acaeabdc4fce502bc93bcc"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025870 - Use signed 64-bit arithmetic for grid auto repeat calculations. r=AlaskanEmily,layout-reviewers\n\nWe do this to prevent overflows or large grid gaps from producing\nzero repetitions. Wpt for grid auto-repeat with a large gap added.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342759\n", "files": ["layout/generic/nsGridContainerFrame.cpp", "testing/web-platform/tests/css/css-grid/grid-items/grid-item-auto-repeat-large-gap.html"], "git_node": "e7b1ecc1be8e6cfe7ad9a67ca29cbfd6d17bdb24", "git_parents": ["0f8e555d8ff869211a701f54526317cbe1de0e93"], "node": "dd9630c7a1f9e33636bf5006ee237f7d793ee066", "parents": ["e58a31f3f4d2f89bcb28988f8dcedf3bd59ceaec"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070617 - Synchronously remove excess chunks r=jstutte\n\nThis limits the number of spare chunks per arena to 1 and removes the\nexcess chunks synchronously as part of `free()`.  This matches how\nthe allocator behaved before Bug 2055507.  Later we can consider doing\nthis asynchronously.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342568\n", "files": ["memory/build/Arena.h", "memory/build/mozjemalloc.cpp"], "git_node": "f6a91897b6b1f39aa2593e0dfa656bfdb04acfe3", "git_parents": ["e7b1ecc1be8e6cfe7ad9a67ca29cbfd6d17bdb24"], "node": "659afd6fe9a91b0a21c49f96559f5a11cbebe36f", "parents": ["dd9630c7a1f9e33636bf5006ee237f7d793ee066"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090947 - Request focus be placed in the browser after adding signature to pick up browser events r=android-reviewers,jonalmeida\n\nThis patch makes sure that focus is placed on the browser so it catches the signature `focus()` state. A wait state is added to ensure the processing button is saw by the screenreader first for a smoother experience.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341498\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfToolsIntegration.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationGleanTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationTest.kt"], "git_node": "98a3f1d552b1575b5ff0eaeae98f787ae297e816", "git_parents": ["f6a91897b6b1f39aa2593e0dfa656bfdb04acfe3"], "node": "914df8f8ec5a22e9bbf8e093d02d2b6a899324ba", "parents": ["659afd6fe9a91b0a21c49f96559f5a11cbebe36f"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2092373. Give the GPU process windowserver access on x86_64 when WebRender uses CGL. r=mac-reviewers,spohl\n\nBug 2088620 limited windowserver access in the GPU sandbox to x86_64 processes\nwhere WebGL won't use Metal ANGLE. WebRender makes its own choice:\nWEBRENDER_ANGLE_METAL is blocklisted on Macs with more than one GPU, while\nWEBGL_ANGLE_METAL isn't. On dual-GPU Intel Macs WebRender therefore creates a\nCGL context in a GPU process without windowserver access, fails, and falls\nback to software WebRender, which also disables accelerated Canvas2D.\n\nAlso grant access when WebRender isn't using ANGLE. gfxVars::UseWebRenderANGLE\nis set by InitWebRenderConfig before the GPU process is launched.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342418\n", "files": ["gfx/ipc/GPUProcessHost.cpp"], "git_node": "91f6ba8bbc88114effb792a8d755e5556c302e25", "git_parents": ["98a3f1d552b1575b5ff0eaeae98f787ae297e816"], "node": "05633ed40130c8e082011b8946bfda7ef0799b0d", "parents": ["914df8f8ec5a22e9bbf8e093d02d2b6a899324ba"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2092510 - Use cached JAR in moz-extension if possible r=necko-reviewers,jesup\n\nThe switch from jar:file:/file:-URLs to moz-extension: in bug 1976115\ncaused `loadSubScriptWithOptions` (in ExtensionCommon.sys.mjs) to\ngo through the extension protocol handler instead of the JAR handler,\nwhich triggers a nested event loop while waiting for the parent to\nreturn the underlying data.\n\nUnfortunately, a nested event loop causes unwanted side effects:\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=2092510#c3\n\nThis patch fixes the issue for most common cases, by reading the data\nfrom the cached JAR data if possible.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342689\n", "files": ["netwerk/protocol/res/ExtensionProtocolHandler.cpp", "toolkit/components/extensions/test/xpcshell/test_ext_experiments.js"], "git_node": "16a7f879a158557c7fb4b13a1038725eeeae4921", "git_parents": ["91f6ba8bbc88114effb792a8d755e5556c302e25"], "node": "b18d5a5258f248193eb858698dd96ff1ea7c66b6", "parents": ["05633ed40130c8e082011b8946bfda7ef0799b0d"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092157 - Add a detekt rule to forbid string casing in displayed text in composables r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342414\n", "files": ["mobile/android/android-components/components/tooling/detekt/src/main/kotlin/mozilla/components/tooling/detekt/acorn/AcornDisplayedTextCasingRule.kt", "mobile/android/android-components/components/tooling/detekt/src/main/kotlin/mozilla/components/tooling/detekt/acorn/AcornRuleSetProvider.kt", "mobile/android/android-components/components/tooling/detekt/src/test/kotlin/AcornDisplayedTextCasingRuleTest.kt", "mobile/android/android-components/config/detekt-baseline.xml", "mobile/android/android-components/config/detekt.yml", "mobile/android/fenix/config/detekt-baseline.xml", "mobile/android/fenix/config/detekt.yml", "mobile/android/focus-android/quality/detekt.yml"], "git_node": "ca3f1d57d97012c622ecf40a955173434dd683bb", "git_parents": ["16a7f879a158557c7fb4b13a1038725eeeae4921"], "node": "949b6ca1dcc787f4d94cc39db587862bc2c2e2d3", "parents": ["b18d5a5258f248193eb858698dd96ff1ea7c66b6"], "tags": []}, {"author": "Benjamin Grant \u003cbenjamin@nothingrandom.com\u003e", "branch": "default", "desc": "Bug 2090081 - Propagate omnibox.setDefaultSuggestion errors to the extension framework. r=extension-reviewers,robwu\n\nThe try/catch rejected with a bare string, which normalizeError already\nreplaced with a sanitized error, so callers see the same rejection. Dropping\nit logs the original error with its stack instead of a bare string.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341469\n", "files": ["browser/components/extensions/parent/ext-omnibox.js", "browser/components/extensions/test/browser/browser_ext_omnibox.js"], "git_node": "ce5ddb50fcab9daa074e1cb81d7c490835fc264f", "git_parents": ["ca3f1d57d97012c622ecf40a955173434dd683bb"], "node": "d9b4abcaed59009c29019b7f3ba245903e631610", "parents": ["949b6ca1dcc787f4d94cc39db587862bc2c2e2d3"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092758 - Normalize reftest content sandbox whitelist paths. r=dshin,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342822\n", "files": ["layout/tools/reftest/runreftest.py"], "git_node": "7b978d4137f4e151be641eabaaa05578d3101f93", "git_parents": ["ce5ddb50fcab9daa074e1cb81d7c490835fc264f"], "node": "5e2906a11901a40e747292847d57f75f7b0564e2", "parents": ["d9b4abcaed59009c29019b7f3ba245903e631610"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2083098 - Part 1: Unify child handle codepaths in GeckoChildProcessHost, r=ipc-reviewers,media-playback-reviewers,jld,alwu\n\nThis delays calling `OnChannelConnected()` until after the process has\nbeen started.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339678\n", "files": ["dom/media/ipc/RDDProcessHost.cpp", "dom/media/ipc/RDDProcessHost.h", "gfx/ipc/GPUProcessHost.cpp", "gfx/ipc/GPUProcessHost.h", "gfx/vr/ipc/VRProcessParent.cpp", "gfx/vr/ipc/VRProcessParent.h", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h", "ipc/glue/NodeChannel.cpp", "ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessHost.h"], "git_node": "f24c75150b5ef43645d6d69e73eac7566929eee8", "git_parents": ["7b978d4137f4e151be641eabaaa05578d3101f93"], "node": "ec61ba48210079efb37e418c2a73f04f16a9c4b9", "parents": ["5e2906a11901a40e747292847d57f75f7b0564e2"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2083098 - Part 2: Fully remove OnChannelConnected from GeckoChildProcessHost, r=ipc-reviewers,media-playback-reviewers,mccr8,aosmond\n\nThis hook was scheduled to happen either slightly before or slightly\nafter the process handle became ready, on the IPC I/O thread. This\nreplaces all uses with instead chaining off of the process handle\npromise, which happens with consistent scheduling.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339679\n", "files": ["dom/media/gmp/GMPProcessParent.cpp", "dom/media/ipc/RDDProcessHost.cpp", "dom/media/ipc/RDDProcessHost.h", "gfx/ipc/GPUProcessHost.cpp", "gfx/ipc/GPUProcessHost.h", "gfx/vr/ipc/VRProcessParent.cpp", "gfx/vr/ipc/VRProcessParent.h", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h", "ipc/glue/NodeChannel.cpp", "ipc/glue/NodeChannel.h", "ipc/glue/NodeController.cpp", "ipc/glue/NodeController.h", "ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessHost.h", "ipc/ipdl/test/gtest/IPDLUnitTest.cpp"], "git_node": "b64cfd8c692fd0237b49d2f04e25352bca787e82", "git_parents": ["f24c75150b5ef43645d6d69e73eac7566929eee8"], "node": "a2c556c76da44e23da985083fdfff2f095020c84", "parents": ["ec61ba48210079efb37e418c2a73f04f16a9c4b9"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1558431 - Test the direction of plaintext lines after forced breaks. r=layout-reviewers,emilio\n\nCheck that each line after a forced break takes its direction from its own\nparagraph with unicode-bidi: plaintext [1].\n\nbidi-plaintext-br-002.html puts the forced break inside an inline element, and\ninside two nested inline elements. The nested case checks that the fix looks\nthrough more than one empty continuation. The block has a fixed width, because\nthe test does not fail without the fix when the width is auto.\n\ntext-wrap-balance-bidi-001.html balances the lines of a block [2] with the\nforced break inside an inline element. It needs white-space: pre-line and\noverflow-wrap: break-word, so that a narrow trial breaks the first word before\nthe newline.\n\nBoth tests also have the opposite order, a right-to-left paragraph before a\nleft-to-right one. These cases pass without the fix, and they check that the\nfix does not change this direction.\n\nThese tests are also verified to pass in Chrome and Safari.\n\n[1] https://drafts.csswg.org/css-writing-modes-3/#valdef-unicode-bidi-plaintext\n[2] https://drafts.csswg.org/css-text-4/#text-wrap-style\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340245\n", "files": ["testing/web-platform/tests/css/css-text/white-space/reference/text-wrap-balance-bidi-001-ref.html", "testing/web-platform/tests/css/css-text/white-space/text-wrap-balance-bidi-001.html", "testing/web-platform/tests/css/css-writing-modes/bidi-plaintext-br-002.html", "testing/web-platform/tests/css/css-writing-modes/reference/bidi-plaintext-br-002-ref.html"], "git_node": "f425d56e1766cf36aa8c064fcec1bb7f86427672", "git_parents": ["b64cfd8c692fd0237b49d2f04e25352bca787e82"], "node": "05d53c06df91786623766c27cc589622d50a0dea", "parents": ["a2c556c76da44e23da985083fdfff2f095020c84"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 2084316 - Use SnackbarDelegate with a non-root view r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340256\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/nimbus/NimbusBranchesFragment.kt"], "git_node": "54143156779adfb542122d4ac93ee5f6db710d4f", "git_parents": ["f425d56e1766cf36aa8c064fcec1bb7f86427672"], "node": "b9cc4077634a408435bb1d4ff6373d92cc8ec330", "parents": ["05d53c06df91786623766c27cc589622d50a0dea"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 2084316 - Do not execute onClick in Snackbar if not attached to a window r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340257\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/snackbar/FenixSnackbarDelegate.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/snackbar/FenixSnackbarDelegateTest.kt"], "git_node": "d944f5a3d38de6e64f5e54ef59f3a92abe49afd0", "git_parents": ["54143156779adfb542122d4ac93ee5f6db710d4f"], "node": "3119c03c2b3e4daee34279c3b923af13df2442b0", "parents": ["b9cc4077634a408435bb1d4ff6373d92cc8ec330"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083098 - Part 2: Fully remove OnChannelConnected from GeckoChildProcessHost, r=ipc-reviewers,media-playback-reviewers,mccr8,aosmond\" for causing failures at GeckoChildProcessHost.cpp.\n\nThis reverts commit b64cfd8c692fd0237b49d2f04e25352bca787e82.\n\nRevert \"Bug 2083098 - Part 1: Unify child handle codepaths in GeckoChildProcessHost, r=ipc-reviewers,media-playback-reviewers,jld,alwu\"\n\nThis reverts commit f24c75150b5ef43645d6d69e73eac7566929eee8.\n", "files": ["dom/media/gmp/GMPProcessParent.cpp", "dom/media/ipc/RDDProcessHost.cpp", "dom/media/ipc/RDDProcessHost.h", "gfx/ipc/GPUProcessHost.cpp", "gfx/ipc/GPUProcessHost.h", "gfx/vr/ipc/VRProcessParent.cpp", "gfx/vr/ipc/VRProcessParent.h", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h", "ipc/glue/NodeChannel.cpp", "ipc/glue/NodeChannel.h", "ipc/glue/NodeController.cpp", "ipc/glue/NodeController.h", "ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessHost.h", "ipc/ipdl/test/gtest/IPDLUnitTest.cpp"], "git_node": "fcb37cfb75d4ae2385f20bdd326d32546ad20513", "git_parents": ["d94