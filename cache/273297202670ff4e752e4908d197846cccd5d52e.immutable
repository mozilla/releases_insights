iewers,layout-reviewers,jwatt\n\nWe know those loads don't affect the styling of the document. A\nmalicious import could make such load and the subsequent error trigger\nat a bad time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343516\n", "files": ["dom/xml/nsXMLContentSink.cpp", "layout/style/FontFaceSetDocumentImpl.cpp", "layout/style/Loader.cpp", "layout/style/Loader.h"], "git_node": "5dc8166373e9128e8ddc2b59752c55423fdb1030", "git_parents": ["0d977e13c4a9fb2111bf100bc7238b9cd9575762"], "node": "b441aa5f321282e6a0d6925339d35814c1094619", "parents": ["d6a0f7466758adec1d1d41dc32de5e84cc03a22b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093703 - Document what `:dir()` follows in chrome documents in the RTL guidelines. r=desktop-theme-reviewers,kcochrane DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343281\n", "files": ["docs/code-quality/coding-style/rtl_guidelines.md"], "git_node": "b0e60bac402e3d1392cd4e267478fad8addd93bb", "git_parents": ["5dc8166373e9128e8ddc2b59752c55423fdb1030"], "node": "5d0c29293698fd1ee75b55b3caa0feae60d84801", "parents": ["b441aa5f321282e6a0d6925339d35814c1094619"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2093299 - Make sure to get profile to avoid deadlock with Encryption r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343190\n", "files": ["netwerk/test/unit_ipc/test_http3_prio_enabled_wrap.js"], "git_node": "a6aa12b9ba4fbacb62529d0da244df9d269ab18f", "git_parents": ["b0e60bac402e3d1392cd4e267478fad8addd93bb"], "node": "dfa28d0b8c4ece4829a43414a85393c7676c913e", "parents": ["5d0c29293698fd1ee75b55b3caa0feae60d84801"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2093250 - Ignore the a11y check when clicking bookmark or history rows r=sidebar-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343409\n", "files": ["browser/components/sidebar/tests/browser/browser_places_sidebar.js"], "git_node": "082b8300ec0e5431ac2b3dcbb862cc2f7dc848a7", "git_parents": ["a6aa12b9ba4fbacb62529d0da244df9d269ab18f"], "node": "4fd369c9680456b38053a859bfd35015a8e8234a", "parents": ["dfa28d0b8c4ece4829a43414a85393c7676c913e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090117 - Only let first-line re-parenting change first-line-allowed properties. r=firefox-style-system-reviewers,layout-reviewers,jwatt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343518\n", "files": ["servo/components/style/properties/cascade.rs", "servo/components/style/properties/properties.mako.rs"], "git_node": "6009e601af92ea57df6024b6e508fc93a11af7e9", "git_parents": ["082b8300ec0e5431ac2b3dcbb862cc2f7dc848a7"], "node": "49962f781e5498d40d729f56c42758bbacdfb0ad", "parents": ["4fd369c9680456b38053a859bfd35015a8e8234a"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2086148 - Fix reading of the \"marionette.navigate-after-click.*\" preferences. r=webdriver-reviewers,Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343099\n", "files": ["remote/marionette/prefs.sys.mjs", "remote/marionette/test/xpcshell/test_prefs.js"], "git_node": "d824b5b94a1c32f35d212a9aeee321cd5f2b4c63", "git_parents": ["6009e601af92ea57df6024b6e508fc93a11af7e9"], "node": "be8c36d3251f2e4dce7e1835f3e9becf0ea764c0", "parents": ["49962f781e5498d40d729f56c42758bbacdfb0ad"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2090969 - Close the IndexedDB connection opened by browser_storage_fission_indexeddb.js, r=devtools-reviewers,nchevobbe.\n\nThe connection left open blocked the head.js cleanup's deleteDatabase until\nits 10s timeout on every run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340951\n", "files": ["devtools/client/storage/test/browser_storage_fission_indexeddb.js"], "git_node": "3e8f2dc21f216807667e6763b2a6e0ca0700db30", "git_parents": ["d824b5b94a1c32f35d212a9aeee321cd5f2b4c63"], "node": "5daebfbfb38ac57fad821f92425464df06d862f5", "parents": ["be8c36d3251f2e4dce7e1835f3e9becf0ea764c0"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2090969 - [devtools] Don't create missing IndexedDB databases when reading them from the storage inspector, r=devtools-reviewers,bomsy.\n\nThis happened when the inspector read a database while the page was\ndeleting it; a page opening it at version 1 then never got upgradeneeded.\nDatabases that vanish this way are now skipped when listing a host's stores,\nand getObjectStoreData's error path, which the abort now reaches, no longer\ncloses an undefined db.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340952\n", "files": ["devtools/server/actors/resources/storage/indexed-db.js"], "git_node": "97b6f1e92eb2ce55603df734c62fb98716edd5f7", "git_parents": ["3e8f2dc21f216807667e6763b2a6e0ca0700db30"], "node": "ccabeb64ffb99829ed117a3715d90b32b7a5639f", "parents": ["5daebfbfb38ac57fad821f92425464df06d862f5"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079920 - Fix infobar icon alignment r=desktop-theme-reviewers,reusable-components-reviewers,tgiles,fterdal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342599\n", "files": ["toolkit/content/widgets/infobar.css"], "git_node": "1159ac19d463a56c3f2eee9af74096f0d13fab17", "git_parents": ["97b6f1e92eb2ce55603df734c62fb98716edd5f7"], "node": "51122e7b66a1b360e9ae6f59418ba6d3eb4a735a", "parents": ["ccabeb64ffb99829ed117a3715d90b32b7a5639f"], "tags": []}, {"author": "Jonathan Kew \u003cjfkthame@gmail.com\u003e", "branch": "default", "desc": "Bug 2082015 - Refresh the line iterator on each iteration of GetNextPrevLineFromBlockFrame. r=layout-reviewers,jwatt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343522\n", "files": ["layout/generic/nsIFrame.cpp"], "git_node": "8e9a95cf901c8d56d9cda5c0fc01a97562563381", "git_parents": ["1159ac19d463a56c3f2eee9af74096f0d13fab17"], "node": "2bd2c57706ca534e289c4d48d0c44f11f6435eb9", "parents": ["51122e7b66a1b360e9ae6f59418ba6d3eb4a735a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093872 - Vendor application-services to 09df0c1918dc8e08f1ed94bbd7af6c85b9426a9a r=bdk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343386\n", "files": ["third_party/application-services/components/ads-client/src/ads_store.rs", "third_party/application-services/components/ads-client/src/ads_store/store.rs", "third_party/application-services/components/fxa-client/src/auth.rs", "third_party/application-services/components/fxa-client/src/internal/mod.rs", "third_party/application-services/components/fxa-client/src/internal/oauth.rs", "third_party/application-services/components/fxa-client/src/internal/state_manager.rs", "third_party/application-services/components/fxa-client/src/internal/state_persistence.rs", "third_party/application-services/components/fxa-client/src/state_machine/helpers.rs", "third_party/application-services/components/fxa-client/src/state_machine/mod.rs", "third_party/application-services/components/fxa-client/src/state_machine/transitions.rs", "third_party/application-services/components/remote_settings/src/service.rs", "third_party/application-services/components/remote_settings/src/telemetry.rs", "third_party/application-services/components/support/nimbus-fml/src/backends/frontend_manifest.rs", "third_party/application-services/components/support/nimbus-fml/src/command_line/workflows.rs", "third_par