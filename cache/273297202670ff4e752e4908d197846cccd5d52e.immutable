stBreachAlerts.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustContextId.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustDbCrypto.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFilterAdult.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFxcontainers.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "ef6a044982edd87323f39f056341e4fbfb653e8d", "git_parents": ["7780e0663d57f823875fffbf3a5802278317fd77"], "node": "f34bdfcf4bfcae488c9c428194e052654c144310", "parents": ["2d73c12f2efc344b954c0149f9d9ec438ee04d87"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2093715 - Update app-services-tools nimbus-fml to the new API r=markh\n\nAs of bug 2066497 this function no longer takes any arguments.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343299\n", "files": ["services/app-services-tools/nimbus-fml/src/bin/nimbus-fml.rs"], "git_node": "5bb2c8316ef369daffe419d451f52db4ff894e08", "git_parents": ["ef6a044982edd87323f39f056341e4fbfb653e8d"], "node": "35421d30fc4434eb3f7ceacd40640f70a99a3e05", "parents": ["f34bdfcf4bfcae488c9c428194e052654c144310"], "tags": []}, {"author": "John Reitano \u003cjreitano@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089980 - Delete the nsProfileLock copy constructor. r=sylvestre,jhirsch\n\nIt called operator=, and so Unlock(), on uninitialized members. Nothing uses it, so mark it deleted rather than fix it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343722\n", "files": ["toolkit/profile/nsProfileLock.cpp", "toolkit/profile/nsProfileLock.h"], "git_node": "b97861eb2a14c407b694a173293753ee77aa6ad0", "git_parents": ["5bb2c8316ef369daffe419d451f52db4ff894e08"], "node": "f1c054a568c23e7f3722ce66d638b99f365c1082", "parents": ["35421d30fc4434eb3f7ceacd40640f70a99a3e05"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2092145 - Do not require an android build environment to run nimbus-cli r=geckoview-reviewers,android-build-system-reviewers,ahochheiden,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343234\n", "files": ["mobile/android/mach_commands.py"], "git_node": "ca65a967716dc9526c29bcd740d6bd23c5874793", "git_parents": ["b97861eb2a14c407b694a173293753ee77aa6ad0"], "node": "e6c8dcb6fb976d9b02f49c29936bdb350318a7f5", "parents": ["f1c054a568c23e7f3722ce66d638b99f365c1082"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1893684 - Introduce sectionheader and sectionfooter aria roles. r=accessibility-platform-reviewers,morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338831\n", "files": ["accessible/base/ARIAMap.cpp", "accessible/base/RoleMap.inc", "accessible/html/HTMLElementAccessibles.cpp", "accessible/interfaces/nsIAccessibleRole.idl", "accessible/mac/mozAccessible.mm", "accessible/tests/browser/mac/browser_roles_elements.js", "accessible/tests/browser/role/browser_computedARIARole.js", "accessible/tests/browser/role/browser_roles_generic.js", "accessible/tests/browser/windows/uia/browser_generalProps.js", "accessible/tests/mochitest/elm/test_HTMLSpec.html", "accessible/tests/mochitest/role.js", "accessible/tests/mochitest/role/test_general.html", "accessible/windows/uia/uiaRawElmProvider.cpp", "accessible/windows/uia/uiaRawElmProvider.h", "dom/locales/en-US/chrome/accessibility/mac/accessible.properties", "dom/locales/en-US/chrome/accessibility/win/accessible.properties", "testing/web-platform/meta/core-aam/aamtests/role/sectionfooter.py.ini", "testing/web-platform/meta/core-aam/aamtests/role/sectionheader.py.ini", "testing/web-platform/meta/html-aam/roles-contextual.tentative.html.ini", "testing/web-platform/meta/wai-aria/role/contextual-roles.tentative.html.ini", "testing/web-platform/meta/wai-aria/role/roles.tentative.html.ini", "xpcom/ds/StaticAtoms.py"], "git_node": "2d6f060435e87563b7cdc8e3ccac551a188f5077", "git_parents": ["ca65a967716dc9526c29bcd740d6bd23c5874793"], "node": "ea8798e4781260fde2b231dfe5cdfd760ee4b394", "parents": ["e6c8dcb6fb976d9b02f49c29936bdb350318a7f5"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060917 - Part 1: Make ::cue the block that holds the cue lines. r=emilio\n\nThe WebVTT spec applies ::cue to the list of WebVTT Node Objects, the block\nthat holds the cue lines, and applies its background properties to the WebVTT\ncue background box, the inline box around the cue text [1]. We applied ::cue\nto the inline box, and the block had a fixed font. Thus author ::cue rules could\nnot change the line height.\n\nNow the block is the ::cue element and takes all ::cue rules. The inline box\ninherits the background properties from it, and the ::cue block does not paint\nits own background. Thus the background is painted once, behind the text, and\nno new pseudo-element or cascade filter is necessary. The user agent defaults\nof the spec move to the ::cue rule in html.css [2]. These defaults include\ntext-wrap: balance and unicode-bidi: plaintext, so the old workaround that set\nplaintext late is removed.\n\nThe ::cue block keeps its position and size in its style attribute. Only\nprivileged code sets the style attribute of a pseudo-element, so the property\nrestrictions of pseudo-elements no longer apply to it. The cascade now decides\nonce for each rule whether the restriction applies, not for each declaration.\n\n[1] https://w3c.github.io/webvtt/#the-cue-pseudo-element\n[2] https://w3c.github.io/webvtt/#applying-css-properties\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342860\n", "files": ["dom/media/webvtt/vtt.sys.mjs", "layout/painting/nsDisplayList.cpp", "layout/style/res/html.css", "servo/components/style/properties/cascade.rs", "toolkit/themes/shared/media/videocontrols.css"], "git_node": "08cbd0f921fb2933674535c55b90e06d67ec3313", "git_parents": ["2d6f060435e87563b7cdc8e3ccac551a188f5077"], "node": "dedc91d940c8ca5ab9776e81cdfc187abc8927e0", "parents": ["ea8798e4781260fde2b231dfe5cdfd760ee4b394"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060917 - Part 2: Remove text-wrap from the properties that ::cue takes. r=emilio\n\nThe WebVTT spec lists the properties that apply to ::cue, and text-wrap is not\none of them [1]. We allowed the text-wrap shorthand there, so a page could turn\noff the text-wrap: balance default that the spec gives the cue [2].\n\nNow ::cue rules from pages drop text-wrap-style. text-wrap-mode still applies,\nbecause white-space is in the list and sets it.\n\nThe new reftest checks that a ::cue rule with text-wrap-style: stable does not\nchange the balanced lines of a cue.\n\n[1] https://w3c.github.io/webvtt/#the-cue-pseudo-element\n[2] https://w3c.github.io/webvtt/#applying-css-properties\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343393\n", "files": ["layout/style/test/property_database.js", "servo/components/style/properties/data.py", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue/text-wrap_not_allowed-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue/text-wrap_not_allowed.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/support/three_words.vtt"], "git_node": "0963384d51ea1e2a0ccbbdd9486a64dcdac944d1", "git_parents": ["08cbd0f921fb2933674535c55b90e06d67ec3313"], "node": "f293e60c21ed91185a59fba650a8c0b977bbbf13", "parents": ["dedc91d940c8ca5ab9776e81cdfc187abc8927e0"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060917 - Part 3: Update the expectations of the WebVTT reftests that ::cue now passes. r=media-playback-reviewers,padenot\n\nPart 1 puts ::cue on the block that holds the cue lines, as the spec says [1].\nThus the cues have the correct position, size and line height, and many\nWebVTT reftests now pass.\n\nRemove the failure expectations of these tests. Some differ from their\nreferences by one colour level on some platforms, so they get fuzzy ranges.\ndom_override_cue_line.html still fails on Windows (bug 2088668), and\ninherit_values_from_media_element.html still fails on Android (bug 2088741).\nfontsize_smaller_than_container.tentative.html now fails, because its\nreference does not follow the spec [2].\n\n[1] https://w3c.github.io/webvtt/#the-cue-pseudo-element\n[2] https://github.com/w3c/webvtt/issues/530\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343394\n", "files": ["testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_line.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/evil/media_height_19.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/evil/size_90.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/evil/size_99.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/line_0_is_top.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/line_50_percent.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/one_line_cue_plus_wrapped_cue.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/portrait.tentative.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/color_hex.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/color_hsla.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/color_rgba.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/fontsize_smaller_than_container.tentative.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/inherit_values_from_media_element.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/outline_properties.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/outline_shorthand.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/white-space_pre-line_wrapped.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/class_object/class_namespace.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_namespace.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/white-space_pre-line_wrapped.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/size_50.html.ini"], "git_node": "4ced00dd63cf0acecbf43d7aff9d88eb2083408b", "git_parents": ["0963384d51ea1e2a0ccbbdd9486a64dcdac944d1"], "node": "422d39e248e5a59150b213ad5d74a3fb061f56df", "parents": ["f293e60c21ed91185a59fba650a8c0b977bbbf13"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060917 - Part 4: Test which cue boxes ::cue styles. r=media-playback-reviewers,padenot\n\nCheck that the ::cue font reaches the block that holds the cue lines and sets\ntheir height, and that the ::cue background is painted only by the inline box\naround the cue text [1].\n\n[1] https://w3c.github.io/webvtt/#the-cue-pseudo-element\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342861\n", "files": ["dom/media/webvtt/test/mochitest/cue_layout_helpers.js", "dom/media/webvtt/test/mochitest/mochitest.toml", "dom/media/webvtt/test/mochitest/test_webvtt_cue_pseudo_element.html"], "git_node": "fd9f511efe1c8a7bf053bfc4a8c19daad6dbfe31", "git_parents": ["4ced00dd63cf0acecbf43d7aff9d88eb2083408b"], "node": "5b637d8548b4a864b0abc5724519ffb0945bf244", "parents": ["422d39e248e5a59150b213ad5d74a3fb061f56df"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2094355 - Pass the home region to the Travel widget frame in its URL fragment. r=Dre\"\n\nThis reverts commit 8289e23c523afb9fbfef02b5c82432cc815d55ca.\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Travel/Travel.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Travel.test.jsx"], "git_node": "abe496e9e5b8ae10f4633b012613e6cfedf23e27", "git_parents": ["fd9f511efe1c8a7bf053bfc4a8c19daad6dbfe31"], "node": "e3834a986a08ec83746cb2621d1f4b5f7bfb18e7", "parents": ["5b637d8548b4a864b0abc5724519ffb0945bf244"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2094356 - Send the Travel widget frame an interaction_state action so it can move its hero text clear of the New badge. r=Dre\" for causing failures at browser_framed_widgets.js.\n\nThis reverts commit 630af3ada5173e57472b150d546f26d331c51235.\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Travel/Travel.jsx", "browser/extensions/newtab/content-src/components/Widgets/useFramedWidgetMessages.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Travel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/useFramedWidgetMessages.test.jsx"], "git_node": "8da3dde8632becef3c0e7a1baffbe9c7b71db472", "git_parents": ["abe496e9e5b8ae10f4633b012613e6cfedf23e27"], "node": "2d2a69dc3bb78486644cf75de6341faa2f52d78c", "parents": ["e3834a986a08ec83746cb2621d1f4b5f7bfb18e7"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2093679 - Inline AutoCheckRecursionLimit's FrontendContext checks. r=arai\n\nAutoCheckRecursionLimit::check(FrontendContext*) read the stack limit through\ngetStackLimit, which was defined out of line in jsfriendapi.cpp because\njs/friend/StackLimits.h can't see FrontendContext's definition. Every\nrecursion check in the parser, the bytecode emitter, constant folding and name\nresolution therefore made a call to load one field.\n\nDefine the FrontendContext overloads in frontend/FrontendContext.h instead,\nwhere they can read FrontendContext::stackLimit() directly, and leave only\ntheir declarations in StackLimits.h. Defining them in StackLimits.h with an\ninline getStackLimit doesn't work: every file including the header would\nodr-use getStackLimit without its definition (-Wundefined-inline).\ngetStackLimit and the debug-only CheckAndUpdateFrontendContextRecursionLimit\nwrapper, which existed for the same reason, are removed, and\nParseNodeVisitor.h now includes FrontendContext.h.\n\nOn an Apple M4 Max, getStackLimit took 1.1% of JetStream 3's web-ssr and\nmulti-inspector-code-load. Over 40 rounds of the five code-load tests, each\nrunning this change and its parent in two code layouts, instructions fall\n1.65% (95% confidence interval 1.49% to 1.81%) and cycles 1.20% (0.38% to\n2.02%).\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343248\n", "files": ["js/public/friend/StackLimits.h", "js/src/frontend/FrontendContext.cpp", "js/src/frontend/FrontendContext.h", "js/src/frontend/ParseNodeVisitor.h", "js/src/jsfriendapi.cpp"], "git_node": "fa1fcaf68a63f461449586a2a66ae91ef14d1723", "git_parents": ["8da3dde8632becef3c0e7a1baffbe9c7b71db472"], "node": "7c8ce470731a67b817123935fb0dfe79b7356020", "parents": ["2d2a69dc3bb78486644cf75de6341faa2f52d78c"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "dfa6944f24babada8f1b360a617714e847dfc891", "git_parents": ["fa1fcaf68a63f461449586a2a66ae91ef14d1723", "524e4e57a3321306bc6f9e6fe8bb11a35287dae5"], "node": "710766b9c5828134af1153bc988f9eb1b6d5855f", "parents": ["7c8ce470731a67b817123935fb0dfe79b7356020", "1038c442e5194e713080203d7767f99c87020978"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2094362 - replace device's tabs record with an empty when when tab syncing is turned off r=markh,sync-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343756\n", "files": ["services/sync/modules/engines/tabs.sys.mjs", "services/sync/modules/stages/enginesync.sys.mjs", "services/sync/tests/unit/test_tab_quickwrite.js", "services/sync/tests/unit/xpcshell.toml"], "git_node": "34882b1189e3b455b69b4b8d9b315c7b397b659b", "git_parents": ["dfa6944f24babada8f1b360a617714e847dfc891"], "node": "c236d3b2af0190d21c1cce2b408abc83a2cc1184", "parents": ["710766b9c5828134af1153bc988f9eb1b6d5855f"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091072 - Fail engines that need a meta/syncids record in a newer format. r=markh,sync-reviewers\n\nPreviously a newer-format registry was ignored and treated as read-only, so\nengines missing from meta/global kept syncing with local sync IDs that newer\nclients never see. We should treat it like a newer engine version instead: those\nengines fail with VERSION_OUT_OF_DATE until the client is upgraded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341115\n", "files": ["services/sync/modules/stages/syncids.sys.mjs", "services/sync/tests/unit/test_service_sync_updateEnabledEngines.js"], "git_node": "ed2ebb66761f412675fc56466dcefc3e7b73a8e0", "git_parents": ["34882b1189e3b455b69b4b8d9b315c7b397b659b"], "node": "13e1c893e9cd6e7419344f5733ddb60fabddd3fe", "parents": ["c236d3b2af0190d21c1cce2b408abc83a2cc1184"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2088689 - Add a browser.urlbar.resultTargetMenu.featureGate pref and Nimbus variable to show 'Open in ...' items on result menu r=urlbar-reviewers,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339390\n", "files": ["browser/app/profile/firefox.js", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js", "browser/components/urlbar/tests/browser-newtab/browser_resultMenuOpenIn.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "36b9bb16b2acf04f26a03987442a2c1098739195", "git_parents": ["ed2ebb66761f412675fc56466dcefc3e7b73a8e0"], "node": "528e0b17179fea9a964a36b8d839d3629fb55d93", "parents": ["13e1c893e9cd6e7419344f5733ddb60fabddd3fe"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2093887 - Add a Nimbus variable for browser.urlbar.contextMenu.featureGate r=adw,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343396\n", "files": ["browser/app/profile/firefox.js", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "172f176559a6f14c934d598c86cbfc3165515eb9", "git_parents": ["36b9bb16b2acf04f26a03987442a2c1098739195"], "node": "8499b183e3fda105b774a1cc129c4c5f787a7f22", "parents": ["528e0b17179fea9a964a36b8d839d3629fb55d93"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 1169485 - Let MSE container parsers declare implicit initialization segments and bytes to ignore. r=media-playback-reviewers,alwu\n\nIn the MPEG audio byte stream format, every frame header is an\ninitialization segment and is also part of the media segment that follows\nit. TrackBuffersManager assumed initialization segments have bytes of their\nown, and re-parsed the stored one as input when the parser state is reset.\n\nThe format also has metadata frames that must be ignored. Remove them from\nthe start of the input buffer while waiting for a segment, as step 3 of the\nsegment parser loop says, rather than requiring the demuxer to skip them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339669\n", "files": ["dom/media/mediasource/ContainerParser.h", "dom/media/mediasource/TrackBuffersManager.cpp"], "git_node": "225e4de8021d2d369f37fcdf4b375af250a9110e", "git_parents": ["172f176559a6f14c934d598c86cbfc3165515eb9"], "node": "45dd73a4891c717a9ecaaf699580e398eced9ed4", "parents": ["8499b183e3fda105b774a1cc129c4c5f787a7f22"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 1169485 - Add a container parser and demuxer for the MSE MPEG audio byte stream format. r=media-playback-reviewers,alwu\n\nOnly a frame header that changes the layer, sample rate or channel count is\nreported as an initialization segment, so that a demuxer isn't created for\neach frame. Metadata frames and garbage are ignored, resynchronizing after\ngarbage as in Chromium, so media segments only hold frames. Xing/Info frames\nare dropped.\n\nLayers I and II are supported as in Chromium: the decoder handles them, and\nhls.js uses audio/mpeg for all MPEG audio once it's supported.\n\nMP3TrackDemuxer and its frame parser aren't used: the parser only accepts\nLayer III, and the demuxer needs several frames to initialize and seeks back\ninto bytes that TrackBuffersManager has already evicted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339670\n", "files": ["dom/media/mediasource/ContainerParser.cpp", "dom/media/mediasource/MPEGAudioByteStream.cpp", "dom/media/mediasource/MPEGAudioByteStream.h", "dom/media/mediasource/MPEGAudioByteStreamDemuxer.cpp", "dom/media/mediasource/MPEGAudioByteStreamDemuxer.h", "dom/media/mediasource/TrackBuffersManager.cpp", "dom/media/mediasource/gtest/TestContainerParser.cpp", "dom/media/mediasource/gtest/TestMPEGAudioByteStream.cpp", "dom/media/mediasource/gtest/moz.build", "dom/media/mediasource/moz.build"], "git_node": "9280f70d1ec997e2d8a4b23a437bf9cd7fd79a97", "git_parents": ["225e4de8021d2d369f37fcdf4b375af250a9110e"], "node": "1b30a20201a4e47e19ecc3eb4411c3bcd76c5bee", "parents": ["45dd73a4891c717a9ecaaf699580e398eced9ed4"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 1169485 - Support audio/mpeg in MediaSource on Nightly. r=media-playback-reviewers,aosmond\n\nIt's behind media.mediasource.mp3.enabled. The new WPT checks what the byte\nstream format says about metadata frames, which Chrome passes too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339672\n", "files": ["dom/media/mediasource/MediaSource.cpp", "dom/media/mediasource/test/mochitest.toml", "dom/media/mediasource/test/mp1_tone.mp1", "dom/media/mediasource/test/mp2_click.mp2", "dom/media/mediasource/test/mp3_crc.mp3", "dom/media/mediasource/test/test_MP3_AbortAndResync.html", "dom/media/mediasource/test/test_MP3_Append.html", "dom/media/mediasource/test/test_MP3_RemoveAndEvict.html", "dom/media/mediasource/test/test_MP3_TypeSupport.html", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/media-source/__dir__.ini", "testing/web-platform/meta/media-source/mediasource-addsourcebuffer-mode.html.ini", "testing/web-platform/meta/media-source/mediasource-changetype.html.ini", "testing/web-platform/meta/media-source/mediasource-sourcebuffer-mode-timestamps.html.ini", "testing/web-platform/tests/media-source/mediasource-mpeg-audio-metadata.html"], "git_node": "78c73bc62172d3165d27afbb74125942f42db14c", "git_parents": ["9280f70d1ec997e2d8a4b23a437bf9cd7fd79a97"], "node": "3a826f8649e5506c977f82f0906a6bbbaaa549b0", "parents": ["1b30a20201a4e47e19ecc3eb4411c3bcd76c5bee"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 1169485 - Advance generated timestamps over frames dropped before appendWindowStart. r=media-playback-reviewers,alwu\n\nOtherwise, once a frame is dropped for starting before appendWindowStart,\nevery following frame gets the same timestamp and is dropped too, so\ntrimming the start of an MPEG audio stream with the append window (or a\nnegative timestampOffset) buffers nothing. Chrome advances the timestamps.\nThe last decode timestamp advances as well, so that no discontinuity is\ndetected among the dropped frames, which would rewind the timestamps as it\ndoes in Chrome. The group end timestamp is left alone, so the dropped\nframes don't extend the duration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339673\n", "files": ["dom/media/mediasource/TrackBuffersManager.cpp", "dom/media/mediasource/test/mochitest.toml", "dom/media/mediasource/test/test_MP3_AppendWindow.html"], "git_node": "8eb8ffb5649e633f11a179893ae682b47cd014d9", "git_parents": ["78c73bc62172d3165d27afbb74125942f42db14c"], "node": "873cb2d809c380bf6d844ffb904cf57afd901bc2", "parents": ["3a826f8649e5506c977f82f0906a6bbbaaa549b0"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 1169485 - Compensate for the MPEG audio decoder delay in MediaSource. r=media-playback-reviewers,alwu\n\nMPEG audio decoders output audio late: by 529 samples for Layer III, and by\n241 for Layers I and II, the decoder's share of their filterbank delay.\nMP3TrackDemuxer compensates for it in file playback, and Chromium drops the\nfirst 529 samples a decoder outputs after it starts, whatever the layer. Do\nthe same for audio/mpeg in MediaSource, with the delay of each layer, so that\nthe audio lines up with the coded frame timestamps. Trimming to the append\nwindow stays sample accurate, including the audio that the decoder only\noutputs with the following frame.\n\nThe byte stream demuxer declares the delay in Mp3CodecSpecificData, so MP3\nfrom other containers, whose timestamps come from the container, is\nunaffected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339674\n", "files": ["dom/media/MediaInfo.h", "dom/media/mediasource/MPEGAudioByteStreamDemuxer.cpp", "dom/media/mediasource/MediaSourceDemuxer.cpp", "dom/media/mediasource/MediaSourceDemuxer.h", "dom/media/mediasource/gtest/TestMPEGAudioByteStream.cpp", "dom/media/mediasource/test/flac_click.mp4", "dom/media/mediasource/test/mochitest.toml", "dom/media/mediasource/test/mp3_click.mp3", "dom/media/mediasource/test/test_MP3_DecoderDelay.html"], "git_node": "fccbd166ba8cf8c7ab430842a5900ba1693ad363", "git_parents": ["8eb8ffb5649e633f11a179893ae682b47cd014d9"], "node": "ae7ce5a4c58eef39478337d0469832acab25a14a", "parents": ["873cb2d809c380bf6d844ffb904cf57afd901bc2"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 1169485 - Fuzz the MSE MPEG audio container parser and demuxer. r=media-playback-reviewers,alwu\n\nThe driver appends the input in chunks and demuxes each media segment, as\nTrackBuffersManager does, and checks that the demuxer agrees with the parser\nabout the segments. It runs as the MediaSourceMPEGAudio libFuzzer target in\nfuzzing builds, and over mutated streams in a gtest everywhere else.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339675\n", "files": ["dom/media/mediasource/gtest/TestMPEGAudioByteStream.cpp", "dom/media/mediasource/gtest/moz.build"], "git_node": "8be1b0fe9664024659c87ce6eefac27c85a87fe6", "git_parents": ["fccbd166ba8cf8c7ab430842a5900ba1693ad363"], "node": "ca8d9dc6d5e02229f731902d73e4dc47abfb5713", "parents": ["ae7ce5a4c58eef39478337d0469832acab25a14a"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2093551 - Stop reverting the urlbar when opening a result in a background tab r=adw,urlbar-reviewers\n\nDepends on D343396\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343448\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js"], "git_node": "12fd688b955873eaaf5fc16cfeba2f53153c2ccd", "git_parents": ["8be1b0fe9664024659c87ce6eefac27c85a87fe6"], "node": "c693cec29dedd867069a8ac0741e2b349a1d5dc4", "parents": ["ca8d9dc6d5e02229f731902d73e4dc47abfb5713"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082787 - Remove layout containment from moz-widget r=fchasen\n\nThe `:host` rule of moz-widget now uses `contain: size paint style`\ninstead of `contain: strict`. Widgets keep their size, clip their\ncontent and anchor the menu button as before, but layout now reflows\nwidgets together with the rest of the page.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343442\n", "files": ["browser/components/widgets/content/moz-widget.css"], "git_node": "41699c8d7b45bc9e8658318e3ff5910dbc9c44d1", "git_parents": ["12fd688b955873eaaf5fc16cfeba2f53153c2ccd"], "node": "c48cd240a7749817ce4f70dd808c2a6f5d442f47", "parents": ["c693cec29dedd867069a8ac0741e2b349a1d5dc4"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060917 - Part 4: Test which cue boxes ::cue styles. r=media-playback-reviewers,padenot\" for causing failures at text-wrap_not_allowed.html.\n\nThis reverts commit fd9f511efe1c8a7bf053bfc4a8c19daad6dbfe31.\n\nRevert \"Bug 2060917 - Part 3: Update the expectations of the WebVTT reftests that ::cue now passes. r=media-playback-reviewers,padenot\"\n\nThis reverts commit 4ced00dd63cf0acecbf43d7aff9d88eb2083408b.\n\nRevert \"Bug 2060917 - Part 2: Remove text-wrap from the properties that ::cue takes. r=emilio\"\n\nThis reverts commit 0963384d51ea1e2a0ccbbdd9486a64dcdac944d1.\n\nRevert \"Bug 2060917 - Part 1: Make ::cue the block that holds the cue lines. r=emilio\"\n\nThis reverts commit 08cbd0f921fb2933674535c55b90e06d67ec3313.\n", "files": ["dom/media/webvtt/test/mochitest/cue_layout_helpers.js", "dom/media/webvtt/test/mochitest/mochitest.toml", "dom/media/webvtt/test/mochitest/test_webvtt_cue_pseudo_element.html", "dom/media/webvtt/vtt.sys.mjs", "layout/painting/nsDisplayList.cpp", "layout/style/res/html.css", "layout/style/test/property_database.js", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/data.py", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/dom_override_cue_line.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/evil/media_height_19.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/evil/size_90.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/evil/size_99.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/line_0_is_top.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/line_50_percent.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/one_line_cue_plus_wrapped_cue.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/portrait.tentative.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/color_hex.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/color_hsla.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/color_rgba.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/fontsize_smaller_than_container.tentative.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/inherit_values_from_media_element.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/outline_properties.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/outline_shorthand.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/white-space_pre-line_wrapped.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/class_object/class_namespace.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_namespace.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/white-space_pre-line_wrapped.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/size_50.html.ini", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue/text-wrap_not_allowed-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue/text-wrap_not_allowed.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/support/three_words.vtt", "toolkit/themes/shared/media/videocontrols.css"], "git_node": "ba42f5bef0ac5ac4b833ac6e2f1686ee75e768af", "git_parents": ["41699c8d7b45bc9e8658318e3ff5910dbc9c44d1"], "node": "28f61b5598c0d2e2e009e8b76d8e5749b67ddf3c", "parents": ["c48cd240a7749817ce4f70dd808c2a6f5d442f47"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1893684 - Introduce sectionheader and sectionfooter aria roles. r=accessibility-platform-reviewers,morgan\" for causing wpt failures @role-updates-after-move.html.\n\nThis reverts commit 2d6f060435e87563b7cdc8e3ccac551a188f5077.\n", "files": ["accessible/base/ARIAMap.cpp", "accessible/base/RoleMap.inc", "accessible/html/HTMLElementAccessibles.cpp", "accessible/interfaces/nsIAccessibleRole.idl", "accessible/mac/mozAccessible.mm", "accessible/tests/browser/mac/browser_roles_elements.js", "accessible/tests/browser/role/browser_computedARIARole.js", "accessible/tests/browser/role/browser_roles_generic.js", "accessible/tests/browser/windows/uia/browser_generalProps.js", "accessible/tests/mochitest/elm/test_HTMLSpec.html", "accessible/tests/mochitest/role.js", "accessible/tests/mochitest/role/test_general.html", "accessible/windows/uia/uiaRawElmProvider.cpp", "accessible/windows/uia/uiaRawElmProvider.h", "dom/locales/en-US/chrome/accessibility/mac/accessible.properties", "dom/locales/en-US/chrome/accessibility/win/accessible.properties", "testing/web-platform/meta/core-aam/aamtests/role/sectionfooter.py.ini", "testing/web-platform/meta/core-aam/aamtests/role/sectionheader.py.ini", "testing/web-platform/meta/html-aam/roles-contextual.tentative.html.ini", "testing/web-platform/meta/wai-aria/role/contextual-roles.tentative.html.ini", "testing/web-platform/meta/wai-aria/role/roles.tentative.html.ini", "xpcom/ds/StaticAtoms.py"], "git_node": "72180c865fdab00109bf45996b18b55199149a5b", "git_parents": ["ba42f5bef0ac5ac4b833ac6e2f1686ee75e768af"], "node": "8580fe85a84184b93fc04241c06607807bcaf909", "parents": ["28f61b5598c0d2e2e009e8b76d8e5749b67ddf3c"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2093551 - Stop reverting the urlbar when opening a result in a background tab r=adw,urlbar-reviewers\" for causing bc failures @browser_locationBarCommand.js.\n\nThis reverts commit 12fd688b955873eaaf5fc16cfeba2f53153c2ccd.\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js"], "git_node": "ff789fb3eb25e0a675de21ebfa50b8f3d297cbfe", "git_parents": ["72180c865fdab00109bf45996b18b55199149a5b"], "node": "da8b9e3ac7882aeea1995d9e506d549383fe1e03", "parents": ["8580fe85a84184b93fc04241c06607807bcaf909"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2089067 - Mention another widget bug in the comment. r=hiro\n\nBug 2091573, a bug of Windows widget, causes the situation in which\nMULTITOUCH_END makes the touch count 0 and resets the phase even\nthough the finger is still on the screen.\n\nThe fix for bug 2089005, a Windows widget bug causing the same\nsituation, prevents a crash caused by bug 2091573 as well. So, this\npatch adds a mention in the code comment as future reference.\n\nNo test is added, because the MULTITOUCH_END including several\ncontacts is necessary to trigger bug 2091573 and such input can't\nbe reproduced on mochitest.\n(With native injection, nsWindow::InjectTouchPoint passes only a\nsingle contact to InjectTouchInput. With\napz.test.fails_with_native_injection enabled, the synthesized\nMULTITOUCH_END contains only the lifted touch.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343685\n", "files": ["widget/nsIWidget.cpp"], "git_node": "29668f1a7f56c4c015a80e085daf6643fe6eb66e", "git_parents": ["ff789fb3eb25e0a675de21ebfa50b8f3d297cbfe"], "node": "fb9de0ad1b5365d6574493990c0b1ea2e1093445", "parents": ["da8b9e3ac7882aeea1995d9e506d549383fe1e03"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2093306 - Fix a crash in touchscreen swipe when one finger lifts and another touches down at once while queueing inputs. r=hiro\n\nThe crash caused by a Windows widget bug (bug 2089005) can happen when\nreplaying the queued inputs in ReceiveTouchSwipableDirections() as well.\nSo the guard is necessary at that time, too.\n\nThis patch factors out the guard into the static member of TouchSwipeState\nand moves it into HandleTouchInputForSwipe().\nOne of the three call sites of HandleTouchInputForSwipe() doesn't need the\nguard, but that call site works with it as well.\n\nThis patch doesn't include a test case for the same reason explained on\nhttps://phabricator.services.mozilla.com/D339398 .\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343686\n", "files": ["widget/TouchSwipeState.cpp", "widget/TouchSwipeState.h", "widget/nsIWidget.cpp"], "git_node": "1453f834ba408b1293d82d0b7a0bd07a41fe4d2a", "git_parents": ["29668f1a7f56c4c015a80e085daf6643fe6eb66e"], "node": "2294c38e17be189586466563e3b9745d3aea27b4", "parents": ["fb9de0ad1b5365d6574493990c0b1ea2e1093445"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Match CSP nonces of inline content in allowsByNonce(); r=tschuster\n\nInstead of asking every source of a directive through allows() with CSP_NONCE,\nmatch its nonce-source expressions in nsCSPDirective::allowsByNonce(), like\nstep 2.1 of \"Does element match source list for type and source?\" does, and\ncall it through nsCSPPolicy::allowsByNonce() from GetAllowsInline().\n\nAlso make getNonce() return a reference, so that matching doesn't copy nonces,\nalso in DoesNonceMatchSourceList().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342815\n", "files": ["dom/security/nsCSPContext.cpp", "dom/security/nsCSPUtils.cpp", "dom/security/nsCSPUtils.h"], "git_node": "cb5e310c17bc6f1ab2ad5233856fbdb7f2321c25", "git_parents": ["1453f834ba408b1293d82d0b7a0bd07a41fe4d2a"], "node": "67b3bea52cb4b1e0e4bf349638d8c207387a1721", "parents": ["2294c38e17be189586466563e3b9745d3aea27b4"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 1933281 - Fallback to compare the order of event targets for CSSAnimation if they have the same time. r=jwatt,birtles\n\nJust like what we do for CSSTransition, we use the similar way to handle\nCSSAnimation with the same schedule time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D226212\n", "files": ["dom/animation/Animation.cpp", "dom/animation/Animation.h", "dom/animation/CSSAnimation.cpp", "dom/animation/CSSAnimation.h", "testing/web-platform/meta/css/css-animations/event-dispatch.tentative.html.ini"], "git_node": "e9f8b5f7549f0450114d9d509fb72917e57b62d9", "git_parents": ["cb5e310c17bc6f1ab2ad5233856fbdb7f2321c25"], "node": "f54885ddc8ba6cb3ddda3ba25f94c3561b0d16c6", "parents": ["67b3bea52cb4b1e0e4bf349638d8c207387a1721"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2092435 - Treat blocks without frames as word breaks in the inline spellchecker. r=masayuki\n\n`IsBreakElement()` in `mozInlineSpellWordUtil.cpp` treated an element without\na primary frame as inline, so the word splitter joined words across it.  When\na web app inserts or moves paragraphs and the idle spellcheck runs before the\nnext refresh constructs their frames, the last word of a paragraph and the\nfirst word of the next one are checked as one word, e.g. \"paragraphNew\", and\nthe wrong mark stays until the text is modified again.\n\nTherefore, this patch checks whether the frame of such an element will be\nconstructed lazily, i.e., the element or one of its flattened tree ancestors\nup to the nearest one with a non-leaf frame has `NODE_NEEDS_FRAME`.  If so,\nit uses the computed style of the element if it has been styled, otherwise,\nguesses from the default style of the element.  Elements which won't get a\nframe, e.g., in a `display: none` subtree, `display: contents`, not in the flat\ntree or children of a leaf frame, are still treated as inline like before.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342468\n", "files": ["extensions/spellcheck/src/moz.build", "extensions/spellcheck/src/mozInlineSpellWordUtil.cpp"], "git_node": "54f5db0677ebbc4a777756c18588006745ae240d", "git_parents": ["e9f8b5f7549f0450114d9d509fb72917e57b62d9"], "node": "5f6b5f35a9bd1d98f965643041f561886ca32edc", "parents": ["f54885ddc8ba6cb3ddda3ba25f94c3561b0d16c6"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2092435 - Test that the inline spellchecker does not join words across blocks without frames. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342469\n", "files": ["editor/spellchecker/tests/mochitest.toml", "editor/spellchecker/tests/test_spellcheck_across_unrendered_blocks.html"], "git_node": "6b9c338af0428d891fdd2afb4c5e75f688a8063f", "git_parents": ["54f5db0677ebbc4a777756c18588006745ae240d"], "node": "f3799e151dc849c448a947d6b6dbdfab862deb78", "parents": ["5f6b5f35a9bd1d98f965643041f561886ca32edc"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2091671 - Keep the hidden sections in place while a shown section is dragged r=android-reviewers,giorga\n\nWhile a shown section is dragged, the shown sections below it still close\nthe gap it leaves, but the hidden sections title, the hidden sections and\nthe reset button now stay where they are instead of moving up.\n\nAn empty space above the hidden sections title takes up the dragged\nsection's size.\nThe space is a node of its own in the hidden sections item, apart from\nthe title, so the title doesn't slide when the space changes size.\nThe line showing that the section is dropped last among the shown\nsections is drawn at the top of this space, where the last shown section\nends. The title only draws its line for a section dropped after it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341835\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuDragState.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuDropTarget.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuScreen.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/HiddenAreaSpace.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuContentTest.kt"], "git_node": "c77a7f05334612026c0391c7ccacc3526b21e805", "git_parents": ["6b9c338af0428d891fdd2afb4c5e75f688a8063f"], "node": "4aba468d7370111ad3b6b54a499889f66c6b6187", "parents": ["f3799e151dc849c448a947d6b6dbdfab862deb78"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2091712 - part 1 - Stop auto-scrolling when a found drop target is rejected r=android-reviewers,jdelorenzo\n\nA dragged item past the edge of a draggable list now scrolls it only if\nthe list found nothing to place it next to or drop it onto, whatever\ninterceptInteractionMode changes the interaction to.\n\nIn the customize menu on a short screen, a section held at the bottom\nof the screen is below the reset button once that is shown, so the\ntarget found for it is rejected. Scrolling then moved the reset button\nfurther up, keeping the target rejected, and the list scrolled to its\nend, taking all shown sections off the screen.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341836\n", "files": ["mobile/android/android-components/components/compose/draggable/src/main/java/mozilla/components/compose/draggable/InteractableList.kt", "mobile/android/android-components/components/compose/draggable/src/test/java/mozilla/components/compose/draggable/InteractableListTest.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuAutoScrollTest.kt"], "git_node": "2fdc582d9d98bbdc89ed67b8a14f0d6b80936a19", "git_parents": ["c77a7f05334612026c0391c7ccacc3526b21e805"], "node": "126f018ff255e619ba48d52b38739245c4076f0e", "parents": ["4aba468d7370111ad3b6b54a499889f66c6b6187"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2091712 - part 2 - Don't draw customize menu items moving out of view the wrong way r=android-reviewers,jdelorenzo\n\nWhile a section is dragged, the list keeps it laid out when it is\nscrolled out of view, before the items shown. Compose then takes it for\nthe first item shown, so a section still moving when it is scrolled out\nof view at the top is drawn moving down across the list to its end,\nthrough the hidden sections.\n\nUntil the dragged section is dropped in its place, the menu's items are\nnow drawn only while the list shows them. The list's layout is read only\nduring a drag, so outside one, scrolling does not redraw the items.\n\nCompose issue: https://issuetracker.google.com/issues/584383294\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341837\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenu.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuScreen.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/DrawnOnlyInView.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/DrawnOnlyInViewTest.kt"], "git_node": "fbf17e6410eadf3941aa93a8a3fd8e030e3e3fb5", "git_parents": ["2fdc582d9d98bbdc89ed67b8a14f0d6b80936a19"], "node": "b5650eb96b6b8d30118be07e73ea088388ce51be", "parents": ["126f018ff255e619ba48d52b38739245c4076f0e"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086547 - part 1 - Mark the customize menu titles as headings r=android-reviewers,giorga\n\nAlso check that Preview and Reset to default are read as buttons, as the design asks, which they already are.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342217\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuScreen.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuAccessibilityTest.kt"], "git_node": "67a346a5ac965431c7cc07fb396036bca0bbc899", "git_parents": ["fbf17e6410eadf3941aa93a8a3fd8e030e3e3fb5"], "node": "e1367972c2f95ab0c4856f3e77ccdf722b284300", "parents": ["b5650eb96b6b8d30118be07e73ea088388ce51be"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086547 - part 2 - Read each customize menu section as its item names and position r=android-reviewers,android-l10n-reviewers,giorga,flod\n\nThe position follows the names in the description, for TalkBack to read it after them,\nas in the design, whatever order of state and description is set in TalkBack.\nEg: \"VPN. Position 2 of 5\" or \"Back, Forward, Share, Refresh. Position 1 of 5\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342218\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenu.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuGroupSemantics.kt", "mobile/android/android-components/components/compose/menu/src/main/res/values/strings.xml", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuAccessibilityTest.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuAutoScrollTest.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuContentTest.kt"], "git_node": "2d090d89bf4d9dab6da361e65ac7cdc57a69a043", "git_parents": ["67a346a5ac965431c7cc07fb396036bca0bbc899"], "node": "a14c3c3772e0dcbb3c93f4fd7bd01f619ae1cc91", "parents": ["e1367972c2f95ab0c4856f3e77ccdf722b284300"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086547 - part 3 - Don't expose to screen readers how many items the customize menu list has r=android-reviewers,giorga\n\nNot all of them are menu sections so a read of the total would be confusing for the user.\nEach menu section already has their position and total of sections siblings read.\n\nBefore: \"VPN. Position 2 of 5. In list. 11 items\"\nAfter: \"VPN. Position 2 of 5. In list\"\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342220\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuScreen.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuAccessibilityTest.kt"], "git_node": "0c25037491c2bdc5d3b5bd5deae830a6ddb95415", "git_parents": ["2d090d89bf4d9dab6da361e65ac7cdc57a69a043"], "node": "5a0ae0ae02b6efef8f0bf69a5c1c3fb2be3393de", "parents": ["a14c3c3772e0dcbb3c93f4fd7bd01f619ae1cc91"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086547 - part 4 - Name the customize menu sections for screen readers r=android-reviewers,android-l10n-reviewers,giorga,flod\n\nEach section is read as a section: \"Section \u201cPage controls\u201d: Back, Forward, Share, Refresh\" for a\nnamed one, or \"Section \u201cVPN\u201d\" for one without a name. The name is quoted to make the string easier\nto translate.\n\nThe design names Page controls, Tools, Library, Accounts and settings and New tab.\nSaying \"section\" also keeps the New tab section from being read as \"New tab, New tab, New private\ntab\".\n\nTo test, with TalkBack on, open the menu, then Customize menu:\n1. Focus the first section: it reads \"Section \u201cPage controls\u201d: Back, Forward, Share, Refresh.\n   Position 1 of \u2026\".\n2. Focus the VPN section: it reads \"Section \u201cVPN\u201d. Position \u2026 of \u2026\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342221\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/data/MenuItemsGroup.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuGroupSemantics.kt", "mobile/android/android-components/components/compose/menu/src/main/res/values/strings.xml", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuAccessibilityTest.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuContentTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/configuration/BrowserMenuConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/configuration/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/configuration/BrowserMenuConfigurationTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/configuration/MenuSectionConfigurationTest.kt"], "git_node": "8dd6ef2d47fd03ecc4f38a3a8f2a82d4d517f23e", "git_parents": ["0c25037491c2bdc5d3b5bd5deae830a6ddb95415"], "node": "11128f1de674ec75c9d0949f4294da221a583df8", "parents": ["5a0ae0ae02b6efef8f0bf69a5c1c3fb2be3393de"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086547 - part 5 - Share how a move of the customize menu sections is saved r=android-reviewers,giorga\n\nMove it out of the drag handler, for the accessibility actions of the next commits to save their moves the same way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342222\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuDragState.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/utils/ext/CustomizableMenuStore.kt"], "git_node": "cc3545d78e5d158bb29526e9b4ed9278e06f596d", "git_parents": ["8dd6ef2d47fd03ecc4f38a3a8f2a82d4d517f23e"], "node": "6803fa49ad454a17b1eabaae1130bc7e04b5bcca", "parents": ["11128f1de674ec75c9d0949f4294da221a583df8"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086547 - part 6 - Move customize menu sections up and down with accessibility actions r=android-reviewers,android-l10n-reviewers,giorga,flod\n\nThe moves are saved the same way as the ones done by dragging.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342223\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenu.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuGroupSemantics.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuGroups.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuScreen.kt", "mobile/android/android-components/components/compose/menu/src/main/res/values/strings.xml", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuAccessibilityTest.kt"], "git_node": "eddd109929a104b1dc526ff4d8b5651adfdda18c", "git_parents": ["cc3545d78e5d158bb29526e9b4ed9278e06f596d"], "node": "2612e843acfe60efec1a79ca2cb849847c67f370", "parents": ["6803fa49ad454a17b1eabaae1130bc7e04b5bcca"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086547 - part 7 - Hide and show customize menu sections with accessibility actions r=android-reviewers,android-l10n-reviewers,giorga,flod\n\nThe sections which cannot be removed from the menu have no action hiding them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342224\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuGroupSemantics.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuGroups.kt", "mobile/android/android-components/components/compose/menu/src/main/res/values/strings.xml", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuAccessibilityTest.kt"], "git_node": "b0520a4696707fc72e19924360f39e333dba1200", "git_parents": ["eddd109929a104b1dc526ff4d8b5651adfdda18c"], "node": "e5b5561c637f3961805b185a6266413c0f067033", "parents": ["2612e843acfe60efec1a79ca2cb849847c67f370"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086547 - part 8 - Announce the result of the customize menu accessibility actions r=android-reviewers,android-l10n-reviewers,giorga,flod\n\nAfter Move up, Move down, Hide section or Unhide section, TalkBack now says\nwhat happened, e.g. \"Section \u201cVPN\u201d moved to position 3 of 5\",\n\"Section \u201cVPN\u201d removed\" or \"Section \u201cVPN\u201d added to menu\".\n\nThe announcement is drawn over the list, because TalkBack is not told about\nchanges to a node that another one covers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342225\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenu.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuGroupSemantics.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuScreen.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/utils/A11yUpdatesAnnouncer.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/utils/Constants.kt", "mobile/android/android-components/components/compose/menu/src/main/res/values/strings.xml", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuAccessibilityTest.kt"], "git_node": "659e59eb6291aa607312584b89d1e9618393f275", "git_parents": ["b0520a4696707fc72e19924360f39e333dba1200"], "node": "fdf94107d072505d425a4fecd0ccbcf88fece16e", "parents": ["e5b5561c637f3961805b185a6266413c0f067033"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086547 - part 9 - Keep the customize menu section moved by an accessibility action in view r=android-reviewers,giorga\n\nKeeping it laid out where it was, or bringing it into view, lets accessibility services keep their focus on it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342226\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuGroups.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuScreen.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuAccessibilityTest.kt"], "git_node": "c7c242e07d4ef1ede9907dd466e3b2dfeb86e0de", "git_parents": ["659e59eb6291aa607312584b89d1e9618393f275"], "node": "618807649f0deccf822fa688bc336120d2655609", "parents": ["fdf94107d072505d425a4fecd0ccbcf88fece16e"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086547 - part 10 - Read the customize menu preview as a heading for screen readers r=android-reviewers,android-l10n-reviewers,flod,giorga\n\nWhen the customize menu screen opens the menu as a preview, TalkBack now first reads\nthe whole menu as the heading \"Menu preview. Items can't be activated here.\", as the\ndesign asks, before its handle and items.\n\nIt is set on the view of the menu rather than on a Compose node, as a Compose node\ncan't be a focusable heading spanning the whole menu without TalkBack also reading\nits children.\n\nTo test:\n- Turn on TalkBack, open the customize menu screen and tap Preview.\n- \"Menu preview. Items can't be activated here, heading\" is read first, with the\n  focus around the whole menu, then \"Close menu\" and the menu items one by one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343143\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "11aed36600cf627bd608b8d7d2a23fe6c0b947a2", "git_parents": ["c7c242e07d4ef1ede9907dd466e3b2dfeb86e0de"], "node": "8f370b1d0f5f7a3d1a4dc85bcd2df1c737d648d7", "parents": ["618807649f0deccf822fa688bc336120d2655609"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2092011 - part 1 - Share the actions moving a customize menu section r=android-reviewers,giorga\n\nThe actions TalkBack offers for a section are now listed in one place, with the\nones which cannot apply kept as such, for the actions sheet of part 3 to\nshow the same ones.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342227\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuGroupSemantics.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuSectionAction.kt"], "git_node": "71ad0a71fa396878117c6d2981bee8fc5fd063ad", "git_parents": ["11aed36600cf627bd608b8d7d2a23fe6c0b947a2"], "node": "1ab2d91dedd134b118af81d216eb86ba6a645978", "parents": ["8f370b1d0f5f7a3d1a4dc85bcd2df1c737d648d7"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2092011 - part 2 - Move the drop area and reset button of the customize menu list into their own functions r=android-reviewers,giorga\n\nAs already done for the hidden sections title, for the list to stay short enough\nonce it also shows the actions sheet of a section.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342228\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/CustomizeMenuScreen.kt"], "git_node": "566bd744b3a3dba1292e2e1ea252da5a57dc3f76", "git_parents": ["71ad0a71fa396878117c6d2981bee8fc5fd063ad"], "node": "bb54d241d73c30cbfcc4588f35472481f29caf76", "parents": ["1ab2d91dedd134b118af81d216eb86ba6a645978"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2092011 - part 3 - Show the actions moving a customize menu section on a long press of its drag handle r=android-reviewers,android-l10n-reviewers,giorga,flod\n\nLong pressing the drag handle of a section opens a bottom sheet with Move up,\nMove down, and Hide section for a shown section or Unhide section for a hidden\none, the actions TalkBack offers for it. Unlike TalkBack, which leaves them out, the sheet shows\nthe actions which cannot apply disabled, as the main menu does.\n\nThe sheet opens as soon as the press is a long press, as other long press\npopups do, and the rest of that touch no longer drags the section.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342229\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/customize/Custom