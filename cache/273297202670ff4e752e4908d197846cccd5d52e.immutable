2bfca8e1bef7516890dec7ae48f4c756"], "node": "77b2f540240fc39c6fcc6baadf8847c0e05f41e3", "parents": ["51de121838451145b3e9c29d40ad8bbea66d32d6"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087917 - Remove the bug 1495350 fill-mode workaround from the video controls fade animations. r=reusable-components-reviewers,mconley,jules\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338629\n", "files": ["toolkit/content/widgets/videocontrols.js"], "git_node": "ac750d67839a84ad8fe3af79c4edb3728b36816b", "git_parents": ["2e89a83f6b9b92c3b3b617b9782e51a4e84e7c3d"], "node": "65351e4840f3d397ca4ae8791e9cbbc977a7b9f0", "parents": ["77b2f540240fc39c6fcc6baadf8847c0e05f41e3"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092652 - Update the About Firefox newsletter card visibility when the app locale changes. r=settings-reviewers,mkennedy\n\nThe newsletterSignUp setting decides visibility from the app locale but never emitted a change, so with intl.multilingual.liveReload enabled the card kept its old visibility until about:preferences was reloaded. Observe intl:app-locales-changed in its setup so the setting re-evaluates live.\n\nThis also rewrites browser_newsletter_signup.js to open about:preferences once and switch locales in place, instead of opening a new tab per locale.  The test now checks the hidden and shown transitions on a live locale switch.\nThat should also fix the intermittent timeout in bug 2092303.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342767\n", "files": ["browser/components/preferences/config/about-firefox.mjs", "browser/components/preferences/tests/browser_newsletter_signup.js"], "git_node": "f1867c15a1f0b52cdee9f53dc6bd8262e02928a6", "git_parents": ["ac750d67839a84ad8fe3af79c4edb3728b36816b"], "node": "53a7d2cb2001be705745925fc455c32f819da2a2", "parents": ["65351e4840f3d397ca4ae8791e9cbbc977a7b9f0"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-es-rCL/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-es-rCL/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-gn/strings.xml", "mobile/android/android-components/components/feature/importer/src/main/res/values-es-rCL/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-es-rCL/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rCL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gn/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-sq/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml"], "git_node": "96c228ef91e0084182cb819473f3ac9fa54dfd39", "git_parents": ["f1867c15a1f0b52cdee9f53dc6bd8262e02928a6"], "node": "8dcd4ed611fb811b0216df9731981ac313b8316b", "parents": ["53a7d2cb2001be705745925fc455c32f819da2a2"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2012843 - Make OPFS use the system global's `storage` instead of a window's r=nordzilla,ai-platform-reviewers\" for causing bc failures @ browser_ml_model_hub_download.js\n\nThis reverts commit 8936d3c31a59978be919dd6cefb6b475e175f40d.\n\nRevert \"Bug 2012843 - Resolve `storage` on the system global so OPFS does not need a window; asuth! r=nordzilla,frontend-codestyle-reviewers,asuth,smaug\"\n\nThis reverts commit 6d68d547d718e5934e628898ab7fb7db1f45a984.\n\nRevert \"Bug 2012843 - Rename locally bound \"storage\" variables to fix the \"no-shadow\" lint error introduced by making \"storage\" a global; r=nordzilla,credential-management-reviewers,sessionstore-reviewers,omc-reviewers,thecount,joschmidt,sfoster,yazan\"\n\nThis reverts commit 0681759afad4a67de23306c67c96f48355af6300.\n\nRevert \"Bug 2012843 - Add tests for parseUrl, getOwnerIcon, legacy migrations, and per-call hub overrides r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 714c3017f3ad89852d771c4ff27b8a525998856c.\n\nRevert \"Bug 2012843 - Repair stale entries from previous correctness bugs r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit b20f954babb29df929c87b832c86d895d9057677.\n\nRevert \"Bug 2012843 - Fix deleted models leaving empty directories behind r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 17966bd6231fda47961dcd4d175f7f2a8d01a78d.\n\nRevert \"Bug 2012843 - Fix simultaneous reads downloading the same model file twice r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit bfd967e51fc95463b4acff20bb3fc9b92c0d9392.\n\nRevert \"Bug 2012843 - Fix listModels reporting only one of several tasks sharing a model r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 47e76f1278d33d433349029eddcb2f81d52974a3.\n\nRevert \"Bug 2012843 - Fix listFiles reporting the wrong engines for each file r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 348ed7b8cd5c0903f2f4d376f1b123a27d2e03e3.\n\nRevert \"Bug 2012843 - Fix a failed download leaving a zero-length OPFS entry behind r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 2c871be07c722fd19fb66eb5821c14a13c04a353.\n\nRevert \"Bug 2012843 - Fix fileExists treating a pending headers lookup as present r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit b3044ce7eff465bce40aa02de13e658830057a7d.\n\nRevert \"Bug 2012843 - Fix denied models not being purged from the cache r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 9b795265f916ddd44ae6417ba437cd800fe333e4.\n\nRevert \"Bug 2012843 - Remove unused getModelFileAsResponse r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 1f398e961b4d7a34d35b7c2fb7fd5f85eb10be49.\n\nRevert \"Bug 2012843 - Delete browser_ml_cache.js now that the model hub tests cover it r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit a3ae0af0c0fdc18e797406f95a2431b52da9c55b.\n\nRevert \"Bug 2012843 - Restore MOZ_ALLOW_EXTERNAL_ML_HUB after the tests that set it r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 5de37b3de22cfe70889fbc1d82990e55cde54834.\n\nRevert \"Bug 2012843 - Add tests for the model hub denylist and listing r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 07de9e425a3e0941da952e19d20db829c26b117c.\n\nRevert \"Bug 2012843 - Add tests for deleting models r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 9efd682bf06fdff526d0afc4e6d588995e83de9b.\n\nRevert \"Bug 2012843 - Add tests for ETag revalidation r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit cf9be8471b7902221b0bb236335c5b14fa7c4b45.\n\nRevert \"Bug 2012843 - Add tests for failed and retried downloads r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 8d448a606cc597c314eba1dbc69affe3e75925dc.\n\nRevert \"Bug 2012843 - Add tests for engine downloads through the model hub r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 90f1e5e8df0820a6498362e1c7758024f5ab6bb2.\n\nRevert \"Bug 2012843 - Add tests for downloading and caching model files r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 6165c5f0575aa17c29d575bfdf4dee814be18e28.\n\nRevert \"Bug 2012843 - Add a mock model hub r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 42e9efbcfa58ffaf1402d885cb549cdccc79c061.\n\nRevert \"Bug 2012843 - Add type checking to ModelHub.sys.mjs r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit c1000332fd7e1ad348eb0deeacd8e2a077b87b54.\n\nRevert \"Bug 2012843 - Remove OPFS usage in workers; r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit ae6f1eef4f9d8f606d114303914e0169a57cc388.\n\nRevert \"Bug 2012843 - Re-work OPFS.sys.mjs to pass TypeScript and remove dead code; r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 8a8c864b9475f6c28e4fcabcc5bd48e8fd836b49.\n\nRevert \"Bug 2012843 - Remove incorrect isPrivateBrowsing call and test; r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit a5084a86d9bb3f9f56de467326c9ec435047f72c.\n\nRevert \"Bug 2012843 - Add a characterization for OPFS behavior for model downloading; r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit a671b8ecab72e20c5c6c87a894ffbfa4924be75c.\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/ASRouterNewTabHook.sys.mjs", "browser/components/backup/resources/MiscDataBackupResource.sys.mjs", "browser/components/mozcachedohttp/actors/MozCachedOHTTPParent.sys.mjs", "browser/components/newtab/AboutHomeStartupCache.sys.mjs", "browser/components/sessionstore/TabStateCache.sys.mjs", "browser/extensions/formautofill/content/editDialog.mjs", "browser/extensions/formautofill/content/manageDialog.mjs", "dom/console/ConsoleAPIStorage.sys.mjs", "dom/fs/test/xpcshell/head.js", "js/xpconnect/src/Sandbox.cpp", "js/xpconnect/src/XPCJSRuntime.cpp", "js/xpconnect/src/XPCRuntimeService.cpp", "js/xpconnect/src/xpcprivate.h", "js/xpconnect/tests/unit/test_storage.js", "toolkit/components/ml/actors/MLEngineChild.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/components/ml/content/MLEngine.worker.mjs", "toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/content/Utils.sys.mjs", "toolkit/components/ml/content/backends/LlamaCppPipeline.mjs", "toolkit/components/ml/content/backends/StaticEmbeddingsPipeline.mjs", "toolkit/components/ml/ml.d.ts", "toolkit/components/ml/tests/MLTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_cache.js", "toolkit/components/ml/tests/browser/browser_ml_engine_e2e.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_delete.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_denylist.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_download.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_download_failures.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_engine_e2e.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_etag.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_list.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_migration.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_owner_icon.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_url_parsing.js", "toolkit/components/ml/tests/browser/browser_ml_opfs.js", "toolkit/components/ml/tests/browser/browser_ml_opfs_private_window.js", "toolkit/components/ml/tests/browser/browser_ml_privatebrowsing.js", "toolkit/components/ml/tests/browser/browser_ml_telemetry.js", "toolkit/components/ml/tests/browser/ml_model_hub_echo_stub.worker.mjs", "toolkit/components/ml/tests/browser/shared-head.js", "toolkit/components/passwordmgr/test/unit/test_BreachAlertStore.js", "tools/@types/lib.gecko.tweaks.d.ts", "tools/lint/eslint/eslint-plugin-mozilla/lib/environments/privileged.mjs"], "git_node": "1946bcbf764136f2f0a63745caeb980fa6df10f9", "git_parents": ["96c228ef91e0084182cb819473f3ac9fa54dfd39"], "node": "3b3f1d4daf492994ce0714efd4db626a20c5a156", "parents": ["8dcd4ed611fb811b0216df9731981ac313b8316b"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081759 - Read credit cards from the Rust store without decrypting them unless a secret is needed r=joschmidt,credential-management-reviewers,NeilDeakin,mtigley,mossop,theidkamp\" for causing bc failures @ browser_creditCard_telemetry_cvv.js\n\nThis reverts commit 9c1896744b682f35b545ed3cc094009d0ddf4c04.\n", "files": ["browser/components/profiles/tests/browser/browser.toml", "browser/components/profiles/tests/browser/browser_delete_profile_page_locked_cards.js", "browser/extensions/formautofill/content/manageDialog.mjs", "browser/extensions/formautofill/test/browser/browser_creditCard_primaryPassword.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_capture_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_fill_cancel_login.js", "browser/extensions/formautofill/test/browser/creditCard/browser_editCreditCardDialog_cvv.js", "browser/extensions/formautofill/test/browser/head.js", "browser/extensions/formautofill/test/unit/test_rustStoreShutdown.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_adapter.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_migration.js", "toolkit/components/formautofill/AutofillStorageMigrator.sys.mjs", "toolkit/components/formautofill/FormAutofillParent.sys.mjs", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/components/formautofill/FormAutofillStorageBase.sys.mjs", "toolkit/components/formautofill/ProfileAutoCompleteResult.sys.mjs", "toolkit/components/formautofill/RustAutofillAdapterBase.sys.mjs", "toolkit/components/formautofill/RustAutofillCreditCardStorage.sys.mjs", "toolkit/components/formautofill/RustAutofillStore.sys.mjs", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs", "toolkit/components/formautofill/shared/CreditCardRecord.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillSection.sys.mjs"], "git_node": "af89bbb2d5f878adbf6ab517aaaabffeaffd499e", "git_parents": ["1946bcbf764136f2f0a63745caeb980fa6df10f9"], "node": "2f553ffae71ad151bbe72649bad258f99f41b5ee", "parents": ["3b3f1d4daf492994ce0714efd4db626a20c5a156"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083832 - Add telemetry for the Smart Window single page onboarding r=mlucks\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342488\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-onboarding/smartwindow-onboarding.mjs", "browser/components/aiwindow/ui/content/firstrun.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_firstrun.js"], "git_node": "4e400a729cafd91e696eb21f6878d37a898d9535", "git_parents": ["af89bbb2d5f878adbf6ab517aaaabffeaffd499e"], "node": "f43996665bbb579b5d41883c7a9a2c2b7ac27440", "parents": ["2f553ffae71ad151bbe72649bad258f99f41b5ee"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093768 - Make sendNativeMouseScrollEvent's interpretation of the sign of a horizontal delta consistent across platforms. r=hiro,win-reviewers,handyman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343334\n", "files": ["dom/interfaces/base/nsIDOMWindowUtils.idl", "gfx/layers/apz/test/mochitest/apz_test_native_event_utils.js", "gfx/layers/apz/test/mochitest/helper_bug1922904.html", "widget/gtk/nsWindow.cpp", "widget/nsIWidget.h", "widget/tests/window_mouse_scroll_win.html", "widget/windows/nsWindow.cpp"], "git_node": "482dfbb049e4cc82202ab992004785a1c8aa77c8", "git_parents": ["4e400a729cafd91e696eb21f6878d37a898d9535"], "node": "dc3170ea36d2ecd3c91d8eef8473450d109c4f13", "parents": ["f43996665bbb579b5d41883c7a9a2c2b7ac27440"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093561: Rename DisableAppNap to RegisterEarlyUserDefaults so it can register other early defaults. r=hballent\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343209\n", "files": ["toolkit/xre/MacApplicationDelegate.h", "toolkit/xre/MacApplicationDelegate.mm", "toolkit/xre/nsAppRunner.cpp"], "git_node": "4273fed9140f0c33016902fa9e6903d64d495ab7", "git_parents": ["482dfbb049e4cc82202ab992004785a1c8aa77c8"], "node": "897437cce20b7b9eb98d3855c090e8fff000b2b1", "parents": ["dc3170ea36d2ecd3c91d8eef8473450d109c4f13"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093561: Opt Nightly into AppKit's touch gesture recognizers for third-party toolkits. r=hballent\n\nOn macOS 27, AppKit already opts the Firefox, Beta and Developer Edition bundle identifiers into NSApplicationRequiresGestureRecognizersFor3rdPartyToolKit, which turns touch input into emulated mouse and scroll events. Nightly has its own bundle identifier, so register the default for it next to NSAppSleepDisabled. This runs before prefs are loaded, so it is limited to Nightly at build time. The default can still be overridden per user with `defaults write org.mozilla.nightly NSApplicationRequiresGestureRecognizersFor3rdPartyToolKit -bool NO`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343210\n", "files": ["toolkit/xre/MacApplicationDelegate.mm"], "git_node": "467b50436d3901a6f438a1675ae24d32a64831b0", "git_parents": ["4273fed9140f0c33016902fa9e6903d64d495ab7"], "node": "afd3a7dea46d162441cb7103abf7666dc712403a", "parents": ["897437cce20b7b9eb98d3855c090e8fff000b2b1"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2083098 - Part 1: Unify child handle codepaths in GeckoChildProcessHost, r=ipc-reviewers,media-playback-reviewers,jld,alwu\n\nThis delays calling `OnChannelConnected()` until after the process has\nbeen started.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339678\n", "files": ["dom/media/ipc/RDDProcessHost.cpp", "dom/media/ipc/RDDProcessHost.h", "gfx/ipc/GPUProcessHost.cpp", "gfx/ipc/GPUProcessHost.h", "gfx/vr/ipc/VRProcessParent.cpp", "gfx/vr/ipc/VRProcessParent.h", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h", "ipc/glue/NodeChannel.cpp", "ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessHost.h"], "git_node": "6a90e98ea914b888d9dd06703c08e03f054a8087", "git_parents": ["467b50436d3901a6f438a1675ae24d32a64831b0"], "node": "af415d47c1930543b1be112fc00ca0936828c490", "parents": ["afd3a7dea46d162441cb7103abf7666dc712403a"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2083098 - Part 2: Fully remove OnChannelConnected from GeckoChildProcessHost, r=ipc-reviewers,media-playback-reviewers,mccr8,aosmond\n\nThis hook was scheduled to happen either slightly before or slightly\nafter the process handle became ready, on the IPC I/O thread. This\nreplaces all uses with instead chaining off of the process handle\npromise, which happens with consistent scheduling.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339679\n", "files": ["dom/media/gmp/GMPProcessParent.cpp", "dom/media/ipc/RDDProcessHost.cpp", "dom/media/ipc/RDDProcessHost.h", "gfx/ipc/GPUProcessHost.cpp", "gfx/ipc/GPUProcessHost.h", "gfx/vr/ipc/VRProcessParent.cpp", "gfx/vr/ipc/VRProcessParent.h", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h", "ipc/glue/NodeChannel.cpp", "ipc/glue/NodeChannel.h", "ipc/glue/NodeController.cpp", "ipc/glue/NodeController.h", "ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessHost.h", "ipc/ipdl/test/gtest/IPDLUnitTest.cpp"], "git_node": "1bf6c7da1f5dcd0dc47e430f4309e3fb0f452b41", "git_parents": ["6a90e98ea914b888d9dd06703c08e03f054a8087"], "node": "7d8710822b5dec06cfd2cf2340c8df03cf42637e", "parents": ["af415d47c1930543b1be112fc00ca0936828c490"], "tags": []}, {"author": "Azaleck \u003cmelchior.vila@laposte.net\u003e", "branch": "default", "desc": "Bug 2089983 - Handle a missing type value in the updater manifest parser. r=application-update-reviewers,spohl\n\nmstrtok() returns null when the type line in update.manifest has no\nquoted value, and the null was passed to LOG and NS_tstrcmp. Return\nPARSE_ERROR instead, and log it as DoUpdate() already does when the\nfirst token is missing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342892\n", "files": ["toolkit/mozapps/update/updater/updater.cpp"], "git_node": "d4c12ab211e406d1ddd97216bd194b8ed5b12a16", "git_parents": ["1bf6c7da1f5dcd0dc47e430f4309e3fb0f452b41"], "node": "07d4c50efc357cfa562b6972b7c6e54419972c6b", "parents": ["7d8710822b5dec06cfd2cf2340c8df03cf42637e"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2093823 - Wait for loading font on /css/CSS2/floats/floats-in-inline-content-intrinsic-size-001.html. r=layout-reviewers,tnikkel\n\nWhen I turn on WPT for GeckoView with fission,\n`/css/CSS2/floats/floats-in-inline-content-intrinsic-size-001.html`'s\nresult is random. Although this test is added by\nhttps://bugs.webkit.org/show_bug.cgi?id=328507, this doesn't wait for\nloading font even if Ahem font is used.\n\nThis fix adds a wait for loading font on this test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343358\n", "files": ["testing/web-platform/meta/css/CSS2/floats/floats-in-inline-content-intrinsic-size-001.html.ini", "testing/web-platform/tests/css/CSS2/floats/floats-in-inline-content-intrinsic-size-001.html"], "git_node": "54fe737cafd80c3757ce046a49bdc5d5d813165f", "git_parents": ["d4c12ab211e406d1ddd97216bd194b8ed5b12a16"], "node": "5132170ffa3a6340c99221bbc49400c5c3f83917", "parents": ["07d4c50efc357cfa562b6972b7c6e54419972c6b"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2090434 - Enable offline AMP and Wikipedia suggestions by default in CA. r=urlbar-reviewers,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341282\n", "files": ["browser/components/urlbar/QuickSuggest.sys.mjs", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_defaultPrefs.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_exposures_locales.js"], "git_node": "a68e8655921ab8b8202a051c076b2cfb03d05196", "git_parents": ["54fe737cafd80c3757ce046a49bdc5d5d813165f"], "node": "11eb6bc1abf878433af586688b6e505d23f73159", "parents": ["5132170ffa3a6340c99221bbc49400c5c3f83917"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093540 - Read OffscreenCanvas snapshots when creating a VideoFrame from them. r=media-playback-reviewers,alwu\n\nAn accelerated canvas snapshot can only be read back on the canvas' owning\nthread, so read it now as is done for HTMLCanvasElement, rather than when the\nencoder converts it on its own task queue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343187\n", "files": ["dom/media/webcodecs/VideoFrame.cpp"], "git_node": "207a3dae4129a351c7f8974714562d5ae436407b", "git_parents": ["a68e8655921ab8b8202a051c076b2cfb03d05196"], "node": "7c2609761f3b1e055b70d7db44bdfcc347fd7478", "parents": ["11eb6bc1abf878433af586688b6e505d23f73159"], "tags": []}, {"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Bug 2093140 - Use CTAP1 for authenticators that set `NMSG` without setting `CBOR` (MitID chip) r=jschanck\n\nDanish MitID chip (modified Feitian MultiPass FIDO) reports `capabilities =\n0xb`, which is an invalid configuration.  Other Feitian authenticators\nappear to set valid capability sets, but sometimes contradict this in their\n`authenticatorGetInfo.versions`.\n\nBefore Bug 2081040, Firefox treated this as a CTAP1-only authenticator, so\nthis patch restores that behaviour, and complains when it happens.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343371\n", "files": ["dom/webauthn/authenticator/src/transport/hid.rs", "dom/webauthn/authenticator/src/transport/mock/device.rs"], "git_node": "ccd26bd4d58d02d13630b9fcd587a32081476ef6", "git_parents": ["207a3dae4129a351c7f8974714562d5ae436407b"], "node": "8fc680499a9d7e5ed19cb8e4e5f34c646d71ab94", "parents": ["7c2609761f3b1e055b70d7db44bdfcc347fd7478"], "tags": []}, {"author": "Osmond Arnesto \u003coarnesto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076492 - UITour theme CSS passes use-design-tokens r=desktop-theme-reviewers,hjones,omc-reviewers,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339400\n", "files": ["browser/themes/shared/UITour.css", "stylelint-rollouts.config.js"], "git_node": "9d22d89b42b76dac19559500fc776731bd3fb96a", "git_parents": ["ccd26bd4d58d02d13630b9fcd587a32081476ef6"], "node": "96a22991fc42a571a8887e65add354e1426dcadc", "parents": ["8fc680499a9d7e5ed19cb8e4e5f34c646d71ab94"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2093806 - Update android nightly application-services version bump to 09df0c1918dc8e08f1ed94bbd7af6c85b9426a9a r=android-build-system-reviewers,release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343356\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "df7cb126fe0dafe46d631e1dd6ed69e131c5cf6d", "git_parents": ["9d22d89b42b76dac19559500fc776731bd3fb96a"], "node": "2e58fdaa8b9b9dc38e5d9c60dca1d5645fbe6fc1", "parents": ["96a22991fc42a571a8887e65add354e1426dcadc"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975505 - Part 4 - Generate the XPCOM typelib input from every IDL in the tree r=Standard8\n\nA build only parses the IDL files its configuration selects, so the\nchecked in XPCOM typelib depended on the platform that generated it.\n`xpidl_typelib.py` parses every IDL in the tree instead. It skips the\ndirectories in `IDL_EXCLUDED_DIRS`, whose `.idl` files are MIDL,\nvendored third party IDLs or test fixtures rather than Gecko XPIDL. It\nfails if two IDLs share a file name, because xpidl resolves includes by\nfile name. Part 6 runs it from `./mach ts update`, and a new `ts` python\ntest task runs the `tools/ts` unit tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334778\n", "files": ["taskcluster/kinds/source-test/python.yml", "tools/moz.build", "tools/ts/test/python/data/xpidl/a/nsITsSupports.idl", "tools/ts/test/python/data/xpidl/b/nsITsChild.idl", "tools/ts/test/python/python.toml", "tools/ts/test/python/test_typelibs.py", "tools/ts/typelib_inputs.py", "tools/ts/xpidl_typelib.py"], "git_node": "ef4d8f09ec03bd79cb228a12a58eaf5d566333c0", "git_parents": ["df7cb126fe0dafe46d631e1dd6ed69e131c5cf6d"], "node": "f8126b5b66f39fdae636ed4ae751e414a90bec75", "parents": ["2e58fdaa8b9b9dc38e5d9c60dca1d5645fbe6fc1"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975505 - Part 5 - Generate the services typelib input from every `components.conf` in the tree r=Standard8\n\nA build evaluates `components.conf` files for its own platform only, so\nthe checked in services typelib depended on the platform that generated\nit. `services_typelib.py` evaluates every `components.conf` for Windows,\nmacOS and Linux and merges the results. Every build option other than\nthe platform counts as enabled. It fails if one interface gets two\nservice names. It skips `mobile`, `widget/android` and `widget/uikit`,\nbecause the types only cover desktop Firefox. Part 6 runs it from\n`./mach ts update`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334779\n", "files": ["taskcluster/kinds/source-test/python.yml", "tools/ts/services_typelib.py", "tools/ts/test/python/data/services/a/components.conf", "tools/ts/test/python/data/services/b/components.conf", "tools/ts/test/python/test_typelibs.py", "tools/ts/typelib_inputs.py"], "git_node": "487ed5f79d2bd0f89cbebc4bd43c3f7b6980ac3b", "git_parents": ["ef4d8f09ec03bd79cb228a12a58eaf5d566333c0"], "node": "cc651b3f06b643128a0895da8a294d02c09ed0dc", "parents": ["f8126b5b66f39fdae636ed4ae751e414a90bec75"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975505 - Part 6 - Make `mach ts update` generate the TypeScript typelibs without a build r=Standard8\n\n`mach ts update` now also writes the module path map and the\nsubstitution declarations, so `mach ts build`, `mach ts subs` and\n`mach ts paths` are removed. The output does not depend on an objdir or\na mozconfig, and `tools/@types` is written only once every file is\ngenerated.\n\nThe IDL, `components.conf`, WebIDL and JavaScript inputs come from the\nfiles tracked by version control, so untracked files and nested\ncheckouts such as `comm/` are left out.\n\n`build_xpcom.js` writes all three platform typelibs, with a map from\neach platform specific IDL to its platforms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334781\n", "files": ["docs/code-quality/lint/linters/typescript.md", "docs/code-quality/typescript/index.md", "docs/code-quality/typescript/updatingTypes.md", "docs/config.yml", "tools/@types/generated/README", "tools/ts/build_dom.js", "tools/ts/build_nsresult.js", "tools/ts/build_paths.js", "tools/ts/build_services.js", "tools/ts/build_xpcom.js", "tools/ts/config/fixed_paths.js", "tools/ts/generate_input.py", "tools/ts/mach_commands.py", "tools/ts/test/python/test_typelibs.py", "tools/ts/typelib_inputs.py", "tools/ts/typelibs.py"], "git_node": "4eb31ae45d4fa5e8611b8d8934fb09f2f700f372", "git_parents": ["487ed5f79d2bd0f89cbebc4bd43c3f7b6980ac3b"], "node": "100aec0491f3f1b08b35720cc3002e3ec90ce6dc", "parents": ["cc651b3f06b643128a0895da8a294d02c09ed0dc"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975505 - Part 7 - Remove the TypeScript typelib inputs the build writes and the checked in `error_list.json` r=Standard8,firefox-build-system-reviewers,frontend-codestyle-reviewers,chumphreys,sylvestre,mossop\n\nSince Part 6, `mach ts update` generates every typelib input itself, so\nnothing reads the `error_list.json`, `lib.gecko.glean.d.ts` and per\nmodule `.d.json` files the build writes for `tools/ts`, or the checked\nin copy of `error_list.json`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334782\n", "files": [".prettierignore", "python/mozbuild/mozbuild/action/xpidl-process.py", "toolkit/components/glean/moz.build", "tools/rewriting/Generated.txt", "tools/ts/config/error_list.json", "xpcom/base/moz.build"], "git_node": "d544b220f44890e7dedad53b6ba65a7f947a6e21", "git_parents": ["4eb31ae45d4fa5e8611b8d8934fb09f2f700f372"], "node": "9bcd6613b507c942891b7e3f0f77b3efd8f047ab", "parents": ["100aec0491f3f1b08b35720cc3002e3ec90ce6dc"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975505 - Part 8 - Sort the checked in XPCOM typelibs by IDL path r=Standard8\n\n`build_xpcom.js` lists interfaces in the order of its input. Part 4\ngenerates that input as one file with every IDL in path order, instead\nof one file per XPIDL module, so the first regeneration would move\nalmost every interface in `lib.gecko.xpcom.d.ts` and hide the content\nchanges in a diff of about 16,000 lines. This commit only reorders the\nchecked in files, so Part 9 shows just the content changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334783\n", "files": ["tools/@types/generated/lib.gecko.win32.d.ts", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "c4b06718d8241dd94631ad4220f3ebac62b5f069", "git_parents": ["d544b220f44890e7dedad53b6ba65a7f947a6e21"], "node": "8b5ba3981e9dcbae862a0aa1fbfb435c6115e2fa", "parents": ["9bcd6613b507c942891b7e3f0f77b3efd8f047ab"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975505 - Part 9 - Regenerate the checked in TypeScript typelibs r=Standard8\n\nGenerated by `mach ts update`. The diff carries every source change since\nthe last manual update of the typelibs. It also adds the IDLs that the\nplatform used for the last update did not build, and moves platform only\ninterfaces such as `nsIASWebAuthSessionRequest` into their platform file.\n\n`DiscoveryStreamFeed.sys.mjs` drops three `@ts-expect-error` directives\nfor Glean metrics that `lib.gecko.glean.d.ts` now declares. The\n`typescript` linter fails on a directive that suppresses no error.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334784\n", "files": ["browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "tools/@types/generated/lib.gecko.darwin.d.ts", "tools/@types/generated/lib.gecko.dom.d.ts", "tools/@types/generated/lib.gecko.glean.d.ts", "tools/@types/generated/lib.gecko.linux.d.ts", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/lib.gecko.win32.d.ts", "tools/@types/generated/lib.gecko.xpcom.d.ts", "tools/@types/subs/FeatureManifest.sys.d.mts"], "git_node": "0e6902a13cee000e7891b2bb9d14ca39582c2533", "git_parents": ["c4b06718d8241dd94631ad4220f3ebac62b5f069"], "node": "5cf01bc240c97ade2f447325ee28344dd98416f0", "parents": ["8b5ba3981e9dcbae862a0aa1fbfb435c6115e2fa"], "tags": []}], "date": 1794908322, "git_changesets": ["a671b8ecab72e20c5c6c87a894ffbfa4924be75c", "a5084a86d9bb3f9f56de467326c9ec435047f72c", "8a8c864b9475f6c28e4fcabcc5bd48e8fd836b49", "ae6f1eef4f9d8f606d114303914e0169a57cc388", "c1000332fd7e1ad348eb0deeacd8e2a077b87b54", "42e9efbcfa58ffaf1402d885cb549cdccc79c061", "6165c5f0575aa17c29d575bfdf4dee814be18e28", "90f1e5e8df0820a6498362e1c7758024f5ab6bb2", "8d448a606cc597c314eba1dbc69affe3e75925dc", "cf9be8471b7902221b0bb236335c5b14fa7c4b45", "9efd682bf06fdff526d0afc4e6d588995e83de9b", "07de9e425a3e0941da952e19d20db829c26b117c", "5de37b3de22cfe70889fbc1d82990e55cde54834", "a3ae0af0c0fdc18e797406f95a2431b52da9c55b", "1f398e961b4d7a34d35b7c2fb7fd5f85eb10be49", "9b795265f916ddd44ae6417ba437cd800fe333e4", "b3044ce7eff465bce40aa02de13e658830057a7d", "2c871be07c722fd19fb66eb5821c14a13c04a353", "348ed7b8cd5c0903f2f4d376f1b123a27d2e03e3", "47e76f1278d33d433349029eddcb2f81d52974a3", "bfd967e51fc95463b4acff20bb3fc9b92c0d9392", "17966bd6231fda47961dcd4d175f7f2a8d01a78d", "b20f954babb29df929c87b832c86d895d9057677", "714c3017f3ad89852d771c4ff27b8a525998856c", "0681759afad4a67de23306c67c96f48355af6300", "6d68d547d718e5934e628898ab7fb7db1f45a984", "8936d3c31a59978be919dd6cefb6b475e175f40d", "94e0ffcae1d5f0b8a2aa843f584d7e5f331bbb4c", "31de23ea5978f51a07a5bacb24d3aca5bf817a5c", "492126022d79fcffc9d27c1a093b061a38839b16", "8b2f1318aafb2ec4ad081a2f684fed067f5abc9b", "11eeed56302b330dfd7d1bebddc045efde2a42bf", "892e372bfc46c2044e58791512d983790412c600", "92c8f1dd633591e0270462d5cba81ef4472ed80d", "37f513bb9561c92d135bb0934e201effadbc781a", "95ef4ee7186c3dc6f9e3b471498ca8e41a79a74d", "ee255ef6398c23a703e2cc89bd3f324fbf777192", "9ece3007ac8749ea008e384166c71f97504e3966", "57a74ad6af0c31e5744ebaf5cdbb3a64266f1842", "90fa1f30bc0e154f5d5c90df5e1548e911bd58e2", "70482255670611570b7fa0a1450c1418798a007