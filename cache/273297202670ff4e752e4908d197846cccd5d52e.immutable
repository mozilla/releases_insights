"], "node": "9d40cfb6cb80db8dbd5a0a850e9d0583d04b42ab", "parents": ["585bd43287f3c51db61c44021afc611860432331"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2091211 - Don't consider a capture equal to the viewport as unreasonably large. r=nical,view-transitions-reviewers\n\nThis fixes the reported case, but follow-up will fix the rendering issue\ntoo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342091\n", "files": ["dom/view-transitions/ViewTransition.cpp"], "git_node": "e007bb687e0c666fe0d6fe31f8d809a0355b5db2", "git_parents": ["aa137a1681257694be1d8953acd4eb0f1bbeef7e"], "node": "f88696e329544d4e1c33eeb4e5a65b27b534c73d", "parents": ["9d40cfb6cb80db8dbd5a0a850e9d0583d04b42ab"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054666 - Derive the cookie base domain in the parent for SetCookies. r=cookie-reviewers,timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335923\n", "files": ["dom/ipc/PWindowGlobal.ipdl", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "netwerk/cookie/CookieServiceChild.cpp", "netwerk/cookie/CookieServiceParent.cpp", "netwerk/cookie/CookieServiceParent.h", "netwerk/cookie/PCookieService.ipdl"], "git_node": "a6e39f4f71957e5675b3c7dedd91294aa3e71ced", "git_parents": ["e007bb687e0c666fe0d6fe31f8d809a0355b5db2"], "node": "d64d651be1c4e270fc8c7711fe2afa3a7ce0022e", "parents": ["f88696e329544d4e1c33eeb4e5a65b27b534c73d"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090172: Hold a strong reference to the main-thread XHR across worker abort. r=dom-worker-reviewers,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340567\n", "files": ["dom/xhr/XMLHttpRequestWorker.cpp"], "git_node": "81c851d3c75f77e1b68975f2e8ae29142c82c8b3", "git_parents": ["a6e39f4f71957e5675b3c7dedd91294aa3e71ced"], "node": "e6dae240a39b2da914f4dafc69b9abfd9213265f", "parents": ["d64d651be1c4e270fc8c7711fe2afa3a7ce0022e"], "tags": []}, {"author": "Emily Wachowiak \u003cewachowiak@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091597 - Load branding/brand.ftl in DownloadUIHelper so the downloads prompt resolves the brand name. r=Gijs\n\nBug 2074615 added { -brand-short-name } to the downloads prompt strings, but\nthe Localization loaded toolkit/branding/brandings.ftl, which doesn't define\nthat term. The prompt showed the literal \"{-brand-short-name}\". The term is\ndefined in branding/brand.ftl, so load that file instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342167\n", "files": ["toolkit/components/downloads/DownloadUIHelper.sys.mjs"], "git_node": "f518432b66e3d612a12e8a9b9895dbaca6175b9b", "git_parents": ["81c851d3c75f77e1b68975f2e8ae29142c82c8b3"], "node": "3b06930d2eda39351353354047001743ec853b60", "parents": ["e6dae240a39b2da914f4dafc69b9abfd9213265f"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092037 - Enable the new frame load behavior by default. r=dom-core-reviewers,jjaschke\n\nRemove redundant WPT pref overrides so tests exercise the default behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342085\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/browsers/browsing-the-web/navigating-across-documents/navigate-iframe-to-same-url-with-document-domain.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/joint_session_history/001.html.ini", "testing/web-platform/meta/navigation-api/__dir__.ini"], "git_node": "c31b8d1022e4eda4f20522af5e7642b7540a28e3", "git_parents": ["f518432b66e3d612a12e8a9b9895dbaca6175b9b"], "node": "c5706e10565b0ec3cdb6dde70eba8394507ea6bb", "parents": ["3b06930d2eda39351353354047001743ec853b60"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1645648 - Rename split-view-footer to address-footer (no functional change). r=tabbrowser-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341795\n", "files": ["browser/base/content/browser-main.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/address-footer.mjs", "browser/components/tabbrowser/content/split-view-footer.mjs", "browser/components/tabbrowser/jar.mn", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_footer.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_telemetry.js", "browser/themes/shared/tabbrowser/content-area.css", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "b435e27dc8d2a037fea6f1b0635fe3f6849c55a7", "git_parents": ["c31b8d1022e4eda4f20522af5e7642b7540a28e3"], "node": "54d405640ec1150817a399fde81e9b923fe820c9", "parents": ["c5706e10565b0ec3cdb6dde70eba8394507ea6bb"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2087937 - Proper \u003crandom-ua-ident\u003e for early substituted random() in substitution functions. r=firefox-style-system-reviewers,emilio\n\nBug 2080511 added support for arbitrary substitution functions that parse their\narguments at substitution/computed-value time. This is called early substitution\nand it affects the prefix used by `property-scoped` / `property-index-scoped` random\nkeys -- for example, when `random()` is used in attribute values of a typed `attr()`,\nthe conditions of `if()`, or the `ident()` function.\n\nGenerating the correct `\u003crandom-ua-ident\u003e` for such random keys requires adding a\nparsing mode to indicate early substitution, and introducing a separate counter for\nearly `random()` functions. This patch also propagates the correct property name\nthrough the entire substitution process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338646\n", "files": ["servo/components/style/custom_properties.rs", "servo/components/style/parser.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/mod.rs", "servo/components/style/properties_and_values/value.rs", "servo/components/style/substitution/attr.rs", "servo/components/style/substitution/env.rs", "servo/components/style/substitution/mod.rs", "servo/components/style/values/specified/random.rs", "servo/components/style_traits/lib.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/tests/css/css-values/random-computed.tentative.html"], "git_node": "27ea5a44a55d200e62c959586ad913dfb936f36c", "git_parents": ["b435e27dc8d2a037fea6f1b0635fe3f6849c55a7"], "node": "399d663b21f9ea9711ad7af79fc39b58057c4752", "parents": ["54d405640ec1150817a399fde81e9b923fe820c9"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2087544 - Optimize invalidation for attr() in container queries with nested substitution functions. r=firefox-style-system-reviewers,emilio\n\nPreviously, the presence of any container query with an unparsed `attr()` function\nwould cause all container elements to restyle style-query-dependent descendants on\nall attribute changes, since it's not known which attribute will eventually be used\nwhen evaluating the query. It also caused all elements to snapshot all attributes\nwhen they're modified. This patch optimizes invalidation by:\n\n- When collecting stylesheet rules, tracking all container query conditions with\n  any unparsed `attr()` functions.\n- When evaluating a container query, adding a flag to evaluated container elements\n  if the container query had an unparsed `attr()` function.\n- When handling a modified attribute, if the element has the new flag, evaluating\n  tracked container queries on the element to see if the attribute was referenced.\n\nThis tracking and flag approach is over-broad in that all container query conditions\nwith unparsed `attr()` functions are evaluated on the element, since the flag doesn't\nindicate /which/ query condition was evaluated on the container. Still, this isolates\nthe effect of attribute modification and invalidation to just the relevant containers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338647\n", "files": ["dom/base/nsINode.h", "layout/style/test/mochitest.toml", "layout/style/test/test_invalidation_container_query_unparsed_attr.html", "servo/components/selectors/matching.rs", "servo/components/style/gecko/wrapper.rs", "servo/components/style/stylesheets/container_rule.rs", "servo/components/style/stylist.rs", "testing/web-platform/tests/css/css-conditional/container-queries/style-query-custom-attr-nested-name-change.html"], "git_node": "e7aeafe756ea92c781355b164593f7dbd09b64e6", "git_parents": ["27ea5a44a55d200e62c959586ad913dfb936f36c"], "node": "76cbeb20baf755785b817a7eac86329ca2c08b71", "parents": ["399d663b21f9ea9711ad7af79fc39b58057c4752"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2091710 - Implement CSS inherit() substitution function. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341682\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "servo/components/style/custom_properties.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/substitution/inherit.rs", "servo/components/style/substitution/mod.rs", "servo/components/style/substitution/var.rs", "testing/web-platform/meta/css/__dir__.ini", "testing/web-platform/meta/css/css-values/inherit-function-basic.html.ini", "testing/web-platform/meta/css/css-values/inherit-function-invalidation.html.ini", "testing/web-platform/meta/css/css-values/inherit-function-parsing.html.ini", "testing/web-platform/tests/css/css-values/inherit-function-basic.html", "testing/web-platform/tests/css/css-values/inherit-function-invalidation.html"], "git_node": "0bbabb574e35267514bbf1b6604b998b992925a4", "git_parents": ["e7aeafe756ea92c781355b164593f7dbd09b64e6"], "node": "b8b562da15dcd1e60b0d5d31289c97e705414dce", "parents": ["76cbeb20baf755785b817a7eac86329ca2c08b71"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2086244 - Update the Terms of Use published date and only use it once that date has passed r=android-reviewers,devota,cpeterson\" for causing fenix lint failures at fenix:spotlessKotlinCheck\n\nThis reverts commit ffb4a1e2ce7647f4865e3325efdeaa99092e8950.\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/termsofuse/TermsOfUseVersion.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/termsofuse/store/PrivacyNoticeBannerRepository.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/termsofuse/store/PrivacyNoticeBannerRepositoryTest.kt"], "git_node": "e073b9f40e9c2690dfd0511ea48761257a83331f", "git_parents": ["0bbabb574e35267514bbf1b6604b998b992925a4"], "node": "c63720da141583782b9d428eee46b6f59c32cd2c", "parents": ["b8b562da15dcd1e60b0d5d31289c97e705414dce"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2028436 - Use BROWSER_NEW_TAB_URL instead of hardcoded about:newtab r=tabbrowser-reviewers,kcochrane\" for causing bc tests failures at open_tab_in_splitview.js\n\nThis reverts commit 3b97b7070410d374c8b38a7db6278f3de125f4a0.\n", "files": ["browser/components/tabbrowser/content/opentabs-splitview.mjs", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_about_opentabs.js"], "git_node": "f7f70c55b2cd54f443c24ed51c040f4f6cd07635", "git_parents": ["e073b9f40e9c2690dfd0511ea48761257a83331f"], "node": "22a67a40a5c6e982ca2f796137f6a3882819ad37", "parents": ["c63720da141583782b9d428eee46b6f59c32cd2c"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086171 - Update ExecuteModule implementation to latest spec; r=rhunt\n\nThere ended up being no changes to functionality.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339212\n", "files": ["js/src/wasm/WasmJS.cpp"], "git_node": "ce17cb7e3a28c40a9812f8f35a4d50409ac12a88", "git_parents": ["f7f70c55b2cd54f443c24ed51c040f4f6cd07635"], "node": "9d1d8b3dfeb56255e8b1173be4c78efec428771e", "parents": ["22a67a40a5c6e982ca2f796137f6a3882819ad37"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090056 - add initial smart window actions toolbar with existing conversation starters r=flozia,fluent-reviewers,bolsson\n\nreuse sidebar starters for the current page to show new toolbar behind prefs ahead of more actions, context, data, etc.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340378\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/content/smart-actions-toolbar.css", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/SmartActionsToolbar.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_smart_actions_toolbar.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/locales-preview/aiWindow.ftl"], "git_node": "47e1f92e439f7c2db2552504e40f1d990c0664e0", "git_parents": ["ce17cb7e3a28c40a9812f8f35a4d50409ac12a88"], "node": "5c808c8fd6c3c43797275a3d510e1cc55cd45131", "parents": ["9d1d8b3dfeb56255e8b1173be4c78efec428771e"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087560 - Verify that the hazard analysis covers buffer allocations r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342004\n", "files": ["js/src/jsapi-tests/testGCAllocator.cpp"], "git_node": "da90b08a541603252995fcd065ca811a754653cb", "git_parents": ["47e1f92e439f7c2db2552504e40f1d990c0664e0"], "node": "7209d3d1e2a1e36ea8b2553cab934cb1866f026a", "parents": ["5c808c8fd6c3c43797275a3d510e1cc55cd45131"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976115 - Don't load experiment API modules after their extension has shut down. r=robwu\n\nAn API call made as an extension shuts down can finish loading its\nmodule after shutdown has started. For an experiment API, the script\nthen runs after the extension's policy has been removed. This went\nunnoticed while experiment scripts loaded from `jar:file:` URLs. The\nsubsequent patch in this series, however, will cause them to be loaded\nfrom `moz-extension:` URLs. As a result, the parent-process script check\nblocks the load, crashing debug builds.\n\n`LazyAPIManager` now has a `disableNewScripts()` method, which the\nextension calls as it shuts down. After that, module scripts that have\nnot already run are rejected. Unlike the existing `_checkLoadModule()`\nconditions, this one can change while a module is compiled\nasynchronously. It is therefore checked by a separate\n`_checkExecuteModule()` method, which runs again once compilation\nfinishes.\n\nTwo JSDoc annotations declared the `apiManagers` arrays as\n`LazyAPIManager[]`, even though each array always starts with the global\nAPI manager. Type checking accepted this only because the global manager\nhappened to have every member `LazyAPIManager` declared. Adding new\nmembers to `LazyAPIManager` breaks that, so the arrays are now annotated\nas `SchemaAPIManager[]`, and `lazyInit()`, which every API manager\nimplements, is declared on that base class.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335158\n", "files": ["toolkit/components/extensions/Extension.sys.mjs", "toolkit/components/extensions/ExtensionChild.sys.mjs", "toolkit/components/extensions/ExtensionCommon.sys.mjs", "toolkit/components/extensions/test/xpcshell/test_ext_experiments.js"], "git_node": "094ca2c3732cc05158afa2705a67e5ba41fde096", "git_parents": ["da90b08a541603252995fcd065ca811a754653cb"], "node": "d2b99c749ad89339e6d554c7e1b419a0c4b59583", "parents": ["7209d3d1e2a1e36ea8b2553cab934cb1866f026a"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976115 - Load experiment API scripts from moz-extension: URLs. r=robwu\n\nExperiment API scripts were loaded from the extension package's resolved\n`jar:file:` or `file:` URL rather than the `moz-extension:` URL used\nelsewhere in the extension framework. As a result, child processes\nopened the package file by path to load the scripts. That only worked if\nthe package was already open in that process, or the process sandbox\nallowed reading it.\n\nThe scripts are now loaded from `moz-extension:` URLs, which child\nprocesses load through the parent rather than by opening the package\nthemselves.\n\nThis fixes test_ext_experiments.js on Android isolated processes, so it\nis re-enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335159\n", "files": ["js/xpconnect/loader/mozJSSubScriptLoader.cpp", "toolkit/components/extensions/Extension.sys.mjs", "toolkit/components/extensions/test/mochitest/mochitest-common.toml", "toolkit/components/extensions/test/mochitest/test_ext_experiments_child.html", "toolkit/components/extensions/test/xpcshell/test_ext_experiments.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common.toml"], "git_node": "7dfcd91f6d423d0157700630552751ffc92e2e66", "git_parents": ["094ca2c3732cc05158afa2705a67e5ba41fde096"], "node": "106c7c15daf68615fd5fdd57fa66560eea700151", "parents": ["d2b99c749ad89339e6d554c7e1b419a0c4b59583"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090885 - Don't call onTopLevelEvaluationFinished for wasm module records; r=rhunt\n\nThis is only relevant for top level async in JavaScript modules.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341533\n", "files": ["js/src/jit-test/modules/exports-dot-generator.wasm", "js/src/jit-test/modules/exports-dot-generator.wat", "js/src/jit-test/tests/modules/wasm-eval-phase-dot-generator-export.js", "js/src/wasm/WasmJS.cpp"], "git_node": "202d3041a4938003ebd40deef0e25c50339305a6", "git_parents": ["7dfcd91f6d423d0157700630552751ffc92e2e66"], "node": "0340cfaa2811e176c9401821c37ba71334a31abe", "parents": ["106c7c15daf68615fd5fdd57fa66560eea700151"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2091710, Bug 2087544, Bug 2087937 - Implement CSS inherit() substitution function. r=firefox-style-system-reviewers,emilio\" for causing wpt failures at custom-property-explicit-inherit-invalidation.html\n\nThis reverts commit 0bbabb574e35267514bbf1b6604b998b992925a4.\n\nRevert \"Bug 2087544 - Optimize invalidation for attr() in container queries with nested substitution functions. r=firefox-style-system-reviewers,emilio\"\n\nThis reverts commit e7aeafe756ea92c781355b164593f7dbd09b64e6.\n\nRevert \"Bug 2087937 - Proper \u003crandom-ua-ident\u003e for early substituted random() in substitution functions. r=firefox-style-system-reviewers,emilio\"\n\nThis reverts commit 27ea5a44a55d200e62c959586ad913dfb936f36c.\n", "files": ["dom/base/nsINode.h", "layout/style/test/mochitest.toml", "layout/style/test/test_invalidation_container_query_unparsed_attr.html", "modules/libpref/init/StaticPrefList.yaml", "servo/components/selectors/matching.rs", "servo/components/style/custom_properties.rs", "servo/components/style/gecko/wrapper.rs", "servo/components/style/parser.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/mod.rs", "servo/components/style/properties_and_values/value.rs", "servo/components/style/stylesheets/container_rule.rs", "servo/components/style/stylist.rs", "servo/components/style/substitution/attr.rs", "servo/components/style/substitution/env.rs", "servo/components/style/substitution/inherit.rs", "servo/components/style/substitution/mod.rs", "servo/components/style/substitution/var.rs", "servo/components/style/values/specified/random.rs", "servo/components/style_traits/lib.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/__dir__.ini", "testing/web-platform/meta/css/css-values/inherit-function-basic.html.ini", "testing/web-platform/meta/css/css-values/inherit-function-invalidation.html.ini", "testing/web-platform/meta/css/css-values/inherit-function-parsing.html.ini", "testing/web-platform/tests/css/css-conditional/container-queries/style-query-custom-attr-nested-name-change.html", "testing/web-platform/tests/css/css-values/inherit-function-basic.html", "testing/web-platform/tests/css/css-values/inherit-function-invalidation.html", "testing/web-platform/tests/css/css-values/random-computed.tentative.html"], "git_node": "54e2a3625f672c72417ffeffd7dc37b45e9d9b95", "git_parents": ["202d3041a4938003ebd40deef0e25c50339305a6"], "node": "193e0c9a192bad5aec7fff428eadb35ad5908e8c", "parents": ["0340cfaa2811e176c9401821c37ba71334a31abe"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996168 - Use logical properties for spacing/positioning r=desktop-theme-reviewers,mstriemer,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337179\n", "files": ["browser/themes/linux/browser.css", "browser/themes/shared/customizableui/panelUI-shared.css", "browser/themes/shared/privatebrowsing/aboutPrivateBrowsing.css"], "git_node": "9200b0bc894b5f4fd4f8d106335cf818b2c2c555", "git_parents": ["54e2a3625f672c72417ffeffd7dc37b45e9d9b95"], "node": "5be9b69fae0142a95053615b03449170b3273ece", "parents": ["193e0c9a192bad5aec7fff428eadb35ad5908e8c"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996168 - Use logical properties for spacing/positioning r=geckoview-reviewers,akulyk,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337216\n", "files": ["docs/_static/sphinx_design.css", "dom/crypto/test/test_WebCrypto.css", "dom/events/test/pointerevents/wpt/pointerevent_styles.css", "dom/xml/test/old/books/classic.css", "dom/xml/test/old/books/common.css", "dom/xml/test/old/books/list.css", "dom/xml/test/old/xmlbase/xmlbase.css", "gfx/layers/layerviewer/tree.css", "mobile/android/themes/geckoview/config.css", "testing/mochitest/static/harness.css", "testing/mozbase/mozlog/mozlog/formatters/html/style.css", "tools/tryselect/selectors/chooser/static/style.css"], "git_node": "f8551fffa8b8c27d10d83b16fcd4ea13a1c17405", "git_parents": ["9200b0bc894b5f4fd4f8d106335cf818b2c2c555"], "node": "85cfbe74a1dd53a81289d22e44357ad51e1ae91e", "parents": ["5be9b69fae0142a95053615b03449170b3273ece"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085931: use Nova tab group token values by default r=nsharpley,desktop-theme-reviewers,tabbrowser-reviewers,reusable-components-reviewers,tgiles\n\nThis patch makes the base layer for tab.tokens.css reflect the Nova values for tab group tokens while leaving tabs.css unchanged to override Proton values for those tokens.\n\nIt looks like the current state was:\n1. tab.tokens.css base layer describes older values for Nova\n2. tab.tokens.css Nova layer describes the latest values for Nova\n3. tabs.css describes the Proton values\n\nParts 1 and 2 were confusing because some values are different and some token definitions were missing. This patch makes the base token layer set all of the Nova tokens with Nova values.\n\nThis change accomplishes two goals:\n1. fixes bug 2085931 by making sure each tab group token's `invert` counterpart is a correct light-dark swap of the non-inverted token\n2. makes it easier to clean up Proton tab group tokens, since they are now clearly in one location in tabs.css\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337267\n", "files": ["browser/themes/shared/tabbrowser/tab.nova.tokens.json", "browser/themes/shared/tabbrowser/tab.tokens.css", "browser/themes/shared/tabbrowser/tab.tokens.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-table.mjs"], "git_node": "09b86521110cb23b77f5385a0e02aa4013a41f97", "git_parents": ["f8551fffa8b8c27d10d83b16fcd4ea13a1c17405"], "node": "aeba22d2efdd0269c6970dda0c1e35d9b2186434", "parents": ["85cfbe74a1dd53a81289d22e44357ad51e1ae91e"], "tags": []}], "date": 1794520346, "git_changesets": ["c800aefce73bec4059296780015ba943962a1ec6", "baa844cc9835ba1d7e0d6a582db7730327a026de", "0137c84567644a3fa3eb02e83fb5299201058c6d", "4e32fee8b779216c6808ee1057883aa68b70769b", "3e3b16df04f74634f2c3b59d19558d91d5999f03", "ca09d5af568e3378a57ffc75c0bbf3ecb58c621a", "b092ff1bf282eb77366b47571b32610029822c49", "9e101d2b4f9d7db354987cd4821b4f689e0b38c4", "62b713f66bf9b628a89472b44eee756b6c172b28", "62dc22f7665a4637fb69a7adf465222acb6708fd", "1d5c63beaa48a24188e6c344a7f56e7cf62f162e", "5fabeec89c9911846b549c1f27c9a74a104d0b75", "963550ba9107ba475c7ff5fa60bbd3b16776bcae", "01a89f8f5c7f9557d45ac9ebc1d8b85aa5e41acb", "9964f61deed082ae55cbb84a25e13e03d99df3e4", "e3f8eb11d852648912a425c28eb3c05db6e77ca3", "641e7a22bdc3ef5514d9ee14747a195133742061", "c66ff4c1a88dffb0e1336bb8e29a4330b404fa54", "c702dea3059b07e0bf915c4032e5b81bf694c854", "5561e25d88d8b7111d75e061f4b0953104f487ac",