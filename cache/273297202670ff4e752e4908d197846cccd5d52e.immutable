rofiler/tests/xpcshell/test_source_table.js"], "git_node": "9f30100d4cd6cf8085ead5b87ddc449ec6e3a6b7", "git_parents": ["932d54e1748c1abad860e9de97621f2e9efc089c"], "node": "cd8ab1004b592d89078614e54273e91c403e301a", "parents": ["06e4cff7b9976e20f1529986fc7fed6a7a78c0f6"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2091211 - Fix active rect handling of view transition captures. r=nical,view-transitions-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342092\n", "files": ["layout/generic/nsImageFrame.cpp", "testing/web-platform/meta/css/css-view-transitions/massive-element-left-of-viewport-offscreen-new.html.ini", "testing/web-platform/meta/css/css-view-transitions/massive-element-left-of-viewport-offscreen-old.html.ini", "testing/web-platform/meta/css/css-view-transitions/massive-element-on-top-of-viewport-offscreen-new.html.ini", "testing/web-platform/meta/css/css-view-transitions/massive-element-on-top-of-viewport-offscreen-old.html.ini"], "git_node": "72de6495c46a07ed2e85471d01e6d8c7a1c14c6e", "git_parents": ["9f30100d4cd6cf8085ead5b87ddc449ec6e3a6b7"], "node": "6f1c0063caeebe0d061ed21acf31bf7df0ac902e", "parents": ["cd8ab1004b592d89078614e54273e91c403e301a"], "tags": []}, {"author": "Heitor Neiva \u003chneiva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084811 - Schedule Android store submissions for release day r=releng-reviewers,taskgraph-reviewers,jcristau\n\nSubmit Samsung, Huawei and vivo uploads during the push phase using\nrelease_eta. Without an ETA, keep uploading without submitting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336075\n", "files": ["taskcluster/android_taskgraph/transforms/push_android_app.py", "taskcluster/android_taskgraph/worker_types.py", "taskcluster/docs/kinds.md", "taskcluster/gecko_taskgraph/test/test_android_taskgraph.py", "taskcluster/kinds/push-android/kind.yml"], "git_node": "82ef26de923e3776d2cc2b4eb5735a3bc8186922", "git_parents": ["72de6495c46a07ed2e85471d01e6d8c7a1c14c6e"], "node": "62b6f64a7ea0234fed84da6cde764f937acbed5f", "parents": ["6f1c0063caeebe0d061ed21acf31bf7df0ac902e"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 1962169: Wait for the input's focus event in browser_focus_document.js before checking what has focus in the parent process r=accessibility-platform-reviewers,Jamie\n\nBased on try runs, this seems more consistent than the browser load\nstate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341519\n", "files": ["accessible/tests/browser/events/browser_focus_document.js"], "git_node": "6e02a0591931a3a63bec7d363d64fb387ed1d43a", "git_parents": ["82ef26de923e3776d2cc2b4eb5735a3bc8186922"], "node": "1b831789766eb06416ef9e678c553145201670f7", "parents": ["62b6f64a7ea0234fed84da6cde764f937acbed5f"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083003 - Add a Firefox newsletter sign-up card to the About Firefox settings pane. r=settings-reviewers,fluent-reviewers,mkennedy,flod\n\n- Adds a \"Firefox newsletter\" group to the bottom of the About Firefox pane, below Firefox support, with a moz-box-link pointing to the newsletter page with the UTM parameters from bug 2083003 comment 1.\n- The setting is only visible when the app locale is en-US, en-CA, en-GB, de or fr, per bug 2083003 comment 2.\n- Adds browser_newsletter_signup.js to cover the locale gating and the link URL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341514\n", "files": ["browser/components/preferences/config/about-firefox.mjs", "browser/components/preferences/preferences.js", "browser/components/preferences/tests/browser.toml", "browser/components/preferences/tests/browser_newsletter_signup.js", "browser/locales/en-US/browser/preferences/preferences.ftl"], "git_node": "712ebdb3691e792553c7c59624a221f116c6b3a0", "git_parents": ["6e02a0591931a3a63bec7d363d64fb387ed1d43a"], "node": "c95ea17f72ab2d60ac2950600a5e11cbf3acecd6", "parents": ["1b831789766eb06416ef9e678c553145201670f7"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2089759 - Drop nullable from the media codec IPDL parameters. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340127\n", "files": ["dom/media/ipc/PRemoteDecoder.ipdl", "dom/media/ipc/PRemoteEncoder.ipdl", "dom/media/ipc/RemoteAudioDecoder.cpp", "dom/media/ipc/RemoteDecoderChild.cpp", "dom/media/ipc/RemoteDecoderParent.cpp", "dom/media/ipc/RemoteDecoderParent.h", "dom/media/ipc/RemoteMediaDataEncoder.cpp", "dom/media/ipc/RemoteMediaDataEncoderParent.cpp", "dom/media/ipc/RemoteMediaDataEncoderParent.h", "dom/media/ipc/RemoteVideoDecoder.cpp"], "git_node": "a6f3fe8c56f880a773cca4917b389935861cb76a", "git_parents": ["712ebdb3691e792553c7c59624a221f116c6b3a0"], "node": "5aeb1a516e696bd2a43785946af5ae31b48f59dd", "parents": ["c95ea17f72ab2d60ac2950600a5e11cbf3acecd6"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091596 - Expand ANGLE Radeon GFX10 buffer upload workaround to all AMD GPUs. r=gfx-reviewers,bradwerth\n\nIn bug 2074540 we disabled the unsynchronized glMapBufferRange fast path\nfor DrawTargetWebgl buffer uploads on Radeon GFX10 GPUs when ANGLE is\nenabled, falling back to glBufferSubData. We have now received reports\nof a similar bug on additional AMD GPUs.\n\nAvoid the bug by taking the glBufferSubData path on all AMD GPUs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342064\n", "files": ["dom/canvas/WebGLBuffer.cpp", "gfx/gl/GLContext.cpp", "gfx/gl/GLContext.h", "gfx/gl/GLContextTypes.h"], "git_node": "c43cc54089f8e378560825ec8f95668fa48f708c", "git_parents": ["a6f3fe8c56f880a773cca4917b389935861cb76a"], "node": "64b1eac6cb5d11f7cfc4c9b169fc12d5d515aff0", "parents": ["5aeb1a516e696bd2a43785946af5ae31b48f59dd"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061238 - Add content-facing border to sidebar launcher when expand on hover is enabled and the sidebar is expanded r=desktop-theme-reviewers,sidebar-reviewers,akulyk,nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340415\n", "files": ["browser/themes/shared/sidebar.css"], "git_node": "cdb86abe967d4a31b8132074a714867d0a27891a", "git_parents": ["c43cc54089f8e378560825ec8f95668fa48f708c"], "node": "47a1d532e39bdd948282df1db0e6f6d53f4a7c55", "parents": ["64b1eac6cb5d11f7cfc4c9b169fc12d5d515aff0"], "tags": []}, {"author": "Ben Dean-Kawamura \u003cbdk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2011696 - Wire up Glean error ping on Desktop, r=janerik\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337980\n", "files": ["browser/components/StartupTelemetry.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAdsClient.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAutofill.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustBreachAlerts.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustContextId.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustDbCrypto.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFilterAdult.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFxcontainers.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustInitRustComponents.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustInterruptSupport.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTracing.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/src/lib.rs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "0588ab90cba6984f5dd2aed09e9509e07067e5f2", "git_parents": ["cdb86abe967d4a31b8132074a714867d0a27891a"], "node": "9baf4b8bfbd0842a705570c2252e4d875014d480", "parents": ["47a1d532e39bdd948282df1db0e6f6d53f4a7c55"], "tags": []}, {"author": "Taimur Hasan \u003cthasan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057035 - Read Google Docs through their /mobilebasic view in PageExtractor. r=ai-platform-reviewers,nordzilla\n\nBehind browser.pageextractor.googledocs.enabled, on by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335404\n", "files": ["modules/libpref/init/all.js", "toolkit/components/pageextractor/GoogleDocsExtraction.sys.mjs", "toolkit/components/pageextractor/PageExtractorChild.sys.mjs", "toolkit/components/pageextractor/PageExtractorEvents.sys.mjs", "toolkit/components/pageextractor/metrics.yaml", "toolkit/components/pageextractor/moz.build", "toolkit/components/pageextractor/tests/browser/browser.toml", "toolkit/components/pageextractor/tests/browser/browser_google_docs_extraction.js"], "git_node": "321abe97608e5add7c8197b116fa332a61f38fb1", "git_parents": ["0588ab90cba6984f5dd2aed09e9509e07067e5f2"], "node": "1cc9bfa6c06cdb2d56008106ea5823546fcaefa7", "parents": ["9baf4b8bfbd0842a705570c2252e4d875014d480"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088694 - add some tests for RTCAudioSourceStats;r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341069\n", "files": ["testing/web-platform/meta/webrtc-stats/getStats-RTCAudioSourceStats.https.html.ini", "testing/web-platform/tests/webrtc-stats/getStats-RTCAudioSourceStats.https.html"], "git_node": "b734a87832ce96986a55dd65e9ec1ad5ebe06b57", "git_parents": ["321abe97608e5add7c8197b116fa332a61f38fb1"], "node": "3d589784031d0a67c8d2b51c0bc21659c08841cd", "parents": ["1cc9bfa6c06cdb2d56008106ea5823546fcaefa7"], "tags": []}, {"author": "Nico Grunbaum \u003cna-g@nostrum.com\u003e", "branch": "default", "desc": "Bug 1728364 - add RTCAudioSourceStats to webidl;r=bwc,webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262001\n", "files": ["dom/webidl/RTCStatsReport.webidl"], "git_node": "29a69d9a601bab61887c4f33dd76ee561ac453a2", "git_parents": ["b734a87832ce96986a55dd65e9ec1ad5ebe06b57"], "node": "34e0306fc79eb68c990c6e63e53d69323e2c8e0f", "parents": ["3d589784031d0a67c8d2b51c0bc21659c08841cd"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 1728364 - implement RTCAudioSourceStats;r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262002\n", "files": ["dom/media/webrtc/WebrtcGlobal.h", "dom/media/webrtc/jsapi/RTCRtpSender.cpp"], "git_node": "cd3cfc3246967332f3edb0c6f3c97d1a6f0cf9c5", "git_parents": ["29a69d9a601bab61887c4f33dd76ee561ac453a2"], "node": "41160858525ebaf73b3b0c53499ccab18eb2503f", "parents": ["34e0306fc79eb68c990c6e63e53d69323e2c8e0f"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 1728364 - add RTCAudioSourceStats to PeerConnection stats mochitest;r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262003\n", "files": ["dom/media/webrtc/tests/mochitests/stats.js"], "git_node": "b78bac99580c41316e33ab4784da72d6efa88b09", "git_parents": ["cd3cfc3246967332f3edb0c6f3c97d1a6f0cf9c5"], "node": "91aad92701f51d3a4561dcb220eb1a8c336ae28a", "parents": ["41160858525ebaf73b3b0c53499ccab18eb2503f"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 1728364 - update WPT expectations for RTCAudioSourceStats;r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262004\n", "files": ["testing/web-platform/meta/webrtc-stats/getStats-RTCAudioSourceStats.https.html.ini", "testing/web-platform/meta/webrtc-stats/supported-stats.https.html.ini", "testing/web-platform/meta/webrtc/RTCPeerConnection-mandatory-getStats.https.html.ini"], "git_node": "6aa95d801091d7aa3cbb1778086dda2a6926b30f", "git_parents": ["b78bac99580c41316e33ab4784da72d6efa88b09"], "node": "790b907d88089b905e843b46942b2f1e40906506", "parents": ["91aad92701f51d3a4561dcb220eb1a8c336ae28a"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088585: Give authentication windows a consistent size and centered position. r=tabbrowser-reviewers,nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339269\n", "files": ["browser/components/tabbrowser/docs/opening-tabs.md", "browser/modules/ASWebAuthSessionService.sys.mjs", "browser/modules/URILoadingHelper.sys.mjs", "browser/modules/test/browser/browser_aswebauth_session.js"], "git_node": "daf21543dbc74308262d85fe2f2fa0c3b828903a", "git_parents": ["6aa95d801091d7aa3cbb1778086dda2a6926b30f"], "node": "9058daf474d01609a41cdbd10fbefb4e4e62e83a", "parents": ["790b907d88089b905e843b46942b2f1e40906506"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092180 - Use assertIs for the caught exception type in ListenSettingsTest. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342251\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/settings/ListenSettingsTest.kt"], "git_node": "469666cd8340f4c7c03dca41d930b96dc76d1daa", "git_parents": ["daf21543dbc74308262d85fe2f2fa0c3b828903a"], "node": "005edac3d960e26a8db596610dbb868982621b82", "parents": ["9058daf474d01609a41cdbd10fbefb4e4e62e83a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092219 - Mark sharedUserMaxSdkVersion as API 33 only in the Fenix Beta and Release manifests. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342289\n", "files": ["mobile/android/fenix/app/src/beta/AndroidManifest.xml", "mobile/android/fenix/app/src/release/AndroidManifest.xml"], "git_node": "7e19471cf8cd5a47c2288823dfd585242a222401", "git_parents": ["469666cd8340f4c7c03dca41d930b96dc76d1daa"], "node": "3e41f7f07d0d0beabfca8ff697a60c1e76afb643", "parents": ["005edac3d960e26a8db596610dbb868982621b82"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2092069 - Inject CoroutineScope into PromptMiddleware r=android-reviewers,giorga\n\nReplace the default MainScope() with an explicit CoroutineScope dependency.\nThis avoids creating an unmanaged scope within the middleware and aligns coroutine lifecycle ownership with the hosting application.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342162\n", "files": ["mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/PromptMiddleware.kt", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/DefaultComponents.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/Components.kt"], "git_node": "c485f098ccc5b46e9986aa551100d2aafae78f0d", "git_parents": ["7e19471cf8cd5a47c2288823dfd585242a222401"], "node": "9d1ca057876d9669f332c7dd1076c019cc1d1042", "parents": ["3e41f7f07d0d0beabfca8ff697a60c1e76afb643"], "tags": []}, {"author": "John Oberhauser \u003cj.git@obez.io\u003e", "branch": "default", "desc": "Bug 2081838 - Require profile authentication to manage passwords on Android Automotive OS r=mihai209,twhite\n\nOn Android Automotive OS with the `automotive-sensitive-data` Nimbus feature enabled, the password manager now uses the `AutomotiveSensitiveDataAuthenticator` check from bug 2081834 instead of the once-only device lock warning. Every entry point opens `SavedLoginsFragment`, so they are all covered. Cancelling the setup prompt or failing authentication leaves the user on the existing unlock screen. Other devices are unchanged.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/433\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/logins/ui/BiometricAuthenticationHelper.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/logins/ui/BiometricAuthenticationDialogTest.kt"], "git_node": "22490327085145e5e9c4297e02209e2adbe9bdd3", "git_parents": ["c485f098ccc5b46e9986aa551100d2aafae78f0d"], "node": "4e0763c223285f37f81fac7bdc025198c2331645", "parents": ["9d1ca057876d9669f332c7dd1076c019cc1d1042"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092181 - Read the pager swipe offset during layout and draw in SportsPagerIndicator. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342269\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/ui/SportsCardPager.kt"], "git_node": "38f60d2d79198857ebe77a43bc7fe9d0472467e5", "git_parents": ["22490327085145e5e9c4297e02209e2adbe9bdd3"], "node": "8707dfd5021bedda426bd6d96c534ebc993cfe40", "parents": ["4e0763c223285f37f81fac7bdc025198c2331645"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092200 - Enable reinstalls feature by default in all channels. r=Roger,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342268\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml"], "git_node": "9f01a9ccd06a0e21bc3520a6acf6c6a98fa1ad0c", "git_parents": ["38f60d2d79198857ebe77a43bc7fe9d0472467e5"], "node": "c0ad966c8f4d0aad3abf7721ce6e290476e72aa7", "parents": ["8707dfd5021bedda426bd6d96c534ebc993cfe40"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2092221 - Write LF line endings in appservices_version_bump.py r=android-build-system-reviewers,android-reviewers,ahochheiden,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342291\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/appservices_version_bump.py"], "git_node": "52ff395960f347ff55eadb98b435261f12d6dda0", "git_parents": ["9f01a9ccd06a0e21bc3520a6acf6c6a98fa1ad0c"], "node": "33656fd0a7832bb9096730313cbebea69c9aee18", "parents": ["c0ad966c8f4d0aad3abf7721ce6e290476e72aa7"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2091584 - Use the OLED colors for the homepage thumbnail background r=android-reviewers,npoon\n\n- Resolve the theme through getTheme() instead of a separate light, dark and private check.\n- Map each Theme to its color scheme with an exhaustive when, so Theme.Oled uses acornOledColorScheme().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342019\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/HomepageThumbnailIntegration.kt"], "git_node": "c1b0f1d73c825012b3187eb49eba4637afd4e338", "git_parents": ["52ff395960f347ff55eadb98b435261f12d6dda0"], "node": "0acd8acfcd5b6d2a6deb198021c0e34023a0dfc6", "parents": ["33656fd0a7832bb9096730313cbebea69c9aee18"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091396 - Fix Fenix unit tests that break with MockK 1.14.12. r=android-reviewers,mcarare\n\nMockK 1.14.12 applies mockk.restrictedClasses to @MockK/@RelaxedMockK fields too, so the BrowserStore mocks in\nDefaultTabManagerControllerTest and TabsCleanupFeatureTest now throw; use real stores instead. Verifications\nwith an upper bound now wait out their whole timeout, so ActivationPingTest waits for the call and checks the\ncount separately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341362\n", "files": ["mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/ActivationPingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/TabsCleanupFeatureTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/controller/DefaultTabManagerControllerTest.kt"], "git_node": "617444de4594bc12df21fdc2104dd8502cf0d76e", "git_parents": ["c1b0f1d73c825012b3187eb49eba4637afd4e338"], "node": "2b23b3c1ac55c3fc26b582c6c346c0d39a5df97e", "parents": ["0acd8acfcd5b6d2a6deb198021c0e34023a0dfc6"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091396 - Update MockK to version 1.14.12. r=android-build-system-reviewers,ahochheiden\n\nAlso remove the unused mockk-android catalog entry.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341363\n", "files": ["gradle/libs.versions.toml"], "git_node": "bec2c141d69db9379a5d40a8b35dd837d114f9ae", "git_parents": ["617444de4594bc12df21fdc2104dd8502cf0d76e"], "node": "d66c97b78d12060aabaf2cc40c615aa9c786e94a", "parents": ["2b23b3c1ac55c3fc26b582c6c346c0d39a5df97e"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088087 - Part 1. Reject createMediaKeys when RemoteCDMProxy cannot initialize its CDM. r=media-playback-reviewers,azebrowski\n\nMediaDrmRemoteCDMParent::RecvInit resolved before the AMediaDrm crypto\nexisted, and RemoteCDMProxy ignored the result of Init, so\ncreateMediaKeys resolved with a MediaKeys that could not be used.\nRecvInit now waits for the crypto and resolves with its error, and\nRemoteCDMProxy rejects the promise on a failed Init.\n\nInit failures were rejected off the main thread, and MediaKeys::Init did\nnot handle a missing CDM proxy.\n\nA provisioning response that is not ok is now rejected instead of being\ngiven to the plugin. The provisioning server can be overridden with\nmedia.eme.mediadrm.provisioning.url-override, so a test can check that\ncreateMediaKeys rejects after one provisioning attempt when the server\nfails or returns an invalid response.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338771\n", "files": ["dom/media/eme/MediaKeys.cpp", "dom/media/eme/mediadrm/MediaDrmProvisioning.sys.mjs", "dom/media/eme/mediadrm/MediaDrmRemoteCDMParent.cpp", "dom/media/ipc/RemoteCDMProxy.cpp", "dom/media/test/eme_mediadrm_provisioning.sjs", "dom/media/test/file_eme_mediadrm_provisioning_failure.html", "dom/media/test/mochitest_eme.toml", "dom/media/test/test_eme_mediadrm_provisioning_failure.html", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "234ae87ff3241ca6c747545808aa88fc8cfc8ba2", "git_parents": ["bec2c141d69db9379a5d40a8b35dd837d114f9ae"], "node": "301211973000f3885d934c26cc901fdba4456d22", "parents": ["d66c97b78d12060aabaf2cc40c615aa9c786e94a"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088087 - Part 2. Fail MediaDrmCDMProxy::Init when the Java bridge cannot create its crypto. r=geckoview-reviewers,tcampbell\n\nThis matches RemoteCDMProxy. A bridge that cannot create its crypto is\nreleased, which left createMediaKeys resolving with a bridge that cannot\nbe used.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338772\n", "files": ["dom/media/eme/mediadrm/MediaDrmCDMProxy.cpp", "dom/media/eme/mediadrm/MediaDrmProxySupport.cpp", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/GeckoMediaDrmBridge.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/MediaDrmProxy.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/MediaManager.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/RemoteManager.java"], "git_node": "5f13eb29e9f0c7af73356d05566a8eb9b3848dcb", "git_parents": ["234ae87ff3241ca6c747545808aa88fc8cfc8ba2"], "node": "41126d1a3c02038343057656088ba8041ee4a791", "parents": ["301211973000f3885d934c26cc901fdba4456d22"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088087 - Part 3. Expect MediaKeySession attribute syntax to fail on Android. r=media-playback-reviewers,azebrowski\n\nThe test creates more MediaKeys than the device has MediaDrm sessions.\ncreateMediaKeys now rejects when the CDM cannot create its crypto, so\nthe test fails with QuotaExceededError on the NDK path and\nInvalidStateError on the Java path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338773\n", "files": ["testing/web-platform/meta/encrypted-media/drm-mp4-syntax-mediakeysession.https.html.ini"], "git_node": "31a7e652a4d8e627fc6b12dea34b87501311a00f", "git_parents": ["5f13eb29e9f0c7af73356d05566a8eb9b3848dcb"], "node": "8d33665043ec28ed55224ec78a327bc0e797c60c", "parents": ["41126d1a3c02038343057656088ba8041ee4a791"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092213 - Provide the sports widget team badges at every screen density. r=android-reviewers,skhan\n\nLint now reports the still-unused badges against their hdpi copies, so their baseline entries move there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342287\n", "files": ["mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_birmingham.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_blackburn_rovers.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_bolton.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_bristol_city.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_burnley.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_cardiff.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_charlton.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_derby_county.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_lincoln_city.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_man_united.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_middlesbrough.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_millwall.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_norwich_city.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_portsmouth.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_preston.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_qpr.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_sheffield_united.webp", "mobile/android/fenix/app/src/main/res/drawable-hdpi/team_badge_southamp