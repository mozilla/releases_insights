 the wrong engines for each file r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit d19e20c19918a21769c34d8244b16200ef5d1ec3.\n\nRevert \"Bug 2012843 - Fix a failed download leaving a zero-length OPFS entry behind r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 002a869e445f56ea2f03ff6854bae1cf63062472.\n\nRevert \"Bug 2012843 - Fix fileExists treating a pending headers lookup as present r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit a2d537c73a0f4a4495bbface3bf597b5aac097a2.\n\nRevert \"Bug 2012843 - Fix denied models not being purged from the cache r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit f1685cabc5c51de14ee9dd4d22901d427c8cc2e6.\n\nRevert \"Bug 2012843 - Remove unused getModelFileAsResponse r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit bf46acad8a28980ffdfcadab0f3e5a641be6cbb3.\n\nRevert \"Bug 2012843 - Delete browser_ml_cache.js now that the model hub tests cover it r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 0b4386e2b9ae8edde1b15bf776acd9c02c33574b.\n\nRevert \"Bug 2012843 - Restore MOZ_ALLOW_EXTERNAL_ML_HUB after the tests that set it r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 74b088ce3195f5cedc3c386947cb35e18f0b8bf9.\n\nRevert \"Bug 2012843 - Add tests for the model hub denylist and listing r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 13522acf270ff83a79d344f499fd0fd644161302.\n\nRevert \"Bug 2012843 - Add tests for deleting models r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit c6ee6e3155908bb56db69fb31a108230e3d7f099.\n\nRevert \"Bug 2012843 - Add tests for ETag revalidation r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 3eca3fe64897a0c43bbea4324af8bf58aad5607f.\n\nRevert \"Bug 2012843 - Add tests for failed and retried downloads r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit c51ff8d659f7aaa9ae556fb564f9ada3f53efec6.\n\nRevert \"Bug 2012843 - Add tests for engine downloads through the model hub r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit fc51f10f239a11393fdd9da9db7d5ee0e163bdf2.\n\nRevert \"Bug 2012843 - Add tests for downloading and caching model files r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 10e477c70fc2b7352a4a76b61b4c3596b1b7adde.\n\nRevert \"Bug 2012843 - Add a mock model hub r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit ab13ded18b81d5c56f8a0a2e5676f8e583e72832.\n\nRevert \"Bug 2012843 - Add type checking to ModelHub.sys.mjs r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 9b2172d5b80d71b08ab0a0bafa4fa81cdbc34268.\n\nRevert \"Bug 2012843 - Remove OPFS usage in workers; r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 0307562b9d24982e354a2def94683b8fdaa851fe.\n\nRevert \"Bug 2012843 - Re-work OPFS.sys.mjs to pass TypeScript and remove dead code; r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 82294b12678985966cb7f7b954ddabdd7a5837d3.\n\nRevert \"Bug 2012843 - Remove incorrect isPrivateBrowsing call and test; r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit fdd7204cfb9f7f6092aaddce9edee3eb82028673.\n\nRevert \"Bug 2012843 - Add a characterization for OPFS behavior for model downloading; r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 35bef685d3ef7101c3123cba7dea2c55e7eb4163.\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/ASRouterNewTabHook.sys.mjs", "browser/components/backup/resources/MiscDataBackupResource.sys.mjs", "browser/components/mozcachedohttp/actors/MozCachedOHTTPParent.sys.mjs", "browser/components/newtab/AboutHomeStartupCache.sys.mjs", "browser/components/sessionstore/TabStateCache.sys.mjs", "browser/extensions/formautofill/content/editDialog.mjs", "browser/extensions/formautofill/content/manageDialog.mjs", "dom/console/ConsoleAPIStorage.sys.mjs", "dom/fs/test/xpcshell/head.js", "js/xpconnect/src/Sandbox.cpp", "js/xpconnect/src/XPCJSRuntime.cpp", "js/xpconnect/src/XPCRuntimeService.cpp", "js/xpconnect/src/xpcprivate.h", "js/xpconnect/tests/unit/test_storage.js", "toolkit/components/ml/actors/MLEngineChild.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/components/ml/content/MLEngine.worker.mjs", "toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/content/Utils.sys.mjs", "toolkit/components/ml/content/backends/LlamaCppPipeline.mjs", "toolkit/components/ml/content/backends/StaticEmbeddingsPipeline.mjs", "toolkit/components/ml/ml.d.ts", "toolkit/components/ml/tests/MLTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_cache.js", "toolkit/components/ml/tests/browser/browser_ml_engine_e2e.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_delete.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_denylist.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_download.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_download_failures.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_engine_e2e.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_etag.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_list.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_migration.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_owner_icon.js", "toolkit/components/ml/tests/browser/browser_ml_model_hub_url_parsing.js", "toolkit/components/ml/tests/browser/browser_ml_opfs.js", "toolkit/components/ml/tests/browser/browser_ml_opfs_private_window.js", "toolkit/components/ml/tests/browser/browser_ml_privatebrowsing.js", "toolkit/components/ml/tests/browser/browser_ml_telemetry.js", "toolkit/components/ml/tests/browser/ml_model_hub_echo_stub.worker.mjs", "toolkit/components/ml/tests/browser/shared-head.js", "toolkit/components/passwordmgr/test/unit/test_BreachAlertStore.js", "tools/@types/lib.gecko.tweaks.d.ts", "tools/lint/eslint/eslint-plugin-mozilla/lib/environments/privileged.mjs"], "git_node": "4c24f734d8214b601bab49ad4df00ccc45fdbe4d", "git_parents": ["7449e38b05e5b7ce1498e18075cdeb6d0943c1ae"], "node": "031b4a272ec8c9a7ce86f333fd03b9df945d43e7", "parents": ["a6780907e2f24866ca294ed272eccee8d3aeb9c5"], "tags": []}], "date": 1794994574, "git_changesets": ["1161851ffb5246e27933cb3e7e4c8795b5f4ad04", "b18ebf30419d396776a2f78ce2cb93c5fa4d451e", "82081e77c53a2dd4b9d190f34e32c543bfb30991", "aa15bff7e204af3c1548bb05dfbef2fb64324093", "c5c3c763e6a8ba7046d2b559660c9a195232fd30", "07a14c5675a8d9f560fd188b390cda1be1b8982a", "5ff9f89a34f5e7980e16a0b3f704d39929311407", "f4758ea3ba972a24d848f0b47afadfbbf6e4734a", "1e18aec39ea3a60d3475eb82163bc84e4b47ed6b", "8115fe23518251ca389f962124908f2486365535", "a4f140c57ca9edd55d4d534782c62984cd79d5f7", "05c831d441793c247dbcf7b668dea46c34c76fb1", "050c51c7135f5795ef6c257feb8c7c708eae3f1c", "615267205aa81fd3527093f50b9dac8f18155733", "ab43449cddab24b1d437c3867e9c55d0e161db3d", "f99c2e26fa57b0067485b2f24e1b9ffd5f079642", "4e5fa7a212918c0801b63f8d3393b8581750c1a0", "46134b1809d2abe405faef11cb870415f447557a", "9d2f1e021f0ab77960cea5b54c1d0aa0a3116726", "442fc08004722780d1068931d0f3bd5723e3e61b", "32707bddf8ae80e531af66ad769a4d20ebbc6e2c", "e170ddd5abe6ad15652ff37ad56d7cc861e5c2cd", "eec25622b95bcdbe75efd5de41eca63d4c54f827", "b064f2ca548372606bdf8d6a5f0489fcf546115e", "fc449ea9f96371d85998a4a6f38e28cf5766f231", "15570f1f5c902494a20b2ebb2097ea75f0530453", "4e556616af439923a2efd1e6daa2fc006262e194", "96b7a91d820a86c4c29fc6cb10c0cc2d0eecf60c", "377a282046065a2251af8dcb76a93d3ef151a838", "2011304d5dde801df149532507310e91e3f949dc", "23d48a65eebe2cb7666a455e7558e3c1562323a9", "630af3ada5173e57472b150d546f26d331c51235", "8289e23c523afb9fbfef02b5c82432cc815d55ca", "cb89217f72be3f6474d3c4ab98aa49147586b846", "5acb796dc810375faca899991c9cbd524f75c138", "b2a1e260ea8a5d2062c77f699095f980798c904b", "80e634134f5465b34548f2ad98c6ea01