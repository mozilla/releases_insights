2b843e044859cd207e", "1a4e7709ae5480bd3105daffa87d7254ee24dcbc", "d93b4011d1f1baf068451775bbd91b6552ffa163", "34ec04d4fa9d1c8ab9b5e7c4c2ac9980d3309f4f", "daec459afc8fa03dd9fd6ef9e738edccef6e9a44"], "user": "asilaghi@mozilla.com"}, "45830": {"changesets": [{"author": "lottiehope \u003clottie_hope@hotmail.co.uk\u003e", "branch": "default", "desc": "Bug 2082529 - Part 1: Move the certificate details logic and EU trust mark to support-utils. r=android-reviewers,jonalmeida\n\nThe certificate parsing and display logic and the EU trust mark drawables move from\nFenix to support-utils, so that Focus can show the same certificate details and\ntrust mark as the Fenix Trust Panel. Fenix behaviour is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D344030\n", "files": ["mobile/android/android-components/components/support/utils/src/main/java/mozilla/components/support/utils/CertificateDetails.kt", "mobile/android/android-components/components/support/utils/src/main/res/drawable/eu_trust_mark.xml", "mobile/android/android-components/components/support/utils/src/main/res/drawable/eu_trust_mark_inverted.xml", "mobile/android/android-components/components/support/utils/src/test/java/mozilla/components/support/utils/CertificateDetailsTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/store/CertificateDetails.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/store/TrustPanelState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/CertificateDetailsPanel.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/CertificateIssuedTo.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/CertificateVerifiedBy.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/IssuedTo.kt", "mobile/android/fenix/app/src/main/res/drawable/eu_trust_mark.xml", "mobile/android/fenix/app/src/main/res/drawable/eu_trust_mark_inverted.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/CertificateDetailsTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/CertificateIssuedToTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/CertificateVerifiedByTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/IssuedToTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/IssuerDisplayNameTest.kt"], "git_node": "898207dca073f0530b298a0f02215b6194bda7c1", "git_parents": ["daec459afc8fa03dd9fd6ef9e738edccef6e9a44"], "node": "be8ddb3278837ec5704708396ab9c2db68039a30", "parents": ["b17fde009f0e271a0d755a9397ca2d80a2fae912"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2094483 - Handle Android ImageReader fences for WebGL blits and readback r=gfx-reviewers,bradwerth\n\n- Share acquire-fence wait logic between Android ImageReader WebGL blits and readback. Abort the operation if the fence cannot be imported or waited on.\n- Export and register a release fence after each WebGL blit so the decoder can reuse the buffer once the GPU finishes reading it.\n- Fall back to glFinish() when the release fence cannot be exported, ensuring the blit completes before the image reference is released.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343828\n", "files": ["gfx/gl/GLBlitHelper.cpp", "gfx/layers/AndroidHardwareBuffer.cpp", "gfx/layers/AndroidHardwareBuffer.h", "gfx/layers/AndroidImageReader.cpp", "gfx/layers/AndroidImageReader.h"], "git_node": "d1cebfd0e8b3000fae60ef8ae7d00668c1b61e00", "git_parents": ["898207dca073f0530b298a0f02215b6194bda7c1"], "node": "525e88ad7b557f01f5ac7f932b77063b9be5a8fb", "parents": ["be8ddb3278837ec5704708396ab9c2db68039a30"], "