ial Revision: https://phabricator.services.mozilla.com/D340559\n", "files": ["mobile/android/android-components/components/support/test/src/main/java/mozilla/components/support/test/Assertions.kt", "mobile/android/android-components/components/support/test/src/test/java/mozilla/components/support/test/AssertionsTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/helpers/ExceptionAssertions.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/ui/TabManagementFragmentTest.kt"], "git_node": "540c1dc70a501ce7c66fa1d0be3eaf6ffb8cd3e2", "git_parents": ["2494b3b2217838f804bfe1af44ff7d7b0fbfd667"], "node": "28d529d91bef06052d7728957b35bbb2376c0b95", "parents": ["39ff0308218c932896d000d466b70ead62676282"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091076 - Suppress the deprecation javac lint in WebRTC's Android Java. r=webrtc-reviewers,mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341063\n", "files": ["dom/media/systemservices/android_video_capture/java/src/org/webrtc/videoengine/VideoCaptureAndroid.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/EglRenderer.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/SurfaceTextureHelper.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/AndroidVideoDecoder.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/Camera2Session.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/CameraSession.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/HardwareVideoEncoder.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/RefCountDelegate.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/audio/WebRtcAudioUtils.java"], "git_node": "0cc6ebbaf802a7b66025104d1b97738872e73310", "git_parents": ["540c1dc70a501ce7c66fa1d0be3eaf6ffb8cd3e2"], "node": "a7a0fea72bed57bb89a310efe6a3450a8a22a36c", "parents": ["28d529d91bef06052d7728957b35bbb2376c0b95"], "tags": []}, {"author": "Nora Liu \u003cnliu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085002 - Inline class fields with no initializer r=spidermonkey-reviewers,mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338017\n", "files": ["js/src/frontend/BytecodeEmitter.cpp", "js/src/frontend/Parser.cpp", "js/src/frontend/SharedContext.h", "js/src/jit-test/tests/parser/script-source-extent.js"], "git_node": "38bfd8e0b532fbafb76b25ba36be4e2cb61a73d1", "git_parents": ["0cc6ebbaf802a7b66025104d1b97738872e73310"], "node": "ca56dce358a3a5e4e48875b568941376bf229250", "parents": ["a7a0fea72bed57bb89a310efe6a3450a8a22a36c"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090233 - Enable per-site container assignment by default on Nightly, r=emz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340465\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "c91c400a4e0ef35f94b9f51b1ecfaa3ca43444f9", "git_parents": ["38bfd8e0b532fbafb76b25ba36be4e2cb61a73d1"], "node": "79cea20fdf959006059eedb0e994662676cd8011", "parents": ["ca56dce358a3a5e4e48875b568941376bf229250"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1932997 - Implement vertical tabs closing animation r=desktop-theme-reviewers,tabbrowser-reviewers,sidebar-reviewers,dao,kcochrane\n\nAllow vertical tabs to animate themselves while being added to or removed from the tabstrip. Animate vertical tabs by transitioning a grid row between 0fr and 1fr. This lets tab content determine the expanded height without an explicit height cap.\n\nOnly run transitions when the `height-animating` attr is present. This ensures that density changes don't needlessly invoke a transition.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335166\n", "files": ["browser/components/sidebar/tests/browser/browser_sidebar_collapsed_close_tab_button.js", "browser/components/sidebar/tests/browser/browser_vertical_tabs.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tabs.mjs", "browser/components/tabbrowser/content/tabsplitview.mjs", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_vertical_tab_animations.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "8e58afea7a18030e690f4efda3ac9b75c7794d15", "git_parents": ["c91c400a4e0ef35f94b9f51b1ecfaa3ca43444f9"], "node": "b7b49b14909c11a1f1605b7b0961d0146e761662", "parents": ["79cea20fdf959006059eedb0e994662676cd8011"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091077 - Stop using deprecated junit and androidx.test APIs in GeckoView tests. r=geckoview-reviewers,ohall\n\nThe Robolectric tests drop @SmallTest instead of moving to the androidx annotation, since only the\ninstrumentation runner filters on test size. The mock location provider keeps the deprecated Criteria\nconstants because the ProviderProperties overload of addTestProvider needs API 31.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341064\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/GeckoResultTest.java", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/MultiMapTest.java", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/TestCrashHandler.java", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/TestRuntimeService.java", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/util/UiThreadUtils.java", "mobile/android/geckoview/src/test/java/org/mozilla/gecko/util/GeckoBundleTest.java", "mobile/android/geckoview/src/test/java/org/mozilla/gecko/util/IntentUtilsTest.java", "mobile/android/geckoview/src/test/java/org/mozilla/gecko/util/LocaleUtilsTest.java"], "git_node": "00b59589793fa710b42424b00ddc0a7e735a5b48", "git_parents": ["8e58afea7a18030e690f4efda3ac9b75c7794d15"], "node": "070e68fead4b3b4cdf494612690e4b465ac37212", "parents": ["b7b49b14909c11a1f1605b7b0961d0146e761662"], "tags": []}, {"author": "Rana Al-Khulaidi \u003cralkhulaidi@gmail.com\u003e", "branch": "default", "desc": "Bug 2065369 - Remove the old Normandy migration system. r=nimbus-reviewers,beth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337220\n", "files": ["toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs", "toolkit/components/normandy/Normandy.sys.mjs", "toolkit/components/normandy/NormandyMigrations.sys.mjs", "toolkit/components/normandy/jar.mn", "toolkit/components/normandy/test/browser/browser.toml", "toolkit/components/normandy/test/browser/browser_NormandyMigrations.js", "toolkit/components/normandy/test/unit/test_Normandy.js"], "git_node": "9fb8074c467ab38764c2a4a0f775c4d30ab45a70", "git_parents": ["00b59589793fa710b42424b00ddc0a7e735a5b48"], "node": "9ac87daa40c32992cedea254735c7573c62e08b0", "parents": ["070e68fead4b3b4cdf494612690e4b465ac37212"], "tags": []}, {"author": "Resonance \u003cres0nancee@pm.me\u003e", "branch": "default", "desc": "Bug 2083466 - Request a SystemClockDriver graph for HTMLMediaElement.captureStream(). r=karlt,media-playback-reviewers\n\nWhen captureStream() created the graph for a media element with audio,\nit requested an AUDIO_THREAD_DRIVER graph, so an output stream was\nopened and started even though no audio output had been added yet.\nWith https://phabricator.services.mozilla.com/D334988, CheckDriver()\nthen switches to a SystemClockDriver until an output is added. Request a\nSYSTEM_THREAD_DRIVER graph instead, so that CheckDriver() creates the\nAudioCallbackDriver only when an output is added and no stream is started up\nfront.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340766\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp"], "git_node": "454876765e35d888e11d258ee9aed49a9d192eb8", "git_parents": ["9fb8074c467ab38764c2a4a0f775c4d30ab45a70"], "node": "9ef7f5cdbca33a56034e6f7c5cfb0daff880b8ab", "parents": ["9ac87daa40c32992cedea254735c7573c62e08b0"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060365 - Update ContextMenu url link functions to public r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321349\n", "files": ["mobile/android/android-components/components/feature/contextmenu/src/main/java/mozilla/components/feature/contextmenu/ContextMenuCandidate.kt"], "git_node": "bef7467d05bc0513c123ceef87b3f74fb3ecb992", "git_parents": ["454876765e35d888e11d258ee9aed49a9d192eb8"], "node": "1e3eeae521d6f7298819369ca6ad7682b11074fd", "parents": ["9ef7f5cdbca33a56034e6f7c5cfb0daff880b8ab"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2088670 - Clear node weak references when unlinking. r=dom-core-reviewers,smaug\n\nIt turns out we have a third kind of weak reference.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340924\n", "files": ["dom/base/nsINode.cpp", "dom/base/nsINode.h"], "git_node": "4b89189021a1294ffd095910f9ecdeab45511386", "git_parents": ["bef7467d05bc0513c123ceef87b3f74fb3ecb992"], "node": "ffc61b9d0e1726da2d2fc53b4d7a672d326153ad", "parents": ["1e3eeae521d6f7298819369ca6ad7682b11074fd"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088762 - Part 1 - Make mach wpt-metadata-merge work with Python 3 r=jgraham\n\n`Differences` defined `__nonzero__`, which Python 3 ignores, so tests\ndeleted from the current metadata came back whenever the new metadata\nleft them unchanged. `test_metamerge.py` would have caught this, but it\nhas never run in CI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339402\n", "files": ["testing/web-platform/metamerge.py"], "git_node": "d664d2fa262c01a8309857d46dcb50af1ec13522", "git_parents": ["4b89189021a1294ffd095910f9ecdeab45511386"], "node": "3bb6cb0d2d936cae59006ec4afe59401cbeab786", "parents": ["ffc61b9d0e1726da2d2fc53b4d7a672d326153ad"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088762 - Part 2 - Run the wpt python unit tests without a build r=taskgraph-reviewers,jcristau\n\nThe wpt Python unit tests were registered in\n`testing/web-platform/moz.build`, which is only read when a build\nenables tests. The `source-test` tasks run `mach python-test` without a\nbuild, so these tests never ran. `testing/moz.build` is always read, so\nthey are registered there now. The mozbase tasks also run when the\nPython files in `testing/web-platform` change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339403\n", "files": ["js/src/make-source-package.py", "taskcluster/kinds/source-test/python.yml", "testing/moz.build", "testing/web-platform/moz.build"], "git_node": "c14375edb84d6555f8657e3098f16bae68cdfca4", "git_parents": ["d664d2fa262c01a8309857d46dcb50af1ec13522"], "node": "5de18ab433fcd9f4e3966df95fdef41ab6c116a4", "parents": ["3bb6cb0d2d936cae59006ec4afe59401cbeab786"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088762 - Part 3 - Share the Gecko tree list between artifact builds and the wpt manifest download r=ahal\n\nBoth kept their own list of the mozilla-central, autoland and ESR trees,\nso every new ESR had to be added in two places.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339404\n", "files": ["python/mozbuild/mozbuild/artifact_builds.py", "python/mozbuild/mozbuild/artifacts.py", "testing/web-platform/manifestdownload.py"], "git_node": "c215e4c8dac5866630c7cf0b0cd8abf86fc256b6", "git_parents": ["c14375edb84d6555f8657e3098f16bae68cdfca4"], "node": "f6299d6c2df5e18c6323a8c83d334c3f73f784ba", "parents": ["5de18ab433fcd9f4e3966df95fdef41ab6c116a4"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088762 - Part 4 - Look up commit specific wpt manifests by git SHA on git checkouts r=ahal\n\nOn git checkouts the commit specific wpt manifest lookup never worked,\nbecause it sent git SHAs to the hg.mozilla.org pushlog (`json-pushes`),\nwhich only knows Mercurial changesets. Collecting those SHAs with a\n`git log` limited to the wpt test directories also stalled git backed\ntry artifact builds for 30 minutes or more. Filtering by path needs\neach commit's tree, and the deepened history has none, so git\ndownloaded the trees one at a time.\n\nGit checkouts now look up the 20 most recent commits from\n`git rev-list` directly in the taskcluster index, which is keyed by git\nSHA, and use the first match. `git rev-list` needs no trees. Only\npushes that change the wpt tests are indexed, but the manifest does not\nchange in between, so the first match is usually the right manifest.\nWith no match, the latest manifest is used as before.\n\nIndex requests now go through `get_root_url()`, which uses the\ntaskcluster proxy in CI, and every request now has a 30 second connect\nand read timeout.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339405\n", "files": ["python/mozversioncontrol/mozversioncontrol/repo/git.py", "python/mozversioncontrol/mozversioncontrol/repo/jj.py", "python/mozversioncontrol/test/python.toml", "python/mozversioncontrol/test/test_get_ancestors.py", "testing/web-platform/manifestdownload.py", "testing/web-platform/python.toml", "testing/web-platform/test_manifestdownload.py"], "git_node": "c8dda8c7b95794e27789e2ab403d11f758d2f6a8", "git_parents": ["c215e4c8dac5866630c7cf0b0cd8abf86fc256b6"], "node": "d519be4c8b5701e60c032a059aee5a8cd7a8bfb1", "parents": ["f6299d6c2df5e18c6323a8c83d334c3f73f784ba"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089210 - Send VPN on, off and location requests to the engine one at a time. r=android-reviewers,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338481\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/debug/IPProtectionStateDebug.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Actions.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/middleware/IPProtectionEngineMiddleware.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/middleware/IPProtectionLocationMiddleware.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/reducer/AccountReducer.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/reducer/ActivationReducer.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/reducer/LocationReducer.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/reducer/ProxyReducer.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/reducer/ServiceReducer.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/IPProtectionStatus.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/FakeIPProtectionHandler.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/IPProtectionFeatureTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/debug/IPProtectionStateDebugTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/storage/FakeEligibilityStorage.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/middleware/IPProtectionEngineMiddlewareTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/reducer/IPProtectionReducerTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/state/IPProtectionStatusTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtection.kt"], "git_node": "feefebc696815ecd7c917f6aed9a6388b67dcb4b", "git_parents": ["c8dda8c7b95794e27789e2ab403d11f758d2f6a8"], "node": "a1fbca8385c85980d102f6dcff2673a3b9b76931", "parents": ["d519be4c8b5701e60c032a059aee5a8cd7a8bfb1"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088575 - Poison entire allocations on Nightly only r=glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340822\n", "files": ["memory/build/Globals.h"], "git_node": "307dfb86d1e2e7dd2d9dc6bda9fa29522c7901c1", "git_parents": ["feefebc696815ecd7c917f6aed9a6388b67dcb4b"], "node": "0183f9e5074275d7240c15239b235f4bd35ae47d", "parents": ["a1fbca8385c85980d102f6dcff2673a3b9b76931"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090118 - Add script runner for ExternalResourceMap::PendingLoad::StartLoad r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340912\n", "files": ["dom/base/Document.cpp"], "git_node": "0dac0d5254fd44b0d43d9b1c911a93f1a38712cd", "git_parents": ["307dfb86d1e2e7dd2d9dc6bda9fa29522c7901c1"], "node": "93ac0730c120855909837a0ebf664a7d50386c7d", "parents": ["0183f9e5074275d7240c15239b235f4bd35ae47d"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1356018 - Expose ATK_STATE_READ_ONLY. r=accessibility-platform-reviewers,morgan\n\nAlso remove checkable state in the case that it is read only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339335\n", "files": ["accessible/atk/AccessibleWrap.cpp", "accessible/atk/nsStateMap.h", "testing/web-platform/meta/core-aam/aamtests/attribute/aria_readonly_true.py.ini", "testing/web-platform/meta/core-aam/aamtests/attribute/aria_readonly_unspecified_on_gridcell.py.ini"], "git_node": "7d1680b9a0d4a02087c52c3a9f050e88df389eae", "git_parents": ["0dac0d5254fd44b0d43d9b1c911a93f1a38712cd"], "node": "57a6ef267e57891d8ddaeac32a3dd31ac2900679", "parents": ["93ac0730c120855909837a0ebf664a7d50386c7d"], "tags": []}], "date": 1794282952, "git_changesets": ["64dfbf99a033e6ff69e964570615f212ecf21009", "c72331f05d49c91ee60b976e6791389dca953082", "a3cb459d1d39d134f9b697afe24494acbf297dd9", "fcf053566baff491ce0c372c594df5987e1d8cb5", "699fbb370474b1968d31af5d8b16adba29e1b4c7", "10b0b5dc04d70c06542caa5574d56212f12ab528", "35c86dbee187c1ffb27fa9c64a55bb3a96d7d508", "d85f864c6d7ae354ca43a28aa1b06e9524a01275", "8f5049e004d34411e161196bd9547a5b2f3c7511", "adda4fa7f24fc5553e8278038b3a39c4cd43f696", "fe56b58ce029dfd7a2950b410a5d0a502b934a16", "2b88f8e069e83431d7d7a9faa37a33c73334dbf8", "ce04697aaf1b507cb66713e37ba25cdbb604fb39", "4c4ef66ea3d4507d5c7eb1ecd6614debd23f756a", "48d72ce06267bf38ff352f6b7003db63f966cc78", "8a278d32949daafd6245bf89a232a1a3bf5ba70f", "ba0940c6fcb23096aad5e2088365e03d9d2ad45a", "0212230187e4a0a7fc3f4b3f9381aa6e12ad5a4a", "0904b043ac58e30784106fda6b9f07e0ed29ec84", "1decb865107ecb2b761d39e9b55371da466305ec", "ce5269797b58fa05d613ff52ef3d24f3ba30f3fd", "7bc1fdbf9e2aeb8ff74e12d0bf503e7f8dd1e431", "f2fb04982a609aecd2d58af4d53e4de9e1715a46", "f0eec3bcae14a92bfc2b11dd75f153778c39d26e", "093d61dc23c859511538d96139824a194408bcd7", "e35f44214000f0dbcf36d93e51500d4b4d5aa8b0", "8df9ff29399d37453e087e470d2dd8b31be3fbac", "c6f932cc8801895a22934531fad59bd0f62f8ac6", "4ba70e8e6ba60b190ca8de2eaed2e6aef03ed30b", "bc208b5437da13d8e22c38e89d49d23b97a206cf", "f20ea31dcca691b3eaea677dce92c0a4e7c9f0b5", "82ac8b0198090a827b8091a11ece86aabb3db0de", "4babf098ba6a3118a5bf76202e2b6f68507c6faf", "482b5f7a7c53e83498bdf5d1f267f0fc417741e5", "3c5d09b7cc898b2c97b5f2b85cfc8ff3582f674e", "ac7f982da837735cd0f0d5756d7741c6f20fc3ca", "501416d91a3ea8a61eb693d3e11ac24e1cb900bf", "0f7d0d158e45a4e8e6b82d1395d068c8785b4fc7", "2494b3b2217838f804bfe1af44ff7d7b0fbfd667", "540c1dc70a501ce7c66fa1d0be3eaf6ffb8cd3e2", "0cc6ebbaf802a7b66025104d1b97738872e73310", "38bfd8e0b532fbafb76b25ba36be4e2cb61a73d1", "c91c400a4e0ef35f94b9f51b1ecfaa3ca43444f9", "8e58afea7a18030e690f4efda3ac9b75c7794d15", "00b59589793fa710b42424b00ddc0a7e735a5b48", "9fb8074c467ab38764c2a4a0f775c4d30ab45a70", "454876765e35d888e11d258ee9aed49a9d192eb8", "bef7467d05bc0513c123ceef87b3f74fb3ecb992", "4b89189021a1294ffd095910f9ecdeab45511386", "d664d2fa262c01a8309857d46dcb50af1ec13522", "c14375edb84d6555f8657e3098f16bae68cdfca4", "c215e4c8dac5866630c7cf0b0cd8abf86fc256b6", "c8dda8c7b95794e27789e2ab403d11f758d2f6a8", "feefebc696815ecd7c917f6aed9a6388b67dcb4b", "307dfb86d1e2e7dd2d9dc6bda9fa29522c7901c1", "0dac0d5254fd44b0d43d9b1c911a93f1a38712cd", "7d1680b9a0d4a02087c52c3a9f050e88df389eae"], "user": "asilaghi@mozilla.com"}, "45748": {"changesets": [{"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2090948 - Disable -Wcpp for every macOS deployment target below 11.0. r=firefox-build-system-reviewers,ArnaudBienner,sergesanspaille\" for causing conflicts when backing out Bug 2072073 which is causing MACOS nightly balrog issues\n\nThis reverts commit 67a38d512b90e9fce1faaf2726423f474ff42540.\n", "files": ["build/moz.configure/bindgen.configure", "build/moz.configure/warnings.configure"], "git_node": "02fe1224a9cd23b555948d97daf02eb2015e3945", "git_parents": ["7d1680b9a0d4a02087c52c3a9f050e88df389eae"], "node": "4141e1ca0ba811c6de186333c3382cab926889d2", "parents": ["57a6ef267e57891d8ddaeac32a3dd31ac2900679"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072073 - Disable -Wcpp for macOS x86_64 builds. r=firefox-build-system-reviewers,sergesanspaille,ahochheiden\" at Stephen Pohl request for causing MacOS nightly balrog issues\n\nThis reverts commit ff4d11ecdaf3161379f40b32df2177c4bd09f283.\n\nRevert \"Bug 2072073 - Keep cpython from using pipe2 and dup3 on macOS. r=firefox-build-system-reviewers,sergesanspaille,glandium\"\n\nThis reverts commit 20b9636b76c24cd03e258e1ca6085a9643aa6dee.\n\nRevert \"Bug 2072073 - Update macOS SDK to 27.2. r=firefox-build-system-reviewers,mac-reviewers,sergesanspaille,spohl,ahochheiden\"\n\nThis reverts commit 7473b2886dc9974eea23b7273397a40c33e5098b.\n\nRevert \"Bug 2072073 - Teach cctools-port's libtapi about arm64e.x1. r=firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit 254c15b5ac00551061d2aa8c7a03ac4e17a9bf80.\n\nRevert \"Bug 2072073 - Backport the stack_protector_ignore attribute to clang 22. r=firefox-build-system-reviewers,sergesanspaille,ahochheiden\"\n\nThis reverts commit ee0de25f8bf772e50240c449f1aa70628cf299ca.\n\nRevert \"Bug 2072073 - Backport arm64e.x1 support to clang 22. r=firefox-build-system-reviewers,sylvestre\"\n\nThis reverts commit e0cabf73464cc7309ce4aa6c8722cab01f9a5535.\n", "files": ["build/build-clang/build-clang.py", "build/build-clang/clang-22.json", "build/build-clang/llvmorg-23-init-1731-ga63696edca8b.patch", "build/build-clang/llvmorg-24-init-8352-gb8007a8e4020.patch", "build/docs/toolchains.md", "build/macosx/catalog.py", "build/moz.configure/bindgen.configure", "build/moz.configure/toolchain.configure", "build/moz.configure/warnings.configure", "python/mozbuild/mozbuild/test/configure/macos_fake_sdk/SDKSettings.plist", "taskcluster/kinds/toolchain/custom-car.yml", "taskcluster/kinds/toolchain/macos-sdk.yml", "taskcluster/kinds/toolchain/misc.yml", "taskcluster/kinds/toolchain/python.yml", "taskcluster/scripts/misc/build-cctools-port.sh", "taskcluster/scripts/misc/build-cpython.sh", "taskcluster/scripts/misc/build-llvm-common.sh", "taskcluster/scripts/misc/cpython-3.10-macos-dup3-pipe2.patch", "taskcluster/scripts/misc/cpython-3.11-macos-dup3-pipe2.patch", "taskcluster/scripts/misc/libtapi-arm64e-x1.patch", "taskcluster/scripts/misc/macos-setup.sh"], "git_node": "1b9ab39f9b434f08ccbaa3a073ce592743554c01", "git_parents": ["02fe1224a9cd23b555948d97daf02eb2015e3945"], "node": "c50c88a5a25eb3e478303ca160e2234b4d5b3c4b", "parents": ["4141e1ca0ba811c6de186333c3382cab926889d2"], "tags": []}], "date": 1794288796, "git_changesets": ["02fe1224a9cd23b555948d97daf02eb2015e3945", "1b9ab39f9b434f08ccbaa3a073ce592743554c01"], "user": "asilaghi@mozilla.com"}, "45749": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087617: Allow caching evals containing inner objects r=mgaudet\n\nThere are two cases where the existing restriction actually matters: JSOp::Object, and JSOp::CallSiteObj. Both cases return an object from the script's data. JSOp::Object avoids reuse by only being usable in run-once context. JSOp::CallSiteObj is used to implement template literals, and is required by the spec to always return the same object for a given parse node. (See [the MDN article on template literals](https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Template_literals#:~:text=exact%20same%20literal%20array).)\n\nThis patch addresses the JSOp::Object case by not marking eval scripts as runOnce. The JSOp::Object optimization is the only effect of that flag, so the only thing we lose is slightly slower initialization of large top-level object literals in evals. In exchange, we can cache significantly more evals (in particular including evals with inner functions).\n\nIn the CallSiteObj case, the spec effectively requires us to store the CallSiteObj on the script, meaning that we can't share scripts that use template literals, including in inner functions. To handle this case, we simply disable caching for eval statements that include template literals, which shouldn't be that common.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340548\n", "files": ["js/src/builtin/Eval.cpp", "js/src/frontend/BytecodeCompiler.cpp", "js/src/frontend/BytecodeCompiler.h", "js/src/jit-test/tests/basic/eval-object-identity.js", "js/src/vm/JSScript.h"], "git_node": "2cce7105edbbdcadcfd4139d46d65b2a2f1cf2b1", "git_parents": ["7d1680b9a0d4a02087c52c3a9f050e88df389eae"], "node": "2c0530c576951100ae7b755a4040c8e9242dee59", "parents": ["57a6ef267e57891d8ddaeac32a3dd31ac2900679"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087617: Put eval scripts in the cache immediately r=mgaudet\n\nBecause eval scripts were runOnce, we did a complicated dance to remove them from the cache while running, then put them back afterwards. Now that they're no longer runOnce, we can simplify this code. Note that this also means that we can cache reentrant eval scripts and eval scripts that throw exceptions.\n\nWe also no longer need EvalCacheLookup::trace, because we've shortened the lifetime of its uses.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340549\n", "files": ["js/src/builtin/Eval.cpp", "js/src/jit-test/tests/basic/eval-reentrant.js", "js/src/jit-test/tests/basic/eval-throws.js", "js/src/vm/Caches.h"], "git_node": "a4150576087587551d779b7cb399b6ec16f83cf4", "git_parents": ["2cce7105edbbdcadcfd4139d46d65b2a2f1cf2b1"], "node": "6ef84a0a4bf2bec3da0bfeaec042af778fa0b635", "parents": ["2c0530c576951100ae7b755a4040c8e9242dee59"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087617: Hoist EvalType into Caches.h as an enum class r=mgaudet\n\nThe next patch will start using EvalType in EvalCacheEntry/EvalCacheLookup. To avoid defining bare DIRECT_EVAL / INDIRECT_EVAL in a larger scope, I'm also turning it into an enum class.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340550\n", "files": ["js/src/builtin/Eval.cpp", "js/src/vm/Caches.h"], "git_node": "d3af5478819c4e4226e4776315874b3fe8b4d760", "git_parents": ["a4150576087587551d779b7cb399b6ec16f83cf4"], "node": "2c38b30786fa4c538a18c368e16c0a93ec5e0200", "parents": ["6ef84a0a4bf2bec3da0bfeaec042af778fa0b635"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087617: Cache indirect and top-level evals r=mgaudet\n\nThe existing EvalCacheLookup does not store enough information to cache all evals correctly. In particular:\n\n1. We have to be careful to ensure that we only reuse an eval script if it will appear the same in a backtrace, so we need the introducerScript and introducerPc to be the same.\n2. An indirect eval can call `g.eval(s)` with two different globals for g1 and g2, so we need to compare the current global to the global of the cached script to ensure that they match.\n3. It is technically possible to have a direct and indirect eval at the same site if `eval` is replaced with a bound copy of itself.\n\nI also changed pc from a pointer to an offset, which means that at least on 64-bit, the size of an EvalCacheEntry is unchanged.\n\nWith this patch, we can now cache any eval unless a) it is called directly from Wasm, or b) it contains a JSOp::CallSiteObj. The former could be fixed if we really wanted; the latter is more or less mandatory because of the semantics of tagged template literals.\n\nA couple of existing debugger tests had to be updated because they did not expect script reuse.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340551\n", "files": ["js/src/builtin/Eval.cpp", "js/src/jit-test/lib/debuggerNXHelper.js", "js/src/jit-test/tests/basic/eval-cache-indirect.js", "js/src/jit-test/tests/debug/Script-gc-01.js", "js/src/vm/Caches.h"], "git_node": "4d59e109ca4950f4bbe49e67157f0b905ae1112b", "git_parents": ["d3af5478819c4e4226e4776315874b3fe8b4d760"], "node": "49211e5735cf997a91f5740d87299001766da3ac", "parents": ["2c38b30786fa4c538a18c368e16c0a93ec5e0200"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087617: Speed up hashing for long eval strings r=mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340552\n", "files": ["js/src/builtin/Eval.cpp", "js/src/jit-test/tests/basic/eval-cache-hash.js"], "git_node": "73be32eb009e865069197cce2ae44686b83e1953", "git_parents": ["4d59e109ca4950f4bbe49e67157f0b905ae1112b"], "node": "8ee487324b10b515660a74e2624987ecbef3335f", "parents": ["49211e5735cf997a91f5740d87299001766da3ac"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087617: Limit eval caching for non-syntactic scopes r=mgaudet\n\nWhile reviewing this stack, Claude consistently leaves comments along the lines of \"this design always does the right thing for non-syntactic scopes, but the reasoning is subtle\".\n\n(Concrete example: \"An unwritten assumption is now more exposed. Compilation reads env through ScopeContext::determineEffectiveScope, which walks a non-syntactic env chain looking for a CallObject. Caching by script+pc is only sound if that walk always gives the same result for a given script+pc. For function-frame direct evals that held trivially: the frame's own CallObject is first on the chain. With top-level direct evals now cached, a non-syntactic global script can run the same JSScript under different env chains; Gecko frame scripts do this. As far as I can tell, no such chain can contain a CallObject, and Debugger.Frame.eval compiles a fresh script each call, so this is fine today. A short comment on the cache key saying it's valid because compilation doesn't depend on env beyond the scope would help keep it that way.\")\n\nScopeContext::determineEffectiveScope looks for a surrounding CallObject and uses its scope. The only concerning case is if there's somehow a CallObject in the non-syntactic scope chain. That seems like a profoundly silly thing to do, but it's not trivial to assert without adding a bunch of code. The simplest way to nip this all in the bud is to just avoid caching direct eval in non-syntactic scopes. Indirect eval always uses the global lexical as the env, so non-syntactic scopes aren't an issue there.\n\n(The more precise version of this would allow direct eval to be cached if the caller frame is a function frame with its own CallObject, because in that case the ScopeContext::determineEffectiveScope walk will always find the immediately surrounding scope, but since we're already being conservative here, it seems better to keep it simple.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340553\n", "files": ["js/src/builtin/Eval.cpp"], "git_node": "766445ad6577f5a22361df08a3445150d4705a23", "git_parents": ["73be32eb009e865069197cce2ae44686b83e1953"], "node": "40d54d1f8f1343ece4355d8b7ddce9ae343e47bc", "parents": ["8ee487324b10b515660a74e2624987ecbef3335f"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2084831 - update response card to new layout r=jlewis,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339697\n", "files": ["browser/components/aiwindow/ui/components/aitab-tool-ui/aitab-tool-ui.css", "browser/components/aiwindow/ui/components/aitab-tool-ui/aitab-tool-ui.mjs", "browser/components/aiwindow/ui/test/browser/browser_aitab_tool_ui.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "b276c57b080dc32e693e7854338908d15c596509", "git_parents": ["766445ad6577f5a22361df08a3445150d4705a23"], "node": "910e0f70ca2a167d4b7f7f665dcfc1c5574cd89a", "parents": ["40d54d1f8f1343ece4355d8b7ddce9ae343e47bc"], "tags": []}, {"author": "nirmaladvani \u003cnirmaladvani@live.com\u003e", "branch": "default", "desc": "Bug 2060382 - Remove leading space from browser.backup.template.fallback-download.esr pref value r=kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316970\n", "files": ["browser/app/profile/firefox.js"], "git_node": "a652cda8a3f118406ef939e62d604b2df6e12f0b", "git_parents": ["b276c57b080dc32e693e7854338908d15c596509"], "node": "c596e270db401bc5180975b18dd62541ec3a8afc", "parents": ["910e0f70ca2a167d4b7f7f665dcfc1c5574cd89a"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 1808737: Wait for popupshown before hovering the menu items in test_focus_menu.xhtml r=accessibility-platform-reviewers,eeejay\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341076\n", "files": ["accessible/tests/mochitest/events/test_focus_menu.xhtml"], "git_node": "c0ae291b232163a5fd50829f38ebcd0be368bac4", "git_parents": ["a652cda8a3f118406ef939e62d604b2df6e12f0b"], "node": "aa6225da9c6bfd9ea93816098da7699d914c522c", "parents": ["c596e270db401bc5180975b18dd62541ec3a8afc"], "tags": []}, {"author": "Resonance \u003cres0nancee@pm.me\u003e", "branch": "default", "desc": "Bug 2083466 - Only use an AudioCallbackDriver when the graph has an audio device to drive. r=webrtc-reviewers,karlt,bwc\n\nMediaTrackGraphImpl::CheckDriver() kept an AudioCallbackDriver whenever\nany audio track was present, even if no track output had been added and\nno input device was open. A receive-only audio RTCRtpTransceiver creates\nsuch a track: the remote track, which pages do not necessarily ever\nattach to a sink, kept the output stream open for the lifetime of the\npeer connection. Bot-detection scripts (x.com's \"Checking your Browser\"\ninterstitial, hCaptcha frames) do this on page load and thereby make\nmacOS route automatically-switching Bluetooth headsets to the machine\nalthough nothing is audible.\n\nRequire a native input track or at least one track output on an output\ndevice before creating or keeping an AudioCallbackDriver, instead of any\naudio track; pending resume operations still force one. The output of a\nsuspended or ended track renders only silence and does not count, so\nthat the destination track of an AudioContext that is not allowed to\nstart, or that has been suspended, does not bring up an\nAudioCallbackDriver merely because an unrelated audio track without an\noutput, such as a remote WebRTC track, shares the graph.\nAudioTrackPresent() is no longer needed and is removed. Audio tracks\nwithout any device are processed by the SystemClockDriver, as they\nalready are while an AudioCallbackDriver is starting up. CheckDriver()\ncreates the AudioCallbackDriver when an output is added, e.g. when a\nremote track is attached to an HTMLMediaElement.\n\nTests that relied on a bare audio track to bring up an output-only\nAudioCallbackDriver, in TestAudioTrackGraph and in the TestDecodedStream\nfixture, now add an audio output to that track, except\nSetInputChannelCountBeforeAudioCallbackDriver, which no longer waits for\nan output-only stream: its graph now stays on the SystemClockDriver\nuntil the input device is connected. New tests cover an audio track\nwithout a device staying on the SystemClockDriver, switching to an\nAudioCallbackDriver when an output is added and back when it is\nremoved, and outputs of suspended or ended tracks not counting while\nanother audio track is active.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334988\n", "files": ["dom/media/MediaTrackGraph.cpp", "dom/media/MediaTrackGraphImpl.h", "dom/media/gtest/TestAudioTrackGraph.cpp", "dom/media/gtest/TestDecodedStream.cpp"], "git_node": "977a8c0db2d22b5b4418a890f2b16d7086aae001", "git_parents": ["c0ae291b232163a5fd50829f38ebcd0be368bac4"], "node": "953c24d5abd1d55e4b970d9621ac36df9e5bf746", "parents": ["aa6225da9c6bfd9ea93816098da7699d914c522c"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2044348 - Enable headingoffset by default r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340303\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/dom/idlharness.https.html.ini"], "git_node": "cd8001495a21d337cd7cdd4079cbc19f05bd036f", "git_parents": ["977a8c0db2d22b5b4418a890f2b16d7086aae001"], "node": "d9dc79500f84547f00f944cf5c367763a25a8952", "parents": ["953c24d5abd1d55e4b970d9621ac36df9e5bf746"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087617: Limit eval caching for non-syntactic scopes r=mgaudet\" for causing mochitests chrome failures at nearNativeStackLimit\n\nThis reverts commit 766445ad6577f5a22361df08a3445150d4705a23.\n\nRevert \"Bug 2087617: Speed up hashing for long eval strings r=mgaudet\"\n\nThis reverts commit 73be32eb009e865069197cce2ae44686b83e1953.\n\nRevert \"Bug 2087617: Cache indirect and top-level evals r=mgaudet\"\n\nThis reverts commit 4d59e109ca4950f4bbe49e67157f0b905ae1112b.\n\nRevert \"Bug 2087617: Hoist EvalType into Caches.h as an enum class r=mgaudet\"\n\nThis reverts commit d3af5478819c4e4226e4776315874b3fe8b4d760.\n\nRevert \"Bug 2087617: Put eval scripts in the cache immediately r=mgaudet\"\n\nThis reverts commit a4150576087587551d779b7cb399b6ec16f83cf4.\n\nRevert \"Bug 2087617: Allow caching evals containing inner objects r=mgaudet\"\n\nThis reverts commit 2cce7105edbbdcadcfd4139d46d65b2a2f1cf2b1.\n", "files": ["js/src/builtin/Eval.cpp", "js/src/frontend/BytecodeCompiler.cpp", "js/src/frontend/BytecodeCompiler.h", "js/src/jit-test/lib/debuggerNXHelper.js", "js/src/jit-test/tests/basic/eval-cache-hash.js", "js/src/jit-test/tests/basic/eval-cache-indirect.js", "js/src/jit-test/tests/basic/eval-object-identity.js", "js/src/jit-test/tests/basic/eval-reentrant.js", "js/src/jit-test/tests/basic/eval-throws.js", "js/src/jit-test/tests/debug/Script-gc-01.js", "js/src/vm/Caches.h", "js/src/vm/JSScript.h"], "git_node": "33f1412ac58ffa242ae8ef2333e6c7ec9cbb4f43", "git_parents": ["cd8001495a21d337cd7cdd4079cbc19f05bd036f"], "node": "2f766825120007054765595da872bdb39d5ef7f1", "parents": ["d9dc79500f84547f00f944cf5c367763a25a8952"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/browser/toolbar/src/main/res/values-de/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-de/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-tg/strings.xml", "mobile/android/android-components/components/feature/downloads/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-tg/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/sitepermissions/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/ui/tabcounter/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-brh/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rGB/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/res/values-fa/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gl/strings.xml", "mobile/android/fenix/app/src/main/res/values-hsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-in/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-iw/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml"], "git_node": "d601ba32f857ffe8d23e4dffaa162fc83fa085c1", "git_parents": ["33f1412ac58ffa242ae8ef2333e6c7ec9cbb4f43"], "node": "b4881ea728627babfecf1add580eaa366a7b6255", "parents": ["2f766825120007054765595da872bdb39d5ef7f1"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2085480 - Re-enable SharedSurface_AndroidHardwareBuffer with WebGL on Android r=jnicol\n\nSharedSurface_AndroidHardwareBuffer was disabled in Bug 2084321 because it was suspected of causing the crashes. Further investigation showed that the crashes were unrelated to this feature, so it is safe to re-enable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340207\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "e39ab70032a93474b725518a896707ad2bfb184f", "git_parents": ["d601ba32f857ffe8d23e4dffaa162fc83fa085c1"], "node": "4de5c080e67df4ffe567e118a1cbf285c24137d3", "parents": ["b4881ea728627babfecf1add580eaa366a7b6255"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2087392 - [loong64] Enable canStoreConstantWithoutRegister for zeroes on Loong64. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338230\n", "files": ["js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.h"], "git_node": "a5a42f2c4395f0fdb62e028745732872d84ec3d8", "git_parents": ["e39ab70032a93474b725518a896707ad2bfb184f"], "node": "504b1e9343221a5aeae7dfea81861b2143997be0", "parents": ["4de5c080e67df4ffe567e118a1cbf285c24137d3"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2087394 - [riscv64] Enable canStoreConstantWithoutRegister for zeroes on RISCV64. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338237\n", "files": ["js/src/jit/riscv64/Lowering-riscv64.cpp", "js/src/jit/riscv64/Lowering-riscv64.h"], "git_node": "a7254a3785aa6759ebcff36962ded3ec42404bc2", "git_parents": ["a5a42f2c4395f0fdb62e028745732872d84ec3d8"], "node": "fc89577df7a6f2bc97f6ca62ffd939f431e928e3", "parents": ["504b1e9343221a5aeae7dfea81861b2143997be0"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090215 - Add a file workspace for the widget generation tools. r=mconley\n\nAdds a `Workspace` that holds the widget's files during generation and runs the model's tool calls on them.\n\n- Checks each call against the tool definitions and returns errors to the model as the tool reply.\n- Adds `edit_file`, `read_file` and `delete_file` tools alongside `write_file`.\n- Raises `browser.widgets.generated.maxTurns` to 30 to account for extra tool calls.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340560\n", "files": ["browser/app/profile/firefox.js", "browser/components/widgets/Tools.sys.mjs", "browser/components/widgets/WidgetGenerator.sys.mjs", "browser/components/widgets/Workspace.sys.mjs", "browser/components/widgets/moz.build", "browser/components/widgets/prompt.md", "browser/components/widgets/tests/browser/browser_generated_widgets.js"], "git_node": "55ecc53c4c9022460a9211a5c9abcd14f18fb5b8", "git_parents": ["a7254a3785aa6759ebcff36962ded3ec42404bc2"], "node": "7f57b8a09c6d061edb94739b86d7977c0c53265a", "parents": ["fc89577df7a6f2bc97f6ca62ffd939f431e928e3"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090455 - Add a decline_request tool for widget generation. r=mconley\n\nAdds a `decline_request` tool that ends generation with an `unsupported`, `unclear` or `policy` error.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340570\n", "files": ["browser/components/widgets/Tools.sys.mjs", "browser/components/widgets/WidgetGenerator.sys.mjs", "browser/components/widgets/Workspace.sys.mjs", "browser/components/widgets/prompt.md", "browser/components/widgets/tests/browser/browser_generated_widgets.js"], "git_node": "cd63fd65b0a778318269d309001a5b18a2369b3d", "git_parents": ["55ecc53c4c9022460a9211a5c9abcd14f18fb5b8"], "node": "948c3dd3cafd684afeefbecd31671b2ad5137084", "parents": ["7f57b8a09c6d061edb94739b86d7977c0c53265a"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044348 - Enable headingoffset by default r=dom-core-reviewers,jjaschke\" for causing browser chrome failures at nsINode.cpp\n\nThis reverts commit cd8001495a21d337cd7cdd4079cbc19f05bd036f.\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/dom/idlharness.https.html.ini"], "git_node": "7362239ddd06fe3db5049cf3fc793ecd52e78068", "git_parents": ["cd63fd65b0a778318269d309001a5b18a2369b3d"], "node": "ec9d6a78121a0872af1b16ee85a2bfed4dac8696", "parents": ["948c3dd3cafd684afeefbecd31671b2ad5137084"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087134 - Limit tp6/tp6m tests to only run on autoland instead of trunk r=perftest-reviewers,aglavic\n\ntp6/tp6m currently run on autoland and m-c. This is mostly duplicate\ncoverage at this point, so we should limit it to autoland only and save\non unnecessary hardware use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340068\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "taskcluster/kinds/browsertime/mobile.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "fea892e5bacc8cbb830323d6d31851ba2b64bb35", "git_parents": ["7362239ddd06fe3db5049cf3fc793ecd52e78068"], "node": "c44358c84f5fdbae6bc9939ce0c6288c965d33d6", "parents": ["ec9d6a78121a0872af1b16ee85a2bfed4dac8696"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2084393 - Fix setting primary attribute for activeness change in GeckoView r=geckoview-reviewers,ohall\n\nReactivation doesn't re-register the primary BrowserParent (that only happens on a BrowserParent change), so re-assert the primary attribute to force nsFrameLoader to restore this browser as the window's primary content. Without this, APIs that rely on the primary content browsing context break after the tab is backgrounded and reselected (ScrollCapture and captureFullPage are affected, other potentially affected APIs include SessionFinder, SessionTextInput, SelectionActionDelegate, getPageToScreenMatrix, getPageToSurfaceMatrix, printToPdf, printPageContent, ScrollDelegate).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336281\n", "files": ["mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/background.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-api.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-schema.json", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/BaseSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/SessionLifecycleTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java", "mobile/shared/modules/geckoview/GeckoViewContent.sys.mjs"], "git_node": "344c3b0dbfbbe8877abba822969520da5f6199fd", "git_parents": ["fea892e5bacc8cbb830323d6d31851ba2b64bb35"], "node": "44180bd268626f142679afed96e01bc1da6248d6", "parents": ["c44358c84f5fdbae6bc9939ce0c6288c965d33d6"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 1833214 - Add a WPT that scrolling only the layout viewport fires no visualViewport scroll event. r=layout-reviewers,jwatt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341131\n", "files": ["testing/web-platform/tests/visual-viewport/viewport-no-scroll-event-on-layout-viewport-scroll.html"], "git_node": "418258d4a192fa8bc16972b2b517657e27af2623", "git_parents": ["344c3b0dbfbbe8877abba822969520da5f6199fd"], "node": "5cc58d5b26188ea607937d532d90939513003712", "parents": ["44180bd268626f142679afed96e01bc1da6248d6"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 1831655 - Add a WPT that smooth scrolling to fractional offsets fires no visualViewport scroll event. r=layout-reviewers,jwatt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339774\n", "files": ["testing/web-platform/tests/visual-viewport/viewport-no-scroll-event-on-layout-viewport-smooth-scroll-to-fractional-offset.html"], "git_node": "bca0f859e8ccf0800ecb744227ce8580a16c4281", "git_parents": ["418258d4a192fa8bc16972b2b517657e27af2623"], "node": "2a1b9d5b103b4e0e16221052c79e28aee5bc0c23", "parents": ["5cc58d5b26188ea607937d532d90939513003712"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084216: mark a failed WebTransport's rejected closed and ready promises as handled r=jib\n\nAlso renumber the cleanup step comments to match the current spec, and drop\nthe harness ERROR expectations the unhandled rejections caused.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336207\n", "files": ["dom/webtransport/api/WebTransport.cpp", "testing/web-platform/meta/connection-allowlist/tentative/webtransport-document.https.sub.window.js.ini", "testing/web-platform/meta/webtransport/export-keying-material.https.any.js.ini"], "git_node": "5733912a00c790603ae83312bf4992329e5f8f09", "git_parents": ["bca0f859e8ccf0800ecb744227ce8580a16c4281"], "node": "a86731bbb851756ad169f6332aeeab7f673b5452", "parents": ["2a1b9d5b103b4e0e16221052c79e28aee5bc0c23"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084281 - [devtools] Fallback to the style editor for inline style links r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335710\n", "files": ["devtools/client/framework/toolbox.js"], "git_node": "27cfd9bd2638572c1b07ade5335a590ad95e1ebf", "git_parents": ["5733912a00c790603ae83312bf4992329e5f8f09"], "node": "461b3ad4d6e831d7c43a32fc46dc59a6d109f4ac", "parents": ["a86731bbb851756ad169f6332aeeab7f673b5452"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081428 - [devtools] Enable 'devtools.debugger.features.stylesheets-in-debugger' by default r=devtools-reviewers,jdescottes,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333605\n", "files": ["browser/app/profile/firefox.js", "devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_debug_debugger.js", "devtools/client/debugger/test/mochitest/browser_dbg-reloading.js", "devtools/client/framework/test/browser_toolbox_view_source_03.js", "devtools/client/framework/test/head.js", "devtools/client/inspector/computed/test/browser_computed_original-source-link.js", "devtools/client/inspector/computed/test/browser_computed_style-editor-link.js", "devtools/client/inspector/markup/test/browser_markup_links_06.js", "devtools/client/inspector/rules/test/browser_rules_original-source-link.js", "devtools/client/inspector/rules/test/browser_rules_original-source-link2.js", "devtools/client/inspector/rules/test/browser_rules_style-editor-link.js", "devtools/client/inspector/rules/test/head.js", "devtools/client/netmonitor/test/browser_net_open_in_style_editor.js", "devtools/client/webconsole/test/browser/browser_webconsole_location_styleeditor_link.js"], "git_node": "78fbf11ad231ad0d9f3d561da4b24c04901e6991", "git_parents": ["27cfd9bd2638572c1b07ade5335a590ad95e1ebf"], "node": "c16610f68b7ea53aa055f63d637956721e3ad3c3", "parents": ["461b3ad4d6e831d7c43a32fc46dc59a6d109f4ac"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081428 - [devtools] Clarify the rule view link tests for styles with sourcemaps r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338279\n", "files": ["devtools/client/inspector/rules/test/browser_rules_original-source-link.js", "devtools/client/inspector/rules/test/browser_rules_original-source-link2.js"], "git_node": "a016453e9dba473ec94397dc7ce6c6d60e02b42b", "git_parents": ["78fbf11ad231ad0d9f3d561da4b24c04901e6991"], "node": "735fd3959b588519fd146eba90bbbf71f0bd6808", "parents": ["c16610f68b7ea53aa055f63d637956721e3ad3c3"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087450 - [devtools] Update the tooltip for style links when the stylesheet in debugger pref is enabled r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338280\n", "files": ["devtools/client/inspector/rules/test/browser_rules_original-source-link.js", "devtools/client/inspector/rules/test/browser_rules_style-editor-link.js", "devtools/client/inspector/rules/views/rule-editor.js", "devtools/client/shared/components/Frame.js", "devtools/client/shared/components/test/chrome/test_frame_01.html"], "git_node": "e997028c944ca3cc634899ce56f8c2d33f1531be", "git_parents": ["a016453e9dba473ec94397dc7ce6c6d60e02b42b"], "node": "f892f59eab69bf0b49b3275eb9b89e24add9c202", "parents": ["735fd3959b588519fd146eba90bbbf71f0bd6808"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091029 - Update cctools-port to cctools 1035.1.102 and ld64 957.1, and libtapi to the latest revision. r=firefox-build-system-reviewers,ahochheiden\n\nThis drops the patches merged upstream: the arm64e.x1 TextAPI support, the LLVM 23 lto.h header copy, the\nstring pool out-of-bounds read fix and the ld64 exception keeping Rust compiler_builtins atoms live during LTO\ndead-stripping.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341054\n", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/misc.yml", "taskcluster/scripts/misc/build-cctools-port.sh", "taskcluster/scripts/misc/cctools-ld64-dead-strip-compiler-builtins.patch", "taskcluster/scripts/misc/cctools-ld64-fix-out-of-bounds-read.patch", "taskcluster/scripts/misc/cctools-llvm-c-headers.patch", "taskcluster/scripts/misc/libtapi-arm64e-x1.patch"], "git_node": "0036fce1cf2b2dded59877cf13c850a7c83a002f", "git_parents": ["e997028c944ca3cc634899ce56f8c2d33f1531be"], "node": "30a3533df084681bbf2021aa5a916bc68c53803f", "parents": ["f892f59eab69bf0b49b3275eb9b89e24add9c202"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077495 - Assert that the TLSTransportLayer stream wrappers are armed on the socket thread. r=necko-reviewers,valentin,leggert\n\nAsyncWait stored the callback before checking the thread, and the callback members are updated on the socket thread, so arming from another thread was never safe.  The only consumers arm on the socket thread, so assert that and drop the dispatch of the poll from InputStreamWrapper::AsyncWait.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330410\n", "files": ["netwerk/protocol/http/TLSTransportLayer.cpp"], "git_node": "c84ad74c9488a9346ee3ca8f1a10020522befbdc", "git_parents": ["0036fce1cf2b2dded59877cf13c850a7c83a002f"], "node": "459642c5c5b64207f2a7e636ca8dc764dfd5de0a", "parents": ["30a3533df084681bbf2021aa5a916bc68c53803f"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2089860 - Pad OSI points with nops the way Baseline pads debug mode OSR points. r=jandem\n\nCodeGeneratorShared::ensureOsiSpace() works out how many bytes of\npadding an OSI point needs but emitted one nop per byte, so every\nbackend whose nop is four bytes padded four times as much as it needed\nto. BaselineCompilerCodeGen::ensureDebugModeOSRPointSpace() already\nsteps by Assembler::NopSize(), and uses one multi-byte nop on x86 and\nx64. Move it into MacroAssembler::ensureNearCallPatchSpace() and use\nthat for both.\n\nHow much the overpadding costs depends on PatchWrite_NearCallSize(), the\nroom an OSI point needs for the call invalidation patches in. ARM and\nARM64 patch in a 4-byte BL, so they pad only when two OSI points share\nan offset, which happened once in a JetStream 3 run on ARM64. RISC-V 64\npatches in 28 bytes (li_ptr and jalr), so padding is common: the first\nOSI point of a function, 16 bytes past its prologue, got 12 nops rather\nthan 3. In a JetStream 3 run on a SpacemiT K3 this removes 85,579 of the\n156,684 nops in Ion code, 342 KB or 0.41% of it.\n\nMIPS64 and LoongArch64 patch in 24 and 16 bytes, so they pad with up to\n24 and 16 nops where 6 and 4 would do, and should shrink in the same\nway. Neither has been measured.\n\nFound with riscvlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340206\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/shared/CodeGenerator-shared.cpp"], "git_node": "5ee28366bda0b2be05fcad10742af312749f7214", "git_parents": ["c84ad74c9488a9346ee3ca8f1a10020522befbdc"], "node": "f4aa12258fadf6141ca954c89a66ed657117e510", "parents": ["459642c5c5b64207f2a7e636ca8dc764dfd5de0a"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\u00a0\n", "files": ["build/build-clang/llvmorg-23-init-1731-ga63696edca8b.patch", "build/build-clang/llvmorg-24-init-8352-gb8007a8e4020.patch", "taskcluster/kinds/toolchain/misc.yml", "taskcluster/scripts/misc/build-cctools-port.sh", "taskcluster/scripts/misc/cpython-3.10-macos-dup3-pipe2.patch", "taskcluster/scripts/misc/cpython-3.11-macos-dup3-pipe2.patch"], "git_node": "206ebeb5ebba14bf4c98790622207153c82229b9", "git_parents": ["5ee28366bda0b2be05fcad10742af312749f7214", "1b9ab39f9b434f08ccbaa3a073ce592743554c01"], "node": "aa021af8f0f71d24c4b9e871d7650b14670205e5", "parents": ["f4aa12258fadf6141ca954c89a66ed657117e510", "c50c88a5a25eb3e478303ca160e2234b4d5b3c4b"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2087950 - Make rbx the x64 JIT scratch register and move R1 to r11. r=jandem\n\nScratchReg is r11, so every scratch use that is not already 64-bit pays a REX\nbyte for the register number alone. It is among the most used registers in\nBaseline and Ion code. rbx is the only low register without a fixed role in\nthe JIT ABI, apart from being Baseline's R1, so swap the two: ScratchReg\nbecomes rbx, and R1, CallTempReg2, ABINonArgReg1, WasmJitEntryReturnScratch\nand the temporaries that the trampolines, the x64 div/mod helpers and the\nwasm catch-handler path hard-code as rbx move to r11.\n\nMeasured on JetStream 3 in the x86-64 shell from a dump of every JIT code\nblob, per instruction to factor out run-to-run differences in what gets\ncompiled: Baseline code is 0.80% smaller (1.01% in total bytes, 109.1 MB -\u003e\n108.0 MB), Ion code 0.6-1.1% smaller and WasmBaseline code 1.06% smaller.\nWasmIon code grows 0.29% (--no-threads, 85.3 MB) now that rbx is no longer\nallocatable there, and the trampolines grow 1-2% because R1 now needs REX.\n\nThe codegen tests that name the scratch register now expect rbx. With rbx no\nlonger allocatable in wasm code, Ion drops the extra move in the Linux\nselect test and uses rsi where the Windows-only select test expected rbx.\n\nFound via x86lint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338644\n", "files": ["js/src/jit-test/tests/wasm/binop-divrem-with-constant-x64-ion-codegen.js", "js/src/jit-test/tests/wasm/binop-x64-ion-codegen.js", "js/src/jit/x64/Assembler-x64.h", "js/src/jit/x64/MacroAssembler-x64.cpp", "js/src/jit/x64/SharedICRegisters-x64.h", "js/src/jit/x64/Trampoline-x64.cpp", "js/src/jit/x86-shared/Architecture-x86-shared.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared.cpp"], "git_node": "b7bf66b2cb2bd30efe948c24178fee7e748aac02", "git_parents": ["206ebeb5ebba14bf4c98790622207153c82229b9"], "node": "4a7e38adda81a886560f4ede3285f3bca95b6bd2", "parents": ["aa021af8f0f71d24c4b9e871d7650b14670205e5"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2088702 - Part 4: Add MerinoSportsUpdater to periodically refresh the matches r=android-reviewers,android-build-system-reviewers,npoon\n\n- Schedule a periodic WorkManager request that fetches and stores the latest matches\n- Retry the work when the matches fail to fetch\n- Add an in-memory MerinoMatchesStorage for tests and previews\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339584\n", "files": ["mobile/android/android-components/components/service/merino-sports/build.gradle", "mobile/android/android-components/components/service/merino-sports/src/main/java/mozilla/components/service/merino/sports/MerinoMatchesStorage.kt", "mobile/android/android-components/components/service/merino-sports/src/main/java/mozilla/components/service/merino/sports/MerinoSportsUpdater.kt", "mobile/android/android-components/components/service/merino-sports/src/main/java/mozilla/components/service/merino/sports/MerinoSportsUpdaterWorker.kt", "mobile/android/android-components/components/service/merino-sports/src/main/java/mozilla/components/service/merino/sports/MerinoSportsUseCases.kt", "mobile/android/android-components/components/service/merino-sports/src/test/java/mozilla/components/service/merino/sports/MerinoSportsUpdaterTest.kt", "mobile/android/android-components/components/service/merino-sports/src/test/java/mozilla/components/service/merino/sports/MerinoSportsUpdaterWorkerTest.kt", "mobile/android/android-components/components/service/merino-sports/src/test/java/mozilla/components/service/merino/sports/MerinoSportsUseCasesTest.kt"], "git_node": "91059c762b5c17345aeba96832eef4af7ff6c680", "git_parents": ["b7bf66b2cb2bd30efe948c24178fee7e748aac02"], "node": "a392fc30bf55e8dbf9b3122db86fd4beaf4b5cdd", "parents": ["4a7e38adda81a886560f4ede3285f3bca95b6bd2"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2090722 - Build more 64-bit constants in two instructions on arm64. r=jandem\n\nWhen movz/movn and movk need three or four instructions, try a 32-bit move of\nthe low word and a movk of the upper word's only non-zero halfword, then an orr\nof a logical immediate and a movk, as LLVM does. The first covers negative\nInt32 Values, the second i64 division magic numbers and doubles like 0.7.\nTogether they save 6,976 instructions (27 KB) in a JetStream 3 run.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340737\n", "files": ["js/src/jit-test/tests/wasm/binop-divrem-with-constant-arm64-ion-codegen.js", "js/src/jit/arm64/vixl/MacroAssembler-vixl.cpp", "js/src/jit/arm64/vixl/MacroAssembler-vixl.h", "js/src/jsapi-tests/testJitMacroAssembler.cpp"], "git_node": "8d1bd113a63c53f862f976dd522a158891a9177d", "git_parents": ["91059c762b5c17345aeba96832eef4af7ff6c680"], "node": "da9394786de83c4c5e89e8b4178728b7888a8949", "parents": ["a392fc30bf55e8dbf9b3122db86fd4beaf4b5cdd"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2091180 - Revert the pip/certifi changes from bug 2085860. r=firefox-build-system-reviewers,mach-reviewers,ahochheiden\n\nBug 2085860 ran `mach vendor python`, which undid the changes from bug\n2084865. Ensure future `mach vendor python` won't do the same by copying\nthe certifi files from the separately vendored version.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341201\n", "files": ["python/mozbuild/mozbuild/vendor/vendor_python.py", "third_party/python/pip/pip-25.2.dist-info/RECORD", "third_party/python/pip/pip/_vendor/certifi/__init__.py", "third_party/python/pip/pip/_vendor/certifi/cacert.pem", "third_party/python/pip/pip/_vendor/vendor.txt"], "git_node": "14798d2a2557762c56e3ce8b213261c4487ee225", "git_parents": ["8d1bd113a63c53f862f976dd522a158891a9177d"], "node": "a3537c8872a1afa30d53fb52fcd5e2abb5b92ecd", "parents": ["da9394786de83c4c5e89e8b4178728b7888a8949"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2087983 - Assert IPC Thread Affinity in TextureClient Actor Operations r=gfx-reviewers,lsalzman\n\nAdd MOZ_ASSERT checks to verify that selected TextureClient actor operations run on the expected IPC thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338657\n", "files": ["gfx/layers/client/TextureClient.cpp"], "git_node": "854c989159e0428e5589d01f947a8685b94190aa", "git_parents": ["14798d2a2557762c56e3ce8b213261c4487ee225"], "node": "e7e77b345cdc789eb454eded326c6d5908bd45d9", "parents": ["a3537c8872a1afa30d53fb52fcd5e2abb5b92ecd"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\naf -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\nan -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\nar -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\nast -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\naz -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\nbe -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\nbg -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\nbn -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\nbo -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\nbqi -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\nbr -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\nbrx -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\nbs -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f648\nca -\u003e f1d82d5fe0eb6ee6b71997d2c21723f6e186f