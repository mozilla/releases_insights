eb/cmaps/UniJIS2004-UTF32-H.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniJIS2004-UTF32-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniJIS2004-UTF8-H.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniJIS2004-UTF8-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniJISPro-UCS2-HW-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniJISPro-UCS2-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniJISPro-UTF8-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniJISX0213-UTF32-H.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniJISX0213-UTF32-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniJISX02132004-UTF32-H.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniJISX02132004-UTF32-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UCS2-H.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UCS2-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF16-H.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF16-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF32-H.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF32-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF8-H.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF8-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/WP-Symbol.bcmap"], "git_node": "f43afc2eee18f682d5653ab290dbf9825abb731e", "git_parents": ["c72617c016491f426f33f84b8822aad7fdd532c2", "3620b7281d7aa88ce205f924314af0b5363b9114"], "node": "9552c07881af614a4c5bc8a50fac6d04972f1911", "parents": ["ba1611bc9aa69edd4d01123391c6552fedb3565d", "d5e304ae2883b9ba34a5cc68161f29e9558ddfe9"], "tags": []}], "date": 1794692460, "git_changesets": ["e8c1781e6a462e158dce2ad970bef889c0f45c84", "43f247c5c0e4257b169e33078deab737c9176bab", "b31606db70dc42997cbb361efacd3bdc12bd08a7", "fa44e88ca6423c0db57bd6d86869592b7040848c", "7b75579564edfc9f7743362ad8a48d1fd1c47102", "e76294fcb123c657a31756e0697caab2124d5b02", "1683369cd3504362320ae7ad658655c894312b79", "95d6cd46c10d24f253b1aa947a0a7b03dc220914", "83b3936aa8e4139bfbfb725df4e849e97f16f35d", "19e526c6488d50aa45f6949a296851b18049e5d6", "904d99ffe0bde16bce466871da076183d3a9a97c", "f451c5aa5608a0dd823b739aeb5fe21a21253f0f", "cf6db0017f0f6de39847cce59c55501c098232cd", "9b4a8ff7bbf3e2d24e6fff70ef738ff97766569c", "60cb56c693a06dce725bea19c934e8a7d3af776a", "d93dc67b4313997ef9020f683e005461a7f6ea05", "2b469e093224a654de66a0f865d8a7f8c81fc48d", "2cfdc05495c9c3f3901bd3cd6a5fda2c58f82087", "9c8fdce380dfb2cf4dc7eac8350c1d1bbf29faf4", "b2be7627fa7412f96edc481fa690dcff3e5ee43f", "6f13629728c5216ac1df9508b3686fb692c94ea0", "8808bb980c489f2c77177e95038e660cefbefad9", "749a7a37529318ad45b34afe5adea2167b9ddabf", "b80d520f2cc7304c7ac5247be69c4a72f93e60af", "c9b2735c3171bf1a595fdefac69140b202d70ffc", "b4deb7a09e3a63a2ef34ad12fadb7a3e6869e6f2", "5af7232cb72de162be20d434239ed1e226b51630", "72a16f042fc23a22d00eea641efac8b679f835be", "5b9550ce8cd8ebb3384effc3838da7ebd46af57a", "d905f7af8d067a5e69b7a9c0faabb88078754aaa", "6118fd76c574eb437541fdf22276ebcdfec5dcbe", "d48f76d2c2bd7e2a521fbf0a697b61d1234132d0", "4b1811855f8351543d9f2d1bbfcec17acf7c1d3d", "8ee9b48609cb19abaa0bbe64104910f53e04c195", "2d48885ba008afcab7952813ad91778f3a615ce6", "4e027485ed6727c811459eb98c620687a60df37c", "17f6b4b0fa93816d72dd099139bdb16382d2f600", "7c9dfdfb1d179283a2bb582d9eb4d1927154f9db", "d5cbf7453d8300aaf6ebb9259734e6effbd3624f", "3620b7281d7aa88ce205f924314af0b5363b9114", "f43afc2eee18f682d5653ab290dbf9825abb731e"], "user": "asilaghi@mozilla.com"}, "45787": {"changesets": [{"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2092923 - Restrict the modeset workaround to NVIDIA's proprietary Vulkan driver. r=stransky,media-playback-reviewers\n\nNVK uses Nouveau but reports the NVIDIA GPU vendor ID. Applying the\nnvidia_drm modeset check by vendor therefore rejects NVK when the NVIDIA\nkernel module is absent. Query the driver ID alongside the DRM properties\nand apply the workaround only to VK_DRIVER_ID_NVIDIA_PROPRIETARY.\n\nRequire vkGetPhysicalDeviceProperties2 upfront and remove the legacy\nvkGetPhysicalDeviceProperties fallback. Properties2 is a core command\nsince Vulkan 1.1. Vulkan Video requires Vulkan 1.1 with\nVK_KHR_synchronization2, or Vulkan 1.3; this decoder already requires\nVulkan 1.3. The function is therefore mandatory for the supported path.\nThe legacy query cannot return the driver ID or DRM properties, so fail\ninitialization if the required entry point is unavailable.\n\nhttps://docs.vulkan.org/refpages/latest/refpages/source/vkGetPhysicalDeviceProperties2.html\nhttps://docs.vulkan.org/refpages/latest/refpages/source/VK_KHR_video_queue.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342902\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.cpp"], "git_node": "dede42eb10d74dfed32428fed5ccee7d027c1b53", "git_parents": ["3620b7281d7aa88ce205f924314af0b5363b9114"], "node": "4e0014c66153f7277ea61157698d28865e379819", "parents": ["d5e304ae2883b9ba34a5cc68161f29e9558ddfe9"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 1955816 - Rename browser.tabs.loadBookmarksIn{Tabs,Background} prefs to browser.tabs.loadUILinkIn{Tab,Background} r=mak,extension-reviewers,tabbrowser-reviewers,places-reviewers,firefox-desktop-core-reviewers ,urlbar-reviewers,kcochrane,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341697\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/browser-commands.js", "browser/components/BrowserGlue.sys.mjs", "browser/components/ProfileDataUpgrader.sys.mjs", "browser/components/places/PlacesUIUtils.sys.mjs", "browser/components/places/content/controller.js", "browser/components/places/tests/browser/browser_bookmark_context_menu_contents.js", "browser/components/places/tests/browser/browser_click_bookmarks_on_toolbar.js", "browser/components/places/tests/browser/browser_sidebar_open_bookmarks.js", "browser/components/places/tests/marionette/test_reopen_from_library.py", "browser/components/tabbrowser/test/browser/tabs/browser_new_tab_insert_position.js", "browser/components/tests/unit/test_profileDataUpgrade_loadUILinkPrefs.js", "browser/components/tests/unit/xpcshell.toml", "browser/components/urlbar/tests/browser/browser_middleClick.js", "toolkit/components/extensions/ExtensionSettingsStore.sys.mjs", "toolkit/components/extensions/parent/ext-browserSettings.js", "toolkit/components/extensions/test/xpcshell/test_ext_browserSettings.js", "toolkit/components/extensions/test/xpcshell/test_ext_extensionSettingsStore.js"], "git_node": "40de427882575ec73572b1f4b41b03c457cd7898", "git_parents": ["dede42eb10d74dfed32428fed5ccee7d027c1b53"], "node": "571ffbdafc29190edbc67ecaa6306aa356f2422a", "parents": ["4e0014c66153f7277ea61157698d28865e379819"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 1955816 - Open history entries in a new tab when browser.tabs.loadUILinkInTab is enabled r=mak,places-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341698\n", "files": ["browser/components/places/PlacesUIUtils.sys.mjs", "browser/components/places/tests/browser/browser.toml", "browser/components/places/tests/browser/browser_library_open.js", "browser/components/places/tests/browser/browser_library_open_bookmark.js", "browser/components/places/tests/browser/browser_library_telemetry.js"], "git_node": "4c9cc493a9e696a7149b5fc314d77748ac03ed4e", "git_parents": ["40de427882575ec73572b1f4b41b03c457cd7898"], "node": "0c9c677ae62558b17be63b1cd0efd8d08ab281f2", "parents": ["571ffbdafc29190edbc67ecaa6306aa356f2422a"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 1955816 - Make the History menu respect browser.tabs.loadUILinkInTab r=mak,places-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341721\n", "files": ["browser/base/content/browser-places.js", "browser/base/content/test/browser-menubar/browser.toml", "browser/base/content/test/browser-menubar/browser_places_menus_open.js"], "git_node": "10a68f95c10580e7633806a2d4209e5f32218efb", "git_parents": ["4c9cc493a9e696a7149b5fc314d77748ac03ed4e"], "node": "61f6f122c3347470b3cedd29cb6fb2920dddca85", "parents": ["0c9c677ae62558b17be63b1cd0efd8d08ab281f2"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 1885995 - Stop considering custom properties as discretely animatable. r=firefox-style-system-reviewers,emilio\n\nDoing so was preventing Servo from transitioning registered custom\nproperties (when not using `transition-behavior: allow-discrete`).\n\nNote that, even if custom properties are no longer considered discrete,\nif the values can't interpolate (like it happens by default with a\nuniversal syntax), then the interpolation will still be discrete.\n\nNo change for Gecko, since the only `is_discrete_animatable()` caller\nhad some special handling for custom properties which was equivalent\nto returning false.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342893\n", "files": ["servo/components/style/properties/mod.rs", "servo/ports/geckolib/glue.rs"], "git_node": "ad235c1bb4e0005287a09e8dd21bf7672769f4f2", "git_parents": ["10a68f95c10580e7633806a2d4209e5f32218efb"], "node": "96c2c7c56310cbaa9f6b8157453edebb05533f5f", "parents": ["61f6f122c3347470b3cedd29cb6fb2920dddca85"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 987115 - Notify when a macOS native fullscreen transition ends, and wait for it in browser_fullscreen-window-open.js, r=mac-reviewers,spohl.\n\nOn macOS, the next --repeat run of this test was left windowed: its fullscreen was reverted natively just after this run closed windows that were fullscreen or mid-transition. The fullscreen and sizemode events fire when a native transition starts, so nothing told the test when it was over.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342588\n", "files": ["browser/base/content/test/browser-general/browser_fullscreen-window-open.js", "widget/cocoa/nsCocoaWindow.mm"], "git_node": "f400907624eaa4ed5ac61f21190ceb336c3cbc9e", "git_parents": ["ad235c1bb4e0005287a09e8dd21bf7672769f4f2"], "node": "7a027ae90614bdae799fa3f8a4491d316b96fb69", "parents": ["96c2c7c56310cbaa9f6b8157453edebb05533f5f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052054 - Remove EARLY_BETA_OR_EARLIER. r=perftest-reviewers,necko-reviewers,mozperftest-reviewers,firefox-build-system-reviewers,spidermonkey-reviewers,linter-reviewers,ahal,ahochheiden,aglavic,valentin,jonco\n\nIt has been an alias for NIGHTLY_BUILD since bug 2052050 and no code reads it anymore. This also removes the\ndeprecated early-beta and late-beta --as-milestone aliases and adds a rejected-words lint to keep new uses\nfrom appearing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342336\n", "files": ["build/moz.configure/init.configure", "build/rust/mozbuild/generate_buildconfig.py", "docs/code-quality/lint/linters/test-manifest-toml.md", "docs/setup/configuring_build_options.md", "js/src/doc/feature_checklist.md", "js/src/frontend/ParseNodeVerify.h", "js/src/tests/jstests.py", "modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/Http2Session.cpp", "python/mozbuild/mozbuild/mozinfo.py", "python/mozbuild/mozbuild/test/configure/test_toolkit_moz_configure.py", "python/mozperftest/mozperftest/tests/data/mozinfo.json", "taskcluster/kinds/source-test/mozlint.yml", "testing/mozbase/manifestparser/manifestparser/token.py", "testing/perfdocs/generated/perf-sheriffing.md", "testing/performance/perf-sheriffing/perfdocs/index.md", "testing/web-platform/meta/wasm/jsapi/memory/constructor.any.js.ini", "toolkit/modules/AppConstants.sys.mjs", "toolkit/modules/moz.build", "tools/@types/subs/AppConstants.sys.d.mts", "tools/lint/rejected-words.yml"], "git_node": "b578c91cb483691778d4baa7ac8b24097a13eadd", "git_parents": ["f400907624eaa4ed5ac61f21190ceb336c3cbc9e"], "node": "10cc797b1f2770f0eb9b530d1f66255ebb42891c", "parents": ["7a027ae90614bdae799fa3f8a4491d316b96fb69"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2029836 - Incrementally update DBusMenu model. r=gtk-reviewers,emilio\n\nThis fixes the KDE global menu from disappearing when expanding nested\nmenu items.\n\nCo-authored-by: t800-x \u003ct800.x.official@gmail.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342888\n", "files": ["widget/gtk/DBusMenu.h", "widget/gtk/NativeMenuGtk.cpp"], "git_node": "ea6f244b009223afed075ca4542a1be074d346f6", "git_parents": ["b578c91cb483691778d4baa7ac8b24097a13eadd"], "node": "ef4691d63fa6a40730059d7b50ac073849d32f94", "parents": ["10cc797b1f2770f0eb9b530d1f66255ebb42891c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052054 - Remove the unused gfxConfigManager::mIsEarlyBetaOrEarlier. a=bustage\n", "files": ["gfx/config/gfxConfigManager.cpp", "gfx/config/gfxConfigManager.h", "gfx/tests/gtest/TestConfigManager.cpp"], "git_node": "76252b99155ab875adfa16e4cd5d6af61ae65146", "git_parents": ["ea6f244b009223afed075ca4542a1be074d346f6"], "node": "ad1c671a6f13aa70bc082529ce76ee0af2734723", "parents": ["ef4691d63fa6a40730059d7b50ac073849d32f94"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update HSTS HPKP r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342696\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "43ceeb18acdccb451c45f32e4a8aa35dd3bc9368", "git_parents": ["76252b99155ab875adfa16e4cd5d6af61ae65146"], "node": "1d45ba89a7fed49015d4de02a2962131da0261ff", "parents": ["ad1c671a6f13aa70bc082529ce76ee0af2734723"], "tags": []}, {"author": "Logan Rosen \u003cloganrosen@gmail.com\u003e", "branch": "default", "desc": "Bug 1452408 - Add \"Use Selection for Find\" to the Edit menu on macOS. r=firefox-desktop-core-reviewers ,fluent-reviewers,flod,mossop\n\nThe Cmd-E shortcut already worked, but without a menu item macOS does not flash the Edit menu when it is pressed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340623\n", "files": ["browser/base/content/browser-menubar.inc.xhtml", "browser/base/content/test/browser-menubar/browser.toml", "browser/base/content/test/browser-menubar/browser_edit_find_selection_macosx.js", "browser/locales/en-US/browser/menubar.ftl"], "git_node": "5a0ef4670908c3870a23ed570ce8a431e409a10c", "git_parents": ["43ceeb18acdccb451c45f32e4a8aa35dd3bc9368"], "node": "b81992c99d7dcae744e1c5d47f7cf9652bc9a43c", "parents": ["1d45ba89a7fed49015d4de02a2962131da0261ff"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2092576 - Mention git instead of hg in the HTTP test server docs. r=necko-reviewers,jesup DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342679\n", "files": ["netwerk/docs/http_server_for_testing.md"], "git_node": "80f676a4c27e028a6b9c5c15410b2c5fad69f58c", "git_parents": ["5a0ef4670908c3870a23ed570ce8a431e409a10c"], "node": "55ff8fb437cfd15c842b29a3c1db8a0179f0569c", "parents": ["b81992c99d7dcae744e1c5d47f7cf9652bc9a43c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2092576 - Replace hg.mozilla.org source links in the release docs with Searchfox. r=releng-reviewers,hneiva DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342680\n", "files": ["taskcluster/docs/partner-attribution.md", "taskcluster/docs/partner-repacks.md"], "git_node": "95ac80844902bbf35508e59bce3c9b183fbc97af", "git_parents": ["80f676a4c27e028a6b9c5c15410b2c5fad69f58c"], "node": "6f8d8bd081096adaf5ea397be593a49bef577a98", "parents": ["55ff8fb437cfd15c842b29a3c1db8a0179f0569c"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Parse url-hash-source expressions in CSP; r=tschuster,extension-reviewers,robwu\n\nWhen security.csp.url-hashes.enabled is set, parse 'url-\u003chash-algorithm\u003e-\n\u003cbase64-value\u003e' source expressions into nsCSPUrlHashSrc, a sibling of\nnsCSPHashSrc, and serialize them back with the \"url-\" prefix. With the pref\ndisabled, they're ignored as before. Matching them against script requests is\nimplemented separately.\n\nurl-hash-source is a separate grammar from hash-source, so unlike hashes, url\nhashes never match inline content, don't disable 'unsafe-inline' and aren't\nintegrity metadata. 'strict-dynamic' doesn't ignore them, and they count as a\nusable source for its \"no hash or nonce\" warning.\n\nThe validators of built-in page and add-on CSPs reject them, as they can allow\nremote scripts. test_csp_validator.js checks that add-on CSPs reject them, and\nignore them with the pref disabled.\n\nSpec PR: https://github.com/w3c/webappsec-csp/pull/784\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337047\n", "files": ["dom/security/nsCSPParser.cpp", "dom/security/nsCSPParser.h", "dom/security/nsCSPUtils.cpp", "dom/security/nsCSPUtils.h", "dom/security/nsContentSecurityUtils.cpp", "toolkit/components/extensions/test/xpcshell/test_csp_validator.js", "toolkit/components/extensions/test/xpcshell/xpcshell.toml", "toolkit/mozapps/extensions/AddonContentPolicy.cpp"], "git_node": "f5d1aa2cd2ac0ef0f0ea1aa3176e232195244474", "git_parents": ["95ac80844902bbf35508e59bce3c9b183fbc97af"], "node": "12934243fde033b1f6564ba4c3d562aa1fe59322", "parents": ["6f8d8bd081096adaf5ea397be593a49bef577a98"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-az/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-be/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-th/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-az/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-be/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-th/strings.xml", "mobile/android/android-components/components/feature/importer/src/main/res/values-be/strings.xml", "mobile/android/android-components/components/feature/importer/src/main/res/values-el/strings.xml", "mobile/android/android-components/components/feature/importer/src/main/res/values-th/strings.xml", "mobile/android/android-components/components/feature/ipprotection/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-th/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-az/strings.xml", "mobile/android/fenix/app/src/main/res/values-be/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rGB/strings.xml", "mobile/android/fenix/app/src/main/res/values-es/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/res/values-iw/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nb-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sq/strings.xml", "mobile/android/fenix/app/src/main/res/values-th/strings.xml"], "git_node": "aa2e511c12a8053598a81e85ce7581aa37951bd5", "git_parents": ["f5d1aa2cd2ac0ef0f0ea1aa3176e232195244474"], "node": "95efa4d3a3a254b8516fa44724bfda40cfb36b66", "parents": ["12934243fde033b1f6564ba4c3d562aa1fe59322"], "tags": []}, {"author": "Taimur Hasan \u003cthasan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090291 - Let the link preview engine shut down when idle r=yjamora,valentinp\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340524\n", "files": ["browser/components/genai/LinkPreviewModel.sys.mjs"], "git_node": "fd7b37ad221fe70a5d3a79f0c196f61cd6d103c5", "git_parents": ["aa2e511c12a8053598a81e85ce7581aa37951bd5"], "node": "babfa0b402d541ac3a2511bf58d0a7017602f100", "parents": ["95efa4d3a3a254b8516fa44724bfda40cfb36b66"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "6a0320da1c0d22fa08ac3b494aadddb071b8d299", "git_parents": ["fd7b37ad221fe70a5d3a79f0c196f61cd6d103c5", "f43afc2eee18f682d5653ab290dbf9825abb731e"], "node": "29cfaacdf14dae1f1d13ce14585b760a5d84f59c", "parents": ["babfa0b402d541ac3a2511bf58d0a7017602f100", "9552c07881af614a4c5bc8a50fac6d04972f1911"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2091438 [wpt PR 64461] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=329537, a=testonly\n\nAutomatic update from web-platform-tests\nAsync clipboard should UTF-8 decode text blobs it writes\n\nThe Clipboard API's write blobs and option to the clipboard algorithm UTF-8 decodes each blob it\nwrites. For text/plain, text/html, and text/uri-list blobs, ClipboardItemBindingsDataSource read\nthem the way FileReader's readAsText() does instead, which switches to UTF-16 when the data starts\nwith a UTF-16 byte order mark. Read them with FileReaderLoader::ReadAsUTF8Text, as Blob's text()\ndoes since 324356@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329537\n\n--\n\nwpt-commits: a0dd301b85aa1457a1df36c21df5f3fb73ed95cf\nwpt-pr: 64461\n", "files": ["testing/web-platform/tests/clipboard-apis/text-write-read/async-write-read.https.html"], "git_node": "a7320b0585ed07c7a7c5fa0ac1f2c24fdd9b64ef", "git_parents": ["6a0320da1c0d22fa08ac3b494aadddb071b8d299"], "node": "3415fd573bb868d2b10a8f5cdfba4549fb447b71", "parents": ["29cfaacdf14dae1f1d13ce14585b760a5d84f59c"], "tags": []}, {"author": "Mike Wyrzykowski \u003cmwyrzykowski@apple.com\u003e", "branch": "default", "desc": "Bug 2091468 [wpt PR 64506] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327533, a=testonly\n\nAutomatic update from web-platform-tests\n[WebXR][WebGPU] Projection layer created without depthStencilFormat returns an uncleared depthStencilTexture that the compositor reads\n\nA WebXR projection layer created without a depth format now reports\nignoreDepthValues as true and hands out a null depthStencilTexture\ninstead of the compositor's depth stencil texture.\n\nWithholding that texture is not enough on its own. The depth textures\nbelong to the compositor's swapchain and are recycled across frames, so\na layer with no depthStencilFormat is handed a texture still holding\nwhatever depth a previous frame wrote. Nothing in the page can clear it\nnow that it is not exposed, and the compositor consumes depth\nunconditionally (.requestDepth is always true in\nPlatformXRCompositor.mm), so those stale values would be reprojected as\nif they were this layer's geometry. XRProjectionLayer::clearDepthTexture()\ntherefore clears each slice of the recycled swapchain depth texture at\nthe start of every frame for such a layer.\n\nThe clear value is FLT_MIN, not 0.0. The compositor renders reverse-Z,\nso the far plane is 0, but CompositorServices skips pixels at depth 0.0\nand composites them as transparent, which would punch a hole through the\nlayer. FLT_MIN is the nearest usable far value and matches what\nCompositorCoordinator::setUpDepthTextures() clears these same textures\nto at session start.\n\nThe clear is gated on the layer having no depthStencilFormat. When the\nlayer has one, XRSubImage::update gives the page a view onto this same\ntexture, so the page owns its contents and clearing it would be both\nwrong and a per-frame cost of a forced finalizeBlitCommandEncoder(), an\nextra command buffer, and one render pass per slice.\n\nTelling the compositor that such a layer has no depth at all would avoid\nthe per-frame clear entirely, but that is a follow-up.\n\nThis includes the header fix from https://commits.webkit.org/325401@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327533\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329730\nWebKit-Canonical-Link: https://commits.webkit.org/324747@main\n\n--\n\nwpt-commits: 974e057e11bcbd2e94040b901cc5385ae6fc2d62\nwpt-pr: 64506\n", "files": ["testing/web-platform/tests/webxr/layers/xrGPUProjectionLayer_ignoreDepthValues.https.html", "testing/web-platform/tests/webxr/layers/xrProjectionLayer_ignoreDepthValues.https.html"], "git_node": "1241a8c8ad5e62105572f8fee9b74772f9051ca5", "git_parents": ["a7320b0585ed07c7a7c5fa0ac1f2c24fdd9b64ef"], "node": "34bfb6e027761012d0e726558346ed07542b3bee", "parents": ["3415fd573bb868d2b10a8f5cdfba4549fb447b71"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091468 [wpt PR 64506] - Update wpt metadata, a=testonly\n\nwpt-pr: 64506\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webxr/layers/xrGPUProjectionLayer_ignoreDepthValues.https.html.ini", "testing/web-platform/meta/webxr/layers/xrProjectionLayer_ignoreDepthValues.https.html.ini"], "git_node": "1f6076eb2e84cf42963ecff40895ef7b846ea031", "git_parents": ["1241a8c8ad5e62105572f8fee9b74772f9051ca5"], "node": "a5111d59f37b6f5c1f1db64443261ebda9d3be51", "parents": ["34bfb6e027761012d0e726558346ed07542b3bee"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091480 [wpt PR 64504] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=319173, a=testonly\n\nAutomatic update from web-platform-tests\n[CSS] Support the white-space-trim: discard-inner value\n\nImplement the 'discard-inner' value of the CSS Text 4 'white-space-trim' property\n(https://drafts.csswg.org/css-text-4/#white-space-trim) in the modern inline layout\npath, behind the existing CSSWhiteSpaceTrimEnabled setting. This builds on the\n'discard-before' / 'discard-after' support.\n\n'discard-inner' removes the collapsible white space at the start and end of the\nelement's own content -- i.e. immediately inside its edges. It maps onto the same\nsingle forward pass over the inline items that already implements discard-before /\ndiscard-after: a discard-inner inline box start arms the \"discard the following\ncollapsible white space\" state (like discard-after does at an end edge), and a\ndiscard-inner inline box end discards the collapsible white space accumulated since\nthe last piece of real content (like discard-before does at a start edge). Inline\nbox boundaries remain transparent, so the trimming reaches across nested empty\nboxes. As with the other values, only collapsible white space is affected:\npreserved white space and non-collapsible characters (e.g. the ideographic space\nU+3000) are left untouched.\n\nThis covers discard-inner on inline boxes. The block-level facet of the spec --\ntrimming the collapsible white space at the start and end of each line of a block\ncontainer -- is a line-layout-time concern and is left as a follow-up.\n\nThis includes the header fix from https://commits.webkit.org/325401@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=319173\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329730\nWebKit-Canonical-Link: https://commits.webkit.org/317210@main\n\n--\n\nwpt-commits: 797e78ce439124156cc07deacaeca55e0fd84441\nwpt-pr: 64504\n", "files": ["testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-discard-inner-ref.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-discard-inner.html"], "git_node": "7e605bfdb928e228e5e132f298f973b7947fa4a3", "git_parents": ["1f6076eb2e84cf42963ecff40895ef7b846ea031"], "node": "9e64dd4f6541729569bb3f77980b288ff1eb4a4d", "parents": ["a5111d59f37b6f5c1f1db64443261ebda9d3be51"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091480 [wpt PR 64504] - Update wpt metadata, a=testonly\n\nwpt-pr: 64504\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-text/white-space/white-space-trim-discard-inner.html.ini"], "git_node": "592018643fa3c413c4fcca603f2a243c8b526572", "git_parents": ["7e605bfdb928e228e5e132f298f973b7947fa4a3"], "node": "7db8c4484da6c83e20f758ee2d6935a408257ae6", "parents": ["9e64dd4f6541729569bb3f77980b288ff1eb4a4d"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091508 [wpt PR 64503] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322718, a=testonly\n\nAutomatic update from web-platform-tests\n[css-text-decor] Negative text-decoration-inset is clipped when the decoration propagates to a descendant inline box\n\ncollectInkOverflowForTextDecorations() measured each text box's decoration overflow\nfrom displayBox.layoutBox().parent().style(). The decoration properties are not\ninherited, so when a decoration propagates from an ancestor to a descendant inline box\nthat immediate parent carries the initial values, and the overflow came out too small.\nThe decoration was still painted in the right place - TextBoxPainter walks up to the\noriginating box - so it got clipped to the undersized overflow instead.\n\nThis includes the lint fix from https://commits.webkit.org/325400@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322718\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329720\nWebKit-Canonical-Link: https://commits.webkit.org/320044@main\n\n--\n\nwpt-commits: 8e850fe621b0d44cc8c5d8391b038e31688b3993\nwpt-pr: 64503\n", "files": ["testing/web-platform/tests/css/css-text-decor/reference/text-decoration-propagated-ink-overflow-ref.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-propagated-ink-overflow.html"], "git_node": "92fdeff87213ae1da798ffa91000e963f8067e62", "git_parents": ["592018643fa3c413c4fcca603f2a243c8b526572"], "node": "810272bcfd2168aa4176aa5d6ff612dd215e8872", "parents": ["7db8c4484da6c83e20f758ee2d6935a408257ae6"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091517 [wpt PR 64505] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=319169, a=testonly\n\nAutomatic update from web-platform-tests\n[CSS] Support the white-space-trim property (discard-before / discard-after)\n\nImplement the 'discard-before' and 'discard-after' values of the CSS Text 4\n'white-space-trim' property (https://drafts.csswg.org/css-text-4/#white-space-trim)\nin the modern inline layout path, behind the CSSWhiteSpaceTrimEnabled setting\n(off by default).\n\n'discard-before' / 'discard-after' remove the collapsible white space\nimmediately before the start / after the end of an element. We do this at\ninline-item building time: InlineItemsBuilder::adjustInlineItemsForWhiteSpaceTrim\ndiscards the corresponding InlineTextItems in a single forward pass before line\nbuilding, bidi resolution and intrinsic sizing run, so the removed white space\nis kept out of every downstream computation (rendering, soft-wrap opportunities\nand min/max-content) at once. The property applies to inline boxes and block\ncontainers, so an inline box or a non-replaced inline-block carries it. Inline\nbox boundaries -- and floats / out-of-flow boxes -- are transparent to this\nadjacency, matching white space collapsing, while other atomic inlines, replaced\ncontent, iframes and block-in-inline boxes are real content that ends it.\n\nBecause the property changes which inline items are generated, a value change\ninvalidates the cached inline item list (InlineInvalidation) and requires layout\n(StyleDifference). Since the discard depends on cross-box adjacency that a\npartial rebuild starting mid-content cannot resolve, the inline formatting\ncontext re-collects all inline items whenever the content carries\nwhite-space-trim rather than doing an incremental rebuild.\n\n'discard-inner' parses and computes to a value but has no layout effect yet.\n\nThis includes the header fix from https://commits.webkit.org/325401@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=319169\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329730\nWebKit-Canonical-Link: https://commits.webkit.org/317172@main\n\n--\n\nwpt-commits: daa4194a210b3491e83be91b35031a465569c26a\nwpt-pr: 64505\n", "files": ["testing/web-platform/tests/css/css-text/parsing/white-space-trim-computed.html", "testing/web-platform/tests/css/css-text/parsing/white-space-trim-invalid.html", "testing/web-platform/tests/css/css-text/parsing/white-space-trim-valid.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-atomic-inline-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-block-in-inline-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-break-spaces-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-content-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-discard-after-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-discard-before-after-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-discard-before-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-dynamic-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-generated-content-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-inline-block-dynamic-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-inline-block-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-interaction-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-nested-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-rtl-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-white-space-ref.html", "testing/web-platform/tests/css/css-text/white-space/reference/white-space-trim-wrap-ref.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-atomic-inline.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-block-in-inline.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-break-spaces.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-content.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-discard-after.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-discard-before-after.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-discard-before.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-dynamic.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-generated-content.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-inline-block-dynamic.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-inline-block.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-interaction.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-intrinsic-width.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-nested.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-rtl.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-white-space.html", "testing/web-platform/tests/css/css-text/white-space/white-space-trim-wrap.html"], "git_node": "987154cf64edd8bed6faa6686e58baa3e4bbdd46", "git_parents": ["92fdeff87213ae1da798ffa91000e963f8067e62"], "node": "a3c952bbab46cec22e0fac1eee08d04b685a3b6e", "parents": ["810272bcfd2168aa4176aa5d6ff612dd215e8872"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091517 [wpt PR 64505] - Update wpt metadata, a=testonly\n\nwpt-pr: 64505\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-text/parsing/white-space-trim-computed.html.ini", "testing/web-platform/meta/css/css-text/parsing/white-space-trim-valid.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-atomic-inline.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-block-in-inline.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-content.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-discard-after.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-discard-before-after.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-discard-before.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-dynamic.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-generated-content.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-inline-block-dynamic.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-inline-block.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-interaction.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-intrinsic-width.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-nested.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-rtl.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-white-space.html.ini", "testing/web-platform/meta/css/css-text/white-space/white-space-trim-wrap.html.ini"], "git_node": "fb92314150a1dddbcc768466d3d7b30193ce5966", "git_parents": ["987154cf64edd8bed6faa6686e58baa3e4bbdd46"], "node": "9dca0a22ca60d70c08c56ef234a6d402f5cca183", "parents": ["a3c952bbab46cec22e0fac1eee08d04b685a3b6e"], "tags": []}, {"author": "lilly \u003c173393835+cupidsity@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2073835 [wpt PR 62819] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324646, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=324646\n\n--\n\nwpt-commits: 27258df5dcbed92adbc2663933c3b4299d914190\nwpt-pr: 62819\n", "files": ["testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-clip-path-border-box-ref.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-clip-path-border-box.html"], "git_node": "328abe57ade1c1d6b5258cf4af8eb3aad4c65e82", "git_parents": ["fb92314150a1dddbcc768466d3d7b30193ce5966"], "node": "f5ba59a07a7de2b7c7b2e8fd11e6e89f87c79799", "parents": ["9dca0a22ca60d70c08c56ef234a6d402f5cca183"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073835 [wpt PR 62819] - Update wpt metadata, a=testonly\n\nwpt-pr: 62819\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-clip-path-border-box.html.ini"], "git_node": "ef9f4cb57105d740fab5e4c04a64d48523473395", "git_parents": ["328abe57ade1c1d6b5258cf4af8eb3aad4c65e82"], "node": "4a75fd386196372ac48d3b4c202cb65c3df2bef5", "parents": ["f5ba59a07a7de2b7c7b2e8fd11e6e89f87c79799"], "tags": []}, {"author": "Sammy Gill \u003csgill26@apple.com\u003e", "branch": "default", "desc": "Bug 2077013 [wpt PR 63141] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325819, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=325819\n\n--\n\nwpt-commits: 88f457e0202bd5c71ecbac746e4d5274d636dedb\nwpt-pr: 63141\n", "files": ["testing/web-platform/tests/css/css-grid/grid-model/grid-item-first-line-001.html", "testing/web-platform/tests/css/css-grid/grid-model/grid-item-first-line-002.html"], "git_node": "4d81c5efe30f94272e2f65c071896fd1c9b3dee3", "git_parents": ["ef9f4cb57105d740fab5e4c04a64d48523473395"], "node": "69dc460ba2cc661e4f96c19964254c737b069297", "parents": ["4a75fd386196372ac48d3b4c202cb65c3df2bef5"], "tags": []}, {"author": "Sammy Gill \u003csgill26@apple.com\u003e", "branch": "default", "desc": "Bug 2077014 [wpt PR 63142] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322861, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=322861\n\n--\n\nwpt-commits: 49aeaec9c022517293242e5d486df4be924f7924\nwpt-pr: 63142\n", "files": ["testing/web-platform/tests/css/css-grid/layout-algorithm/flex-sizing-rows-min-max-height-002.html"], "git_node": "33c54a259fc085a54c537a839a939a1076ffd4f2", "git_parents": ["4d81c5efe30f94272e2f65c071896fd1c9b3dee3"], "node": "0babc42a251ed181e7cddd129221813c4fe2818f", "parents": ["69dc460ba2cc661e4f96c19964254c737b069297"], "tags": []}, {"author": "Nikolas Zimmermann \u003cnzimmermann@igalia.com\u003e", "branch": "default", "desc": "Bug 2082401 [wpt PR 63704] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325531, a=testonly\n\nAutomatic update from web-platform-tests\nRaise fuzzy tolerance of foreign-object-scale-scroll.html\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325531\n\n--\n\nwpt-commits: 5da890f0f4b277696d78f6a5023d6fcbdcb40d59\nwpt-pr: 63704\n", "files": ["testing/web-platform/tests/svg/extensibility/foreignObject/foreign-object-scale-scroll.html"], "git_node": "e4207301651a0c6312d773f9efe69a67379a9c50", "git_parents": ["33c54a259fc085a54c537a839a939a1076ffd4f2"], "node": "9e40f67de9bdebe64c0fb8f1f0165c8982a2768e", "parents": ["0babc42a251ed181e7cddd129221813c4fe2818f"], "tags": []}, {"author": "Kiet Ho \u003ckiet.ho@apple.com\u003e", "branch": "default", "desc": "Bug 2087424 [wpt PR 64303] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322522, a=testonly\n\nAutomatic update from web-platform-tests\nJavaScript `import ... with { type: \"json\" }` can inadvertently load the JSON as JavaScript\n\nIf a JSON is imported in JavaScript using the `import` syntax:\n\n    import module from \"url/to/malicious-javascript.js\" with { type: \"json\" };\n\nand assuming `url/to/malicious-javascript.js` is served with MIME type\napplication/javascript, ScriptModuleLoader::notifyFinished will treat the\nloaded source code as JavaScript and not JSON:\n\n(1)    if (MIMETypeRegistry::isSupportedJavaScriptMIMEType(mimeType))\n(2)        type = ModuleType::JavaScript;\n(3)    else if (loader.parameters() && loader.parameters()-\u003etype() == JSC::ScriptFetchParameters::JSON && MIMETypeRegistry::isSupportedJSONMIMEType(mimeType))\n           type = ModuleType::JSON;\n       else {\n           rejectWithFetchError(...);\n           return;\n       }\n\n(1) succeeds because the MIME type is JavaScript, so (2) executes, and the file\nis treated as JavaScript, even though it's loaded with `{ type: \"json\" }`. (3)\nchecks for JSON MIME type, but it's not reached because check (1) succeeds. The\nresult is that the loaded file gets executed as JavaScript instead of JSON.\n\nSecurity ramification: If JavaScript from a site A imports a JSON from another\nsite B, it can change the JSON file to be a JavaScript file, and make its MIME\ntype `application/javascript`. Then, when site A imports the JSON, JavaScript\nfrom site B gets run instead.\n\nFix this by changing the check to a switch-case on the module type, which brings\ntwo benefits:\n1) If a new JSC::ScriptFetchParameters::Type is introduced in the future, the\n   compiler will warn us to add a new check for it.\n2) Ensures that non-JavaScript types don't use the default path of treating it\n   as JavaScript.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322522\n\n--\n\nwpt-commits: 77809c0b5695394edb328504c4d1369af8dd6db2\nwpt-pr: 64303\n", "files": ["testing/web-platform/tests/html/semantics/scripting-1/the-script-element/json-module/invalid-content-type.any.js", "testing/web-platform/tests/html/semantics/scripting-1/the-script-element/json-module/should-not-be-loaded.js"], "git_node": "1848ccc3e5fc11f6fea6c0472458ad8e8fb1b99c", "git_parents": ["e4207301651a0c6312d773f9efe69a67379a9c50"], "node": "adfad76b843b96d5d7c08fec77c3346eaa9f9b40", "parents": ["9e40f67de9bdebe64c0fb8f1f0165c8982a2768e"], "tags": []}, {"author": "Sammy Gill \u003csgill26@apple.com\u003e", "branch": "default", "desc": "Bug 2075462 [wpt PR 62948] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321093, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=321093\n\n--\n\nwpt-commits: 9cfb978a556c73cc6801d028ae91c100a13fa906\nwpt-pr: 62948\n", "files": ["testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-column-block-end.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-column-block-start.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-column-inline-end.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-column-inline-start.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-column-multi-line-block-end.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-column-multi-line-block-start.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-column-multi-line-block.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-column-multi-line-inline-end.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-column-multi-line-inline-start.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-column-style-change-triggers-layout-block-start.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-row-block-end.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-row-block-start.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-row-block.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-row-inline-end.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-row-inline-start.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-row-multi-line-block-end.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-row-multi-line-block-start.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-row-multi-line-block.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-row-multi-line-inline-end.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/flexbox-row-multi-line-inline-start.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-block-end-trimmed-only-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-block-end-trimmed-only.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-block-start-trimmed-only-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-block-start-trimmed-only.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-block-trimmed-only-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-block-trimmed-only.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-column-block-multiline.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-column-grow.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-column-inline-multiline-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-column-inline-multiline.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-column-orthogonal-item.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-column-shrink.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-column-style-change-triggers-layout-block-end-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-column-style-change-triggers-layout-block-end.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-column-style-change-triggers-layout-block-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-column-style-change-triggers-layout-block-start-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-column-style-change-triggers-layout-block-start.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-column-style-change-triggers-layout-block.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-inline-end-trimmed-only-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-inline-end-trimmed-only.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-inline-start-trimmed-only-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-inline-start-trimmed-only.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-inline-trimmed-only-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-inline-trimmed-only.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-row-block-multiline-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-row-block-multiline.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-row-grow.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-row-inline-multiline.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-row-orthogonal-item.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-row-shrink.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-row-style-change-triggers-layout-inline-end-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-row-style-change-triggers-layout-inline-end.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-row-style-change-triggers-layout-inline-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-row-style-change-triggers-layout-inline-start-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-row-style-change-triggers-layout-inline-start.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-row-style-change-triggers-layout-inline.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-trim-all-margins-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/flex-trim-all-margins.html"], "git_node": "dbf0614ee4f91c32650a7824accf814b459781ea", "git_parents": ["1848ccc3e5fc11f6fea6c0472458ad8e8fb1b99c"], "node": "1f1765006faa75b5546415acad15563346a452d2", "parents": ["adfad76b843b96d5d7c08fec77c3346eaa9f9b40"], "tags": []}, {"author": "Sammy Gill \u003csgill26@apple.com\u003e", "branch": "default", "desc": "Bug 2075463 [wpt PR 62949] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321130, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=321130\n\n--\n\nwpt-commits: aeb9d4bf5eb7e9e72883a81e3a164192be0c8f5c\nwpt-pr: 62949\n", "files": ["testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/grid-block-end-column-auto-flow.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/grid-block-end-item-spans-multiple-rows.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/grid-block-end.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/grid-block-start.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/grid-inline-end-columns-added-to-end.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/grid-inline-end-items-in-last-column-trimmed.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/grid-inline-start-item-negative-span.html", "testing/web-platform/tests/css/css-box/margin-trim/computed-margin-values/grid-inline-start.html", "testing/web-platform/tests/css/css-box/margin-trim/grid-block-end-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/grid-block-end.html", "testing/web-platform/tests/css/css-box/margin-trim/grid-block-start-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/grid-block-start.html", "testing/web-platform/tests/css/css-box/margin-trim/grid-block.html", "testing/web-platform/tests/css/css-box/margin-trim/grid-inline-end-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/grid-inline-end.html", "testing/web-platform/tests/css/css-box/margin-trim/grid-inline-start-ref.html", "testing/web-platform/tests/css/css-box/margin-trim/grid-inline-start.html", "testing/web-platform/tests/css/css-box/margin-trim/grid-inline.html", "testing/web-platform/tests/css/css-box/margin-trim/grid-trim-ignores-collapsed-tracks.html"], "git_node": "8debccfcbef1d76fdf2e453109a06c1ea9bd12b4", "git_parents": ["dbf0614ee4f91c32650a7824accf814b459781ea"], "node": "f6ccdae6c2cfd10c47873bb018ad3162d871fe2b", "parents": ["1f1765006faa75b5546415acad15563346a452d2"], "tags": []}, {"author": "Nikolas Zimmermann \u003cnzimmermann@igalia.com\u003e", "branch": "default", "desc": "Bug 2082800 [wpt PR 63739] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324109, a=testonly\n\nAutomatic update from web-platform-tests\nExtend composited bounds by the filter outsets of a layer and its ancestors\n\nThe clips above a composited layer may shrink the backing store that\nupdateCompositedBounds() assigns to the layer. A pixel-moving filter such\nas blur or drop-shadow above the layer samples pixels outside the\nbackground clip rect that we usually use to clip the layer, by up to its\noutsets. These outsets are currently not taken into account when\ncomputing the clipping region, so the backing store does not hold the\npixels in the outset region around the layer, and the filter cannot\nsample them corectly. Fix that by expanding the clips above the layer,\nincluding the document clip, by the relevant filter outsets.\n\nEach clip is expanded only by the outsets of the filters that apply before\nit, on the layer itself or on ancestors between the layer and the\nclipping ancestor. Filters on the clipping ancestor or further up sample\nalready clipped content and leave the clip unchanged. Reference filters\nand filters, that a composited layer cannot composite, are painted in\nsoftware, so their outsets are ignored.\n\nA change of the filter outsets affects the composited bounds of all\ndescendants, not just the nearest composited ones, so such a change now\ntriggers a backing update of all descendents. When a composited filter\nchanges to a reference filter, the filter on the GraphicsLayer is now\ncleared as well, which was previously broken.\n\nRenderLayerBacking passes the sampling outsets on on to the GraphicsLayer.\nOn Cocoa platforms, GraphicsLayerCA::computeVisibleAndCoverageRect()\nexpands the visible and coverage rects by these outsets, so descendent\nlayers retrieve backing store in the outset region too.\n\nThis progresses two WPT tests in css/filter-effects:\nfixed-pos-filter-clip-002.html and will-change-blur-filter-under-clip.html.\n\nI added new tests for edge cases that WPT does not cover. Five of them are\nplain reftests that describe interoperable behaviour rather than anything\nWebKit specific, so they go to css/filter-effects as WPT tests.\nThe remaining ones inspect the composited bounds through internals.layerTreeAsText(),\nso they are placed in compositing/filters.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324109\nWebKit-Canonical-Link: https://commits.webkit.org/323864@main\n\n--\n\nwpt-commits: 447208410d94ab8a924144b1c003d2db1dc922f6\nwpt-pr: 63739\n", "files": ["testing/web-platform/tests/css/filter-effects/drop-shadow-outsets-sample-composited-child-preserve-3d-ref.html", "testing/web-platform/tests/css/filter-effects/drop-shadow-outsets-sample-composited-child-preserve-3d.html", "testing/web-platform/tests/css/filter-effects/drop-shadow-outsets-sample-composited-child-ref.html", "testing/web-platform/tests/css/filter-effects/drop-shadow-outsets-sample-composited-child.html", "testing/web-platform/tests/css/filter-effects/filter-change-to-reference-filter-ref.html", "testing/web-platform/tests/css/filter-effects/filter-change-to-reference-filter.html", "testing/web-platform/tests/css/filter-effects/filter-outsets-clipped-by-document-edge-ref.html", "testing/web-platform/tests/css/filter-effects/filter-outsets-clipped-by-document-edge.html", "testing/web-platform/tests/css/filter-effects/filter-outsets-do-not-escape-ancestor-clip-ref.html", "testing/web-platform/tests/css/filter-effects/filter-outsets-do-not-escape-ancestor-clip.html", "testing/web-platform/tests/css/filter-effects/fixed-pos-filter-clip-002.html"], "git_node": "76c80d7ac5ad4122899109bf52cb6eff851bfd89", "git_parents": ["8debccfcbef1d76fdf2e453109a06c1ea9bd12b4"], "node": "84ed147743326577526186cd6a7c264c6d7e39a6", "parents": ["f6ccdae6c2cfd10c47873bb018ad3162d871fe2b"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2087353 [wpt PR 64302] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=290727, a=testonly\n\nAutomatic update from web-platform-tests\ncontent shifted downward with text-box-trim and vertical-align:bottom\n\nInline level box coords are relative to the top/left corner of the line box but\nbottom aligned boxes are in practice anchored to the bottom.\n\nLet's adjust such, bottom aligned content when line box moves up while getting trimmed.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=290727\nWebKit-Canonical-Link: https://commits.webkit.org/293283@main\n\n--\nFix stylesheet link syntax in HTML file\n--\nInclude Ahem font stylesheet in HTML\n\nAdded a link to the Ahem font stylesheet.\n--\n\nwpt-commits: a7fb282c2d9c3e0abef0813f93ecb643d65519d4, fdfa3cb55ba038f034f0823e492b3d7a648a4cc8, 69f509c1c04a5a5a8f1c6bd38428cdfc4b7aa164\nwpt-pr: 64302\n", "files": ["testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-both-with-bottom-aligned-box-ref.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-both-with-bottom-aligned-box.html"], "git_node": "6bd6e8faa9bbd79882035b7c8c41a8c2adf4c8df", "git_parents": ["76c80d7ac5ad4122899109bf52cb6eff851bfd89"], "node": "e90691cc2a775945e4294848157713c27842cae0", "parents": ["84ed147743326577526186cd6a7c264c6d7e39a6"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087353 [wpt PR 64302] - Update wpt metadata, a=testonly\n\nwpt-pr: 64302\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-inline/text-box-trim/text-box-trim-both-with-bottom-aligned-box.html.ini"], "git_node": "5998a2a0d9e4c4ad82d5c1f254802bb215379c88", "git_parents": ["6bd6e8faa9bbd79882035b7c8c41a8c2adf4c8df"], "node": "a0d164fffba0e659d0e5c36cbbe347f1870ade96", "parents": ["e90691cc2a775945e4294848157713c27842cae0"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2080499 [wpt PR 63487] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326654, a=testonly\n\nAutomatic update from web-platform-tests\nScript elements with an ASCII-whitespace-only src are treated as having an empty src\n\nThis patch aligns WebKit with Gecko / Firefox.\n\n\"Prepare the script element\" [1] only special-cases the exact empty string:\n\n    \"If src is the empty string, then queue an element task on the DOM\n    manipulation task source given el to fire an event named error at el,\n    and return.\"\n\nAny other value, including one made up only of ASCII whitespace, is\nencoding-parsed as a URL. The URL parser strips leading and trailing C0\ncontrol or space and removes tabs and newlines, so a whitespace-only src\nresolves to the document's base URL and is fetched.\n\nrequestClassicScript() and requestModuleScript() treated a whitespace-only\nsrc as empty and fired an error event instead. Check isEmpty() in both to\nmatch the spec.\n\n[1] https://html.spec.whatwg.org/multipage/scripting.html#prepare-the-script-element\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326654\nWebKit-Canonical-Link: https://commits.webkit.org/323236@main\n\n--\n\nwpt-commits: d0627f4a50d0f5bbcf4c8db9fff62589e880f2cd\nwpt-pr: 63487\n", "files": ["testing/web-platform/tests/html/semantics/scripting-1/the-script-element/fetch-src/whitespace-with-base-module.html", "testing/web-platform/tests/html/semantics/scripting-1/the-script-element/fetch-src/whitespace-with-base.html", "testing/web-platform/tests/html/semantics/scripting-1/the-script-element/fetch-src/whitespace.js"], "git_node": "06a90d96225f0a69be726c1ba01958cd658941b4", "git_parents": ["5998a2a0d9e4c4ad82d5c1f254802bb215379c88"], "node": "2dcc6208d3bb3ad38749e9344aa666ed07cf5205", "parents": ["a0d164fffba0e659d0e5c36cbbe347f1870ade96"], "tags": []}, {"author": "Karl Dubost \u003ck_dubost@apple.com\u003e", "branch": "default", "desc": "Bug 2071259 [wpt PR 62615] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323707, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=323707\n\n--\n\nwpt-commits: 5fb98fd9ef09887be591595813e9a74c64e242cb\nwpt-pr: 62615\n", "files": ["testing/web-platform/tests/svg/types/scripted/SVGGraphicsElement.getBBox-06.html", "testing/web-platform/tests/svg/types/scripted/SVGGraphicsElement.getBBox-07.html"], "git_node": "d4b6867b4fd28507f29b28440307f1edd0eac06d", "git_parents": ["06a90d96225f0a69be726c1ba01958cd658941b4"], "node": "9450e343fb6e3fa422d8efc0877355ed8154e316", "parents": ["2dcc6208d3bb3ad38749e9344aa666ed07cf5205"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071259 [wpt PR 62615] - Update wpt metadata, a=testonly\n\nwpt-pr: 62615\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/types/scripted/SVGGraphicsElement.getBBox-06.html.ini", "testing/web-platform/meta/svg/types/scripted/SVGGraphicsElement.getBBox-07.html.ini"], "git_node": "ce7a89b3befdadcf90dab7b029ba956ab132f05c", "git_parents": ["d4b6867b4fd28507f29b28440307f1edd0eac06d"], "node": "fc64645fec3305ff6b50e822b3e797bed883249d", "parents": ["9450e343fb6e3fa422d8efc0877355ed8154e316"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2091605 [wpt PR 64415] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327770, a=testonly\n\nAutomatic update from web-platform-tests\nMouseEvent constructor and initMouseEvent() remap button -2 to 0\n\nMouseButton::None is -2 and is used internally as a \"no button\" sentinel.\nThe MouseEventInit constructor and initMouseEvent() applied the same\nremapping to script-provided values, so new MouseEvent(\"x\", { button: -2 })\nand initMouseEvent(..., -2, ...) reported button == 0 instead of -2.\nbutton is an unconstrained short in the IDL, and -2 was the only value in\nits range that was altered. Firefox and Blink both preserve it.\n\nScript-created events cannot carry the sentinel, so store the value as\ngiven and always treat the button as down. The constructors used for\ntrusted events keep the sentinel handling, and the initializer constructor\nnow asserts that a trusted event never carries MouseButton::None.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327770\nWebKit-Canonical-Link: https://commits.webkit.org/325341@main\n\n--\n\nwpt-commits: 6af1bb108a9d76a26317f01ddd6b18ff590406eb\nwpt-pr: 64415\n", "files": ["testing/web-platform/tests/uievents/mouse/mouseevent-constructor-button-range.html"], "git_node": "5b508f006dd1bfb34a0807598358091026f36870", "git_parents": ["ce7a89b3befdadcf90dab7b029ba956ab132f05c"], "node": "3209cb39ab01819d52d6171e467f7428005223a8", "parents": ["fc64645fec3305ff6b50e822b3e797bed883249d"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2091607 [wpt PR 64509] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=309977, a=testonly\n\nAutomatic update from web-platform-tests\nTest cell backgrounds at the edges of a collapsed-border table\n\nThese tests come from two WebKit changes:\n- Cell background in collapsed-border table extends into adjacent cells' border space at table edges (https://commits.webkit.org/308969@main). It was exported as #58462, which #59246 reverted because the test failed in every browser.\n- [css-tables] Fix collapsed-border-background-inset WPT mismatch test to use transparent borders (https://commits.webkit.org/309431@main), which fixes the test.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=309488\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=309977\n\n--\n\nwpt-commits: 41ce24f042d9f8ee1a8ebb3d869d13dd941ea6fa\nwpt-pr: 64509\n", "files": ["testing/web-platform/tests/css/css-tables/collapsed-border-background-inset-notref.html", "testing/web-platform/tests/css/css-tables/collapsed-border-background-inset.html"], "git_node": "d9f83843d06be0cccc74b8f91f74fe448610788d", "git_parents": ["5b508f006dd1bfb34a0807598358091026f36870"], "node": "c5b258f21552ae425110b06461d6fbdf96d6fe8f", "parents": ["3209cb39ab01819d52d6171e467f7428005223a8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091607 [wpt PR 64509] - Update wpt metadata, a=testonly\n\nwpt-pr: 64509\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-tables/collapsed-border-background-inset.html.ini"], "git_node": "6c8158c6f28df455620a092906c0626e3e12495f", "git_parents": ["d9f83843d06be0cccc74b8f91f74fe448610788d"], "node": "0b4b2a1619cf34619dd8ed7021cb132c000de013", "parents": ["c5b258f21552ae425110b06461d6fbdf96d6fe8f"], "tags": []}, {"author": "Gabriele Cabrini \u003cgabriele@gabrielecabrini.it\u003e", "branch": "default", "desc": "Bug 2091611 [wpt PR 64500] - tests: Wait for fonts in baseline-source textarea tests, a=testonly\n\nAutomatic update from web-platform-tests\ntests: Wait for fonts in baseline-source textarea tests\n\nSigned-off-by: Gabriele Cabrini \u003cgabriele@gabrielecabrini.it\u003e\n\n--\n\nwpt-commits: 1528b49ffa67934be0b643373fa5f468d5b75e09\nwpt-pr: 64500\n", "files": ["testing/web-platform/tests/css/css-inline/baseline-source/baseline-source-first-textarea-001.tentative.html", "testing/web-platform/tests/css/css-inline/baseline-source/baseline-source-first-textarea-002.tentative.html", "testing/web-platform/tests/css/css-inline/baseline-source/baseline-source-first-textarea-003.tentative.html", "testing/web-platform/tests/css/css-inline/baseline-source/baseline-source-last-textarea-001.tentative.html", "testing/web-platform/tests/css/css-inline/baseline-source/baseline-source-last-textarea-002.tentative.html", "testing/web-platform/tests/css/css-inline/baseline-source/baseline-source-last-textarea-003.tentative.html"], "git_node": "726b4cdc08738b78dcca265de50d1d96681fd856", "git_parents": ["6c8158c6f28df455620a092906c0626e3e12495f"], "node": "c69e4f98e017dd560051d6e5b8b6fd456474f056", "parents": ["0b4b2a1619cf34619dd8ed7021cb132c000de013"], "tags": []}, {"author": "Roberto Rodriguez \u003croberto_rodriguez2@apple.com\u003e", "branch": "default", "desc": "Bug 2091612 [wpt PR 64507] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=314705, a=testonly\n\nAutomatic update from web-platform-tests\nCSP sandbox does not prevent cross-document view transition state transfer\n\nA navigation to a same-origin URL that responds with Content-Security-Policy: sandbox\n(but without allow-same-origin) still receives the full inbound cross-document view\ntransition. The same-origin check runs before CSP headers are applied and is never\nre-evaluated. The previous page's captured element names, geometry, and rendered content\nget transfered to the sandboxed document.\n\nStore the old document's SecurityOrigin in ViewTransitionParams at pageswap capture time.\nRe-check same-origin in resolveInboundCrossDocumentViewTransition, which runs during\nDocument::reveal() after CSP headers have been applied and the new document's final origin\nis established. If the origins no longer match, the transition is rejected and no state is\ntransferred.\n\nThis includes the lint fix from https://commits.webkit.org/325400@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=314705\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329720\nWebKit-Canonical-Link: https://commits.webkit.org/314585@main\n\n--\n\nwpt-commits: 6d49f3a855adba7e4d056caf60c14dfef7b02e7f\nwpt-pr: 64507\n", "files": ["testing/web-platform/tests/css/css-view-transitions/navigation/no-view-transition-with-csp-sandbox.html", "testing/web-platform/tests/css/css-view-transitions/navigation/resources/csp-sandbox-new.html", "testing/web-platform/tests/css/css-view-transitions/navigation/resources/csp-sandbox-new.html.headers", "testing/web-platform/tests/css/css-view-transitions/navigation/resources/csp-sandbox-old.html"], "git_node": "163237f5403412e95313b9ca9ff7d1ce6c949e59", "git_parents": ["726b4cdc08738b78dcca265de50d1d96681fd856"], "node": "50d5f184fcca5a5eff87429a05b82bbcc5817385", "parents": ["c69e4f98e017dd560051d6e5b8b6fd456474f056"], "tags": []}, {"author": "Gabriele Cabrini \u003cgabriele@gabrielecabrini.it\u003e", "branch": "default", "desc": "Bug 2091614 [wpt PR 64511] - wpt: Wait for web fonts before measuring in Ahem-based testharness tests, a=testonly\n\nAutomatic update from web-platform-tests\nwpt: Wait for web fonts before measuring in Ahem-based testharness tests\n\nSigned-off-by: Gabriele Cabrini \u003cgabriele@gabrielecabrini.it\u003e\n\n--\n\nwpt-commits: 93d221d6c7720d3efd1b51820b62d6bca94483a5\nwpt-pr: 64511\n", "files": ["testing/web-platform/tests/css/CSS2/linebox/inline-negative-margin-001.html", "testing/web-platform/tests/css/CSS2/normal-flow/block-in-inline-self-collapsing-margin-001.html", "testing/web-platform/tests/css/css-align/baseline-rules/first-baseline-block-in-inline-001.html", "testing/web-platform/tests/css/css-break/box-decoration-break-clone-block-in-inline-001.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-block-in-inline-line-height-001.html"], "git_node": "b1daed4a63f1f5e815f29d411e44c88c22e595de", "git_parents": ["163237f5403412e95313b9ca9ff7d1ce6c949e59"], "node": "af51826cd29d15fd2f98055cecea797111f3e7d2", "parents": ["50d5f184fcca5a5eff87429a05b82bbcc5817385"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091614 [wpt PR 64511] - Update wpt metadata, a=testonly\n\nwpt-pr: 64511\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/CSS2/normal-flow/block-in-inline-self-collapsing-margin-001.html.ini", "testing/web-platform/meta/css/css-align/baseline-rules/first-baseline-block-in-inline-001.html.ini", "testing/web-platform/meta/css/css-break/box-decoration-break-clone-block-in-inline-001.html.ini", "testing/web-platform/meta/css/css-writing-modes/orthogonal-block-in-inline-line-height-001.html.ini"], "git_node": "a477858685f030ef3b2f4bbee97bd304a04489a4", "git_parents": ["b1daed4a63f1f5e815f29d411e44c88c22e595de"], "node": "e1f4a7fc7b1c096c4449de69034627b459ae0e80", "parents": ["af51826cd29d15fd2f98055cecea797111f3e7d2"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2091616 [wpt PR 64502] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=329737, a=testonly\n\nAutomatic update from web-platform-tests\nCanonicalize incoming MIME types\n\nWebKit didn't canonicalize every MIME type it received. The soup backend didn't\nlowercase them, and those from clients, as for loadData:MIMEType:, and from web\narchives kept their case and parameters. Exact comparisons then failed, and\ndocument.contentType exposed them as given.\n\nHave extractMIMETypeFromMediaType() lowercase, and use it where WebKit receives\nother MIME types, such as from an NSURLResponse or a web archive. For data that\nclients load, add ResourceResponse::responseForMIMEType(). A charset parameter\nfills in a missing text encoding name. ResourceResponseBase now asserts that\nMIME types are canonical, so TextResourceDecoder::contentTypeForMIMEType()\ncompares exactly, which resolves the FIXME from 324702@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329737\n\n--\n\nwpt-commits: 4ca2300045158959639296c721e6d3c2f304623d\nwpt-pr: 64502\n", "files": ["testing/web-platform/tests/dom/nodes/Document-contentType/contentType/contenttype_mimeheader_03.html"], "git_node": "ae4fef79a173de2949f99b91ca2cc1fd329087cd", "git_parents": ["a477858685f030ef3b2f4bbee97bd304a04489a4"], "node": "7c61d2b9a6b2b2ce0e2013e14ae3118b63864f31", "parents": ["e1f4a7fc7b1c096c4449de69034627b459ae0e80"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2091625 [wpt PR 64501] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=329731, a=testonly\n\nAutomatic update from web-platform-tests\nTest byte order marks split across chunks for Response's text() and json()\n\nAdd tests where a byte order mark or a multi-byte sequence is split across network chunks, using\nxhr/resources/content-in-chunks.py, like the XMLHttpRequest and EventSource tests in 324356@main.\nWebKit decodes the body all at once, so these pass already, but these tests could catch bugs if we\never made that process incremental.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329731\n\n--\n\nwpt-commits: 4e3292cf4dbfd512ec6104a9d3644eecb886a010\nwpt-pr: 64501\n", "files": ["testing/web-platform/tests/fetch/api/basic/split-byte-order-mark.any.js"], "git_node": "6ba7594f9aeccc6d351e2beeff4f6ed7c6cae0db", "git_parents": ["ae4fef79a173de2949f99b91ca2cc1fd329087cd"], "node": "69bc2452b658651fecba4c98578bcf8724aee016", "parents": ["7c61d2b9a6b2b2ce0e2013e14ae3118b63864f31"], "tags": []}, {"author": "Felipe Erias \u003cfelipeerias@igalia.com\u003e", "branch": "default", "desc": "Bug 2091628 [wpt PR 64519] - [svg] Use the replaced content rect for embedded SVG documents, a=testonly\n\nAutomatic update from web-platform-tests\n[svg] Use the replaced content rect for embedded SVG documents\n\nWhen the flag SVGEmbeddedAsReplacedElement is enabled, object-fit and\nobject-position apply to in-process SVG documents in \u003cobject\u003e and\n\u003cembed\u003e. The child frame is sized and positioned by the replaced content\nrect, but coordinate mapping still uses the offset of the content box.\nWhen the replaced content rect has a different offset, pointer events\nget the wrong target and coordinates, scrollIntoView scrolls to the\nwrong position, and IntersectionObserver reports wrong results.\n\nLocalFrameView and LayoutView now map between the child and parent\ndocuments using the offset of the replaced content rect.\n\nSince object-fit can also extend the child frame beyond the content box,\nvisual rects mapped out of the child document are clipped by the\nLayoutEmbeddedObject. Where the child frame covers only part of the\ncontent box, pointer events over the rest now target the \u003cobject\u003e or\n\u003cembed\u003e element instead of the child frame.\n\nChanges to object-fit or object-position only invalidate paint, so the\nchild frame keeps its old size and position. With the flag enabled,\nthese changes on a LayoutEmbeddedObject now schedule a geometry update\nin the parent LocalFrameView and a paint property update on the child\nLayoutView.\n\nApart from the handling of style changes, these changes do not depend on\nthe flag. For other frames and plugins, the replaced content rect has\nthe same offset as the content box, so the offset used for coordinate\nmapping does not change. The exception is a frame owner that is the\neffective root scroller, whose replaced content rect has a zero offset.\nCoordinate mapping now uses that offset, as painting and hit testing\nalready do.\n\nTests:\n  /wpt/css/css-images/object-fit-change-svg-001o.html\n  /wpt/css/css-images/object-fit-svg-intersection-observer.sub.html\n  /wpt/css/css-images/object-fit-svg-pointer-events.html\n  /wpt/css/css-images/object-fit-svg-scroll-into-view.html\n\nBug: 41302806\nChange-Id: I0ad803f1a4da18a3949c9f6738eb23ceb15ce10f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8585219\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCommit-Queue: Felipe Erias \u003cfelipeerias@igalia.com\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1732547}\n\n--\n\nwpt-commits: 5602b0f210e3278b5f0030ae980b68da4ef35032\nwpt-pr: 64519\n", "files": ["testing/web-platform/tests/css/css-images/object-fit-change-svg-001-ref.html", "testing/web-platform/tests/css/css-images/object-fit-change-svg-001o.html", "testing/web-platform/tests/css/css-images/object-fit-svg-intersection-observer.sub.html", "testing/web-platform/tests/css/css-images/object-fit-svg-pointer-events.html", "testing/web-platform/tests/css/css-images/object-fit-svg-scroll-into-view.html", "testing/web-platform/tests/css/css-images/support/frame-with-fitted-object.html"], "git_node": "49f24a9f906909d57a4fc0d38e15c3f0a03f10d4", "git_parents": ["6ba7594f9aeccc6d351e2beeff4f6ed7c6cae0db"], "node": "82410265c22c4cad1cbcaed010744fa790738118", "parents": ["69bc2452b658651fecba4c98578bcf8724aee016"], "tags": []}, {"author": "Sam Weinig \u003csam@webkit.org\u003e", "branch": "default", "desc": "Bug 2081480 [wpt PR 63608] - Make generate_object_view_box_tests.py generate SVG in an \u003cobject\u003e variants, a=testonly\n\nAutomatic update from web-platform-tests\nMake generate_object_view_box_tests.py generate SVG in an \u003cobject\u003e variants\n\nUpdates the generator to support \u003cobject\u003e and runs it to generate the new tests.\n\n--\n\nwpt-commits: 0de04ac4d7b0930d54c6c8e2511e9a479719fa69\nwpt-pr: 63608\n", "files": ["testing/web-platform/tests/css/css-images/object-view-box-fit-contain-svg-object-ref.html", "testing/web-platform/tests/css/css-images/object-view-box-fit-contain-svg-object.html", "testing/web-platform/tests/css/css-images/object-view-box-fit-cover-svg-object-ref.html", "testing/web-platform/tests/css/css-images/object-view-box-fit-cover-svg-object.html", "testing/web-platform/tests/css/css-images/object-view-box-fit-fill-svg-object-ref.html", "testing/web-platform/tests/css/css-images/object-view-box-fit-fill-svg-object.html", "testing/web-platform/tests/css/css-images/object-view-box-fit-none-svg-object-ref.html", "testing/web-platform/tests/css/css-images/object-view-box-fit-none-svg-object.html", "testing/web-platform/tests/css/css-images/support/testHelper.js", "testing/web-platform/tests/css/css-images/tools/generate_object_view_box_tests.py"], "git_node": "ff6b68b37c7e299973d7bd7b72a0f66963dc8e8a", "git_parents": ["49f24a9f906909d57a4fc0d38e15c3f0a03f10d4"], "node": "54e329fc128c57c3938802c2d96e72c2640d7b6f", "parents": ["82410265c22c4cad1cbcaed010744fa790738118"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081480 [wpt PR 63608] - Update wpt metadata, a=testonly\n\nwpt-pr: 63608\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-images/object-view-box-fit-contain-svg-object.html.ini", "testing/web-platform/meta/css/css-images/object-view-box-fit-cover-svg-object.html.ini", "testing/web-platform/meta/css/css-images/object-view-box-fit-fill-svg-object.html.ini", "testing/web-platform/meta/css/css-images/object-view-box-fit-none-svg-object.html.ini"], "git_node": "a14f78d0b1fbab3f19a94e770b484328b68d2ad9", "git_parents": ["ff6b68b37c7e299973d7bd7b72a0f66963dc8e8a"], "node": "6d7ed3fe8c6a97d0ab627827f535dd1f9889d6e9", "parents": ["54e329fc128c57c3938802c2d96e72c2640d7b6f"], "tags": []}, {"author": "Alicia Boya Garc\u00eda \u003cntrrgc@gmail.com\u003e", "branch": "default", "desc": "Bug 2091639 [wpt PR 15432] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=194760, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=194760\n\n--\n\nwpt-commits: 8afcd6b9d3568ad5416b2abab5f711e320fa3bd7\nwpt-pr: 15432\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/media-elements/replay.html"], "git_node": "db37f4cfed3a650c2ba2bb18b298cb45f818ed17", "git_parents": ["a14f78d0b1fbab3f19a94e770b484328b68d2ad9"], "node": "31e9b4c6ab8fbcd3d09b4f3966704797e5af7e15", "parents": ["6d7ed3fe8c6a97d0ab627827f535dd1f9889d6e9"], "tags": []}, {"author": "Gabriele Cabrini \u003cgabriele@gabrielecabrini.it\u003e", "branch": "default", "desc": "Bug 2091648 [wpt PR 64517] - wpt: Wait for web fonts in onload layout tests, a=testonly\n\nAutomatic update from web-platform-tests\ntests: Wait for web fonts in onload layout tests\n\nSigned-off-by: Gabriele Cabrini \u003cgabriele@gabrielecabrini.it\u003e\n\n--\nRemove unused Ahem\n\nSigned-off-by: Euclid Ye \u003cyezhizhenjiakang@gmail.com\u003e\n\n--\n\nwpt-commits: 8a0e11a8a26785ca131b4e519e1b58cfa8c5ecd4, 01cd37dc891b65f3dfbe99f854ecc69f4649861a\nwpt-pr: 64517\n", "files": ["testing/web-platform/tests/css/css-flexbox/align-items-baseline-row-horz.html", "testing/web-platform/tests/css/css-flexbox/flex-item-compressible-001.html", "testing/web-platform/tests/css/css-flexbox/text-as-flexitem-size-001.html", "testing/web-platform/tests/css/css-overflow/scrollable-overflow-padding-input.html", "testing/web-platform/tests/css/css-overflow/scrollable-overflow-textarea.html", "testing/web-platform/tests/css/cssom-view/offsetTopLeft-border-box.html", "testing/web-platform/tests/mathml/presentation-markup/operators/mo-no-vertical-adjustment-for-basic-binary-operators.html", "testing/web-platform/tests/mathml/presentation-markup/operators/operator-dictionary-combining-default.html", "testing/web-platform/tests/mathml/presentation-markup/operators/operator-dictionary-combining.html"], "git_node": "b5ff8f701e040b08a04bfc158a54db90156342a0", "git_parents": ["db37f4cfed3a650c2ba2bb18b298cb45f818ed17"], "node": "7263ef33cf2bc5f37e638572547ada641cf13142", "parents": ["31e9b4c6ab8fbcd3d09b4f3966704797e5af7e15"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091648 [wpt PR 64517] - Update wpt metadata, a=testonly\n\nwpt-pr: 64517\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/overflow-body-propagation-013.html.ini"], "git_node": "20c1bdb82c4492f37376e33c4a167017655ed951", "git_parents": ["b5ff8f701e040b08a04bfc158a54db90156342a0"], "node": "7490681ace8851f0a48e32d8bf665cdc90d03ddb", "parents": ["7263ef33cf2bc5f37e638572547ada641cf13142"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2091660 [wpt PR 64520] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=311689, a=testonly\n\nAutomatic update from web-platform-tests\nREGRESSION(302241@main): CSS \"aspect-ratio\" is not honored when window is zoomed in\n\nWhen we are computing a box's size in an axis (e.g. height) using an\naspect-ratio and its minimum size in that axis (e.g. min-height) is\nauto, we need to compute its min-content size as the automatic minimum\nsize.\nhttps://drafts.csswg.org/css-sizing-4/#aspect-ratio-minimum\n\nFor the logical height, we have this behavior implemented in\nRenderBox::constrainLogicalHeightByMinMax.\n\nThis includes the reference fix from https://commits.webkit.org/325407@main.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=311689\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329740\nWebKit-Canonical-Link: https://commits.webkit.org/310931@main\n\n--\n\nwpt-commits: a562c09d327933d3a71ed2599a6eec0a87f11626\nwpt-pr: 64520\n", "files": ["testing/web-platform/tests/css/css-viewport/zoom/aspect-ratio-height-with-automatic-minimum-size-tall-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/aspect-ratio-height-with-automatic-minimum-size-tall.html", "testing/web-platform/tests/css/css-viewport/zoom/aspect-ratio-height-with-automatic-minimum-size.html"], "git_node": "313376b65fc3a5bd8823e734a7c0e70fb7b110da", "git_parents": ["20c1bdb82c4492f37376e33c4a167017655ed951"], "node": "6f5994b27d4011c993e7350cbb551a10d6966d25", "parents": ["7490681ace8851f0a48e32d8bf665cdc90d03ddb"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2091663 [wpt PR 64351] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=329441, a=testonly\n\nAutomatic update from web-platform-tests\nA page in the back/forward cache shares processes with a document of the page in the same browsing context group\n\nSince 324033@main, a same-site navigation can move the main frame to another\nprocess when only one of the documents has a Document-Isolation-Policy. The page\nstays in its browsing context group, so the document that goes into the\nback/forward cache keeps sharing the group's processes with the new one. A frame\nof the new document could then be sent to a process where the page's WebPage is\nthe cached one, and never load, which made\nlocation-replace-keeps-entry.tentative.https.html time out after\nisolate-and-require-corp.tentative.https.html. And evicting the cached document\nclosed the new document's remote pages.\n\nNow, when a document commits, the processes of the page's cached documents in\nits group move to groups of their own, with the page's remote pages in them.\nRestoring a document moves them back, as long as no other page uses the group.\nOtherwise the document is loaded again, or keeps its own group if the other page\nonly joined during the restore. A cached document with a frame in the process\nthe new document's main frame started in is dropped from the cache, as that\nframe's WebPage became the new document's.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329441\n\n--\n\nwpt-commits: cf1e56022f15dbb53e6a2cf3f0cc082a13813b4a\nwpt-pr: 64351\n", "files": ["testing/web-platform/tests/html/document-isolation-policy/back-forward-cache-same-origin-frames.tentative.https.html"], "git_node": "26570ceb1b771783be90ff91d60bede0e08f697d", "git_parents": ["313376b65fc3a5bd8823e734a7c0e70fb7b110da"], "node": "74eec6205ba4ffa77762589bbb2d81a7c1746627", "parents": ["6f5994b27d4011c993e7350cbb551a10d6966d25"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091663 [wpt PR 64351] - Update wpt metadata, a=testonly\n\nwpt-pr: 64351\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/document-isolation-policy/back-forward-cache-same-origin-frames.tentative.https.html.ini"], "git_node": "4ab862086f63375be45097113ae2739f919b6bc8", "git_parents": ["26570ceb1b771783be90ff91d60bede0e08f697d"], "node": "8c21c2749b8e22389a724a0a03228fe41bc17bda", "parents": ["74eec6205ba4ffa77762589bbb2d81a7c1746627"], "tags": []}, {"author": "Alicia Boya Garcia \u003caboya@igalia.com\u003e", "branch": "default", "desc": "Bug 2091830 [wpt PR 64521] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=201401, a=testonly\n\nAutomatic update from web-platform-tests\n[MSE][GStreamer] Fix video sometimes not appearing\n\nAdded a test that reproduces the sequence of operations that was\ncausing the video to not appear in WebKitGTK and checks that this time\nthere is visible output.\n\nThis includes the changes from https://commits.webkit.org/325438@main that make the test work outside WebKit.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=201401\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=329778\nWebKit-Canonical-Link: https://commits.webkit.org/216219@main\n\n--\n\nwpt-commits: 7aec45d140d786e7cc295a1c61cbf717308dd854\nwpt-pr: 64521\n", "files": ["testing/web-platform/tests/media-source/mediasource-video-is-visible-ref.html", "testing/web-platform/tests/media-source/mediasource-video-is-visible.html", "testing/web-platform/tests/media-source/mp4/test-a-1s.mp4", "testing/web-platform/tests/media-source/mp4/test-a-1s.mp4-manifest.json", "testing/web-platform/tests/media-source/mp4/test-v-1s-blue.mp4", "testing/web-platform/tests/media-source/mp4/test-v-1s-blue.mp4-manifest.json", "testing/web-platform/tests/media-source/webm/test-a-1s.webm", "testing/web-platform/tests/media-source/webm/test-a-1s.webm-manifest.json", "testing/web-platform/tests/media-source/webm/test-v-1s-blue.webm", "testing/web-platform/tests/media-source/webm/test-v-1s-blue.webm-manifest.json"], "git_node": "1b48da964f9a7693688dc3bc0a44a27fe46a7589", "git_parents": ["4ab862086f63375be45097113ae2739f919b6bc8"], "node": "cbbec33868bd87cc3de282ba28c036ae0cff820b", "parents": ["8c21c2749b8e22389a724a0a03228fe41bc17bda"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091830 [wpt PR 64521] - Update wpt metadata, a=testonly\n\nwpt-pr: 64521\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/media-source/mediasource-video-is-visible.html.ini"], "git_node": "ac3cad2c5b659fff9748fc12a38871ba75bb23b1", "git_parents": ["1b48da964f9a7693688dc3bc0a44a27fe46a7589"], "node": "c242522ff0563752a7fd34f0b8b1bf4a437cdad7", "parents": ["cbbec33868bd87cc3de282ba28c036ae0cff820b"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091836 [wpt PR 64523] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328586, a=testonly\n\nAutomatic update from web-platform-tests\n[Flex] A column-wrap flex container keeps a stale max-content width when its height changes\n\nA multi-line column flex container's max-content width depends on its height, so when that height is a percentage or calc, a height change now invalidates its cached intrinsic widths.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328586\nWebKit-Canonical-Link: https://commits.webkit.org/324706@main\n\n--\n\nwpt-commits: d27f98e3115a017669875d895f1b1b38f4e1d3bd\nwpt-pr: 64523\n", "files": ["testing/web-platform/tests/css/css-flexbox/intrinsic-size/col-wrap-dynamic-002.html"], "git_node": "3d5bcd6320093906292c7f7512f852a5fe5b316f", "git_parents": ["ac3cad2c5b659fff9748fc12a38871ba75bb23b1"], "node": "965579aa1b5f31660739140406e5a1f6060024b0", "parents": ["c242522ff0563752a7fd34f0b8b1bf4a437cdad7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091836 [wpt PR 64523] - Update wpt metadata, a=testonly\n\nwpt-pr: 64523\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-flexbox/intrinsic-size/col-wrap-dynamic-002.html.ini"], "git_node": "b2f56a8ce611a79675ef8cd67be3eaf63ea920df", "git_parents": ["3d5bcd6320093906292c7f7512f852a5fe5b316f"], "node": "1a51fdbf0fb4b3ad075e7e63bcb3d45550f27924", "parents": ["965579aa1b5f31660739140406e5a1f6060024b0"], "tags": []}, {"author": "lilly \u003c173393835+cupidsity@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2091842 [wpt PR 64522] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=326574, a=testonly\n\nAutomatic update from web-platform-tests\ncorner-shape: Ancestor overflow clip ignores corner-shape changes and clips square corners round\n\nStore the corner curvatures in CompositedClipData so shape-only changes are seen,\nand strip the radii on the non-mask path via contentsClippingRectForCornerShape().\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=326574\nWebKit-Canonical-Link: https://commits.webkit.org/324753@main\n\n--\n\nwpt-commits: 0011028a4c4e452d9b6635762d569c2fd8d6bccb\nwpt-pr: 64522\n", "files": ["testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-ancestor-clip-dynamic-ref.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-ancestor-clip-dynamic.html"], "git_node": "a674b9532e141912e0573a5c4a8a89a92061d9b1", "git_parents": ["b2f56a8ce611a79675ef8cd67be3eaf63ea920df"], "node": "74c253685b499f94b0afd97a8e438e9f03a4e8e1", "parents": ["1a51fdbf0fb4b3ad075e7e63bcb3d45550f27924"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091845 [wpt PR 64527] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328507, a=testonly\n\nAutomatic update from web-platform-tests\nTest the intrinsic widths of inline content with floats and out-of-flow boxes\n\nThese tests come from two WebKit changes, exported together because the second one edits a test the first one adds:\n- [IFC] IFC cannot compute intrinsic widths when inline content has floats (https://commits.webkit.org/324663@main)\n- [IFC] IFC cannot compute intrinsic widths when inline content has out-of-flow boxes (https://commits.webkit.org/324666@main)\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328507\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328517\n\n--\n\nwpt-commits: a1aee13518cb8e6fb10d2c089c03d0239356956e\nwpt-pr: 64527\n", "files": ["testing/web-platform/tests/css/CSS2/floats/floats-in-inline-content-intrinsic-size-001.html", "testing/web-platform/tests/css/css-position/out-of-flow-in-inline-content-intrinsic-size-001.html"], "git_node": "ae209c4a1a7ad8c8c99cc7e692a054a9c8c310b8", "git_parents": ["a674b9532e141912e0573a5c4a8a89a92061d9b1"], "node": "1407809e8165d2834a0e12be11f447821f9743ed", "parents": ["74c253685b499f94b0afd97a8e438e9f03a4e8e1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091845 [wpt PR 64527] - Update wpt metadata, a=testonly\n\nwpt-pr: 64527\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/CSS2/floats/floats-in-inline-content-intrinsic-size-001.html.ini", "testing/web-platform/meta/css/css-position/out-of-flow-in-inline-content-intrinsic-size-001.html.ini"], "git_node": "d0df9ff525b6dfc4ab2aa748be1e2e30715bf180", "git_parents": ["ae209c4a1a7ad8c8c99cc7e692a054a9c8c310b8"], "node": "80144faef0b7f609878cd40b496f175bbe19f1e1", "parents": ["1407809e8165d2834a0e12be11f447821f9743ed"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091849 [wpt PR 64525] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328531, a=testonly\n\nAutomatic update from web-platform-tests\n[IFC] IFC cannot compute intrinsic widths when inline content has atomic inline-level boxes without a fixed width\n\ncanUseForIntrinsicWidthComputation only took atomic inline-level boxes with a fixed width, because the box geometry IFC\nreads their widths from holds only the min-content width. Inline-blocks with content, auto-width replaced boxes, inline\nflex, grid and table boxes and orthogonal boxes went to the legacy intrinsic width walk.\n\nAsk the render tree for an atomic box's width under each constraint, as floats and block level boxes on a line already do\n(InlineFormattingUtils::intrinsicMarginBoxWidth). An orthogonal atomic box contributes its block size, like an orthogonal block level box.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328531\nWebKit-Canonical-Link: https://commits.webkit.org/324705@main\n\n--\n\nwpt-commits: 0c51314344f4ae8a72b3df447f65ce75c3147d7b\nwpt-pr: 64525\n", "files": ["testing/web-platform/tests/css/css-inline/atomic-inline-intrinsic-size-001.html"], "git_node": "a6729d7b7bb627060db0c401d79f256d8beffd04", "git_parents": ["d0df9ff525b6dfc4ab2aa748be1e2e30715bf180"], "node": "dd7c178042f0cc8c11ec5f40016af1dd040cdec8", "parents": ["80144faef0b7f609878cd40b496f175bbe19f1e1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091849 [wpt PR 64525] - Update wpt metadata, a=testonly\n\nwpt-pr: 64525\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-inline/atomic-inline-intrinsic-size-001.html.ini"], "git_node": "74cd9810ba17bfb89ef008615276f821a3459da3", "git_parents": ["a6729d7b7bb627060db0c401d79f256d8beffd04"], "node": "6a12945f08015462c87a38d6bd16fc6e97cedb50", "parents": ["dd7c178042f0cc8c11ec5f40016af1dd040cdec8"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091853 [wpt PR 64526] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328544, a=testonly\n\nAutomatic update from web-platform-tests\n[IFC] IFC cannot compute intrinsic widths when inline content has form controls\n\ncanUseForIntrinsicWidthComputation still sends form controls with native appearance and no fixed width, and controls like a\nlist box whose options have no renderers, to the legacy intrinsic width walk.\n\nTheir widths now come from the render tree like any other atomic inline-level box. A change that resizes a control (e.g. a\nnew select option) invalidates the container's content widths, which resets the cached intrinsic widths.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328544\nWebKit-Canonical-Link: https://commits.webkit.org/324712@main\n\n--\n\nwpt-commits: dead33fe5059bbb8f63743538fffa6e0e17d7b15\nwpt-pr: 64526\n", "files": ["testing/web-platform/tests/css/css-sizing/form-control-in-inline-content-intrinsic-size-001.html"], "git_node": "3c8030f965a8169a34a10764ce5c2224cf49b80d", "git_parents": ["74cd9810ba17bfb89ef008615276f821a3459da3"], "node": "180f65792887eeb5f8f7b0b501bbaba57fe7dcc0", "parents": ["6a12945f08015462c87a38d6bd16fc6e97cedb50"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091853 [wpt PR 64526] - Update wpt metadata, a=testonly\n\nwpt-pr: 64526\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-sizing/form-control-in-inline-content-intrinsic-size-001.html.ini"], "git_node": "63181036ea0b5435acb1db8119c9739104bcb1be", "git_parents": ["3c8030f965a8169a34a10764ce5c2224cf49b80d"], "node": "00a9a4bfeac4a4cc25b05d2cb63a6d171c7f5dfe", "parents": ["180f65792887eeb5f8f7b0b501bbaba57fe7dcc0"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2091858 [wpt PR 64524] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328594, a=testonly\n\nAutomatic update from web-platform-tests\n[Grid] A column-flow grid with auto-fill rows keeps a stale max-content width when its height changes\n\nA column-flow grid with auto-fill or auto-fit rows takes its row count from its height, which sets how many columns its items fill.\nIts cached intrinsic widths survived height changes that did not touch its own style, like a parent's height under height: 100%.\n\nRenderGrid::intrinsicLogicalWidthsDependOnLogicalHeight reports such a grid when its height, min-height or max-height is relative, or it is a stretched flex or grid item.\nshouldInvalidateContentWidths and RenderBlockFlow's percentage-height invalidation use it to invalidate the grid's intrinsic widths.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328594\nWebKit-Canonical-Link: https://commits.webkit.org/324711@main\n\n--\n\nwpt-commits: fe8e9baae6cc143bb7b65c5713b2679473c88f4c\nwpt-pr: 64524\n", "files": ["testing/web-platform/tests/css/css-grid/grid-definition/grid-auto-repeat-rows-dynamic-height-001.html"], "git_node": "7472fae4f5bfcdecc1d710ff1a4142533ec5354f", "git_parents": ["63181036ea0b5435acb1db8119c9739104bcb1be"], "node": "2f5dcad055b7061abf4664a405f1e4ae6742cde2", "parents": ["00a9a4bfeac4a4cc25b05d2cb63a6d171c7f5dfe"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091858 [wpt PR 64524] - Update wpt metadata, a=testonly\n\nwpt-pr: 64524\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/grid-definition/grid-auto-repeat-rows-dynamic-height-001.html.ini"], "git_node": "24e885e6c2a76f5fedf4df45c8aaf37a0b1cfbf4", "git_parents": ["7472fae4f5bfcdecc1d710ff1a4142533ec5354f"], "node": "af144fca1743c47d7c62f3b566212a5494ff5001", "parents": ["2f5dcad055b7061abf4664a405f1e4ae6742cde2"], "tags": []}, {"author": "Morten Stenshorne \u003cmstensho@chromium.org\u003e", "branch": "default", "desc": "Bug 2091861 [wpt PR 64401] - [FragmentedOofInCb] Resume fragmented OOFs in table row., a=testonly\n\nAutomatic update from web-platform-tests\n[FragmentedOofInCb] Resume fragmented OOFs in table row.\n\nIf a table row is the containing block of out-of-flow positioned\ndescendants, out-of-flow break tokens may now found directly under the\nrow.\n\nThe test coverage for this was non-existent, so add a test that would\nhave failed without this fix.\n\nBug: 40267498\nChange-Id: Ic9b7d2d83d8c824010f46950d27d380457737551\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8690893\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCommit-Queue: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1732619}\n\n--\n\nwpt-commits: 74c3e2c3e200a4586e6f6bc7328a96f8c4b2a387\nwpt-pr: 64401\n", "files": ["testing/web-platform/tests/css/css-break/table/oof-static-pos-percentage-height-003.html"], "git_node": "46df0a1000cf79315d656462939ac8afe89fa9e1", "git_parents": ["24e885e6c2a76f5fedf4df45c8aaf37a0b1cfbf4"], "node": "3835e5499e93e6aa8224878911b3b898683f6769", "parents": ["af144fca1743c47d7c62f3b566212a5494ff5001"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091861 [wpt PR 64401] - Update wpt metadata, a=testonly\n\nwpt-pr: 64401\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-break/table/oof-static-pos-percentage-height-003.html.ini"], "git_node": "00930532841777cb3dbc80d539d98c70d2462e6a", "git_parents": ["46df0a1000cf79315d656462939ac8afe89fa9e1"], "node": "f9fca60c8bf9c72e213a67773590916e760a2b64", "parents": ["3835e5499e93e6aa8224878911b3b898683f6769"], "tags": []}, {"author": "Seokho Song \u003cseokho@chromium.org\u003e", "branch": "default", "desc": "Bug 2091876 [wpt PR 64529] - Throw SyntaxError for unparsable matchContainer() queries, a=testonly\n\nAutomatic update from web-platform-tests\nThrow SyntaxError for unparsable matchContainer() queries\n\nSpec requires matchContainer() to throw a SyntaxError when\nthe container query list fails to parse [1]. Previously it returned a\nlist that never matched.\n\nUnknown features such as \"(invalid-feature)\" still parse and evaluate to\nfalse.\n\n[1] https://drafts.csswg.org/css-conditional-5/#the-matchContainer-method\n\nBug: 40887402\nChange-Id: If647cdc5c5970d15e4deecd287a5c095fc38c2f7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8439896\nCommit-Queue: Seokho Song \u003cseokho@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1732635}\n\n--\n\nwpt-commits: 5197f4e83e1e5a0e02c85f8600c11ae9c0433769\nwpt-pr: 64529\n", "files": ["testing/web-platform/tests/css/css-conditional/match-container.tentative.html"], "git_node": "f7111840bf48cbbf233b13b1983995b28852ae4a", "git_parents": ["00930532841777cb3dbc80d539d98c70d2462e6a"], "node": "7adfc21be4beee72b5fb8f3fc1a62d616866d3f1", "parents": ["f9fca60c8bf9c72e213a67773590916e760a2b64"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091876 [wpt PR 64529] - Update wpt metadata, a=testonly\n\nwpt-pr: 64529\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-conditional/container-queries/whitespace-update-after-removal.html.ini", "testing/web-platform/meta/css/css-conditional/match-container.tentative.html.ini"], "git_node": "db13ba58977a1de756daa26680a7f1f267bd22ba", "git_parents": ["f7111840bf48cbbf233b13b1983995b28852ae4a"], "node": "2667596e0459da26060cbe090fd8a60ee277f447", "parents": ["7adfc21be4beee72b5fb8f3fc1a62d616866d3f1"], "tags": []}, {"author": "Aakash \u003caaka3h@gmail.com\u003e", "branch": "default", "desc": "Bug 2091878 [wpt PR 64530] - Propagate NaN through min(), max() and clamp() in deferred calc, a=testonly\n\nAutomatic update from web-platform-tests\nPropagate NaN through min(), max() and clamp() in deferred calc\n\nThe deferred calc evaluator computed min()/max() with\nstd::min()/std::max() and clamp() with a std::max(std::min())\ncombination. Those drop a NaN second argument, so a NaN operand that\nfollowed a percentage (resolved in this later path) was silently\ndiscarded: width: min(12.5%, NaN * 1px) computed to 12.5% of the\ncontainer instead of 0, and the result depended on argument order.\n\nPer CSS Values 4, any operation with a NaN argument produces NaN, and\na top-level NaN calculation resolves to zero. Propagate NaN explicitly\nin the three operators so they match the non-deferred evaluator.\n\nExtend the computed-value WPT with percentage-based min/max/clamp NaN\ncases.\n\nBug: 579214227\nChange-Id: I52a871a9d0479c9447ace5a3b9d9f466a0b5a470\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8684761\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Helmut Januschka \u003chelmut@januschka.com\u003e\nCr-Commit-Position: refs/heads/main@{#1732677}\n\n--\n\nwpt-commits: a98d38dfeca40f4389840eefc1c34ab363e7bf67\nwpt-pr: 64530\n", "files": ["testing/web-platform/tests/css/css-values/calc-infinity-nan-computed.html"], "git_node": "5beda9be02d419eb4b9d3274183a4c4cffcb899f", "git_parents": ["db13ba58977a1de756daa26680a7f1f267bd22ba"], "node": "dad1a9526d97643b9e88028ebccfd4d9cbba8567", "parents": ["2667596e0459da26060cbe090fd8a60ee277f447"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091878 [wpt PR 64530] - Update wpt metadata, a=testonly\n\nwpt-pr: 64530\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/calc-infinity-nan-computed.html.ini", "testing/web-platform/meta/css/css-values/crashtests/calc-with-percent-and-number-in-line-height.html.ini"], "git_node": "8d030e7051e3b55c552d41a29b020ea14dd0c813", "git_parents": ["5beda9be02d419eb4b9d3274183a4c4cffcb899f"], "node": "cb9f2f68128612b8468208b771cc2ab7c5ab43d0", "parents": ["dad1a9526d97643b9e88028ebccfd4d9cbba8567"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2091883 [wpt PR 64533] - Don't allow a second value after 'auto' for caret-color, a=testonly\n\nAutomatic update from web-platform-tests\nDon't allow a second value after 'auto' for caret-color\n\nRemoved an invalid test for caret-color: auto white;\n\nBehavioral change only for CSSCaretColorWithOptionalSecondValue flag\nwhich is not yet shipped.\n\nBug: 579016024\nChange-Id: I380bd310795a25042dcc8dd8401f352c63718db0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8690136\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Ziran Sun \u003czsun@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1732696}\n\n--\n\nwpt-commits: e61778017713b31c415b52756f20c745f80ec4c9\nwpt-pr: 64533\n", "files": ["testing/web-platform/tests/css/css-ui/caret-color-block-shape-text-color-004-ref.html", "testing/web-platform/tests/css/css-ui/caret-color-block-shape-text-color-004.html"], "git_node": "5fe915e0867903b49afb14bc46093a109c0219c2", "git_parents": ["8d030e7051e3b55c552d41a29b020ea14dd0c813"], "node": "dc5e6eec1d74a7bf3c590a93dcec693791403bd0", "parents": ["cb9f2f68128612b8468208b771cc2ab7c5ab43d0"], "tags": []}, {"author": "Camille Lamy \u003cclamy@chromium.org\u003e", "branch": "default", "desc": "Bug 2091892 [wpt PR 64540] - Only pass verified integrity metadata on ModuleMap CSP re-check, a=testonly\n\nAutomatic update from web-platform-tests\nOnly pass verified integrity metadata on ModuleMap CSP re-check\n\nWhen a module script hits an existing entry in the ModuleMap,\nFetchSingleModuleScript re-checks CSP with the request's parser state to\nprevent a modulepreload strict-dynamic bypass. Previously, that re-check\npassed the consumer request's integrity metadata even when it did not\nmatch the entry's SRI-verified integrity metadata, allowing an\nunverified integrity attribute matching a policy hash to satisfy CSP\nwithout SRI enforcement.\n\nOnly forward the request's integrity metadata to AllowScriptFromSource()\nwhen it matches the cached entry's integrity metadata; otherwise pass an\nempty set.\n\nBug: 574603289\nChange-Id: I1fe6aa02c3d0e6e476d60c849d128df6f66bee00\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8674247\nReviewed-by: Mike West \u003cmkwst@chromium.org\u003e\nCommit-Queue: Camille Lamy \u003cclamy@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1732722}\n\n--\n\nwpt-commits: 0e5338a1826ea666cce5a49ae67570bbb3f35d4e\nwpt-pr: 64540\n", "files": ["testing/web-platform/tests/content-security-policy/script-src/script-src-strict_dynamic_modulepreload_integrity_mismatch.html", "testing/web-platform/tests/content-security-policy/script-src/script-src-strict_dynamic_modulepreload_integrity_mismatch.html.headers"], "git_node": "4893dedfa6b2641d00e4044bfe7dc9f7c6fdfdc8", "git_parents": ["5fe915e0867903b49afb14bc46093a109c0219c2"], "node": "001929c937e3457f283fa34ab0e7137dbed25b06", "parents": ["dc5e6eec1d74a7bf3c590a93dcec693791403bd0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091892 [wpt PR 64540] - Update wpt metadata, a=testonly\n\nwpt-pr: 64540\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/content-security-policy/script-src/script-src-strict_dynamic_modulepreload_integrity_mismatch.html.ini"], "git_node": "3d99c0636f2e30f48237e7469f4b5811f401d75b", "git_parents": ["4893dedfa6b2641d00e4044bfe7dc9f7c6fdfdc8"], "node": "81f8cc9a2b10a1f61c6fa6d6ef632fd34b782759", "parents": ["001929c937e3457f283fa34ab0e7137dbed25b06"], "tags": []}, {"author": "Gabriele Cabrini \u003cgabriele@gabrielecabrini.it\u003e", "branch": "default", "desc": "Bug 2091898 [wpt PR 64510] - script: Ignore transforms in HTMLImageElement width/height getters, a=testonly\n\nAutomatic update from web-platform-tests\nscript: Ignore transforms in HTMLImageElement width/height getters\n\nSigned-off-by: Gabriele Cabrini \u003cgabriele@gabrielecabrini.it\u003e\n\n--\n\nwpt-commits: 2ba9fb4a8b58120939823502895d8f7b6b50f431\nwpt-pr: 64510\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-img-element/dimension-getter-transform.html"], "git_node": "6a9ae596a03b2f1d7c1634791b48aebbc6d5dfbf", "git_parents": ["3d99c0636f2e30f48237e7469f4b5811f401d75b"], "node": "dab14d20b509508d4e0587848516a9c7a5b24ce5", "parents": ["81f8cc9a2b10a1f61c6fa6d6ef632fd34b782759"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2091906 [wpt PR 64512] - Update Wasm tests, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate Wasm tests (core)\n\n--\n\nwpt-commits: 8eefc87f8b58e5cdb6ed961de89040a7a7e09709\nwpt-pr: 64512\n", "files": ["testing/web-platform/tests/wasm/core/js/gc/array_copy.wast.js"], "git_node": "3eb247edc789bfc4136fd5f9d1a5c2c99c0e2c77", "git_parents": ["6a9ae596a03b2f1d7c1634791b48aebbc6d5dfbf"], "node": "f781116812cbaeb9b6aee09a8343403307f2f06b", "parents": ["dab14d20b509508d4e0587848516a9c7a5b24ce5"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2091912 [wpt PR 64514] - Update Test262 tests, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate Test262 tests\n\n--\n\nwpt-commits: f9ce02291557e4a126b51ff194f212bf18f4b99f\nwpt-pr: 64514\n", "files": ["testing/web-platform/tests/third_party/test262/test/built-ins/DataView/prototype/byteLength/detached-buffer.js", "testing/web-platform/tests/third_party/test262/test/built-ins/DataView/prototype/byteLength/instance-has-detached-buffer.js", "testing/web-platform/tests/third_party/test262/test/built-ins/DataView/prototype/byteLength/resizable-array-buffer-auto.js", "testing/web-platform/tests/third_party/test262/test/built-ins/DataView/prototype/byteLength/resizable-array-buffer-fixed.js", "testing/web-platform/tests/third_party/test262/test/bu