d9f46d1ab8b3", "parents": ["4cdcf0d25b929f93a9e3706fffae2ef3fdfa1e1c"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075548 - Cache API: add a static_assert to check the DB migration list is ordered, and goes up to kLatestSchemaVersion. r=dom-storage-reviewers,dom-worker-reviewers,jari,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342112\n", "files": ["dom/cache/DBSchema.cpp"], "git_node": "492126022d79fcffc9d27c1a093b061a38839b16", "git_parents": ["31de23ea5978f51a07a5bacb24d3aca5bf817a5c"], "node": "4527dad564c990e6078ce7d9adee74b709d42c9e", "parents": ["e9298eb0a225bf27e42a361c6c13d9f46d1ab8b3"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075548 - Cache API: reserve size in AppendListParamsToQuery since we know the size already. r=dom-storage-reviewers,dom-worker-reviewers,jari,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333832\n", "files": ["dom/cache/DBSchema.cpp"], "git_node": "8b2f1318aafb2ec4ad081a2f684fed067f5abc9b", "git_parents": ["492126022d79fcffc9d27c1a093b061a38839b16"], "node": "8125122bdd39342522a63180178d5a38084e0d4f", "parents": ["4527dad564c990e6078ce7d9adee74b709d42c9e"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075548 - Cache API: move common strings constants to unique place. r=dom-storage-reviewers,dom-worker-reviewers,jari,edenchuang\n\nAlso, use typed constants instead of macros define (safer and cleaner).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333833\n", "files": ["dom/cache/FileUtils.cpp", "dom/cache/FileUtils.h", "dom/cache/FileUtilsImpl.h", "dom/cache/QuotaClient.cpp", "dom/cache/QuotaClient.h"], "git_node": "11eeed56302b330dfd7d1bebddc045efde2a42bf", "git_parents": ["8b2f1318aafb2ec4ad081a2f684fed067f5abc9b"], "node": "0816a8ff8118a57e27196520