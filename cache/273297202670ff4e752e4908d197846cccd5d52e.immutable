tandard_fonts/FoxitFixed.pfb", "toolkit/components/pdfjs/content/web/standard_fonts/FoxitFixedBold.pfb", "toolkit/components/pdfjs/content/web/standard_fonts/FoxitFixedBoldItalic.pfb", "toolkit/components/pdfjs/content/web/standard_fonts/FoxitFixedItalic.pfb", "toolkit/components/pdfjs/content/web/standard_fonts/FoxitSerif.pfb", "toolkit/components/pdfjs/content/web/standard_fonts/FoxitSerifBold.pfb", "toolkit/components/pdfjs/content/web/standard_fonts/FoxitSerifBoldItalic.pfb", "toolkit/components/pdfjs/content/web/standard_fonts/FoxitSerifItalic.pfb", "toolkit/components/pdfjs/content/web/standard_fonts/FoxitSymbol.pfb", "toolkit/components/pdfjs/content/web/standard_fonts/LICENSE_ARIMO", "toolkit/components/pdfjs/content/web/standard_fonts/LICENSE_FOXIT", "toolkit/components/pdfjs/content/web/standard_fonts/LICENSE_LIBERATION", "toolkit/components/pdfjs/content/web/standard_fonts/LICENSE_NOTO", "toolkit/components/pdfjs/content/web/standard_fonts/LICENSE_TINOS", "toolkit/components/pdfjs/content/web/standard_fonts/LICENSE_UNICODE", "toolkit/components/pdfjs/content/web/standard_fonts/LiberationSans-Bold.ttf", "toolkit/components/pdfjs/content/web/standard_fonts/LiberationSans-BoldItalic.ttf", "toolkit/components/pdfjs/content/web/standard_fonts/LiberationSans-Italic.ttf", "toolkit/components/pdfjs/content/web/standard_fonts/LiberationSans-Regular.ttf", "toolkit/components/pdfjs/content/web/standard_fonts/Mono-Bold.hbgd", "toolkit/components/pdfjs/content/web/standard_fonts/Mono-Regular.hbgd", "toolkit/components/pdfjs/content/web/standard_fonts/NotoSymbols.hbgd", "toolkit/components/pdfjs/content/web/standard_fonts/Sans-Bold.hbgd", "toolkit/components/pdfjs/content/web/standard_fonts/Sans-Regular.hbgd", "toolkit/components/pdfjs/content/web/standard_fonts/Serif-Bold.hbgd", "toolkit/components/pdfjs/content/web/standard_fonts/Serif-BoldItalic.hbgd", "toolkit/components/pdfjs/content/web/standard_fonts/Serif-Italic.hbgd", "toolkit/components/pdfjs/content/web/standard_fonts/Serif-Regular.hbgd", "toolkit/components/pdfjs/content/web/standard_fonts/Symbol.hbgd", "toolkit/components/pdfjs/content/web/standard_fonts/ZapfDingbats.hbgd", "toolkit/components/pdfjs/content/web/standard_fonts/unicode.bin", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/content/web/wasm/LICENSE_HELLBOX", "toolkit/components/pdfjs/content/web/wasm/hellbox_bg.wasm", "toolkit/components/pdfjs/content/web/wasm/hellbox_nowasm_fallback.js", "toolkit/components/pdfjs/jar.mn", "toolkit/components/pdfjs/moz.yaml"], "git_node": "f91482a33d1af65d45df31a4c8210c7425cb405a", "git_parents": ["517e557366e7e985f53b2e3157ae09acfe6610d0"], "node": "9e9dca5ac96f4837c622bd2cf3e78cd5584d3f4b", "parents": ["3a0945e7db179470168cee3a632503364f38c6fd"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1785929 - Set the Android Java 17 target without requiring a JDK 17 toolchain. r=android-reviewers,geckoview-reviewers,android-build-system-reviewers,ahochheiden,jonalmeida\n\njvmToolchain(17) made Gradle run javac, javadoc, tests and JavaExec tasks on a JDK 17 installation, which\nblocks building with a newer JDK while still targeting Java 17. The conventions ProjectPlugin now sets the\nJava, Kotlin and Javadoc levels for every project in all Android Gradle builds, and the tasks run on the JDK\nrunning Gradle.\n\nKotlin in plain JVM modules compiles with `-Xjdk-release` so it is held to the Java 17 API like javac's\n`release` option, and in automation every Java and Kotlin compile task fails if it writes a class file newer\nthan Java 17.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338192\n", "files": ["build.gradle", "mobile/android/android-components/.config.yml", "mobile/android/geckoview/build.gradle", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt", "mobile/android/gradle/plugins/conventions/src/test/java/org/mozilla/conventions/ClassFileVersionCheckTest.kt", "mobile/android/shared-settings.gradle"], "git_node": "82934ae704c3f8898f966f60a7cc50911cd41ee9", "git_parents": ["f91482a33d1af65d45df31a4c8210c7425cb405a"], "node": "9d1f27c7039f13e4706bd8c1b5260b9333e2c376", "parents": ["9e9dca5ac96f4837c622bd2cf3e78cd5584d3f4b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1785929 - Move the Android javac lint options into the conventions plugin. r=android-reviewers,geckoview-reviewers,android-build-system-reviewers,ahochheiden,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338193\n", "files": ["build.gradle", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "5d0d586a504464c8b3340221a684b01e2364688a", "git_parents": ["82934ae704c3f8898f966f60a7cc50911cd41ee9"], "node": "92164a579849b71a777e8a2004e0d683b69bab84", "parents": ["9d1f27c7039f13e4706bd8c1b5260b9333e2c376"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1785929 - Build Android with Temurin JDK 25. r=android-reviewers,geckoview-reviewers,android-build-system-reviewers,ahochheiden,jonalmeida\n\nThe this-escape check stays off until the GeckoView API classes that pass `this` out of their constructors are\nfixed, and dangling-doc-comments is off in Android projects because of AGP's generated BuildConfig.java.\n\nJDK 25 formats US short times with a narrow no-break space before AM/PM, as Android 14 and later do.\n\nUnit tests run with `--enable-native-access=ALL-UNNAMED` because Robolectric loads its native runtime with\n`System.load`, which JDK 25 warns about and a later JDK will block.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338194\n", "files": ["gradle/gradle-daemon-jvm.properties", "mobile/android/android-components/components/feature/awesomebar/src/test/java/mozilla/components/feature/awesomebar/provider/FlightsOnlineSuggestionProviderTest.kt", "mobile/android/android-components/components/feature/awesomebar/src/test/java/mozilla/components/feature/awesomebar/provider/ProviderUtilsTest.kt", "mobile/android/android-components/components/feature/awesomebar/src/test/java/mozilla/components/feature/awesomebar/provider/SportsOnlineSuggestionProviderTest.kt", "mobile/android/docs/index.md", "mobile/android/docs/shared/android/configure_java.md", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt", "python/mozboot/mozboot/android.py", "python/mozbuild/mozbuild/test/configure/test_checks_configure.py", "taskcluster/kinds/toolchain/android.yml"], "git_node": "511b7c7c920dce94eed603a04d4438eccc9909f6", "git_parents": ["5d0d586a504464c8b3340221a684b01e2364688a"], "node": "5243dd2aad192641554c3fef836f11f6d1c41702", "parents": ["92164a579849b71a777e8a2004e0d683b69bab84"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1785929 - Update google-java-format to 1.36.1. r=android-reviewers,geckoview-reviewers,android-build-system-reviewers,jonalmeida\n\nSpotless requires at least 1.30.0 on JDK 25. 1.37.0 does not work with Spotless yet\n(https://github.com/diffplug/spotless/issues/3126).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338195\n", "files": ["gradle/libs.versions.toml", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/gfx/RemoteSurfaceAllocator.java"], "git_node": "20803bb6e8714973ee15ac72ac550b1666b80bcb", "git_parents": ["511b7c7c920dce94eed603a04d4438eccc9909f6"], "node": "5d048d50936d59354e7aa3858d05accf0cf5c96c", "parents": ["5243dd2aad192641554c3fef836f11f6d1c41702"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1785929 - Update checkstyle to 14.3.0. r=android-reviewers,geckoview-reviewers,android-build-system-reviewers,jonalmeida\n\nCheckstyle 13 and later need Java 21. The version now comes from the version catalog. The newer checks also\ncover parameters of default interface methods and fail on malformed javadoc, so this fixes the code they flag.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338196\n", "files": ["gradle/libs.versions.toml", "mobile/android/geckoview/build.gradle", "mobile/android/geckoview/checkstyle.xml", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/FormatParam.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/Autocomplete.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/ExperimentDelegate.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoPreferenceController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/TranslationsController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/WebExtensionController.java"], "git_node": "53201e64b2dc12b3e7ffa95b90fd2de7f93f91b4", "git_parents": ["20803bb6e8714973ee15ac72ac550b1666b80bcb"], "node": "4c027e86459f2e94667aa8a378d49113fb436e44", "parents": ["5d048d50936d59354e7aa3858d05accf0cf5c96c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1785929 - Install OpenJDK 25 in the Android docker images. r=android-reviewers,jonalmeida\n\nDebian 12 has no OpenJDK 25 package, so android-components moves to the Debian 13 base image.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338197\n", "files": ["taskcluster/docker/android-components/Dockerfile", "taskcluster/docker/android-ui-tests/Dockerfile", "taskcluster/kinds/docker-image/kind.yml"], "git_node": "4bcf7edf5f84db032c9e8458d7fb381a64935d1a", "git_parents": ["53201e64b2dc12b3e7ffa95b90fd2de7f93f91b4"], "node": "c73f1c4750b6695e69bc3ea2f607da0a631cf191", "parents": ["4c027e86459f2e94667aa8a378d49113fb436e44"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1985185 - Run Robolectric tests against SDK 37. r=android-reviewers,geckoview-reviewers,webcompat-reviewers,ai4dev-reviewers,crashreporting-reviewers,android-build-system-reviewers,twisniewski,padenot,jonalmeida,ahochheiden\n\nRobolectric sets up SDK 37's ApplicationSharedMemory through jdk.internal.access, so unit test JVMs now export\nthat package, as upstream recommends in https://github.com/robolectric/robolectric/issues/11434.\n\nCompose UI test still pulls in espresso-core 3.5.0, which fails on SDK 37 (fixed in 3.7.0, see\nhttps://github.com/android/android-test/issues/2507), so unit test classpaths are constrained to the catalog\nversion.\n\nSDK 37 adds extended launch flags to an intent as it starts the activity, so DownloadsFeatureTest stubs out\nthe launch whose intent it compares.\n\nOn SDK 37, Robolectric reports the permissions an app declares as granted when it requests them\n(https://github.com/robolectric/robolectric/issues/11518), so the LensCameraActivityTest permission denial\ntest stays on SDK 36.\n\nThe Android agent skills now add test dependencies and robolectric.properties only along with a module's first\ntests that need them, since CI fetches the Robolectric jars only for modules with that file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338198\n", "files": [".agents/skills/android-new-module/SKILL.md", ".agents/skills/android/SKILL.md", ".claude/skills/android-new-module/SKILL.md", ".claude/skills/android/SKILL.md", "mobile/android/android-components/components/browser/domains/src/test/resources/robolectric.properties", "mobile/android/android-components/components/browser/engine-gecko/src/test/resources/robolectric.properties", "mobile/android/android-components/components/browser/engine-system/src/test/resources/robolectric.properties", "mobile/android/android-components/components/browser/errorpages/src/test/resources/robolectric.properties", "mobile/android/android-components/components/browser/icons/src/test/resources/robolectric.properties", "mobile/android/android-components/components/browser/menu/src/test/resources/mockito-extensions/robolectric.properties", "mobile/android/android-components/components/browser/menu/src/test/resources/robolectric.properties", "mobile/android/android-components/components/browser/menu2/src/test/resources/robolectric.properties", "mobile/android/android-components/components/browser/session-storage/src/test/resources/robolectric.properties", "mobile/android/android-components/components/browser/state/src/test/resources/robolectric.properties", "mobile/android/android-components/components/browser/storage-sync/src/test/resources/robolectric.properties", "mobile/android/android-components/components/browser/tabstray/src/test/resources/robolectric.properties", "mobile/android/android-components/components/browser/thumbnails/src/test/resources/robolectric.properties", "mobile/android/android-components/components/browser/toolbar/src/test/resources/robolectric.properties", "mobile/android/android-components/components/compose/awesomebar/src/test/resources/robolectric.properties", "mobile/android/android-components/components/compose/base/src/test/resources/robolectric.properties", "mobile/android/android-components/components/compose/browser-toolbar/src/test/resources/robolectric.properties", "mobile/android/android-components/components/compose/cfr/src/test/resources/robolectric.properties", "mobile/android/android-components/components/compose/draggable/src/test/resources/robolectric.properties", "mobile/android/android-components/components/compose/menu/src/test/resources/robolectric.properties", "mobile/android/android-components/components/concept/engine/src/test/resources/robolectric.properties", "mobile/android/android-components/components/concept/fetch/src/test/resources/robolectric.properties", "mobile/android/android-components/components/concept/toolbar/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/accounts-push/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/accounts/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/addons/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/app-links/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/autofill/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/automotive/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/awesomebar/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/containers/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/contextmenu/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/customtabs/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/downloads/src/test/java/mozilla/components/feature/downloads/DownloadsFeatureTest.kt", "mobile/android/android-components/components/feature/downloads/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/findinpage/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/fxsuggest/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/intent/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/ipprotection/src/test/resources/robolectric.properties", "mobile/android/andro