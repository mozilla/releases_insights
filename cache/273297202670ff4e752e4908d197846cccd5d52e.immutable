DME.md", "mobile/android/android-components/components/lib/bookmark-parser-jsoup/build.gradle", "mobile/android/android-components/components/lib/bookmark-parser-jsoup/src/main/java/mozilla/components/lib/bookmark/parser/jsoup/BookmarksParseResult.kt", "mobile/android/android-components/components/lib/bookmark-parser-jsoup/src/main/java/mozilla/components/lib/bookmark/parser/jsoup/JsoupBookmarksFileParser.kt", "mobile/android/android-components/components/lib/bookmarks-file/build.gradle", "mobile/android/android-components/components/lib/bookmarks-file/src/main/java/mozilla/components/lib/bookmarks/file/HtmlBookmarksFileImporter.kt", "mobile/android/android-components/components/lib/bookmarks-file/src/test/java/mozilla/components/lib/bookmarks/file/HtmlBookmarksFileImporterTest.kt", "mobile/android/android-components/components/lib/password-parser-csv/build.gradle", "mobile/android/android-components/components/lib/password-parser-csv/src/main/java/mozilla/components/lib/password/parser/csv/CsvPasswordsFileParser.kt", "mobile/android/android-components/components/lib/password-parser-csv/src/main/java/mozilla/components/lib/password/parser/csv/PasswordsParseResult.kt", "mobile/android/android-components/components/lib/passwords-file/build.gradle", "mobile/android/android-components/components/lib/passwords-file/src/main/java/mozilla/components/lib/passwords/file/CsvPasswordsFileImporter.kt", "mobile/android/android-components/components/lib/passwords-file/src/test/java/mozilla/components/lib/passwords/file/CsvPasswordsFileImporterTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/.buildconfig.yml", "taskcluster/config.yml"], "git_node": "39f55bf85df013ac3a41551cedbce82a62db2ff1", "git_parents": ["cd12ee56b53b992619892bb8ec254085c6df3299"], "node": "56ce2d834aab3292ddfb07dbc6a84897bfc1062c", "parents": ["9b488257631c4142d40631c265a03af54b8ae290"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090996 - Don't allow @position-try to change longhands that it shouldn't change. r=firefox-style-system-reviewers,layout-reviewers,jwatt\n\nMuch like we do for `::first-line`, this prevents unexpected style\nchanges.\n\nNo behavior change (any behavior change would be a bug).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340990\n", "files": ["servo/components/style/properties/cascade.rs", "servo/components/style/properties/properties.mako.rs", "servo/components/style/style_resolver.rs", "servo/components/style/stylist.rs", "servo/ports/geckolib/glue.rs"], "git_node": "0292ab166a5df34e55262da1fdf5de55a2839a1c", "git_parents": ["39f55bf85df013ac3a41551cedbce82a62db2ff1"], "node": "bd3a925d1c28615630e084d7c965146e7f5a2127", "parents": ["56ce2d834aab3292ddfb07dbc6a84897bfc1062c"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090620. r=jwatt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341048\n", "files": ["layout/generic/nsIFrame.cpp", "layout/generic/nsSplittableFrame.cpp"], "git_node": "972f6cd4d77cdb6510a0da06fe7f36671afbf27d", "git_parents": ["0292ab166a5df34e55262da1fdf5de55a2839a1c"], "node": "b98f3938f0fb18f74acec4de509a957c0c756d55", "parents": ["bd3a925d1c28615630e084d7c965146e7f5a2127"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Expect the urlHash of CSP violation reports in padded base64; r=tschuster\n\nThe script-url-blocked-report-contains-hash tests compared the urlHash of the\nviolation report against a base64url encoded, unpadded hash, while Chromium\nreports standard, padded base64. They could only pass for URLs whose hash\ncontains no '+' or '/', and fail for the URL the tests use.\n\nThe encoding isn't specified yet, as the spec PR doesn't define urlHash, so\nexpect the format Chromium reports. It can be used unchanged in a\nurl-hash-source, as the spec PR matches hashes against their standard, padded\nbase64 encoding.\n\nSpec PR: https://github.com/w3c/webappsec-csp/pull/784\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337041\n", "files": ["testing/web-platform/tests/content-security-policy/script-src/tentative/script-url-blocked-report-contains-hash-dedicated-worker.https.html", "testing/web-platform/tests/content-security-policy/script-src/tentative/script-url-blocked-report-contains-hash-service-worker.https.html", "testing/web-platform/tests/content-security-policy/script-src/tentative/script-url-blocked-report-contains-hash-shared-worker.https.html", "testing/web-platform/tests/content-security-policy/script-src/tentative/script-url-blocked-report-contains-hash.https.html", "testing/web-platform/tests/content-security-policy/script-src/tentative/support/util.js"], "git_node": "bd11a08e83c00eab8fe18d7a77be75f867d543aa", "git_parents": ["972f6cd4d77cdb6510a0da06fe7f36671afbf27d"], "node": "6b2790e603c89e144045d9ec34f7d87613a093cd", "parents": ["b98f3938f0fb18f74acec4de509a957c0c756d55"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080208 - Write robustcheckout perfherder data to UPLOAD_DIR. r=taskgraph-reviewers,ahal\n\nPerfherder ingests perfherder-data artifacts instead of parsing task logs.\nDepends on robustcheckout's --perfherderoutput option (bug 2080201).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336225\n", "files": ["taskcluster/scripts/run-task"], "git_node": "981968693f39bba92dca5ac0271f28b952421f7a", "git_parents": ["bd11a08e83c00eab8fe18d7a77be75f867d543aa"], "node": "a7e4a3fe1b6a0a666dd5af33947fe312c7260092", "parents": ["6b2790e603c89e144045d9ec34f7d87613a093cd"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2079881 - Part 1: Add ResolvedBindingObject::BindingNameType. r=jonco\n\nResolveExport can return String, NAMESPACE or DEFERRED-NAMESPACE in\n[[BindingName]], this patch adds a BindingNameType in ResolvedBindingObject to\nindicate the type of the [[BindingName]].\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338245\n", "files": ["js/src/builtin/ModuleObject.cpp", "js/src/builtin/ModuleObject.h", "js/src/vm/Modules.cpp"], "git_node": "4b674cec411df5772adb0943c557c4cc473ee448", "git_parents": ["981968693f39bba92dca5ac0271f28b952421f7a"], "node": "82b7ddac5905ab53e9eaa5b5e19734564907e0a9", "parents": ["a7e4a3fe1b6a0a666dd5af33947fe312c7260092"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2079881 - Part 2: Add resolveExport to ShellModuleObjectWrapper. r=jonco\n\nAdd a resolveExport function to ShellModuleObjectWrapper, the function returns\na ResolvedBindingObject, which can be used to verify the type and the value of\n[[BindingName]] of Resolved Binding Record returned from ResolveExport.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338246\n", "files": ["js/src/jit-test/tests/modules/namespace-reserved-export-names.js", "js/src/jit-test/tests/modules/resolve-export-binding-name.js", "js/src/shell/ShellModuleObjectWrapper.cpp"], "git_node": "f2d7ed231b83304e180ec29681f2e3b11d4f51c5", "git_parents": ["4b674cec411df5772adb0943c557c4cc473ee448"], "node": "ce62ff0c11276a038abdb38c9ed2cf9a2f9c678e", "parents": ["82b7ddac5905ab53e9eaa5b5e19734564907e0a9"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2079881 - Part 3: Add createSyntheticModule to the JS shell. r=jonco\n\nSynthetic Module Records can have arbitrary [[ExportNames]].\nSee https://tc39.es/ecma262/#table-synthetic-module-record-fields\n\nAdd a createSyntheticModule test function in the JS shell to simulate export\narbitrary names from a synthetic module or a wasm modules.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338247\n", "files": ["js/src/jit-test/tests/modules/synthetic-module-namespace-ambiguity.js", "js/src/jit-test/tests/modules/synthetic-module-resolve-export.js", "js/src/shell/js.cpp"], "git_node": "c87eee4ab11c1193514ad2fc32807d84c90b1d43", "git_parents": ["f2d7ed231b83304e180ec29681f2e3b11d4f51c5"], "node": "4da0efb782eb21ca0a6f0fc1da1747e23cada6db", "parents": ["ce62ff0c11276a038abdb38c9ed2cf9a2f9c678e"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2079881 - Part 4: Store the namespace objects in ModuleEnvironmentObject. r=jonco\n\nNamespace objects were stored in properties named *namespace* and\n*deferred-namespace*, which could collide with export names of synthetic and\nwasm modules. Store them in reserved slots instead, and bind to the slots\ndirectly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338248\n", "files": ["js/src/builtin/ModuleObject.cpp", "js/src/builtin/ModuleObject.h", "js/src/jit-test/modules/export-namespace-wasm.js", "js/src/jit-test/modules/exports-namespace-name.wasm", "js/src/jit-test/modules/exports-namespace-name.wat", "js/src/jit-test/tests/modules/namespace-reserved-slots.js", "js/src/jit-test/tests/modules/synthetic-module-deferred-namespace.js", "js/src/jit-test/tests/modules/synthetic-module-namespace-export-name.js", "js/src/jit-test/tests/modules/wasm-eval-phase-namespace-export-name.js", "js/src/vm/EnvironmentObject.cpp", "js/src/vm/EnvironmentObject.h", "js/src/vm/Modules.cpp", "js/src/vm/Scope.cpp"], "git_node": "b0402004010301a6d82e59bdb01c4ed686fa130d", "git_parents": ["c87eee4ab11c1193514ad2fc32807d84c90b1d43"], "node": "700a75da3c430753641e3267c68192aa48bcc600", "parents": ["4da0efb782eb21ca0a6f0fc1da1747e23cada6db"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2079881 - Part 5: Remove the *namespace* pseudo-bindings from module scopes. r=jonco\n\nThe namespace objects of a module are now stored in reserved slots of its\nenvironment, so the *namespace* and *deferred-namespace* bindings that the\nparser declared in every module scope are no longer used.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339878\n", "files": ["js/src/frontend/Parser.cpp", "js/src/jit-test/tests/modules/namespace-reserved-slots.js", "js/src/shell/js.cpp", "js/src/vm/CommonPropertyNames.h", "js/src/vm/EnvironmentObject.cpp"], "git_node": "e2e7d67bc6bace936b4a2c0f5c05934081a9e6a7", "git_parents": ["b0402004010301a6d82e59bdb01c4ed686fa130d"], "node": "8bf9fe6fca954244fa2d41fa73fbe8bee894fa40", "parents": ["700a75da3c430753641e3267c68192aa48bcc600"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2079881 - Part 6: Throw a LinkError for namespace imports in WasmModuleExecute. r=dminor\n\nThe spec doesn't handle the case when the [[BindingName]] is ~namespace~,\nSee https://github.com/WebAssembly/esm-integration/issues/127.\n\nThrows an exception first to prvent hitting assertion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339879\n", "files": ["js/public/friend/ErrorNumbers.msg", "js/src/jit-test/modules/namespace-import-deferredNs.wasm", "js/src/jit-test/modules/namespace-import-deferredNs.wat", "js/src/jit-test/modules/namespace-import-jsNs.wasm", "js/src/jit-test/modules/namespace-import-jsNs.wat", "js/src/jit-test/modules/namespace-import-reexport.js", "js/src/jit-test/modules/namespace-import-target.js", "js/src/jit-test/modules/namespace-import-target.wasm", "js/src/jit-test/modules/namespace-import-target.wat", "js/src/jit-test/modules/namespace-import-wasmNs.wasm", "js/src/jit-test/modules/namespace-import-wasmNs.wat", "js/src/jit-test/tests/modules/wasm-eval-phase-namespace-import.js", "js/src/wasm/WasmJS.cpp"], "git_node": "66b11b285564087a742232046e67051f765c1d3c", "git_parents": ["e2e7d67bc6bace936b4a2c0f5c05934081a9e6a7"], "node": "d603d8d725867ee70979895f0dba8fab66b4969e", "parents": ["8bf9fe6fca954244fa2d41fa73fbe8bee894fa40"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084649 - Track the embedding frameloader in BrowserParent. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340308\n", "files": ["docshell/shistory/nsSHistory.cpp", "dom/base/nsFrameLoader.cpp", "dom/base/nsFrameLoader.h", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "09e02cb64d94b3b74848fd38771276a68d6546c5", "git_parents": ["66b11b285564087a742232046e67051f765c1d3c"], "node": "b4f17d9c4270ddef7e2839b65fccb014b1b718c3", "parents": ["d603d8d725867ee70979895f0dba8fab66b4969e"], "tags": []}, {"author": "Manuel Bucher \u003cmanuel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064457 - Copy Clean Link: Use schemelessSites rules instead of hosts where possible r=timhuang\n\nAlso fix shopee.vn domain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340459\n", "files": ["toolkit/components/antitracking/StripOnShareLists/LGPL/StripOnShareLGPL.json", "toolkit/components/antitracking/StripOnShareLists/MPL2/StripOnShare.json"], "git_node": "3ee2103f63d355a42e58899a27b6b0483716c9d9", "git_parents": ["09e02cb64d94b3b74848fd38771276a68d6546c5"], "node": "b276f461838c28d635aaa11821b83a0ccb383554", "parents": ["b4f17d9c4270ddef7e2839b65fccb014b1b718c3"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090855 - Null-check PromiseObj in ToJSValue. r=farre,arai,saschanaz\n\nPromise::CreateInfallible mentions that it can leave mPromiseObj null.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338807\n", "files": ["dom/bindings/ToJSValue.cpp"], "git_node": "4f73cee18f65aaaa09061f69bab454b3bfb1e4e0", "git_parents": ["3ee2103f63d355a42e58899a27b6b0483716c9d9"], "node": "c349b4fbd7a24471d056b4fd6eb6603d9ddd3507", "parents": ["b276f461838c28d635aaa11821b83a0ccb383554"], "tags": []}, {"author": "Arne Fucks \u003cafucks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087972 - Don't wipe persistent alt-svc cache when closing last private window r=mxinden,necko-reviewers,kershaw\n\nThe nsIDataStorage also listens to last-pb-context-exited and clears the\nprivate storage. Clearing the alt-svc mappings in nsHttpHandler was\ntherefore redundant and removed more entries than necessary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340967\n", "files": ["netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/test/unit/test_altsvc_cache_last-pb-context-exited.js", "netwerk/test/unit/test_bug1948203.js", "netwerk/test/unit/test_coaleasing_h2_and_h3_connection.js", "netwerk/test/unit/test_http3_alt_svc.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "03b0ffd9618437a4c12d27cb46f985256a035426", "git_parents": ["4f73cee18f65aaaa09061f69bab454b3bfb1e4e0"], "node": "5afe120376c6c220af3fc56cae43ff70cb75bfca", "parents": ["c349b4fbd7a24471d056b4fd6eb6603d9ddd3507"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1975964 - Clear the HTTP cache after browser_net_cached-status.js, r=devtools-reviewers,nchevobbe.\n\nThe test expects its first batch of requests to miss the cache, so a second run in the same browser failed on responses cached by the first run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340942\n", "files": ["devtools/client/netmonitor/test/browser_net_cached-status.js"], "git_node": "0c874d5d768cc5b129d81a52639bacea2451362d", "git_parents": ["03b0ffd9618437a4c12d27cb46f985256a035426"], "node": "6e5ef128b747187d0a5ef030e187f30da8a61be0", "parents": ["5afe120376c6c220af3fc56cae43ff70cb75bfca"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086525 - Remove the \u003cimg\u003e file browser_networkobserver_localMode.js writes, r=devtools-reviewers,nchevobbe.\n\nLeft in the local-mode folder, it is listed before test.html, so the test fails when run again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340943\n", "files": ["devtools/shared/network-observer/test/browser/browser_networkobserver_localMode.js"], "git_node": "13970c160e0fd40c0d45f97936fce55fab533e1b", "git_parents": ["0c874d5d768cc5b129d81a52639bacea2451362d"], "node": "4c9bcb4752c66ecaf1cc1d54738212f79dfe7041", "parents": ["6e5ef128b747187d0a5ef030e187f30da8a61be0"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2090968 - Reset the browser window resolution after browser_viewport_resolution_restore.js, r=devtools-reviewers,nchevobbe.\n\nThe test sets the resolution of the browser window holding the tab and never restores it, so the last case's 1.1 leaks into the next run of the test, whose first case expects 1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340944\n", "files": ["devtools/client/responsive/test/browser/browser_viewport_resolution_restore.js"], "git_node": "f50ab3f44ef1e41a6ca8491a29be32c7748925b4", "git_parents": ["13970c160e0fd40c0d45f97936fce55fab533e1b"], "node": "5b2de7e114dfa58ddbcf944e736e0db75f39e448", "parents": ["4c9bcb4752c66ecaf1cc1d54738212f79dfe7041"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2090970 - Reset the Browser Console session state at the end of browser_console_restore.js, r=devtools-reviewers,nchevobbe.\n\nThe test stored a true session state while the Browser Console was open and left it in BrowserConsoleManager, so a second run of the test in the same browser failed its first check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340945\n", "files": ["devtools/client/webconsole/test/browser/browser_console_restore.js"], "git_node": "814f48c04f811337926f85476706463a68ae8c70", "git_parents": ["f50ab3f44ef1e41a6ca8491a29be32c7748925b4"], "node": "c0ace18088efc5ad8bc16872ea03fdb5a8a9d169", "parents": ["5b2de7e114dfa58ddbcf944e736e0db75f39e448"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085954 - Added source extra for out-of-app telemetry by emitting ListenToPageFacts r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340152\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/facts/ListenToPageFacts.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionService.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/SessionPlayer.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/SessionPlayerTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/listentopage/ListenToPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/listentopage/ListenToPageTelemetryMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/listentopage/ListenToPageTelemetryMiddlewareTest.kt"], "git_node": "01875fd017d1a245762f87341db5e25ecf2d3b1a", "git_parents": ["814f48c04f811337926f85476706463a68ae8c70"], "node": "00750aa0e9bb5c7b3e84830b55bd2cb987f5c6e6", "parents": ["c0ace18088efc5ad8bc16872ea03fdb5a8a9d169"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071819 - turn obfuscation on in Fenix. r=mcarare\n\nby removing -dontobfuscate.\n\nNB Fenix now has the broadest possible keep rule to allow us to retain its full class and function names in stack traces for now. We can work on this to narrow the rule to what is really required and further improve performance.\n\n[here is a green try, updated after rebase and rule tweak to retain other r8 optimisation in fenix](https://treeherder.mozilla.org/jobs?repo=try&revision=37f18896f408a5885b30b518889390c58a7f877e)\n(i rebased to try and get rid of the noise in the pr bots, which has nothing to do with this change, but it didn't work \ud83e\udd72 )\n\n[perf compare running here](https://perf.compare/compare-lando-results?landoInstance=lando-prod-2025&baseLando=116720&newLando=116918&baseRepo=try&newRepo=try&framework=15&initialized=1) - expecting this to be neutral (due to current broad keep rule).\n\nthis pr brings apk size down 0.8MB though, which is nice\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/438\n", "files": ["mobile/android/fenix/app/proguard-rules.pro"], "git_node": "7aaa812fd8f3435c96ea278e393544a353f196e3", "git_parents": ["01875fd017d1a245762f87341db5e25ecf2d3b1a"], "node": "b3e4771190d03185185b0783b20aa24554d0953a", "parents": ["00750aa0e9bb5c7b3e84830b55bd2cb987f5c6e6"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074787 - Use HTTPS RR for WebSocket upgrades without Happy Eyeballs, r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333251\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/test/unit/test_websocket_ech.js", "netwerk/test/unit/xpcshell.toml", "security/manager/ssl/tests/unit/tlsserver/cmd/EncryptedClientHelloServer.cpp"], "git_node": "a4407469d0266a0a6eb5b20dbe0b2f7330378d6f", "git_parents": ["7aaa812fd8f3435c96ea278e393544a353f196e3"], "node": "e0673a1ccf1cf367250c95c06fa7b2b1c0ad6020", "parents": ["b3e4771190d03185185b0783b20aa24554d0953a"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088915 - Fix on open behavior for the mini window toolbar. r=kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339524\n", "files": ["browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowChild.sys.mjs", "browser/components/miniwindow/MiniWindowParent.sys.mjs", "browser/components/miniwindow/test/browser/browser_framing.js", "browser/components/miniwindow/test/browser/browser_reveal.js"], "git_node": "cf322867984def3d71b0d5499a7dae23f272be8c", "git_parents": ["a4407469d0266a0a6eb5b20dbe0b2f7330378d6f"], "node": "08046707e0162c04613d7983f2d7dc8ea85530d5", "parents": ["e0673a1ccf1cf367250c95c06fa7b2b1c0ad6020"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1821615 - Part 1: Add an innerHTML fast path for a small subset of HTML. r=hsivonen\n\nSimple markup whose tags trigger no implied end tags, foster parenting or\nadoption agency doesn't need the full parser's state machine and tree\nbuilder. The fast path validates all of the input before it creates any node,\nso a rejected input leaves the target untouched for the full parser. It is\ncontrolled by dom.html_fragment_fast_path.enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337962\n", "files": ["dom/base/FragmentOrElement.cpp", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/base/nsDOMWindowUtils.cpp", "dom/base/test/mochitest.toml", "dom/base/test/test_innerHTML_fast_path.html", "dom/base/test/test_innerHTML_fast_path_csp.html", "dom/interfaces/base/nsIDOMWindowUtils.idl", "modules/libpref/init/StaticPrefList.yaml", "parser/html/moz.build", "parser/html/nsHtml5FragmentFastPath.cpp", "parser/html/nsHtml5FragmentFastPath.h", "parser/html/nsHtml5PortabilityHSupplement.h", "parser/html/nsHtml5TokenizerCppSupplement.h", "parser/htmlaccel/gtest/TestHtmlSimd.cpp", "parser/htmlaccel/htmlaccel.h", "parser/htmlaccel/htmlaccelNotInline.cpp", "parser/htmlaccel/htmlaccelNotInline.h", "tools/clang-tidy/config.yaml"], "git_node": "7c96f4edc464c90f0709bad0fa2ace8e2c4e9eb6", "git_parents": ["cf322867984def3d71b0d5499a7dae23f272be8c"], "node": "8c9e4088c721448496618f3775c98ba26f27b187", "parents": ["08046707e0162c04613d7983f2d7dc8ea85530d5"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1821615 - Part 2: Support comments in the innerHTML fast path. r=hsivonen\n\nComments don't trigger any tree builder fix-up in the supported contexts, and\ntemplates commonly contain them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337963\n", "files": ["dom/base/test/test_innerHTML_fast_path.html", "parser/html/nsHtml5FragmentFastPath.cpp", "parser/html/nsHtml5FragmentFastPath.h"], "git_node": "ce59520d12062e460c541c403c0e0340385bade1", "git_parents": ["7c96f4edc464c90f0709bad0fa2ace8e2c4e9eb6"], "node": "0c1ff3ff67526f52a0b510dbafb6627edac25068", "parents": ["8c9e4088c721448496618f3775c98ba26f27b187"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1821615 - Part 3: Support character references in the innerHTML fast path. r=hsivonen\n\nOnly the references whose decoding doesn't depend on the context are decoded.\nThe full parser handles the rest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337964\n", "files": ["dom/base/test/test_innerHTML_fast_path.html", "parser/html/nsHtml5FragmentFastPath.cpp", "parser/html/nsHtml5FragmentFastPath.h"], "git_node": "f85cfec9373dc1801ebdce0fdf29a8362cf2260f", "git_parents": ["ce59520d12062e460c541c403c0e0340385bade1"], "node": "d5cd9f6cb4db2d6ad59220536cf6ba595ec5475f", "parents": ["0c1ff3ff67526f52a0b510dbafb6627edac25068"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1821615 - Part 4: Use the innerHTML fast path for DOMParser documents. r=hsivonen\n\nInput that is only body content after optional whitespace parses into the\nbody that the full parser would create, in quirks mode as without a doctype.\nPages that render through DOMParser.parseFromString() benefit like innerHTML\ndoes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337965\n", "files": ["dom/base/DOMParser.cpp", "dom/base/test/test_innerHTML_fast_path.html", "parser/html/nsHtml5FragmentFastPath.cpp", "parser/html/nsHtml5FragmentFastPath.h"], "git_node": "7069e7ad57cd8f34bc306bc44d0588ef9d65c5ab", "git_parents": ["f85cfec9373dc1801ebdce0fdf29a8362cf2260f"], "node": "7592c5290bb3c7cbedb0af5d360ab448ee7915a2", "parents": ["d5cd9f6cb4db2d6ad59220536cf6ba595ec5475f"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1821615 - Part 5: Add telemetry for the innerHTML fast path. r=hsivonen\n\nUse counters record whether innerHTML and DOMParser input was parsed by the\nfast path or left to the full parser. Sampled timing distributions, labeled by\nthat outcome and the input length, show what the fast path saves and what a\nrejection costs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337966\n", "files": ["dom/base/DOMParser.cpp", "dom/base/FragmentOrElement.cpp", "dom/base/UseCounters.conf", "dom/base/test/browser.toml", "dom/base/test/browser_fragment_parsing_telemetry.js", "dom/base/test/browser_use_counters.js", "dom/base/test/file_use_counter_domparser_fast_path.html", "dom/base/test/file_use_counter_innerhtml_fast_path.html", "dom/base/use_counter_metrics.yaml", "dom/metrics.yaml", "modules/libpref/init/StaticPrefList.yaml", "parser/html/nsHtml5FragmentFastPath.cpp", "parser/html/nsHtml5FragmentFastPath.h"], "git_node": "f21a58abf7f81c16fc2deddb974cb073f9053f40", "git_parents": ["7069e7ad57cd8f34bc306bc44d0588ef9d65c5ab"], "node": "96f2562cf123d2282d3d0baf92f1baed5e9fafcf", "parents": ["7592c5290bb3c7cbedb0af5d360ab448ee7915a2"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2089592 - Deal with replicated frames in CharacterDataChanged. r=jfkthame,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341301\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/base/nsCSSFrameConstructor.h"], "git_node": "8dc7ad9a543e87be4f08c2c0ac31e08aa05c095b", "git_parents": ["f21a58abf7f81c16fc2deddb974cb073f9053f40"], "node": "8fdb1d1dba421923e90cd3af8e3de811d0e2bff9", "parents": ["96f2562cf123d2282d3d0baf92f1baed5e9fafcf"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083604 - Don't warn when canceling a non-cancelable imgRequestProxy. r=gfx-reviewers,wsmind\n\nCSS image requests are non-cancelable but remain in the document's load group,\nso this happened every time a load group with CSS images was canceled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335260\n", "files": ["image/imgRequestProxy.cpp"], "git_node": "dfa70e911f7742c97b8f8cdc609f2749df40ce5b", "git_parents": ["8dc7ad9a543e87be4f08c2c0ac31e08aa05c095b"], "node": "52919f7b598b5ebbdecd7d435eb35fbcd3ec10b5", "parents": ["8fdb1d1dba421923e90cd3af8e3de811d0e2bff9"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089672 - Don't reuse the parent's bugbug connections in forked children. r=taskgraph-reviewers,bhearsum\n\nTaskgraph forks a process per kind, and the children inherited the cached\nbugbug session, and the keep-alive connections pooled in it, from the\nparent. Children polling bugbug at the same time then shared a socket,\nfailing with ChunkedEncodingError or connection resets.\n\nClear the get_session cache after fork in the child, as taskgraph does for\nits own sessions since bug 2088960.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340292\n", "files": ["taskcluster/gecko_taskgraph/test/test_util_bugbug.py", "taskcluster/gecko_taskgraph/util/bugbug.py"], "git_node": "9071e10934dbc3e858edaf6992e3ae15aaed6d52", "git_parents": ["dfa70e911f7742c97b8f8cdc609f2749df40ce5b"], "node": "26b4cbf4b9bd7feeeecef097bfef40ea3d992dec", "parents": ["52919f7b598b5ebbdecd7d435eb35fbcd3ec10b5"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089560 - part 1: Add Rocky Linux 8 and 10 images and install tests r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340371\n", "files": ["taskcluster/docker/el-base/Dockerfile", "taskcluster/docker/el-raw/Dockerfile", "taskcluster/kinds/docker-image/kind.yml", "taskcluster/kinds/linux-install-test/kind.yml"], "git_node": "85db553bdc8931cb6dd00be2ad07ae70b623028b", "git_parents": ["9071e10934dbc3e858edaf6992e3ae15aaed6d52"], "node": "3162c675938cc58e10ea127809e8f8835dafd759", "parents": ["26b4cbf4b9bd7feeeecef097bfef40ea3d992dec"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089560 - part 2: Add AlmaLinux 8.10 and 10.2 images and install tests r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340372\n", "files": ["taskcluster/kinds/docker-image/kind.yml", "taskcluster/kinds/linux-install-test/kind.yml"], "git_node": "8805ec08e9f979a6a1bc18283b88be3a576c5787", "git_parents": ["85db553bdc8931cb6dd00be2ad07ae70b623028b"], "node": "589f6a764134da54db29fd1029799caefa0383b8", "parents": ["3162c675938cc58e10ea127809e8f8835dafd759"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071042 - disable test_gfx_sanity_gpu.html for causing frequent failures. r=intermittent-reviewers,aryx DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341268\n", "files": ["dom/media/test/mochitest.toml"], "git_node": "3d467268ed5ae4ac0de24c96056c05c4863e780d", "git_parents": ["8805ec08e9f979a6a1bc18283b88be3a576c5787"], "node": "d10235d3169721876084b7fc7b2189295737f0b8", "parents": ["589f6a764134da54db29fd1029799caefa0383b8"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2091317 - Upgrade node toolchains to versions that deal with the eMudhra root certificates situation. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341306\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "621d2a8635c960481982da4ad023980c8f27817f", "git_parents": ["3d467268ed5ae4ac0de24c96056c05c4863e780d"], "node": "00513d6e8c64e5482a8142a6347dec653b07f6e6", "parents": ["d10235d3169721876084b7fc7b2189295737f0b8"], "tags": []}, {"author": "Daniel Adams \u003cmsub2official@gmail.com\u003e", "branch": "default", "desc": "Bug 2090338 - Don't resolve `none` origin components to 0 outside of calculation. r=firefox-style-system-reviewers,emilio\n\nSigned-off-by: Daniel Adams \u003cmsub2official@gmail.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340555\n", "files": ["servo/components/style/color/component.rs", "testing/web-platform/meta/css/css-color/parsing/alpha-color-computed.html.ini", "testing/web-platform/meta/css/css-color/parsing/color-computed-none.html.ini", "testing/web-platform/meta/css/css-color/parsing/color-computed-powerless.html.ini", "testing/web-platform/meta/css/css-color/parsing/color-computed-relative-color.html.ini"], "git_node": "6e1c28011e75d845e3d3c81fc219180c18b19d86", "git_parents": ["621d2a8635c960481982da4ad023980c8f27817f"], "node": "17af85e503b16366c8d0bad1acb4e3708a932056", "parents": ["00513d6e8c64e5482a8142a6347dec653b07f6e6"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2089560 - part 2: Add AlmaLinux 8.10 and 10.2 images and install tests r=taskgraph-reviewers,bhearsum\" for causing alma failures.\n\nThis reverts commit 8805ec08e9f979a6a1bc18283b88be3a576c5787.\n\nRevert \"Bug 2089560 - part 1: Add Rocky Linux 8 and 10 images and install tests r=taskgraph-reviewers,bhearsum\"\n\nThis reverts commit 85db553bdc8931cb6dd00be2ad07ae70b623028b.\n", "files": ["taskcluster/docker/el-base/Dockerfile", "taskcluster/docker/el-raw/Dockerfile", "taskcluster/kinds/docker-image/kind.yml", "taskcluster/kinds/linux-install-test/kind.yml"], "git_node": "289da24d36f645022a415dd6363ed2f7634fcabd", "git_parents": ["6e1c28011e75d845e3d3c81fc219180c18b19d86"], "node": "12dd37c7ea2d8788ac1126e3823633897022c322", "parents": ["17af85e503b16366c8d0bad1acb4e3708a932056"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090749 - Treat access from trusted sources to resource:// the same as chrome://. r=tschuster\n\nThis allows removing a bunch of resource:// stuff from being\ncontentaccessible=true.\n\nRemove the \"always contentaccessible pref\" while at it, replacing\nthe tests by content accessible resource files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339318\n", "files": ["browser/components/resistfingerprinting/test/mochitest/test_bug863246_resource_uri.html", "caps/nsScriptSecurityManager.cpp", "caps/tests/mochitest/test_bug292789.html", "dom/security/test/mixedcontentblocker/file_main_bug803225.html", "dom/security/test/mixedcontentblocker/test_bug803225.html", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "f9b0bce88f71886c77535acad0a988076581f1fc", "git_parents": ["289da24d36f645022a415dd6363ed2f7634fcabd"], "node": "df87ede4136335275453b17b6e8400fb1ac2349d", "parents": ["12dd37c7ea2d8788ac1126e3823633897022c322"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 1937911 - Use config search engines in browser_searchModeSwitcher_basic.js. r=urlbar-reviewers,jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338361\n", "files": ["browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js"], "git_node": "c9ac33ee346c2081fce61ab47bf96836de63da92", "git_parents": ["f9b0bce88f71886c77535acad0a988076581f1fc"], "node": "211b8aca57a4cbb9018ae805f51b725f34333892", "parents": ["df87ede4136335275453b17b6e8400fb1ac2349d"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 1937911 - Split out icon tests from browser_searchModeSwitcher_basic.js. r=urlbar-reviewers,jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338362\n", "files": ["browser/components/urlbar/tests/browser-searchMode/browser.toml", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_icon.js"], "git_node": "3207db8c1654152e4099d9bff8d1ab92fd3c39e6", "git_parents": ["c9ac33ee346c2081fce61ab47bf96836de63da92"], "node": "0b7ff481ea75d695d96b30d2ad1824375e5b397f", "parents": ["211b8aca57a4cbb9018ae805f51b725f34333892"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 1937911 - Split out keyboard shortcut tests from browser_searchModeSwitcher_basic.js. r=urlbar-reviewers,jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338363\n", "files": ["browser/components/touchbar/tests/browser/browser_touchbar_searchrestrictions.js", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-searchMode/browser.toml", "browser/components/urlbar/tests/browser-searchMode/browser_addonsShortcutMoved.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_keyboardShortcuts.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_telemetry.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_addEngine.js"], "git_node": "cc7cc81fe0945f6a9cfcc487e4d2f9e1b267ab5e", "git_parents": ["3207db8c1654152e4099d9bff8d1ab92fd3c39e6"], "node": "5d5b0a65a3b3a42b6ec2eafcc1f8b3d8617e868e", "parents": ["0b7ff481ea75d695d96b30d2ad1824375e5b397f"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087567 - Fix stale suggestions when switching searchmodes with accel+down on an empty query. r=urlbar-reviewers,jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338364\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_keyboardShortcuts.js"], "git_node": "073f1a81ee5058c5379c050bf0d6fe1800bf517f", "git_parents": ["cc7cc81fe0945f6a9cfcc487e4d2f9e1b267ab5e"], "node": "85ffcecd0c0b97119018a6331e48b49f086be620", "parents": ["5d5b0a65a3b3a42b6ec2eafcc1f8b3d8617e868e"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087572 - Always recalculate selected index in the search mode switcher so it's never out of sync. r=urlbar-reviewers,jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338365\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_keyboardShortcuts.js"], "git_node": "f8a068a57c853bdccffac088dfe917bf33be69df", "git_parents": ["073f1a81ee5058c5379c050bf0d6fe1800bf517f"], "node": "fd1df3b05ac3f77f78b6ff3a078f667c1525724b", "parents": ["85ffcecd0c0b97119018a6331e48b49f086be620"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086672 - Compile Linux's clang-tidy with PGO on r=glandium\n\nWe reuse clang(s profile to avoid extra computation. This only affects\nlibclang and libLLVM, but it already adds a decent speedup:\n\n    % hyperfine -r30 --parameter-list clang_tidy  /tmp/clang-tidy/bin/clang-tidy,$HOME/.mozbuild/clang-tools/clang-tidy/bin/clang-tidy '{clang_tidy} ~/sources/sqlite-bench/sqlite3.c \"--checks=bugprone-*\"'\n    Benchmark 1: /tmp/clang-tidy/bin/clang-tidy ~/sources/sqlite-bench/sqlite3.c \"--checks=bugprone-*\"\n      Time (mean \u00b1 \u03c3):      2.751 s \u00b1  0.056 s    [User: 2.703 s, System: 0.036 s]\n      Range (min \u2026 max):    2.472 s \u2026  2.788 s    30 runs\n\n      Warning: Statistical outliers were detected. Consider re-running this benchmark on a quiet system without any interferences from other programs. It might help to use the '--warmup' or '--prepare' options.\n\n    Benchmark 2: /home/ssp/.mozbuild/clang-tools/clang-tidy/bin/clang-tidy ~/sources/sqlite-bench/sqlite3.c \"--checks=bugprone-*\"\n      Time (mean \u00b1 \u03c3):      2.893 s \u00b1  0.023 s    [User: 2.840 s, System: 0.038 s]\n      Range (min \u2026 max):    2.863 s \u2026  2.998 s    30 runs\n\n      Warning: Statistical outliers were detected. Consider re-running this benchmark on a quiet system without any interferences from other programs. It might help to use the '--warmup' or '--prepare' options.\n\n    Summary\n      /tmp/clang-tidy/bin/clang-tidy ~/sources/sqlite-bench/sqlite3.c \"--checks=bugprone-*\" ran\n        1.05 \u00b1 0.02 times faster than /home/ssp/.mozbuild/clang-tools/clang-tidy/bin/clang-tidy ~/sources/sqlite-bench/sqlite3.c \"--checks=bugprone-*\"\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337658\n", "files": ["build/build-clang/stage-4-tidy-pgo.json", "taskcluster/kinds/toolchain/clang-tidy.yml"], "git_node": "27727f7649bbed8073acbdfc22255159e23d7081", "git_parents": ["f8a068a57c853bdccffac088dfe917bf33be69df"], "node": "213be0048645715e9682aaff2bf4e1ac8c46674b", "parents": ["fd1df3b05ac3f77f78b6ff3a078f667c1525724b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2088658. r=layout-reviewers,jwatt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341305\n", "files": ["layout/base/nsCSSFrameConstructor.cpp"], "git_node": "ecfefc26378fc58b77cc98ab06e8001889149ff8", "git_parents": ["27727f7649bbed8073acbdfc22255159e23d7081"], "node": "203146128b588e8e0257088375b0147a23cd5831", "parents": ["213be0048645715e9682aaff2bf4e1ac8c46674b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090749 - Annotate one failure.\n", "files": ["testing/web-platform/meta/css/css-color/parsing/color-computed-powerless.html.ini"], "git_node": "3201797f3472b1520198691decb7ff2764d3da61", "git_parents": ["ecfefc26378fc58b77cc98ab06e8001889149ff8"], "node": "743b820d3c1b777563f2346837884495230eb32f", "parents": ["203146128b588e8e0257088375b0147a23cd5831"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049024 - Remove the unused dialog button widget from Settings r=settings-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341010\n", "files": ["browser/components/preferences/jar.mn", "browser/components/preferences/preferences.xhtml", "browser/components/preferences/widgets/dialog-button/dialog-button.mjs", "browser/components/preferences/widgets/dialog-button/dialog-button.stories.mjs", "browser/components/preferences/widgets/setting-group/setting-group.mjs", "browser/modules/BrowserUsageTelemetry.sys.mjs"], "git_node": "a1dec2d8a19c8d10080fce160cf9af644f937cfb", "git_parents": ["3201797f3472b1520198691decb7ff2764d3da61"], "node": "b875a85b181c0f678552cc5074b536fa205943d8", "parents": ["743b820d3c1b777563f2346837884495230eb32f"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091328 - Bump webspec-index to 0.15.0. r=ai4dev-reviewers,marco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341320\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "71e1599a297bfa8407b671976e1c2ad875e0edff", "git_parents": ["a1dec2d8a19c8d10080fce160cf9af644f937cfb"], "node": "8b34b1d2e03fcc38f8582b4351582c2af09d9dca", "parents": ["b875a85b181c0f678552cc5074b536fa205943d8"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2090982 - Remove the override file written by browser_dbg-overrides.js and wait for the override to be set, r=devtools-reviewers,nchevobbe.\n\nThe file left in the temp directory by the first run made the existence polling pass before DevToolsUtils.saveAs wrote the original content, which then replaced the test's overridden script, so a repeated run never paused.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340946\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-overrides.js"], "git_node": "eecf6fe90329c115d0bdd97e05b82a20b8501a15", "git_parents": ["71e1599a297bfa8407b671976e1c2ad875e0edff"], "node": "3e2363df8fd585745b982fa80dd2f3ec8b138c29", "parents": ["8b34b1d2e03fcc38f8582b4351582c2af09d9dca"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2091316 - Use moz-src for toolkit/components/captivedetect r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341307\n", "files": ["toolkit/components/captivedetect/components.conf", "toolkit/components/captivedetect/moz.build", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "07352761e6343881b0f81569ef9175ad83d9121e", "git_parents": ["eecf6fe90329c115d0bdd97e05b82a20b8501a15"], "node": "b0e8211ac275d11daa91f1e9bf04721bb817a4b9", "parents": ["3e2363df8fd585745b982fa80dd2f3ec8b138c29"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2084526 - Advance past HTTPS AliasMode records with TargetName '.' when decoding. r=necko-reviewers,kershaw\n\nSkipping such a record with `continue` left the index on its RDATA, so the\nrest of the response was parsed at the wrong offset and decoding failed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335910\n", "files": ["netwerk/dns/DNSPacket.cpp", "netwerk/test/gtest/TestDNSPacket.cpp"], "git_node": "8d3c4460047e335748829c5422c937734cdf43fc", "git_parents": ["07352761e6343881b0f81569ef9175ad83d9121e"], "node": "354c1b107a6fed38e0b536a6f5b1637589510185", "parents": ["b0e8211ac275d11daa91f1e9bf04721bb817a4b9"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2084526 - Compare owner names case-insensitively in the Windows native HTTPS RR parser. r=necko-reviewers,jesup\n\nThe CNAME target was lowercased before being compared with strcmp against the\nnext owner name, so following a CNAME to a mixed-case name, or querying a host\nwith a trailing dot, never matched. The record walk is split out of\nResolveHTTPSRecordImpl so it can be unit tested.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335911\n", "files": ["netwerk/dns/DNSPacket.cpp", "netwerk/dns/DNSPacket.h", "netwerk/dns/GetAddrInfo.h", "netwerk/dns/PlatformDNSWin.cpp", "netwerk/test/gtest/TestPlatformDNSWin.cpp", "netwerk/test/gtest/moz.build"], "git_node": "5a1e9e3b8f5c5ca58e5d7c50b959a4f15a72c6f3", "git_parents": ["8d3c4460047e335748829c5422c937734cdf43fc"], "node": "63e1032686441839acd54cc5ba0bda3b87471c9a", "parents": ["354c1b107a6fed38e0b536a6f5b1637589510185"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2084526 - Use the origin host for port-prefixed native HTTPS RR lookups. r=necko-reviewers,jesup\n\nTRR already uses the origin host as the TargetName of ServiceMode records with\nTargetName '.' for port-prefixed names; the native path used the prefixed name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335912\n", "files": ["netwerk/dns/GetAddrInfo.cpp", "netwerk/dns/GetAddrInfo.h", "netwerk/dns/PlatformDNSAndroid.cpp", "netwerk/dns/PlatformDNSMac.cpp", "netwerk/dns/PlatformDNSUnix.cpp", "netwerk/dns/PlatformDNSWin.cpp", "netwerk/dns/nsHostResolver.cpp", "netwerk/test/gtest/TestDNS.cpp", "netwerk/test/gtest/TestPlatformDNSWin.cpp"], "git_node": "a10a4a9056887c4c62159bc924ac5148c7114938", "git_parents": ["5a1e9e3b8f5c5ca58e5d7c50b959a4f15a72c6f3"], "node": "0362ff6f517f40dfae9a9374537e1bf68559d8c2", "parents": ["63e1032686441839acd54cc5ba0bda3b87471c9a"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2084526 - Keep processing DNSServiceQueryRecord replies until the HTTPS RRSet is delivered on macOS. r=necko-reviewers,jesup\n\nWith kDNSServiceFlagsReturnIntermediates the CNAME arrives in its own reply, and\na single DNSServiceProcessResult call returned before the HTTPS records of the\ntarget were delivered.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335913\n", "files": ["netwerk/dns/PlatformDNSMac.cpp", "netwerk/dns/PlatformDNSMac.h", "netwerk/dns/moz.build", "netwerk/test/gtest/TestPlatformDNSMac.cpp", "netwerk/test/gtest/moz.build"], "git_node": "3df94fd4a54d24c349b2c5cb6c7ffbab51d48826", "git_parents": ["a10a4a9056887c4c62159bc924ac5148c7114938"], "node": "4650f302e123d14f02946f8dfe23a78b5ad8f699", "parents": ["0362ff6f517f40dfae9a9374537e1bf68559d8c2"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2084526 - Reinitialize the per-thread resolver state after a network change on Linux. r=necko-reviewers,jesup\n\nThe state initialized by res_ninit keeps the nameservers from resolv.conf, so\nafter a network change native HTTPS queries kept going to the old servers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335914\n", "files": ["netwerk/dns/GetAddrInfo.cpp", "netwerk/dns/GetAddrInfo.h", "netwerk/dns/PlatformDNSUnix.cpp", "netwerk/dns/nsHostResolver.cpp", "netwerk/test/gtest/TestPlatformDNSUnix.cpp", "netwerk/test/gtest/moz.build"], "git_node": "2e3e6d2132a9115695e469336b4c47d5f5e421cd", "git_parents": ["3df94fd4a54d24c349b2c5cb6c7ffbab51d48826"], "node": "b3e3d049fa321baca415078e4d96738e5f8ef7ae", "parents": ["4650f302e123d14f02946f8dfe23a78b5ad8f699"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080757 - Also send opener window id when creating browsing context. r=dom-core-reviewers,hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334022\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "dom/ipc/ContentParent.cpp", "dom/ipc/PContent.ipdl"], "git_node": "e7e8dfa1e01fabf52882fc4fce471b9b2ddae267", "git_parents": ["2e3e6d2132a9115695e469336b4c47d5f5e421cd"], "node": "4bc22f0e95e74c8afa1c2ffe3f059f2e616ee097", "parents": ["b3e3d049fa321baca415078e4d96738e5f8ef7ae"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088110 - Create two new verifyHomeButtonOnNewsPageTest and verifyStoriesSettingTogglesNewsButtonTest regression UI tests r=mobiletest-reviewers,aaronmt\n\nBoth UI tests successfully passed 25x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=117429\nAll efficiency UI tests successfully passed 1x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=117430\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339084\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/HomeScreenRedesignedUITest.kt"], "git_node": "031b6529a696865b3d1aaf6953532eb681e3ae6d", "git_parents": ["e7e8dfa1e01fabf52882fc4fce471b9b2ddae267"], "node": "315d307ec310268608288f1a6880ce23609bc134", "parents": ["4bc22f0e95e74c8afa1c2ffe3f059f2e616ee097"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091265 - Update android nightly application-services version bump to 558e2cde797a312c068ea5d78f876baf92fdb7ca r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341237\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "e09e4d16a2607c63f338bd356ab0ec9b311d5c21", "git_parents": ["031b6529a696865b3d1aaf6953532eb681e3ae6d"], "node": "68b908ccc77ffa7caf4ed1b91797bc1767ca159c", "parents": ["315d307ec310268608288f1a6880ce23609bc134"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2091366 - Update treeherder-cli toolchain to 0.3.2. r=freddyb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341343\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "d40496e8e491968b644380023a0237e110afea12", "git_parents": ["e09e4d16a2607c63f338bd356ab0ec9b311d5c21"], "node": "7dadebe6c8d83652e8cd3d75843c0708635943c9", "parents": ["68b908ccc77ffa7caf4ed1b91797bc1767ca159c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080403 - Ignore the reindent of the four renamed tabbrowser window modules in blame and annotate. r=firefox-desktop-core-reviewers ,mak DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340016\n", "files": [".git-blame-ignore-revs", ".hg-annotate-ignore-revs"], "git_node": "7410be8e0f9d6fe623940d5db66e44a201eabb56", "git_parents": ["d40496e8e491968b644380023a0237e110afea12"], "node": "253a8612bfd9c09d12e64ae755abd5ed