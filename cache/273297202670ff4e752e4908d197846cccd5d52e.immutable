universal-deep-chain-001.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-deep-chain-001.tentative.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-escaped-star.tentative.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-inheritance-001.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-inheritance-001.tentative.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-no-named-rule-001.tentative.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-no-named-rule-002.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-no-named-rule-002.tentative.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-painting-001.tentative.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-painting-002.tentative.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-painting-003.tentative.html.ini", "testing/web-platform/meta/css/css-highlight-api/custom-highlight-universal-parsing-and-computed-style.tentative.html.ini"], "git_node": "27b5087e429094563c2c83fbb032aaeb73cd615b", "git_parents": ["8d1a3bd92f517224a670561032692dbd1f1bbff9"], "node": "c370f90ccd8b38e620f57c6c8699eb64ffe1a143", "parents": ["eee357a4d13b85d5127405fe582b88dacbc28afe"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2078508 [wpt PR 63292] - Deflake orthogonal-parent-shrink-to-fit-001.html, a=testonly\n\nAutomatic update from web-platform-tests\nDeflake orthogonal-parent-shrink-to-fit-001.html\n\nThis patch deflakes the following test:\nwpt/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001.html\n\nThe flakiness is consistently reproducible and is due to not waiting\nfor the Ahem font to be ready. This patch waits for the font to be\nready, which fixes the flakiness.\n\nBug: 568337130, 40382555\nChange-Id: Id05184a1fe542f4db1a8a480613e98f39b09ede7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8515657\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nAuto-Submit: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1711527}\n\n--\nUpdate generator template and regenerate orthogonal-parent-shrink-to-fit tests\n\nUpdate css/css-writing-modes/tools/generators/template.html to wait for\ndocument.fonts.ready using promise_setup and promise_test, and regenerate\northogonal-parent-shrink-to-fit-001a.html through 001x.html to keep them\nin sync with orthogonal-parent-shrink-to-fit-001.html.\n\n--\n\nwpt-commits: 8a19fd26a4d1a2a28a84f7b8467f9483cdf6fd37, c645564b0e57698796f7d2f358fd4b3f238be174\nwpt-pr: 63292\n", "files": ["testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001a.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001b.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001c.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001d.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001e.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001f.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001g.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001h.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001i.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001j.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001k.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001l.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001m.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001n.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001o.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001p.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001q.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001r.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001s.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001t.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001u.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001v.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001w.html", "testing/web-platform/tests/css/css-writing-modes/orthogonal-parent-shrink-to-fit-001x.html", "testing/web-platform/tests/css/css-writing-modes/tools/generators/template.html"], "git_node": "c9cddb896d8d670a8621d2385bf34d97f842f513", "git_parents": ["27b5087e429094563c2c83fbb032aaeb73cd615b"], "node": "4e953ac7fd9896266f9574da817fcbf27291d3c1", "parents": ["c370f90ccd8b38e620f57c6c8699eb64ffe1a143"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078508 [wpt PR 63292] - Update wpt metadata, a=testonly\n\nwpt-pr: 63292\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-writing-modes/forms/text-input-vertical-overflow-no-scroll.html.ini"], "git_node": "5403b947dc83d117bdccc55db9e00d937e073dbd", "git_parents": ["c9cddb896d8d670a8621d2385bf34d97f842f513"], "node": "e1919f9f09ee972dc1bb20514f4d1abfd1174b81", "parents": ["4e953ac7fd9896266f9574da817fcbf27291d3c1"], "tags": []}, {"author": "Mike Wasserman \u003cmsw@chromium.org\u003e", "branch": "default", "desc": "Bug 2084285 [wpt PR 63897] - Built-In AI APIs: Add AbortManager and align DecisionModel, a=testonly\n\nAutomatic update from web-platform-tests\nBuilt-In AI APIs: Add AbortManager and align DecisionModel\n\nAdd AbortManager to manage the session destruction AbortController,\ncreate() AbortSignal listener, and composite per-operation\nAbortSignals.\nAdopt across DecisionModel, AIWritingAssistanceBase, Proofreader,\nTranslator, and LanguageDetector.\n\nAlign DecisionModel abort and destroy behavior with sibling APIs, and\nadd unit and WPT coverage.\n(supersedes https://crrev.com/c/8545313)\n\nBug: 424659255, 468104678, 565849508\nChange-Id: I02147aafd4de6490f1276db1d83141f6ba29012d\n\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8590306\nAuto-Submit: Mike Wasserman \u003cmsw@chromium.org\u003e\nReviewed-by: Jaewon Lee \u003cjaeone@google.com\u003e\nCommit-Queue: Jaewon Lee \u003cjaeone@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1722079}\n\n--\n\nwpt-commits: 99f9ac353e3152b5e3345c111c28a8c426607a6c\nwpt-pr: 63897\n", "files": ["testing/web-platform/tests/ai/decision-model/decision-model.tentative.https.window.js"], "git_node": "12227b5d97ce04d82238043aba6594ab543b7593", "git_parents": ["5403b947dc83d117bdccc55db9e00d937e073dbd"], "node": "45ce4938e915b74f56abf5d87cc3ab0d6e6eb614", "parents": ["e1919f9f09ee972dc1bb20514f4d1abfd1174b81"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084285 [wpt PR 63897] - Update wpt metadata, a=testonly\n\nwpt-pr: 63897\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/ai/decision-model/decision-model.tentative.https.window.js.ini"], "git_node": "8343db703cfe5845b4cc2615c87cd7e222474cfb", "git_parents": ["12227b5d97ce04d82238043aba6594ab543b7593"], "node": "0c4ec8847fd68b07341863103d988b9c28561985", "parents": ["45ce4938e915b74f56abf5d87cc3ab0d6e6eb614"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2085461 [wpt PR 64029] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=328198, a=testonly\n\nAutomatic update from web-platform-tests\nDocuments with a Document-Isolation-Policy are never restored from the back/forward cache\n\nSince 324033@main, with site isolation, a document with a Document-Isolation-Policy is in a\ncross-origin isolated process of a browsing context group that isn't. The back/forward cache kept\nsuch a document as any other, but a back/forward navigation only went to the process of the cached\ndocument if that process had the cross-origin mode of the navigation's group, and a process for\ndocuments with a policy counts as cross-origin isolated. So the navigation went to another process\ninstead. The response's policy then moved it to the group's process for documents with a policy\nfrom that site, which is the cached document's process, and that dropped the cached document and\nloaded it again.\n\nA back/forward navigation now goes to the process of the cached document when that process's\ncross-origin isolation fits the navigation's group, which\nBrowsingContextGroup::canUseProcessForCrossOriginIsolation() decides. A group that isn't\ncross-origin isolated can use a process for documents with a policy, and one that is can't. The\nold checks allowed the latter, though such a group never has one. The same checks without site\nisolation, and the asserts about which processes a group has, now use it too.\n\nChild frames in other processes already came back with their parent, whatever their policy. That\nthey come back before their parent, firing pageshow while the parent is still in the back/forward\ncache, is a separate bug. So the new test asks them about themselves once their parent is back,\nrather than having them report their pageshow event to their parent.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=328198\nWebKit-Canonical-Link: https://commits.webkit.org/324262@main\n\n--\n\nwpt-commits: 929349a7143c3d8093efb8637ba27a0163672dcd\nwpt-pr: 64029\n", "files": ["testing/web-platform/tests/html/document-isolation-policy/back-forward-cache-frames.tentative.https.html", "testing/web-platform/tests/html/document-isolation-policy/back-forward-cache.tentative.https.html", "testing/web-platform/tests/html/document-isolation-policy/resources/back-forward-cache-frame.html"], "git_node": "c31f4aa66e4eefd89bf52a0ff4c9879afcc83e25", "git_parents": ["8343db703cfe5845b4cc2615c87cd7e222474cfb"], "node": "bbbf6e6d2944062829d2a53825dd25d887ce0657", "parents": ["0c4ec8847fd68b07341863103d988b9c28561985"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085461 [wpt PR 64029] - Update wpt metadata, a=testonly\n\nwpt-pr: 64029\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/document-isolation-policy/back-forward-cache-frames.tentative.https.html.ini", "testing/web-platform/meta/html/document-isolation-policy/back-forward-cache.tentative.https.html.ini"], "git_node": "c485f3a6a69bd8da115fb746f179aceb268ba746", "git_parents": ["c31f4aa66e4eefd89bf52a0ff4c9879afcc83e25"], "node": "40a52bd313a30a8d863d36196d7533358fd7f3f3", "parents": ["bbbf6e6d2944062829d2a53825dd25d887ce0657"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2084040 [wpt PR 63890] - Expect outline serialization in width-style-color order, a=testonly\n\nAutomatic update from web-platform-tests\nExpect outline serialization in width-style-color order\n\nCSSWG resolved to align the canonical order of outline with border, and the CSS UI grammar now lists width, style, then color. Update the parsing and declaration-block serialization expectations to follow that order.\n\nPreserve the existing alternatives for omitting default components; this correction only changes the order of components that are retained.\n\nhttps://github.com/w3c/csswg-drafts/issues/7700\nhttps://drafts.csswg.org/css-ui-4/#propdef-outline\n\nCo-authored-by: codex \u003ccodex@openai.com\u003e\n\n--\n\nwpt-commits: 1c7f3a08e2ae9e0b393966541d33bdf8d2603e09\nwpt-pr: 63890\n", "files": ["testing/web-platform/tests/css/css-ui/parsing/outline-valid.html", "testing/web-platform/tests/css/cssom/shorthand-values.html"], "git_node": "3cdb1438da8abdfd86f32cc07d372ddb3e367dde", "git_parents": ["c485f3a6a69bd8da115fb746f179aceb268ba746"], "node": "140483be8e31d6cfdbfaca3a79163b8dfdee2d88", "parents": ["40a52bd313a30a8d863d36196d7533358fd7f3f3"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084040 [wpt PR 63890] - Update wpt metadata, a=testonly\n\nwpt-pr: 63890\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-ui/parsing/outline-valid.html.ini", "testing/web-platform/meta/css/cssom/shorthand-values.html.ini"], "git_node": "12573360bc2ee78572776282fc40d3a18d875395", "git_parents": ["3cdb1438da8abdfd86f32cc07d372ddb3e367dde"], "node": "ad0a108f6c19f5230b9aefa580852d0ae18901e0", "parents": ["140483be8e31d6cfdbfaca3a79163b8dfdee2d88"], "tags": []}, {"author": "Pouneh \u003c55304332+pooneh-nb@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2085463 [wpt PR 64061] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327908, a=testonly\n\nAutomatic update from web-platform-tests\nStorage access should not be inherited by SharedWorkers and ServiceWorkers (#64061)\n\nrdar://158814068 stopped DedicatedWorker requests from using the storage access\ngrant of the page that created them. It only covered dedicated workers, not\nSharedWorkers or ServiceWorkers. The same gap existed for WebSockets\n(rdar://176030553).\n\nI could not reproduce an observable bug for SharedWorker or ServiceWorker. I\nadded WPT tests for both, and they pass without this change: neither worker\nsends the cookie, same as DedicatedWorker. The likely reason is that a Storage\nAccess grant belongs to the page that obtained it, and these workers run on\ntheir own separate page, so the grant does not apply to them.\nSo I flag every worker-initiated request as such, so this no longer depends on that\ndetail. This is hardening only, with no known user-visible change.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327908\nWebKit-Canonical-Link: https://commits.webkit.org/324282@main\n\nCo-authored-by: Pouneh Bahrami \u003cpbahrami@apple.com\u003e\n--\n\nwpt-commits: 87c1c07d75c14973fbbeef7eb3ed4bed7e9b3370\nwpt-pr: 64061\n", "files": ["testing/web-platform/tests/storage-access-api/requestStorageAccess-service-worker.sub.https.tentative.window.js", "testing/web-platform/tests/storage-access-api/requestStorageAccess-shared-worker.sub.https.tentative.window.js", "testing/web-platform/tests/storage-access-api/resources/embedded_service_worker.js", "testing/web-platform/tests/storage-access-api/resources/embedded_shared_worker.js", "testing/web-platform/tests/storage-access-api/resources/embedded_worker_responder.js"], "git_node": "7fd441555aa5f46f4aef2356d44b1267a02d0de4", "git_parents": ["12573360bc2ee78572776282fc40d3a18d875395"], "node": "43da3fefa212bdd3a8c6f1a13289b2b40edd0d13", "parents": ["ad0a108f6c19f5230b9aefa580852d0ae18901e0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085463 [wpt PR 64061] - Update wpt metadata, a=testonly\n\nwpt-pr: 64061\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/storage-access-api/requestStorageAccess-service-worker.sub.https.tentative.window.js.ini", "testing/web-platform/meta/storage-access-api/requestStorageAccess-shared-worker.sub.https.tentative.window.js.ini"], "git_node": "829703ee92fd15ae74ccb3283dd0d8d60df41497", "git_parents": ["7fd441555aa5f46f4aef2356d44b1267a02d0de4"], "node": "15148c7f47f5d02d00fccbaccbf9f757183bcf63", "parents": ["43da3fefa212bdd3a8c6f1a13289b2b40edd0d13"], "tags": []}, {"author": "Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e", "branch": "default", "desc": "Bug 2083854 [wpt PR 63866] - [inline-layout] Add regression WPT for contextual forms, a=testonly\n\nAutomatic update from web-platform-tests\n[inline-layout] Add regression WPT for contextual forms\n\nThe associated bug was a regression in monospace text editing that\nwasn't caught by existing WPT's. Adding a test case so this doesn't\nregress again.\n\nBug: 573312311\nChange-Id: I84733fc2617bfaffa2524d3b11ab6238f2a566fb\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8599928\nCommit-Queue: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1722140}\n\n--\n\nwpt-commits: 1db716ea43c1e072500e0d80b5819cacfe81848c\nwpt-pr: 63866\n", "files": ["testing/web-platform/tests/css/css-text/shaping/monospace-contextual-forms-incremental.html", "testing/web-platform/tests/css/css-text/shaping/reference/monospace-contextual-forms-incremental-ref.html"], "git_node": "a6c8519fa443bc180c34002dde039757927282d6", "git_parents": ["829703ee92fd15ae74ccb3283dd0d8d60df41497"], "node": "fe97b33e33b562deb03b0bd8799ca5de4f4574f9", "parents": ["15148c7f47f5d02d00fccbaccbf9f757183bcf63"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083854 [wpt PR 63866] - Update wpt metadata, a=testonly\n\nwpt-pr: 63866\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-text/shaping/shaping-no-glyphs-crash.html.ini"], "git_node": "caea7ca45c7427ac57418eb1e82682bf2c46fd81", "git_parents": ["a6c8519fa443bc180c34002dde039757927282d6"], "node": "866e000a88d9ff363cdca06c8c2548be2450508c", "parents": ["fe97b33e33b562deb03b0bd8799ca5de4f4574f9"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2082692 [wpt PR 63722] - Remove ForceInertTemplate from ParseHTMLFragment, a=testonly\n\nAutomatic update from web-platform-tests\nRemove ForceInertTemplate from ParseHTMLFragment\n\nNow that StreamingSanitizer creates disallowed elements in the inert\ntemplate document and strips disallowed attributes during tree\nconstruction before custom element upgrade reactions run,\nParseHTMLFragment no longer needs to force an inert template document\nwhen a sanitizer is active.\n\nParsing directly into the context element's document (unless the context\nelement is a \u003ctemplate\u003e) preserves the target's scoped\nCustomElementRegistry and matches the HTML spec's reaction ordering for\nsanitized setHTML() and setHTMLUnsafe().\n\nBug: 491743369, 569832084\nChange-Id: I160dd56857b77ab57677f2827d7c4df21b500c7c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8580486\nReviewed-by: Lauren Winston \u003clwinston@google.com\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nReviewed-by: Daniel Vogelheim \u003cvogelheim@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1722184}\n\n--\n\nwpt-commits: 2bd2d93eff0de0e2cec7211775dab0822447762e\nwpt-pr: 63722\n", "files": ["testing/web-platform/tests/sanitizer-api/sethtml-custom-element-reactions.html", "testing/web-platform/tests/sanitizer-api/sethtml-scoped-custom-element-registry.html"], "git_node": "499942e3cd51a9a6cb0005e19ca67fde3a2cdff8", "git_parents": ["caea7ca45c7427ac57418eb1e82682bf2c46fd81"], "node": "8b2b4fc7505bf7af77a0119baad0ca4ed3bda525", "parents": ["866e000a88d9ff363cdca06c8c2548be2450508c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082692 [wpt PR 63722] - Update wpt metadata, a=testonly\n\nwpt-pr: 63722\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/sanitizer-api/sethtml-custom-element-reactions.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-scoped-custom-element-registry.html.ini"], "git_node": "4d81980a8d068533cdfe9432cf50379886227c78", "git_parents": ["499942e3cd51a9a6cb0005e19ca67fde3a2cdff8"], "node": "3829a8c4f5a7d00cdf6e861e3348ddb141032466", "parents": ["8b2b4fc7505bf7af77a0119baad0ca4ed3bda525"], "tags": []}, {"author": "Celeste Pan \u003ccelestepan@microsoft.com\u003e", "branch": "default", "desc": "Bug 2085465 [wpt PR 64055] - [Masonry] Implement reading-flow down the stacking axis, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Implement reading-flow down the stacking axis\n\nThis change implements reading-flow following the visual order of items\ndown each track in a grid-lanes container. This change works for\nreversed placement and dense-packing cases.\n\nWe move the reversal of nodes for gap decorations and fragmentation to\nbe after `SetReadingFlow` occurs, since using the\n`GridLanesItemIterator` requires iterating on the original order of\nnodes.\n\nBug: 343257585\nChange-Id: Ib51438465b93df063e0edbc56ba05cf461ed7cab\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8528949\nCommit-Queue: Celeste Pan \u003ccelestepan@microsoft.com\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1722185}\n\n--\n\nwpt-commits: 05b91845847380d5a5fc084bedb69afb31089b65\nwpt-pr: 64055\n", "files": ["testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/flex-visual-wrapped-fragmentation.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-columns-fragmentation.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-010.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-011.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-012.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-013.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-row-reading-flow-004.html"], "git_node": "b4ba0f689d8586ad2935e77c234c14e72a073403", "git_parents": ["4d81980a8d068533cdfe9432cf50379886227c78"], "node": "cc6b6422016597655084e3c6a4e9337ba58bcad9", "parents": ["3829a8c4f5a7d00cdf6e861e3348ddb141032466"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085465 [wpt PR 64055] - Update wpt metadata, a=testonly\n\nwpt-pr: 64055\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/flex-visual-wrapped-fragmentation.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-columns-fragmentation.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-010.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-011.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-column-reading-flow-013.html.ini", "testing/web-platform/meta/shadow-dom/focus-navigation/reading-flow/tentative/grid-lanes-row-reading-flow-004.html.ini"], "git_node": "4708ad61c693e448fe4e8103330fd321d8bc2054", "git_parents": ["b4ba0f689d8586ad2935e77c234c14e72a073403"], "node": "9055b12e08ecbbbabe8d45c4dfd274d29abee700", "parents": ["cc6b6422016597655084e3c6a4e9337ba58bcad9"], "tags": []}, {"author": "ChangSeok Oh \u003cchangseok@chromium.org\u003e", "branch": "default", "desc": "Bug 2083717 [wpt PR 63862] - [initial-letter] Fix block position for non-integer size above sink, a=testonly\n\nAutomatic update from web-platform-tests\n[initial-letter] Fix block position for non-integer size above sink\n\nWhen an initial letter's size is greater than or equal to its sink,\ncss-inline-3 under-aligns it: its baseline sits on the sink-th line's\nbaseline. Blink placed the baseline `size` lines below the first line\nbut shifted the surrounding text by ceil(size) - sink whole lines, so a\nnon-integer size left the letter too high, e.g. 0.49 line above the\nsecond line's baseline for `initial-letter: 2.51 2`.\n\nShift the text by the specified size minus the sink instead. This keeps\nthe letter's top in place and puts its baseline on the sink-th line. In\nvertical writing modes, center the letter across the specified size\nrather than its ceiling, which also applies when the size is less than\nthe sink. Integer sizes do not change. Both are guarded by the\nInitialLetterBlockPositioning flag.\n\nTests:\n- external/wpt/css/css-inline/initial-letter/initial-letter-block-position-fractional-size.html (new)\n- external/wpt/css/css-inline/initial-letter/initial-letter-block-position-fractional-size-vrl.html (new)\n- external/wpt/css/css-inline/initial-letter/initial-letter-block-position-fractional-size-vlr.html (new)\n\nBug: 573256240\nChange-Id: Ica6e89890ed024f3a64a663faec42a1443a01f78\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8602966\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nCommit-Queue: ChangSeok Oh \u003cchangseok@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1722259}\n\n--\n\nwpt-commits: 8ed556f41c146d03eb1e5cf24eae3903a76808bf\nwpt-pr: 63862\n", "files": ["testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-fractional-size-ref.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-fractional-size-vlr-ref.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-fractional-size-vlr.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-fractional-size-vrl-ref.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-fractional-size-vrl.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-fractional-size.html"], "git_node": "21905c38e7c86d55595ba978a382838816390405", "git_parents": ["4708ad61c693e448fe4e8103330fd321d8bc2054"], "node": "12b9fbcdbfa0980a9d258c9a203ec884b1cc14c2", "parents": ["9055b12e08ecbbbabe8d45c4dfd274d29abee700"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083717 [wpt PR 63862] - Update wpt metadata, a=testonly\n\nwpt-pr: 63862\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-inline/initial-letter/crashtests/initial-letter-dynamic-crash.html.ini", "testing/web-platform/meta/css/css-inline/initial-letter/initial-letter-block-position-fractional-size-vlr.html.ini", "testing/web-platform/meta/css/css-inline/initial-letter/initial-letter-block-position-fractional-size-vrl.html.ini", "testing/web-platform/meta/css/css-inline/initial-letter/initial-letter-block-position-fractional-size.html.ini"], "git_node": "83aa87cb606b93bf0428a02afeec3c4fabcbf4ae", "git_parents": ["21905c38e7c86d55595ba978a382838816390405"], "node": "f609c599f85d1f907eeeaffb48f5c572e525a5e1", "parents": ["12b9fbcdbfa0980a9d258c9a203ec884b1cc14c2"], "tags": []}, {"author": "Stephen Chenney \u003cschenney@chromium.org\u003e", "branch": "default", "desc": "Bug 2085466 [wpt PR 64056] - Disable FEDisplacementMap acting as a backdrop-filter, a=testonly\n\nAutomatic update from web-platform-tests\nDisable FEDisplacementMap acting as a backdrop-filter\n\nThe background contents filtered by a CSS backdrop filter may contain\nsensitive information, including but not limited to forms containing\nuser data or cross-origin image content. When the background is used as\nthe displacement map for an SVG FEDisplacementMap filter it becomes\npossible to use timing attacks to determine the background, so the spec\nsays the filter must operate as a pass through when the map input is\ncross-origin or otherwise should not be revealed.\n\nUnfortunately we cannot just taint all backdrop filters because doing so\ndisables them for HTML-in-Canvas. Instead, add tracking of \"contains\nbackdrop\" to the filter effect chain and use it in FEDisplacementMap to\nenforce pass-through.\n\nFixed: 540025369\nChange-Id: Ib2b677cbaef36965c77261a79121c73c809f6822\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8395606\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Stephen Chenney \u003cschenney@chromium.org\u003e\nAuto-Submit: Stephen Chenney \u003cschenney@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1722317}\n\n--\n\nwpt-commits: 77ca9242ae301c6bbec1fefec23f81bd2177973a\nwpt-pr: 64056\n", "files": ["testing/web-platform/tests/css/filter-effects/backdrop-filter-svg-displacement.html", "testing/web-platform/tests/css/filter-effects/reference/backdrop-filter-svg-displacement-ref.html"], "git_node": "a219ee022a9737fe29ee70f6ef578d7158227f7f", "git_parents": ["83aa87cb606b93bf0428a02afeec3c4fabcbf4ae"], "node": "44de215cfc9db9ca27af90c3d57362a2fe8d1ef3", "parents": ["f609c599f85d1f907eeeaffb48f5c572e525a5e1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085466 [wpt PR 64056] - Update wpt metadata, a=testonly\n\nwpt-pr: 64056\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/filter-effects/backdrop-filter-svg-displacement.html.ini"], "git_node": "8ad6591bc7d1dcbcf09b9fb6051acd874f5a2027", "git_parents": ["a219ee022a9737fe29ee70f6ef578d7158227f7f"], "node": "86dec349ce5a043b5ee3fafa5c22ab32e5e77c11", "parents": ["44de215cfc9db9ca27af90c3d57362a2fe8d1ef3"], "tags": []}, {"author": "Lia Hiscock \u003cliahiscock@microsoft.com\u003e", "branch": "default", "desc": "Bug 2084329 [wpt PR 63906] - [\u003cinstall\u003e Element] Align InstallResultEventInit default with spec, a=testonly\n\nAutomatic update from web-platform-tests\n[\u003cinstall\u003e Element] Align InstallResultEventInit default with spec\n\nDeclare \"aborted\" as the default result in InstallResultEventInit,\nmatching the Web Install specification. This makes the generated\ndictionary default explicit instead of relying solely on the event's C++\nfallback. There is no change to the observable constructor behavior.\n\nSpec - https://aka.ms/InstallElement\n\nBug: 454827186\nChange-Id: I16db1bfc2957b6977bddbcfefcb8147b3cf167e8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8595146\nReviewed-by: Dan Clark \u003cdaniec@microsoft.com\u003e\nCommit-Queue: Lia Hiscock \u003cliahiscock@microsoft.com\u003e\nReviewed-by: Kristin Lee \u003ckristinlee@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1722325}\n\n--\n\nwpt-commits: e842d012042f6bcf283b43a8de6bbd07b800fc9b\nwpt-pr: 63906\n", "files": ["testing/web-platform/tests/html/semantics/permission-element/install/install-result-event-constructor.tentative.html"], "git_node": "eca620de454fb152b0e98f76c83095e7886a9f7b", "git_parents": ["8ad6591bc7d1dcbcf09b9fb6051acd874f5a2027"], "node": "278d09e58ebb2af3d603e3d6b1d7fe3f140368e8", "parents": ["86dec349ce5a043b5ee3fafa5c22ab32e5e77c11"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084329 [wpt PR 63906] - Update wpt metadata, a=testonly\n\nwpt-pr: 63906\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/permission-element/install/install-result-event-constructor.tentative.html.ini"], "git_node": "e1689f194878431658c77faffe1ce4d40af370cd", "git_parents": ["eca620de454fb152b0e98f76c83095e7886a9f7b"], "node": "b829db01b65cc2f3cddfd91f43607d2772e27f99", "parents": ["278d09e58ebb2af3d603e3d6b1d7fe3f140368e8"], "tags": []}, {"author": "Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e", "branch": "default", "desc": "Bug 2084435 [wpt PR 63910] - [svg] Fall back to masking when SVG clip path union fails, a=testonly\n\nAutomatic update from web-platform-tests\n[svg] Fall back to masking when SVG clip path union fails\n\nLayoutSVGResourceClipper::AsPath() combines multiple \u003cclipPath\u003e children\nusing SkOpBuilder. If the union failed, Blink ignored the failure and\ncached the first child as a valid analytic clip. Painting then used only\nthat child, while hit testing and clip bounds continued to account for\nevery child, producing inconsistent rendering and interaction geometry.\n\nHandle union failure by leaving the analytic-path cache invalid and\nreturning std::nullopt. This invokes the existing mask-based fallback,\nwhich paints every contributing child and keeps painting consistent with\nhit testing and intersection geometry. Use the modern\nstd::optional\u003cSkPath\u003e -returning SkOpBuilder::resolve() API rather than\nits deprecated output-parameter overload.\n\nAdd a WPT reftest covering HTML and SVG clip-path consumers. It uses a\nvalid path ending in a trailing moveto, which causes Skia path-union\nresolution to fail, and verifies that all clip-path children still\ncontribute to the rendered clip. Verified that the new WPT passes in\nFirefox as well.\n\nBug: 574376000\nChange-Id: Ia07a8bbcde4e776b7ff576622fef57a7232fab2e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8608391\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1722404}\n\n--\n\nwpt-commits: 59e775dafdb2cb5a619ed3a5c9706124acf38f48\nwpt-pr: 63910\n", "files": ["testing/web-platform/tests/css/css-masking/clip-path/clip-path-union-trailing-moveto-ref.html", "testing/web-platform/tests/css/css-masking/clip-path/clip-path-union-trailing-moveto.html"], "git_node": "1fdb282b16d7572a7010b2422e00b63a45bef5d9", "git_parents": ["e1689f194878431658c77faffe1ce4d40af370cd"], "node": "892ffb2e6da92de6e06abc2816493abfd70b5296", "parents": ["b829db01b65cc2f3cddfd91f43607d2772e27f99"], "tags": []}, {"author": "Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e", "branch": "default", "desc": "Bug 2084436 [wpt PR 63911] - [svg] Apply overflow clips during visual rect mapping, a=testonly\n\nAutomatic update from web-platform-tests\n[svg] Apply overflow clips during visual rect mapping\n\nApply SVG viewport overflow clips during slow visual-rect mapping, not\nonly when clipping to the content box. This keeps IntersectionObserver\ngeometry consistent with painting and hit testing for\noverflow-clip-margin and per-axis overflow. Add nested-frame WPT\ncoverage that also passes in Firefox.\n\nBug: 574782587\nChange-Id: Iff4a5a14c6dafe557d4c048fc3bdc1b14734a16d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8613667\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1722441}\n\n--\n\nwpt-commits: 7e32d85baff1078cf1bf252b4bad3247848fda60\nwpt-pr: 63911\n", "files": ["testing/web-platform/tests/intersection-observer/resources/svg-overflow-clip-margin-iframe.html", "testing/web-platform/tests/intersection-observer/svg-overflow-clip-margin-iframe.sub.html"], "git_node": "42f3a2cf0b16c325618cc59d14f916247260032f", "git_parents": ["1fdb282b16d7572a7010b2422e00b63a45bef5d9"], "node": "ca2433e49707dfa4a969161a8d1a76340328c6dc", "parents": ["892ffb2e6da92de6e06abc2816493abfd70b5296"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084436 [wpt PR 63911] - Update wpt metadata, a=testonly\n\nwpt-pr: 63911\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/intersection-observer/cross-origin-tall-iframe-rendering.sub.html.ini", "testing/web-platform/meta/intersection-observer/scroll-margin-percent.html.ini"], "git_node": "176d9f425196a06e6f9c89bb4414f02011ca6158", "git_parents": ["42f3a2cf0b16c325618cc59d14f916247260032f"], "node": "0be608627a60b0318bb86bb034021f454a799201", "parents": ["ca2433e49707dfa4a969161a8d1a76340328c6dc"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2084443 [wpt PR 63913] - [Trusted Types] Clean up stale WPT expectations and harden 007-crash, a=testonly\n\nAutomatic update from web-platform-tests\n[Trusted Types] Clean up stale WPT expectations and harden 007-crash\n\n1. Remove the stale [ Crash ] expectation for\nexternal/wpt/trusted-types/navigate-to-javascript-url-007-crash.html\n(the underlying Use-After-Detach crash in FrameLoader::StartNavigation\nwas fixed in https://crrev.com/c/6821038), remove it from the\nvirtual/threaded suite (it does not use requestIdleCallback), and use\nclass=\"test-wait\" on the root element so the crashtest waits until the\ndefault policy's createScript callback has removed the subframe.\n\n2. Remove the transitional [ Failure Pass ] expectations and\nstale-expected.txt baselines for eval-function-constructor.html and\neval-function-constructor-untrusted-arguments-and-applying-default-policy.html\nnow that V8's per-argument codegen callback check in\n   CreateDynamicFunction (https://crrev.com/c/8252307) has rolled in.\n\nBug: 429011220, 330516530, 542045675\nChange-Id: I056bd33c3c8ae872af0d4e8b0bf075a79975fedc\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8562699\nCommit-Queue: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nReviewed-by: Ari Chivukula \u003carichiv@chromium.org\u003e\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1722462}\n\n--\n\nwpt-commits: 2dd1215ff7e45296c70576111db06b201332c1ce\nwpt-pr: 63913\n", "files": ["testing/web-platform/tests/trusted-types/navigate-to-javascript-url-007-crash.html"], "git_node": "39da524236753fb408f7a7d52736e6ab0399d0fd", "git_parents": ["176d9f425196a06e6f9c89bb4414f02011ca6158"], "node": "d6c4747b5523a9690656cb750994cc42de097f7e", "parents": ["0be608627a60b0318bb86bb034021f454a799201"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2085476 [wpt PR 64057] - [wdspec] Remove 2**53 pointer dimension and release pointerDown, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Remove 2**53 pointer dimension and release pointerDown\n\n- Parametrize valid pointer dimension values as [0, 0.1], dropping\n  2**53, and release the pointer button after pointerDown in the\n  missing-dimension test.\n- WebDriver BiDi requires pointer width and height to fit in js-uint\n  (0..2^53-1), and an unreleased pointerDown leaks pressed button state\n  into subsequent tests (added in crrev.com/c/8550115).\n\nTAG=agy\n\nBug: 540482873\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nChange-Id: I250d99f35d013dfb0821f4e4a9c7646f65899112\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8598428\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nReviewed-by: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCommit-Queue: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1722729}\n\n--\n\nwpt-commits: 48c3d3dd5c3814a051e5bb4af8b46a032f9620f9\nwpt-pr: 64057\n", "files": ["testing/web-platform/tests/webdriver/tests/classic/perform_actions/perform.py"], "git_node": "b02c4cdfb5c241d95f13f5925773ff6dd3e41921", "git_parents": ["39da524236753fb408f7a7d52736e6ab0399d0fd"], "node": "d6395321c783e7372c8766b3c7b68f7dab31f60f", "parents": ["d6c4747b5523a9690656cb750994cc42de097f7e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085476 [wpt PR 64057] - Update wpt metadata, a=testonly\n\nwpt-pr: 64057\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/classic/perform_actions/perform.py.ini"], "git_node": "d999ff64ff32929daee3a0b405dce85cddc8b5e6", "git_parents": ["b02c4cdfb5c241d95f13f5925773ff6dd3e41921"], "node": "9265ca7055c9dc5f37582633d8d5089ea4905bf8", "parents": ["d6395321c783e7372c8766b3c7b68f7dab31f60f"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2084752 [wpt PR 63936] - [css] Use document referrer policy for fetching from inline CSS, a=testonly\n\nAutomatic update from web-platform-tests\n[css] Use document referrer policy for fetching from inline CSS\n\nWhen parsing an inline stylesheet, `CSSStyleSheet::InlineParserContext`\npreviously constructed the `CSSParserContext` with\n`network::mojom::ReferrerPolicy::kDefault`, causing subresource fetches\n(such as fonts, images, or SVG resource references) initiated from\n`\u003cstyle\u003e` elements to ignore the owner document's referrer policy.\n\nInstead, snapshot `owner_node_document.GetReferrerPolicy()` when\ncreating the inline `CSSParserContext` so that inline stylesheets use\nthe owner document's referrer policy active at parse time. Also guard\n`ExecutionContext::GetReferrerPolicy()` when `policy_container_` is\nnull (e.g. after `TakePolicyContainer()` on a cloned document).\n\nOriginal patch by estark@chromium.org.\n\nTAG=agy\nCONV=0f543df6-f84d-421a-bec5-5db380444d4d\n\nBug: 40898994, 40229610\nFixed: 392139161\nTest: external/wpt/referrer-policy/css-integration/\nChange-Id: Ieb123531d3fac6cbc8d32d6378b6d15168518f1a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8602043\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCr-Commit-Position: refs/heads/main@{#1722857}\n\n--\n\nwpt-commits: 1f66d4dd3c1b18bc2fce6a58dc26243d23de863d\nwpt-pr: 63936\n", "files": ["testing/web-platform/tests/referrer-policy/css-integration/child-css/internal-stylesheet-no-referrer.html", "testing/web-platform/tests/referrer-policy/css-integration/font-face/internal-stylesheet-no-referrer.html", "testing/web-platform/tests/referrer-policy/css-integration/image/internal-stylesheet-no-referrer.html"], "git_node": "60fee2046a854bd2b89c5a23b47547982ca4a2fd", "git_parents": ["d999ff64ff32929daee3a0b405dce85cddc8b5e6"], "node": "3afcbb9944da812e03179ab2916a317994f85f10", "parents": ["9265ca7055c9dc5f37582633d8d5089ea4905bf8"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2084822 [wpt PR 63943] - [wdspec] Wait for context destruction in pointer_mouse close test, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Wait for context destruction in pointer_mouse close test\n\n- Wait for browsingContext.contextDestroyed before checking that the\n  browsing context closed on mousedown in input.performActions.\n- window.close() queues a task to close and destroy the traversable\n  asynchronously, so querying the browsing context tree right after\n  input.performActions returns can race with context destruction\n  (exposed by crrev.com/c/8522202).\n\nTAG=agy\n\nBug: 573374312\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel,linux-blink-rel,android-15-chrome-blink-rel\nChange-Id: I5fb223be9f6e053c4f8542cec654e7d6007bacc5\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8620312\nReviewed-by: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nCommit-Queue: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1722934}\n\n--\n\nwpt-commits: 4d9edaa6f94149b9139145d4c85edbd113e825bd\nwpt-pr: 63943\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/pointer_mouse.py"], "git_node": "e6b5b2d9719eaf151c3c8cd9364a007cdc117e9e", "git_parents": ["60fee2046a854bd2b89c5a23b47547982ca4a2fd"], "node": "f24442f33aa6fe0c30410155c214ba99f933efb0", "parents": ["3afcbb9944da812e03179ab2916a317994f85f10"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2084456 [wpt PR 63914] - Prototype window.open() split tab support, a=testonly\n\nAutomatic update from web-platform-tests\nPrototype window.open() split tab support\n\nAdd \"split\", \"splitposition\" and \"splitsize\" window features to\nwindow.open(), behind the WindowOpenSplitTab runtime enabled feature.\nSee the explainer at https://github.com/mfreed7/split-tabs.\n\nBlink parses the new features into WindowFeatures and sends them to the\nbrowser as hints. The renderer keeps a fallback disposition: a new tab,\nor a popup if \"popup\" was also given. When \"split\" is given, the legacy\n\"any other feature means popup\" heuristic does not apply, and\n\"resizable=no\" no longer forces a popup.\n\nIf the user's click modifiers choose the disposition (e.g. ctrl-click\nfor a background tab, shift-click for a new window, or the split view\nmodifier), Blink drops the split request, so the browser handles the\nmodifiers as it would without \"split\".\n\nThe browser decides whether to create the split. On desktop Chrome,\nBrowserWebContentsDelegate::AddNewContents upgrades the fallback\ndisposition to NEW_SPLIT_VIEW only if all of these hold:\n - the opener is the active tab;\n - the opener is not already in a split;\n - the opener is not running a background actor task;\n - the browser is TYPE_NORMAL.\nOtherwise the fallback disposition is used. Other embedders get the\nfallback with no changes.\n\nThe browser navigator applies the requested position and size.\n\"top\"/\"bottom\" give a stacked layout when kSplitViewHorizontal is\nenabled; otherwise they map to \"left\"/\"right\". The size is clamped to\n[10, 90] percent.\n\nBarProp visibility reflects the requested features, not whether a split\nwas created, so script cannot detect the outcome.\n\nSplit creation is recorded with SplitTabCreatedSource::kLinkClick for\nnow. The declarative windowfeatures attribute is left for a follow-up.\n\nBug: 570412924\nChange-Id: If42b9c6c1af82e1b4c24f0c3b78cce5d1ec8f987\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8527612\nReviewed-by: Dave Tapuska \u003cdtapuska@chromium.org\u003e\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nReviewed-by: Nasko Oskov \u003cnasko@chromium.org\u003e\nCommit-Queue: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1722976}\n\n--\n\nwpt-commits: 9978b553bee357b8fec973f462d7c60c2521be9a\nwpt-pr: 63914\n", "files": ["testing/web-platform/tests/html/browsers/the-window-object/open-close/open-features-split.tentative.html"], "git_node": "d2dd9f07bc2ed88591ae1585733c7bc218680141", "git_parents": ["e6b5b2d9719eaf151c3c8cd9364a007cdc117e9e"], "node": "c2587451e707b5b7dfee9574e948f5176940e473", "parents": ["f24442f33aa6fe0c30410155c214ba99f933efb0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084456 [wpt PR 63914] - Update wpt metadata, a=testonly\n\nwpt-pr: 63914\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/browsers/the-window-object/open-close/open-features-split.tentative.html.ini"], "git_node": "d395d9fe2b9f822025d346939bd0d6402a8ff424", "git_parents": ["d2dd9f07bc2ed88591ae1585733c7bc218680141"], "node": "c2f433c0338865ccda8c8bae5f18cb0606014428", "parents": ["c2587451e707b5b7dfee9574e948f5176940e473"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2085482 [wpt PR 64058] - Make sizes=\"auto\" two-dimensional, a=testonly\n\nAutomatic update from web-platform-tests\nMake sizes=\"auto\" two-dimensional\n\nSecond part of https://github.com/whatwg/html/pull/13053, behind the\n`SrcsetTwoDimensionalSizes` runtime flag.\n\nWhen `sizes=\"auto\"` is used, resolve it to the layout box's width and\nheight together with the computed `object-fit`, so that the source\nconcrete width of candidates with an `h` descriptor accounts for how the\nimage is fit into the box. The last auto-sizes size (used when the image\nis not being rendered) stores the full `TargetBoxSize`.\n\nA change to the computed `object-fit` of a lazy-loaded `sizes=\"auto\"`\nimage is a relevant mutation, so re-run source selection (in a task, as\nthis is detected during style recalc).\n\nUsing the `width`/`height` attributes as a default aspect ratio for\ncandidates without an `h` descriptor is implemented in a follow-up CL.\n\nBug: 572724710\nChange-Id: Ie4ce4feffc447102862fea230ba852ecdcc9dc3d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8563320\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1722995}\n\n--\n\nwpt-commits: 080cafcc9fdc08e314a3949bcbe6bb5edc5b6b6d\nwpt-pr: 64058\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-img-element/sizes/sizes-auto-2d.tentative.html"], "git_node": "9ab58bd037f597f91d07faf12d2234a51e83f0ce", "git_parents": ["d395d9fe2b9f822025d346939bd0d6402a8ff424"], "node": "6518b89473cb35fe30377feb787e6e05e5773127", "parents": ["c2f433c0338865ccda8c8bae5f18cb0606014428"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085482 [wpt PR 64058] - Update wpt metadata, a=testonly\n\nwpt-pr: 64058\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/the-img-element/sizes/sizes-auto-2d.tentative.html.ini"], "git_node": "38273563944d1ed66a32ec5a3a7ec6f3ac682834", "git_parents": ["9ab58bd037f597f91d07faf12d2234a51e83f0ce"], "node": "153d5ee7f7510f6137d7c2224849c4fe6d8f2486", "parents": ["6518b89473cb35fe30377feb787e6e05e5773127"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2084277 [wpt PR 63896] - Exclude higher composite order effects from partial effect stacks, a=testonly\n\nAutomatic update from web-platform-tests\nExclude higher composite order effects from partial effect stacks\n\nPer step 5.3 of the commit computed styles procedure [1], effects whose\nanimation has a higher composite order than the committing animation\nmust not contribute to the value committed by commitStyles().\n\nEffectStack::ActiveInterpolations() implements this by cutting the\neffect stack off at the sampled effect of the committing animation.\nHowever, an effect that is not in effect (e.g. canceled, in its start\ndelay, or past its active interval without a forwards fill) has no\nsampled effect in the stack, so the cutoff was never reached and the\nvalues of all higher composite order animations were committed instead.\n\nNotably, this is the case for commitStyles() on a canceled animation\nwith a removed replace state (see crrev.com/c/8564720): instead of being\na no-op, it committed the value of the replacing animation.\n\nThis CL makes the cutoff also stop at the first sampled effect with a\nhigher composite order than the cutoff effect's animation, using the\nsame ordering that is used to sort the effect stack. Behavior is\nunchanged when the cutoff effect is part of the effect stack.\n\n[1] https://drafts.csswg.org/web-animations-1/#commit-computed-styles\n\nBug: 574857654\nChange-Id: I29df5cf9569145ea1113311f7829d972a88add0e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8606107\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1722998}\n\n--\n\nwpt-commits: 1b7eeb5c7e5ea149c7f6d9cbb1273d0239c2a15a\nwpt-pr: 63896\n", "files": ["testing/web-platform/tests/web-animations/interfaces/Animation/commitStyles.html"], "git_node": "45f2bda257a0b2a68b60b0faac2254dfb32db393", "git_parents": ["38273563944d1ed66a32ec5a3a7ec6f3ac682834"], "node": "8c9e691023d0dd5861580a0fe43e6fbb9f6362d7", "parents": ["153d5ee7f7510f6137d7c2224849c4fe6d8f2486"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2084215 [wpt PR 63895] - scroll-snap: Update scrollsnapchanging targets after a short scroll, a=testonly\n\nAutomatic update from web-platform-tests\nscroll-snap: Update scrollsnapchanging targets after a short scroll\n\nIf a scroll starts and finishes between commits from the compositor,\nSendEndOfScrollEvents() runs on the main thread without an intervening\nSendScrollSnapChangingEventIfNeeded() call.\n\nUpdate the scrollsnapchanging targets and enqueue scrollsnapchanging in\nUpdateSnappedTargetsAndEnqueueScrollSnapChange() before checking for\nscrollsnapchange so that scrollsnapchanging always precedes\nscrollsnapchange (and overscroll state reflects the final snapped\ntargets).\n\nAdditionally, fix two issues where TargetSnapAreaElementIds updates were\ndropped or overwritten on non-composited (RasterInducingScroll)\nscrollers:\n- Request a commit in PropertyTreeManager::EnsureCompositorScrollNodeInternal\n  when a ScrollPaintPropertyNode has changed, and clear change flags on\n  scroll_translation_nodes in PaintArtifactCompositor::Update.\n- Keep pending_tree and recycle_tree in sync when updating\n  TargetSnapAreaElementIds on the active tree via\n  LayerTreeImpl::SetTargetSnapAreaElementIds so impl-side invalidations\n  do not overwrite active tree snap targets.\n\nBug: 575414038\nChange-Id: If8f1ad74b22813154d5d80ebf62234f1cbcc4c97\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8550803\nReviewed-by: David A \u003cawogbemila@chromium.org\u003e\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1723064}\n\n--\n\nwpt-commits: ae2769bc68ca0d9d697eed96b014b4c5f702f0fe\nwpt-pr: 63895\n", "files": ["testing/web-platform/tests/css/css-scroll-snap/snap-events/scrollsnapchanging/scrollsnapchanging-on-fast-scroll.tentative.html"], "git_node": "82bfea5da070308943bd25cb6ca35c45abf59ba1", "git_parents": ["45f2bda257a0b2a68b60b0faac2254dfb32db393"], "node": "abcfc32c73f87071322fef5536698ef81f46b12b", "parents": ["8c9e691023d0dd5861580a0fe43e6fbb9f6362d7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084215 [wpt PR 63895] - Update wpt metadata, a=testonly\n\nwpt-pr: 63895\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-scroll-snap/snap-events/scrollsnapchanging/scrollsnapchanging-on-fast-scroll.tentative.html.ini"], "git_node": "eba27b85369bea7cba6bc1f5f8baef35e48672f0", "git_parents": ["82bfea5da070308943bd25cb6ca35c45abf59ba1"], "node": "987cb42ae6a4c8f733a521751d4e43021440696f", "parents": ["abcfc32c73f87071322fef5536698ef81f46b12b"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2085483 [wpt PR 64059] - Remove void element end tags from HTML WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nRemove void element end tags from HTML WPTs\n\nSome elements (such as img, input, link, meta, embed, source, etc) have\nno end tag. Writing their end tag anyway is a parse error, and the\nparser drops the tag, so the source suggests a structure the document\nnever had. This CL removes these end tags from WPT tests in\nthird_party/blink/web_tests/external/wpt/html.\n\nBug: 542686202\nChange-Id: I8906100d1087b14d6015c3080e960426a1674624\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8227084\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCommit-Queue: Andres Regalado Rosas \u003candresrega@microsoft.com\u003e\nReviewed-by: Andres Regalado Rosas \u003candresrega@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1723320}\n\n--\n\nwpt-commits: bf5e557274eb8b67e51ff9be881b2c65e445a2a9\nwpt-pr: 64059\n", "files": ["testing/web-platform/tests/html/dom/aria-element-reflection.html", "testing/web-platform/tests/html/dom/documents/dom-tree-accessors/document.getElementsByName/document.getElementsByName-newelements.html", "testing/web-platform/tests/html/dom/documents/dom-tree-accessors/nameditem-05.html", "testing/web-platform/tests/html/dom/elements/global-attributes/id-name-specialcase.html", "testing/web-platform/tests/html/infrastructure/common-dom-interfaces/collections/htmlformcontrolscollection.html", "testing/web-platform/tests/html/interaction/focus/sequential-focus-navigation-and-the-tabindex-attribute/resources/frameset-using-page.html", "testing/web-platform/tests/html/interaction/focus/sequential-focus-navigation-and-the-tabindex-attribute/tabindex-getter.html", "testing/web-platform/tests/html/interaction/focus/the-autofocus-attribute/resources/child-autofocus.html", "testing/web-platform/tests/html/interaction/focus/the-autofocus-attribute/resources/grand-child-autofocus.html", "testing/web-platform/tests/html/semantics/grouping-content/the-ol-element/grouping-ol.html", "testing/web-platform/tests/html/semantics/interactive-elements/the-dialog-element/dialog-autofocus-multiple-times.html", "testing/web-platform/tests/html/semantics/interactive-elements/the-summary-element/interactive-content.html", "testing/web-platform/tests/html/semantics/scripting-1/the-script-element/load-error-events-2.html", "testing/web-platform/tests/html/semantics/scripting-1/the-script-element/script-text-modifications-csp.html", "testing/web-platform/tests/html/semantics/scripting-1/the-script-element/script-text-modifications.html", "testing/web-platform/tests/html/semantics/selectors/pseudo-classes/enabled.html", "testing/web-platform/tests/html/semantics/selectors/pseudo-classes/link.html", "testing/web-platform/tests/html/semantics/selectors/pseudo-classes/placeholder-shown-type-change.html"], "git_node": "456c7292450a111e619912f417192d286a896d7d", "git_parents": ["eba27b85369bea7cba6bc1f5f8baef35e48672f0"], "node": "59d671c08c7005b5686606f84b4f8fe40e8ce2d4", "parents": ["987cb42ae6a4c8f733a521751d4e43021440696f"], "tags": []}, {"author": "Viktoria Zlatinova \u003cvizlatin@microsoft.com\u003e", "branch": "default", "desc": "Bug 2085485 [wpt PR 64060] - CSP: Enforce Trusted Types in embedded CSP, a=testonly\n\nAutomatic update from web-platform-tests\nCSP: Enforce Trusted Types in embedded CSP\n\nInclude Trusted Types directives when checking whether a response\nsatisfies an iframe's required CSP. Combine enforcing response policies\nbefore conservatively comparing normalized Trusted Types restrictions,\nand ignore report-only policies.\n\nThe initial trusted-types implementation compares normalized enforcement\nconfigurations using exact equality. This is conservative and may reject\nstricter returned subsets while richer subsumption is deferred.\n\nFlag: CSPEmbeddedEnforcementTrustedTypes (disabled by default) When\ndisabled, CSP:EE preserves its existing source-list-only subsumption\nbehavior and skips Trusted Types checks.\n- Chrome status entry: https://chromestatus.com/feature/5199775795380224\n- I2P: https://groups.google.com/a/chromium.org/g/blink-dev/c/H-i9_ZsT6CU/m/p9t7nrn1AwAJ\n\n- Spec issue: https://github.com/w3c/webappsec-csp/issues/628\n- Spec PR: https://github.com/w3c/webappsec-cspee/pull/36\n\nBug: 40912894\nChange-Id: Ic1f887cce8f075306c78fd78a71cba7344604193\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8237933\nReviewed-by: Antonio Sartori \u003cantoniosartori@chromium.org\u003e\nReviewed-by: Reilly Grant \u003creillyg@chromium.org\u003e\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nCommit-Queue: Viktoria Zlatinova \u003cvizlatin@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1723352}\n\n--\n\nwpt-commits: 48ae2959b7df3bb9f18a14e21222ec148a6c0488\nwpt-pr: 64060\n", "files": ["testing/web-platform/tests/content-security-policy/embedded-enforcement/subsumption_algorithm-trusted_types.tentative.html"], "git_node": "d035a48f7618773bdd30f7f0974be0f9f4ec2a72", "git_parents": ["456c7292450a111e619912f417192d286a896d7d"], "node": "5470d097ce310cda63a1a9e3d2ef14ebb4ccd8ed", "parents": ["59d671c08c7005b5686606f84b4f8fe40e8ce2d4"], "tags": []}, {"author": "Stephen Chenney \u003cschenney@chromium.org\u003e", "branch": "default", "desc": "Bug 2085214 [wpt PR 63964] - [HiC] Additional test for mix-blend-mode and a backdrop-filter, a=testonly\n\nAutomatic update from web-platform-tests\n[HiC] Additional test for mix-blend-mode and a backdrop-filter\n\nTests that the backdrop-filter filters the canvas content behind the\nelement when the backdrop-filter is on the element that is drawn.\n\nBug: 567613565\nChange-Id: I4f4cac56621b704bd17528e0011ec1e966b2afcc\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7843433\nAuto-Submit: Stephen Chenney \u003cschenney@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Stephen Chenney \u003cschenney@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1723405}\n\n--\n\nwpt-commits: 5caead786a3c8e8b01c813f65a0bfbfbbe728c1c\nwpt-pr: 63964\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/css-backdrop-filter-with-blend-mode-over-content-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/css-backdrop-filter-with-blend-mode-over-content.tentative.html"], "git_node": "829997cc668aab4a2578e00b3c1356cb3df9b952", "git_parents": ["d035a48f7618773bdd30f7f0974be0f9f4ec2a72"], "node": "76423e60e7f332fc22b0f57252050d5d06dfbb70", "parents": ["5470d097ce310cda63a1a9e3d2ef14ebb4ccd8ed"], "tags": []}, {"author": "ChangSeok Oh \u003cchangseok@chromium.org\u003e", "branch": "default", "desc": "Bug 2084484 [wpt PR 63922] - [initial-letter] Use the computed sink for drop and an omitted sink, a=testonly\n\nAutomatic update from web-platform-tests\n[initial-letter] Use the computed sink for drop and an omitted sink\n\nPer css-inline-3, `drop` computes to a sink equal to the initial letter\nsize floored, and an omitted sink means `drop`[1]. So `2.51` and\n`2.51 drop` mean `2.51 2`: as 2.51 \u003e= 2, the letter is under-aligned\nwith its baseline on line 2, and the text moves down 0.51 line.\nStyleInitialLetter already stores floor(size), but layout ignored it\nfor these sink types and used ceil(size) instead, so `2.51` rendered\nlike `2.51 3`: top-aligned with no text shift.\n\nUse Sink() for every sink type. Such letters now take the size \u003e= sink\npath and are under-aligned on the floored line. A size below 2, e.g.\n`1.5`, floors to 1 and becomes a raised initial. Integer sizes do not\nchange. The change is guarded by the InitialLetterBlockPositioning\nflag.\n\n[1] https://drafts.csswg.org/css-inline-3/#valdef-initial-letter-drop\n\nTests:\n- external/wpt/css/css-inline/initial-letter/initial-letter-block-position-fractional-drop.html (new)\n- external/wpt/css/css-inline/initial-letter/initial-letter-block-position-fractional-drop-vrl.html (new)\n- external/wpt/css/css-inline/initial-letter/initial-letter-block-position-fractional-drop-vlr.html (new)\n\nBug: 573256240\nChange-Id: Ie5a62c70e9187adfa0b0d24faeff36b15f3bab71\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8615437\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCommit-Queue: ChangSeok Oh \u003cchangseok@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1723424}\n\n--\n\nwpt-commits: 4a8b79926be49cb9ce180be4eac090c78c6230df\nwpt-pr: 63922\n", "files": ["testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-fractional-drop-ref.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-fractional-drop-vlr-ref.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-fractional-drop-vlr.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-fractional-drop-vrl-ref.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-fractional-drop-vrl.html", "testing/web-platform/tests/css/css-inline/initial-letter/initial-letter-block-position-fractional-drop.html"], "git_node": "2af2e138c07d5a5b6d09e31a6c16e55ae792328d", "git_parents": ["829997cc668aab4a2578e00b3c1356cb3df9b952"], "node": "c260387d5a8f5cd3b174b73571e788fa20998a1c", "parents": ["76423e60e7f332fc22b0f57252050d5d06dfbb70"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084484 [wpt PR 63922] - Update wpt metadata, a=testonly\n\nwpt-pr: 63922\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-inline/initial-letter/initial-letter-block-position-fractional-drop-vlr.html.ini", "testing/web-platform/meta/css/css-inline/initial-letter/initial-letter-block-position-fractional-drop-vrl.html.ini", "testing/web-platform/meta/css/css-inline/initial-letter/initial-letter-block-position-fractional-drop.html.ini"], "git_node": "9c76bdf8425e64df3e74faa82ce68acdf6f241ba", "git_parents": ["2af2e138c07d5a5b6d09e31a6c16e55ae792328d"], "node": "c99e8e9b110f4ff366b8850abe87e753f3ced896", "parents": ["c260387d5a8f5cd3b174b73571e788fa20998a1c"], "tags": []}, {"author": "Fredrik S\u00f6derquist \u003cfs@opera.com\u003e", "branch": "default", "desc": "Bug 2085490 [wpt PR 64062] - Don't pad for \u003chue-interpolation-method\u003e increasing/decreasing, a=testonly\n\nAutomatic update from web-platform-tests\nDon't pad for \u003chue-interpolation-method\u003e increasing/decreasing\n\nFollowing the behavior of kLonger, let Skia handle the padding.\n\nFixed: 575586564\nChange-Id: I8bbff07b80de3e98d3a0326a9ec78edf49a2e298\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8617021\nReviewed-by: Florin Malita \u003cfmalita@chromium.org\u003e\nAuto-Submit: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCommit-Queue: Florin Malita \u003cfmalita@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1723689}\n\n--\n\nwpt-commits: d0a5a8a97ad097685fc9d05b42dc2df92c20a836\nwpt-pr: 64062\n", "files": ["testing/web-platform/tests/css/css-images/gradient/gradient-single-stop-decreasing-hue-hsl-ref.html", "testing/web-platform/tests/css/css-images/gradient/gradient-single-stop-decreasing-hue-hsl.html", "testing/web-platform/tests/css/css-images/gradient/gradient-single-stop-decreasing-hue-oklch-ref.html", "testing/web-platform/tests/css/css-images/gradient/gradient-single-stop-decreasing-hue-oklch.html", "testing/web-platform/tests/css/css-images/gradient/gradient-single-stop-increasing-hue-hsl-ref.html", "testing/web-platform/tests/css/css-images/gradient/gradient-single-stop-increasing-hue-hsl.html", "testing/web-platform/tests/css/css-images/gradient/gradient-single-stop-increasing-hue-oklch-ref.html", "testing/web-platform/tests/css/css-images/gradient/gradient-single-stop-increasing-hue-oklch.html"], "git_node": "2e5fa57c4eb9184d350d2e30acc124219c5cdcc5", "git_parents": ["9c76bdf8425e64df3e74faa82ce68acdf6f241ba"], "node": "37578e8a900b7f08d3cd4e9be7237e73d466e35f", "parents": ["c99e8e9b110f4ff366b8850abe87e753f3ced896"], "tags": []}, {"author": "Antonio Sartori \u003cantoniosartori@chromium.org\u003e", "branch": "default", "desc": "Bug 2085491 [wpt PR 63982] - [PermissionsPolicyForWorkers] Add WPTs for starting shared workers, a=testonly\n\nAutomatic update from web-platform-tests\n[PermissionsPolicyForWorkers] Add WPTs for starting shared workers\n\nThis CL adds Web Platform tests for starting shared workers and\nconnecting to them with the 'allow' WorkerOptions parameter.\n\nThis is part of a series of CLs implementing permissions policy for\nshared workers behind a feature flag, see the attached tracking bug\nfor more details.\n\nBug: 562705553\nChange-Id: Idfa2691c3323a3566d61fd6acc74682dd4af85e5\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8426415\nReviewed-by: Daniel Vogelheim \u003cvogelheim@chromium.org\u003e\nCommit-Queue: Antonio Sartori \u003cantoniosartori@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1723696}\n\n--\n\nwpt-commits: 1780db0ec9efeba3b7d70c4769bfbc435ba023b2\nwpt-pr: 63982\n", "files": ["testing/web-platform/tests/permissions-policy/shared-worker-permissions-policy-allow-option.https.tentative.html", "testing/web-platform/tests/permissions-policy/shared-worker-permissions-policy-allow-option.https.tentative.html.headers", "testing/web-platform/tests/permissions-policy/shared-worker-permissions-policy-connect.https.tentative.html"], "git_node": "7e112f5f40b32b78cc4d983b440f6dcc64a125cf", "git_parents": ["2e5fa57c4eb9184d350d2e30acc124219c5cdcc5"], "node": "c7a62584876f6968b33dc4219142f47655b7b99c", "parents": ["37578e8a900b7f08d3cd4e9be7237e73d466e35f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085491 [wpt PR 63982] - Update wpt metadata, a=testonly\n\nwpt-pr: 63982\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/permissions-policy/shared-worker-permissions-policy-allow-option.https.tentative.html.ini", "testing/web-platform/meta/permissions-policy/shared-worker-permissions-policy-connect.https.tentative.html.ini"], "git_node": "762e6ae9833cc8c229cde43184ada3c043af52d6", "git_parents": ["7e112f5f40b32b78cc4d983b440f6dcc64a125cf"], "node": "6a3247802c323923254f632d601c5e201ff1bfa7", "parents": ["c7a62584876f6968b33dc4219142f47655b7b99c"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2085225 [wpt PR 63966] - Fix timeouts in referrer-policy/css-integration/svg WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nFix timeouts in referrer-policy/css-integration/svg WPTs\n\nThe six tests in external/wpt/referrer-policy/css-integration/svg/\nrun nine sequential promise_tests (one per SVG property), each of\nwhich waits 800ms before checking the request headers. That is at\nleast 7.2s of sleeping, which exceeds the default 6s WPT timeout, so\nthe tests always timed out. Mark them with\n\u003cmeta name=\"timeout\" content=\"long\"\u003e.\n\nWith the timeout fixed, external-stylesheet.html and\nprocessing-instruction.html pass today. The other four tests\n(inline-style, inline-style-with-differentorigin-base-tag.tentative,\ninternal-stylesheet and presentation-attribute) pass once inline CSS\nfetches use the document's referrer policy, which is fixed by\nhttps://crrev.com/c/8200773. This CL should land after that one, and\nremoves the stale [ Failure Timeout ] expectations for all six tests.\n\nTAG=agy\nCONV=0f543df6-f84d-421a-bec5-5db380444d4d\n\nBug: 40898994\nChange-Id: Ifec6ec5575c363bcfec7e9d31233c9cfaff95bc4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8582905\nReviewed-by: Ari Chivukula \u003carichiv@chromium.org\u003e\nCommit-Queue: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1723776}\n\n--\n\nwpt-commits: 1e2626f057440a460e818b6094b6cc9d4bb5b956\nwpt-pr: 63966\n", "files": ["testing/web-platform/tests/referrer-policy/css-integration/svg/external-stylesheet.html", "testing/web-platform/tests/referrer-policy/css-integration/svg/inline-style-with-differentorigin-base-tag.tentative.html", "testing/web-platform/tests/referrer-policy/css-integration/svg/inline-style.html", "testing/web-platform/tests/referrer-policy/css-integration/svg/internal-stylesheet.html", "testing/web-platform/tests/referrer-policy/css-integration/svg/presentation-attribute.html", "testing/web-platform/tests/referrer-policy/css-integration/svg/processing-instruction.html"], "git_node": "20cdb82b80f0ec19f9960cab8159938bd3ccb712", "git_parents": ["762e6ae9833cc8c229cde43184ada3c043af52d6"], "node": "0f30c0b28586c84b17ad7de974f22857ea2eb466", "parents": ["6a3247802c323923254f632d601c5e201ff1bfa7"], "tags": []}, {"author": "Aeryn Moss \u003caerynm@google.com\u003e", "branch": "default", "desc": "Bug 2085493 [wpt PR 64063] - [a11y] Defer restoring parents of aria-owned children during removal, a=testonly\n\nAutomatic update from web-platform-tests\n[a11y] Defer restoring parents of aria-owned children during removal\n\nWhen an aria-owns owner is removed while immediate tree updates are\nallowed, AXRelationCache::RemoveAXID() previously called\nMaybeRestoreParentOfOwnedChild() -\u003e RestoreParentOrPruneWithCleanLayout()\nsynchronously during removal. Restoring the child's parent inline can\ntrigger ChildrenChangedWithCleanLayout() and nested relation updates\nthat rebuild or clear an ancestor's children vector while\nRemoveSubtree() is still iterating over it.\n\nInstead, record unparented aria-owns children in\nchild_axids_to_restore_parent_ (and queue candidate owners in\nowner_axids_to_update_) during RemoveAXID(), and restore or prune their\nparents later in AXRelationCache::ProcessUpdatesWithCleanLayout() after\npending owner updates have been processed.\n\nIn AXObjectCacheImpl, flush deferred parent restorations as soon as the\noutermost Remove(), RemoveSubtree(), or RemoveIncludedSubtree() call\ncompletes, and defer radio button peer invalidation during immediate\ntree updates so ancestor subtrees and unparented nodes are not touched\nmid-removal.\n\nIncludes web tests and WPT crashtests for aria-owns parent restoration\nfrom crrev.com/c/8614312.\n\nCo-authored-by: Sky Debreuil \u003cskydebreuil@google.com\u003e\nFixed: 572237022\nChange-Id: I1a75b0b9fbede0533df92dacf3fdcfb9b2f7eae7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8594503\nReviewed-by: Lucas Radaelli \u003clucasradaelli@google.com\u003e\nCommit-Queue: Aeryn Moss \u003caerynm@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1723783}\n\n--\n\nwpt-commits: 6d1c1ea6cfadd2bdb36fd867a4483bce9cd25eba\nwpt-pr: 64063\n", "files": ["testing/web-platform/tests/accessibility/crashtests/aria-owns-deferred-parent-cycle.html", "testing/web-platform/tests/accessibility/crashtests/aria-owns-deferred-parent-restoration.html"], "git_node": "f071534ad19da37a0ae09adabe3078b1a40462d4", "git_parents": ["20cdb82b80f0ec19f9960cab8159938bd3ccb712"], "node": "efe55f00060ecc0a6f28c2cc0eeeaa6588099494", "parents": ["0f30c0b28586c84b17ad7de974f22857ea2eb466"], "tags": []}, {"author": "Mike Taylor \u003cmiketaylr@chromium.org\u003e", "branch": "default", "desc": "Bug 2085494 [wpt PR 63985] - [css] Reset element sheet when \u003cmeta name=\"referrer\"\u003e changes policy, a=testonly\n\nAutomatic update from web-platform-tests\n[css] Reset element sheet when \u003cmeta name=\"referrer\"\u003e changes policy\n\nFollow-up to https://crrev.com/c/8602043, which made inline CSS snapshot\nthe owner document's referrer policy at parse time.\n\n`Document::ElementSheet()` is created lazily and cached, and its parser\ncontext is used for every inline `style` attribute and presentation\nattribute. If it was created before `\u003cmeta name=\"referrer\"\u003e` was\nprocessed (for example by `\u003cmeta name=\"color-scheme\"\u003e`, which parses\nits content with the element sheet's context), later inline styles kept\nthe stale pre-meta policy and could send a referrer under\n`no-referrer`.\n\nWhen `\u003cmeta name=\"referrer\"\u003e` changes the document's policy, drop\n`elem_sheet_` (as `Document::UpdateBaseURL()` already does for base URL\nchanges) and clear `StyleEngine`'s cached `fill`/`clip-path`\n`CSSURIValue`s, which were parsed with the old element sheet context.\n\nA policy from the `Referrer-Policy` header is applied before the\ndocument is created, so it does not need this invalidation.\n\nBug: 392139161\nChange-Id: Ib688e41c7c78cbc201993af85b513652198233d6\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8603655\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1723792}\n\n--\n\nwpt-commits: d801544a33bdbb142b604bd8315c77b5eb9d93b8\nwpt-pr: 63985\n", "files": ["testing/web-platform/tests/referrer-policy/css-integration/image/inline-style-with-color-scheme-no-referrer.html"], "git_node": "1b753b2e4683fde29e0faba5cbd799b5f11f6b88", "git_parents": ["f071534ad19da37a0ae09adabe3078b1a40462d4"], "node": "264262fe0e0871cfd35fedc9b30c560d7b6de273", "parents": ["efe55f00060ecc0a6f28c2cc0eeeaa6588099494"], "tags": []}, {"author": "mark a. foltz \u003cmfoltz@chromium.org\u003e", "branch": "default", "desc": "Bug 2084483 [wpt PR 63921] - [MediaCapabilities] Reject HDR fields for types 'record' and 'webrtc', a=testonly\n\nAutomatic update from web-platform-tests\n[MediaCapabilities] Reject HDR fields for types 'record' and 'webrtc'\n\nIn Media Capabilities, hdrMetadataType, colorGamut, and transferFunction\nare only valid for non-WebRTC decode configurations ('file' and\n'media-source'). Reject them with TypeError for 'webrtc' decoding and\nall encoding configurations ('record' and 'webrtc').\n\nSpec:\nhttps://w3c.github.io/media-capabilities/#valid-video-configuration\nSpecifically, sections about applicability of these three properties to\nthe 'file' and 'media-source' types.\n\nUpdate IsValidVideoConfiguration() accordingly, add unit tests,\nupdate WPT baselines, and update media_capabilities_browsertest.cc.\n\nBug: None\nChange-Id: I47f0a6b3b29c8447a6b0ac728b53666747922554\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8614858\nReviewed-by: Eugene Zemtsov \u003ceugene@chromium.org\u003e\nCommit-Queue: Mark Foltz \u003cmfoltz@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1723850}\n\n--\n\nwpt-commits: 1adf54a8705d5ee236731b0d4e01970ce1a4416f\nwpt-pr: 63921\n", "files": ["testing/web-platform/tests/media-capabilities/decodingInfo-webrtc.any.js", "testing/web-platform/tests/media-capabilities/encodingInfo-webrtc.any.js", "testing/web-platform/tests/media-capabilities/encodingInfo.any.js"], "git_node": "7d813b26ca2d737ffabf47d36aa8c21e8f1edfd1", "git_parents": ["1b753b2e4683fde29e0faba5cbd799b5f11f6b88"], "node": "25ea6e818814b4ea2a1690669b68781795443825", "parents": ["264262fe0e0871cfd35fedc9b30c560d7b6de273"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084483 [wpt PR 63921] - Update wpt metadata, a=testonly\n\nwpt-pr: 63921\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/media-capabilities/encodingInfo-webrtc.any.js.ini", "testing/web-platform/meta/media-capabilities/encodingInfo.any.js.ini"], "git_node": "fd88b7527a84a336bb2119da45d88fa53a65b3a3", "git_parents": ["7d813b26ca2d737ffabf47d36aa8c21e8f1edfd1"], "node": "d3474ef9c003f84cb02c39ac96de5054adcdda8f", "parents": ["25ea6e818814b4ea2a1690669b68781795443825"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2085267 [wpt PR 63973] - [html-in-canvas] Fully update property nodes on drawable changes, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Fully update property nodes on drawable changes\n\nThis patch forces an isolation-piercing subtree paint property update\nwhen an element's drawable state (`HasCanvasDrawableState()`) changes.\n\nFixed: 575201668\nChange-Id: I7297340322512a825c248ec7b3e1a92380281e23\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8613351\nAuto-Submit: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1723881}\n\n--\n\nwpt-commits: f3af6a89e7af65f14b54983e543e0cd0fb26d15f\nwpt-pr: 63973\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/filtered-div-drawable-added-ignored.tentative.https.sub.html"], "git_node": "9119019e1e46830fd63e7f9f094edf73be25c13d", "git_parents": ["fd88b7527a84a336bb2119da45d88fa53a65b3a3"], "node": "7ffb19604335200d6b2e08a330193ea7c6551e78", "parents": ["d3474ef9c003f84cb02c39ac96de5054adcdda8f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085267 [wpt PR 63973] - Update wpt metadata, a=testonly\n\nwpt-pr: 63973\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/filtered-div-drawable-added-ignored.tentative.https.sub.html.ini"], "git_node": "ccef3b528cc504f284b23c260dc942c3c83b630f", "git_parents": ["9119019e1e46830fd63e7f9f094edf73be25c13d"], "node": "8bc2c419ecb8c1a6867a1864fad0f5c6d400a958", "parents": ["7ffb19604335200d6b2e08a330193ea7c6551e78"], "tags": []}, {"author": "selya \u003cselya@chromium.org\u003e", "branch": "default", "desc": "Bug 2085213 [wpt PR 63963] - [Cookies] Port legacy path0015-test to WPT path-redirect.html, a=testonly\n\nAutomatic update from web-platform-tests\n[Cookies] Port legacy path0015-test to WPT path-redirect.html\n\nWhen httpRedirectCookieTest redirects to a directory path ending in '/',\nwptserve's DirectoryHandler returns an auto-generated directory listing\npage that does not include path-redirect-shared.js. Update\ngetAndExpireCookiesForRedirectTest() to read document.cookie from the\nsame-origin iframe and expire cookies directly when\npath-redirect-shared.js is not loaded.\n\nAdd test=18 to cookies/attributes/path-redirect.html to cover an exact\nredirected path match with a trailing '/'.\n\nBug: 40162492\nChange-Id: Ic87541dbbc78dc425f30ab3012c9ffc59c1051ea\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8594141\nReviewed-by: Jonathan Lee \u003cjonathanjlee@google.com\u003e\nAuto-Submit: Aaron Selya \u003cselya@google.com\u003e\nCommit-Queue: Aaron Selya \u003cselya@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1724032}\n\n--\n\nwpt-commits: 727c666bee6b7fca388996fb2a87bc1a31c4e033\nwpt-pr: 63963\n", "files": ["testing/web-platform/tests/cookies/attributes/path-redirect.html", "testing/web-platform/tests/cookies/resources/cookie-test.js"], "git_node": "21a618d10269947052589194b2cd1cd1d3c6ccf2", "git_parents": ["ccef3b528cc504f284b23c260dc942c3c83b630f"], "node": "3fc44a99846dcca3f270b3fda1b85dce10189ad1", "parents": ["8bc2c419ecb8c1a6867a1864fad0f5c6d400a958"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2084897 [wpt PR 63947] - Trigger interest when long-pressing ::interest-button, a=testonly\n\nAutomatic update from web-platform-tests\nTrigger interest when long-pressing ::interest-button\n\nUpdate InterestButtonPseudoElement::DefaultEventHandler to intercept\ngesturelongpress events in addition to click and keyboard activation,\ntriggering immediate interest in the originating element. Also update\nGestureManager::HandleGestureEventInFrame to dispatch gesture DOM\nevents to InnerPossiblyPseudoElement() so hit-testable pseudo elements\nreceive gesture events.\n\nThe equivalent change has been made to the interest invokers\nexplainer and spec PR:\n- https://open-ui.org/components/interest-invokers.explainer/\n- https://github.com/whatwg/html/pull/11006\n- https://drafts.csswg.org/css-pseudo-4/#selectordef-interest-button\n\nBug: 453705247\nChange-Id: Id5ca9d5fd7916bda7ec9e296f7fa5dbde4de3c5a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8593811\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724150}\n\n--\n\nwpt-commits: e551ebe4be77cc6c2f4d3b346fd1a8b505e948fb\nwpt-pr: 63947\n", "files": ["testing/web-platform/tests/html/semantics/interestfor/interestfor-pseudo-element.tentative.html"], "git_node": "833646b13f029c0eacb01665bfc68f86990a7c6e", "git_parents": ["21a618d10269947052589194b2cd1cd1d3c6ccf2"], "node": "4bc333b43ee1c95828fc3e318def6d0885c25000", "parents": ["3fc44a99846dcca3f270b3fda1b85dce10189ad1"], "tags": []}, {"author": "Michael Wilson \u003cmjwilson@chromium.org\u003e", "branch": "default", "desc": "Bug 2085498 [wpt PR 64065] - Pass signal through AnalyserNode when connected only to an AudioParam, a=testonly\n\nAutomatic update from web-platform-tests\nPass signal through AnalyserNode when connected only to an AudioParam\n\nAnalyserHandler::PullInputs() and AnalyserHandler::Process() previously\nchecked Output(0).RenderingFanOutCount() \u003e 0 to decide whether to pass\nthe input signal to Output(0).Bus(). Because RenderingFanOutCount() only\ncounts AudioNodeInput connections and ignores AudioParam connections, an\nAnalyserNode connected exclusively to an AudioParam left its output bus\nsilent even while recording the input into RealtimeAnalyser.\n\nUse Output(0).IsConnectedDuringRendering() instead so that AudioParam\nconnections also receive the pass-through audio signal.\n\nFixed: 574558290\nChange-Id: I4f607997ed356b5bbb480b6446f55758c50126b0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8613475\nCommit-Queue: Hongchan Choi \u003chongchan@google.com\u003e\nAuto-Submit: Michael Wilson \u003cmjwilson@chromium.org\u003e\nReviewed-by: Hongchan Choi \u003chongchan@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1724224}\n\n--\n\nwpt-commits: f2ba0f69fb917bf476b051acd3ae882b307cf171\nwpt-pr: 64065\n", "files": ["testing/web-platform/tests/webaudio/the-audio-api/the-analysernode-interface/test-analyser-output.html"], "git_node": "c936de4b285c364b3805ea53f5a8cb60cf504721", "git_parents": ["833646b13f029c0eacb01665bfc68f86990a7c6e"], "node": "111401e113b8a05db4f29858f89fcd2b818f08c0", "parents": ["4bc333b43ee1c95828fc3e318def6d0885c25000"], "tags": []}, {"author": "Stephen Chenney \u003cschenney@chromium.org\u003e", "branch": "default", "desc": "Bug 2085499 [wpt PR 64066] - Disable FEDisplacementMap for animated CSS backdrop-filter, a=testonly\n\nAutomatic update from web-platform-tests\nDisable FEDisplacementMap for animated CSS backdrop-filter\n\nThe composited animations code path was missed in the earlier CL\nto disable FEDisplacementMap for backdrop-filter. Fix the oversight.\n\nAlso move some animated filter effects WPT tests into the existing\nanimations directly, and enable that directory for the virtual/threaded\ntest suite so that we have coverage for composited filter animations.\n\nBug: 575826638\nChange-Id: I9b51a04945103b0913dbb1aae7acb9ddabef3747\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8624807\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Stephen Chenney \u003cschenney@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1724266}\n\n--\n\nwpt-commits: 95971004fb17cfd9a54fa5bdbd54e5b5efbdd2a9\nwpt-pr: 64066\n", "files": ["testing/web-platform/tests/css/filter-effects/WEB_FEATURES.yml", "testing/web-platform/tests/css/filter-effects/animation/WEB_FEATURES.yml", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-blur-ref.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-blur.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-brightness-ref.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-brightness.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-combined-ref.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-combined.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-contrast-ref.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-contrast.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-displacement-ref.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-displacement.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-drop-shadow-ref.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-drop-shadow.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-grayscale-ref.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-grayscale.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-hue-rotate-ref.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-hue-rotate.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-invert-ref.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-invert.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-opacity-ref.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-opacity.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-saturate-ref.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-saturate.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-sepia-ref.html", "testing/web-platform/tests/css/filter-effects/animation/css-backdrop-filters-animation-sepia.html", "testing/web-platform/tests/css/filter-effects/animation/css-filters-animation-blur-ref.html", "testing/web-platform/tests/css/filter-effects/animation/css-filt