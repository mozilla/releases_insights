eme-screenshots/scripts/capture-pair.sh", ".claude/skills/desktop-theme-screenshots/scripts/capture.js", ".claude/skills/desktop-theme-screenshots/scripts/pixel-diff.py", ".claude/skills/desktop-theme-screenshots/scripts/zoom-pair.py", ".claude/skills/desktop-theme-tokens/SKILL.md", ".claude/skills/desktop-theme-tokens/references/nova-overrides.md", ".claude/skills/desktop-theme-tokens/references/rem-roots.md", ".claude/skills/desktop-theme-tokens/references/theme-manifests.md", ".claude/skills/desktop-theme-tokens/references/token-history.md", ".claude/skills/desktop-theme-tokens/references/token-layers.md", ".claude/skills/desktop-theme-tokens/scripts/token-resolve.py", ".claude/skills/firefox-desktop-frontend/SKILL.md"], "git_node": "f3a0092b418f36405a642b3c940a84027c8a19ca", "git_parents": ["538887faa1ced2864ed95069cf286f17c2940d54"], "node": "de9ec0f39ccc5a99269baa6fe7793e6d52191be3", "parents": ["de36ecb21adb12fd6a68a811c0da917cd8572b7c"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1890278 - Don't start Remote Settings worker tasks once app shutdown has begun. r=gbeckley,remote-settings-reviewers\n\nThe worker only knew about shutdown once its profile-before-change blocker ran,\nso a get() resuming earlier in shutdown could still import a dump and\nre-instantiate the worker, hitting \"Try to init HttpHandler after shutdown\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339488\n", "files": ["services/settings/RemoteSettingsWorker.sys.mjs", "services/settings/test/unit/test_shutdown_handling.js"], "git_node": "9a127323d088cb2ceb7e8f116e68e460035195ca", "git_parents": ["f3a0092b418f36405a642b3c940a84027c8a19ca"], "node": "e06cc4bdfb6b65b131ec7af672328337d284e1fb", "parents": ["de9ec0f39ccc5a99269baa6fe7793e6d52191be3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2052707 - Defer destruction of detached element style data. r=smaug,sning\n\nMove the GC machinery to the root node of the rule tree in order to gc\nrule trees as we drop the deferred data.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338793\n", "files": ["dom/base/Element.cpp", "layout/style/GeckoBindings.cpp", "layout/style/GeckoBindings.h", "layout/style/ServoStyleSet.cpp", "servo/components/style/gecko/wrapper.rs", "servo/components/style/rule_tree/core.rs", "servo/ports/geckolib/glue.rs"], "git_node": "616dfb5ab578e1e31b6fcdca5dc8401bc9bbf41e", "git_parents": ["9a127323d088cb2ceb7e8f116e68e460035195ca"], "node": "6be57c58972f86fe3178c9fcdcbba161b269a5f0", "parents": ["e06cc4bdfb6b65b131ec7af672328337d284e1fb"], "tags": []}, {"author": "Marcin Kozi\u0144ski \u003cmkozinski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082835 - Add Tech Principles r=android-reviewers,ai4dev-reviewers,gmalekpour,pollymce,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338701\n", "files": [".agents/skills/android/SKILL.md", ".claude/skills/android/SKILL.md", "mobile/android/fenix/docs/Tech-Principles.md", "mobile/android/fenix/docs/index.md"], "git_node": "3200a2a1f1b58a5e359410bb41da8ccaeafba295", "git_parents": ["616dfb5ab578e1e31b6fcdca5dc8401bc9bbf41e"], "node": "4333b2180f8803baa2914f526bb58ef3bf85c037", "parents": ["6be57c58972f86fe3178c9fcdcbba161b269a5f0"], "tags": []}, {"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089997 - include sub/document label in Trusted Types telemetry r=tschuster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340283\n", "files": ["dom/base/Document.cpp", "dom/security/metrics.yaml", "dom/security/test/general/browser_trusted_types_readiness.js", "dom/security/test/general/file_trusted_types_readiness.sjs"], "git_node": "d08ad4a5c446457ff45b5811e21632c6ee33284e", "git_parents": ["3200a2a1f1b58a5e359410bb41da8ccaeafba295"], "node": "fc591a59838419ba8db0101965d1ef107f39fee3", "parents": ["4333b2180f8803baa2914f526bb58ef3bf85c037"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2089545 - Add WPT for VideoFrame copyTo RGBA sub-rect layout r=media-playback-reviewers,azebrowski\n\nCovers allocationSize() and copyTo() layout for a cropped RGBA frame, where the\nper-pixel sample count must be applied to the x offset and width (w3c/webcodecs#573).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339949\n", "files": ["testing/web-platform/tests/webcodecs/videoFrame-copyTo.any.js"], "git_node": "b3260f7aff75267870cb51403b4cc4733489b3b4", "git_parents": ["d08ad4a5c446457ff45b5811e21632c6ee33284e"], "node": "1dc941657b0f6a342b8d0984643661fc21e8d724", "parents": ["fc591a59838419ba8db0101965d1ef107f39fee3"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2082119 - Part 1: Report import map parse errors when it is safe to run script. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337506\n", "files": ["js/loader/ModuleLoaderBase.cpp"], "git_node": "b8c5c062de7133a4f84bd07d33c82708babcf31f", "git_parents": ["b3260f7aff75267870cb51403b4cc4733489b3b4"], "node": "e1b52dd6d271e09ac3f24cd9ac6a7c08b3d0dea1", "parents": ["1dc941657b0f6a342b8d0984643661fc21e8d724"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2089813 - Name the JSDoc API-reference cases in the documentation skill's description. r=sylvestre,ai4dev-reviewers,padenot DONTBUILD\" for causing documentation failures in SKILL.md\n\nThis reverts commit 8597fdb024831657cf9139c2cd6a6863cfd8cdd0.\n", "files": [".agents/skills/documentation/SKILL.md", ".claude/skills/documentation/SKILL.md"], "git_node": "8df556d58c609447ba0b677c0d7305748642981e", "git_parents": ["b8c5c062de7133a4f84bd07d33c82708babcf31f"], "node": "50a245b11936692bcef90f35e4deef9be0de72bb", "parents": ["e1b52dd6d271e09ac3f24cd9ac6a7c08b3d0dea1"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090028 - Expect navigateerror for a non-intercepted \u003ca download\u003e. r=farre\n\nThe test asserted that a non-intercepted \u003ca download\u003e fires neither\nnavigatesuccess nor navigateerror. The spec says otherwise:\n\n1. \"Download the hyperlink\" fires a download request navigate event,\n   then, if it was neither canceled nor intercepted, runs \"inform the\n   navigation API about aborting navigation\" on the same navigable:\n   https://html.spec.whatwg.org/multipage/links.html#downloading-hyperlinks\n\n2. When that event was fired, the inner navigate event firing\n   algorithm made it the navigation's ongoing navigate event, and\n   nothing clears it on the path that returns true:\n   https://html.spec.whatwg.org/multipage/nav-history-apis.html#inner-navigate-event-firing-algorithm\n\n3. \"Inform the navigation API about aborting navigation\" runs\n   synchronously when on the navigable's event loop, and aborts the\n   ongoing navigate event, which is now the download's own event:\n   https://html.spec.whatwg.org/multipage/nav-history-apis.html#inform-the-navigation-api-about-aborting-navigation\n\n4. \"Abort the ongoing navigation\" aborts the event's signal and fires\n   navigateerror:\n   https://html.spec.whatwg.org/multipage/nav-history-apis.html#abort-the-ongoing-navigation\n\nSo the download's navigate event must be followed by navigateerror.\n\nNo navigate event is fired for the download fetch itself. \"Download\nthe hyperlink\" never invokes \"navigate\", so the download request event\nis the only one.\n\nSee issue on WPT repo: https://github.com/web-platform-tests/wpt/issues/64851\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340295\n", "files": ["testing/web-platform/meta/navigation-api/ordering-and-transition/anchor-download.html.ini", "testing/web-platform/tests/navigation-api/ordering-and-transition/anchor-download.html"], "git_node": "94a5393db6e3df73c0689321835ffb0f7bea753e", "git_parents": ["8df556d58c609447ba0b677c0d7305748642981e"], "node": "492dca7538a178a6b8a48c59bfb99025ae36bd8a", "parents": ["50a245b11936692bcef90f35e4deef9be0de72bb"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2086565 - Record machine changes and the Windows profile type in the downgrade ping. r=xpcom-reviewers,niklas,TravisLong,jstutte\n\nA hash of the machine ID is stored in a pref on each startup so that the downgrade check can tell whether the profile was last used on a different machine. We also send whether the profile is a roaming profile or not.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337624\n", "files": ["toolkit/components/telemetry/docs/data/downgrade-ping.md", "toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsAppRunner.h", "toolkit/xre/test/gtest/TestDowngradePing.cpp"], "git_node": "cba3dc8af5f095814084d6e9c2bab5a5acd79485", "git_parents": ["94a5393db6e3df73c0689321835ffb0f7bea753e"], "node": "314119b029d7e8c2ff66277792cc93406f64416f", "parents": ["492dca7538a178a6b8a48c59bfb99025ae36bd8a"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079922; r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338171\n", "files": ["dom/base/Document.cpp"], "git_node": "37c1471c4ffdb34e6f5dac5e4c4eeda36e47e358", "git_parents": ["cba3dc8af5f095814084d6e9c2bab5a5acd79485"], "node": "cc2e2017556378b231424571532e8be3f294c89c", "parents": ["314119b029d7e8c2ff66277792cc93406f64416f"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2087787 - Add a perf reftest for this bug. r=perftest-reviewers,aglavic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338723\n", "files": ["testing/talos/talos/tests/perf-reftest-singletons/has-not-descendant-many-rules.html", "testing/talos/talos/tests/perf-reftest-singletons/perf_reftest_singletons.manifest"], "git_node": "45f173206fc453c3bc30d65b41954a5582b5728c", "git_parents": ["37c1471c4ffdb34e6f5dac5e4c4eeda36e47e358"], "node": "4c9adbf25e9acf99c6125c360e63cb3c032c393b", "parents": ["cc2e2017556378b231424571532e8be3f294c89c"], "tags": []}, {"author": "lottiehope \u003clottie_hope@hotmail.co.uk\u003e", "branch": "default", "desc": "Bug 2082519 - Show the QWAC statement and EU trust mark on the certificate details sub-page. r=android-reviewers,android-l10n-reviewers,Roger,parker\n\nThe trust mark drawables are converted from the desktop assets. Its colors must\nnot be altered, so the inverted asset is used on dark backgrounds instead of\ntinting it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340061\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/CertificateDetailsPanel.kt", "mobile/android/fenix/app/src/main/res/drawable/eu_trust_mark.xml", "mobile/android/fenix/app/src/main/res/drawable/eu_trust_mark_inverted.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "628e7eb3c2cf0988585792cd9e398a14a0a46125", "git_parents": ["45f173206fc453c3bc30d65b41954a5582b5728c"], "node": "1af6e1c74eeeff0036caea5d93a2cd2d83d9913b", "parents": ["4c9adbf25e9acf99c6125c360e63cb3c032c393b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2089681 - Let Typed OM ride the trains. r=janv,firefox-style-system-reviewers,layout-reviewers,webidl,dom-worker-reviewers,boris,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340066\n", "files": ["dom/serviceworkers/test/test_serviceworker_interfaces.js", "dom/tests/mochitest/general/test_interfaces.js", "dom/workers/test/test_worker_interfaces.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "d984003a0d48d79ad140407f0525d145d5415c65", "git_parents": ["628e7eb3c2cf0988585792cd9e398a14a0a46125"], "node": "a693d1ab3f55ecf2fce9fd9882f86c09ff9c1fff", "parents": ["1af6e1c74eeeff0036caea5d93a2cd2d83d9913b"], "tags": []}, {"author": "Joey Arhar \u003cjarhar@chromium.org\u003e", "branch": "default", "desc": "Bug 2083406 [wpt PR 63804] - Move \u003cpersistentwidget\u003e tests from wpt_internal to external/wpt, a=testonly\n\nAutomatic update from web-platform-tests\nMove \u003cpersistentwidget\u003e tests from wpt_internal to external/wpt\n\nBecause VirtualTestSuites configures the persistent-widgets virtual test\nsuite with \"exclusive_tests\":\"ALL\", the base wpt_internal/ tests are\nskipped. However, blink_wpt_tests runs with\nTestLists/content_shell.filter (which only includes explicitly\nallowlisted virtual/.../wpt_internal/* suites), and\nheadless_shell_wpt_tests and chrome_wpt_tests only run tests under\nexternal/wpt/. As a result, virtual/persistent-widgets was not running\non CQ/CI trybots when located in wpt_internal/.\n\nMoving the tests to external/wpt ensures that\nvirtual/persistent-widgets runs on CQ/CI trybots and allows routing the\nsuite to chrome_wpt_tests via TestLists/chrome.filter in a follow-up\npatch to run the tests on chrome instead of content_shell for more test\ncoverage.\n\nBug: 537818859\nChange-Id: Iff749149cb8f254280ee6aff144324b6bf34ae6c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8465024\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1721085}\n\n--\n\nwpt-commits: debccad31d4c4ee4e87e6cff01a6c23721bceb5c\nwpt-pr: 63804\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-persistentwidget-element/tentative/idlharness.window.js", "testing/web-platform/tests/interfaces/persistent-widgets.tentative.idl"], "git_node": "e34bd092488abc8fcca5c7338bd36260597af00d", "git_parents": ["d984003a0d48d79ad140407f0525d145d5415c65"], "node": "b668f1150ac99996d5e2ec63fae7aaf1294ff1bc", "parents": ["a693d1ab3f55ecf2fce9fd9882f86c09ff9c1fff"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083406 [wpt PR 63804] - Update wpt metadata, a=testonly\n\nwpt-pr: 63804\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/the-persistentwidget-element/tentative/idlharness.window.js.ini"], "git_node": "c235903f28cdcbb014e98d9da22c2a216cde4924", "git_parents": ["e34bd092488abc8fcca5c7338bd36260597af00d"], "node": "e4c9ffbbe2ff2ca8b5afd01ac03bc7435205b607", "parents": ["b668f1150ac99996d5e2ec63fae7aaf1294ff1bc"], "tags": []}, {"author": "Isaac Ahouma \u003ciahouma@google.com\u003e", "branch": "default", "desc": "Bug 2083405 [wpt PR 63802] - [Prompt API] Let samplingMode take precedence over legacy params, a=testonly\n\nAutomatic update from web-platform-tests\n[Prompt API] Let samplingMode take precedence over legacy params\n\nWhen both samplingMode and legacy sampling parameters (temperature or\ntopK) are provided in contexts where AIPromptAPILegacyParams is enabled,\nsuch as Chrome Extensions, let samplingMode take precedence and ignore\nthe legacy parameters after recording their deprecation warning instead\nof throwing a TypeError. This matches the behavior on web pages and\nallows callers to pass both during the migration period. Also switch\nLanguageModel.params(), LanguageModel.topK, and\nLanguageModel.temperature from MeasureAs to DeprecateAs in IDL.\n\nBug: 502214118\nChange-Id: I100cc0735f8e43d808b8ad4e05e13d616e1ee1b3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8591422\nCommit-Queue: Isaac Ahouma \u003ciahouma@google.com\u003e\nReviewed-by: Mike Wasserman \u003cmsw@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1721286}\n\n--\n\nwpt-commits: aee5e17b71a25b4ab4b8b5b9d4a0d632bddfbc5c\nwpt-pr: 63802\n", "files": ["testing/web-platform/tests/ai/language-model/language-model-availability-sampling-mode.tentative.https.window.js", "testing/web-platform/tests/ai/language-model/language-model-create-sampling-mode.tentative.https.window.js"], "git_node": "3c4ff23134fb0e29767231b2ed53545d7ae902d8", "git_parents": ["c235903f28cdcbb014e98d9da22c2a216cde4924"], "node": "9232e34e74961d735f364bb4f494d00c0d50ddfa", "parents": ["e4c9ffbbe2ff2ca8b5afd01ac03bc7435205b607"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083405 [wpt PR 63802] - Update wpt metadata, a=testonly\n\nwpt-pr: 63802\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/ai/language-model/language-model-availability-sampling-mode.tentative.https.window.js.ini"], "git_node": "6b16cd0f88916dd1b57d62332d1f9932888f511b", "git_parents": ["3c4ff23134fb0e29767231b2ed53545d7ae902d8"], "node": "6e8e026ada729943e1848b77eb2cf8435a13c0b0", "parents": ["9232e34e74961d735f364bb4f494d00c0d50ddfa"], "tags": []}, {"author": "Seongjin Kim \u003cmirusu400@gmail.com\u003e", "branch": "default", "desc": "Bug 2081315 [wpt PR 63597] - Update tspan gradients when text bounds change, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate tspan gradients when text bounds change\n\nA \u003ctspan\u003e gradient uses the bounding box of its containing \u003ctext\u003e\nelement. When that box changed, the \u003ctspan\u003e could keep using a gradient\ncalculated from the previous box.\n\nUpdate child SVG text resources when the \u003ctext\u003e bounding box changes.\n\nBug: 557821366\nChange-Id: I0952ff88dad4ff4c3851ab13896d6901f9ffff9b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8493051\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nCommit-Queue: Amos Lim \u003camoseui@chromium.org\u003e\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCr-Commit-Position: refs/heads/main@{#1721338}\n\n--\n\nwpt-commits: 51a43ba4adb079683518d0f567226e060ec72e86\nwpt-pr: 63597\n", "files": ["testing/web-platform/tests/svg/pservers/reftests/gradient-on-text-after-font-size-change-ref.html", "testing/web-platform/tests/svg/pservers/reftests/gradient-on-tspan-after-font-size-change.html", "testing/web-platform/tests/svg/pservers/reftests/gradient-on-use-context-fill-after-font-size-change.html"], "git_node": "8d54913e672e2213ba9e5f6b9ddf5fee33814adc", "git_parents": ["6b16cd0f88916dd1b57d62332d1f9932888f511b"], "node": "a34c2a1c301f6ebc84662fce2107546bf9197e1a", "parents": ["6e8e026ada729943e1848b77eb2cf8435a13c0b0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081315 [wpt PR 63597] - Update wpt metadata, a=testonly\n\nwpt-pr: 63597\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/pservers/reftests/gradient-on-use-context-fill-after-font-size-change.html.ini"], "git_node": "fd0a8401cc7bc9294ec6f9ce5f6b8bf2a6648e01", "git_parents": ["8d54913e672e2213ba9e5f6b9ddf5fee33814adc"], "node": "fc0f4ef426ac011823338301431ba23911818962", "parents": ["a34c2a1c301f6ebc84662fce2107546bf9197e1a"], "tags": []}, {"author": "Claudio Saavedra \u003ccsaavedra@igalia.com\u003e", "branch": "default", "desc": "Bug 2083429 [wpt PR 63810] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327805, a=testonly\n\nAutomatic update from web-platform-tests\n[OpenSSL] AES-KW unwrapKey accepts tampered wrapped keys\n\nAES_wrap_key() and AES_unwrap_key() return -1 on failure in BoringSSL\nbut 0 in OpenSSL, so with OpenSSL a failed integrity check was treated\nas success and unwrapKey resolved with an all-zero key. Treat 0 as a\nfailure too.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327805\nWebKit-Canonical-Link: https://commits.webkit.org/324035@main\n\n--\n\nwpt-commits: e15690d276ae50728b9d557f4e04f894588d34a0\nwpt-pr: 63810\n", "files": ["testing/web-platform/tests/WebCryptoAPI/wrapKey_unwrapKey/aes_kw_unwrapKey_failures.https.any.js"], "git_node": "6135fad4d4b9f6a6f096b6cad792d844ec002eb8", "git_parents": ["fd0a8401cc7bc9294ec6f9ce5f6b8bf2a6648e01"], "node": "cc4306e0d9603f410a4ff488ceb90ddb397ed8b7", "parents": ["fc0f4ef426ac011823338301431ba23911818962"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2083400 [wpt PR 63801] - Wait for the fragment parser to stop parsing when closing HTMLStream, a=testonly\n\nAutomatic update from web-platform-tests\nWait for the fragment parser to stop parsing when closing HTMLStream\n\nAlign HTMLStream's close algorithm with the spec\n(whatwg/html#12758): instead of resolving the close() promise\nimmediately after calling Finish(), wait until the fragment parser\nstops parsing in HTMLDocumentParser::PrepareToStopParsing().\n\nWhen the stream is blocked on a parser-blocking classic external script, `Finish()` marks EOF on the input stream and delays ending the parser\nuntil the script finishes and any remaining buffered input has been\nparsed. Running the close callback in PrepareToStopParsing() (just\nbefore AttemptToRunDeferredScriptsAndEnd()) ensures that close()\nresolves after all pending parser-blocking scripts have executed and all\nwritten input is in the DOM, while still resolving before defer and\nmodule scripts run in subsequent tasks.\n\nBug: 491743369\nChange-Id: I3e05d7b8a3bb8d6b0414281b33118960f7935f49\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8579606\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1721359}\n\n--\n\nwpt-commits: da4442adde45533bcf4451e0761ea7a905f3599c\nwpt-pr: 63801\n", "files": ["testing/web-platform/tests/domparsing/tentative/stream-html-parser-blocking-script.html"], "git_node": "f4e297fbac4e759c41eb76923f6d50b403122a38", "git_parents": ["6135fad4d4b9f6a6f096b6cad792d844ec002eb8"], "node": "4727eb5de121f33e5802ba7b1178d6f1c475e4f3", "parents": ["cc4306e0d9603f410a4ff488ceb90ddb397ed8b7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083400 [wpt PR 63801] - Update wpt metadata, a=testonly\n\nwpt-pr: 63801\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/tentative/stream-html-parser-blocking-script.html.ini"], "git_node": "7bea66f9b9db3103355db3a9fb0d1b8d574bef1c", "git_parents": ["f4e297fbac4e759c41eb76923f6d50b403122a38"], "node": "2eeb6e6ba57bf169552c281d4abd9af2e4d014fb", "parents": ["4727eb5de121f33e5802ba7b1178d6f1c475e4f3"], "tags": []}, {"author": "Elika Etemad \u003cfantasai.bugs@inkedblade.net\u003e", "branch": "default", "desc": "Bug 2083454 [wpt PR 63817] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324348, a=testonly\n\nAutomatic update from web-platform-tests\nREGRESSION(Safari 27): anchored box inside modal dialog missing if page is scrolled\n\n311715@main rewrote the body of offsetFromAncestorContainer() to use\nlocalToContainerQuad(); however in the process it lost the ancestor checks\nfor isFixed. This is causing the anchor position to be incorrectly calculated\nwhen layout happens after scrolling away from the origin--for example\nif a fixed box contains a non-positioned anchor for an anchor-positioned\nfixed child--resulting in the anchored box being laid out offscreen, and\nthus entirely invisible.\n\nThis updates our isFixed() helper to handle boxes that don't themselves\nhave a RenderLayer, which fixes this problem... and prossibly some other\nscenarios as well.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324348\nWebKit-Canonical-Link: https://commits.webkit.org/321475@main\n\n--\n\nwpt-commits: 470a7adf88ce3f2772ebe2aa2308334ed4e7b98a\nwpt-pr: 63817\n", "files": ["testing/web-platform/tests/css/css-anchor-position/anchor-fixedpos-nested-scroll-001-ref.html", "testing/web-platform/tests/css/css-anchor-position/anchor-fixedpos-nested-scroll-001.html"], "git_node": "0f1827670e17f058bcc13db6c1c4368767e7abd0", "git_parents": ["7bea66f9b9db3103355db3a9fb0d1b8d574bef1c"], "node": "5757bf023a6bf70dc137f33d40e153626ed5bf74", "parents": ["2eeb6e6ba57bf169552c281d4abd9af2e4d014fb"], "tags": []}, {"author": "Mike Wasserman \u003cmsw@chromium.org\u003e", "branch": "default", "desc": "Bug 2083396 [wpt PR 63798] - Built-In AI APIs: Promote and harden ResolverWithAbortSignal, a=testonly\n\nAutomatic update from web-platform-tests\nBuilt-In AI APIs: Promote and harden ResolverWithAbortSignal\n\nMove ResolverWithAbortSignal to modules/ai/ and harden its Cleanup(),\nOnAborted(), Resolve(), and Reject() handling.\nSimplify RejectOnDestruction() in ai_utils.h.\nAdopt in DecisionModel::decide(),\nAIWritingAssistanceBase::measureInputUsage(), and\nLanguageModel::measureContextUsage().\n\nBug: 468104678, 424659255, 565849508\nChange-Id: I4841ffe9fbc23dedfe4e6163403d40b758349104\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8590307\nCommit-Queue: Mike Wasserman \u003cmsw@chromium.org\u003e\nReviewed-by: Nathan Memmott \u003cmemmott@chromium.org\u003e\nAuto-Submit: Mike Wasserman \u003cmsw@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1721419}\n\n--\n\nwpt-commits: 51af97519fae8e9f69dd8158e238444c87604f85\nwpt-pr: 63798\n", "files": ["testing/web-platform/tests/ai/summarizer/summarizer-abort.tentative.https.window.js"], "git_node": "d4e45ffa086ac45286e66e2196a0023fbfc40efb", "git_parents": ["0f1827670e17f058bcc13db6c1c4368767e7abd0"], "node": "d55d7803cd4a6f700e83a97d4b1f453db581a3d3", "parents": ["5757bf023a6bf70dc137f33d40e153626ed5bf74"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083396 [wpt PR 63798] - Update wpt metadata, a=testonly\n\nwpt-pr: 63798\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/ai/summarizer/summarizer-abort.tentative.https.window.js.ini"], "git_node": "9fd2b52950270080768914d0757f93dc409125db", "git_parents": ["d4e45ffa086ac45286e66e2196a0023fbfc40efb"], "node": "f43150d490935eba8174160f72073e43b62a2555", "parents": ["d55d7803cd4a6f700e83a97d4b1f453db581a3d3"], "tags": []}, {"author": "Mike Wasserman \u003cmsw@chromium.org\u003e", "branch": "default", "desc": "Bug 2083455 [wpt PR 63837] - Built-In AI APIs: Consolidate synthetic create monitor progress updates, a=testonly\n\nAutomatic update from web-platform-tests\nBuilt-In AI APIs: Consolidate synthetic create monitor progress updates\n\nConsolidate the duplicate 0 and 100% download progress completion\ndispatch into AIContextObserver::CompleteDownloadProgress.\nWire CompleteDownloadProgress into CreateSemanticEmbedderClient and\nCreateDecisionModelClient for consistent progress dispatch when models\nare already available.\nAlign WPT create monitor test coverage across all Built-In AI APIs.\n\nBug: 468104678, 565849508\nChange-Id: Iebc4f3a1f4e6c2b767249b040baeaa1a4525943e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8511697\nAuto-Submit: Mike Wasserman \u003cmsw@chromium.org\u003e\nCommit-Queue: Mike Wasserman \u003cmsw@chromium.org\u003e\nReviewed-by: Nathan Memmott \u003cmemmott@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1721451}\n\n--\n\nwpt-commits: 23b0b89b1a472cac446e3c6e75fc7d6254913ef0\nwpt-pr: 63837\n", "files": ["testing/web-platform/tests/ai/decision-model/decision-model.tentative.https.window.js", "testing/web-platform/tests/ai/language-model/language-model-create.tentative.https.window.js", "testing/web-platform/tests/ai/language_detection/detector.https.window.js", "testing/web-platform/tests/ai/proofreader/proofreader-create-available.tentative.https.window.js", "testing/web-platform/tests/ai/proofreader/proofreader-create.tentative.https.window.js", "testing/web-platform/tests/ai/semantic_embedder/semantic-embedder-create.tentative.https.window.js", "testing/web-platform/tests/ai/semantic_embedder/semantic-embedder-downloadprogress.tentative.https.window.js", "testing/web-platform/tests/ai/translator/translator.https.window.js"], "git_node": "3c94eabd03b70e1200d00b884d35e2c7567a46af", "git_parents": ["9fd2b52950270080768914d0757f93dc409125db"], "node": "be1ce1093388bc2c31251af90a78eafc685b00bf", "parents": ["f43150d490935eba8174160f72073e43b62a2555"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083455 [wpt PR 63837] - Update wpt metadata, a=testonly\n\nwpt-pr: 63837\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/ai/decision-model/decision-model.tentative.https.window.js.ini", "testing/web-platform/meta/ai/language-model/language-model-create.tentative.https.window.js.ini", "testing/web-platform/meta/ai/language_detection/detector.https.window.js.ini", "testing/web-platform/meta/ai/proofreader/proofreader-create-available.tentative.https.window.js.ini", "testing/web-platform/meta/ai/proofreader/proofreader-create.tentative.https.window.js.ini", "testing/web-platform/meta/ai/semantic_embedder/semantic-embedder-create.tentative.https.window.js.ini", "testing/web-platform/meta/ai/translator/translator.https.window.js.ini"], "git_node": "dbebed84dec94818693cd8663e0efc291f28334f", "git_parents": ["3c94eabd03b70e1200d00b884d35e2c7567a46af"], "node": "54708303d57ffbc5e1bf8a1f4bfa205cd4749112", "parents": ["be1ce1093388bc2c31251af90a78eafc685b00bf"], "tags": []}, {"author": "Stefan Zager \u003cszager@chromium.org\u003e", "branch": "default", "desc": "Bug 2083457 [wpt PR 63836] - [HiC] Make canvas break out of the enclosing decorating box, a=testonly\n\nAutomatic update from web-platform-tests\n[HiC] Make canvas break out of the enclosing decorating box\n\nThe rules for breaking out of the decorating box for text-decoration\nare specified at:\n\nhttps://drafts.csswg.org/css-text-decor-4/#line-decoration\n\nCanvas elements don't qualify because they are display:inline rather\nthan display:inline-block. However, it makes little sense to include\ncanvas contents in the enclosing decorating box, and it also leaks\nvisited link colors.\n\nFixed: 541436684\nChange-Id: Idfc8219e22553a2be9e946e361d701c8cdf14850\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8603748\nCommit-Queue: Stefan Zager \u003cszager@chromium.org\u003e\nReviewed-by: Stephen Chenney \u003cschenney@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1721453}\n\n--\n\nwpt-commits: 850b36a56cfc15b9117a9d222d32a63104662f49\nwpt-pr: 63836\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/visited-link/visited-link-decorating-box-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/visited-link/visited-link-decorating-box.tentative.html"], "git_node": "d710058d12998387311770dc23bce94a27e74b8e", "git_parents": ["dbebed84dec94818693cd8663e0efc291f28334f"], "node": "2ea936a5651177885b0b94285765b6b485ca5a9b", "parents": ["54708303d57ffbc5e1bf8a1f4bfa205cd4749112"], "tags": []}, {"author": "Shannon Booth \u003cshannon.ml.booth@gmail.com\u003e", "branch": "default", "desc": "Bug 2083550 [wpt PR 63854] - Test Blob.text() byte order mark handling, a=testonly\n\nAutomatic update from web-platform-tests\nTest Blob.text() byte order mark handling\n\nBlob.text() uses UTF-8 decode, which strips one UTF-8 BOM and does not\nswitch encoding on a UTF-16 BOM.\n\n--\n\nwpt-commits: 0f26972422b15f587e2afbd38dbb6ea2397fded0\nwpt-pr: 63854\n", "files": ["testing/web-platform/tests/FileAPI/blob/Blob-text.any.js"], "git_node": "31d755a9834370685ed9621a43a4e449b9ac0f1b", "git_parents": ["d710058d12998387311770dc23bce94a27e74b8e"], "node": "a16da509c5eb802ad05ccfab2b5db09026c0b0bf", "parents": ["2ea936a5651177885b0b94285765b6b485ca5a9b"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2083497 [wpt PR 63833] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327936, a=testonly\n\nAutomatic update from web-platform-tests\nOnly top-level data: documents should be non-secure contexts\n\nSince opaque origins stopped being potentially trustworthy in 222036@main, a data: document has\nnot been a secure context, except in a sandboxed frame, where its URL is checked instead. That\nchange was aimed at top-level data: documents, which have no secure creator. In a frame, HTML\nmakes a data: document as secure as its parent, and so does Gecko. The proposal in\nhttps://github.com/whatwg/html/issues/12091 which follows\nhttps://github.com/w3c/webappsec-secure-contexts/issues/69 is to keep that and to only make a\ntop-level data: document not a secure context.\n\nA data: document in a frame now takes its parent's state, and a top-level one is not a secure\ncontext. WebPageProxy::topLevelIsSecureContext(), added in 323985@main, treated a top-level data:\ndocument as secure, and so honored Origin-Agent-Cluster for its frames; it now agrees.\n\nFour WPTs are affected:\n\n- secure-contexts/basic-popup-and-iframe-tests.https.html, which expects a data: frame to be a\n  secure context when its creator is one, now passes.\n- fs/opaque-origin.https.window.html, which expects FileSystemDirectoryHandle to be defined in a\n  data: frame, now passes.\n- digital-credentials/get-opaque-origin-combinations.https.html expected a data: frame not to be a\n  secure context. It now expects get() there to reject for its opaque origin, like in the other\n  opaque-origin frames.\n- credential-management/credentialscontainer-frame-basics.https.html expected navigator.credentials\n  to be undefined in a data: frame. It now expects it to be defined.\n\nTwo WebKit tests covered the old behavior. http/tests/security/iframe-unique-origin.https.html\nasserted that a data: frame is not a secure context, which the secure-contexts WPT above covers, so\nit is removed. http/tests/web-locks/web-lock-in-data-url.html only checked that navigator.locks is\nundefined there; as with the sandboxed srcdoc test it now expects request() to reject, since the\norigin is still opaque.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327936\n\n--\n\nwpt-commits: e2955dc1edc6de9af67d71e616cd6c1d68182c6d\nwpt-pr: 63833\n", "files": ["testing/web-platform/tests/credential-management/credentialscontainer-frame-basics.https.html", "testing/web-platform/tests/digital-credentials/get-opaque-origin-combinations.https.html", "testing/web-platform/tests/html/browsers/origin/origin-keyed-agent-clusters/data-frame-child.https.sub.html"], "git_node": "3e42ea7c5951eb0d5e5ca59e0f795d8484c657ac", "git_parents": ["31d755a9834370685ed9621a43a4e449b9ac0f1b"], "node": "41e43075f60b1ba38e4247c59a5aa38224c43f54", "parents": ["a16da509c5eb802ad05ccfab2b5db09026c0b0bf"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083497 [wpt PR 63833] - Update wpt metadata, a=testonly\n\nwpt-pr: 63833\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/digital-credentials/get-opaque-origin-combinations.https.html.ini"], "git_node": "712a3d08032ceccbd413a5b5724aae3649a2c7d5", "git_parents": ["3e42ea7c5951eb0d5e5ca59e0f795d8484c657ac"], "node": "a07292a3856b2efdcf3309332ef846a6f24c129b", "parents": ["41e43075f60b1ba38e4247c59a5aa38224c43f54"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083495 [wpt PR 63832] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323287, a=testonly\n\nAutomatic update from web-platform-tests\nREGRESSION (Safari 27): line-height quirk not applied inside inline-block\n\nIn quirks mode the line-height quirk applies to line break boxes too, since a \u003cbr\u003e has no text content.\n310839@main made a \u003cbr\u003e with a non-normal line-height stretch the line box unconditionally, so a line-height\ninherited from an ancestor started stretching lines that have other content on them. Now the \u003cbr\u003e only\nstretches the line box when there's nothing else on the line to do it.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323287\nWebKit-Canonical-Link: https://commits.webkit.org/320514@main\n\n--\n\nwpt-commits: 9f5ea07b32478095c6e41e0352cb60491a14986d\nwpt-pr: 63832\n", "files": ["testing/web-platform/tests/css/css-inline/br-line-height-inherited-quirks-ref.html", "testing/web-platform/tests/css/css-inline/br-line-height-inherited-quirks.html"], "git_node": "e9c2b1dae9365a2c3e0554e4dc9692d73271a28f", "git_parents": ["712a3d08032ceccbd413a5b5724aae3649a2c7d5"], "node": "bf2e123f5e3870b71a29dfdb5fba02d98a4f8b25", "parents": ["a07292a3856b2efdcf3309332ef846a6f24c129b"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2083492 [wpt PR 63831] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322716, a=testonly\n\nAutomatic update from web-platform-tests\nSVGLength resolves 'ex' by rounding the font's x-height up to a whole pixel\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nSVGLengthContext resolved the 'ex' unit by applying std::ceil() to the\nprimary font's x-height before multiplying, so the SVG DOM\n(baseVal.value / valueInSpecifiedUnits) disagreed with getComputedStyle\nfor the same element: e.g. Helvetica at 20px (x-height ~10.459px) gave\nx=\"2ex\" as 22 (2 x ceil(10.459)) via the DOM but 20.898438px via\ngetComputedStyle. Per spec, 'ex' resolves against the computed font\nx-height with no rounding:\nhttps://w3c.github.io/svgwg/svg2-draft/types.html#__svg__SVGLength__value\n\nThe ceil() dated back to SVG 1.1; SVG 2 does not mandate any such\nrounding.\n\nThe ceil() carried a comment noting it existed solely to get a pixel\nmatch against the W3C SVG 1.1 expected output of coords-units-03-b.svg,\nand that it might be best to remove it if it ever caused problems in\nreal-world cases. That is now the case: WebKit is the only engine still\napplying this rounding, Firefox and Chrome both dropped it, and SVG 2\nsays nothing about rounding 'ex'. We therefore knowingly deviate from\nthe SVG 1.1 test (rebaselining coords-units-03-b) in favor of interop\nwith other browsers and conformance to SVG 2.\n\nRemove the ceil() in both conversion directions.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=322716\nWebKit-Canonical-Link: https://commits.webkit.org/320606@main\n\n--\n\nwpt-commits: b26a9b17adb4a39be2961aa9b8008a73265fa77a\nwpt-pr: 63831\n", "files": ["testing/web-platform/tests/svg/types/scripted/SVGLength-ex.html"], "git_node": "57cac9d06b03f7c1cf83fa9b1402ab4023572759", "git_parents": ["e9c2b1dae9365a2c3e0554e4dc9692d73271a28f"], "node": "3cd46053eaffcbc9ffbb678fa2a6a578c5bce6f9", "parents": ["bf2e123f5e3870b71a29dfdb5fba02d98a4f8b25"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083492 [wpt PR 63831] - Update wpt metadata, a=testonly\n\nwpt-pr: 63831\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/types/scripted/SVGLength-ex.html.ini"], "git_node": "3374b26ec7955a37f89d698d18370548df5765e3", "git_parents": ["57cac9d06b03f7c1cf83fa9b1402ab4023572759"], "node": "17bc14320d099e373bfbb67b17a3dbe85c8c0716", "parents": ["3cd46053eaffcbc9ffbb678fa2a6a578c5bce6f9"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083489 [wpt PR 63829] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323466, a=testonly\n\nAutomatic update from web-platform-tests\nTab character renders too narrow when tab-size is small (proportional fonts)\n\n    \u003cdiv style=\"font: 32px serif; white-space: pre; tab-size: 0.4ch\"\u003e&#9;&#9;&#9;\u003c/div\u003e\n\nEach tab should advance to the second tab stop, making the run 2.4ch wide. Instead it advanced to the first one and the run was 1.2ch.\n\nA tab is not a glyph but a shift to the next tab stop, and a shift too short to read as a tab takes the subsequent stop instead.\nThe spec measures \"too short\" against 0.5ch, half the advance of the \"0\" glyph, while we measured it against the space character.\nIn a proportional font the space is a lot narrower than the \"0\" (2.2px vs 4px in 16px Times)\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323466\nWebKit-Canonical-Link: https://commits.webkit.org/320671@main\n\n--\n\nwpt-commits: 6dea36165a6b27d329b888837c281a41845bb850\nwpt-pr: 63829\n", "files": ["testing/web-platform/tests/css/css-text/white-space/reference/tab-stop-threshold-007-ref.html", "testing/web-platform/tests/css/css-text/white-space/tab-stop-threshold-007.html"], "git_node": "053780daa2a73ce4cabed0f3ec267d42dc151932", "git_parents": ["3374b26ec7955a37f89d698d18370548df5765e3"], "node": "ec1a04624e82539e73a0e7359c69d8b2c44d0d96", "parents": ["17bc14320d099e373bfbb67b17a3dbe85c8c0716"], "tags": []}, {"author": "Sergio Villar Senin \u003csvillar@igalia.com\u003e", "branch": "default", "desc": "Bug 2083486 [wpt PR 63828] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323656, a=testonly\n\nAutomatic update from web-platform-tests\nREGRESSION(r311167): It made hit testing fail whenever offsetRay was not specified\n\n311167@main broke hit testing because it added\n[ImplementationDefaultValue=null] to offsetRay which is not a nullable\ndictionary member (it's simply optional). When offsetRay was not\nspecified (and considering that a default null value was declared) then\nJSToWrappedOverloader\u003cWebXRRay\u003e::toWrapped() converted the undefined\nfrom the dictionary into a nullptr which causes JSDOMCovertInterface to\nthrow a TypeError (because a missing wrapper is considered as an error).\n\nWe are adding a new WPT test that properly detects whether the absence\nof optional parameters passed to request(Transient)HitTestSource do not\ntrigger exceptions.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323656\nWebKit-Canonical-Link: https://commits.webkit.org/320717@main\n\n--\n\nwpt-commits: bfb760e9e28eebc91b9c7d4d5c021d3eee671b7a\nwpt-pr: 63828\n", "files": ["testing/web-platform/tests/webxr/hit-test/ar_hittest_subscription_optional_offsetRay.https.html"], "git_node": "d05ec80cb8a3f1a341a5e15ceb3f6295d9fc8210", "git_parents": ["053780daa2a73ce4cabed0f3ec267d42dc151932"], "node": "8972fd3009f047e88bd346db2c223fafb6e39263", "parents": ["ec1a04624e82539e73a0e7359c69d8b2c44d0d96"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083486 [wpt PR 63828] - Update wpt metadata, a=testonly\n\nwpt-pr: 63828\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webxr/hit-test/ar_hittest_subscription_optional_offsetRay.https.html.ini"], "git_node": "e735217265606f7ed7d65c93ccdc3337230fc9e0", "git_parents": ["d05ec80cb8a3f1a341a5e15ceb3f6295d9fc8210"], "node": "ce5926c68c69763c3df222188a828249b4c00607", "parents": ["8972fd3009f047e88bd346db2c223fafb6e39263"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083482 [wpt PR 63827] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323782, a=testonly\n\nAutomatic update from web-platform-tests\n[IFC] Stop adjusting the display, float and clear values of line break boxes\n\nThis is in preparation for not adjusting computed style for layout boxes.\n\n\u003cbr\u003e and \u003cwbr\u003e in-flow display was forced to inline, float to none and, for \u003cwbr\u003e, clear to none.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323782\nWebKit-Canonical-Link: https://commits.webkit.org/320828@main\n\n--\n\nwpt-commits: c5efadfc13cd018e0923d067d66ea70745151fad\nwpt-pr: 63827\n", "files": ["testing/web-platform/tests/html/rendering/non-replaced-elements/the-br-element/br-and-wbr-with-non-inline-display-ref.html", "testing/web-platform/tests/html/rendering/non-replaced-elements/the-br-element/br-and-wbr-with-non-inline-display.html"], "git_node": "b75928f3d7d2f1ab78ec872abb626e3b79f250ac", "git_parents": ["e735217265606f7ed7d65c93ccdc3337230fc9e0"], "node": "cf12f23cfc6fcc745dcef0b7f21e3bb8bfd80aef", "parents": ["ce5926c68c69763c3df222188a828249b4c00607"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083482 [wpt PR 63827] - Update wpt metadata, a=testonly\n\nwpt-pr: 63827\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/rendering/non-replaced-elements/the-br-element/br-and-wbr-with-non-inline-display.html.ini"], "git_node": "a01f0f54a19a8a64737e3ec8e7b85f88e708c391", "git_parents": ["b75928f3d7d2f1ab78ec872abb626e3b79f250ac"], "node": "3cffa453f6c67ad2758dafd49b910e9d89f1da3d", "parents": ["cf12f23cfc6fcc745dcef0b7f21e3bb8bfd80aef"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083481 [wpt PR 63826] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323803, a=testonly\n\nAutomatic update from web-platform-tests\n[IFC] Stop adjusting internal table and table caption display values to block\n\nThis is in preparation for not adjusting computing style for layout boxes.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323803\nWebKit-Canonical-Link: https://commits.webkit.org/320891@main\n\n--\n\nwpt-commits: 7d4c8a69ff08be3c7f4713b4e74f3821b55b49e9\nwpt-pr: 63826\n", "files": ["testing/web-platform/tests/css/css-display/table-display-on-fieldset-ref.html", "testing/web-platform/tests/css/css-display/table-display-on-fieldset.html"], "git_node": "01121de11c3d35211660dded0c3f1a9c475c90fe", "git_parents": ["a01f0f54a19a8a64737e3ec8e7b85f88e708c391"], "node": "a6db03d67522c28e299725d71d73fe4c648d97b1", "parents": ["3cffa453f6c67ad2758dafd49b910e9d89f1da3d"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083491 [wpt PR 63830] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323503, a=testonly\n\nAutomatic update from web-platform-tests\n[css-content] A gradient in the content property paints blank\n\nRenderImage only painted when it had a CachedImage behind it, so a generated image (gradient, cross-fade,\ncanvas) drew the missing image state instead.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323503\nWebKit-Canonical-Link: https://commits.webkit.org/320620@main\n\n--\n\nwpt-commits: d3e8e86147770d1f581359e38237033a9d4d6bc7\nwpt-pr: 63830\n", "files": ["testing/web-platform/tests/css/css-content/pseudo-element-gradient-ref.html", "testing/web-platform/tests/css/css-content/pseudo-element-gradient.html", "testing/web-platform/tests/css/css-content/pseudo-element-image-set-ref.html", "testing/web-platform/tests/css/css-content/pseudo-element-image-set.html"], "git_node": "2546580b93f014e44d257c2c0204c8002e460246", "git_parents": ["01121de11c3d35211660dded0c3f1a9c475c90fe"], "node": "8a64989fc4371fa9b24a3832ec7d59c47f57e494", "parents": ["a6db03d67522c28e299725d71d73fe4c648d97b1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083491 [wpt PR 63830] - Update wpt metadata, a=testonly\n\nwpt-pr: 63830\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-content/pseudo-element-gradient.html.ini", "testing/web-platform/meta/css/css-content/pseudo-element-image-set.html.ini"], "git_node": "3fd61c6126afcf028cbb8d91c19576bc84013399", "git_parents": ["2546580b93f014e44d257c2c0204c8002e460246"], "node": "76d27eb9b446f7765a2374630ea31ec2f6c69132", "parents": ["8a64989fc4371fa9b24a3832ec7d59c47f57e494"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083480 [wpt PR 63825] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323799, a=testonly\n\nAutomatic update from web-platform-tests\n[IFC] Stop adjusting the display value of inline boxes with a non-inline display\n\nThis is in preparation for not adjusting computed style for layout boxes.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323799\nWebKit-Canonical-Link: https://commits.webkit.org/320833@main\n\n--\n\nwpt-commits: 30013c8869793751f497533647478dae455a8724\nwpt-pr: 63825\n", "files": ["testing/web-platform/tests/css/css-display/display-on-svg-text-content-element-ref.html", "testing/web-platform/tests/css/css-display/display-on-svg-text-content-element.html"], "git_node": "7015bcb839d0cb7ed5c58ff1d1a83ba23104b704", "git_parents": ["3fd61c6126afcf028cbb8d91c19576bc84013399"], "node": "55f7151403428b5f9f565b527f6801bda528ca06", "parents": ["76d27eb9b446f7765a2374630ea31ec2f6c69132"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083479 [wpt PR 63824] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323802, a=testonly\n\nAutomatic update from web-platform-tests\n[IFC] Stop adjusting display: inline to inline-block on block container boxes\n\nThis is in preparation for not adjusting computed style for layout boxes.\n\nSome elements always get a block container renderer, whatever their computed\ndisplay value is (e.g. \u003cinput style=\"display: inline\"\u003e or\n\u003cfieldset style=\"display: inline\"\u003e).\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323802\nWebKit-Canonical-Link: https://commits.webkit.org/320872@main\n\n--\n\nwpt-commits: b76d3b0de81d770e01ac341d0a36ab9b8e574024\nwpt-pr: 63824\n", "files": ["testing/web-platform/tests/css/css-display/display-inline-on-block-container-ref.html", "testing/web-platform/tests/css/css-display/display-inline-on-block-container.html"], "git_node": "56a31beae42faa9eecb9a36422fc33aeb5c1930c", "git_parents": ["7015bcb839d0cb7ed5c58ff1d1a83ba23104b704"], "node": "8d3bcf562e8cb1591e1bf99a63e3689e85c0fd4d", "parents": ["55f7151403428b5f9f565b527f6801bda528ca06"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083478 [wpt PR 63823] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323818, a=testonly\n\nAutomatic update from web-platform-tests\n[IFC] Stop forwarding overflow and text-overflow to anonymous block boxes\n\nThis is preparation for not adjusting computed style for layout boxes.\n\noverflow and text-overflow are not inherited, so an anonymous block box holding\nthe inline content of a block container gets the initial values while the block\ncontainer is the one asking for the truncation.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=323818\nWebKit-Canonical-Link: https://commits.webkit.org/320922@main\n\n--\n\nwpt-commits: 86b76074a20684fbf989be5fa286aba2052e283a\nwpt-pr: 63823\n", "files": ["testing/web-platform/tests/css/css-overflow/text-overflow-in-anonymous-block-ref.html", "testing/web-platform/tests/css/css-overflow/text-overflow-in-anonymous-block.html"], "git_node": "407ed946160b0e1bb46ff320c2165f7b44ed62b7", "git_parents": ["56a31beae42faa9eecb9a36422fc33aeb5c1930c"], "node": "d27a32ee6d34a87c361a059d66974fa55ce09a95", "parents": ["8d3bcf562e8cb1591e1bf99a63e3689e85c0fd4d"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083476 [wpt PR 63821] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324063, a=testonly\n\nAutomatic update from web-platform-tests\n[out-of-flow] Resolved right and bottom are wrong inside a vertical inline containing block\n\nThe resolved value of an auto right or bottom subtracts offsetLeft, offsetWidth and marginRight, all physical, from the containing block's padding box, so it needs that box's physical width or height.\nRenderInline::innerPaddingBoxWidth and innerPaddingBoxHeight are logical, which matches only in a horizontal writing mode; in vertical-rl a span 20px wide and 40px tall reported right as 40px instead of 20px.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324063\nWebKit-Canonical-Link: https://commits.webkit.org/321061@main\n\n--\n\nwpt-commits: 02931d05721ae783137b57ef3ef2022b48dc6ad2\nwpt-pr: 63821\n", "files": ["testing/web-platform/tests/css/cssom/getComputedStyle-inset-inline-containing-block-vertical.html"], "git_node": "430c4b7db6d8b33f10ed0f2f8933330bb4498473", "git_parents": ["407ed946160b0e1bb46ff320c2165f7b44ed62b7"], "node": "73eff66eafee2e4cdaadf1cecd371a7d5b1896ff", "parents": ["d27a32ee6d34a87c361a059d66974fa55ce09a95"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083476 [wpt PR 63821] - Update wpt metadata, a=testonly\n\nwpt-pr: 63821\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/cssom/getComputedStyle-inset-inline-containing-block-vertical.html.ini"], "git_node": "448c2369c74d47da8da22a114ca2901ef44c6243", "git_parents": ["430c4b7db6d8b33f10ed0f2f8933330bb4498473"], "node": "34f36f713298fe4ab67102fbec276d6a19e3961b", "parents": ["73eff66eafee2e4cdaadf1cecd371a7d5b1896ff"], "tags": []}, {"author": "Simon Fraser \u003csimon.fraser@apple.com\u003e", "branch": "default", "desc": "Bug 2083477 [wpt PR 63822] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=201905, a=testonly\n\nAutomatic update from web-platform-tests\nshape-outside should support path() and shape() functions\n\nSupport `path()` and `shape()` functions in `shape-outside`. This is now easy after 320552@main,\nwhich made `shape-outside` respect `corner-shape` by building a polygon to approximate the\npath. We can then feed that polygon into the existing exclusion logic.\n\n`LayoutShape::createShape()` now returns a `PathLayoutShape` which contains the flattened\npath, and `PathLayoutShape` implements `getExcludedInterval()`.\n\nBased on work by Lilly Le (@cupidsity).\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=201905\nWebKit-Canonical-Link: https://commits.webkit.org/321010@main\n\n--\n\nwpt-commits: ec416985d5beba44ba25111117972e87f14cf798\nwpt-pr: 63822\n", "files": ["testing/web-platform/tests/css/css-shapes/shape-outside-shape-function.html"], "git_node": "3cc33180de46c9d6c9a43d0e5d2a2d29ec7288f5", "git_parents": ["448c2369c74d47da8da22a114ca2901ef44c6243"], "node": "0d6d3ea238414ed2813752dc4e960fbcf1ce50cc", "parents": ["34f36f713298fe4ab67102fbec276d6a19e3961b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083477 [wpt PR 63822] - Update wpt metadata, a=testonly\n\nwpt-pr: 63822\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-shapes/crashtests/shape-outside-extreme-percent.html.ini", "testing/web-platform/meta/css/css-shapes/shape-outside-infinite-crash.html.ini", "testing/web-platform/meta/css/css-shapes/shape-outside-shape-function.html.ini"], "git_node": "8b2a19e013f93425e281ee6746d78e7f853593b7", "git_parents": ["3cc33180de46c9d6c9a43d0e5d2a2d29ec7288f5"], "node": "baded317360a8de650437d04fecf3dd36ea0a890", "parents": ["0d6d3ea238414ed2813752dc4e960fbcf1ce50cc"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083475 [wpt PR 63820] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324019, a=testonly\n\nAutomatic update from web-platform-tests\nTransforming a table row group misplaces absolutely positioned children\n\nA box that starts or stops being the containing block for out-of-flow descendants has to take them off the block that currently holds them.\nOnly RenderBlock and RenderInline called removeOutOfFlowBoxesIfNeededOnStyleChange, so a table section gaining a transform left its\nabsolutely positioned descendants registered on the old containing block and they were laid out against it.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324019\nWebKit-Canonical-Link: https://commits.webkit.org/321065@main\n\n--\n\nwpt-commits: 247e524d5c129d2bcb669d4cb4d3beda447ee84a\nwpt-pr: 63820\n", "files": ["testing/web-platform/tests/css/css-transforms/transformed-table-section-containing-block.html"], "git_node": "48889c5e58553415b2fe8c32c2975ea019739e2e", "git_parents": ["8b2a19e013f93425e281ee6746d78e7f853593b7"], "node": "1173b8b564a965d0797147238acdc863502884d6", "parents": ["baded317360a8de650437d04fecf3dd36ea0a890"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083475 [wpt PR 63820] - Update wpt metadata, a=testonly\n\nwpt-pr: 63820\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-transforms/crashtests/fragmented-block-in-inline-with-perspective.html.ini"], "git_node": "39a44ffb2d0fee8d69bff4a6c1317c48b49fd011", "git_parents": ["48889c5e58553415b2fe8c32c2975ea019739e2e"], "node": "250317c4d67b164db06ce4a390b11ba24d1040a0", "parents": ["1173b8b564a965d0797147238acdc863502884d6"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083473 [wpt PR 63819] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324007, a=testonly\n\nAutomatic update from web-platform-tests\n[Flex] flex-wrap: balance puts every item after an overflowing item on its own line\n\n    \u003cdiv style=\"display: flex; flex-wrap: balance; width: 100px; column-gap: 10px\"\u003e\n      \u003cdiv style=\"width: 50px\"\u003e\u003c/div\u003e\n      \u003cdiv style=\"width: 300px\"\u003e\u003c/div\u003e\n      \u003cdiv style=\"width: 20px\"\u003e\u003c/div\u003e\n      \u003cdiv style=\"width: 20px\"\u003e\u003c/div\u003e\n    \u003c/div\u003e\n\nThe last two items should share the third line. Instead each got a line of its own.\n\nBefore balancing,\n1, the line breaker walks the items once to record how many of them fit on a line starting at each index\n2, the walk keeps a single end index across iterations so it never re-measures\n\nbut end only moves forward when something fits, so an item wider than the line leaves it behind start.\n\nThe next iteration then asks for the length of an empty range producing a length larger than any line,\nso the walk stops at once and records that only one item fits.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324007\nWebKit-Canonical-Link: https://commits.webkit.org/321057@main\n\n--\n\nwpt-commits: 922ac9c8a11f1da20fbfffdf7df092ed7170ddcb\nwpt-pr: 63819\n", "files": ["testing/web-platform/tests/css/css-flexbox/balance/balance-line-break-overflowing-item-ref.html", "testing/web-platform/tests/css/css-flexbox/balance/balance-line-break-overflowing-item.html"], "git_node": "1d1c2b4387ceb4c952ef5586e135eaaed4e61356", "git_parents": ["39a44ffb2d0fee8d69bff4a6c1317c48b49fd011"], "node": "d3446c15cb9413f89563ae339da2f74f17feab83", "parents": ["250317c4d67b164db06ce4a390b11ba24d1040a0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083473 [wpt PR 63819] - Update wpt metadata, a=testonly\n\nwpt-pr: 63819\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-flexbox/balance/balance-line-break-crash.html.ini", "testing/web-platform/meta/css/css-flexbox/balance/balance-line-break-overflowing-item.html.ini"], "git_node": "907e95c56d1e0a273d463083fcae2a1487ad3859", "git_parents": ["1d1c2b4387ceb4c952ef5586e135eaaed4e61356"], "node": "fdce1eefd1e4ae4f1feadf15e99b643d4ea81b0d", "parents": ["d3446c15cb9413f89563ae339da2f74f17feab83"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083472 [wpt PR 63818] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324386, a=testonly\n\nAutomatic update from web-platform-tests\nFloats and inline-blocks are sized incorrectly when a child sets min-width: min-content or max-content\n\n    \u003cdiv style=\"display: inline-block\"\u003e\n      \u003cdiv style=\"width: 200px; min-width: min-content; max-width: 50px\"\u003e\n        \u003cdiv style=\"width: 60px\"\u003e\u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n\nThe middle box is 60px wide, but the inline-block around it is 200px.\n\ncomputeIntrinsicLogicalWidthContributions() sets both contributions to the fixed inline width, so the\nkeyword minimum reads back 200px instead of the content size. The maximum already recomputes for this\ncase; make the minimum do the same and share the check.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=324386\nWebKit-Canonical-Link: https://commits.webkit.org/321332@main\n\n--\n\nwpt-commits: 8d6127d3ce5fba6a2c855449e54244c9494c0971\nwpt-pr: 63818\n", "files": ["testing/web-platform/tests/css/css-sizing/min-width-min-content-contribution.html"], "git_node": "d39ec0652cc4d50176ad4339499c47126861e55f", "git_parents": ["907e95c56d1e0a273d463083fcae2a1487ad3859"], "node": "3d17859fb91796a5153393f0ec174dcddc11d726", "parents": ["fdce1eefd1e4ae4f1feadf15e99b643d4ea81b0d"], "tags": []}, {"author": "Ahmad Saleem \u003cahmad.saleem792+github@gmail.com\u003e", "branch": "default", "desc": "Bug 2083470 [wpt PR 63816] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321082, a=testonly\n\nAutomatic update from web-platform-tests\nBroken \u003cimg\u003e with alt text is given a square aspect ratio, overflowing a definite CSS Grid area\n\nRenderImage::preferredAspectRatioAsSize() fabricated a 1:1 preferred aspect ratio for\nany image in the broken state, and discarded the ratio derived from the width/height\nattributes whenever alt text was rendered. With a square ratio the used block size\nfollows the used inline size, so for\n\n    .media { display: grid; width: 420px; height: 236.25px }\n    .media \u003e img { width: 100%; height: 100% }\n\nthe grid item's automatic minimum size in the block axis resolved through the ratio to\n420 (the column size divided by 1), the implicit auto row grew to 420, and height:100%\nthen resolved against that row, overflowing the container by ~184px. min-height:0\nskipped the automatic minimum size and hid it. Outside grid the same square showed up\ndirectly: width:100% in a 300px block laid out 300x300 instead of taking its block size\nfrom the alt text box.\n\nAn \u003cimg\u003e rendering alt text is not sized as a replaced element, so it has no preferred\naspect ratio and the \"auto \u003cratio\u003e\" from the dimension attributes does not apply. An\nexplicit aspect-ratio still applies unless the box is an inline box. This matches\nChromium and Firefox: replaced-element-036.html now passes (explicit ratio applies for\nblock and inline-block) and replaced-element-028.html keeps passing (it does not apply\nfor inline).\n\nAlso guard the one consumer that divided by the preferred ratio without checking it\nexists, now reachable for images with no ratio at all.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=321082\nWebKit-Canonical-Link: https://commits.webkit.org/321907@main\n\n--\n\nwpt-commits: fd8726474926f3f27d11282eb879faccb9edf918\nwpt-pr: 63816\n", "files": ["testing/web-platform/tests/html/rendering/replaced-elements/attributes-for-embedded-content-and-images/img-aspect-ratio-alt-text.html"], "git_node": "7590d0fce8e26ef95cc23eb156b4ccb308ecca04", "git_parents": ["d39ec0652cc4d50176ad4339499c47126861e55f"], "node": "a08e6792c8f71c391864a6ab25f6788cb40d377a", "parents": ["3d17859fb91796a5153393f0ec174dcddc11d726"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083470 [wpt PR 63816] - Update wpt metadata, a=testonly\n\nwpt-pr: 63816\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/rendering/replaced-elements/attributes-for-embedded-content-and-images/img-aspect-ratio-alt-text.html.ini"], "git_node": "d1c335143e7a168624e5135c0ab8c58fa927066c", "git_parents": ["7590d0fce8e26ef95cc23eb156b4ccb308ecca04"], "node": "9e318d8455cd53439813aa5aa9a743342d5de20e", "parents": ["a08e6792c8f71c391864a6ab25f6788cb40d377a"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083468 [wpt PR 63815] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325502, a=testonly\n\nAutomatic update from web-platform-tests\ndisplay:contents text inherits the wrong style after its parent span's style changes\n\nAn inline box propagated its new style to every anonymous child, including the anonymous inline that carries the display: contents style for a text child, so \u003cspan\u003e\u003cdiv style=\"display: contents; color: green\"\u003etext\u003c/div\u003e\u003c/span\u003e turned the text to the span's color on the span's next style change.\n\nAn inline box now updates only its anonymous block and ruby children when its style changes, like a block does. The ruby filter also includes the anonymous ruby base. The anonymous inline carrying the display:contents style is no longer overwritten.\n\nAn inside list marker's image lost that propagation, so its style change now refreshes the marker's generated content the way an outside marker already does.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325502\nWebKit-Canonical-Link: https://commits.webkit.org/322092@main\n\n--\n\nwpt-commits: 67d4bc43243c12ede2ae508caa233bbd1c007a75\nwpt-pr: 63815\n", "files": ["testing/web-platform/tests/css/css-display/display-contents-dynamic-inline-parent-style.html"], "git_node": "a216dcc405db94dabc93fc89588b97919c677e6d", "git_parents": ["d1c335143e7a168624e5135c0ab8c58fa927066c"], "node": "64d36553816df5d69710471322f7c628a35178d9", "parents": ["9e318d8455cd53439813aa5aa9a743342d5de20e"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083464 [wpt PR 63813] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325342, a=testonly\n\nAutomatic update from web-platform-tests\nGrid item with aspect-ratio and percentage height does not shrink when the grid gets narrower\n\nThe first column pass of the grid sizing algorithm runs before the rows are sized. At that point a grid item's grid area\nblock size (its containing block height) still holds the row size from the previous layout. A percentage height resolved\nagainst it, and aspect-ratio transferred that into a min-content width, so the column (and the item) never got narrower\nthan in the previous layout.\n\nPer https://drafts.csswg.org/css-grid-2/#algo-grid-sizing the block size available to the item in this step comes from the\nrows with a definite max track sizing function only; other rows (e.g. auto) make it indefinite. When the estimate is\nindefinite, measure the item against an indefinite grid area block size instead of the previous layout's row size.\nThe fix is limited to regular track sizing (intrinsic sizing already uses the estimate when it is definite) and to direct,\nnon-orthogonal grid items outside of grid lanes and subgridded rows for now.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325342\nWebKit-Canonical-Link: https://commits.webkit.org/322176@main\n\n--\n\nwpt-commits: 80b86b6a0248693f65def5193dea32dc552740c7\nwpt-pr: 63813\n", "files": ["testing/web-platform/tests/css/css-sizing/aspect-ratio/grid-aspect-ratio-043-ref.html", "testing/web-platform/tests/css/css-sizing/aspect-ratio/grid-aspect-ratio-043.html"], "git_node": "e22fdcb9bfd3b21921893ff6047f9f3272880ad9", "git_parents": ["a216dcc405db94dabc93fc89588b97919c677e6d"], "node": "2b15202b60b9dff9d2fa837e4e2206e82d1998d1", "parents": ["64d36553816df5d69710471322f7c628a35178d9"], "tags": []}, {"author": "Alan Baradlay \u003czalan@apple.com\u003e", "branch": "default", "desc": "Bug 2083465 [wpt PR 63814] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325449, a=testonly\n\nAutomatic update from web-platform-tests\n[IFC] Justified line comes up short when its hanging trailing whitespace is inside an inline box\n\n\u003cdiv style=\"width: 110px; font: 20px monospace; white-space: pre-wrap; text-align: justify\"\u003e\u003cspan\u003eaa bb cc   \u003c/span\u003edd\u003c/div\u003e\n\nThe spaces after \"cc\" hang at the end of the first line, so justification should only stretch the gaps\nbetween the words. FontCascade spreads a run's expansion over every space in its text, so we split the\nhanging spaces off into their own run, but only when they ended the very last run: with the \u003c/span\u003e after\nthem they got stretched too and \"cc\" fell short of the right edge. Now we split them off the last text run.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325449\nWebKit-Canonical-Link: https://commits.webkit.org/322224@main\n\n--\n\nwpt-commits: dee58a55225d47053ea1d9cbe72ff3c9e2d03d28\nwpt-pr: 63814\n", "files": ["testing/web-platform/tests/css/css-text/white-space/reference/white-space-pre-wrap-justify-005-ref.html", "testing/web-platform/tests/css/css-text/white-space/white-space-pre-wrap-justify-005.html"], "git_node": "fd98971560e494680dcd04562268a642ed95b00f", "git_parents": ["e22fdcb9bfd3b21921893ff6047f9f3272880ad9"], "node": "c72dfb3b31ee39c52f5b408ba0e829e9723c531a", "parents": ["2b15202b60b9dff9d2fa837e4e2206e82d1998d1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083465 [wpt PR 63814] - Update wpt metadata, a=testonly\n\nwpt-pr: 63814\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-text/white-space/break-spaces-before-first-ideographic-char-004.html.ini"], "git_node": "a0d9af063dcbc30e38a90777da98aa954e593bcf", "git_parents": ["fd98971560e494680dcd04562268a642ed95b00f"], "node": "f6813ca78c58a94b642c766c2fdd1d0bc7244383", "parents": ["c72dfb3b31ee39c52f5b408ba0e829e9723c531a"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2083299 [wpt PR 63790] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327828, a=testonly\n\nAutomatic update from web-platform-tests\nA selectedcontent element's option clones must not be options of its select\n\nWhen a selected option's subtree contains a nested option, cloning it into a\nselectedcontent element placed a cloned option into the select's list of\noptions. With a selected nested option this looped forever (each clone became\nthe selected option, re-running the update); without one, select.options still\nwrongly included the clone.\n\nA selectedcontent element only ever holds clones, on both the single and the\nmultiple selection paths, so treat it as such unconditionally.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327828\n\n--\n\nwpt-commits: c3fa98340295b699b3d899e9ecb0ca6d881a1566\nwpt-pr: 63790\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/selectedcontent-cloned-option-is-not-an-option.tentative.html"], "git_node": "7e5545a36bc9c94a584189be5682e4ca5c6e1d26", "git_parents": ["a0d9af063dcbc30e38a90777da98aa954e593bcf"], "node": "948098cf7c2e8152444073a3c5d0c477f89d2657", "parents": ["f6813ca78c58a94b642c766c2fdd1d0bc7244383"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083299 [wpt PR 63790] - Update wpt metadata, a=testonly\n\nwpt-pr: 63790\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/selectedcontent-cloned-option-is-not-an-option.tentative.html.ini"], "git_node": "e2ab21baca87749e4c1b782d41800ae8b4a2c1a5", "git_parents": ["7e5545a36bc9c94a584189be5682e4ca5c6e1d26"], "node": "e85d532f03775b6c8f752d5194f4f4a30a218b3c", "parents": ["948098cf7c2e8152444073a3c5d0c477f89d2657"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2082694 [wpt PR 63723] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327706, a=testonly\n\nAutomatic update from web-platform-tests\nAgent cluster keying is recorded for documents that never exist\n\nHTML records an origin's keying in the historical agent cluster key map when a\ndocument is created. Since 323290@main the UI process recorded it when it\nassigned an agent cluster to a load instead, at the response decision, or at the\nnavigation action decision for substitute data. A response that never became a\ndocument, such as a 204, or a load that was then cancelled or replaced, still\ndecided the keying of every later document of its origin in the browsing context\ngroup.\n\nThese assignments now only reserve the keying. Loads of the same origin that are\nin flight at the same time share the reservation, so they still agree, and the\nkeying is recorded when one of them commits, which the UI process already did\nfor loads whose response decision is skipped. The reservation belongs to the\nload's navigation and lapses once the navigation is gone, and a navigation that\nis gone by the time its decision completes doesn't reserve anything. Alternate\nHTML strings and data loaded into a frame have no navigation, so they still\nrecord the keying right away.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327706\n\n--\n\nwpt-commits: efd6bc5b4f73d0400c7ad133daba7677f24b7c48\nwpt-pr: 63723\n", "files": ["testing/web-platform/tests/html/browsers/origin/origin-keyed-agent-clusters/no-content-response.sub.https.html"], "git_node": "c5760b3a37dbbb083871b15d625f6ceeb073c4a3", "git_parents": ["e2ab21baca87749e4c1b782d41800ae8b4a2c1a5"], "node": "e60d7719daec0c9c305c41471877d90230d23f63", "parents": ["e85d532f03775b6c8f752d5194f4f4a30a218b3c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082694 [wpt PR 63723] - Update wpt metadata, a=testonly\n\nwpt-pr: 63723\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/browsers/origin/origin-keyed-agent-clusters/no-content-response.sub.https.html.ini", "testing/web-platform/meta/html/browsers/origin/origin-keyed-agent-clusters/popups-crash.https.html.ini"], "git_node": "af7d48a0233cd0b0ae80c754294f6634faa985cf", "git_parents": ["c5760b3a37dbbb083871b15d625f6ceeb073c4a3"], "node": "b7930962b069075d50e9c10086a24d1438cf7175", "parents": ["e60d7719daec0c9c305c41471877d90230d23f63"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2083292 [wpt PR 63789] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327841, a=testonly\n\nAutomatic update from web-platform-tests\nwindow.pushManager should only be exposed in secure contexts\n\nThe Push API's PushManagerAttribute mixin is [SecureContext], but WebKit's WindowPush mixin was\nnot, so window.pushManager was exposed in non-secure contexts. Calling subscribe() there crashed\nthe web process on PushManager::subscribe()'s RELEASE_ASSERT that the context is secure.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327841\n\n--\n\nwpt-commits: 634342da16cccd80504e6f0e318aebefba85ccf8\nwpt-pr: 63789\n", "files": ["testing/web-platform/tests/push-api/window-pushManager-non-secure-context.http.html"], "git_node": "c684b3142db8cedb406a3694ad7939f2573ce794", "git_parents": ["af7d48a0233cd0b0ae80c754294f6634faa985cf"], "node": "931b1e0854a89ea721021d5ca953e08a85785dcb", "parents": ["b7930962b069075d50e9c10086a24d1438cf7175"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083292 [wpt PR 63789] - Update wpt metadata, a=testonly\n\nwpt-pr: 63789\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/push-api/cross-origin-nested.tentative.https.sub.window.js.ini"], "git_node": "377644f8cb36c67eb5f04098ec7a62bb7ee43b82", "git_parents": ["c684b3142db8cedb406a3694ad7939f2573ce794"], "node": "b76dfb990b3acada58dd2f62f283aae14d2ea5c9", "parents": ["931b1e0854a89ea721021d5ca953e08a85785dcb"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2081344 [wpt PR 63601] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327253, a=testonly\n\nAutomatic update from web-platform-tests\nPut documents with a Document-Isolation-Policy in cross-origin isolated processes\n\nWith site isolation, a document with a Document-Isolation-Policy now goes in a\ncross-origin isolated process that its browsing context group has for its site.\ncrossOriginIsolated returns true there, and SharedArrayBuffer objects can be\nposted within its agent cluster. A group that is already cross-origin isolated\nkeeps all of its documents in its own processes. A group keeps its processes in\none map, keyed by the site and whether the process is for documents with a\npolicy.\n\nThe policy is only known from the response, so a same-site navigation stays in\nits process until then. As for COOP, the network process then asks the UI\nprocess for a swap when the first response's policy doesn't match the process,\nunless the response doesn't replace the document (204 or 205). It sends the\nresponse's URL and policy header, and the UI process decides, also taking the\ntop-level creation URL into account. The navigation continues with the same\nnetwork load in the site's other process, for subframes too. WebProcessProxy\nrecords why a process is cross-origin isolated and passes this to the network\nprocess. The UI process also refuses to commit a response without a policy in\na process for documents with one. Like COOP responses, navigations that could\ncross between these processes reload rather than revalidate, as a 304 can't\nmove. A top-level data: document gets a process that matches the policy it\ninherits.\n\nA speculation rules prefetch only serves a navigation when its response has the\nsame policy as the document that prefetched it, as the navigation stays in that\ndocument's process. So a document with a policy doesn't use a prefetch whose\nresponse hasn't arrived yet.\n\nSame-origin documents can now be in different processes, so ancestors in other\nprocesses count when a document checks whether it may navigate a frame.\n\nNot covered yet:\n- navigate doesn't fire when a same origin-domain document in another process\n  navigates a frame and the navigation moves to a third process.\n- Dedicated workers of these documents are not cross-origin isolated.\n- A cross-origin iframe with a policy still needs its parent to allow the\n  \"cross-origin-isolated\" permissions policy feature to be cross-origin\n  isolated. Whether it should is\n  https://github.com/WICG/document-isolation-policy/issues/12\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327253\n\n--\n\nwpt-commits: 6cd3f1c39e2aec3d58f140aa0ff2991d79eb9991\nwpt-pr: 63601\n", "files": ["testing/web-platform/tests/html/document-isolation-policy/agent-cluster.tentative.https.html", "testing/web-platform/tests/html/document-isolation-policy/cross-origin-isolated.tentative.https.html", "testing/web-platform/tests/html/document-isolation-policy/navigate-across-policies.tentative.https.html", "testing/web-platform/tests/html/document-isolation-policy/no-secure-context-https-iframe.tentative.html", "testing/web-platform/tests/html/document-isolation-policy/no-secure-context.tentative.html", "testing/web-platform/tests/html/document-isolation-policy/resources/common.js", "testing/web-platform/tests/html/document-isolation-policy/shared-array-buffer.tentative.https.html"], "git_node": "a52e87b7b1687948e2fb704a3211f77dcc69c8c2", "git_parents": ["377644f8cb36c67eb5f04098ec7a62bb7ee43b82"], "node": "58017188b9cf9083b1d871dabc4569024d8b3a60", "parents": ["b76dfb990b3acada58dd2f62f283aae14d2ea5c9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081344 [wpt PR 63601] - Update wpt metadata, a=testonly\n\nwpt-pr: 63601\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/document-isolation-policy/agent-cluster.tentative.https.html.ini", "testing/web-platform/meta/html/document-isolation-policy/cross-origin-isolated.tentative.https.html.ini", "testing/web-platform/meta/html/document-isolation-policy/shared-array-buffer.tentative.https.html.ini"], "git_node": "c6e48b7c6b9b98129fc8b05f88346d3793744b2b", "git_parents": ["a52e87b7b1687948e2fb704a3211f77dcc69c8c2"], "node": "38482a8cf5fdc97dfcc44810cebd004b911ddb38", "parents": ["58017188b9cf9083b1d871dabc4569024d8b3a60"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083566 [wpt PR 63853] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327151, a=testonly\n\nAutomatic update from web-platform-tests\n\u003cuse\u003e copies of an SVG \u003ca\u003e keep the old target after the target attribute changes (#63853)\n\nWhen the target attribute of an SVG \u003ca\u003e element changed, its \u003cuse\u003e copies\nwere not rebuilt, so clicking a copy navigated using the old target.\n\nInvalidate \u003cuse\u003e instances when the target attribute changes. Also stop\nreturning early from SVGAElement::attributeChanged() for target, so the\nbase class handling still runs.\n\nThe test is skipped on iOS, where tapping a \u003cuse\u003e instance of an SVG \u003ca\u003e does\nnot navigate even without changing the target.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327151\nWebKit-Canonical-Link: https://commits.webkit.org/324087@main\n--\n\nwpt-commits: c47791d69da614474168c0f6c1ad9a1dbd0cf0d3\nwpt-pr: 63853\n", "files": ["testing/web-platform/tests/svg/linking/scripted/a.target-dynamic-update.html"], "git_node": "fb715e41e1d0c373846b8a73c2f3c721162bda6e", "git_parents": ["c6e48b7c6b9b98129fc8b05f88346d3793744b2b"], "node": "04f2557d0ff7d9185463a08f9dcb9e6eed0078fc", "parents": ["38482a8cf5fdc97dfcc44810cebd004b911ddb38"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083566 [wpt PR 63853] - Update wpt metadata, a=testonly\n\nwpt-pr: 63853\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/linking/scripted/a.target-dynamic-update.html.ini"], "git_node": "a44db42d1fdc7f0227dac07b4f63fa647017933e", "git_parents": ["fb715e41e1d0c373846b8a73c2f3c721162bda6e"], "node": "1f1f04223106687ae23ed1f75396373341cf14c2", "parents": ["04f2557d0ff7d9185463a08f9dcb9e6eed0078fc"], "tags": []}, {"author": "Siddhi sahu \u003chimanisahu739@gmail.com\u003e", "branch": "default", "desc": "Bug 2083611 [wpt PR 63857] - script: use encoding-parse algorithm in HTMLImageElement, a=testonly\n\nAutomatic update from web-platform-tests\nscript: use encoding-parse algorithm in HTMLImageElement\n\nSigned-off-by: Siddhi sahu \u003chimanisahu739@gmail.com\u003e\n\n--\n\nwpt-commits: 38690cce87929f184a529234eff84eaa426609c3\nwpt-pr: 63857\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-img-element/img-src-encoding-parse.html"], "git_node": "3497b22cc4576f7afb1642a2fa94252ec82e56b3", "git_parents": ["a44db42d1fdc7f0227dac07b4f63fa647017933e"], "node": "6a8bd062d06cde7492a55a29b1e0a46d3d1ebc69", "parents": ["1f1f04223106687ae23ed1f75396373341cf14c2"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083606 [wpt PR 63856] - Update Test262 tests, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate Test262 tests\n\n--\n\nwpt-commits: 6df7a6ede9ba3acd4abfa950ee09cd9fb66d8540\nwpt-pr: 63856\n", "files": ["testing/web-platform/tests/third_party/test262/vendored.toml"], "git_node": "c96d515de77dbd6b8dc47a663b1fc3234ea139b1", "git_parents": ["3497b22cc4576f7afb1642a2fa94252ec82e56b3"], "node": "2ce3a6c28b8f937fa996c9726c7eeeb2b164ed4e", "parents": ["6a8bd062d06cde7492a55a29b1e0a46d3d1ebc69"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2082796 [wpt PR 63738] - [WPT] Fix line-break clipboard test on Windows, a=testonly\n\nAutomatic update from web-platform-tests\n[WPT] Fix line-break clipboard test on Windows (#63738)\n\nOn Windows, writing text/plain to the clipboard normalizes line endings\nto CRLF, as the Clipboard API asks for (\"normalize line endings\naccording to platform conventions\"). Blink's NormalizeLineEndingsToCrLf\ntreats CR, LF and CRLF all as line breaks.\n\nclipboard-copy-selection-line-break.https.html only converted LF and\nCRLF when computing the expected value on Windows, so \u003cpre\u003e cases with\na lone CR (e.g. \"\\r\\r\\r\") expected the CR to survive but got CRLF.\nTreat a lone CR as a line break too when computing the expected value\non Windows.\n\nWith this the test passes on Windows, so remove the stale Windows\nbaselines that recorded the failures.\n\n  variants (?1-10, ?11-20, ?21-30, ?31-last).\n\nBug: 573945439\nTest: run_web_tests.py and wpt run (Edge build) pass for all four\nChange-Id: Id5b236e934cdfc2694edb0e53ee08705befd653a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8589426\nCommit-Queue: John Jansen \u003cjohnjansen@microsoft.com\u003e\nReviewed-by: Mike Jackson \u003cmjackson@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1720092}\n\nCo-authored-by: John Jansen \u003cjohnjansen@microsoft.com\u003e\n--\n\nwpt-commits: cd06ab9de5f3ea8c6c5581bec775d6c6c9b942cf\nwpt-pr: 63738\n", "files": ["testing/web-platform/tests/clipboard-apis/clipboard-copy-selection-line-break.https.html"], "git_node": "0ce7721f49c90acbf6bd621413b0f8ed8f95a833", "git_parents": ["c96d515de77dbd6b8dc47a663b1fc3234ea139b1"], "node": "caef3464ee660589eead2b3fb8ecb743b9100d61", "parents": ["2ce3a6c28b8f937fa996c9726c7eeeb2b164ed4e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082796 [wpt PR 63738] - Update wpt metadata, a=testonly\n\nwpt-pr: 63738\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/clipboard-apis/permissions/__dir__.ini", "testing/web-platform/meta/clipboard-apis/permissions/readText-denied.https.html.ini"], "git_node": "2534851cf739681c2bde2a4b95ed65402b7f408f", "git_parents": ["0ce7721f49c90acbf6bd621413b0f8ed8f95a833"], "node": "4d1f09c2a98a68d07caa39971795841ce406555a", "parents": ["caef3464ee660589eead2b3fb8ecb743b9100d61"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2078532 [wpt PR 63295] - [SAA] Fix flaky SetFirstPartyCookie WPT helper, a=testonly\n\nAutomatic update from web-platform-tests\n[SAA] Fix flaky SetFirstPartyCookie WPT helper (#63295)\n\nSetFirstPartyCookie() waited for the popup's\n'set-document-cookie-complete' message with a listener registered using\n`{ once: true }`. That option detaches the listener after the *first*\nmessage of any kind, but the listener only resolves on the matching\nmessage, so any unrelated message arriving while the helper is waiting\ncauses the returned promise to never resolve and the test to time out.\n\nSuch messages do arrive: the embedded responder frames created by these\ntests load testharness.js (without testharnessreport.js), so ~10s after\neach frame loads its harness times out and testharness.js posts a\n`{type: \"complete\"}` message to every ancestor window. In\nrequestStorageAccess-cross-site-sibling-iframes, the second subtest\ncreates its frames before calling SetFirstPartyCookie twice, so on slow\n(debug) bots the first subtest's frames hit their 10s harness timeout\nexactly while the second SetFirstPartyCookie() is waiting, which removed\nthe listener and hung the test until the harness timeout.\n\nKeep the listener attached until the expected message has been\nprocessed, and only then remove it, ignoring unrelated messages.\n\nBug: 566580874\nChange-Id: I3bdeb970f42bbd44e72c02ef438b9e45eae13a09\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8512297\nReviewed-by: Andrew Williams \u003cawillia@chromium.org\u003e\nCommit-Queue: Mike Taylor \u003cmiketaylr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1711774}\n\nCo-authored-by: Mike Taylor \u003cmiketaylr@chromium.org\u003e\n--\n\nwpt-commits: 4ad507b28db0a636f528def9161d109fe11b93a3\nwpt-pr: 63295\n", "files": ["testing/web-platform/tests/storage-access-api/helpers.js"], "git_node": "efa3cce2bd30474207d0813c627c474c42eeb3b1", "git_parents": ["2534851cf739681c2bde2a4b95ed65402b7f408f"], "node": "ac30f1b3be2305cb13c3f016f8126cbefef647bf", "parents": ["4d1f09c2a98a68d07caa39971795841ce406555a"], "tags": []}, {"author": "Koji Ishii \u003ckojii@chromium.org\u003e", "branch": "default", "desc": "Bug 2083851 [wpt PR 63865] - [iframe] Allow responsive iframes to shrink, a=testonly\n\nAutomatic update from web-platform-tests\n[iframe] Allow responsive iframes to shrink\n\n`LocalFrameView::layout_overflow_size_` always unites its own\n`padding_rect_`, which prevents responsive iframes to shrink.\n\nThis patch adds `layout_overflow_size_without_padding_box_`,\nwhich is computed during the existing single pass in\n`ScrollableOverflowCalculator()`, and uses it in\n`LocalFrameView::RecordNaturalDimensions()`.\n\nThis change is guarded by the runtime feature flag\n`ResponsiveIframesShrink`, enabled by default.\n\nFixed: 570579609\nChange-Id: Id735425797219a24700272fcfca3f29b7cf44c8c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8584857\nAuto-Submit: Koji Ishii \u003ckojii@chromium.org\u003e\nCommit-Queue: Koji Ishii \u003ckojii@chromium.org\u003e\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCommit-Queue: Kent Tamura \u003ctkent@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1721627}\n\n--\n\nwpt-commits: 01e7679faa63133cab7206e3b89a1d76084f0a32\nwpt-pr: 63865\n", "files": ["testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-400x200root.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/responsive-iframe-value.html"], "git_node": "f80f256fc3b8125746da5ea6b2f8a8b817e9c39b", "git_parents": ["efa3cce2bd30474207d0813c627c474c42eeb3b1"], "node": "162ab8791f741aca27d66de912e96a208a3ee329", "parents": ["ac30f1b3be2305cb13c3f016f8126cbefef647bf"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083851 [wpt PR 63865] - Update wpt metadata, a=testonly\n\nwpt-pr: 63865\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-sizing/responsive-iframe/responsive-iframe-value.html.ini"], "git_node": "68784007662a43a9173c31b82d007b1f6107a5e9", "git_parents": ["f80f256fc3b8125746da5ea6b2f8a8b817e9c39b"], "node": "5f745a6b7afc20767ea95004329d37e5f4c8895b", "parents": ["162ab8791f741aca27d66de912e96a208a3ee329"], "tags": []}, {"author": "Byungwoo Lee \u003cblee@igalia.com\u003e", "branch": "default", "desc": "Bug 2083911 [wpt PR 63871] - Add WPTs for reporting CSP violations on worker/worklet module imports, a=testonly\n\nAutomatic update from web-platform-tests\nAdd WPTs for reporting CSP violations on worker/worklet module imports\n\nA CSP violation detected while fetching the module graph of a worker or\na worklet belongs to the context that created it, since the module graph\nis fetched with the outside settings object as the request's client.\nSo the violation should be reported on the creator document.\n\nAdd WPTs for a blocked static import in a module DedicatedWorker, a\nmodule SharedWorker and an AudioWorklet. Each test checks the event, the\nreport observed by ReportingObserver, and the report delivered to the\nreport-to endpoint.\n\nBug: 40612680\nForce-WPT-Export: true\nChange-Id: Ie1e3eaecf4f53514766b01524793a777a64bd353\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8602288\nReviewed-by: Antonio Sartori \u003cantoniosartori@chromium.org\u003e\nCommit-Queue: Byungwoo Lee \u003cblee@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1721713}\n\n--\n\nwpt-commits: b3e4cd8809c3e2a3404e5a09a8ef2134544410fa\nwpt-pr: 63871\n", "files": ["testing/web-platform/tests/content-security-policy/reporting-api/reporting-api-sends-reports-on-violation-for-dedicated-worker-import.https.sub.html", "testing/web-platform/tests/content-security-policy/reporting-api/reporting-api-sends-reports-on-violation-for-dedicated-worker-import.https.sub.html.sub.headers", "testing/web-platform/tests/content-security-policy/reporting-api/reporting-api-sends-reports-on-violation-for-shared-worker-import.https.sub.html", "testing/web-platform/tests/content-security-policy/reporting-api/reporting-api-sends-reports-on-violation-for-shared-worker-import.https.sub.html.sub.headers", "testing/web-platform/tests/content-security-policy/reporting-api/reporting-api-sends-reports-on-violation-for-worklet-import.https.sub.html", "testing/web-platform/tests/content-security-policy/reporting-api/reporting-api-sends-reports-on-violation-for-worklet-import.https.sub.html.sub.headers", "testing/web-platform/tests/workers/resources/empty-worker-script-with-cors-header.js", "testing/web-platform/tests/workers/resources/empty-worker-script-with-cors-header.js.headers", "testing/web-platform/tests/workers/resources/import-remote-origin-empty-worker-script.sub.js"], "git_node": "bd88df28a94db8c46fe43bd4aca63df2f6ba0b10", "git_parents": ["68784007662a43a9173c31b82d007b1f6107a5e9"], "node": "a11047f3177731becbb783dae960aade0c7409f4", "parents": ["5f745a6b7afc20767ea95004329d37e5f4c8895b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083911 [wpt PR 63871] - Update wpt metadata, a=testonly\n\nwpt-pr: 63871\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/content-security-policy/reporting-api/reporting-api-sends-reports-on-violation-for-dedicated-worker-import.https.sub.html.ini", "testing/web-platform/meta/content-security-policy/reporting-api/reporting-api-sends-reports-on-violation-for-shared-worker-import.https.sub.html.ini"], "git_node": "bd69cc6d5c11d2ecef143d253b085b35d596bdc4", "git_parents": ["bd88df28a94db8c46fe43bd4aca63df2f6ba0b10"], "node": "6a72ffd48f5743b8ab21e63c8a003c20e6070936", "parents": ["a11047f3177731becbb783dae960aade0c7409f4"], "tags": []}, {"author": "Javier Fernandez Garcia-Boente \u003cjfernandez@igalia.com\u003e", "branch": "default", "desc": "Bug 2076469 [wpt PR 63050] - Cache Storage: fix the VARY override handler in vary.py, a=testonly\n\nAutomatic update from web-platform-tests\nCache Storage: fix vary.py and split the asymmetric addAll() Vary test (#63050)\n\nvary.py has two bugs that make \"Cache.addAll should succeed when entries\ndiffer by vary header\" fail in every engine, and that leave a cookie set\nfor the rest of the browser session.\n\n1. str(cookie_vary) stringifies a wptserve CookieValue, whose __str__ is\n   Morsel.OutputString(). The handler therefore emitted\n\n       Vary: vary-value-override=x-shape\n\n   instead of\n\n       Vary: x-shape\n\n   No request carries a `vary-value-override` header, so both addAll()\n   entries match that bogus field name and every engine rejects the batch\n   with InvalidStateError. Use cookie_vary.value.\n\n2. response.unset_cookie() only removes a Set-Cookie header from the\n   outgoing response; it does not delete the cookie on the client. The\n   `clear-vary-value-override-cookie` endpoint was a no-op, so the\n   override cookie survived for the rest of the session and leaked into\n   every later variant of cache-add.https.any.js. Use delete_cookie().\n\nFixing (1) exposes a wrong expectation in \"Cache.addAll should reject\nwhen one entry has a vary header matching another entry\". That subtest\nadds two requests for the same URL, in both orders, and expected a\nrejection each time:\n\n    shape: {x-shape: circle, x-size: big}, response \"Vary: x-shape\"\n    size:  {x-shape: square, x-size: big}, response \"Vary: x-size\"\n\nBatch Cache Operations runs Query Cache for each operation against\naddedItems, the entries added before it, and Request Matches Cached Item\nuses the Vary header of that earlier entry's response. So:\n\n  - [shape, size]: size is compared against shape under \"Vary: x-shape\".\n    circle does not match square, so addAll() resolves.\n  - [size, shape]: shape is compared against size under \"Vary: x-size\".\n    Both are big, so addAll() rejects with InvalidStateError.\n\nThe old subtest passed only because of (1): shape's response varied on a\nheader no request has, so every comparison matched. With vary.py fixed,\nan engine that follows the spec fails its forward-order assertion. Split\nit into one subtest per order with the expectations above, and move the\nshared setup into create_asymmetric_vary_requests(). The old subtest\nname goes away.\n\nExpected results: Gecko compares each entry against the earlier ones in\nargument order and passes both subtests. Chromium checks both directions\nfor every pair, so it fails the [shape, size] subtest until its\nduplicate check is fixed.\n\nNote for WebKit: DOMCache::addAll() runs the duplicate check in each\nfetch's completion handler, against the records whose responses have\nalready arrived. It compares in response arrival order, while the spec\nbuilds the operations in requestList order once every fetch completes.\nWhen the two responses arrive out of order, WebKit rejects [shape, size]\nand resolves [size, shape], so both new subtests can be intermittent\nthere. This change does not force the arrival order. Delaying the first\nentry's response through a request header would make that failure\ndeterministic without affecting engines that follow the spec, at the\ncost of a timing dependency in vary.py.\n--\n\nwpt-commits: 09aa5d8a536f7f48c2ac048a0f32d54217d493fa\nwpt-pr: 63050\n", "files": ["testing/web-platform/tests/service-workers/cache-storage/cache-add.https.any.js", "testing/web-platform/tests/service-workers/cache-storage/resources/vary.py"], "git_node": "d29e1806f7a7f30199b0f3f0deaf6363a3d6bb63", "git_parents": ["bd69cc6d5c11d2ecef143d253b085b35d596bdc4"], "node": "61101501e15fe70a373fe9e3c96556dd303a5c2c", "parents": ["6a72ffd48f5743b8ab21e63c8a003c20e6070936"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076469 [wpt PR 63050] - Update wpt metadata, a=testonly\n\nwpt-pr: 63050\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/service-workers/cache-storage/crashtests/cache-response-clone.https.html.ini", "testing/web-platform/meta/svg/struct/scripted/use-inline-event-handlers.tentative.html.ini"], "git_node": "8f03871ceb99b3e1b97a9653f0253ebe0b73ada7", "git_parents": ["d29e1806f7a7f30199b0f3f0deaf6363a3d6bb63"], "node": "7439586ba81721906b78978720e60351daa5e0a4", "parents": ["61101501e15fe70a373fe9e3c96556dd303a5c2c"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2077051 [wpt PR 63153] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=325898, a=testonly\n\nAutomatic update from web-platform-tests\nRefine when \u003cselectedcontent\u003e elements are updated\n\nAlign with https://github.com/whatwg/html/pull/13005\n\nInserting, removing, or moving an \u003coption\u003e now updates \u003cselectedcontent\u003e when\nthat causes another option to become selected, which happens when the \u003cselect\u003e\nis a drop-down box without a selected option. Like removing or moving one,\ninserting an \u003coption\u003e now queues the update, which the post-connection steps of\nthe inserted options perform. Inserting multiple options together thus updates\n\u003cselectedcontent\u003e once. To tell whether there is a selected option without\nrecalculating the list items, \u003cselect\u003e remembers whether its \u003cselectedcontent\u003e\nelements show one. An \u003coption\u003e whose \u003cselect\u003e does not change, as when inserting\na \u003cselect\u003e that already contains options, leaves updating to the\n\u003cselectedcontent\u003e itself.\n\nThe post-connection steps of a \u003cselectedcontent\u003e no longer update it when an\nupdate of its \u003cselect\u003e's \u003cselectedcontent\u003e elements is pending, as that update\nincludes it. Inserting a \u003cselectedcontent\u003e before options that change\nselectedness thus updates it once.\n\nThe microtasks that perform these updates are now coalesced and do nothing if\nthe update happened in the meantime.\n\nA moved \u003cselectedcontent\u003e now finds its \u003cselect\u003e when the queued microtask runs,\nand is not updated at all when it stays enabled in the same \u003cselect\u003e, for\ninstance when an ancestor of the \u003cselect\u003e is moved.\n\nRemoving a \u003cselectedcontent\u003e now recalculates whether it is disabled.\n\nSetting the selected IDL attribute of an \u003coption\u003e to its current value now\nupdates \u003cselectedcontent\u003e too, so that it can reflect changes to the option's\nchildren. selectedcontent.html is updated to upstream, which tests this, as of\nhttps://github.com/web-platform-tests/wpt/commit/c9731ae2ec9f5fc16c0de13d73f81ca82ac5385e.\n\nTests upstream: https://github.com/web-platform-tests/wpt/pull/63153\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=325898\n\n--\n\nwpt-commits: 3c567c3c0fd9dbff746e92e07a843255e1d0b194\nwpt-pr: 63153\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/selectedcontent-mutations.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/selectedcontent-nested-select.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/selectedcontent-option-insertion.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/selectedcontent-queued-update.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/selectedcontent-subtree-mutations.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/option-selectedness-script-mutation.html"], "git_node": "8c0b9f7bcc0e43d605c48aa421ad83d59a5b609b", "git_parents": ["8f03871ceb99b3e1b97a9653f0253ebe0b73ada7"], "node": "a872a271cd476f95a068cd42ef58c3d539ffe51a", "parents": ["7439586ba81721906b78978720e60351daa5e0a4"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077051 [wpt PR 63153] - Update wpt metadata, a=testonly\n\nwpt-pr: 63153\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/selectedcontent-nested-select.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/selectedcontent-queued-update.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/selectedcontent-subtree-mutations.html.ini"], "git_node": "4f9725663c98daef94c08336cad4ed890501d018", "git_parents": ["8c0b9f7bcc0e43d605c48aa421ad83d59a5b609b"], "node": "c82688fb47958982a3491e46b8dedf8bdbbca8e3", "parents": ["a872a271cd476f95a068cd42ef58c3d539ffe51a"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2083970 [wpt PR 63872] - [wdspec] Fix BiDi prompt and reload tests leaking background tasks, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Fix BiDi prompt and reload tests leaking background tasks\n\n- Fix timeouts and flaky teardown errors in WebDriver BiDi user prompt\n  and reload WPTs.\n- Ignored prompts stay open and block script evaluation or navigation,\n  while timed-out reload commands continue running in the background\n  after assertions finish.\n- Close ignored prompts and await pending command tasks in fixture\n  teardown before removing the user context or closing the tab.\n\nTAG=agy\n\nBug: 565712857\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel,linux-blink-rel,android-15-chrome-blink-rel\nChange-Id: Iab30eb1aba8ad1171ce2ab078d315f78c48c032a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8599133\nReviewed-by: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nCommit-Queue: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1721761}\n\n--\n\nwpt-commits: b0896f5f66c2a46dc9057cde2eccd68cce581e8b\nwpt-pr: 63872\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/browser/create_user_context/unhandled_prompt_behavior.py", "testing/web-platform/tests/webdriver/tests/bidi/browsing_context/reload/wait.py"], "git_node": "09087d892773bd7f0108a3f464f582b1687c00d4", "git_parents": ["4f9725663c98daef94c08336cad4ed890501d018"], "node": "b245907d7aff553f7acb34d8e4ab09a380f9a177", "parents": ["c82688fb47958982a3491e46b8dedf8bdbbca8e3"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083970 [wpt PR 63872] - Update wpt metadata, a=testonly\n\nwpt-pr: 63872\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/browser/create_user_context/accept_insecure_certs.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browser/create_user_context/create_user_context.py.ini"], "git_node": "923b807cf05ea3b66716c719e80223208bc7766b", "git_parents": ["09087d892773bd7f0108a3f464f582b1687c00d4"], "node": "5022fa701579a9b867127986b105c9505f6350cd", "parents": ["b245907d7aff553f7acb34d8e4ab09a380f9a177"], "tags": []}, {"author": "tannal \u003cmtan@igalia.com\u003e", "branch": "default", "desc": "Bug 2071754 [wpt PR 62493] - [svg] Swap SVGAElement to the new HyperlinkElementUtils mixin., a=testonly\n\nAutomatic update from web-platform-tests\n[svg] Swap SVGAElement to the new HyperlinkElementUtils mixin.\n\nThis would adds origin, protocol etc attributes to SVG a element behind\na runtime feature flag.\n\nThe spec change: https://github.com/w3c/svgwg/pull/1052\n\nI2P: https://groups.google.com/u/1/a/chromium.org/g/blink-dev/c/QPP0wy0FhCY\n\nBug: 512726601\nChange-Id: I870e83d557a16e0d203260b21e44dbd88d55230a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8015702\nReviewed-by: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nCommit-Queue: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCr-Commit-Position: refs/heads/main@{#1721804}\n\n--\n\nwpt-commits: 35abdea901bfd3773d226a9dd7df744b4e6b5760\nwpt-pr: 62493\n", "files": ["testing/web-platform/tests/svg/linking/scripted/a-hyperlinkutils-getter-setter.html", "testing/web-platform/tests/svg/linking/scripted/a-hyperlinkutils-getter.html"], "git_node": "c0fdf81c75a102e9547a186c64251f0018db9b06", "git_parents": ["923b807cf05ea3b66716c719e80223208bc7766b"], "node": "f21d7cd43ad65a6905de86822c5abdddd39ac773", "parents": ["5022fa701579a9b867127986b105c9505f6350cd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071754 [wpt PR 62493] - Update wpt metadata, a=testonly\n\nwpt-pr: 62493\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/linking/scripted/a-hyperlinkutils-getter-setter.html.ini"], "git_node": "c83471db0b8c4a264a380e340fc07a58c7b5bf2a", "git_parents": ["c0fdf81c75a102e9547a186c64251f0018db9b06"], "node": "855dbf7fcbde8238d7688fde1e79537fee7ed29b", "parents": ["f21d7cd43ad65a6905de86822c5abdddd39ac773"], "tags": []}, {"author": "J\u00falio Piubello \u003cjulio@gitstart.com\u003e", "branch": "default", "desc": "Bug 2084026 [wpt PR 63881] - Make the large-PDF WebDriver fixture deterministic, a=testonly\n\nAutomatic update from web-platform-tests\nMake the large-PDF WebDriver fixture deterministic\n\nThe large-document print test can time out while drawing its canvas one\npixel at a time. Fill an ImageData buffer with deterministic varied pixels\nand upload it once, preserving PDF validation and the minimum-size\nassertion. Remove the corresponding print failure expectations.\n\nBug: 547617167\nChange-Id: I0cea71a90a6f813933a0b9c4d500587214d892d8\nCq-Include-Trybots: luci.chromium.try\u200b:linux-blink-rel,android-15-chrome-blink-rel\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8576777\nReviewed-by: Alex Rudenko \u003calexrudenko@chromium.org\u003e\nCommit-Queue: Julio Piubello \u003cjulio@gitstart.com\u003e\nCr-Commit-Position: refs/heads/main@{#1722061}\n\n--\n\nwpt-commits: d928657a0858e62b66a3724b3249e2b6e6c773a3\nwpt-pr: 63881\n", "files": ["testing/web-platform/tests/webdriver/tests/classic/print/printcmd.py"], "git_node": "a054ad422288bb21b5c8515543823530ada61487", "git_parents": ["c83471db0b8c4a264a380e340fc07a58c7b5bf2a"], "node": "71cb328792fec5bbd70db42e7558286947d1a0c6", "parents": ["855dbf7fcbde8238d7688fde1e79537fee7ed29b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084026 [wpt PR 63881] - Update wpt metadata, a=testonly\n\nwpt-pr: 63881\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/classic/print/printcmd.py.ini"], "git_node": "2e53f65d2cff5281bfab9683b196657b5a763c8c", "git_parents": ["a054ad422288bb21b5c8515543823530ada61487"], "node": "ec1f3fd8290ba4b28bf448fdffb9d755a26dfaa0", "parents": ["71cb328792fec5bbd70db42e7558286947d1a0c6"], "tags": []}, {"author": "Romain Menke \u003c11521496+romainmenke@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083994 [wpt PR 63877] - [css-color] adjust powerless epsilon test so that they are passable by both float and double implementations, a=testonly\n\nAutomatic update from web-platform-tests\n[css-color] adjust powerless epsilon test so that they are passable by both float and double implementations (#63877)\n--\n\nwpt-commits: 0ca34a03675f9ec89e1f79b75e06fb5c13d755d3\nwpt-pr: 63877\n", "files": ["testing/web-platform/tests/css/css-color/parsing/color-computed-powerless.html"], "git_node": "38803af613bf99e82670ccec0fdbee2b8cf6ec30", "git_parents": ["2e53f65d2cff5281bfab9683b196657b5a763c8c"], "node": "4a16f0af54cd0cf264ae6f518e2bce786685531d", "parents": ["ec1f3fd8290ba4b28bf448fdffb9d755a26dfaa0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083994 [wpt PR 63877] - Update wpt metadata, a=testonly\n\nwpt-pr: 63877\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-color/parsing/color-computed-powerless.html.ini"], "git_node": "6d0a4cca65547c8a5d6fc8c459c061ed0da7e10d", "git_parents": ["38803af613bf99e82670ccec0fdbee2b8cf6ec30"], "node": "dcfd4986fb6de0d30f55cad0783b1f2b3f56e81e", "parents": ["4a16f0af54cd0cf264ae6f518e2bce786685531d"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2083988 [wpt PR 63875] - Reset outline color before testing stylesheet values, a=testonly\n\nAutomatic update from web-platform-tests\nReset outline color before testing stylesheet values\n\nThe computed-value checks leave an inline red outline color on the shared target, overriding the stylesheet's auto value in the final test. Remove that declaration before checking how auto computes with different outline styles.\n\nCo-authored-by: codex \u003ccodex@openai.com\u003e\n\n--\n\nwpt-commits: 18aa7efb25564ca8b0ddb1b46a649bc2fd8071d4\nwpt-pr: 63875\n", "files": ["testing/web-platform/tests/css/css-ui/parsing/outline-color-computed.html"], "git_node": "fa488b9c1933962aa60b15c53e0aabd6b47f4a51", "git_parents": ["6d0a4cca65547c8a5d6fc8c459c061ed0da7e10d"], "node": "04d67c14ed4d28cb28b45f2eee257086cf2eb6d1", "parents": ["dcfd4986fb6de0d30f55cad0783b1f2b3f56e81e"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2084031 [wpt PR 63884] - Restrict prefixed generic-family tests to keywords, a=testonly\n\nAutomatic update from web-platform-tests\nRestrict prefixed generic-family tests to keywords\n\nThe shared generic-family list includes generic() functions as well as keywords. Adding -webkit- to a keyword produces a family identifier such as -webkit-serif, but adding it to generic(fangsong) produces an unsupported function, not a family name. The prefixed-family test therefore expects invalid declarations to survive parsing and serialization.\n\nFilter function entries out of this identifier test. Keep them in the unprefixed generic-family and quoted-family tests.\n\nhttps://drafts.csswg.org/css-fonts-4/#font-family-prop\n\nCo-authored-by: codex \u003ccodex@openai.com\u003e\n\n--\n\nwpt-commits: 63f929364c3e05e3432a45fb2ddf25e9eb7b43a0\nwpt-pr: 63884\n", "files": ["testing/web-platform/tests/css/cssom/font-family-serialization-001.html"], "git_node": "70cccbe30dde45e410ae6fe59ff986ec136c0dfd", "git_parents": ["fa488b9c1933962aa60b15c53e0aabd6b47f4a51"], "node": "0aca3fa5839488bbf627b6d3a2e8476f900cd0b4", "parents": ["04d67c14ed4d28cb28b45f2eee257086cf2eb6d1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084031 [wpt PR 63884] - Update wpt metadata, a=testonly\n\nwpt-pr: 63884\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/cssom/font-family-serialization-001.html.ini"], "git_node": "928c7373216a23292705b193a49471c5777223c2", "git_parents": ["70cccbe30dde45e410ae6fe59ff986ec136c0dfd"], "node": "5d44e6c2744667911108adb631446f4a115aa476", "parents": ["0aca3fa5839488bbf627b6d3a2e8476f900cd0b4"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2083995 [wpt PR 63878] - Remove optional position checks from pseudo-element variable tests, a=testonly\n\nAutomatic update from web-platform-tests\nRemove optional position checks from pseudo-element variable tests\n\nThe first-line and first-letter variable tests require position: var(--my-position) to resolve to static when the custom property supplies absolute. This assumes that position cannot apply to these pseudo-elements and that an inapplicable property must expose its initial value through getComputedStyle().\n\nCSS Pseudo explicitly allows user agents to apply properties beyond the required sets, and position is not explicitly excluded. Non-applicability also does not by itself require resetting a computed value to its initial value. These assertions therefore impose requirements that do not follow from the specifications and conflate variable substitution with optional property support.\n\nRemove the direct and chained position cases and their fixtures. Keep the color, font-size, font-weight, and chained color cases, which exercise substitution on properties required to apply to both pseudo-elements.\n\nhttps://drafts.csswg.org/css-pseudo-4/#first-line-styling\nhttps://drafts.csswg.org/css-pseudo-4/#first-letter-styling\nhttps://drafts.csswg.org/css-cascade-5/#computed\nhttps://drafts.csswg.org/cssom/#resolved-values\n\nCo-authored-by: codex \u003ccodex@openai.com\u003e\n\n--\n\nwpt-commits: a26422aab342e2ede3dca385dbd78e16464ed58f\nwpt-pr: 63878\n", "files": ["testing/web-platform/tests/css/css-variables/variable-first-letter.html", "testing/web-platform/tests/css/css-variables/variable-first-line.html"], "git_node": "06a026154485db84fd3f04837edb5b5782982488", "git_parents": ["928c7373216a23292705b193a49471c5777223c2"], "node": "5f7221839149510101b48bc24a8190e76b272aa4", "parents": ["5d44e6c2744667911108adb631446f4a115aa476"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2083541 [wpt PR 63849] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327508, a=testonly\n\nAutomatic update from web-platform-tests\nSVGLength.value setter converts font-relative units using stale style (#63849)\n\nThis patch aligns WebKit with Gecko / Firefox and Blink / Chromium.\n\nSVGLength::valueForBindings() and SVGLength::convertToSpecifiedUnits() call\nupdateStyleIfNeeded() before resolving font-relative units, but\nsetValueForBindings() did not. Setting `value` on an em/ex/ch/lh/rem/rlh length\nright after a font-size change therefore converted the user-unit value to\nspecified units using stale computed style.\n\nFactor the null-element and unit check out of valueForBindings() into a shared\nupdateStyleIfNeeded() helper and use it in setValueForBindings() as well.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327508\nWebKit-Canonical-Link: https://commits.webkit.org/324072@main\n--\n\nwpt-commits: b173bc05d9d63181b1b4a16490a7ce4a279c6af4\nwpt-pr: 63849\n", "files": ["testing/web-platform/tests/svg/types/scripted/SVGLength-value-setter-font-change.html"], "git_node": "b9d632f8951d81064a10dc72f38231c4dede0332", "git_parents": ["06a026154485db84fd3f04837edb5b5782982488"], "node": "1f9823ccdd6cd11d53902bb49cf2788bda68e33b", "parents": ["5f7221839149510101b48bc24a8190e76b272aa4"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2084466 [wpt PR 63918] - Accept auto when parsing column-span, a=testonly\n\nAutomatic update from web-platform-tests\nAccept auto when parsing column-span\n\nCSS Multicol Level 2 includes auto in the column-span grammar. Move the rejection case to valid-value coverage and update the metadata to reference Level 2.\n\nhttps://drafts.csswg.org/css-multicol-2/#propdef-column-span\n\nCo-authored-by: codex \u003ccodex@openai.com\u003e\n\n--\n\nwpt-commits: 5056b6baed567db567f89195b99602b3486b949e\nwpt-pr: 63918\n", "files": ["testing/web-platform/tests/css/css-multicol/parsing/column-span-invalid.html", "testing/web-platform/tests/css/css-multicol/parsing/column-span-valid.html"], "git_node": "7f30a7e6f34b7d0128f4a9064ef08ec0abfa9884", "git_parents": ["b9d632f8951d81064a10dc72f38231c4dede0332"], "node": "040f3661dc580091b87e27609e8bc0180d26e562", "parents": ["1f9823ccdd6cd11d53902bb49cf2788bda68e33b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084466 [wpt PR 63918] - Update wpt metadata, a=testonly\n\nwpt-pr: 63918\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-multicol/parsing/column-span-valid.html.ini"], "git_node": "6a771dce463daebe4ee75b33683e612c71def0b4", "git_parents": ["7f30a7e6f34b7d0128f4a9064ef08ec0abfa9884"], "node": "63243c89fa5a345cc236c8b930da26b367b79052", "parents": ["040f3661dc580091b87e27609e8bc0180d26e562"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@google.com\u003e", "branch": "default", "desc": "Bug 2082586 [wpt PR 63708] - Test that Fragment scripting mode leaves force async true on external scripts, a=testonly\n\nAutomatic update from web-platform-tests\nTest that Fragment scripting mode leaves force async true on external scripts\n\n--\n\nwpt-commits: ee3cbb5ba111b7a1ca37d621bc674b457988212a\nwpt-pr: 63708\n", "files": ["testing/web-platform/tests/domparsing/createContextualFragment-external-scripts-async.html", "testing/web-platform/tests/domparsing/html-unsafe-external-scripts-async.html", "testing/web-platform/tests/domparsing/resources/slow.js", "testing/web-platform/tests/domparsing/unsafe-and-trusted-types-external-scripts-async.html"], "git_node": "b820f7526a2958812e3a40aa428a7c673344b115", "git_parents": ["6a771dce463daebe4ee75b33683e612c71def0b4"], "node": "9dff0707b9e6c436eaa13527e700c520120679ce", "parents": ["63243c89fa5a345cc236c8b930da26b367b79052"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082586 [wpt PR 63708] - Update wpt metadata, a=testonly\n\nwpt-pr: 63708\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/html-unsafe-external-scripts-async.html.ini", "testing/web-platform/meta/domparsing/unsafe-and-trusted-types-external-scripts-async.html.ini"], "git_node": "84bcf8f22e887790494c8cc01fa9c0c6e8293eb4", "git_parents": ["b820f7526a2958812e3a40aa428a7c673344b115"], "node": "a0381b7ebfd5f7d34efac66825c9fcc8952f88b4", "parents": ["9dff0707b9e6c436eaa13527e700c520120679ce"], "tags": []}, {"author": "Andreu Botella \u003cabotella@igalia.com\u003e", "branch": "default", "desc": "Bug 2082331 [wpt PR 63645] - Update baseline-related tests for -webkit-line-clamp, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate baseline-related tests for -webkit-line-clamp\n\nThe tests changed in this patch are all baseline alignment tests that\ninvolve `-webkit-line-clamp` containers which are sized according to\ntheir intrinsic inline sizes (because they're in grid or flex layout,\nor because they're atomic inlines), and which only contain atomic\ninlines.\n\nWith the legacy implementation of `-webkit-line-clamp` in all\nmainstream browsers, characters and atomic inlines could be hid in\norder to place the ellipsis, but that didn't affect layout, including\nbaselines. With the spec'd behavior of `(-webkit-)line-clamp`, though,\nremoving characters and atomic inlines does affect layout.\n\nThe reason the ellipsis needs to remove the atomic inline is because\nall of the contents of the line-clamp containers have a single atomic\ninline per line, and the intrinsic sizing ignores any effect the\nellipsis might have (see w3c/csswg-drafts#14239). Therefore, when the\nellipsis needs to be placed, it must remove content, which happens to\nbe the atomic inline which is causing the baseline effect these tests\nexpect.\n\nTo fix this, this patch adds a `line-clamp` declaration with the\n`no-ellipsis` keyword, so there is no ellipsis that will result in the\natomic inlines to be removed. This is added after each\n`-webkit-line-clamp` declaration, assuming that all browsers that\nsupport `-webkit-line-clamp` but not `line-clamp` will have the legacy\nellipsis behavior.\n\n--\n\nwpt-commits: e57eb6552eceba6f376f315c80ddcb47bfc1104c\nwpt-pr: 63645\n", "files": ["testing/web-platform/tests/css/css-flexbox/alignment/flex-align-baseline-line-clamp-001.tentative.html", "testing/web-platform/tests/css/css-flexbox/alignment/flex-align-baseline-line-clamp-002.tentative.html", "testing/web-platform/tests/css/css-flexbox/alignment/flex-align-baseline-line-clamp-003.tentative.html", "testing/web-platform/tests/css/css-grid/alignment/grid-align-baseline-line-clamp-001.tentative.html", "testing/web-platform/tests/css/css-grid/alignment/grid-align-baseline-line-clamp-002.tentative.html", "testing/web-platform/tests/css/css-grid/alignment/grid-align-baseline-line-clamp-003.tentative.html", "testing/web-platform/tests/css/css-inline/baseline-source/baseline-source-first-001.html", "testing/web-platform/tests/css/css-inline/baseline-source/baseline-source-first-002.html", "testing/web-platform/tests/css/css-inline/baseline-source/baseline-source-first-003.html", "testing/web-platform/tests/css/css-inline/baseline-source/baseline-source-last-001.html", "testing/web-platform/tests/css/css-inline/baseline-source/baseline-source-last-002.html", "testing/web-platform/tests/css/css-inline/baseline-source/baseline-source-last-003.html"], "git_node": "da0d1fcb97820de825da9a724fcd4b368b2be60e", "git_parents": ["84bcf8f22e887790494c8cc01fa9c0c6e8293eb4"], "node": "2487ed0e3021f0291273445960cafd5252c04674", "parents": ["a0381b7ebfd5f7d34efac66825c9fcc8952f88b4"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2083860 [wpt PR 63867] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=327381, a=testonly\n\nAutomatic update from web-platform-tests\nChanging the children of an SVG \u003cmask\u003e used by CSS mask-image does not repaint the masked element (#63867)\n\nAn HTML element with mask-image: url(#m) keeps showing the old mask\nafter a script changes the children of \u003cmask id=\"m\"\u003e. Resizing the\nwindow repaints it with the new mask. Firefox and Chrome update right\naway.\n\nCSS Masking allows a mask-image URL to point at a mask element:\n\n    A URL reference to a mask element (for example\n    url(commonmasks.svg#mask)) or to a CSS image.\n\nhttps://drafts.csswg.org/css-masking-1/#valdef-mask-image-url\n\nAn element that uses an SVG resource through CSS is repainted when the\nresource changes, but only for the resources listed by\nReferencedSVGResources::referencedSVGResourceIDs(). clip-path and filter\nhave been listed for both SVG engines since 241274@main\n(https://webkit.org/b/204204). mask was listed only when the layer-based\nSVG engine is enabled. It is off by default, so the masked element was\nnever repainted.\n\nList mask for both engines, by moving the layer-based engine check below\nit. The legacy engine already notifies these listeners when a mask child\nchanges, and the masked element redraws the mask from its children each\ntime it paints.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327381\nWebKit-Canonical-Link: https://commits.webkit.org/324026@main\n--\n\nwpt-commits: 10dd48f8bc0c18d6b695c83dfa230880385dbf79\nwpt-pr: 63867\n", "files": ["testing/web-platform/tests/css/css-masking/mask-image/mask-image-url-local-mask-mutated.html", "testing/web-platform/tests/css/css-masking/mask-image/reference/mask-image-url-local-mask-mutated-ref.html"], "git_node": "e7a191029877cb84a3cc44792d1ffc5c50832d30", "git_parents": ["da0d1fcb97820de825da9a724fcd4b368b2be60e"], "node": "7438c579178d06da7d3d19cc53f2973f72596a14", "parents": ["2487ed0e3021f0291273445960cafd5252c04674"], "tags": []}, {"author": "\u865a\u7121 \u003cieee0824x@gmail.com\u003e", "branch": "default", "desc": "Bug 2080666 [wpt PR 63537] - Test ProcessingInstruction characterData using a real PI node, a=testonly\n\nAutomatic update from web-platform-tests\nTest ProcessingInstruction characterData using a real PI node\n--\n\nwpt-commits: dff7cf45938f6e16427f5607bac82a803534484b\nwpt-pr: 63537\n", "files": ["testing/web-platform/tests/dom/nodes/MutationObserver-characterData.html"], "git_node": "78ab1761dd452472b191c411f8cb2f5bb704f34b", "git_parents": ["e7a191029877cb84a3cc44792d1ffc5c50832d30"], "node": "d540cb35224e4143c7d5506a647790bbdbea2400", "parents": ["7438c579178d06da7d3d19cc53f2973f72596a14"], "tags": []}, {"author": "Stalgia Grigg \u003cstalgiag@igalia.com\u003e", "branch": "default", "desc": "Bug 2084313 [wpt PR 63903] - WebSocket: make the bad port test observe blocked requests, a=testonly\n\nAutomatic update from web-platform-tests\nWebSocket: make the bad port test observe blocked requests (#63903)\n\n`Create-blocked-port.any.js` passes whether or not a port is blocked because nothing listens on those ports.\n\nThis routes the connections through a per-test PAC to wptserve, where `accept-handshake.py` completes the handshake so that a port that isn't blocked opens.\n--\n\nwpt-commits: cfddf189bbfee915fcc42e97592e4dfd5085e02d\nwpt-pr: 63903\n", "files": ["testing/web-platform/tests/websockets/Create-blocked-port.any.js", "testing/web-platform/tests/websockets/constants.sub.js", "testing/web-platform/tests/websockets/resources/accept-handshake.py", "testing/web-platform/tests/websockets/resources/https-proxy.sub.pac"], "git_node": "2b9e3d6927c4d72add7c8297e926352f8863b044", "git_parents": ["78ab1761dd452472b191c411f8cb2f5bb704f34b"], "node": "ab431b1b3b6e46d0b6b10972437d82fa9ce993f0", "parents": ["d540cb35224e4143c7d5506a647790bbdbea2400"], "tags": []}, {"author": "Jer Noble \u003cjer.noble@apple.com\u003e", "branch": "default", "desc": "Bug 2084629 [wpt PR 63954] - [WebVTT] 10x wpt/webvtt tests are failing because the test reference does not use `text-wrap: balance`, a=testonly\n\nAutomatic update from web-platform-tests\n[WebVTT] 10x wpt/webvtt tests are failing because the test reference does not use `text-wrap: balance` (#63954)\n\nThe WebVTT specification requires applying `text-wrap: balance` by default to all cues. The references\nfor many tests failed to apply this style leading to an incorrect reporting of test failures.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327753\nWebKit-Canonical-Link: https://commits.webkit.org/324255@main\n--\n\nwpt-commits: ed96db1b2169ac6eab2dceb4bd894e37c8c61847\nwpt-pr: 63954\n", "files": ["testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/portrait-ref.tentative.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/class_object/class_white-space_normal_wrapped-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/class_object/class_white-space_pre-line_wrapped-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/italic_object/italic_white-space_normal_wrapped-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/italic_object/italic_white-space_pre-line_wrapped-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/underline_object/underline_white-space_normal_wrapped-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/underline_object/underline_white-space_pre-line_wrapped-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_white-space_normal_wrapped-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/voice_object/voice_white-space_pre-line_wrapped-ref.html"], "git_node": "d8d71f9c6f996ceb3776f233133300e581d4495a", "git_parents": ["2b9e3d6927c4d72add7c8297e926352f8863b044"], "node": "9d106017e00dedca1c89d2c54f92c3799c4797a0", "parents": ["ab431b1b3b6e46d0b6b10972437d82fa9ce993f0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084629 [wpt PR 63954] - Update wpt metadata, a=testonly\n\nwpt-pr: 63954\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/fontsize_smaller_than_container.tentative.html.ini"], "git_node": "1929aaddae036f06bc739454fc52a8c87b7cc425", "git_parents": ["d8d71f9c6f996ceb3776f233133300e581d4495a"], "node": "b664c6874f1a12ee65301dd7f0a2398771b8aacf", "parents": ["9d106017e00dedca1c89d2c54f92c3799c4797a0"], "tags": []}, {"author": "Jer Noble \u003cjer.noble@apple.com\u003e", "branch": "default", "desc": "Bug 2084634 [wpt PR 63956] - WebVTT tests can have small pixel differences due to font smoothing over semi-transparent backgrounds, a=testonly\n\nAutomatic update from web-platform-tests\nWebVTT tests can have small pixel differences due to font smoothing over semi-transparent backgrounds (#63956)\n\nSmall pixel differences can creep in when fonts are painted atop semi-transparent backgrounds, when\nthe cue is contained in a composited layer instead of a normal painting context. To make these tests\nmore robust and precise, use a solid background for testing rather than a semi-transparent one.\n\nThis change results in 67 additional WebVTT rendering tests passing on macOS and iOS.\n\nWebKit-Bug: https://bugs.webkit.org/show_bug.cgi?id=327712\nWebKit-Canonical-Link: https://commits.webkit.org/323876@main\n--\n\nwpt-commits: 52f8bccc86a055db98b343df494717f65ce5c318\nwpt-pr: 63956\n", "files": ["testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/bidi_ruby-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/bidi_ruby.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/start_alignment-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/start_alignment.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/u002E_LF_u05D0-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/u002E_LF_u05D0.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/bidi/u002E_u2028_u05D0-ref.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/p