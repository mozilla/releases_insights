079fa6f4ae3e253be4d742351a250471f0f0e5e2", "git_parents": ["73521f95b2e8466959ddb7a4bd599f9d2ea2408e"], "node": "06f0478caaa5cf935e364247c112fc798edc0ebd", "parents": ["711344e3b8abc0e24af055e7f0c660ac36c65914"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2091622: Fetch only the tags when mach vendor looks up a tag. r=firefox-build-system-reviewers,sergesanspaille\n\nupstream_tag made a full clone, with a checkout, to run `git tag\n--sort=creatordate` and `git log -1` on the result. Those only read tag\nobjects and the commits they point at, so fetch just those, at depth 1\nand with no trees. The tag and timestamp are unchanged for every\ntag-tracking library with an Updatebot task, and the lookup drops from\nup to 10 seconds (perfetto, opentelemetry-cpp, cairo) to under 2. It\nruns on every Updatebot check for those libraries, and again when\nvendoring one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341820\n", "files": ["python/mozbuild/mozbuild/test/vendor/test_vendor_manifest.py", "python/mozbuild/mozbuild/vendor/host_base.py"], "git_node": "61cba4943c9e4df99298bdcb2064c5539c3bd0c6", "git_parents": ["079fa6f4ae3e253be4d742351a250471f0f0e5e2"], "node": "83e11b231e65f4e542b3dc435bc93770bbf03986", "parents": ["06f0478caaa5cf935e364247c112fc798edc0ebd"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091869 - Suppress the new CognitiveComplexMethod detekt warning incidentally triggered by this patch. r=mcarare\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt"], "git_node": "81ab73f807b916a450afa29bfaf09c15d14e225d", "git_parents": ["61cba4943c9e4df99298bdcb2064c5539c3bd0c6"], "node": "8e9281852055f8980e7252d6c2068464f1768c8e", "parents": ["83e11b231e65f4e542b3dc435bc93770bbf03986"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branc