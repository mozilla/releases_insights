rvice/nimbus/src/test/java/mozilla/components/service/nimbus/messaging/NimbusMessagingStorageTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FxNimbusHelper.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/NimbusMessagingHomescreenTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/NimbusMessagingSurveyTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/experiments/NimbusSetup.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/experiments/NimbusSetup.kt"], "git_node": "b3f42cd1593350e73726271b87c8e70bdafb904d", "git_parents": ["f6667c6eeab3d62c58a81635cc00afd3a5d81d63"], "node": "9ab71924979ecf15b512e1d048b4277b9fd76f41", "parents": ["e04b3b53b2ae903db35540c95a257d583bbc4b10"], "tags": []}, {"author": "Ben Dean-Kawamura \u003cbdk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092257 - Remove RustAuthState references, r=beth,android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342318\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/FirefoxAccount.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/FxaAccountManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/FxaAccountManagerTest.kt"], "git_node": "3406174cef31b94f4727abf0d149cbd84625ccd9", "git_parents": ["b3f42cd1593350e73726271b87c8e70bdafb904d"], "node": "1d303ec5b0318951b540b3b6aa7b85be27b5dd42", "parents": ["9ab71924979ecf15b512e1d048b4277b9fd76f41"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 2084316 - Use SnackbarDelegate with a non-root view r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340256\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/nimbus/NimbusBranchesFragment.kt"], "git_node": "11124311eafb8c3eb713436765f3395299414540", "git_parents": ["3406174cef31b94f4727abf0d149cbd84625ccd9"], "node": "414b4ca33522b8d61e5b7e230a3df62a8848f822", "parents": ["1d303ec5b0318951b540b3b6aa7b85be27b5dd42"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2092395. Wait two frames after the last frame before finishing webgl-color-offscreen-test.html. r=gfx-reviewers,lsalzman\n\nAn OffscreenCanvas commits its frame to the compositor asynchronously, and the\ntest finished in the same task as its last draw, so the reftest snapshot could\nbe taken before the frame was presented, giving a blank canvas.\n\nThis is the cause of some of the failures in bug 1788351.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342440\n", "files": ["dom/canvas/test/reftest/webgl-color-offscreen-test.html"], "git_node": "03d2f110f089566e66f9c0e8be2cb45de0aede94", "git_parents": ["11124311eafb8c3eb713436765f3395299414540"], "node": "f5627778c5cbf916bd6c7d0972151810f3fc8eba", "parents": ["414b4ca33522b8d61e5b7e230a3df62a8848f822"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2084316 - Use SnackbarDelegate with a non-root view r=android-reviewers,mcarare\" for causing android failures\n\nThis reverts commit 11124311eafb8c3eb713436765f3395299414540.\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/nimbus/NimbusBranchesFragment.kt"], "git_node": "2e185039d9be31b6a60f9c002144e7ee0dd22762", "git_parents": ["03d2f110f089566e66f9c0e8be2cb45de0aede94"], "node": "02edb0c1927d7c3c87c8ed76e232f616fa76ac07", "parents": ["f5627778c5cbf916bd6c7d0972151810f3fc8eba"], "tags": []}], "date": 1794559876, "git_changesets": ["155e823269e290498670169c64a7c1c0759b6598", "db5832e4f51450cf647dcaabadc8b0ed72f0495a", "e286a9c26637