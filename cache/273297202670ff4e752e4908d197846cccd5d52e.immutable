s/pdfjs/content/web/cmaps/UniKS-UTF16-H.bcmap.br", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF16-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF16-V.bcmap.br", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF32-H.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF32-H.bcmap.br", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF32-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF32-V.bcmap.br", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF8-H.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF8-H.bcmap.br", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF8-V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/UniKS-UTF8-V.bcmap.br", "toolkit/components/pdfjs/content/web/cmaps/V.bcmap", "toolkit/components/pdfjs/content/web/cmaps/V.bcmap.br", "toolkit/components/pdfjs/content/web/cmaps/WP-Symbol.bcmap", "toolkit/components/pdfjs/content/web/cmaps/WP-Symbol.bcmap.br", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "d48f76d2c2bd7e2a521fbf0a697b61d1234132d0", "git_parents": ["6118fd76c574eb437541fdf22276ebcdfec5dcbe"], "node": "d919c12a1443b466b59fb690001cf601a116949e", "parents": ["ac9b0860ed6ecdc5a53918a5744e1bf3d1620588"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092222 - part 1: wait for the Smart Window sidebar document instead of polling for ai-window r=jlewis\n\nwait for DOMContentLoaded rather than load so a new sidebar starts its chat as early as polling did. also fix bug 2091644 browser_security_run_search.js timing\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341189\n", "files": ["browser/components/aiwindow/AGENTS.md", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_security_run_search.js"], "git_node": "4b1811855f8351543d9f2d1bbfcec17acf7c1d3d", "git_parents": ["d48f76d2c2bd7e2a521fbf0a697b61d1234132d0"], "node": "10b5d79aae325bbdd58db5f1467711f52683c2db", "parents": ["d919c12a1443b466b59fb690001cf601a116949e"], "tags": []}, {"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092222 - part 2: split browser_smart_actions_toolbar for slow chaos test verify r=jlewis\n\nsplits into 5 tests each and simplify to one window speeding up 40%\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342692\n", "files": ["browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_smart_actions_toolbar.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/smart_actions/browser.toml", "browser/components/aiwindow/ui/test/browser/smart_actions/browser_smart_actions_toolbar.js", "browser/components/aiwindow/ui/test/browser/smart_actions/browser_smart_actions_toolbar_hiding.js", "browser/components/aiwindow/ui/test/browser/smart_actions/head.js"], "git_node": "8ee9b48609cb19abaa0bbe64104910f53e04c195", "git_parents": ["4b1811855f8351543d9f2d1bbfcec17acf7c1d3d"], "node": "fed6b7e60261836c8011d27d953a71b6f24d20ad", "parents": ["10b5d79aae325bbdd58db5f1467711f52683c2db"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 1700396: Bump Updatebot r=firefox-build-system-reviewers,ahochheiden\n\nThis includes:\nAdd the maintainer as a reviewer instead of replacing the reviewers. Fixes #419\nSummarize the commits by author, and whether they were signed, in the bug description. Fixes #362\nLeave a Phabricator revision alone if someone has commandeered it. Fixes #397\nRetry Bugzilla writes that fail with a gateway error, without repeating them. Fixes #401\nMake the Conduit calls through one helper\nLeave a superseded bug open if someone has commandeered its revision. Fixes #384\nRecord the Taskcluster task that created each job. Fixes #350\nClone upstream repositories without file contents. Fixes #385\nBorrow objects from a local copy of an upstream repository when there is one.\nRun CI on Ubuntu 24.04, and update the package lists before installing Mercurial.\nReturn command output as text instead of decoding it at every call site. Fixes #244\nLog hg status when ./mach try refuses to push because of uncommitted changes. Fixes #392\nPoint out license file changes at the top of the bug. Fixes #190\nTest that the mock providers match the classes they mock. Fixes #104\nStop reprocessing jobs that can never progress, and skip resets that do nothing.\nTreat a try push Treeherder no longer has like one with no job results.\nDon't retry arc diff when it stops to ask a question, and say which.\nTest Phabricator submission with the real arc, against a fake Phabricator.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342856\n", "files": ["taskcluster/docker/updatebot/updatebot-version.sh"], "git_node": "2d48885ba008afcab7952813ad91778f3a615ce6", "git_parents": ["8ee9b48609cb19abaa0bbe64104910f53e04c195"], "node": "8980f7a80e7313db69ce33d20268d4fe35d67644", "parents": ["fed6b7e60261836c8011d27d953a71b6f24d20ad"], "tags": []}, {"author": "tobypilling \u003ctoby@thunderbird.net\u003e", "branch": "default", "desc": "Bug 2090909 - Remove mail.* from mochitest ignorePrefs.json. r=florian\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342071\n", "files": ["testing/mochitest/ignorePrefs.json"], "git_node": "4e027485ed6727c811459eb98c620687a60df37c", "git_parents": ["2d48885ba008afcab7952813ad91778f3a615ce6"], "node": "e87cf4d6ca8714143f28809ced1b50855dec326e", "parents": ["8980f7a80e7313db69ce33d20268d4fe35d67644"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 220d8