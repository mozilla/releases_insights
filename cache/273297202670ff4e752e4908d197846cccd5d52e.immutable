elint-plugin-mozilla/rules/use-design-tokens/font-weight.md", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/use-design-tokens/size.md", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/use-design-tokens/space.md", "taskcluster/kinds/source-test/node.yml", "tools/lint/stylelint/stylelint-plugin-mozilla/config.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/package.json", "tools/lint/stylelint/stylelint-plugin-mozilla/scripts/update-docs.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.docs.tests.mjs"], "git_node": "c8101ad5b2890670354e5579c5cfc4fe6a827f07", "git_parents": ["298c9b363a5919152d4804119f87d55a31b98667"], "node": "79cd18836d3654f503583a0ec659503da9586da5", "parents": ["93841fd9e9502f10eb7ba2dd7cd4ef9470448ede"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2086032 - Add an AutoBoolPref helper to the CSP parser gtests; r=tschuster\n\nrunTestSuite() doesn't need to enable Trusted Types anymore, as it's enabled by\ndefault, so remove that. Add AutoBoolPref, which sets a bool pref for its\nlifetime, for the gtests of url-hash-source and 'strict-dynamic-url' which\nfollow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342265\n", "files": ["dom/security/test/gtest/TestCSPParser.cpp"], "git_node": "aac366efed118ab4bbb1b6ff4db8cee13232b9d4", "git_parents": ["c8101ad5b2890670354e5579c5cfc4fe6a827f07"], "node": "e5461952b28c4df713ae0970cdc3a22b1da2ae05", "parents": ["79cd18836d3654f503583a0ec659503da9586da5"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2092017 - Use moz-src for toolkit/components/contentanalysis r=reusable-components-reviewers,tgiles,gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342072\n", "files": ["browser/components/genai/GenAI.sys.mjs", "toolkit/components/contentanalysis/ContentAnalysisWasmChild.sys.mjs", "toolkit/components/contentanalysis/components.conf", "toolkit/components/contentanalysis/moz.build", "toolkit/components/contentanalysis/tests/xpcshell/head.js", "toolkit/components/downloads/DownloadIntegration.sys.mjs", "toolkit/components/prompts/content/commonDialog.js", "toolkit/content/widgets/browser-custom-element.mjs", "toolkit/modules/ActorManagerParent.sys.mjs", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json", "tools/lint/extra-js-modules/allowlist.txt"], "git_node": "4396c7c66c0c6af98baf3c4066827caee6ca3ab7", "git_parents": ["aac366efed118ab4bbb1b6ff4db8cee13232b9d4"], "node": "a1dc10e9faaceff9846e580fdfa17e9986547b46", "parents": ["e5461952b28c4df713ae0970cdc3a22b1da2ae05"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092963 - Use tmp_path for the stdin filename in mozlint's CLI test. r=linter-reviewers,ahochheiden\n\nThe CLI creates the stdin temp file next to --stdin-filename, so the test briefly put a tmp*.py file in\npython/mozlint/test/files, which other test modules running in parallel walk.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342920\n", "files": ["python/mozlint/test/test_cli.py"], "git_node": "f898416c560977636760a1fdab1d3f468cb62486", "git_parents": ["4396c7c66c0c6af98baf3c4066827caee6ca3ab7"], "node": "21cb931e75f9d02cc5c8ca13625820848f6ef413", "parents": ["a1dc10e9faaceff9846e580fdfa17e9986547b46"], "tags": []}], "date": 1794778519, "git_changesets": ["a48561e23f2695b1121dda5dbd1284055969d4e1", "bc565aeabe5fdcb21f23dbb4f0149965a65e17f4", "9836e84a5fbe9b4f325561eacbb04d0e5a4a13fd", "298c9b363a5919152d4804119f87d55a31b98667", "c8101ad5b2890670354e5579c5cfc4fe6a827f07", "aac366efed118ab4bbb1b6ff4db8cee13232b9d4", "4396c7c66c0c6af98baf3c4066827caee6ca3ab7", "f898416c560977636760a1fdab1d3f468cb62486"], "user": "agoloman@mozilla.com"}, "45789": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092804 - Install Android SDK packages with the Android CLI from the stable channel. r=android-build-system-reviewers,ahochheiden\n\nThe sdkmanager in cmdline-tools 23.0 is a deprecated wrapper around `android sdk`. The CLI accepts the\nlicenses itself, takes ';' package paths, and does not need Java. The stable channel now carries every package\nwe install on Apple Silicon, while --channel=3 pulled the beta emulator and canary platform-tools there.\n\nThe install passes --force so that SDKs which already have those canary and beta packages move back to stable:\nwithout it the CLI refuses the downgrade, and --no-downgrade is not available in every CLI version the\ncmdline-tools launcher may have downloaded. The CLI exits successfully when a package is not found, so check\nthat each package's directory exists afterwards. Also pass --no-metrics to opt out of the CLI's usage data\ncollection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342857\n", "files": ["build/moz.configure/android-sdk.configure", "mobile/android/mach_commands.py", "python/mozboot/mozboot/android.py", "python/mozboot/mozboot/test/test_android.py"], "git_node": "f1c5a5211f474e01c9ca65ff32f2e3d7a67a46ad", "git_parents": ["f898416c560977636760a1fdab1d3f468cb62486"], "node": "bcef16f8fcac3a64288651d74e2cc1f955c50fa8", "parents": ["21cb931e75f9d02cc5c8ca13625820848f6ef413"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091738 - Generate the use-design-tokens rule's list of checked properties from config.mjs. r=hjones,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341923\n", "files": ["docs/code-quality/lint/linters/stylelint-plugin-mozilla.md", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/use-design-tokens.md", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/use-design-tokens/background-col