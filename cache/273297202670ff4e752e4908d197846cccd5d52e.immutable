git_parents": ["33ec6e4fab5d0ff6fda80fdb5d64b53812860026"], "node": "204ff225f95f0049837ba32a6b21f43a721b593a", "parents": ["546b1a8340d24c3e79b3dd4ac557b8a1759642bd"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077597: Move address and search bar results with the toolbox in macOS fullscreen. r=desktop-theme-reviewers,urlbar-reviewers,tabbrowser-reviewers,jswinarton,emilio,jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333091\n", "files": ["browser/base/content/browser-fullScreenAndPointerLock.js", "browser/components/urlbar/tests/browser-UrlbarView/browser.toml", "browser/components/urlbar/tests/browser-UrlbarView/browser_fullscreenMenubarShift.js"], "git_node": "190ec751d65bfaedfa3aa3df14ae6f4a35c5636d", "git_parents": ["00fe0eef4588a184a92d359703720d7c5b850c18"], "node": "6aa496b12b4627d77bcf031c418d47980bd377b0", "parents": ["204ff225f95f0049837ba32a6b21f43a721b593a"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2089913 - Use a pin instead of a hold mark. r=jcristau\n\nThe hold mark doesn't properly handle the case where there's an even\nnewer version of the package.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340258\n", "files": ["taskcluster/docker/debian-raw/Dockerfile"], "git_node": "77f392f637491f625b22f34bee4370be81a9f2a9", "git_parents": ["190ec751d65bfaedfa3aa3df14ae6f4a35c5636d"], "node": "4ca5dff35c49c0d85cd08da1d452b3efc6e21d4d", "parents": ["6aa496b12b4627d77bcf031c418d47980bd377b0"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2089905 - Fortify code added in bug 2084865. r=jcristau\n\nWhile here, also fortify what was added in bug 1984380.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340250\n", "files": ["taskcluster/docker/debian-raw/Dockerfile"], "git_node": "50227827d24af6633745cb16171366c1bb9fc301", "git_parents": ["77f392f637491f625b22f34bee4370be81a9f2a9"], "node": "62b63c79593164de19efd8af2e73d994834a97d1", "parents": ["4ca5dff35c49c0d85cd08da1d452b3efc6e21d4d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089888 - Stop holding ca-certificates at a fixed version in the Ubuntu 22.04 images. r=glandium\n\nThe 22.04 images are not built from a snapshot, so they already get a current ca-certificates from\njammy-updates, and holding the older package broke installing ca-certificates-java, which depends on the newer\none.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340222\n", "files": ["taskcluster/docker/debian-raw/Dockerfile"], "git_node": "f26767f7470e04905e9bcf9b4beb2ab5a2ece55e", "git_parents": ["50227827d24af6633745cb16171366c1bb9fc301"], "node": "c7278a71b5e1d62ebfabdada4860f49e69cf66f2", "parents": ["62b63c79593164de19efd8af2e73d994834a97d1"], "tags": []}, {"author": "Jonatan Wallmander \u003cjonatan.wallmander@kdab.com\u003e", "branch": "default", "desc": "Bug 1873784 - WebGL: Prevent uint64 rollover r=nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339835\n", "files": ["dom/canvas/WebGLParent.cpp"], "git_node": "341334fce5c7d171cdd021edc782e0e5a09a3ced", "git_parents": ["f26767f7470e04905e9bcf9b4beb2ab5a2ece55e"], "node": "de77367d8c1cc12b6a8edcaba670a4e222204bff", "parents": ["c7278a71b5e1d62ebfabdada4860f49e69cf66f2"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088872 - Reject addresses and credit cards containing lone surrogates r=dimi\n\nEncoding a string for the Rust store replaces each lone surrogate with U+FFFD, so such a record would not be stored as submitted. Records saved before this still migrate that way, so the migration check no longer counts the replacement as a divergence.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339500\n", "files": ["browser/extensions/formautofill/test/unit/test_addressRecords.js", "browser/extensions/formautofill/test/unit/test_creditCardRecords.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_address_adapter.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_address_migration.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_adapter.js", "toolkit/components/formautofill/AutofillStorageMigrator.sys.mjs", "toolkit/components/formautofill/FormAutofillStorageBase.sys.mjs", "toolkit/components/formautofill/RustAutofillAdapterBase.sys.mjs"], "git_node": "7bd547bd93bb73c6c740ac1bb4e26f61890a4338", "git_parents": ["341334fce5c7d171cdd021edc782e0e5a09a3ced"], "node": "3b21ca2d73005c30c8d6bde83e14e2f4a23348ae", "parents": ["de77367d8c1cc12b6a8edcaba670a4e222204bff"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060847 - Show a container flag in pinned tab in the tab list view r=desktop-theme-reviewers,fxview-reviewers,dao,sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337865\n", "files": ["browser/components/firefoxview/opentabs-tab-list.mjs", "browser/components/firefoxview/opentabs-tab-row.css"], "git_node": "cf00742904741d2840eb473f5bfee769a59fe246", "git_parents": ["7bd547bd93bb73c6c740ac1bb4e26f61890a4338"], "node": "1bbae3ec6acf131a2d64294780b72f5b6e0a859c", "parents": ["3b21ca2d73005c30c8d6bde83e14e2f4a23348ae"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028219 - Part 1: Make CalcUnpaginatedBSize start at the cell's own row. r=layout-reviewers,emilio\n\nCalcUnpaginatedBSize walked from the row group's first row on every paginated\ncell reflow, which is quadratic in the number of rows. It also compared the\ncell's table-wide row index with a counter starting at 0 for the row group, so\npercentage block-sizes in cells of any row group after the first resolved\nagainst the wrong rows.\n\nCo-authored-by: Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336990\n", "files": ["layout/tables/nsTableCellFrame.cpp", "testing/web-platform/tests/css/css-tables/table-cell-percent-height-row-groups-print-ref.html", "testing/web-platform/tests/css/css-tables/table-cell-percent-height-row-groups-print.html", "testing/web-platform/tests/css/css-tables/table-cell-percent-height-rowspan-fragmented-print-ref.html", "testing/web-platform/tests/css/css-tables/table-cell-percent-height-rowspan-fragmented-print.html"], "git_node": "300eed4f7c6fc894a6083255ef37bad7d1755dd5", "git_parents": ["cf00742904741d2840eb473f5bfee769a59fe246"], "node": "9aeacd7e0d0d765bc7d808835ea8ba43067273b9", "parents": ["1bbae3ec6acf131a2d64294780b72f5b6e0a859c"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028219 - Part 2: Stop letting a forced break in a table row group disable its break-inside: avoid. r=layout-reviewers,emilio\n\nA forced break only overrides break-inside: avoid at its own break point\n(https://drafts.csswg.org/css-break-3/#forced-breaks). SplitRowGroup only\nchecks break-inside: avoid at the first row that doesn't fit, and a forced\nbreak before that row would already have ended the page.\n\nPart 3 stops ReflowChildren at the end of the page, so it wouldn't see the\nlater forced breaks anyway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340376\n", "files": ["layout/tables/nsTableRowGroupFrame.cpp", "layout/tables/nsTableRowGroupFrame.h", "testing/web-platform/tests/css/css-break/table/table-row-break-inside-avoid-later-forced-break-print-ref.html", "testing/web-platform/tests/css/css-break/table/table-row-break-inside-avoid-later-forced-break-print.html", "testing/web-platform/tests/css/css-break/table/table-row-group-break-inside-avoid-forced-break-moved-by-rowspan-print-ref.html", "testing/web-platform/tests/css/css-break/table/table-row-group-break-inside-avoid-forced-break-moved-by-rowspan-print.html", "testing/web-platform/tests/css/css-break/table/table-row-group-break-inside-avoid-later-forced-break-print-ref.html", "testing/web-platform/tests/css/css-break/table/table-row-group-break-inside-avoid-later-forced-break-print.html"], "git_node": "5ba2426f28551025bbb16da7865dc703ab9700c3", "git_parents": ["300eed4f7c6fc894a6083255ef37bad7d1755dd5"], "node": "de44d562ff7a8ff5a95763f596bc7e93e1a32892", "parents": ["9aeacd7e0d0d765bc7d808835ea8ba43067273b9"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062409 - Keep the browser context in the request history r=ai-security-reviewers,ngrato\n\nThe browser context for user messages is only written when it changes, but only the latest context for a user message was sent. Follow-ups on an unchanged tab carried no context.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334632\n", "files": ["browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_ChatConversation.js"], "git_node": "8d67e78ebdd0a34de5a784e0a514c5f143445ccd", "git_parents": ["5ba2426f28551025bbb16da7865dc703ab9700c3"], "node": "eb66b12adbde2991c2f15e666a6f9ec3d7b56ef5", "parents": ["de44d562ff7a8ff5a95763f596bc7e93e1a32892"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062409 - Find user message for a reply by position r=ngrato\n\nEnsure we use the correct last user message before a reply. The parent of a model reply is only a user message if the turn did not include tool calls. Retry and finding the original user prompt relied on that. D334636 updates the behaviour to store a reply after its tool results.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334634\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/ToolUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_retry_context.js", "browser/components/aiwindow/ui/test/xpcshell/test_ToolUI.js"], "git_node": "6b9f390ef3c8f9b8aab4025a2d0fe2678c9e1657", "git_parents": ["8d67e78ebdd0a34de5a784e0a514c5f143445ccd"], "node": "f323fee84bf091683d1a27611c83c8f87d9daa2a", "parents": ["eb66b12adbde2991c2f15e666a6f9ec3d7b56ef5"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062409 - Render an assistant turn as a single bubble r=ngrato\n\nShow assistant messages of a turn in a single bubble, so the reply can be stored after its tool calls without splitting a turn.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334635\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/test/browser/browser_aichat_content_action_log_order.js"], "git_node": "9ea955f5f067faf348bb3112bb2c6abb0bbd4d68", "git_parents": ["6b9f390ef3c8f9b8aab4025a2d0fe2678c9e1657"], "node": "6d4db8b47bbc29a8771fc5c52920788cd46809c5", "parents": ["f323fee84bf091683d1a27611c83c8f87d9daa2a"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062409 - Store a reply after the tool results it is based on r=ai-security-reviewers,ngrato,tetchart\n\nA reply streamed into a chat message is created before its tool calls, so follow-up requests sent the reply ahead of the tool call. Stream text after the tool results instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334636\n", "files": ["browser/components/aiwindow/models/tests/xpcshell/test_Chat.js", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aichat_content_action_log_order.js", "browser/components/aiwindow/ui/test/xpcshell/test_ChatConversation.js"], "git_node": "ba5455eb36fee5853c19a30b6e3442e12c724e8d", "git_parents": ["9ea955f5f067faf348bb3112bb2c6abb0bbd4d68"], "node": "58e3cb4ec195109558fa824ef520de2f03200ba8", "parents": ["6d4db8b47bbc29a8771fc5c52920788cd46809c5"], "tags": []}, {"author": "lola_t \u003cltokhtamuradova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086312 - Prevent Listen to page to close when new tab opened from a srortcut. r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340001\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionService.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionServiceTest.kt"], "git_node": "97737748ffd6d58ae280d79f39620f8bb59e540a", "git_parents": ["ba5455eb36fee5853c19a30b6e3442e12c724e8d"], "node": "11362e6c1630d5e12f88d8ca9f7c5d05411c2102", "parents": ["58e3cb4ec195109558fa824ef520de2f03200ba8"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2090058 - Fix verifyHistorySearchWithBrowsingHistoryTest UI test r=aaronmt,mobiletest-reviewers\n\nAfter clicking a search suggestion (which opens the page in the browser), the test called navigateToPage(), which only glances once to check it\u2019s on the browser page.\nIf the page was still loading, it wrongly thought it was still on the search bar and failed.\n\nTo fix this, I've removed the browserPage.navigateToPage() and left only verifyUrl(), which waits for the browser\u2019s address bar to show the expected URL, an element that only exists on the browser page, so it confirms we\u2019re there and avoids the race.\n\nThe UI test successfully passed 50x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340358\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SearchTest.kt"], "git_node": "ccdcdebedc22db1bab5b717fcb3bbe3e10ca8e1d", "git_parents": ["97737748ffd6d58ae280d79f39620f8bb59e540a"], "node": "0dbab272e0d41793e945a192560893babce5541d", "parents": ["11362e6c1630d5e12f88d8ca9f7c5d05411c2102"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2079172, part 1 - Inline GraphWalker and ScanBlackVisitor into FloodBlackNode. r=smaug\n\nThey are only used in a single place, so inline it all to make it\neasier to understand.\n\nChange the aPi check in CheckedPush to be a release assert, for simplicity.\n\nWalkFromRoots is not used so it is removed.\n\nI marked FloodBlackNode MOZ_NEVER_INLINE to match GraphWalker::Walk,\nGraphWalker::DoWalk and ScanBlackVisitor::VisitNode.\n\nThis patch should not change the behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338469\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "691e3e1779b475ac9117ed5718cced822d3ec629", "git_parents": ["ccdcdebedc22db1bab5b717fcb3bbe3e10ca8e1d"], "node": "0149f95acc90739234037ea5400b3848b74e9d66", "parents": ["0dbab272e0d41793e945a192560893babce5541d"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2079172, part 2 - Use infallible allocation for Push in FloodBlackNode. r=smaug\n\nIf a cycle collection can't fully run due to running low on memory, it won't be\nable to free much of anything, so the memory problems will only get worse. If\nwe crash, then at least this issue will be visible in crash stats, as opposed\nto performance invisibly becoming terrible.\n\nThis requires removing a lot of failure propagation code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338470\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "98f44ee735085cea7fb5df8b8800d194172e1aa5", "git_parents": ["691e3e1779b475ac9117ed5718cced822d3ec629"], "node": "ef38a96c15384a781f53a6817b6fedb5ba7c22b8", "parents": ["0149f95acc90739234037ea5400b3848b74e9d66"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2079172, part 3 - Mark nodes black when they are pushed in FloodBlackNode. r=smaug\n\nPreviously, every child was pushed onto the queue, and filtered out when it was\npopped if it was already black or had not been traversed. This meant that the\nqueue could grow to the number of edges rather than the number of nodes. Doing\nthe check and marking the node black when it is pushed means each node is\npushed at most once. The resulting coloring and white node count are the same.\n\nRunning browser_aiwindow_smartbar_chat_active_navigate.js locally, this reduced\nthe maximum size of the queue from around 5600 nodes to 2800.\n\nThis probably makes locality worse, because we now look at a node when we push\nit, but I think that's a reasonable tradeoff for cutting memory usage in half.\n(Testing described in the last patch shows that the entire patch set improves\nScanBlockNodes performance over all.)\n\nThis is combined with the patches to make memory allocation infallible in the\nhope that it will reduce the rate of OOM crashes.\n\nRemove a WasTraversed check in ScanBlackNodes that is now redundant.\nThere's a check in PurpleScanBlackVisitor::Visit that is also redundant,\nbut that case is likely more common, so let's leave it to avoid the call\noverhead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338471\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "5639db69c5e504866041acd570001b9c43add9ad", "git_parents": ["98f44ee735085cea7fb5df8b8800d194172e1aa5"], "node": "650243b10b9b7e2477d2fdc0369ece3c8fac090f", "parents": ["ef38a96c15384a781f53a6817b6fedb5ba7c22b8"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2079172, part 4 - Switch from nsDeque to Queue in FloodBlackNodes. r=smaug\n\nnsDeque uses a single block of memory, while Queue uses a segmented vector, so\nhopefully this will cause less OOMs. 1024 pointers seems big enough that\niterator overhead shouldn't be a big deal.\n\nWe already use infallible allocation with EdgeBlock, which each contain\n16 * 1024 pointers. Over the last week, those were about 7.6% of all\nOOM | small crashes.\n\nUnlike nsDeque, Queue has no inline storage, so creating one in each\nFloodBlackNode call would mean a heap allocation of a page for every call, which\ncan happen once per root. Instead, create the queue in ScanRoots and pass it\ndown. A drained Queue keeps its head page, so it is only allocated once. It\nwould be nice if it kept all of its empty pages but oh well.\n\nWhile running tests with big CCs, the full patch stack reduced the time spent\nin ScanBlackNodes() by 22% which sounds great but CC time is mostly dominated\nby building the graph so that's not much. The biggest improvement seen\nin a single CC was like 0.3ms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338472\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "a071e500499c67a2af1a7f8c254a3ac272ef482c", "git_parents": ["5639db69c5e504866041acd570001b9c43add9ad"], "node": "83d42a22773912cf66080854b69d4dc7081f299a", "parents": ["650243b10b9b7e2477d2fdc0369ece3c8fac090f"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088688 - Use ValidateFontDescriptor in WebRenderBridgeParent. r=gfx-reviewers,ahale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340224\n", "files": ["gfx/2d/ScaledFontFontconfig.cpp", "gfx/2d/UnscaledFontFreeType.h", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/webrender_bindings/WebRenderTypes.h"], "git_node": "15121caee00a2ca4a96b807f8813558f0290733b", "git_parents": ["a071e500499c67a2af1a7f8c254a3ac272ef482c"], "node": "62eda04834e3ca3adab9bcd97959050d5323088f", "parents": ["83d42a22773912cf66080854b69d4dc7081f299a"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076456 - Update about and error theme pages so they pass use-design-tokens r=desktop-theme-reviewers,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333415\n", "files": ["browser/base/content/blockedSite.xhtml", "browser/themes/shared/aboutRestartRequired.css", "browser/themes/shared/aboutSessionRestore.css", "browser/themes/shared/aboutTabCrashed.css", "browser/themes/shared/blockedSite.css", "stylelint-rollouts.config.js", "toolkit/content/aboutNetError.html", "toolkit/content/net-error-card.mjs", "toolkit/themes/shared/aboutNetError.css", "toolkit/themes/shared/error-pages.css"], "git_node": "1f6febeec740e823227b33fd4b44e4c63fe0755d", "git_parents": ["15121caee00a2ca4a96b807f8813558f0290733b"], "node": "6b0c5e1298d0502279618bd9b2020e69417a5c9c", "parents": ["62eda04834e3ca3adab9bcd97959050d5323088f"], "tags": []}, {"author": "Danielle Graham \u003cdgraham@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086771 - Stop confirmation hints closing early or being dropped when shown again while opening or hiding. r=firefox-desktop-core-reviewers ,dao\n\nIf show() was called while a hint was still opening, each call added its own popupshown listener, so two auto-hide timers started. Only one of them could be cleared, and the other one later closed whatever hint was open at the time. show() now only keeps the latest call's listeners.\n\nIf show() was called while a hint was hiding, the new hint was silently dropped, because openPopup does nothing in that state. It now waits for popuphidden and then shows the hint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338411\n", "files": ["browser/base/content/browser.js", "browser/base/content/test/browser-confirmationHint/browser_confirmationHint.js", "browser/components/customizableui/test/browser_fireButton.js"], "git_node": "42f28cdc9bd6456863a19178aa63b716390a8a2e", "git_parents": ["1f6febeec740e823227b33fd4b44e4c63fe0755d"], "node": "0cc44f2c3c8675fa15edf161e60e7f9b7bea7682", "parents": ["6b0c5e1298d0502279618bd9b2020e69417a5c9c"], "tags": []}, {"author": "Danielle Graham \u003cdgraham@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021196 - Show a hint when the Tab Groups button is removed. r=tabbrowser-reviewers,fluent-reviewers,jswinarton,bolsson\n\n- onWidgetRemoved also fires when the button is moved, so it waits a tick and checks the button isn't placed anywhere before showing the hint (same as SidebarManager)\n- The listener now stays registered for the session instead of being removed once the button is introduced, since it also handles the hint. init() skips it once both prefs are set\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337300\n", "files": ["browser/app/profile/firefox.js", "browser/components/customizableui/test/browser_tab_groups_button.js", "browser/components/tabbrowser/TabGroupsToolbarButton.sys.mjs", "browser/locales/en-US/browser/confirmationHints.ftl"], "git_node": "f04afd4149158413fa33af3f0251fc35bdc04983", "git_parents": ["42f28cdc9bd6456863a19178aa63b716390a8a2e"], "node": "3d65161356901559f2d40395396fea505378455b", "parents": ["0cc44f2c3c8675fa15edf161e60e7f9b7bea7682"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086698 - Run fenix nav-bench-m on Android emulators. r=perftest-reviewers,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340402\n", "files": ["taskcluster/kinds/browsertime/mobile.yml", "taskcluster/test_configs/test-sets.yml", "testing/mozbase/mozproxy/mozproxy/backends/mitm/android.py", "testing/perfdocs/generated/raptor.md"], "git_node": "5a8ff35d8953ce59fcfcacdbf72a18fdf6b0f721", "git_parents": ["f04afd4149158413fa33af3f0251fc35bdc04983"], "node": "1ae3a0f64d5f831a8a3d5b1ca330d8f2b95960f6", "parents": ["3d65161356901559f2d40395396fea505378455b"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089603 - Create the moz-widget iframe manually r=fchasen\n\nDon't use Lit to create the iframe since we want to restrict what\nelements we can create using Lit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340079\n", "files": ["browser/components/widgets/content/moz-widget.mjs", "browser/components/widgets/tests/chrome/test_moz_widget.html"], "git_node": "5394f741563514c1a633c11de7a032ba3aa2aff8", "git_parents": ["5a8ff35d8953ce59fcfcacdbf72a18fdf6b0f721"], "node": "6c47d8b398c0c79c26bd3e688f500e8e9aa6aafd", "parents": ["1ae3a0f64d5f831a8a3d5b1ca330d8f2b95960f6"], "tags": []}, {"author": "Manuel Bucher \u003cmanuel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089290 - Copy Clean Link: Strip more search related parameters on linkedin r=timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340062\n", "files": ["toolkit/components/antitracking/StripOnShareLists/LGPL/StripOnShareLGPL.json", "toolkit/components/antitracking/StripOnShareLists/MPL2/StripOnShare.json"], "git_node": "30945d52d1baefc390999fb2d1fe70dcfabc2591", "git_parents": ["5394f741563514c1a633c11de7a032ba3aa2aff8"], "node": "3a42666c14e18beec8a8707c242233ef6c45d8e1", "parents": ["6c47d8b398c0c79c26bd3e688f500e8e9aa6aafd"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089206 - Keep alt-svc mappings when a racing connection attempt fails, r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340348\n", "files": ["netwerk/base/MockNetworkLayer.cpp", "netwerk/base/MockNetworkLayerController.cpp", "netwerk/base/MockNetworkLayerController.h", "netwerk/base/nsIMockNetworkLayerController.idl", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/socket/neqo_glue/src/lib.rs", "netwerk/test/unit/test_http3_proxy_reset_keeps_alt_svc.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "6b0fd381f54532f3b558bb31cd00007f9d9d8a5a", "git_parents": ["30945d52d1baefc390999fb2d1fe70dcfabc2591"], "node": "3ed20c28f475a876af842563f5a4dd153b043445", "parents": ["3a42666c14e18beec8a8707c242233ef6c45d8e1"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084281 - [devtools] Fallback to the style editor for inline style links r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335710\n", "files": ["devtools/client/framework/toolbox.js"], "git_node": "ae9a49c4965db34e39699966b1b50555f04d5921", "git_parents": ["6b0fd381f54532f3b558bb31cd00007f9d9d8a5a"], "node": "55766169495dc10d5ae20b40de7ec6ae0009c3cc", "parents": ["3ed20c28f475a876af842563f5a4dd153b043445"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081428 - [devtools] Enable 'devtools.debugger.features.stylesheets-in-debugger' by default r=devtools-reviewers,jdescottes,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333605\n", "files": ["browser/app/profile/firefox.js", "devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_debug_debugger.js", "devtools/client/framework/test/browser_toolbox_view_source_03.js", "devtools/client/framework/test/head.js", "devtools/client/inspector/computed/test/browser_computed_original-source-link.js", "devtools/client/inspector/computed/test/browser_computed_style-editor-link.js", "devtools/client/inspector/markup/test/browser_markup_links_06.js", "devtools/client/inspector/rules/test/browser_rules_original-source-link.js", "devtools/client/inspector/rules/test/browser_rules_original-source-link2.js", "devtools/client/inspector/rules/test/browser_rules_style-editor-link.js", "devtools/client/inspector/rules/test/head.js", "devtools/client/netmonitor/test/browser_net_open_in_style_editor.js", "devtools/client/webconsole/test/browser/browser_webconsole_location_styleeditor_link.js"], "git_node": "1ed9f312ef6d83cf09dd1d453734ad614f5354da", "git_parents": ["ae9a49c4965db34e39699966b1b50555f04d5921"], "node": "bb512c5f98f4e7816dc13c0cd0e4be40b44abbc3", "parents": ["55766169495dc10d5ae20b40de7ec6ae0009c3cc"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081428 - [devtools] Clarify the rule view link tests for styles with sourcemaps r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338279\n", "files": ["devtools/client/inspector/rules/test/browser_rules_original-source-link.js", "devtools/client/inspector/rules/test/browser_rules_original-source-link2.js"], "git_node": "d621b8461d9c298b91580da09f81531102deb2d9", "git_parents": ["1ed9f312ef6d83cf09dd1d453734ad614f5354da"], "node": "71cf64ec8f360e0a76026badf1040dae9d0ac70c", "parents": ["bb512c5f98f4e7816dc13c0cd0e4be40b44abbc3"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2089939 - Inline a minimal font in browser_aitab_heading_font.js instead of loading one from pdf.js. r=Mardak\n\nThe pdf.js update in bug 2089551 removes the Liberation fonts the test was\nborrowing. The test only needs the bytes of a font covering the heading text,\nso it now carries its own: printable ASCII mapped to a single box glyph.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340271\n", "files": ["browser/components/aiwindow/ui/test/browser/aitab/browser_aitab_heading_font.js"], "git_node": "632eea19a7d6da420ccc936793d5d909a24713f0", "git_parents": ["d621b8461d9c298b91580da09f81531102deb2d9"], "node": "6438fbb6d4f6dafdc86eca31b0ea7cd7f5881567", "parents": ["71cf64ec8f360e0a76026badf1040dae9d0ac70c"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089902 - Remove dangling declarations in layout/base. r=layout-reviewers,jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340231\n", "files": ["gfx/thebes/gfxUserFontSet.h", "layout/base/AccessibleCaretEventHub.h", "layout/base/AccessibleCaretManager.h", "layout/base/PresShell.h", "layout/base/nsCSSFrameConstructor.h", "layout/base/nsLayoutUtils.h", "layout/base/nsPresContext.h", "layout/base/nsRefreshDriver.h"], "git_node": "cde224cff0d2859ca0bf62d00f9e12c8055e886a", "git_parents": ["632eea19a7d6da420ccc936793d5d909a24713f0"], "node": "7cff1de222badcd080ff408c316f301e77dd22d7", "parents": ["6438fbb6d4f6dafdc86eca31b0ea7cd7f5881567"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089902 - Remove dangling declarations in layout/build. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340232\n", "files": ["layout/build/nsContentDLF.h", "layout/build/nsLayoutModule.h"], "git_node": "967234bfaabf4fe17ad5f8fcb0609f07c2f58c0c", "git_parents": ["cde224cff0d2859ca0bf62d00f9e12c8055e886a"], "node": "8c30da3aec0a9f0b467e7b3919df3fb7b79d415e", "parents": ["7cff1de222badcd080ff408c316f301e77dd22d7"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089902 - Remove dangling declarations in layout/forms. r=layout-reviewers,emilio,jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340233\n", "files": ["layout/forms/nsComboboxControlFrame.h", "layout/forms/nsListControlFrame.h", "layout/forms/nsTextControlFrame.h"], "git_node": "f64c304d6840c920aed19e09758952bd2ff230ea", "git_parents": ["967234bfaabf4fe17ad5f8fcb0609f07c2f58c0c"], "node": "7ee2c691b74f