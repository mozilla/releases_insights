"pushes": {"163": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 3ac96fd3a3820bb8a3160de1bc52009fe22d769d with FIREFOX_91_6_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "a95de196a690e759e4ea11f84bbd8df9a64ab296", "parents": ["3ac96fd3a3820bb8a3160de1bc52009fe22d769d"], "tags": []}], "date": 1643680847, "git_changesets": [null], "user": "ffxbld"}, "164": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137730", "files": ["services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/gfx.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "916e549ca29552fb486ef0f90675caa97dead66e", "parents": ["a95de196a690e759e4ea11f84bbd8df9a64ab296"], "tags": []}], "date": 1644002963, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "165": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137991", "files": ["services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "3aca81d250c3077b9779b05156f53805ce77a8d3", "parents": ["916e549ca29552fb486ef0f90675caa97dead66e"], "tags": []}], "date": 1644246282, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "166": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_91_5_X_RELBRANCH", "desc": "Close obsolete FIREFOX_ESR_91_5_X_RELBRANCH. a=release", "files": [], "git_node": null, "git_parents": [null], "node": "4a11cc14c324627680b6d03486713b72b6ac2fdf", "parents": ["f560cd3cd43bace45c9a7323404848efde7ac452"], "tags": []}], "date": 1644248001, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "167": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "357a990c305dfab1ee735c9a5955d7da88524b29", "parents": ["3aca81d250c3077b9779b05156f53805ce77a8d3"], "tags": []}], "date": 1644250081, "git_changesets": [null], "user": "ffxbld-merge"}, "168": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 3ac96fd3a3820bb8a3160de1bc52009fe22d769d with FIREFOX_91_6_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "14ecd99eea6f179edbaaf56ac1117f7fc83db68b", "parents": ["357a990c305dfab1ee735c9a5955d7da88524b29"], "tags": []}], "date": 1644328318, "git_changesets": [null], "user": "ffxbld"}, "169": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D138426", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "20f623d4e6ad673c850c72f524acb873c99c88c2", "parents": ["14ecd99eea6f179edbaaf56ac1117f7fc83db68b"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 1748485 - Add test for Bug 1742682: Ensure callback app is launched with umask from before updating. r=bytesized, a=test-only\n\nThis adds a new `check-umask` command to `TestAUSHelper`.  For\nconvenience, we invoke the new command with the umask from before the\nupdate but have the command output its current umask (i.e., from when\nit is launched).  This allows to reuse the existing `checkCallbackLog`\nfunction, which verifies that the arguments and the callback log\noutput are the same.  The callback log file is the given argument, so\nwe prefix with \"umask\" to avoid conflicting with existing numeric\nfiles and directories in the test data.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D133804", "files": ["toolkit/mozapps/update/tests/TestAUSHelper.cpp", "toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/tests/unit_base_updater/marCallbackUmask_unix.js", "toolkit/mozapps/update/tests/unit_base_updater/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "fb5344db3508b0f76cd89eef97cedce22b295fdc", "parents": ["20f623d4e6ad673c850c72f524acb873c99c88c2"], "tags": []}], "date": 1644501702, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "170": {"changesets": [{"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 1678645 - [devtools] Fix devtools/client/shared/test/browser_filter-editor-* intermittent. r=Honza a=test-only\n\nDestroy created widget at the end of tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D138158", "files": ["devtools/client/shared/test/browser_filter-editor-01.js", "devtools/client/shared/test/browser_filter-editor-02.js", "devtools/client/shared/test/browser_filter-editor-03.js", "devtools/client/shared/test/browser_filter-editor-04.js", "devtools/client/shared/test/browser_filter-editor-05.js", "devtools/client/shared/test/browser_filter-editor-06.js", "devtools/client/shared/test/browser_filter-editor-07.js", "devtools/client/shared/test/browser_filter-editor-08.js", "devtools/client/shared/test/browser_filter-editor-09.js", "devtools/client/shared/test/browser_filter-editor-10.js"], "git_node": null, "git_parents": [null], "node": "cab8de08ac86c73b5c85a7901d215bd43ab3c099", "parents": ["fb5344db3508b0f76cd89eef97cedce22b295fdc"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D138642", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "ee0386bdc19dfac709e6fc31ebd67944c74dfc68", "parents": ["cab8de08ac86c73b5c85a7901d215bd43ab3c099"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1752396, r=mtigley a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D138358", "files": ["toolkit/components/downloads/DownloadCore.jsm", "uriloader/exthandler/nsExternalHelperAppService.cpp", "uriloader/exthandler/tests/mochitest/browser.ini", "uriloader/exthandler/tests/mochitest/browser_launched_app_save_directory.js"], "git_node": null, "git_parents": [null], "node": "bb298c7c56136ea9a8bfc543ba78fd38c88a2fd2", "parents": ["ee0386bdc19dfac709e6fc31ebd67944c74dfc68"], "tags": []}, {"author": "Bryce Seager van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1714621 - Add functionality to verify GMP's update xml content signatures. r=Gijs,robwu a=RyanVM\n\nAlso driveby fix a log string to print the proper function name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127566", "files": ["modules/libpref/init/all.js", "toolkit/modules/GMPInstallManager.jsm", "toolkit/modules/GMPUtils.jsm", "toolkit/mozapps/extensions/internal/ProductAddonChecker.jsm"], "git_node": null, "git_parents": [null], "node": "7572a9afdfe3e1e2e4c70b262bf205883fe50f36", "parents": ["bb298c7c56136ea9a8bfc543ba78fd38c88a2fd2"], "tags": []}, {"author": "Bryce Seager van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1714621 - Add tests to cover ProductAddonChecker content signature verification. r=Gijs a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129268", "files": ["toolkit/mozapps/extensions/test/xpcshell/data/productaddons/content_signing_aus_ee.pem", "toolkit/mozapps/extensions/test/xpcshell/data/productaddons/content_signing_aus_ee.pem.certspec", "toolkit/mozapps/extensions/test/xpcshell/data/productaddons/content_signing_int.pem", "toolkit/mozapps/extensions/test/xpcshell/data/productaddons/content_signing_int.pem.certspec", "toolkit/mozapps/extensions/test/xpcshell/data/productaddons/content_signing_root.pem", "toolkit/mozapps/extensions/test/xpcshell/data/productaddons/content_signing_root.pem.certspec", "toolkit/mozapps/extensions/test/xpcshell/head_cert_handling.js", "toolkit/mozapps/extensions/test/xpcshell/test_ProductAddonChecker_signatures.js", "toolkit/mozapps/extensions/test/xpcshell/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "da6a1aee9f9588355db1a2c86dbf0d1e64778b0f", "parents": ["7572a9afdfe3e1e2e4c70b262bf205883fe50f36"], "tags": []}, {"author": "Bryce Seager van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1714621 - Add telemetry to record if GMP update XML is successfully downloaded from balrog. r=Gijs a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127567", "files": ["toolkit/components/telemetry/Histograms.json", "toolkit/modules/GMPInstallManager.jsm"], "git_node": null, "git_parents": [null], "node": "1834ba383ee091833dd9232eff800cb138283e3c", "parents": ["da6a1aee9f9588355db1a2c86dbf0d1e64778b0f"], "tags": []}, {"author": "Bryce Seager van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1714621 - Add test case to cover GMPInstallerManager content signature usage. r=Gijs a=RyanVM\n\nThis tests the new content signature path for the GMPInstaller manager. It also\ntests the telemetry gathered for the new content signature path works correctly\nwhen that path succeeds or fails validation.\n\nThese tests differ from the existing tests in that they use a live HTTPServer,\nrather than using the XML override test mechanism. This is needed to avoid\nadding further test specific mechanisms for content signature, but is also cool\nIMO as it makes the test cases a little more realistic (at the cost of some\nverbosity).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129269", "files": ["toolkit/modules/tests/xpcshell/test_GMPInstallManager.js", "toolkit/modules/tests/xpcshell/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "aa653d9f3a77510f209c1af681531dfcb7d44177", "parents": ["1834ba383ee091833dd9232eff800cb138283e3c"], "tags": []}, {"author": "Geoff Lankow \u003cgeoff@darktrojan.net\u003e", "branch": "default", "desc": "Bug 1739284 - Override telemetry products check in test_GMPInstallManager.js. r=bryce a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D130325", "files": ["toolkit/modules/tests/xpcshell/test_GMPInstallManager.js"], "git_node": null, "git_parents": [null], "node": "43335774a6732ba24f8de186a07a89c406dfaa67", "parents": ["aa653d9f3a77510f209c1af681531dfcb7d44177"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1753787 - renew content-signing test certificates. r=Gijs, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137981", "files": ["toolkit/mozapps/extensions/test/xpcshell/data/productaddons/content_signing_aus_ee.pem", "toolkit/mozapps/extensions/test/xpcshell/data/productaddons/content_signing_int.pem", "toolkit/mozapps/extensions/test/xpcshell/data/productaddons/content_signing_root.pem"], "git_node": null, "git_parents": [null], "node": "d66bffb2743679e5404c072d3930712386494687", "parents": ["43335774a6732ba24f8de186a07a89c406dfaa67"], "tags": []}], "date": 1644877145, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "171": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D139009", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "497b96003977a5cd791473e8aa8ad89890d4de93", "parents": ["d66bffb2743679e5404c072d3930712386494687"], "tags": []}, {"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1745253 - Test, r=Gijs a=test-only\n\nDepends on D133392\n\nDifferential Revision: https://phabricator.services.mozilla.com/D133393", "files": ["uriloader/exthandler/tests/mochitest/browser_protocol_ask_dialog.js"], "git_node": null, "git_parents": [null], "node": "699cbb121fa134afcec58c3773281879278b9e7c", "parents": ["497b96003977a5cd791473e8aa8ad89890d4de93"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1711870 - Use http-on-examine-response to block redirects in policy. r=dragana a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137869", "files": ["browser/components/enterprisepolicies/helpers/WebsiteFilter.jsm", "browser/components/enterprisepolicies/tests/browser/301.sjs", "browser/components/enterprisepolicies/tests/browser/302.sjs", "browser/components/enterprisepolicies/tests/browser/browser.ini", "browser/components/enterprisepolicies/tests/browser/browser_policy_websitefilter.js"], "git_node": null, "git_parents": [null], "node": "b1ad45d18926ceb5adf2b6756265274474b4e515", "parents": ["699cbb121fa134afcec58c3773281879278b9e7c"], "tags": []}], "date": 1645112864, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "172": {"changesets": [{"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1734787 - Add https://example.net:443 to build/pgo/server-locations.txt. r=jmaher, a=test-only\n\nHaving 3 regular domains to test fission scenarios will help migrating to https-first for DevTools mochitests.\nexample.org and example.com are both available in http and https, but example.net is only available in http for now.\n\nThis patch was created by adding https://example.net to build/pgo/server-locations.txt and then running `./mach python build/pgo/genpgocert.py`\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127922", "files": ["build/pgo/certs/cert9.db", "build/pgo/certs/key4.db", "build/pgo/certs/mochitest.client", "build/pgo/server-locations.txt"], "git_node": null, "git_parents": [null], "node": "bd2015c9a5d1dc1be37c61afbd0af934bf6bdb37", "parents": ["b1ad45d18926ceb5adf2b6756265274474b4e515"], "tags": []}], "date": 1645132239, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "173": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1742241. Don't access the PresShell's visual viewport offset if we haven't set one. r=botond a=pascalc\n\nIf the visual viewport offset is not set on the presshell then calling GetVisualViewportOffset returns (0, 0). This then causes us to introduce an incorrect offset between the layout scroll offset and the visual viewport offset that didn't exist before.\n\nLogically we want to treat an unset visual viewport offset as the layout scroll offset.\n\nOther possible fixes:\n-make PresShell::GetVisualViewportOffset return the layout scroll offset if a visual viewport offset is not set\n-make this if conditional on a visual viewport offset already being set\n-the combination of the two above\nAll of these fail some tests on try server. I haven't investigated why. If we want to go with any of those potential fixes in the future then this patch is a step on the way there\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137873", "files": ["layout/generic/nsGfxScrollFrame.cpp"], "git_node": null, "git_parents": [null], "node": "d92316d8e415647b10336414998064c0f9c36aa8", "parents": ["bd2015c9a5d1dc1be37c61afbd0af934bf6bdb37"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1742241. Add test. r=botond a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137960", "files": ["gfx/layers/apz/test/mochitest/browser.ini", "gfx/layers/apz/test/mochitest/browser_test_background_tab_load_scroll.js", "gfx/layers/apz/test/mochitest/helper_background_tab_load_scroll.html"], "git_node": null, "git_parents": [null], "node": "0131547e550a41f78055265f5ffef5323b36569d", "parents": ["d92316d8e415647b10336414998064c0f9c36aa8"], "tags": []}], "date": 1645183625, "git_changesets": [null, null], "user": "pchevrel@mozilla.com"}, "174": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D139271", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "9135a1aa955910baee119ee6ce389c9e4127da01", "parents": ["0131547e550a41f78055265f5ffef5323b36569d"], "tags": []}], "date": 1645532451, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "175": {"changesets": [{"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1706194 - Fix browser_ext_sidebarAction_click.js intermittent failures. r=mixedpuppy, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128728", "files": ["browser/components/extensions/test/browser/browser_ext_sidebarAction_click.js"], "git_node": null, "git_parents": [null], "node": "07cf4384a09d99590728fa4f0a7aefc411057ed4", "parents": ["9135a1aa955910baee119ee6ce389c9e4127da01"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1580875 - Fix browser_ext_sidebarAction_contextMenu.js intermittent failures. r=mixedpuppy, a=test-only\n\nDepends on D128728\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128729", "files": ["browser/components/extensions/test/browser/head.js"], "git_node": null, "git_parents": [null], "node": "3eca474c370e2978c5307ce5ec4d2c3148610b54", "parents": ["07cf4384a09d99590728fa4f0a7aefc411057ed4"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1705244 - Fix browser_ext_incognito_popup.js intermittent failures. r=mixedpuppy, a=test-only\n\nDepends on D128729\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128730", "files": ["browser/components/extensions/test/browser/browser_ext_incognito_popup.js"], "git_node": null, "git_parents": [null], "node": "08a1f8bc5ca447769e2dc9968b3aaed8bfde73ee", "parents": ["3eca474c370e2978c5307ce5ec4d2c3148610b54"], "tags": []}], "date": 1645542029, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "176": {"changesets": [{"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1717501 - Null check attributes in MacUtils::GetAccAttr. r=morgan a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D138475", "files": ["accessible/mac/MacUtils.mm"], "git_node": null, "git_parents": [null], "node": "8c08140677e765f6172eb4c667ffccb8253432db", "parents": ["08a1f8bc5ca447769e2dc9968b3aaed8bfde73ee"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1676986 - Ensure the about:blank subframe is loaded before browser_aboutprocesses_show_frames_without_threads.js verifies it's displayed in about:processes. r=dthayer, a=test-only", "files": ["toolkit/components/aboutprocesses/tests/browser/head.js"], "git_node": null, "git_parents": [null], "node": "8777a633f0fbb5d397a547cc893c193447d617a4", "parents": ["8c08140677e765f6172eb4c667ffccb8253432db"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1742167 - Disable managedbookmarks test on Linux. r=mstriemer, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D138811", "files": ["browser/components/enterprisepolicies/tests/browser/managedbookmarks/browser.ini"], "git_node": null, "git_parents": [null], "node": "6adb5b8327c67d04d6754da3c3f13ade52b036e3", "parents": ["8777a633f0fbb5d397a547cc893c193447d617a4"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1724156 - Replace Background Update ping tt(c) test with xpcshell r=nalexander a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D138841", "files": ["toolkit/components/telemetry/tests/marionette/tests/client/manifest.ini", "toolkit/components/telemetry/tests/marionette/tests/client/test_fog_background_update_ping.py", "toolkit/mozapps/update/BackgroundTask_backgroundupdate.jsm", "toolkit/mozapps/update/tests/unit_background_update/test_backgroundupdate_glean.js"], "git_node": null, "git_parents": [null], "node": "46b2b57eea53b6141a59922d52570df7ae565057", "parents": ["6adb5b8327c67d04d6754da3c3f13ade52b036e3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1720133 - Mark a test as flakily failing in all platforms, not just macOS. r=smaug, a=test-only\n\nThe first subtest is already annotated as failing on all platforms. My\npatch seems to have changed timing in a way such that the second test\nalso fails in non-macOS platforms.\n\nI tried to reproduce the failure locally and investigate a bit more, but\ncouldn't. The test doesn't seem particularly racy, off-hand, other than\nit using a timer which at best should make the test unexpectedly pass,\nnot unexpectedly fail...\n\nThe other thing that looked suspicious is that the test was waiting for\nthe load event of the main window, not of the popup it opens (which I\nthink might be unintended). However that also doesn't make the\nfailure reproduce here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D120204", "files": ["testing/web-platform/meta/html/cross-origin-opener-policy/coop-csp-sandbox-navigate.https.html.ini"], "git_node": null, "git_parents": [null], "node": "56c9486b64f346f9f5b4031dc9349079b5196b47", "parents": ["46b2b57eea53b6141a59922d52570df7ae565057"], "tags": []}, {"author": "Andrew Creskey \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 1717218 - Fix to intermittent failure in browser_interactions_typing.js r=Standard8 a=test-only\n\nIn the scenario where we navigate to a second url immediately after typing we intermittently lose a keystroke on some builds.\nI haven't been able to trace down how this happens, however waiting for the next tick in the event loop after each step appears to resolve the intermittent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127885", "files": ["browser/components/places/tests/browser/interactions/browser_interactions_typing.js"], "git_node": null, "git_parents": [null], "node": "0808f87f80bd84095a805834abf52c29004c3bca", "parents": ["56c9486b64f346f9f5b4031dc9349079b5196b47"], "tags": []}, {"author": "Andrew Creskey \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 1717218 - Intermittent failure in browser_interactions_typing.js r=Standard8 a=test-only\n\nThis fixes the root cause of the intermittent failure (missing keystrokes) -- the function to send keys was not strictly synchronous.\nWe now wait for the input field to be populated before we proceed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128409", "files": ["browser/components/places/tests/browser/interactions/browser_interactions_typing.js"], "git_node": null, "git_parents": [null], "node": "0ce39f45e1a2264155792a437db6e0c0d1b47331", "parents": ["0808f87f80bd84095a805834abf52c29004c3bca"], "tags": []}, {"author": "Andrew Creskey \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 1749328 - Intermittent failure in browser_interactions_typing.js r=Standard8 a=test-only\n\nThe test test_typing_and_reload() was failing, I believe because without waiting for target url in browserLoaded(), we would proceed on the about:blank load and the new interaction write would race the test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136186", "files": ["browser/components/places/tests/browser/interactions/browser_interactions_typing.js"], "git_node": null, "git_parents": [null], "node": "987d7ce2d2441c9c9aa27a8097b5ed67dc79398a", "parents": ["0ce39f45e1a2264155792a437db6e0c0d1b47331"], "tags": []}, {"author": "Andrew Creskey \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 1749328 - Intermittent browser/components/places/tests/browser/interactions/browser_interactions_typing.js r=Standard8 a=test-only\n\nThe failing test is the only one that verifies reload scenarios with respect to history metadata interactions.\nI haven't been able to find a solution to this intermittent, I am remove the specific test that's failing and creating a bug to test reload scenarios.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137477", "files": ["browser/components/places/tests/browser/interactions/browser_interactions_typing.js"], "git_node": null, "git_parents": [null], "node": "6c1511a343807d38e2b790ab9baa29c977a174b2", "parents": ["987d7ce2d2441c9c9aa27a8097b5ed67dc79398a"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 1736202: browser_interactions_typing.js intermittently misses a single keypress. r=Standard8, a=test-only\n\nOur typing interactions separate typing into sessions. If you haven't typed for longer than a\ncertain period of time we count the previous session as over and start afresh. Any sessions\ncontaining just one keypress are discarded, the rest are aggregated.\n\nIn our automated tests we want to test that this detection of a new session of typing works and our\nonly way to do that is to actually delay the test for longer than the maximum time between\nkeypresses. So the test runs fast we reduce the maximum time pref to 50ms.\n\nUnfortunately I've experimentally seen that in CI on debug and asan builds that when not testing\nthis aspect and sending a sentence of characters we can still occasionally see delays of over 50ms\nbetween individual characters. If this delay happens between the first and second character or the\nlast and last but one character then we end up with a typing session with a single character in it\nwhich gets discarded leading our interaction metrics to be short one keypress.\n\nThis patch removes the reduced preference value for general tests and sets a value of 150ms for the\nfew tests where this matters.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D139039", "files": ["browser/components/places/tests/browser/interactions/browser.ini", "browser/components/places/tests/browser/interactions/browser_interactions_typing.js"], "git_node": null, "git_parents": [null], "node": "a30c7b627cf29a2a7f4b818c963810101a78c0da", "parents": ["6c1511a343807d38e2b790ab9baa29c977a174b2"], "tags": []}], "date": 1645663808, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "177": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1742421 - Part 1: [widget/gtk] Exit fullscreen when changing sizemode; r=stransky, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D133734", "files": ["widget/gtk/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "e6a04254cc65e7e6df72dd687f16adf7b78fdde6", "parents": ["a30c7b627cf29a2a7f4b818c963810101a78c0da"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1742421 - Part 2: [widget/cocoa] Exit fullscreen when changing sizemode; r=mstange, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D133735", "files": ["widget/cocoa/nsCocoaWindow.mm"], "git_node": null, "git_parents": [null], "node": "f8c4d04f3a4ec233dbba71ec36a1b942b9213dd0", "parents": ["e6a04254cc65e7e6df72dd687f16adf7b78fdde6"], "tags": []}, {"author": "Chris Martin \u003ccmartin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1742421 - Part 3: [widget/windows] Exit fullscreen when changing sizemode; r=mhowell,edgar a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135606", "files": ["widget/windows/nsWindow.cpp", "widget/windows/nsWindow.h"], "git_node": null, "git_parents": [null], "node": "68810f0fb308faa7ffdd8c45803e915d79d9c558", "parents": ["f8c4d04f3a4ec233dbba71ec36a1b942b9213dd0"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1752979 - Check damaged files. r=mixedpuppy, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137692", "files": ["toolkit/mozapps/extensions/internal/XPIInstall.jsm"], "git_node": null, "git_parents": [null], "node": "537e1fca9a43b53767d5df797e474e150d22ae4f", "parents": ["68810f0fb308faa7ffdd8c45803e915d79d9c558"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1744352 - Part 1: Ensure we set InitialSandboxFlags when opening or replacing toplevel BrowsingContexts, r=mccr8 a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D139430", "files": ["docshell/base/BrowsingContext.h", "docshell/base/CanonicalBrowsingContext.cpp", "toolkit/components/windowwatcher/nsWindowWatcher.cpp"], "git_node": null, "git_parents": [null], "node": "f7139e7249fe59ef84465aeeb2af98327a38682d", "parents": ["537e1fca9a43b53767d5df797e474e150d22ae4f"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1744352 - Part 2: Add test for sandboxing javascript uris in pop-ups, r=smaug a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D138211", "files": ["docshell/test/mochitest/mochitest.ini", "docshell/test/mochitest/test_javascript_sandboxed_popup.html", "dom/jsurl/nsJSProtocolHandler.cpp"], "git_node": null, "git_parents": [null], "node": "a6c71a2cac3ca31f213b0730b70a8b738afdc63e", "parents": ["f7139e7249fe59ef84465aeeb2af98327a38682d"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1754305 - Make assertions in Maybe MOZ_RELEASE_ASSERT, r=glandium a=RyanVM\n\nThese assertions are already diagnostic asserts, and this will make\nfailures to check Maybe into safe crashes rather than security bugs on\nall branches.\n\nA failure to check Maybe is more dangerous than a null pointer\ndereference, as the generated code will produce a valid reference to\nuninitialized data rather than a null reference which should safely\nsegfault.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D138208", "files": ["mfbt/Maybe.h"], "git_node": null, "git_parents": [null], "node": "4f04e2ff2289d04791cbe08b6b385d1a5eef350d", "parents": ["a6c71a2cac3ca31f213b0730b70a8b738afdc63e"], "tags": []}], "date": 1645673235, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "178": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D139579", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "b6bb2e0a424b190294a8c5493a7fedaa01dd016c", "parents": ["4f04e2ff2289d04791cbe08b6b385d1a5eef350d"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1694085 - Serialize and deserialize the codec extra-data when sending an AudioInfo to the RDD. r=bryce, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128895", "files": ["dom/media/ipc/MediaIPCUtils.h"], "git_node": null, "git_parents": [null], "node": "6ccfbda2e8a928155e4ec625e0fc2e7e443f1718", "parents": ["b6bb2e0a424b190294a8c5493a7fedaa01dd016c"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1694085 - Add a test that verifies that HE-AAC plays back correctly including higher frequency content both with MSE and HTTP playback. r=bryce, a=RyanVM\n\nDepends on D128895\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128907", "files": ["dom/media/mediasource/test/mochitest.ini", "dom/media/mediasource/test/test_HEAAC_extradata.html", "dom/media/mediasource/test/whitenoise-he-aac-5s.mp4"], "git_node": null, "git_parents": [null], "node": "385be82d164afd392176ec0f67c29dd149ca250f", "parents": ["6ccfbda2e8a928155e4ec625e0fc2e7e443f1718"], "tags": []}, {"author": "lyavor \u003clyavor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1730920 - Https only mode shouldn't be triggered by the wifi portal code. r=nhnt11,ckerschb a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D131125", "files": ["browser/base/content/browser-captivePortal.js", "browser/base/content/test/captivePortal/browser.ini", "browser/base/content/test/captivePortal/browser_captivePortal_https_only.js"], "git_node": null, "git_parents": [null], "node": "0117fb7ddb1bb48c93ac23112f88f57dfafb47a8", "parents": ["385be82d164afd392176ec0f67c29dd149ca250f"], "tags": []}, {"author": "Glenn Watson \u003cgit@intuitionlibrary.com\u003e", "branch": "default", "desc": "Bug 1747857 - Invalidate partial dirty rects when surface counts change. r=aosmond, a=RyanVM\n\nThis is a sufficient fix to handle this case, we should definitely\ninvalidate the dirty rect validity if the compositor surface count\nhas changed.\n\nThere are likely other cases where the surface count remains the same\nbut we also need to invalidate dirty rect validity (we can handle\nthese as follow ups and/or as we encounter other cases).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135462", "files": ["gfx/wr/webrender/src/composite.rs", "gfx/wr/webrender/src/render_backend.rs"], "git_node": null, "git_parents": [null], "node": "6bbe658037c75f1786e1208f55388e1c49d25f2f", "parents": ["0117fb7ddb1bb48c93ac23112f88f57dfafb47a8"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1749283 - Add a null check for mPrintTarget in nsDeviceContext::CreateRenderingContextCommon. r=dholbert, a=RyanVM\n\nmPrintTarget can be nulled out and the caller needs to deal with null\nreturns already, so this should address the crash.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137473", "files": ["gfx/src/nsDeviceContext.cpp"], "git_node": null, "git_parents": [null], "node": "7e3730a33d4526827bf8d9a5067060094a04db91", "parents": ["6bbe658037c75f1786e1208f55388e1c49d25f2f"], "tags": []}, {"author": "Steven Michaud \u003csmichaud@pobox.com\u003e", "branch": "default", "desc": "Bug 1719215 - Constrain clipping in CreateSubImageForData(). r=lsalzman, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137777", "files": ["gfx/2d/DrawTargetCairo.cpp"], "git_node": null, "git_parents": [null], "node": "63bf31358d0e977f37aac9565ac9b4c4a95a1e75", "parents": ["7e3730a33d4526827bf8d9a5067060094a04db91"], "tags": []}], "date": 1645724902, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "179": {"changesets": [{"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 1749397: Ignore char key input while processing enter key on urlbar. r=adw, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136711", "files": ["browser/components/urlbar/UrlbarInput.jsm", "browser/components/urlbar/tests/browser/browser_canonizeURL.js", "browser/components/urlbar/tests/browser/browser_enter.js"], "git_node": null, "git_parents": [null], "node": "e39559d91f7bebbd1b5b7630fde8de162df34c4b", "parents": ["63bf31358d0e977f37aac9565ac9b4c4a95a1e75"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 1751819: Ignore char key input while processing enter key on searchbar. r=adw, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136712", "files": ["browser/components/search/content/searchbar.js", "browser/components/search/test/browser/browser.ini", "browser/components/search/test/browser/browser_searchbar_enter.js", "browser/components/search/test/browser/browser_searchbar_focus_timing.js"], "git_node": null, "git_parents": [null], "node": "1418b1962c1d9ed6c256f14a70c2f5d5e66a19c6", "parents": ["e39559d91f7bebbd1b5b7630fde8de162df34c4b"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1751037 - Properly disable PDFjs permissions. r=mtigley a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137778", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js"], "git_node": null, "git_parents": [null], "node": "9f7078a55b870a7d698d59263135d57382af0d9d", "parents": ["1418b1962c1d9ed6c256f14a70c2f5d5e66a19c6"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1754409 - Add catch for invalid manual update url. r=bytesized,application-update-reviewers a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D138473", "files": ["browser/base/content/aboutDialog-appUpdater.js"], "git_node": null, "git_parents": [null], "node": "61aab26dc5e5743650541fae1e0558dabe5e8d0d", "parents": ["9f7078a55b870a7d698d59263135d57382af0d9d"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1755292 - Don't double-count the entry memory in the TelemetryOrigin reporter. r=nika a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D139031", "files": ["toolkit/components/telemetry/core/TelemetryOrigin.cpp"], "git_node": null, "git_parents": [null], "node": "6214d2494910e47c3836379b9538f1b8cffc09ca", "parents": ["61aab26dc5e5743650541fae1e0558dabe5e8d0d"], "tags": []}], "date": 1645728798, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "180": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1736243 - Make SVGObserverUtils::GetAndObserveTextPathsPath not observe on continuations. r=jwatt,jfkthame a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D139485", "files": ["layout/svg/SVGObserverUtils.cpp"], "git_node": null, "git_parents": [null], "node": "3c51a47e58c24ff107ab5c19ef5030e39c40acd3", "parents": ["6214d2494910e47c3836379b9538f1b8cffc09ca"], "tags": []}], "date": 1646062189, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "181": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D139825", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "6b08edc3f87ad722a75f91b958a51bf734a143b3", "parents": ["3c51a47e58c24ff107ab5c19ef5030e39c40acd3"], "tags": []}], "date": 1646063294, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "182": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1699373 - Add WPT for COEP/CORP image reloading r=annevk a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125129", "files": ["testing/web-platform/tests/html/cross-origin-embedder-policy/require-corp-cached-images.https.html", "testing/web-platform/tests/html/cross-origin-embedder-policy/require-corp-cached-images.https.html.headers", "testing/web-platform/tests/html/cross-origin-embedder-policy/resources/corp-image.py", "testing/web-platform/tests/html/cross-origin-embedder-policy/resources/load-corp-images.html", "testing/web-platform/tests/html/cross-origin-embedder-policy/resources/load-corp-images.html.headers"], "git_node": null, "git_parents": [null], "node": "6f296ebeda377127eb9275e506bed6d060c6eb79", "parents": ["6b08edc3f87ad722a75f91b958a51bf734a143b3"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1699373 - Call ProcessCrossOrigin*Header methods after loading cached headers r=necko-reviewers,dragana a=pascalc\n\nPreviously we called `ProcessCrossOriginEmbedderPolicy` in\n`nsHttpChannel::ContinueProcessResponse1`, but we only loaded the cached\nresponse headers in `ContinueProcessResponse3`, meaning that we incorrectly\nreported a missing header for the revalidated resource.\n\nThis change moves the header checking calls to `ContinueProcessNormal` and\n`AsyncProcessRedirection` instead, so they get executed after processing\nthe cached headers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125184", "files": ["netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": null, "git_parents": [null], "node": "0cb2ab8a5857348e0e7c0eb22fac300e01dafce0", "parents": ["6f296ebeda377127eb9275e506bed6d060c6eb79"], "tags": ["FIREFOX_91_7_0esr_BUILD1"]}], "date": 1646070781, "git_changesets": [null, null], "user": "pchevrel@mozilla.com"}, "183": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 0cb2ab8a5857348e0e7c0eb22fac300e01dafce0 with FIREFOX_91_7_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "581d847cfc565a23b11ae35b77279776fd485677", "parents": ["0cb2ab8a5857348e0e7c0eb22fac300e01dafce0"], "tags": []}], "date": 1646080754, "git_changesets": [null], "user": "ffxbld"}, "184": {"changesets": [{"author": "Chris Martin \u003ccmartin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1751360 - Backout changes made by D135606. r=mhowell,handyman a=pascalc", "files": ["widget/windows/nsWindow.cpp", "widget/windows/nsWindow.h"], "git_node": null, "git_parents": [null], "node": "70e5dce7b64b7e04337319da8dd7885ef1b41328", "parents": ["581d847cfc565a23b11ae35b77279776fd485677"], "tags": []}, {"author": "Chris Martin \u003ccmartin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1751360 - Fix broken fullscreen behavior on Windows. r=mhowell,handyman a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D137089", "files": ["widget/windows/nsWindow.cpp", "widget/windows/nsWindow.h"], "git_node": null, "git_parents": [null], "node": "c17c94724a2ff10f89fa0a634f2bd1dc2e1744a7", "parents": ["70e5dce7b64b7e04337319da8dd7885ef1b41328"], "tags": ["FIREFOX_91_7_0esr_BUILD2"]}], "date": 1646088840, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "185": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging c17c94724a2ff10f89fa0a634f2bd1dc2e1744a7 with FIREFOX_91_7_0esr_BUILD2 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "e0b59b77671aacd9a70a2b11767a68f2cf95f0c4", "parents": ["c17c94724a2ff10f89fa0a634f2bd1dc2e1744a7"], "tags": []}], "date": 1646092734, "git_changesets": [null], "user": "ffxbld"}, "186": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1736323 - [marionette] \"WebDriver:NewSession\" has to wait for the very first tab to finish loading. r=jdescottes, a=RyanVM", "files": ["remote/marionette/driver.js", "remote/marionette/navigate.js", "testing/marionette/harness/marionette_harness/tests/unit/test_navigation.py"], "git_node": null, "git_parents": [null], "node": "2a3841952a3b5c37945139cc16eeb3db66de5f06", "parents": ["e0b59b77671aacd9a70a2b11767a68f2cf95f0c4"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D140177", "files": ["services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "7a6893e438308466ce80f1ef78883d3ab8241537", "parents": ["2a3841952a3b5c37945139cc16eeb3db66de5f06"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1718878 - Minimal changes to third_party library gyp to make it compatible with Python 3.10 r=mhentges a=RyanVM\n\ngyp appears to have been abandoned. To make it compatible with Python 3.10 a\nsmall 'soft fork' had to be made. If gyp is ever updated in the future, these\nchanges can probably be discarded.\n\ngyp source here: https://chromium.googlesource.com/external/gyp/\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128837", "files": ["third_party/python/gyp/pylib/gyp/msvs_emulation.py"], "git_node": null, "git_parents": [null], "node": "ffe34cdc6f44153939793400ae34da27650b2d15", "parents": ["7a6893e438308466ce80f1ef78883d3ab8241537"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1718878 - Updates to the build system to enable compatibility with Python 3.10 (Mainly regarding collections.abc) r=mhentges,webdriver-reviewers,whimboo a=RyanVM\n\nPreviously, collections.abc was available from the collections import. In Python\n3.10, they were explicitly moved to collections.abc. As such, any references to\ncollections abstract base classes need to import collections.abc in Python 3.10.\n\nMore reading here: https://docs.python.org/3/library/collections.abc.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128838", "files": ["configure.py", "testing/marionette/client/marionette_driver/wait.py", "testing/mozbase/manifestparser/manifestparser/filters.py", "testing/mozbase/versioninfo.py"], "git_node": null, "git_parents": [null], "node": "3b175cd808efc5d0d90387035ceba1df475a2396", "parents": ["ffe34cdc6f44153939793400ae34da27650b2d15"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 1740631 - Add requirements-plist-url to mac signing payloads, r=aki,glandium a=RyanVM\n\nThis file will get picked up by our mac signing infrastructure and be\nforwarded to the `productbuild` invocation.", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/transforms/signing.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "b138fdfe81575c51209dea735d4249b389a693ce", "parents": ["3b175cd808efc5d0d90387035ceba1df475a2396"], "tags": []}], "date": 1646317018, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "187": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset b138fdfe8157 (bug 1740631) for decision task bustage.", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/transforms/signing.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "9155b2214f961ea227e2cff00e7f66743c57e457", "parents": ["b138fdfe81575c51209dea735d4249b389a693ce"], "tags": []}], "date": 1646317258, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "188": {"changesets": [{"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1754724 - Clear up some computations in expat code. r=farre, a=tritter\n\nDifferential Revision: https://phabricator.services.mozilla.com/D140165", "files": ["parser/expat/lib/xmlparse.c"], "git_node": null, "git_parents": [null], "node": "c084e1e90301ca414be9dee690a3ca9ebc2a0a0e", "parents": ["9155b2214f961ea227e2cff00e7f66743c57e457"], "tags": []}, {"author": "Peter Van der 