v-SE -\u003e 1a5cd3da7e2e\nta -\u003e 3ce9d68345d4\nth -\u003e 5247384def0c\ntr -\u003e 2bdd64c98091\nuk -\u003e 9c178dd9cbeb\nur -\u003e ac5052f278c3\nzh-CN -\u003e 4af66a916dc4\nzh-TW -\u003e ffcbb5218418", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "7a782f598e98a5eb0c25b7df5ab065eb944550e8", "parents": ["a4e764f8dda4871165dae3d93f41249bc22ca6db"], "tags": []}], "date": 1576140882, "git_changesets": [null], "user": "ffxbld"}, "659": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nes-CL -\u003e 187d2c555fee\nka -\u003e 0ddd0e0a24f4\npa-IN -\u003e 3654f3fcf581\nuk -\u003e 33aff25e9ba3\nur -\u003e 82b23c6471d8\nvi -\u003e fc3675170f7a", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "7aa0587fd3d367836d28b42b6b39ae7371327673", "parents": ["7a782f598e98a5eb0c25b7df5ab065eb944550e8"], "tags": []}], "date": 1576158920, "git_changesets": [null], "user": "ffxbld"}, "660": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nit -\u003e e98dbf17caf9", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "f945af6a1c3b39c14a65fafc7cf6629f3a93bab7", "parents": ["7aa0587fd3d367836d28b42b6b39ae7371327673"], "tags": []}], "date": 1576162631, "git_changesets": [null], "user": "ffxbld"}, "661": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nen-GB -\u003e 3db0364af0fc\nhi-IN -\u003e 440a038f79a3", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "107b18856f7846dd82cd4e61edad69d3ff5c4e34", "parents": ["f945af6a1c3b39c14a65fafc7cf6629f3a93bab7"], "tags": []}], "date": 1576169752, "git_changesets": [null], "user": "ffxbld"}, "662": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D56906", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "56a0b2b301ad94d7527caadaabf2df9be92e8be9", "parents": ["107b18856f7846dd82cd4e61edad69d3ff5c4e34"], "tags": []}, {"author": "A. Wilcox \u003cAWilcox@Wilcox-Tech.com\u003e", "branch": "default", "desc": "Bug 1511604 - Swizzle YCbCr-\u003eRGB data on big-endian machines. r=lsalzman, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D46134", "files": ["gfx/ycbcr/YCbCrUtils.cpp"], "git_node": null, "git_parents": [null], "node": "74a2092978074c065b17aec0b924f4f50cd81f69", "parents": ["56a0b2b301ad94d7527caadaabf2df9be92e8be9"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1586453 - Don't try to wait for favicons in policy. r=Standard8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48240", "files": ["browser/components/enterprisepolicies/helpers/BookmarksPolicies.jsm", "browser/components/enterprisepolicies/tests/browser/404.sjs", "browser/components/enterprisepolicies/tests/browser/browser.ini", "browser/components/enterprisepolicies/tests/browser/browser_policy_bookmarks.js"], "git_node": null, "git_parents": [null], "node": "8f90e06662bde8464e26d25c18127e509a83f0a0", "parents": ["74a2092978074c065b17aec0b924f4f50cd81f69"], "tags": []}, {"author": "Michal Novotny \u003cmichal.novotny@gmail.com\u003e", "branch": "default", "desc": "Bug 1550815 - Handle SIGBUS error when accessing mmapped file. r=aklotz,haik, a=RyanVM\n\nThis patch adds mmap page fault handling to linux/android.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D42010", "files": ["modules/libjar/MmapFaultHandler.cpp", "modules/libjar/MmapFaultHandler.h", "modules/libjar/moz.build", "modules/libjar/nsJARInputStream.cpp", "modules/libjar/nsZipArchive.cpp", "modules/libjar/nsZipArchive.h", "modules/libjar/test/unit/test_bug1550815.js", "modules/libjar/test/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "19884b779fc1e1e827ba4a418a87e0a832165bb1", "parents": ["8f90e06662bde8464e26d25c18127e509a83f0a0"], "tags": []}, {"author": "Michal Novotny \u003cmichal.novotny@gmail.com\u003e", "branch": "default", "desc": "Bug 1583735 - Find out why accessing mmaped JAR file generates SIGBUS. r=gcp,aklotz, a=RyanVM\n\nWhen we have nsZipHandle available (which is the case of crashes from bugs 1550815, 1564444 and 1564921), we send following information in the crash report:\n - file name\n - current file size\n - buffer address\n - buffer length\n - address that generated SIGBUS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48847", "files": ["modules/libjar/MmapFaultHandler.cpp", "modules/libjar/MmapFaultHandler.h", "modules/libjar/test/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "044a57a29c8ad2b2d40bb9a988dc556014455e30", "parents": ["19884b779fc1e1e827ba4a418a87e0a832165bb1"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 1513855: Make sure that quit-application-granted and quit-application notifications are always sent. r=froydnj, a=RyanVM\n\nWe only run the main event loop if at least one window is open. There are various\ncases where this doesn't happen, such as -silent. By the time we get there though\nsome components have started and require appropriate notifications to tell them\nto shutdown safely. This patch sends the quit-application-granted and\nquit-application notifications in the case that there were no windows open\nand nsAppStartup::Quit hasn't already been called when we come to run the\nevent loop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D51736", "files": ["toolkit/components/startup/nsAppStartup.cpp"], "git_node": null, "git_parents": [null], "node": "9388fd235de54b9c7476dc1caa8e8fd345b254b0", "parents": ["044a57a29c8ad2b2d40bb9a988dc556014455e30"], "tags": []}], "date": 1576186669, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "663": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1601701 - Build libssp as part of the mingw-clang toolchain build, bump mingw, and add -lssp. r=dmajor,froydnj a=RyanVM", "files": ["build/moz.configure/toolchain.configure", "taskcluster/ci/toolchain/clang.yml", "taskcluster/scripts/misc/build-clang-8-mingw.sh"], "git_node": null, "git_parents": [null], "node": "c677377208c230bbdba3eda0c3c7ce154c21abf9", "parents": ["9388fd235de54b9c7476dc1caa8e8fd345b254b0"], "tags": []}, {"author": "Philip Chimento \u003cphilip.chimento@gmail.com\u003e", "branch": "default", "desc": "Bug 1602280 - Add visibility attribute to ProfilingStack. r=tcampbell, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D56303", "files": ["js/public/ProfilingStack.h"], "git_node": null, "git_parents": [null], "node": "07dafa470de6949b681e384316ada23778998fb8", "parents": ["c677377208c230bbdba3eda0c3c7ce154c21abf9"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1511073 - Enable Stack protector on mingw-clang builds. r=dmajor, a=RyanVM", "files": ["build/moz.configure/toolchain.configure"], "git_node": null, "git_parents": [null], "node": "697cfb87b3b6e70a0a26333f40b847be6e25177b", "parents": ["07dafa470de6949b681e384316ada23778998fb8"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1599181 - Fix serialization of @namespace rule. r=boris, a=jcristau\n\nThis code comes from:\n\nhttps://hg.mozilla.org/mozilla-central/rev/2418cfba72c33c5623f6fb4c243c5203819c8240\n\nI audited other callers of write_str, they seem ok.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D54601", "files": ["servo/components/style/stylesheets/namespace_rule.rs"], "git_node": null, "git_parents": [null], "node": "38060b1ce782df06c59089ab56ac3c4d69c01b58", "parents": ["697cfb87b3b6e70a0a26333f40b847be6e25177b"], "tags": []}, {"author": "Yaron Tausky \u003cytausky@mozilla.com\u003e", "branch": "default", "desc": "Bug 1507180 - Make copy of list before iterating over it. r=sg, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D55286", "files": ["dom/cache/StreamControl.cpp"], "git_node": null, "git_parents": [null], "node": "6e1e8bfee8a1900b2025e6e2fa175da8d0d835ea", "parents": ["38060b1ce782df06c59089ab56ac3c4d69c01b58"], "tags": []}], "date": 1576188648, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "664": {"changesets": [{"author": "Toshihito Kikuchi \u003ctkikuchi@mozilla.com\u003e", "branch": "default", "desc": "Bug 1597794 - Return NS_ERROR_FILE_EXECUTION_FAILED if shell failed to launch a file. r=aklotz, a=RyanVM\n\nCalling `AsWin32Error()` for the return value from `ShellExecuteByExplorer` can\ncause the crash because it may not be a Win32 error.  We simply return\n`NS_ERROR_FILE_EXECUTION_FAILED` as we do in `nsProcess::RunProcess` or\n`ShellExecuteWithIFile`.\n\nWe used to check the return value from `ShellExecuteExW` against `SE_ERR_NOASSOC`,\nbut it never happens because `SE_ERR_` is returned as `SHELLEXECUTEINFO::hInstApp`.\nNo worry about the no-association case because `IShellDispatch2.ShellExecute`\ndisplays the \"How do you want to open this file?\" popup when needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D55471", "files": ["xpcom/io/nsLocalFileWin.cpp"], "git_node": null, "git_parents": [null], "node": "07be8c9d49ab44fc15792228af64e52ba22cd2aa", "parents": ["6e1e8bfee8a1900b2025e6e2fa175da8d0d835ea"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1598605 - Be more consistent about decoding IP addresses in PSM. r=kjacobs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D56240", "files": ["security/manager/ssl/SSLServerCertVerification.cpp", "security/manager/ssl/nsNSSCertHelper.cpp", "security/manager/ssl/nsNSSCertificate.cpp"], "git_node": null, "git_parents": [null], "node": "454f5e4c1bfac03507a509444b8d626f3aae5047", "parents": ["07be8c9d49ab44fc15792228af64e52ba22cd2aa"], "tags": []}, {"author": "Andrei Lazar \u003candrei.a.lazar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1601344 - Fix fennec.page_options.total_sites_pinned_to_topsites and fennec.page_options.total_added_search_engines core pings. r=petru, a=RyanVM\n\nFixed logic flaw for retrieving the number of added search engines, flaw which lead to negative number count because of the wrong number of default engines.\nFixed implementation error for retrieving the number of pinned topsites.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D56558", "files": ["mobile/android/base/java/org/mozilla/gecko/BrowserApp.java", "mobile/android/base/java/org/mozilla/gecko/db/LocalBrowserDB.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/pingbuilders/TelemetryCorePingBuilder.java"], "git_node": null, "git_parents": [null], "node": "8fc36c7ccc1dbd558c05f0138c76241563a26b0d", "parents": ["454f5e4c1bfac03507a509444b8d626f3aae5047"], "tags": []}, {"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1583525 - Send the current pwas number in the core ping. r=AndreiLazar, a=RyanVM\n\nThe only way to know exactly how many Fennec installed PWAs the user has on\nhomescreen is ShortcutManager#getPinnedShortcuts which is only available on\nAndroid \u003e=25.\nOn Android \u003e=25 we'll send the value from ShortcutManager#getPinnedShortcuts,\nOn Android \u003c25 we'll send a default value of -1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D55259", "files": ["mobile/android/base/java/org/mozilla/gecko/telemetry/pingbuilders/TelemetryCorePingBuilder.java"], "git_node": null, "git_parents": [null], "node": "3bebea25e867230ef3f6e51a659d5d70d63c1f36", "parents": ["8fc36c7ccc1dbd558c05f0138c76241563a26b0d"], "tags": []}, {"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1583525 - Document the new core ping \"fennec\" fields. r=AndreiLazar, a=RyanVM\n\nAs this tickets adds to the the previous \"fennec\" fields which lacked\ndocumentation this patch\n- adds full documentation for all the new core ping fields\n- increments the ping format version\n\nDepends on D55259\n\nDifferential Revision: https://phabricator.services.mozilla.com/D55260", "files": ["toolkit/components/telemetry/docs/data/core-ping.rst"], "git_node": null, "git_parents": [null], "node": "219f650b2dfc407ff3024c02b83c09ea85fc4db2", "parents": ["3bebea25e867230ef3f6e51a659d5d70d63c1f36"], "tags": []}, {"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1583525 - Remove unused imports in TelemetryCorePingBuilder. r=AndreiLazar, a=RyanVM\n\nDepends on D55260\n\nDifferential Revision: https://phabricator.services.mozilla.com/D55261", "files": ["mobile/android/base/java/org/mozilla/gecko/telemetry/pingbuilders/TelemetryCorePingBuilder.java"], "git_node": null, "git_parents": [null], "node": "eb49d907115ba72768a72726b240e95fc930cb78", "parents": ["219f650b2dfc407ff3024c02b83c09ea85fc4db2"], "tags": []}], "date": 1576194257, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "665": {"changesets": [{"author": "Noemi Erli \u003cnerli@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 454f5e4c1bfa (bug 1598605) for causing build bustages in nsNSSCertificate.cpp", "files": ["security/manager/ssl/SSLServerCertVerification.cpp", "security/manager/ssl/nsNSSCertHelper.cpp", "security/manager/ssl/nsNSSCertificate.cpp"], "git_node": null, "git_parents": [null], "node": "9780be90af6779e38ecea8413739665ae795156d", "parents": ["eb49d907115ba72768a72726b240e95fc930cb78"], "tags": []}], "date": 1576200848, "git_changesets": [null], "user": "nerli@mozilla.com"}, "666": {"changesets": [{"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1599350: Remove esr-next update verify tasks on esr68; r=nthomas a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D57048", "files": ["taskcluster/ci/release-update-verify-config-next/kind.yml", "taskcluster/ci/release-update-verify-next/kind.yml"], "git_node": null, "git_parents": [null], "node": "68b230f9bfae2963ab78e4da7a51d3472c613db9", "parents": ["9780be90af6779e38ecea8413739665ae795156d"], "tags": []}, {"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1600931: [boucner] Add checks for win-aarch64 bouncer entries; r=nthomas a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D57049\n\nDepends on D57048", "files": ["testing/mozharness/configs/releases/bouncer_firefox_esr.py"], "git_node": null, "git_parents": [null], "node": "c8e95a982467b45c708cbbb02effd94048816d66", "parents": ["68b230f9bfae2963ab78e4da7a51d3472c613db9"], "tags": []}], "date": 1576208467, "git_changesets": [null, null], "user": "csabou@mozilla.com"}, "667": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "bran