fxbld"}, "675": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1603313 - Remove some silly patterns. r=bzbarsky, a=RyanVM\n\nfoo ? true : false\n\nor:\n\n  foo ? false : true\n\nHave always a nicer way to be written.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D56842", "files": ["dom/base/nsContentUtils.cpp", "dom/base/nsXHTMLContentSerializer.cpp", "dom/indexedDB/IDBEvents.cpp", "dom/ipc/ContentParent.cpp", "dom/localstorage/LSWriteOptimizer.cpp", "dom/plugins/base/nsNPAPIPluginStreamListener.cpp", "dom/plugins/ipc/PluginInstanceChild.cpp", "dom/presentation/PresentationConnectionList.cpp", "dom/presentation/ipc/PresentationParent.cpp", "dom/webbrowserpersist/nsWebBrowserPersist.cpp", "dom/workers/ScriptLoader.cpp", "layout/base/nsLayoutUtils.cpp", "layout/painting/nsCSSRendering.cpp", "layout/style/nsStyleStruct.cpp", "layout/tables/nsTableFrame.cpp", "layout/xul/nsXULPopupManager.cpp"], "git_node": null, "git_parents": [null], "node": "44d4ad1319daf5a7d51d5909c58282b04a5e3568", "parents": ["53f7fecd392cd109838982781f96a87abe7bd079"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1603313 - Subdocument enum callbacks should take a reference. r=bzbarsky, a=RyanVM\n\nAs they can never take null.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D56843", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/nsGlobalWindowOuter.cpp", "layout/base/PresShell.cpp", "layout/base/nsDocumentViewer.cpp", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h", "layout/generic/nsSubDocumentFrame.cpp", "layout/painting/RetainedDisplayListBuilder.cpp", "layout/painting/nsDisplayList.cpp", "layout/printing/nsPrintJob.cpp"], "git_node": null, "git_parents": [null], "node": "d3ec0942b04a6eaf1acda964f1aba425a369a344", "parents": ["44d4ad1319daf5a7d51d5909c58282b04a5e3568"], "tags": [